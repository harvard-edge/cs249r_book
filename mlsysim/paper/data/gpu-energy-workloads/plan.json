{
  "schema": "mlsysim-gpu-energy-plan/1",
  "declared": "2026-11-19",
  "purpose": "Board energy of single-GPU language-model serving and ResNet-50 training on more workloads and a third device, measured against MLSys·im's two device-power assumptions (rated TDP and Engine.solve's energy-proportional rule) with the protocol of ../gpu-energy/. It asks whether the offsetting errors and the device-choice differences found there also appear for other models and on the H200.",
  "declaration_note": "Every efficiency below is a value the package already uses (engine/empirical.py anchors, or the 0.5 that ../gpu-energy/ declared for language models). None is fitted to these measurements. Commit this file before any run: each run manifest records its SHA-256, and the analysis refuses runs measured under a different plan.",
  "analysis_note": "Declared before any run. The analysis reports the same four estimates as ../gpu-energy/ for every configuration, and device_choice.csv compares the devices each configuration was measured on. The questions are: (1) whether decode draws a large share of TDP at low FLOP utilization for each model; (2) whether ServingModel's decode step is shorter than measured, and whether TDP over the modeled time then comes closer to the meter than either power assumption over the measured time; (3) whether each estimate picks the meter's device; (4) for Mixtral-8x7B, a mixture-of-experts model measured on the H200 only, whether the same holds. The answers are reported whichever way they go.",
  "boundary": "GPU board only, as reported by NVML. Excludes host CPU, DRAM, NICs, fans outside the board, power-supply losses, and facility overhead (PUE).",
  "split_note": "Every configuration is held out: nothing is fitted to these runs. Llama-3.1-8B and ResNet-50 repeat configurations of ../gpu-energy/ on new boards, which also checks that experiment.",
  "trials": 10,
  "warmup_trials": 1,
  "phase_min_seconds": 5.0,
  "idle_seconds": 5.0,
  "sample_interval_s": 0.05,
  "counter_probe_seconds": 2.0,
  "seed": 2198,
  "devices": {
    "H100": {
      "registry": "Hardware.Cloud.H100",
      "modal_gpu": "H100!",
      "expected_name": "NVIDIA H100 80GB HBM3"
    },
    "A100": {
      "registry": "Hardware.Cloud.A100",
      "modal_gpu": "A100-80GB",
      "expected_name": "NVIDIA A100-SXM4-80GB"
    },
    "H200": {
      "registry": "Hardware.Cloud.H200",
      "modal_gpu": "H200",
      "expected_name": "NVIDIA H200"
    }
  },
