<!--
  MLSys·im sidebar brand block: tagline + version chip under the sidebar logo.
  Mirrors tinytorch/guide/assets/scripts/sidebar-subtitle.html so the two
  companion sites read the same way.

  TEMPLATE (config/sidebar-brand.html.in): scripts/build_api.py stamps __MLSYSIM_VERSION__ from
  mlsysim.__version__ into config/sidebar-brand.html on every render.
  Edit this file, not the generated one.
-->
<script>
document.addEventListener('DOMContentLoaded', function () {
  const logoLink = document.querySelector('#quarto-sidebar .sidebar-logo-link');
  if (!logoLink || document.querySelector('.mlsysim-sidebar-tagline')) return;
  const host = logoLink.parentNode;

  const tagline = document.createElement('div');
  tagline.className = 'mlsysim-sidebar-tagline';
  tagline.innerHTML = 'First-principles modeling companion to the<br>' +
    '<a href="https://mlsysbook.ai">Machine Learning Systems</a> textbook';
  host.insertBefore(tagline, logoLink.nextSibling);

  const wrap = document.createElement('div');
  wrap.className = 'mlsysim-version-chip-wrap';
  const chip = document.createElement('a');
  chip.className = 'mlsysim-version-chip';
  chip.href = 'https://pypi.org/project/mlsysim/';
  chip.target = '_blank';
  chip.rel = 'noopener';
  chip.innerHTML = '<span class="mlsysim-version-dot"></span>' +
    '<span class="mlsysim-chip-label">MLSys·im&nbsp;</span>' +
    '<span class="mlsysim-version-tag">v__MLSYSIM_VERSION__</span>';
  wrap.appendChild(chip);
  tagline.parentNode.insertBefore(wrap, tagline.nextSibling);

  // On the deployed site, prefer the release manifest so a cached page still
  // shows the current release.
  fetch('/mlsysim/release-manifest.json?_t=' + Date.now(), { cache: 'no-store' })
    .then(function (res) { return res.ok ? res.json() : null; })
    .then(function (manifest) {
      if (!manifest || !manifest.releaseId) return;
      const tag = chip.querySelector('.mlsysim-version-tag');
      tag.textContent = 'v' + String(manifest.releaseId).replace(/^v/, '');
    })
    .catch(function () {});
});
</script>
