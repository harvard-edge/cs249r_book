{
  "name": "@mlsysbook/socratiq",
  "version": "1.0.0",
  "description": "AI learning widget that injects into static HTML pages via a single <script> tag, running entirely inside a Shadow DOM.",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "node --max-http-header-size=65536 ./node_modules/.bin/vite --config vite.config.dev.mjs",
    "dev:vite": "node --max-http-header-size=65536 ./node_modules/.bin/vite --config vite.config.dev.mjs",
    "build:vite": "vite build --config vite.config.prod.mjs",
    "build:quarto": "npm run build:vite",
    "preview:vite": "vite preview --config vite.config.prod.mjs",
    "build:reader": "vite build --config vite.config.reader.mjs",
    "test:reader": "node --test tests/reader-transport.test.mjs",
    "test:local": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:reader:browser": "playwright test --config playwright.reader.config.mjs",
    "test:gateway": "node --test cloudflare/test/worker.test.mjs"
  },
  "keywords": [],
  "author": "Kai Kleinbard",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "chokidar": "^4.0.3",
    "tailwindcss": "3.4.17",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "katex": "$katex"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.17",
    "boarding.js": "^3.6.0",
    "chart.js": "^4.4.5",
    "compromise": "^14.13.0",
    "crypto-js": "^4.2.0",
    "d3": "^7.9.0",
    "dompurify": "^3.4.13",
    "idb": "^8.0.0",
    "ink-mde": "^0.34.0",
    "jsonrepair": "^3.11.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "katex": "^0.18.3",
    "markdown-it": "^14.3.3",
    "markdown-it-container": "^4.0.0",
    "mermaid": "^11.16.1"
  }
}
