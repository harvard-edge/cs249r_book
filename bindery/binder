#!/usr/bin/env python3
"""
MLSysBook CLI v2.0 - Modular Entry Point

A refactored, modular command-line interface for the MLSysBook project.
This is the new modular version of the original binder script.
"""

import sys
from pathlib import Path

# Add the cli directory to Python path. resolve() matters: this script is
# invoked through the ./binder symlink at the repository root, so __file__ is
# the symlink and its parent is the repo root rather than bindery/.
cli_dir = Path(__file__).resolve().parent / "cli"
sys.path.insert(0, str(cli_dir))

# Import and run the main CLI
from main import main

if __name__ == "__main__":
    main()
