"vol1.goal.3b38e49d1f405267" -> "vol1.goal.8ae1ff743d680798" [id="relation-vol1.connection.9ee0edfbde881469", label="causes downstream\nrework through"];
"vol1.goal.da8b1664cc1b1807" -> "vol1.goal.d7848422d9df2b40" [id="relation-vol1.connection.54303b4341f19481", label="incurs shape-dependent\nwork described by"];
"vol1.goal.29d5e60ee111333e" -> "vol1.goal.6970a97158deafac" [id="relation-vol1.connection.72ee1dfa07c35037", label="requires saved state\ncounted by"];
"vol1.goal.d7848422d9df2b40" -> "vol1.goal.9c24d98f0dede8dd" [id="relation-vol1.connection.d4ebd694bb6fc60d", label="sets the operation\ncount in"];
"vol1.goal.6970a97158deafac" -> "vol1.goal.d30db4dc2bbb9ee5" [id="relation-vol1.connection.a1fd42feffc3e646", label="sets memory feasibility\nfor"];
