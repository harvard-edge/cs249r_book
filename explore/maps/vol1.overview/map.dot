digraph concepts {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.85", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#88949d", penwidth=1.15, fontname="Helvetica Neue", fontsize=16, margin="0.18,0.12"];
edge [fontname="Helvetica Neue", fontsize=12, color="#7a858e", fontcolor="#47535d", arrowsize=0.65];
"vol1.goal.58648863d3885b0b" [id="concept-vol1.goal.58648863d3885b0b", label="Dual mandate", tooltip="Every ML system must show both that its learned behavior is trustworthy and that the machine delivers it within time, memory, energy, and cost budgets, so an accurate but slow model and a fast model trained on unrepresentative data are both failures.", fillcolor="#fcebed", color="#a51c30", penwidth=1.8];
"vol1.goal.26fe99ae186bcbe5" [id="concept-vol1.goal.26fe99ae186bcbe5", label="Data defines behavior", tooltip="Training data plus the optimization procedure produce the program, so changing the dataset changes system behavior as surely as changing source code, and debugging, versioning, and review must extend to the data."];
"vol1.goal.71ef60f06b6686d9" [id="concept-vol1.goal.71ef60f06b6686d9", label="D·A·M diagnosis", tooltip="Attributing a symptom to Data, Algorithm, or Machine chooses the evidence and the class of fix, and relieving the binding constraint moves the bottleneck across the triad, so diagnosis is a loop of diagnose, intervene, and re-measure."];
"vol1.goal.9c24d98f0dede8dd" [id="concept-vol1.goal.9c24d98f0dede8dd", label="Iron law of ML systems", tooltip="Across Data, Algorithm, and Machine, execution time factors as samples per task times FLOPs per sample times seconds per FLOP (where the first two multiply to total operations O), and unpacks on hardware into bytes moved over bandwidth plus operations over peak rate times utilization plus fixed overhead, with ideal overlap giving the larger of the first two plus overhead, so a faster component helps only through the share of time it changes."];
"vol1.goal.42e1407c4fb31210" [id="concept-vol1.goal.42e1407c4fb31210", label="Silicon contract", tooltip="Each tier's hardware offers a peak compute rate, a memory bandwidth, and a fixed overhead that enter the iron law's three terms, while memory capacity and energy act as feasibility preconditions that can rule a tier out before any term is evaluated."];
"vol1.goal.551d90ec7f4ddf8b" [id="concept-vol1.goal.551d90ec7f4ddf8b", label="Workload archetypes and\nlighthouses", tooltip="Classifying a workload by what binds it first gives four archetypes, compute-bound (ResNet-50 training), bandwidth-bound (batch-one LLM decode), capacity-bound (DLRM embeddings), and power-bound (keyword spotting), and the class is a regime, not a model property, since batch, precision, or hardware can move a model across it."];
"vol1.goal.344d9dc0238c67b9" [id="concept-vol1.goal.344d9dc0238c67b9", label="Physical walls set\ndeployment tiers", tooltip="The light barrier puts a round-trip floor under any remote path, the power wall (dynamic power roughly cubic in frequency) caps sustained mobile power at a few watts, and the memory wall makes data movement a growing share of time, so cloud, edge, mobile, and TinyML are constraint regimes spanning about nine orders of magnitude in power and memory."];
"vol1.goal.92736de5a3024450" [id="concept-vol1.goal.92736de5a3024450", label="Device energy budgets", tooltip="On untethered devices energy per inference is first-order with two distinct limits, a battery budget fixable by duty cycling or a lighter model and a thermal ceiling on sustained power that throttles regardless of charge, and transmitting raw data can cost more energy than inferring locally."];
"vol1.goal.0dbf4b4d716d3176" [id="concept-vol1.goal.0dbf4b4d716d3176", label="The lifecycle is a loop", tooltip="An ML system moves through problem definition, data, training, evaluation, deployment, and monitoring, each handing the next a concrete artifact, and because learned behavior changes when the world changes, monitoring evidence must flow back to earlier stages, so deployment starts an operational phase rather than ending the project."];
"vol1.goal.8ae1ff743d680798" [id="concept-vol1.goal.8ae1ff743d680798", label="Constraint propagation", tooltip="A constraint discovered late forces rework in every upstream artifact that relied on its absence (the 4 GB model against a 500 MB device reservation), so rework is estimated by tracing the revise, retrain, and revalidate chain, and propagation runs both backward and forward."];
"vol1.goal.159aa5f332fa3349" [id="concept-vol1.goal.159aa5f332fa3349", label="Problem framing", tooltip="A request becomes a requirement only when stated as a measurable improvement over a named baseline and decomposed into statistical, physical, and operational constraints bound before development, because a metric that diverges from the goal defeats the system before training starts."];
"vol1.goal.8ec7111c10d0bef2" [id="concept-vol1.goal.8ec7111c10d0bef2", label="Data as code practice", tooltip="Because the pipeline that produces a dataset is the system's build and every retraining a rebuild, datasets need the disciplines code has: immutable lineage, executable validation suites, versioned releases, and debugging by controlled comparison of versions."];
"vol1.goal.3b38e49d1f405267" [id="concept-vol1.goal.3b38e49d1f405267", label="Data cascades", tooltip="A data defect entered early passes schemas and tests, is converted by each later stage into new derived state, and surfaces only at evaluation or deployment, so remediation cost scales with the downstream artifacts that consumed it and prevention belongs at the source."];
"vol1.goal.4167acb19228dfd8" [id="concept-vol1.goal.4167acb19228dfd8", label="Labels are the\nspecification", tooltip="Ground truth is the system's specification, so a labeling error becomes part of the definition of correct; labeling usually dominates data cost, granularity sets per-label cost, and label quality is bounded through chance-corrected agreement, gold checks, and monitoring of agreement over time."];
"vol1.goal.7d9b30c58a9c7f1e" [id="concept-vol1.goal.7d9b30c58a9c7f1e", label="Training-serving\nconsistency", tooltip="Shared feature code is not enough: fitted state (normalization constants, vocabularies, gain handling) must be fitted once on the training split, persisted with the model, and replayed identically at serving, because a skewed feature is still a valid vector and raises no error; a violation is training-serving skew, an internal divergence of logic or state that differs from drift in the environment."];
"vol1.goal.da8b1664cc1b1807" [id="concept-vol1.goal.da8b1664cc1b1807", label="Network as linear maps\nand nonlinearities", tooltip="A layer is one matrix product plus bias followed by an element-wise activation and a network is their composition, without the nonlinearity the stack collapses to one linear map, and inference runs only the forward pass while training adds loss, backward pass, and update."];
"vol1.goal.d7848422d9df2b40" [id="concept-vol1.goal.d7848422d9df2b40", label="Cost from layer shapes", tooltip="Layer widths fix parameters, forward work (one multiply-accumulate, two FLOPs, per weight per example), and retained activations before any code runs, so width costs quadratically, depth costs linearly but adds sequential steps and saved activations."];
"vol1.goal.29d5e60ee111333e" [id="concept-vol1.goal.29d5e60ee111333e", label="Backprop over saved\nactivations", tooltip="Backpropagation applies the chain rule layer by layer in reverse, each dense layer needs two backward products of forward size, so a training step costs about three times the forward matrix work and every forward activation must stay live, or be recomputed, until the backward pass reaches its layer."];
"vol1.goal.6970a97158deafac" [id="concept-vol1.goal.6970a97158deafac", label="Training holds four\nkinds of state", tooltip="Training memory is weights plus gradients plus optimizer state plus saved activations, while inference keeps only the weights and the largest adjacent pair of activation buffers, and raising the batch leaves parameter state fixed while multiplying saved activations."];
"vol1.goal.73043a9e20983fa4" [id="concept-vol1.goal.73043a9e20983fa4", label="Inductive bias buys\ndata and cost", tooltip="Each architecture is defined by a structural assumption fixed before training (locality and weight sharing, ordered recurrence, content-based routing), and a bias that matches the data cuts parameters, samples, and operations while weak priors pay off only at large data and compute."];
"vol1.goal.f4cb67a79db7d085" [id="concept-vol1.goal.f4cb67a79db7d085", label="Every family lowers\nonto GEMM", tooltip="Convolution reaches matrix multiply through im2col or implicit GEMM, attention and LSTM gates fuse their projections into wide GEMMs, and pointwise convolutions and recommender MLPs are GEMMs, so GEMM dominates nearly every workload's operation count and the exceptions are the memory-bound remainder."];
"vol1.goal.f44ef6fe0fad6844" [id="concept-vol1.goal.f44ef6fe0fad6844", label="Architectures as cost\nsignatures", tooltip="Counting weights, multiply-accumulates, and resident bytes per building block predicts which iron-law term binds: dense layers stream each weight once per batch, convolutions reuse each filter at every position, recurrence adds a serial floor, attention adds quadratic score work, and embedding lookups are copies."];
"vol1.goal.cf6f8ce8dbd6778c" [id="concept-vol1.goal.cf6f8ce8dbd6778c", label="Quadratic attention", tooltip="Dense self-attention computes sequence-length-squared score interactions, so doubling context quadruples that work, while materializing the score matrix is optional storage that tiled kernels remove, and attention arithmetic dominates a block only past a context of about six times the hidden size."];
"vol1.goal.d8f639b41d4b5b17" [id="concept-vol1.goal.d8f639b41d4b5b17", label="Three framework\nproblems", tooltip="Every framework must solve execution, differentiation, and hardware abstraction; the model fixes the operation count while the framework shapes the other iron-law terms, with execution bearing on overhead, differentiation on bytes, and abstraction on efficiency."];
"vol1.goal.1e6a023e407095de" [id="concept-vol1.goal.1e6a023e407095de", label="Eager, graph, and JIT\nexecution", tooltip="Eager execution exposes intermediate values to ordinary debugging but shows the runtime one operation at a time, static graphs give the compiler whole-program visibility at the price of graph-only control flow, and graph-capture JIT guards captured regions and pays a graph break wherever capture fails."];
"vol1.goal.1a11e5a405cba24d" [id="concept-vol1.goal.1a11e5a405cba24d", label="Dispatch overhead", tooltip="Each eagerly dispatched operation pays a fixed host cost of microseconds, so a workload of many small kernels is overhead-bound when total dispatch time exceeds device time, while large GEMM-dominated layers are device-bound; compilation, fusion, larger batches, and graph replay are the levers."];
"vol1.goal.8624ab6ba194f520" [id="concept-vol1.goal.8624ab6ba194f520", label="Kernel fusion", tooltip="Most elementwise and normalization operators are memory-bound, so fusing a chain of k of them into one kernel cuts idealized traffic from 2kNb to 2Nb and removes k-1 launches, but a compiler fuses only what it sees together and fusion cannot drop values a backward rule must read."];
"vol1.goal.d30db4dc2bbb9ee5" [id="concept-vol1.goal.d30db4dc2bbb9ee5", label="Training-time law", tooltip="In the macroscopic D·A·M product form of the iron law, training work is about 6PD FLOPs (D tokens times 6P FLOPs per token) and run time is that work over peak rate times utilization, so every point of utilization recovered at constant power removes time, energy, and dollars in the same proportion, while memory sits outside the law as a feasibility gate."];
"vol1.goal.ffe632e9837cffb3" [id="concept-vol1.goal.ffe632e9837cffb3", label="Model FLOPs utilization", tooltip="MFU is useful model FLOPs per step over peak times measured step time and is the honest estimate of utilization, whereas the busy time a device monitor reports is only an upper bound, high for a memory-stalled job and low for a data-starved one."];
"vol1.goal.bbbf69154834175f" [id="concept-vol1.goal.bbbf69154834175f", label="Training memory at\nscale", tooltip="Mixed-precision Adam holds 16 bytes per parameter of static state (eight times the FP16 inference weights) before any activation, and only the activation term grows with batch and sequence length, which is what pushes a large model past one accelerator's memory."];
"vol1.goal.0b0c5157d4dbc8ce" [id="concept-vol1.goal.0b0c5157d4dbc8ce", label="Mixed precision", tooltip="Running eligible matrix products in FP16 or BF16 raises the attainable peak and halves activation bytes but leaves the 16 B/param static state unchanged, FP16 needs dynamic loss scaling to keep gradients above its normal floor while BF16 usually does not, and the speedup is bounded by the work that stays off the matrix units."];
"vol1.goal.6d9ba96a2926136b" [id="concept-vol1.goal.6d9ba96a2926136b", label="Data selection payback", tooltip="A training-time claim for data selection holds only if selection time plus subset training time is less than full training time at matched quality and coverage, so scorer size and refresh rate, not the retained fraction, decide whether selection is a net saving."];
"vol1.goal.4c65b162a5b772cc" [id="concept-vol1.goal.4c65b162a5b772cc", label="Measuring data value", tooltip="Sample value is learning per unit of training compute (the information-compute ratio), learning-curve metrics show whether a reduction held quality, and a gain in data value becomes a throughput gain only when the run is compute-bound and the saved work is on the critical path."];
"vol1.goal.db66ad10f7664d6f" [id="concept-vol1.goal.db66ad10f7664d6f", label="Compute-optimal\nfrontier", tooltip="Controlled sweeps fit a compute-optimal balance of about 20 tokens per parameter, so a run whose unique tokens per parameter sit well below it is data-starved and repeats its corpus, which is the regime where selection rather than more compute moves the run toward the frontier."];
"vol1.goal.e177aa17993600de" [id="concept-vol1.goal.e177aa17993600de", label="Accuracy-efficiency\nfrontier", tooltip="Structure-preserving changes can move a dominated model toward the accuracy-efficiency frontier at little quality cost while structure-altering ones trade along it, so the engineer stops at an operating point that meets explicit quality and resource thresholds rather than at a visual knee."];
"vol1.goal.f95de4a67022eefc" [id="concept-vol1.goal.f95de4a67022eefc", label="Compression fits a\ndeployment budget", tooltip="A deployment budget grants memory, time, and energy per result, and compression works three tiers (what the model computes, how many bits each value takes, how the result executes) after identifying the binding term, since a phone vision model spends its frame on arithmetic and LLM decode spends its token on weight bytes."];
"vol1.goal.70eebceb5fb22f60" [id="concept-vol1.goal.70eebceb5fb22f60", label="Structured vs\nunstructured pruning", tooltip="Pruning removes the weights or structures with the smallest loss impact, but only structured removal (channels, heads, layers, or 2:4 groups) yields smaller dense or hardware-supported tensors, and scattered zeros saved in a dense tensor save nothing."];
"vol1.goal.2f405470a16583cf" [id="concept-vol1.goal.2f405470a16583cf", label="Quantization regimes\nand the cliff", tooltip="Accuracy holds on a plateau down to some bit width and then falls off a model-dependent cliff, so post-training quantization over a calibration set comes first and quantization-aware training is spent only when it misses the quality target."];
"vol1.goal.b1ceaa0dab762cc2" [id="concept-vol1.goal.b1ceaa0dab762cc2", label="Accelerator anatomy", tooltip="Every ML accelerator is matrix, vector, and special-function units beside on-chip memory, a wide off-chip path, and a host link, and it wins by spending on dense arithmetic and local storage the transistors a CPU spends on speculation and coherence, which pays only when the workload exposes the supported operation, precision, and parallelism."];
"vol1.goal.1b3acf72c615d5d0" [id="concept-vol1.goal.1b3acf72c615d5d0", label="Matching primitives to\nexecution units", tooltip="Learned layers reduce to element-wise vector work, matrix multiply, and special functions, and each binds to the unit whose reuse matches it, so routing a primitive to the wrong unit collapses throughput to a fraction of peak."];
"vol1.goal.a720e1dcdcaddf57" [id="concept-vol1.goal.a720e1dcdcaddf57", label="Operand-supply\nhierarchy", tooltip="Delivered throughput is set by where operands live, with registers and SRAM supplying the array at its rate while HBM, host memory over PCIe, and flash fall off a bandwidth taper, so the diagnostic is traffic across each boundary, not capacity alone."];
"vol1.goal.4719f2b7dc11a4b0" [id="concept-vol1.goal.4719f2b7dc11a4b0", label="Energy ladder", tooltip="A DRAM access costs on the order of a hundred times an arithmetic operation or an on-chip SRAM read, so data movement, not arithmetic, is the primary energy target, and locality structures such as systolic arrays earn their area by avoiding the costliest event on the ladder."];
"vol1.goal.3e20ca58b393f0d8" [id="concept-vol1.goal.3e20ca58b393f0d8", label="Measurement validity", tooltip="Every speed, size, or energy number holds only for the conditions the measurement fixed (warm or cold, batch size, curated or deployed inputs, burst or sustained), so a benchmark is a proxy and the first question is what it does not measure."];
"vol1.goal.0cfff17de5168e45" [id="concept-vol1.goal.0cfff17de5168e45", label="Benchmark specification", tooltip="A claim becomes testable only when the benchmark fixes the input and output boundary, a quality floor, the model and runtime, the metrics, an open-loop synchronized harness, and recorded run rules, and a number reported without them cannot be reproduced or refuted."];
"vol1.goal.f9adbae47fd049ad" [id="concept-vol1.goal.f9adbae47fd049ad", label="Benchmark granularity", tooltip="Micro-benchmarks isolate kernels, macro-benchmarks expose composition across a model, and end-to-end benchmarks time the full request path, and a component speedup is diluted by every stage it does not touch."];
"vol1.goal.1a75ec7f64d30329" [id="concept-vol1.goal.1a75ec7f64d30329", label="Latency distribution\nand the SLO", tooltip="Mean latency hides the tail, so serving benchmarks report percentiles under a stated offered load and judge them against an SLO (a target for a named indicator, distinct from a contractual SLA), and generative workloads report time to first token and time per output token together."];
"vol1.goal.75f51c154f2d0e73" [id="concept-vol1.goal.75f51c154f2d0e73", label="Online serving", tooltip="Once a model answers live requests the objective flips from long-run throughput to per-request latency at an SLO percentile, batch-one execution exposes weight traffic and launch overhead, and the machine target shifts from maximum utilization to headroom."];
"vol1.goal.3576105a3980e7b1" [id="concept-vol1.goal.3576105a3980e7b1", label="Latency budget", tooltip="End-to-end latency is a zero-sum budget spent serially on ingress, deserialization, preprocessing, transfer, queueing, inference, postprocessing, and egress and met at a stated quantile, so a faster model yields far less end-to-end gain when host stages dominate."];
"vol1.goal.5ae1d9da4b371bd2" [id="concept-vol1.goal.5ae1d9da4b371bd2", label="Queueing and capacity\nheadroom", tooltip="Little's law sizes the in-flight population and the M/M/1 model shows time in system rising nonlinearly with utilization, so capacity is sized as the utilization a percentile SLO permits, and under overload only admission control or graceful degradation preserve latency."];
"vol1.goal.fadc9f2400a193cf" [id="concept-vol1.goal.fadc9f2400a193cf", label="Operations loop", tooltip="Every production model runs detect, diagnose, decide, release, and recover, each step a control with a concrete machine cost, across three interfaces (data-model consistency, model-infrastructure parity, production feedback) where debt accumulates when a boundary erodes."];
"vol1.goal.abc2a696138bd679" [id="concept-vol1.goal.abc2a696138bd679", label="Layered monitoring and\ndetection delay", tooltip="Silent failure is made visible only by layered monitoring (infrastructure telemetry, input checks, label-free drift statistics, outcome metrics joined to matured labels), and confirmation speed is bounded by labeled-outcome arrival, so drift signals must route to an owner with a deadline."];
"vol1.goal.e0d3338f7e0f2837" [id="concept-vol1.goal.e0d3338f7e0f2837", label="Safe release and tested\nrollback", tooltip="A validated checkpoint is not yet a safe release: exposure is staged (shadow, canary, blue-green), every node is verified to run the intended version, and rollback is tiered, tested, and state-aware, because cached state survives a weights-only revert."];
"vol1.goal.0655c99a60bd6f2e" [id="concept-vol1.goal.0655c99a60bd6f2e", label="Release safety costs\nresident memory", tooltip="Every shadow, canary, A/B arm, or standby keeps a second full model copy resident regardless of its traffic share, so release strategy is a memory decision for capacity-bound models and must be scheduled together with retraining on one node."];
"vol1.goal.738015edf6e3f074" [id="concept-vol1.goal.738015edf6e3f074", label="Proxy misalignment", tooltip="A model can pass verification while failing validation because harm enters through an incomplete specification: proxy features carry protected signal, proxy targets encode the inequity they measure, and an optimized proxy decouples from the goal while every health check stays green."];
"vol1.goal.a6db8eaaa7476c3b" [id="concept-vol1.goal.a6db8eaaa7476c3b", label="Fairness criteria as\nrelease gates", tooltip="Disaggregated evaluation turns fairness into a release gate with per-slice demographic parity, equal opportunity, or equalized odds, criteria that cannot all hold under unequal base rates, so the criterion is a justified policy choice and each slice test returns pass, fail, or insufficient evidence."];
"vol1.goal.3c0cdec9706c62e9" [id="concept-vol1.goal.3c0cdec9706c62e9", label="Fairness mitigation and\nits price", tooltip="A disparity is closed before training (reweighting), during training (adversarial debiasing), or after training (group thresholds), and each choice is a point on a fairness-accuracy frontier whose cost must be stated as a number."];
"vol1.goal.fa690d63232e3a9e" [id="concept-vol1.goal.fa690d63232e3a9e", label="Bias feedback loops", tooltip="When decisions censor future labels, disparity evolves geometrically across retraining intervals, so a gate passed at launch is a statement about the first interval, the feedback factor fitted from audits projects the breach, and randomized exploration is the serving cost that keeps it below one."];
