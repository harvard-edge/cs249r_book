<https://mlsysbook.ai/taxonomy/area/efficiency> a skos:Collection ;
  skos:prefLabel "Performance, efficiency & benchmarking"@en ;
  skos:notation "Q1" ;
  skos:scopeNote "Measuring and benchmarking where time, memory, and energy go, and the cross-layer techniques whose primary purpose is to reduce them, such as compression and hardware-aware design."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/profiling-utilization>, <https://mlsysbook.ai/taxonomy/subject/system-benchmarking>, <https://mlsysbook.ai/taxonomy/subject/model-compression>, <https://mlsysbook.ai/taxonomy/subject/hardware-aware-design> .

<https://mlsysbook.ai/taxonomy/subject/profiling-utilization> a skos:Collection ;
  skos:prefLabel "Profiling & utilization"@en ;
  skos:notation "Q1.1" ;
  skos:definition "Measuring where execution time and resources go under a stated workload, and expressing how much of the hardware's capacity does useful model work."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.profiling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.execution-time>, <https://mlsysbook.ai/taxonomy/concept/mlsys.utilization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-flops-utilization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.bottleneck-analysis>, <https://mlsysbook.ai/taxonomy/concept/mlsys.training-goodput> .

<https://mlsysbook.ai/taxonomy/subject/system-benchmarking> a skos:Collection ;
  skos:prefLabel "System benchmarking"@en ;
  skos:notation "Q1.2" ;
  skos:definition "Measuring training and inference system performance under specified workloads, quality targets, load scenarios, and run rules so results are comparable."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.benchmark>, <https://mlsysbook.ai/taxonomy/concept/mlsys.time-to-train>, <https://mlsysbook.ai/taxonomy/concept/mlsys.inference-load-scenario>, <https://mlsysbook.ai/taxonomy/concept/mlsys.benchmark-representativeness>, <https://mlsysbook.ai/taxonomy/concept/mlsys.performance-regression-testing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.measurement-variability> .

<https://mlsysbook.ai/taxonomy/subject/model-compression> a skos:Collection ;
  skos:prefLabel "Model compression"@en ;
  skos:notation "Q1.3" ;
  skos:definition "Techniques that shrink a trained or training model's parameters, precision, or rank to reduce memory, compute, and latency at a measured cost in quality."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.quantization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sparsity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.distillation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.pruning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.structured-pruning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.low-rank-factorization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.quantization-aware-training>, <https://mlsysbook.ai/taxonomy/concept/mlsys.post-training-quantization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.weight-only-quantization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.activation-outliers>, <https://mlsysbook.ai/taxonomy/concept/mlsys.kv-cache-quantization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.nm-sparsity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.activation-sparsity> .

<https://mlsysbook.ai/taxonomy/subject/hardware-aware-design> a skos:Collection ;
  skos:prefLabel "Hardware-aware model design"@en ;
  skos:notation "Q1.4" ;
  skos:definition "Choosing or searching model architectures against a target device's measured cost, so that quality and efficiency are optimized together rather than compressed after the fact."@en ;
