@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix mlsys: <https://mlsysbook.ai/taxonomy/relation/> .

<https://mlsysbook.ai/taxonomy/scheme> a skos:ConceptScheme ;
  dct:title "ML Systems Taxonomy"@en ;
  owl:versionInfo "0.2-draft" ;
  dct:creator "Vijay Janapa Reddi"@en ;
  dct:license <https://creativecommons.org/licenses/by-nc-sa/4.0/> ;
  dct:description "Editorial draft for expert review; not a claim of completeness or consensus."@en .

mlsys:specializes a owl:ObjectProperty ;
  owl:subPropertyOf skos:related ;
  skos:prefLabel "is a kind of"@en ;
  skos:definition "A is a narrower or more specific case of B."@en .

mlsys:part-of a owl:ObjectProperty ;
  owl:subPropertyOf skos:related ;
  skos:prefLabel "is part of"@en ;
  skos:definition "A is a component or stage within B."@en .

mlsys:alternative-to a owl:ObjectProperty ;
  owl:subPropertyOf skos:related ;
  skos:prefLabel "is an alternative to"@en ;
  skos:definition "A and B are competing options for the same job (symmetric)."@en .

mlsys:requires a owl:ObjectProperty ;
  owl:subPropertyOf skos:related ;
  skos:prefLabel "requires"@en ;
  skos:definition "A cannot work, or cannot be correct, without B."@en .

mlsys:uses a owl:ObjectProperty ;
  owl:subPropertyOf skos:related ;
  skos:prefLabel "uses"@en ;
  skos:definition "A commonly relies on B as a building block, without strict necessity."@en .

mlsys:implements a owl:ObjectProperty ;
  owl:subPropertyOf skos:related ;
  skos:prefLabel "implements"@en ;
  skos:definition "A is a concrete mechanism or technique that realizes B."@en .

mlsys:enables a owl:ObjectProperty ;
  owl:subPropertyOf skos:related ;
  skos:prefLabel "enables"@en ;
  skos:definition "A makes B possible or practical."@en .

mlsys:produces a owl:ObjectProperty ;
  owl:subPropertyOf skos:related ;
  skos:prefLabel "produces"@en ;
  skos:definition "A creates or emits B as an output or artifact."@en .

mlsys:reduces a owl:ObjectProperty ;
  owl:subPropertyOf skos:related ;
  skos:prefLabel "reduces"@en ;
  skos:definition "A lowers the amount, cost, or magnitude of B."@en .

mlsys:increases a owl:ObjectProperty ;
  owl:subPropertyOf skos:related ;
  skos:prefLabel "increases"@en ;
  skos:definition "A raises the amount, cost, or magnitude of B."@en .

mlsys:determines a owl:ObjectProperty ;
  owl:subPropertyOf skos:related ;
  skos:prefLabel "determines"@en ;
  skos:definition "A sets or shapes B (direction not simply up/down)."@en .

mlsys:limits a owl:ObjectProperty ;
  owl:subPropertyOf skos:related ;
  skos:prefLabel "limits"@en ;
  skos:definition "A places a limit or ceiling on B."@en .

mlsys:trades-off a owl:ObjectProperty ;
  owl:subPropertyOf skos:related ;
  skos:prefLabel "trades off against"@en ;
  skos:definition "Improving A tends to worsen B, or vice versa (symmetric)."@en .

mlsys:measures a owl:ObjectProperty ;
  owl:subPropertyOf skos:related ;
  skos:prefLabel "measures"@en ;
  skos:definition "A quantifies, evaluates, or tests B."@en .

mlsys:detects a owl:ObjectProperty ;
  owl:subPropertyOf skos:related ;
  skos:prefLabel "detects"@en ;
  skos:definition "A reveals or identifies occurrences of B."@en .

mlsys:causes a owl:ObjectProperty ;
  owl:subPropertyOf skos:related ;
  skos:prefLabel "can cause"@en ;
  skos:definition "A can lead to the failure, harm, or degradation B."@en .

mlsys:mitigates a owl:ObjectProperty ;
  owl:subPropertyOf skos:related ;
  skos:prefLabel "mitigates"@en ;
  skos:definition "A protects against, prevents, or recovers from B."@en .

<https://mlsysbook.ai/taxonomy/group/foundations> a skos:Collection ;
  skos:prefLabel "Foundations"@en ;
  skos:notation "F" ;
  skos:member <https://mlsysbook.ai/taxonomy/area/workloads-requirements>, <https://mlsysbook.ai/taxonomy/area/models-architectures>, <https://mlsysbook.ai/taxonomy/area/system-models> .

<https://mlsysbook.ai/taxonomy/area/workloads-requirements> a skos:Collection ;
  skos:prefLabel "Workloads & requirements"@en ;
  skos:notation "F1" ;
  skos:scopeNote "Targets, workload descriptions, and objectives that every later engineering choice is judged against."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/requirements-slos>, <https://mlsysbook.ai/taxonomy/subject/workload-characterization>, <https://mlsysbook.ai/taxonomy/subject/objectives-decisions> .

<https://mlsysbook.ai/taxonomy/subject/requirements-slos> a skos:Collection ;
  skos:prefLabel "Requirements, SLOs & baselines"@en ;
  skos:notation "F1.1" ;
  skos:definition "Stating measurable targets for a system's behavior and service, and the baselines and budgets against which they are judged."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.requirements>, <https://mlsysbook.ai/taxonomy/concept/mlsys.baseline>, <https://mlsysbook.ai/taxonomy/concept/mlsys.slo>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sli>, <https://mlsysbook.ai/taxonomy/concept/mlsys.error-budget>, <https://mlsysbook.ai/taxonomy/concept/mlsys.latency-budget> .

<https://mlsysbook.ai/taxonomy/subject/workload-characterization> a skos:Collection ;
  skos:prefLabel "Workload characterization"@en ;
  skos:notation "F1.2" ;
  skos:definition "Describing a workload's compute, memory, data, and traffic demands, and where it runs, so it can be engineered and provisioned for."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.workload>, <https://mlsysbook.ai/taxonomy/concept/mlsys.placement>, <https://mlsysbook.ai/taxonomy/concept/mlsys.flop-accounting>, <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-footprint>, <https://mlsysbook.ai/taxonomy/concept/mlsys.workload-trace> .

<https://mlsysbook.ai/taxonomy/subject/objectives-decisions> a skos:Collection ;
  skos:prefLabel "Objectives, proxies & decision policies"@en ;
  skos:notation "F1.3" ;
  skos:definition "How learned outputs become decisions, how optimized proxies relate to intended outcomes, and how competing objectives are traded."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.proxy-objective>, <https://mlsysbook.ai/taxonomy/concept/mlsys.decision-policy>, <https://mlsysbook.ai/taxonomy/concept/mlsys.cost-sensitive-decision>, <https://mlsysbook.ai/taxonomy/concept/mlsys.pareto-frontier> .

<https://mlsysbook.ai/taxonomy/area/models-architectures> a skos:Collection ;
  skos:prefLabel "Models & architectures"@en ;
  skos:notation "F2" ;
  skos:scopeNote "Model families, building blocks, and architectural choices viewed as workloads, plus the artifacts that carry them."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/model-families>, <https://mlsysbook.ai/taxonomy/subject/architecture-blocks>, <https://mlsysbook.ai/taxonomy/subject/conditional-computation>, <https://mlsysbook.ai/taxonomy/subject/efficient-sequence-models>, <https://mlsysbook.ai/taxonomy/subject/model-artifacts> .

<https://mlsysbook.ai/taxonomy/subject/model-families> a skos:Collection ;
  skos:prefLabel "Model families"@en ;
  skos:notation "F2.1" ;
  skos:definition "The classical and neural model regimes, with their inductive assumptions, viewed as workloads with characteristic compute and memory profiles."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.linear-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.tree-ensemble>, <https://mlsysbook.ai/taxonomy/concept/mlsys.kernel-method>, <https://mlsysbook.ai/taxonomy/concept/mlsys.nearest-neighbor>, <https://mlsysbook.ai/taxonomy/concept/mlsys.neural-network>, <https://mlsysbook.ai/taxonomy/concept/mlsys.inductive-bias>, <https://mlsysbook.ai/taxonomy/concept/mlsys.transformer>, <https://mlsysbook.ai/taxonomy/concept/mlsys.recommendation-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.diffusion-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.multimodal-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.gan>, <https://mlsysbook.ai/taxonomy/concept/mlsys.graph-neural-network>, <https://mlsysbook.ai/taxonomy/concept/mlsys.large-language-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.transformer-variants> .

<https://mlsysbook.ai/taxonomy/subject/architecture-blocks> a skos:Collection ;
  skos:prefLabel "Architecture building blocks"@en ;
  skos:notation "F2.2" ;
  skos:definition "The layer-level operations from which neural models are composed and whose shapes determine compute, memory, and data movement."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.embeddings>, <https://mlsysbook.ai/taxonomy/concept/mlsys.attention>, <https://mlsysbook.ai/taxonomy/concept/mlsys.position-encoding>, <https://mlsysbook.ai/taxonomy/concept/mlsys.tokenization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.convolution>, <https://mlsysbook.ai/taxonomy/concept/mlsys.recurrence>, <https://mlsysbook.ai/taxonomy/concept/mlsys.normalization-layer>, <https://mlsysbook.ai/taxonomy/concept/mlsys.depthwise-separable-convolution>, <https://mlsysbook.ai/taxonomy/concept/mlsys.modality-encoder> .

<https://mlsysbook.ai/taxonomy/subject/conditional-computation> a skos:Collection ;
  skos:prefLabel "Sparse & conditional computation"@en ;
  skos:notation "F2.3" ;
  skos:definition "Model designs in which the computation performed varies per input, such as mixture-of-experts routing and early exit."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.mixture-of-experts>, <https://mlsysbook.ai/taxonomy/concept/mlsys.expert-routing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.expert-capacity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.load-balancing-loss>, <https://mlsysbook.ai/taxonomy/concept/mlsys.active-parameters>, <https://mlsysbook.ai/taxonomy/concept/mlsys.early-exit> .

<https://mlsysbook.ai/taxonomy/subject/efficient-sequence-models> a skos:Collection ;
  skos:prefLabel "Long-context & efficient sequence models"@en ;
  skos:notation "F2.4" ;
  skos:definition "Sequence architectures that change how cost scales with context length, co-designed with the memory and compute they demand."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.sliding-window-attention>, <https://mlsysbook.ai/taxonomy/concept/mlsys.linear-attention>, <https://mlsysbook.ai/taxonomy/concept/mlsys.state-space-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.grouped-query-attention>, <https://mlsysbook.ai/taxonomy/concept/mlsys.context-extension>, <https://mlsysbook.ai/taxonomy/concept/mlsys.context>, <https://mlsysbook.ai/taxonomy/concept/mlsys.context-degradation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.dynamic-sparse-attention> .

<https://mlsysbook.ai/taxonomy/subject/model-artifacts> a skos:Collection ;
  skos:prefLabel "Model artifacts & formats"@en ;
  skos:notation "F2.5" ;
  skos:definition "The weights, graphs, metadata, and interface contracts that make a trained model a portable, loadable, deployable artifact."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.model-artifact>, <https://mlsysbook.ai/taxonomy/concept/mlsys.weight-serialization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-exchange-format>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-export>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-signature> .

<https://mlsysbook.ai/taxonomy/area/system-models> a skos:Collection ;
  skos:prefLabel "Quantitative system models"@en ;
  skos:notation "F3" ;
  skos:scopeNote "Analytical and empirical models used to bound performance, capacity, and training cost before or instead of measuring."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/roofline-locality>, <https://mlsysbook.ai/taxonomy/subject/speedup-limits>, <https://mlsysbook.ai/taxonomy/subject/queueing-models>, <https://mlsysbook.ai/taxonomy/subject/scaling-laws> .

<https://mlsysbook.ai/taxonomy/subject/roofline-locality> a skos:Collection ;
  skos:prefLabel "Roofline, performance models & simulation"@en ;
  skos:notation "F3.1" ;
  skos:definition "Bound-based reasoning about whether computation is limited by arithmetic or data movement, and how reuse changes that limit."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.arithmetic-intensity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.roofline>, <https://mlsysbook.ai/taxonomy/concept/mlsys.locality>, <https://mlsysbook.ai/taxonomy/concept/mlsys.ridge-point>, <https://mlsysbook.ai/taxonomy/concept/mlsys.bound-regime>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-movement-energy>, <https://mlsysbook.ai/taxonomy/concept/mlsys.analytical-performance-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.performance-simulation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-fidelity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.execution-trace> .

<https://mlsysbook.ai/taxonomy/subject/speedup-limits> a skos:Collection ;
  skos:prefLabel "Amdahl's law & scaling efficiency"@en ;
  skos:notation "F3.2" ;
  skos:definition "Models of how much speedup added parallel or accelerated resources can deliver, given serial work and fixed or growing problem sizes."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.serial-fraction>, <https://mlsysbook.ai/taxonomy/concept/mlsys.amdahls-law>, <https://mlsysbook.ai/taxonomy/concept/mlsys.strong-scaling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.weak-scaling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.parallel-efficiency> .

<https://mlsysbook.ai/taxonomy/subject/queueing-models> a skos:Collection ;
  skos:prefLabel "Queueing & capacity models"@en ;
  skos:notation "F3.3" ;
  skos:definition "Models relating arrivals, service rates, utilization, and waiting, used to predict latency and capacity under load."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.arrival-rate>, <https://mlsysbook.ai/taxonomy/concept/mlsys.service-capacity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.queueing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.littles-law>, <https://mlsysbook.ai/taxonomy/concept/mlsys.latency-throughput-curve>, <https://mlsysbook.ai/taxonomy/concept/mlsys.arrival-burstiness>, <https://mlsysbook.ai/taxonomy/concept/mlsys.finite-buffer> .

<https://mlsysbook.ai/taxonomy/subject/scaling-laws> a skos:Collection ;
  skos:prefLabel "Scaling laws & compute-optimal allocation"@en ;
  skos:notation "F3.4" ;
  skos:definition "Empirical relationships among parameters, data, and compute and observed quality, used to allocate training budgets."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.scaling-laws>, <https://mlsysbook.ai/taxonomy/concept/mlsys.compute-optimal-allocation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.training-compute-estimate>, <https://mlsysbook.ai/taxonomy/concept/mlsys.inference-compute-estimate> .

<https://mlsysbook.ai/taxonomy/group/stack> a skos:Collection ;
  skos:prefLabel "Stack"@en ;
  skos:notation "S" ;
  skos:member <https://mlsysbook.ai/taxonomy/area/hardware>, <https://mlsysbook.ai/taxonomy/area/software-stack>, <https://mlsysbook.ai/taxonomy/area/distributed>, <https://mlsysbook.ai/taxonomy/area/infrastructure-fleet> .

<https://mlsysbook.ai/taxonomy/area/hardware> a skos:Collection ;
  skos:prefLabel "Hardware & accelerators"@en ;
  skos:notation "S1" ;
  skos:scopeNote "Compute, memory, interconnect, and power characteristics of ML hardware from datacenter accelerators to microcontrollers."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/accelerator-architecture>, <https://mlsysbook.ai/taxonomy/subject/memory-systems>, <https://mlsysbook.ai/taxonomy/subject/node-interconnect>, <https://mlsysbook.ai/taxonomy/subject/chip-power-thermal>, <https://mlsysbook.ai/taxonomy/subject/edge-embedded-hardware> .

<https://mlsysbook.ai/taxonomy/subject/accelerator-architecture> a skos:Collection ;
  skos:prefLabel "Accelerator architecture"@en ;
  skos:notation "S1.1" ;
  skos:definition "The organization of processors specialized for ML: execution units, threading, dataflow, and the throughput they provide."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.accelerator-execution-architecture>, <https://mlsysbook.ai/taxonomy/concept/mlsys.compute-throughput>, <https://mlsysbook.ai/taxonomy/concept/mlsys.systolic-array>, <https://mlsysbook.ai/taxonomy/concept/mlsys.matrix-unit>, <https://mlsysbook.ai/taxonomy/concept/mlsys.simt>, <https://mlsysbook.ai/taxonomy/concept/mlsys.dataflow>, <https://mlsysbook.ai/taxonomy/concept/mlsys.domain-specific-architecture>, <https://mlsysbook.ai/taxonomy/concept/mlsys.compute-in-memory>, <https://mlsysbook.ai/taxonomy/concept/mlsys.cpu-execution-architecture> .

<https://mlsysbook.ai/taxonomy/subject/memory-systems> a skos:Collection ;
  skos:prefLabel "Memory hierarchy & bandwidth"@en ;
  skos:notation "S1.2" ;
  skos:definition "The storage levels of an ML processor, from registers and SRAM to HBM, and the capacity and bandwidth limits they impose."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-hierarchy>, <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-capacity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-bandwidth>, <https://mlsysbook.ai/taxonomy/concept/mlsys.hbm>, <https://mlsysbook.ai/taxonomy/concept/mlsys.on-chip-sram>, <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-wall>, <https://mlsysbook.ai/taxonomy/concept/mlsys.embedding-cache>, <https://mlsysbook.ai/taxonomy/concept/mlsys.emerging-nvm> .

<https://mlsysbook.ai/taxonomy/subject/node-interconnect> a skos:Collection ;
  skos:prefLabel "Host-device & scale-up interconnect"@en ;
  skos:notation "S1.3" ;
  skos:definition "Links that move data between hosts and accelerators and among accelerators within a node or rack-scale domain."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.host-device-interconnect>, <https://mlsysbook.ai/taxonomy/concept/mlsys.scale-up-interconnect>, <https://mlsysbook.ai/taxonomy/concept/mlsys.coherent-interconnect>, <https://mlsysbook.ai/taxonomy/concept/mlsys.peer-to-peer-transfer> .

<https://mlsysbook.ai/taxonomy/subject/chip-power-thermal> a skos:Collection ;
  skos:prefLabel "Chip power & thermal limits"@en ;
  skos:notation "S1.4" ;
  skos:definition "Electrical and thermal limits at the chip and board level, and the runtime controls that keep execution within them."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.power-delivery>, <https://mlsysbook.ai/taxonomy/concept/mlsys.thermal-dynamics>, <https://mlsysbook.ai/taxonomy/concept/mlsys.tdp>, <https://mlsysbook.ai/taxonomy/concept/mlsys.dvfs>, <https://mlsysbook.ai/taxonomy/concept/mlsys.dark-silicon>, <https://mlsysbook.ai/taxonomy/concept/mlsys.power-capping>, <https://mlsysbook.ai/taxonomy/concept/mlsys.duty-cycling> .

<https://mlsysbook.ai/taxonomy/subject/edge-embedded-hardware> a skos:Collection ;
  skos:prefLabel "Edge & embedded hardware"@en ;
  skos:notation "S1.5" ;
  skos:definition "Hardware for on-device ML, from mobile SoCs to microcontrollers, where memory and energy per inference bind."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.microcontroller>, <https://mlsysbook.ai/taxonomy/concept/mlsys.heterogeneous-soc>, <https://mlsysbook.ai/taxonomy/concept/mlsys.edge-npu>, <https://mlsysbook.ai/taxonomy/concept/mlsys.on-device-memory-budget>, <https://mlsysbook.ai/taxonomy/concept/mlsys.intermittent-computing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sensor-interconnect> .

<https://mlsysbook.ai/taxonomy/area/software-stack> a skos:Collection ;
  skos:prefLabel "Frameworks, compilers & runtimes"@en ;
  skos:notation "S2" ;
  skos:scopeNote "The software layers between model code and hardware: programming models, operators, compilers, runtimes, and numerics."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/programming-models>, <https://mlsysbook.ai/taxonomy/subject/tensor-operators>, <https://mlsysbook.ai/taxonomy/subject/gpu-programming>, <https://mlsysbook.ai/taxonomy/subject/ml-compilers>, <https://mlsysbook.ai/taxonomy/subject/runtime-dispatch>, <https://mlsysbook.ai/taxonomy/subject/data-loading>, <https://mlsysbook.ai/taxonomy/subject/numerics> .

<https://mlsysbook.ai/taxonomy/subject/programming-models> a skos:Collection ;
  skos:prefLabel "ML frameworks & programming models"@en ;
  skos:notation "S2.1" ;
  skos:definition "The abstractions with which ML programs are written: tensors, computation graphs, execution modes, and automatic differentiation."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.autodiff>, <https://mlsysbook.ai/taxonomy/concept/mlsys.tensor>, <https://mlsysbook.ai/taxonomy/concept/mlsys.computation-graph>, <https://mlsysbook.ai/taxonomy/concept/mlsys.eager-execution>, <https://mlsysbook.ai/taxonomy/concept/mlsys.tracing-jit>, <https://mlsysbook.ai/taxonomy/concept/mlsys.function-transformations>, <https://mlsysbook.ai/taxonomy/concept/mlsys.task-actor-runtime>, <https://mlsysbook.ai/taxonomy/concept/mlsys.single-vs-multi-controller>, <https://mlsysbook.ai/taxonomy/concept/mlsys.embedded-dsl>, <https://mlsysbook.ai/taxonomy/concept/mlsys.differentiable-programming>, <https://mlsysbook.ai/taxonomy/concept/mlsys.llm-training-framework>, <https://mlsysbook.ai/taxonomy/concept/mlsys.python-gil> .

<https://mlsysbook.ai/taxonomy/subject/tensor-operators> a skos:Collection ;
  skos:prefLabel "Tensor operators & memory layout"@en ;
  skos:notation "S2.2" ;
  skos:definition "Implementations of core tensor operations, such as matrix multiply, convolution, and attention, and the layouts that govern their efficiency."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.tensor-layout>, <https://mlsysbook.ai/taxonomy/concept/mlsys.matrix-multiply>, <https://mlsysbook.ai/taxonomy/concept/mlsys.io-aware-attention>, <https://mlsysbook.ai/taxonomy/concept/mlsys.convolution-lowering>, <https://mlsysbook.ai/taxonomy/concept/mlsys.kernel-library>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sparse-tensor-kernels>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sparse-ragged-tensors> .

<https://mlsysbook.ai/taxonomy/subject/gpu-programming> a skos:Collection ;
  skos:prefLabel "Kernel & GPU programming model"@en ;
  skos:notation "S2.3" ;
  skos:definition "How kernels are written for parallel accelerators: the thread hierarchy, memory access patterns, occupancy, asynchronous data movement, and programming the matrix units."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.thread-hierarchy>, <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-coalescing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.occupancy>, <https://mlsysbook.ai/taxonomy/concept/mlsys.async-data-movement>, <https://mlsysbook.ai/taxonomy/concept/mlsys.matrix-engine-programming> .

<https://mlsysbook.ai/taxonomy/subject/ml-compilers> a skos:Collection ;
  skos:prefLabel "ML compilers & kernel optimization"@en ;
  skos:notation "S2.4" ;
  skos:definition "Transforming model programs through intermediate representations into optimized kernels for target hardware."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.compilation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.fusion>, <https://mlsysbook.ai/taxonomy/concept/mlsys.tiling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.intermediate-representation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.autotuning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.kernel-dsl>, <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-planning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.persistent-kernel>, <https://mlsysbook.ai/taxonomy/concept/mlsys.graph-superoptimization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.dynamic-shapes>, <https://mlsysbook.ai/taxonomy/concept/mlsys.rule-based-graph-rewriting> .

<https://mlsysbook.ai/taxonomy/subject/runtime-dispatch> a skos:Collection ;
  skos:prefLabel "Runtime execution & dispatch"@en ;
  skos:notation "S2.5" ;
  skos:definition "How a runtime launches and orders device work and manages device memory during execution."@en ;
