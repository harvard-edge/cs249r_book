/.quarto/
/_freeze/
**/*.quarto_ipynb

# PDF build artifacts
*.tex
*.aux
*.log

# Allow checked-in LaTeX include sources used by chapters (for example, TikZ includes).
!contents/**/includes/*.tex

!tex/*.tex
!vol*/tex/*.tex
!**/tex/*.tex
!**/tex/tikz/*.tex

# Chapter study sheets are hand-written LaTeX (their *_studysheet_numbers.tex stays generated and ignored).
!**/*_studysheet.tex
