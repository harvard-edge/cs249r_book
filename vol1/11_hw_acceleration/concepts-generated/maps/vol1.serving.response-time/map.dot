digraph concepts {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.85", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#88949d", penwidth=1.15, fontname="Helvetica Neue", fontsize=16, margin="0.18,0.12"];
edge [fontname="Helvetica Neue", fontsize=12, color="#7a858e", fontcolor="#47535d", arrowsize=0.65];
"vol1.serving.latency" [id="concept-vol1.serving.latency", label="Request latency", tooltip="The elapsed time from arrival to response includes waiting, host work, and model execution. The target applies to the complete request.", fillcolor="#fcebed", color="#a51c30", penwidth=1.8];
"vol1.serving.queue" [id="concept-vol1.serving.queue", label="Queueing delay", tooltip="Requests wait when arrivals compete for busy resources. Near saturation, small increases in utilization can produce large increases in waiting."];
"vol1.serving.formation" [id="concept-vol1.serving.formation", label="Batch formation delay", tooltip="A request may wait while the server collects a batch. This delay spends latency allowance before the model runs."];
"vol1.serving.execution" [id="concept-vol1.serving.execution", label="Model execution time", tooltip="Execution includes arithmetic and moving operands. A resource bound gives a lower limit; profiling explains additional overhead."];
"vol1.serving.host" [id="concept-vol1.serving.host", label="Host-path overhead", tooltip="Serialization, preprocessing, transfers, and runtime dispatch can dominate the request path even when accelerator kernels are fast."];
"vol1.serving.utilization" [id="concept-vol1.serving.utilization", label="Utilization", tooltip="Utilization compares offered work with available service capacity. High utilization leaves little room for variation in arrivals and execution."];
"vol1.serving.batching" [id="concept-vol1.serving.batching", label="Batching", tooltip="Grouping requests shares fixed work and can reuse weights. It can improve capacity while adding formation delay; the useful batch is constrained by latency and memory."];
"vol1.hardware.transfer" [id="concept-vol1.hardware.transfer", label="Operand transfer time", tooltip="Supplying operands takes time. For a fixed memory level, the transfer lower bound is bytes moved divided by bandwidth."];
"vol1.hardware.compute" [id="concept-vol1.hardware.compute", label="Arithmetic time", tooltip="The arithmetic lower bound is the required operations divided by the available compute rate. Faster operand delivery cannot remove this bound."];
"vol1.serving.arrivals" [id="concept-vol1.serving.arrivals", label="Arrival rate", tooltip="At fixed service capacity, a higher request arrival rate raises utilization. Burstiness also matters for waiting."];
"vol1.serving.capacity" [id="concept-vol1.serving.capacity", label="Serving capacity", tooltip="Service capacity is the rate at which the system can complete work under a specified workload. The latency target constrains how much of that capacity can be used."];
"vol1.serving.bytes" [id="concept-vol1.serving.bytes", label="Weight bytes moved", tooltip="At small decode batches, repeatedly reading model weights can dominate execution. Sharing a weight stream across requests amortizes that traffic."];
"vol1.hardware.bandwidth" [id="concept-vol1.hardware.bandwidth", label="Memory bandwidth", tooltip="Bandwidth limits the rate at which an accelerator receives operands from a given memory level. The relevant level depends on data placement and reuse."];
"vol1.compression.precision" [id="concept-vol1.compression.precision", label="Weight precision", tooltip="Lower precision reduces the bytes needed for weights. It improves runtime only when the execution regime and kernel support let those saved bytes matter."];
"vol1.hardware.intensity" [id="concept-vol1.hardware.intensity", label="Arithmetic intensity", tooltip="Operations per byte moved identifies the compute-versus-bandwidth regime. A suitable batch can reuse weights and raise this ratio."];
"vol1.serving.latency" -> "vol1.serving.queue" [id="relation-vol1.serving.relation-0", label="includes"];
"vol1.serving.latency" -> "vol1.serving.formation" [id="relation-vol1.serving.relation-1", label="includes"];
"vol1.serving.latency" -> "vol1.serving.execution" [id="relation-vol1.serving.relation-2", label="includes"];
"vol1.serving.latency" -> "vol1.serving.host" [id="relation-vol1.serving.relation-3", label="includes"];
"vol1.serving.queue" -> "vol1.serving.utilization" [id="relation-vol1.serving.relation-4", label="rises nonlinearly with"];
"vol1.serving.utilization" -> "vol1.serving.arrivals" [id="relation-vol1.serving.relation-5", label="increases with"];
"vol1.serving.utilization" -> "vol1.serving.capacity" [id="relation-vol1.serving.relation-6", label="falls with greater"];
"vol1.serving.batching" -> "vol1.serving.capacity" [id="relation-vol1.serving.relation-7", label="can increase"];
"vol1.serving.batching" -> "vol1.serving.formation" [id="relation-vol1.serving.relation-8", label="introduces"];
"vol1.serving.batching" -> "vol1.hardware.intensity" [id="relation-vol1.serving.relation-9", label="can increase"];
"vol1.serving.execution" -> "vol1.hardware.transfer" [id="relation-vol1.hardware.relation-10", label="is bounded below by"];
"vol1.serving.execution" -> "vol1.hardware.compute" [id="relation-vol1.hardware.relation-11", label="is bounded below by"];
"vol1.hardware.transfer" -> "vol1.serving.bytes" [id="relation-vol1.hardware.relation-12", label="increases with"];
"vol1.hardware.transfer" -> "vol1.hardware.bandwidth" [id="relation-vol1.hardware.relation-13", label="decreases with greater"];
"vol1.compression.precision" -> "vol1.serving.bytes" [id="relation-vol1.compression.relation-14", label="sets byte width in"];
"vol1.hardware.intensity" -> "vol1.hardware.transfer" [id="relation-vol1.hardware.relation-15", label="reduces relative\nimportance of"];
"vol1.serving.batching" -> "vol1.serving.bytes" [id="relation-vol1.serving.relation-16", label="amortizes across\nrequests"];
}
