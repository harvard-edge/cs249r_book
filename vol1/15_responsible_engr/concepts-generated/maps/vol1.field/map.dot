digraph concepts {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.85", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#88949d", penwidth=1.15, fontname="Helvetica Neue", fontsize=16, margin="0.18,0.12"];
edge [fontname="Helvetica Neue", fontsize=12, color="#7a858e", fontcolor="#47535d", arrowsize=0.65];
"vol1.data.dataset" [id="concept-vol1.data.dataset", label="Training data", tooltip="Examples used to fit model parameters; their coverage and labels help determine learned behavior.", fillcolor="#fcebed", color="#a51c30", penwidth=1.8];
"vol1.model.behavior" [id="concept-vol1.model.behavior", label="Learned behavior", tooltip="The predictions a trained model produces on inputs, whose usefulness and physical deliverability must both be established."];
"vol1.system.execution" [id="concept-vol1.system.execution", label="Execution time", tooltip="Time spent moving data, performing arithmetic, and paying system overhead; the applicable overlap model depends on the execution boundary."];
"vol1.system.capacity" [id="concept-vol1.system.capacity", label="Memory capacity", tooltip="The amount of resident model and runtime state a machine can hold; fitting is a feasibility condition before speed is considered."];
"vol1.system.power" [id="concept-vol1.system.power", label="Power budget", tooltip="The allowed rate of energy consumption, limited by battery supply and heat dissipation."];
"vol1.system.locality" [id="concept-vol1.system.locality", label="Data locality", tooltip="Placing computation near the data when transfer delay or bandwidth makes remote execution infeasible."];
"vol1.lifecycle.requirements" [id="concept-vol1.lifecycle.requirements", label="System requirements", tooltip="Operationally measurable targets and constraints that determine what counts as a successful system."];
"vol1.lifecycle.contract" [id="concept-vol1.lifecycle.contract", label="Stage interface\ncontract", tooltip="A checked specification of the inputs, outputs, and invariants at a pipeline boundary."];
"vol1.lifecycle.gate" [id="concept-vol1.lifecycle.gate", label="Release gate", tooltip="A decision that blocks deployment unless a particular artifact meets declared evaluation thresholds."];
"vol1.data.labels" [id="concept-vol1.data.labels", label="Labels", tooltip="Supervision targets that specify the behavior the model is trained to reproduce."];
"vol1.data.leakage" [id="concept-vol1.data.leakage", label="Data leakage", tooltip="Information crossing training, validation, or test boundaries so evaluation ceases to estimate generalization."];
"vol1.data.pipeline" [id="concept-vol1.data.pipeline", label="Input pipeline", tooltip="The storage, decoding, transformation, and transfer stages that deliver usable examples to the accelerator."];
"vol1.data.parity" [id="concept-vol1.data.parity", label="Training-serving parity", tooltip="Agreement between the feature values produced by training and serving transformations for the same raw request."];
"vol1.computation.matmul" [id="concept-vol1.computation.matmul", label="Matrix multiplication", tooltip="A shared arithmetic primitive for dense layers and lowered neural-network operations."];
"vol1.computation.activations" [id="concept-vol1.computation.activations", label="Saved activations", tooltip="Forward intermediate tensors retained because backward derivative rules need their values."];
"vol1.computation.gradients" [id="concept-vol1.computation.gradients", label="Parameter gradients", tooltip="Derivatives of training loss with respect to parameters, used to update those parameters."];
"vol1.computation.state" [id="concept-vol1.computation.state", label="Training state", tooltip="Resident weights, saved activations, gradients, and optimizer state required during training."];
"vol1.architecture.bias" [id="concept-vol1.architecture.bias", label="Inductive bias", tooltip="A structural assumption encoded by an architecture that restricts its hypothesis space and changes learning and execution costs."];
"vol1.architecture.attention" [id="concept-vol1.architecture.attention", label="Self-attention", tooltip="An operation that lets tokens combine information from other positions; dense score computation grows quadratically with sequence length."];
"vol1.framework.autodiff" [id="concept-vol1.framework.autodiff", label="Reverse-mode autodiff", tooltip="A reverse traversal that computes parameter gradients from a scalar loss using recorded forward operations."];
"vol1.framework.dispatch" [id="concept-vol1.framework.dispatch", label="Dispatch overhead", tooltip="Host-side work paid to submit operations; many short kernels can make it dominate device execution."];
"vol1.framework.fusion" [id="concept-vol1.framework.fusion", label="Kernel fusion", tooltip="Combining operations to reduce dispatches and keep intermediate values in local storage when dependencies and resource limits permit."];
"vol1.training.quality-time" [id="concept-vol1.training.quality-time", label="Time to target quality", tooltip="Elapsed training time needed to reach a stated quality threshold, coupling convergence work with achieved execution rate."];
"vol1.training.mfu" [id="concept-vol1.training.mfu", label="Model FLOPs utilization", tooltip="Achieved model arithmetic divided by the relevant peak arithmetic rate; useful work differs from device busy time."];
"vol1.training.checkpoint" [id="concept-vol1.training.checkpoint", label="Activation\ncheckpointing", tooltip="Retaining selected forward tensors and recomputing discarded intermediates during backward to reduce activation memory."];
"vol1.selection.scoring" [id="concept-vol1.selection.scoring", label="Selection overhead", tooltip="The time or resource cost of scoring and filtering examples before or during training."];
"vol1.selection.subset" [id="concept-vol1.selection.subset", label="Training subset", tooltip="Selected examples retained for training, whose value must be checked against quality and coverage constraints."];
"vol1.selection.balance" [id="concept-vol1.selection.balance", label="Model-data allocation", tooltip="Allocation of a fixed training compute budget between parameter count and training data within a fitted scaling regime."];
"vol1.compression.quantization" [id="concept-vol1.compression.quantization", label="Quantization", tooltip="Representing tensors at lower precision to reduce storage and traffic, subject to quality and runtime support."];
"vol1.compression.sparsity" [id="concept-vol1.compression.sparsity", label="Weight sparsity", tooltip="Zero-valued or removed weights whose storage and execution benefit depends on pattern, metadata, and sparse kernels."];
"vol1.hardware.tiling" [id="concept-vol1.hardware.tiling", label="Tiling", tooltip="Partitioning operations so operand blocks can be reused in local memory rather than repeatedly fetched from off-chip memory."];
"vol1.hardware.reuse" [id="concept-vol1.hardware.reuse", label="Operand reuse", tooltip="Using a locally retained operand for multiple arithmetic operations before fetching it again."];
"vol1.hardware.amdahl" [id="concept-vol1.hardware.amdahl", label="Accelerated fraction", tooltip="The fraction of baseline end-to-end time that an optimization can accelerate; the remaining time limits total gain."];
"vol1.measurement.protocol" [id="concept-vol1.measurement.protocol", label="Benchmark protocol", tooltip="The workload, software, hardware, measurement boundary, and run rules required to interpret and reproduce a result."];
"vol1.measurement.quality" [id="concept-vol1.measurement.quality", label="Model quality", tooltip="Task-relevant predictive performance evaluated over appropriate distributions and subgroups, with uncertainty."];
"vol1.measurement.slo" [id="concept-vol1.measurement.slo", label="Latency SLO", tooltip="A target for the fraction of requests completing within a stated latency boundary."];
"vol1.operations.drift" [id="concept-vol1.operations.drift", label="Distribution shift", tooltip="A change in serving inputs or outcomes relative to the evaluated distribution; input divergence alone does not establish quality loss."];
"vol1.operations.monitor" [id="concept-vol1.operations.monitor", label="Production monitoring", tooltip="Observation of infrastructure, input statistics, and model outcomes used to detect and diagnose production changes."];
"vol1.operations.rollback" [id="concept-vol1.operations.rollback", label="Rollback", tooltip="Recovery to a known-good artifact and configuration when a release violates operational bounds."];
"vol1.responsibility.fairness" [id="concept-vol1.responsibility.fairness", label="Subgroup fairness", tooltip="Declared error or decision-rate criteria measured across specified population slices and enforced at release."];
"vol1.responsibility.feedback" [id="concept-vol1.responsibility.feedback", label="Bias feedback", tooltip="A feedback mechanism in which model decisions alter future observations and training data, potentially amplifying disparity."];
"vol1.responsibility.carbon" [id="concept-vol1.responsibility.carbon", label="Operational carbon", tooltip="Emissions attributable to electricity use under a stated accounting boundary and electricity carbon intensity."];
"vol1.hardware.transfer" [id="concept-vol1.hardware.transfer", label="Operand transfer time", tooltip="Supplying operands takes time. For a fixed memory level, the transfer lower bound is bytes moved divided by bandwidth."];
"vol1.hardware.compute" [id="concept-vol1.hardware.compute", label="Arithmetic time", tooltip="The arithmetic lower bound is the required operations divided by the available compute rate. Faster operand delivery cannot remove this bound."];
"vol1.hardware.bandwidth" [id="concept-vol1.hardware.bandwidth", label="Memory bandwidth", tooltip="Bandwidth limits the rate at which an accelerator receives operands from a given memory level. The relevant level depends on data placement and reuse."];
"vol1.hardware.intensity" [id="concept-vol1.hardware.intensity", label="Arithmetic intensity", tooltip="Operations per byte moved identifies the compute-versus-bandwidth regime. A suitable batch can reuse weights and raise this ratio."];
"vol1.compression.precision" [id="concept-vol1.compression.precision", label="Weight precision", tooltip="Lower precision reduces the bytes needed for weights. It improves runtime only when the execution regime and kernel support let those saved bytes matter."];
"vol1.serving.latency" [id="concept-vol1.serving.latency", label="Request latency", tooltip="The elapsed time from arrival to response includes waiting, host work, and model execution. The target applies to the complete request."];
"vol1.serving.queue" [id="concept-vol1.serving.queue", label="Queueing delay", tooltip="Requests wait when arrivals compete for busy resources. Near saturation, small increases in utilization can produce large increases in waiting."];
"vol1.serving.batching" [id="concept-vol1.serving.batching", label="Batching", tooltip="Grouping requests shares fixed work and can reuse weights. It can improve capacity while adding formation delay; the useful batch is constrained by latency and memory."];
"vol1.serving.capacity" [id="concept-vol1.serving.capacity", label="Serving capacity", tooltip="Service capacity is the rate at which the system can complete work under a specified workload. The latency target constrains how much of that capacity can be used."];
"vol1.serving.weights" [id="concept-vol1.serving.weights", label="Model weight memory", tooltip="Resident weights compete with KV state for device memory. Reducing weight storage can free cache capacity, subject to runtime allocations."];
"vol1.serving.kv" [id="concept-vol1.serving.kv", label="KV cache per\nconversation", tooltip="Attention keys and values retained for one conversation grow with its token count and model geometry."];
"vol1.serving.context" [id="concept-vol1.serving.context", label="Context length", tooltip="Longer histories retain more token state. At fixed cache format and model geometry, the per-conversation KV footprint grows linearly."];
"vol1.serving.decode" [id="concept-vol1.serving.decode", label="Decode", tooltip="Each generation step reads retained attention state and appends state for a new token."];
"vol1.serving.execution" [id="concept-vol1.serving.execution", label="Model execution time", tooltip="Execution includes arithmetic and moving operands. A resource bound gives a lower limit; profiling explains additional overhead."];
"vol1.serving.utilization" [id="concept-vol1.serving.utilization", label="Utilization", tooltip="Utilization compares offered work with available service capacity. High utilization leaves little room for variation in arrivals and execution."];
"vol1.serving.formation" [id="concept-vol1.serving.formation", label="Batch formation delay", tooltip="A request may wait while the server collects a batch. This delay spends latency allowance before the model runs."];
"vol1.serving.pool" [id="concept-vol1.serving.pool", label="Available KV memory", tooltip="The device memory left after weights and other resident state bounds the cache pool."];
"vol1.serving.concurrency" [id="concept-vol1.serving.concurrency", label="Resident conversations", tooltip="Memory remaining after model weights must hold the attention state of every resident conversation."];
"vol1.training.batch" [id="concept-vol1.training.batch", label="Training batch size", tooltip="The number of training examples contributing to a parameter update; it affects execution efficiency and the updates required to reach target quality."];
"vol1.measurement.quality" -> "vol1.responsibility.fairness" [id="relation-vol1.field.relation-40", label="can conceal violations\nof"];
"vol1.responsibility.fairness" -> "vol1.lifecycle.gate" [id="relation-vol1.field.relation-41", label="constrains acceptance\nat"];
"vol1.model.behavior" -> "vol1.responsibility.feedback" [id="relation-vol1.field.relation-42", label="can create"];
"vol1.responsibility.feedback" -> "vol1.data.dataset" [id="relation-vol1.field.relation-43", label="reshapes"];
"vol1.compression.quantization" -> "vol1.responsibility.fairness" [id="relation-vol1.field.relation-44", label="requires rechecking"];
"vol1.system.execution" -> "vol1.responsibility.carbon" [id="relation-vol1.field.relation-45", label="consumes energy\ncontributing to"];
"vol1.measurement.protocol" -> "vol1.system.execution" [id="relation-vol1.field.relation-33", label="determines\ninterpretation of"];
"vol1.measurement.protocol" -> "vol1.measurement.quality" [id="relation-vol1.field.relation-34", label="specifies how to assess"];
"vol1.measurement.slo" -> "vol1.serving.latency" [id="relation-vol1.field.relation-35", label="sets a quantile target\nfor"];
"vol1.training.checkpoint" -> "vol1.computation.activations" [id="relation-vol1.field.relation-21", label="reduces retained"];
"vol1.training.checkpoint" -> "vol1.training.quality-time" [id="relation-vol1.field.relation-22", label="can add recomputation\ncost to"];
"vol1.training.mfu" -> "vol1.training.quality-time" [id="relation-vol1.field.relation-23", label="helps explain execution\nrate in"];
"vol1.training.batch" -> "vol1.training.quality-time" [id="relation-vol1.field.relation-24", label="does not always shorten"];
"vol1.selection.scoring" -> "vol1.selection.subset" [id="relation-vol1.field.relation-25", label="offsets savings from"];
"vol1.selection.subset" -> "vol1.measurement.quality" [id="relation-vol1.field.relation-26", label="must preserve required"];
"vol1.selection.balance" -> "vol1.data.dataset" [id="relation-vol1.field.relation-27", label="allocates compute\ntoward"];
"vol1.serving.execution" -> "vol1.hardware.transfer" [id="relation-vol1.hardware.relation-10", label="is bounded below by"];
"vol1.serving.execution" -> "vol1.hardware.compute" [id="relation-vol1.hardware.relation-11", label="is bounded below by"];
"vol1.hardware.transfer" -> "vol1.hardware.bandwidth" [id="relation-vol1.hardware.relation-13", label="decreases with greater"];
"vol1.hardware.intensity" -> "vol1.hardware.transfer" [id="relation-vol1.hardware.relation-15", label="reduces relative\nimportance of"];
"vol1.hardware.tiling" -> "vol1.hardware.reuse" [id="relation-vol1.field.relation-30", label="increases local"];
"vol1.hardware.reuse" -> "vol1.hardware.intensity" [id="relation-vol1.field.relation-31", label="raises effective"];
"vol1.hardware.amdahl" -> "vol1.system.execution" [id="relation-vol1.field.relation-32", label="limits gains in"];
"vol1.system.capacity" -> "vol1.computation.state" [id="relation-vol1.field.relation-2", label="bounds residency of"];
"vol1.system.power" -> "vol1.system.execution" [id="relation-vol1.field.relation-3", label="can lengthen"];
"vol1.system.locality" -> "vol1.system.execution" [id="relation-vol1.field.relation-4", label="can shorten"];
"vol1.data.dataset" -> "vol1.model.behavior" [id="relation-vol1.field.relation-0", label="helps determine"];
"vol1.model.behavior" -> "vol1.system.execution" [id="relation-vol1.field.relation-1", label="must fit a budget for"];
