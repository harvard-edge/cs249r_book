"vol1.lifecycle.gate" -> "vol1.data.dataset" [id="relation-vol1.field.relation-7", label="can send work back to"];
"vol1.architecture.bias" -> "vol1.model.behavior" [id="relation-vol1.field.relation-14", label="changes data needed for"];
"vol1.architecture.attention" -> "vol1.system.execution" [id="relation-vol1.field.relation-15", label="adds quadratic score\nwork to"];
