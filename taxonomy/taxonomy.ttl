@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> a skos:ConceptScheme ;
  skos:prefLabel "MLSysBook Taxonomy of Machine Learning Systems"@en ;
  skos:scopeNote "Engineering systems that learn from data. This pilot distinguishes subject hierarchy from navigation collections and conditional technical relationships."@en ;
  skos:editorialNote "Editorial draft; sources are design references, not assertion-level proof."@en .
<https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> dcterms:source <https://www.w3.org/TR/skos-reference/> .
<https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> dcterms:source <https://csed.acm.org/knowledge-areas/> .
<https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> dcterms:source <https://dlsyscourse.org/> .
<https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> dcterms:source <https://mlcommons.org/benchmarks/> .

<https://mlsysbook.ai/taxonomy/mlsys.topic.parallel-execution> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Parallel execution strategies"@en ;
  skos:definition "Strategies for partitioning or replicating computation and state so work can execute concurrently."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.topic.learning-paradigms> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Learning paradigms"@en ;
  skos:definition "Approaches to learning distinguished by their training signals, observations, and interaction with an environment."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.requirements> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "System requirements"@en ;
  skos:definition "Measurable desired behavior and constraints for a specified workload."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.baseline> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Baseline"@en ;
  skos:definition "A reference method or system used to justify the value of a proposed change."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.proxy-objective> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Proxy objective"@en ;
  skos:definition "A measurable target used in place of the outcome actually desired."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.slo> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Service-level objective"@en ;
  skos:definition "A target for a defined service measure over a specified population and window."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.slo> skos:altLabel "SLO"@en .

<https://mlsysbook.ai/taxonomy/mlsys.workload> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Workload characterization"@en ;
  skos:definition "The input, request, model, and execution distributions that a system must support."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.placement> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Execution placement"@en ;
  skos:definition "The choice of where system components execute, such as device, edge, or datacenter."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-quality> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data quality"@en ;
  skos:definition "Fitness of recorded examples for the intended task, including validity, coverage, and error."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.labels> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Label quality"@en ;
  skos:definition "The correctness, consistency, and coverage of recorded supervision relative to the intended task, which bound the training signal and the trustworthiness of evaluation."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.labels> skos:altLabel "label noise"@en .

<https://mlsysbook.ai/taxonomy/mlsys.features> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Feature engineering"@en ;
  skos:definition "Constructing model inputs whose semantics and availability match the task."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.missing-data> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Missing data"@en ;
  skos:definition "Absent observations whose pattern and treatment can change learned behavior."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.leakage> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data leakage"@en ;
  skos:definition "Information unavailable at the intended prediction boundary entering development or evaluation."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.point-in-time> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Point-in-time correctness"@en ;
  skos:definition "Constructing examples using only information available at their stated prediction time."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.lineage> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data lineage"@en ;
  skos:definition "Recorded dependencies that identify the sources and transformations of a dataset or artifact."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.train-serve-skew> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Training-serving skew"@en ;
  skos:definition "A mismatch between the data transformations or feature semantics used in training and serving."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.deduplication> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Dataset deduplication"@en ;
  skos:definition "Identifying and managing repeated or near-duplicate examples."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-selection> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data selection"@en ;
  skos:definition "Allocating learning effort to examples according to value, coverage, and acquisition cost."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.tokenization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Tokenization"@en ;
  skos:definition "Mapping text into vocabulary-dependent token identifiers, which sets sequence lengths and so influences context usage, embedding size, and processing cost."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.tokenization> skos:altLabel "subword tokenization"@en .
<https://mlsysbook.ai/taxonomy/mlsys.tokenization> skos:altLabel "BPE"@en .

<https://mlsysbook.ai/taxonomy/mlsys.distribution-shift> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Distribution shift"@en ;
  skos:definition "A difference between development and deployment data-generating distributions."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.distribution-shift> skos:altLabel "dataset shift"@en .
<https://mlsysbook.ai/taxonomy/mlsys.distribution-shift> skos:altLabel "covariate shift"@en .
<https://mlsysbook.ai/taxonomy/mlsys.distribution-shift> skos:altLabel "label shift"@en .

<https://mlsysbook.ai/taxonomy/mlsys.linear-model> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Linear models"@en ;
  skos:definition "Models whose score is linear in their supplied features, with a possible output link function."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.tree-ensemble> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Tree ensembles"@en ;
  skos:definition "Collections of decision trees whose branch traversal and aggregation determine predictions."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.kernel-method> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Kernel methods"@en ;
  skos:definition "Models using similarity functions whose storage and evaluation costs depend on their representation."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.nearest-neighbor> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Nearest-neighbor models"@en ;
  skos:definition "Predictions or retrieval based on similarity to stored examples or vectors."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.neural-network> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Neural networks"@en ;
  skos:definition "Parameterized compositions of differentiable operations used to learn representations and predictions."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.inductive-bias> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Inductive bias"@en ;
  skos:definition "Structural assumptions that favor some learned functions over others."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.embeddings> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Embeddings"@en ;
  skos:definition "Vector representations whose dimension and lookup or construction method affect storage and computation."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.attention> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Attention"@en ;
  skos:definition "Input-dependent aggregation of value vectors using query-key compatibility scores."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.position-encoding> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Position encoding"@en ;
  skos:definition "Representations that make sequence position available to a model."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.position-encoding> skos:altLabel "Positional encoding"@en .

<https://mlsysbook.ai/taxonomy/mlsys.loss> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Training loss"@en ;
  skos:definition "A computable criterion optimized on training examples."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.autodiff> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Automatic differentiation"@en ;
  skos:definition "Computing derivatives by composing local derivative rules through an execution graph."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.optimizer> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Optimization algorithm"@en ;
  skos:definition "A rule that uses training information to update model parameters and optimizer state."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.regularization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Regularization"@en ;
  skos:definition "Constraints or training procedures used to control sensitivity and generalization behavior."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.batch-size> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Training batch size"@en ;
  skos:definition "The number of examples contributing to an optimization update or microstep."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.training-state> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Training state"@en ;
  skos:definition "The parameters, gradients, optimizer variables, and other state needed to continue training."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.activation-recompute> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Activation recomputation"@en ;
  skos:definition "Recreating forward intermediates during backward execution to reduce retained memory."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.activation-recompute> skos:altLabel "Activation checkpointing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.activation-recompute> skos:altLabel "Gradient checkpointing"@en .

<https://mlsysbook.ai/taxonomy/mlsys.scaling-laws> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Empirical scaling laws"@en ;
  skos:definition "Fitted relationships between resources, data, model size, and observed model performance."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.hyperparameter-search> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Hyperparameter search"@en ;
  skos:definition "Choosing model or training settings through a sequence of evaluations."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.hyperparameter-search> skos:altLabel "Hyperparameter optimization"@en .
<https://mlsysbook.ai/taxonomy/mlsys.hyperparameter-search> skos:altLabel "HPO"@en .

<https://mlsysbook.ai/taxonomy/mlsys.experiment-budget> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Experiment-budget allocation"@en ;
  skos:definition "Dividing a finite evaluation budget across configurations, repetitions, and fidelities."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.transfer-learning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Transfer learning"@en ;
  skos:definition "Adapting representations or parameters learned from one setting to another."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.peft> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Parameter-efficient adaptation"@en ;
  skos:definition "Adapting a model by changing a limited parameter subset or added parameterization."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.peft> skos:altLabel "PEFT"@en .

<https://mlsysbook.ai/taxonomy/mlsys.tensor-layout> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Tensor layout"@en ;
  skos:definition "The mapping from tensor indices to storage locations, including strides and materialization."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.matrix-multiply> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Matrix multiplication"@en ;
  skos:definition "A dense linear-algebra operation whose tiling, shape, and precision affect execution cost."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.precision> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Numerical precision"@en ;
  skos:definition "The representable values and arithmetic behavior of a numerical format."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.numerical-stability> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Numerical stability"@en ;
  skos:definition "Sensitivity of a computed result to finite-precision operations and intermediate representations."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.mixed-precision> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Mixed-precision training"@en ;
  skos:definition "Training with multiple numerical formats and explicit handling of their range and accumulation behavior."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.quantization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Quantization"@en ;
  skos:definition "Representing values using a reduced discrete set with a specified encoding and approximation rule."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.sparsity> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Sparsity"@en ;
  skos:definition "A pattern of absent or zero values whose execution benefit depends on representation and support."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.distillation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Knowledge distillation"@en ;
  skos:definition "Training a student model using signals from a teacher model or ensemble."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.compilation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Graph compilation"@en ;
  skos:definition "Transforming a model or execution graph into an executable representation."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.fusion> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Kernel fusion"@en ;
  skos:definition "Combining compatible operations to reduce intermediate materialization or dispatch."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.dispatch> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Host dispatch overhead"@en ;
  skos:definition "Host-side work required to launch or orchestrate device operations."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.dispatch> skos:altLabel "kernel launch overhead"@en .

<https://mlsysbook.ai/taxonomy/mlsys.memory-capacity> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Memory capacity"@en ;
  skos:definition "Available storage for concurrently resident state and intermediates."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.memory-bandwidth> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Memory bandwidth"@en ;
  skos:definition "The sustainable rate at which bytes move across a specified memory interface."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.compute-throughput> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Compute throughput"@en ;
  skos:definition "The sustainable rate of a specified arithmetic workload on an execution resource."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.arithmetic-intensity> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Arithmetic intensity"@en ;
  skos:definition "Arithmetic work per byte transferred at a specified memory boundary."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.roofline> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Roofline bound"@en ;
  skos:definition "A performance bound combining a compute ceiling with an intensity-dependent bandwidth ceiling."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.locality> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data locality"@en ;
  skos:definition "Reuse of data near its consumers across time or execution locations."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.tiling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Tiling"@en ;
  skos:definition "Partitioning computation so working data can be reused within a chosen storage level."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.profiling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Profiling"@en ;
  skos:definition "Measuring execution to attribute time, work, stalls, and resource use."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.utilization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Resource utilization"@en ;
  skos:definition "The fraction of a resource's defined service capacity that is occupied over a stated interval."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.serial-fraction> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Serial fraction"@en ;
  skos:definition "The portion of execution that a proposed parallel or accelerated transformation leaves unchanged."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.collectives> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Collective communication"@en ;
  skos:definition "Coordinated data exchange and reduction across a process group."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-parallel> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data parallelism"@en ;
  skos:definition "Executing model replicas on different examples while coordinating learning state."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.tensor-parallel> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Tensor parallelism"@en ;
  skos:definition "Partitioning a layer's tensors and operations across devices so each computes a slice, reducing per-device state while adding communication along the partitioned dimensions, usually within a fast scale-up domain."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.pipeline-parallel> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Pipeline parallelism"@en ;
  skos:definition "Partitioning a computation into stages that process different microbatches concurrently."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.state-sharding> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Training-state sharding"@en ;
  skos:definition "Partitioning parameters, gradients, or optimizer state across workers."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.state-sharding> skos:altLabel "ZeRO"@en .
<https://mlsysbook.ai/taxonomy/mlsys.state-sharding> skos:altLabel "FSDP"@en .
<https://mlsysbook.ai/taxonomy/mlsys.state-sharding> skos:altLabel "fully sharded data parallel"@en .

<https://mlsysbook.ai/taxonomy/mlsys.communication-overlap> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Communication overlap"@en ;
  skos:definition "Scheduling communication concurrently with independent computation."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.network-topology> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Network topology"@en ;
  skos:definition "The connectivity and capacity structure that constrains communication paths."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.stragglers> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Stragglers"@en ;
  skos:definition "Workers or tasks whose delayed completion holds back coordinated work."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.checkpoint> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Recovery checkpoint"@en ;
  skos:definition "A persisted state from which a specified computation can resume."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.consistent-cut> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Consistent checkpoint cut"@en ;
  skos:definition "A recoverable collection of distributed states with compatible dependencies."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.consensus> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Replicated-log consensus"@en ;
  skos:definition "Agreement on an ordered state history under specified timing and failure assumptions."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.consensus> skos:altLabel "Paxos"@en .
<https://mlsysbook.ai/taxonomy/mlsys.consensus> skos:altLabel "Raft"@en .

<https://mlsysbook.ai/taxonomy/mlsys.fencing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Fencing"@en ;
  skos:definition "Rejecting effects from an actor whose epoch or authority is stale."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.federated-learning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Federated learning"@en ;
  skos:definition "Coordinating model learning across separately controlled data holders."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.arrival-rate> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Arrival rate"@en ;
  skos:definition "The frequency and distribution of requests reaching a service boundary."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.service-capacity> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Service capacity"@en ;
  skos:definition "The completion rate supported by a service under a stated workload and operating point."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.queueing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Queueing delay"@en ;
  skos:definition "Time a request waits for a resource before receiving service."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.tail-latency> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Tail latency"@en ;
  skos:definition "A high quantile of a defined request-latency distribution."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.batching> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Request batching"@en ;
  skos:definition "Executing requests together to share work or improve resource use."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.admission> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Admission control"@en ;
  skos:definition "Accepting, delaying, or rejecting work according to capacity, policy, and service constraints."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.admission> skos:altLabel "load shedding"@en .
<https://mlsysbook.ai/taxonomy/mlsys.admission> skos:altLabel "rate limiting"@en .

<https://mlsysbook.ai/taxonomy/mlsys.autoscaling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Autoscaling"@en ;
  skos:definition "Changing provisioned service resources in response to measured or predicted demand."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.kv-cache> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "KV cache"@en ;
  skos:definition "Retained attention keys and values reused during autoregressive execution."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.kv-cache> skos:altLabel "Key-value cache"@en .

<https://mlsysbook.ai/taxonomy/mlsys.prefill-decode> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Prefill and decode"@en ;
  skos:definition "The prompt-processing and incremental token-generation phases of autoregressive inference."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.paged-kv> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Paged KV allocation"@en ;
  skos:definition "Managing attention state in blocks to reduce allocation waste and support sharing."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.paged-kv> skos:altLabel "PagedAttention"@en .

<https://mlsysbook.ai/taxonomy/mlsys.prefix-cache> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Prefix caching"@en ;
  skos:definition "Reusing compatible computed state for an identical request prefix."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.prefix-cache> skos:altLabel "prompt caching"@en .
<https://mlsysbook.ai/taxonomy/mlsys.prefix-cache> skos:altLabel "context caching"@en .

<https://mlsysbook.ai/taxonomy/mlsys.speculative-decoding> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Speculative decoding"@en ;
  skos:definition "Using proposed tokens and a validating procedure to accelerate generation while preserving a specified output distribution."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.slo-goodput> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "SLO goodput"@en ;
  skos:definition "The rate of useful completed work that satisfies the specified quality and service criteria."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.generalization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Generalization"@en ;
  skos:definition "Performance on relevant examples or conditions beyond those used to fit the system."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.evaluation-split> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Evaluation split"@en ;
  skos:definition "A partitioning protocol that separates learning, selection, and final assessment."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.selection-bias> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model-selection optimism"@en ;
  skos:definition "Overstated performance caused by choosing a winner using noisy evaluation results."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.metrics> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Evaluation metrics"@en ;
  skos:definition "Specified measurements of predictive or task behavior, with explicit populations and aggregation."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.calibration> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Probability calibration"@en ;
  skos:definition "Agreement between predicted probabilities and observed event frequencies under an evaluation distribution."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.statistical-uncertainty> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Statistical uncertainty"@en ;
  skos:definition "Uncertainty in an estimated quantity due to finite and dependent observations."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.benchmark> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Benchmark protocol"@en ;
  skos:definition "A reproducible workload, measurement boundary, and comparison procedure."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.online-experiment> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Online experimentation"@en ;
  skos:definition "A controlled intervention used to estimate effects on deployed-system outcomes."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.online-experiment> skos:altLabel "A/B testing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.online-experiment> skos:altLabel "A/B test"@en .
<https://mlsysbook.ai/taxonomy/mlsys.online-experiment> skos:altLabel "controlled online experiment"@en .

<https://mlsysbook.ai/taxonomy/mlsys.sliced-evaluation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Sliced evaluation"@en ;
  skos:definition "Measuring behavior separately on relevant populations, conditions, or workload groups."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.selective-prediction> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Selective prediction"@en ;
  skos:definition "Predicting on admitted cases and abstaining or deferring the rest."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.artifact-version> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Artifact versioning"@en ;
  skos:definition "Identifying the exact model, code, data, configuration, and dependencies in an execution or release."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.monitoring> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Production monitoring"@en ;
  skos:definition "Collecting and interpreting signals about deployed system behavior and health."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.rollout> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Staged rollout"@en ;
  skos:definition "Increasing exposure to a candidate system through bounded release stages."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.rollout> skos:altLabel "canary release"@en .
<https://mlsysbook.ai/taxonomy/mlsys.rollout> skos:altLabel "canary deployment"@en .
<https://mlsysbook.ai/taxonomy/mlsys.rollout> skos:altLabel "progressive delivery"@en .

<https://mlsysbook.ai/taxonomy/mlsys.rollback> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Rollback"@en ;
  skos:definition "Returning to a previously accepted deployment configuration with compatible state."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.feedback-loop> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Deployment feedback loop"@en ;
  skos:definition "A deployed system's outputs changing the data or behavior encountered by future learning or evaluation."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.retraining> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Retraining"@en ;
  skos:definition "Training a replacement version of a deployed model on updated or revised data, with timing and data chosen to balance staleness against training and validation cost."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.retraining> skos:altLabel "retraining trigger"@en .
<https://mlsysbook.ai/taxonomy/mlsys.retraining> skos:altLabel "retraining cadence"@en .

<https://mlsysbook.ai/taxonomy/mlsys.incident-response> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Incident response"@en ;
  skos:definition "Detecting, containing, diagnosing, and recovering from unexpected system behavior."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.observability> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "System observability"@en ;
  skos:definition "Instrumentation that permits investigation of internal execution from recorded outputs, traces, and metrics."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.threat-model> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Threat modeling"@en ;
  skos:definition "Specifying adversaries, assets, interfaces, capabilities, and failure consequences."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.poisoning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data poisoning"@en ;
  skos:definition "Adversarial manipulation of learning data or signals to alter learned behavior."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.evasion> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Adversarial evasion"@en ;
  skos:definition "Adversarially chosen inference inputs intended to cause harmful model behavior."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.privacy> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Privacy requirements"@en ;
  skos:definition "Requirements governing the collection, use, retention, and disclosure of information about people or records."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.differential-privacy> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Differential privacy"@en ;
  skos:definition "A parameterized bound on changes in output distributions under a specified neighboring-dataset relation."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.differential-privacy> skos:altLabel "DP"@en .

<https://mlsysbook.ai/taxonomy/mlsys.fairness> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Fairness criteria"@en ;
  skos:definition "Explicit requirements for how system outcomes or errors are distributed across affected groups."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.authorization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Authorization"@en ;
  skos:definition "Determining whether an actor may perform a specified action on a resource."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.isolation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Execution isolation"@en ;
  skos:definition "Restricting which resources and effects a computation can access."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.human-oversight> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Human oversight"@en ;
  skos:definition "An arrangement in which people can understand, intervene in, and contest consequential system behavior."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.energy> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Operating energy"@en ;
  skos:definition "Energy consumed by a specified system boundary over a defined workload or interval."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.carbon> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Lifecycle carbon"@en ;
  skos:definition "Emissions attributed to operation and embodied system resources under declared accounting boundaries."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.unit-cost> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Cost per useful outcome"@en ;
  skos:definition "Total relevant expenditure divided by outcomes meeting a specified acceptance criterion."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.capacity-planning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Capacity planning"@en ;
  skos:definition "Provisioning resources for a workload distribution and service objectives."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.trajectory> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Agent trajectory"@en ;
  skos:definition "A sequence of observations, model proposals, tool actions, and external outcomes for a task."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.planning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Agent planning"@en ;
  skos:definition "Constructing and revising prospective actions in response to goals, dependencies, and observations."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.context> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Context window"@en ;
  skos:definition "The maximum token span a model supports in a stated execution mode, bounding the history it can use and the longest sequences the system must process."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.context> skos:altLabel "context length"@en .

<https://mlsysbook.ai/taxonomy/mlsys.retrieval> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Retrieval"@en ;
  skos:definition "Selecting relevant records from an external collection using an explicit query and ranking process."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.ann> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Approximate nearest-neighbor search"@en ;
  skos:definition "Trading exact neighbor recovery for reduced search cost using an index or approximation."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.ann> skos:altLabel "ANN"@en .

<https://mlsysbook.ai/taxonomy/mlsys.hallucination> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Hallucination"@en ;
  skos:definition "Generated factual assertions or summaries not supported by the relevant source or evidence."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.hallucination> skos:altLabel "unsupported generated claims"@en .

<https://mlsysbook.ai/taxonomy/mlsys.tool-contract> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Tool contract"@en ;
  skos:definition "A specification of tool inputs, outputs, authority, effects, and failure behavior."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.idempotency> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Idempotency"@en ;
  skos:definition "A specified operation's repeated execution having the same intended effect as one execution."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.compensation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Compensating action"@en ;
  skos:definition "An explicit action intended to remedy an earlier effect whose direct reversal is unavailable."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.prompt-injection> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Prompt injection"@en ;
  skos:definition "Untrusted content attempting to redirect model-driven behavior across an instruction or authority boundary."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.prompt-injection> skos:altLabel "indirect prompt injection"@en .

<https://mlsysbook.ai/taxonomy/mlsys.agent-evaluation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Trajectory evaluation"@en ;
  skos:definition "Assessing task outcomes, intermediate effects, and constraint compliance across a complete agent run."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.reward-hacking> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Reward hacking"@en ;
  skos:definition "Improving a measured reward through behavior that fails the intended task objective."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.reward-hacking> skos:altLabel "specification gaming"@en .
<https://mlsysbook.ai/taxonomy/mlsys.reward-hacking> skos:altLabel "reward overoptimization"@en .

<https://mlsysbook.ai/taxonomy/mlsys.dynamics> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Physical dynamics"@en ;
  skos:definition "The evolution of a physical system under inputs, disturbances, and constraints."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.sensing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Sensor calibration"@en ;
  skos:definition "Establishing how observations relate to physical quantities, coordinates, and time."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.state-estimation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "State estimation"@en ;
  skos:definition "Inferring latent physical state and uncertainty from observations and a model."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.state-observability> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "State observability"@en ;
  skos:definition "Whether distinct internal states can be distinguished through the available observations and model."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.observation-age> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Observation age"@en ;
  skos:definition "Elapsed time between a physical observation and its use in a decision."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.feedback-delay> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Feedback delay"@en ;
  skos:definition "Delay around a sensing, computation, communication, and actuation loop."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.wcet> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Worst-case execution time"@en ;
  skos:definition "A justified execution-time upper bound under specified hardware and execution assumptions."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.wcet> skos:altLabel "WCET"@en .

<https://mlsysbook.ai/taxonomy/mlsys.feedback-control> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Feedback control"@en ;
  skos:definition "Selecting inputs using measured or estimated deviation from desired behavior."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.trajectory-feasibility> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Trajectory feasibility"@en ;
  skos:definition "Satisfaction of motion, state, input, and dynamic constraints along a proposed trajectory."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.contact-compliance> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Contact and compliance"@en ;
  skos:definition "Mechanical interaction whose forces depend on geometry, motion, stiffness, and damping."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.sim-to-real> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Simulation-to-real transfer"@en ;
  skos:definition "Deployment of a learned policy under differences between simulated and physical conditions."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.runtime-assurance> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Runtime assurance"@en ;
  skos:definition "Monitoring and constraining execution using explicitly stated safety premises and fallback mechanisms."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.stopping-envelope> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Stopping envelope"@en ;
  skos:definition "The state and clearance conditions within which a specified stopping response remains feasible."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.stopping-envelope> skos:altLabel "safe stopping region"@en .

<https://mlsysbook.ai/taxonomy/mlsys.operating-domain> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Operational design domain"@en ;
  skos:definition "The conditions under which a physical system's behavior and evidence are intended to apply."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.operating-domain> skos:altLabel "ODD"@en .

<https://mlsysbook.ai/taxonomy/mlsys.safety-case> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Safety case"@en ;
  skos:definition "A structured argument connecting claims, evidence, assumptions, and defeaters for a defined system."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.grammar> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Structured output constraint"@en ;
  skos:definition "Restricting the syntax or schema of model outputs without establishing factual correctness or authority."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-acquisition> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data acquisition and sampling"@en ;
  skos:definition "The observation and selection process that determines which examples and populations enter a dataset."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-contract> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data contract"@en ;
  skos:definition "A specification of schema, semantics, validity rules, and availability for data exchanged between components."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.delayed-outcomes> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Delayed outcomes"@en ;
  skos:definition "Target outcomes that become observable only after a delay or for a selected subset of cases."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.decision-policy> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Decision policy"@en ;
  skos:definition "The rule that converts model outputs and system state into actions, thresholds, abstentions, or escalation."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.robustness-evaluation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Robustness evaluation"@en ;
  skos:definition "Testing behavior under explicitly chosen shifts, perturbations, faults, or operating stresses."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.supervised-learning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Supervised learning"@en ;
  skos:definition "Learning a prediction rule from examples with target outputs."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.self-supervised-learning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Self-supervised learning"@en ;
  skos:definition "Learning from targets constructed from the observed data itself."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.unsupervised-learning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Unsupervised learning"@en ;
  skos:definition "Learning structure in data without externally supplied example-level targets."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.reinforcement-learning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Reinforcement learning"@en ;
  skos:definition "Learning a policy from action-dependent observations and reward signals."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.imitation-learning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Imitation learning"@en ;
  skos:definition "Learning a policy from demonstrated behavior and possibly corrective interaction."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-artifact> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model artifact"@en ;
  skos:definition "The learned parameters, structures, example stores, and metadata required to execute a model."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.failure-model> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Failure model"@en ;
  skos:definition "The declared classes of faults and timing assumptions under which a mechanism is analyzed."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.backpressure> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Backpressure"@en ;
  skos:definition "A mechanism that signals downstream saturation to limit or slow upstream production."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.privacy-leakage> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Privacy leakage"@en ;
  skos:definition "Information about people or records revealed through data, artifacts, or model interaction."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.execution-time> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Execution time"@en ;
  skos:definition "Elapsed time for a specified execution boundary, workload, and operating condition."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.irreversible-effects> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Irreversible effects"@en ;
  skos:definition "External consequences that cannot be fully undone by restoring software state, retrying, or performing a compensating action."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.dataset-storage-layout> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Dataset storage layout"@en ;
  skos:definition "Organization of stored dataset records, columns, partitions, and metadata that determines which data an access reads or decodes."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-ingestion> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data ingestion"@en ;
  skos:definition "Reading externally produced records into a processing or learning system under declared delivery, ordering, and timing assumptions."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.schema-evolution> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Schema evolution"@en ;
  skos:definition "Changing a data schema while explicitly managing how existing data and producers or consumers remain interpretable and compatible."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.test-oracle> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Test oracle"@en ;
  skos:definition "A specification, procedure, reference, or informed judgment used to assess whether observed behavior satisfies stated expectations for a test."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.integration-testing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Integration testing"@en ;
  skos:definition "Testing interactions among assembled components against stated interface and behavior expectations."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.failure-injection> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Failure injection"@en ;
  skos:definition "Deliberately introducing selected faults or disruptive conditions to observe system response under controlled experimental boundaries."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.dependency-environment> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Dependency environment"@en ;
  skos:definition "The software packages, versions, native libraries, and runtime configuration on which an execution depends."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.workflow-orchestration> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Workflow orchestration"@en ;
  skos:definition "Coordinating dependent computation steps, their data or control flow, execution conditions, and failure handling."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.experiment-reproducibility> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Experiment reproducibility"@en ;
  skos:definition "The ability to repeat an experimental procedure and obtain results consistent with declared criteria when its inputs, environment, randomness, and execution conditions are specified."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.accelerator-execution-architecture> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Accelerator execution architecture"@en ;
  skos:definition "Organization of arithmetic units, execution lanes or threads, scheduling resources, and local storage that determines how supported operations run. SIMD/SIMT, matrix units, and systolic arrays are distinct examples."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.accelerator-execution-architecture> skos:altLabel "GPU architecture"@en .
<https://mlsysbook.ai/taxonomy/mlsys.accelerator-execution-architecture> skos:altLabel "streaming multiprocessor"@en .
<https://mlsysbook.ai/taxonomy/mlsys.accelerator-execution-architecture> skos:altLabel "SM"@en .

<https://mlsysbook.ai/taxonomy/mlsys.memory-hierarchy> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Memory hierarchy"@en ;
  skos:definition "Arrangement of storage levels and transfer paths with differing capacity, latency, bandwidth, access control, and management mechanisms. The available levels depend on the platform."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.host-device-interconnect> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Host-device interconnect"@en ;
  skos:definition "Communication path through which a host and accelerator exchange data and control, with transport, topology, and memory-access semantics that affect transfers."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.power-delivery> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Power delivery and integrity"@en ;
  skos:definition "Supply paths, conversion stages, limits, and transient behavior that must maintain required voltages while workloads and actuators draw or return power."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.thermal-dynamics> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Thermal behavior and throttling"@en ;
  skos:definition "Evolution of temperature under heat generation and removal, and the performance controls or operating restrictions that follow under a platform thermal policy."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.sli> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Service-level indicator"@en ;
  skos:definition "A quantitative measure of one aspect of delivered service, such as latency, availability, or accepted-output rate, computed over a stated population and window."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.sli> skos:altLabel "SLI"@en .

<https://mlsysbook.ai/taxonomy/mlsys.error-budget> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Error budget"@en ;
  skos:definition "The amount of service-level-objective violation permitted over a window, used to pace changes and risk against a reliability target."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.latency-budget> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Latency budget"@en ;
  skos:definition "An allocation of an end-to-end latency target across the stages of a request path, such as network, preprocessing, inference, and postprocessing."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.flop-accounting> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Operation and byte accounting"@en ;
  skos:definition "Estimating a workload's arithmetic operations and bytes moved per example, token, or step from model shapes, to predict cost before measurement."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.flop-accounting> skos:altLabel "FLOP counting"@en .
<https://mlsysbook.ai/taxonomy/mlsys.flop-accounting> skos:altLabel "resource accounting"@en .

<https://mlsysbook.ai/taxonomy/mlsys.memory-footprint> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Memory footprint"@en ;
  skos:definition "The peak memory a workload occupies, summed over parameters, activations, optimizer or cache state, and runtime buffers."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.workload-trace> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Workload trace"@en ;
  skos:definition "A recorded sequence of requests or jobs with arrival times, sizes, and durations, replayed to evaluate capacity, scheduling, or serving policies."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.cost-sensitive-decision> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Cost-sensitive decision"@en ;
  skos:definition "Choosing actions or thresholds to minimize expected cost when different error types carry unequal consequences."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.pareto-frontier> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Pareto frontier"@en ;
  skos:definition "The set of configurations for which no objective, such as accuracy, latency, or cost, can improve without worsening another."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.transformer> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Transformer"@en ;
  skos:definition "A neural architecture of stacked attention and feed-forward blocks with residual connections and normalization, processing all sequence positions in parallel during training."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.recommendation-model> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Deep recommendation model"@en ;
  skos:definition "Models combining large sparse embedding tables for categorical features with dense layers, whose cost is often dominated by embedding lookups and memory capacity."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.recommendation-model> skos:altLabel "DLRM"@en .

<https://mlsysbook.ai/taxonomy/mlsys.diffusion-model> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Diffusion model"@en ;
  skos:definition "A generative model that learns to reverse a gradual noising process, producing samples through many iterative denoising network evaluations."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.convolution> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Convolution"@en ;
  skos:definition "A locally connected operation applying shared filters across spatial or temporal positions, giving high weight reuse and arithmetic intensity."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.convolution> skos:altLabel "CNN"@en .

<https://mlsysbook.ai/taxonomy/mlsys.recurrence> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Recurrent computation"@en ;
  skos:definition "Computation that updates a hidden state step by step over a sequence, creating sequential dependencies that limit parallelism across time."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.recurrence> skos:altLabel "RNN"@en .
<https://mlsysbook.ai/taxonomy/mlsys.recurrence> skos:altLabel "LSTM"@en .

<https://mlsysbook.ai/taxonomy/mlsys.normalization-layer> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Normalization layers"@en ;
  skos:definition "Layers that rescale activations using batch, layer, or root-mean-square statistics to stabilize and speed training of deep networks."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.normalization-layer> skos:altLabel "BatchNorm"@en .
<https://mlsysbook.ai/taxonomy/mlsys.normalization-layer> skos:altLabel "LayerNorm"@en .
<https://mlsysbook.ai/taxonomy/mlsys.normalization-layer> skos:altLabel "RMSNorm"@en .

<https://mlsysbook.ai/taxonomy/mlsys.mixture-of-experts> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Mixture of experts"@en ;
  skos:definition "An architecture in which a learned router activates a small subset of expert subnetworks per token, decoupling total parameter count from per-token compute."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.mixture-of-experts> skos:altLabel "MoE"@en .

<https://mlsysbook.ai/taxonomy/mlsys.expert-routing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Expert routing"@en ;
  skos:definition "The gating function that assigns each token to one or more experts, such as top-k softmax gating or expert-choice routing."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.expert-routing> skos:altLabel "gating"@en .
<https://mlsysbook.ai/taxonomy/mlsys.expert-routing> skos:altLabel "router"@en .

<https://mlsysbook.ai/taxonomy/mlsys.expert-capacity> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Expert capacity"@en ;
  skos:definition "The maximum number of tokens an expert processes per batch, set by a capacity factor; tokens beyond it are dropped or rerouted."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.expert-capacity> skos:altLabel "capacity factor"@en .

<https://mlsysbook.ai/taxonomy/mlsys.load-balancing-loss> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Load-balancing loss"@en ;
  skos:definition "An auxiliary training objective that penalizes uneven token assignment across experts so routing stays balanced."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.load-balancing-loss> skos:altLabel "auxiliary loss"@en .

<https://mlsysbook.ai/taxonomy/mlsys.active-parameters> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Active parameters"@en ;
  skos:definition "The parameters actually used to process one token or example, as distinct from total stored parameters in conditionally computed models."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.early-exit> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Early exit"@en ;
  skos:definition "Terminating inference at an intermediate layer once a confidence criterion is met, so per-input compute varies with input difficulty."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.early-exit> skos:altLabel "adaptive computation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.sliding-window-attention> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Sparse and sliding-window attention"@en ;
  skos:definition "Attention restricted to local windows or fixed sparse patterns so cost grows linearly rather than quadratically with sequence length."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.sliding-window-attention> skos:altLabel "local attention"@en .

<https://mlsysbook.ai/taxonomy/mlsys.linear-attention> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Linear attention"@en ;
  skos:definition "Attention reformulated with kernel feature maps so it is computed in linear time with a fixed-size recurrent state."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.state-space-model> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "State-space sequence model"@en ;
  skos:definition "Sequence models built on discretized linear state-space recurrences, trainable in parallel and run with constant-size state per step at inference."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.state-space-model> skos:altLabel "SSM"@en .
<https://mlsysbook.ai/taxonomy/mlsys.state-space-model> skos:altLabel "Mamba"@en .
<https://mlsysbook.ai/taxonomy/mlsys.state-space-model> skos:altLabel "S4"@en .

<https://mlsysbook.ai/taxonomy/mlsys.grouped-query-attention> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Grouped-query attention"@en ;
  skos:definition "Attention in which groups of query heads share key and value heads, shrinking the key-value cache and decode memory traffic."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.grouped-query-attention> skos:altLabel "GQA"@en .
<https://mlsysbook.ai/taxonomy/mlsys.grouped-query-attention> skos:altLabel "multi-query attention"@en .
<https://mlsysbook.ai/taxonomy/mlsys.grouped-query-attention> skos:altLabel "MQA"@en .

<https://mlsysbook.ai/taxonomy/mlsys.context-extension> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Context-length extension"@en ;
  skos:definition "Techniques that extend a trained model's usable sequence length, such as position-encoding interpolation followed by long-sequence fine-tuning."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.context-extension> skos:altLabel "RoPE scaling"@en .

<https://mlsysbook.ai/taxonomy/mlsys.weight-serialization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Weight serialization format"@en ;
  skos:definition "The on-disk encoding of a model's parameter tensors and metadata, governing load time, memory mapping, and safety of deserialization."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.weight-serialization> skos:altLabel "safetensors"@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-exchange-format> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model exchange format"@en ;
  skos:definition "A framework-neutral representation of a model's operator graph and weights used to move models between training frameworks and inference runtimes."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-exchange-format> skos:altLabel "ONNX"@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-export> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model export"@en ;
  skos:definition "Converting a framework program into a self-contained deployable artifact by tracing or capturing its graph and fixing operators, shapes, and weights."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-signature> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model signature"@en ;
  skos:definition "The declared names, types, and shapes of a model artifact's inputs and outputs, forming its interface contract with callers."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.ridge-point> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Ridge point"@en ;
  skos:definition "The arithmetic intensity at which a roofline's bandwidth and compute ceilings meet, equal to peak compute throughput divided by peak memory bandwidth."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.bound-regime> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Compute-bound vs. memory-bound"@en ;
  skos:definition "Classifying a kernel or phase by which roofline ceiling limits it, indicating whether more arithmetic throughput or more bandwidth would help."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-movement-energy> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data-movement energy"@en ;
  skos:definition "The energy cost of moving operands between storage levels, which grows with distance and typically exceeds the energy of the arithmetic performed on them."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.amdahls-law> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Amdahl's law"@en ;
  skos:definition "The bound that overall speedup from accelerating part of an execution is limited by the fraction left unaccelerated."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.strong-scaling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Strong scaling"@en ;
  skos:definition "How time to solution changes as resources increase for a fixed total problem size."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.weak-scaling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Weak scaling"@en ;
  skos:definition "How time to solution changes as resources and problem size grow proportionally, keeping work per resource fixed."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.weak-scaling> skos:altLabel "Gustafson's law"@en .

<https://mlsysbook.ai/taxonomy/mlsys.parallel-efficiency> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Parallel scaling efficiency"@en ;
  skos:definition "Achieved speedup divided by the factor of added resources, measuring how much additional hardware turns into useful progress."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.parallel-efficiency> skos:altLabel "scaling efficiency"@en .

<https://mlsysbook.ai/taxonomy/mlsys.littles-law> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Little's law"@en ;
  skos:definition "The relation that the mean number of items in a stable system equals mean arrival rate times mean time in the system."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.littles-law> skos:altLabel "L = lambda W"@en .

<https://mlsysbook.ai/taxonomy/mlsys.latency-throughput-curve> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Latency-throughput curve"@en ;
  skos:definition "The relationship between offered load and latency, in which queueing delay grows sharply as utilization approaches capacity."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.latency-throughput-curve> skos:altLabel "load-latency curve"@en .

<https://mlsysbook.ai/taxonomy/mlsys.arrival-burstiness> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Arrival burstiness"@en ;
  skos:definition "Variability of request inter-arrival times or sizes beyond a Poisson baseline, which raises queueing delay at a given mean utilization."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.compute-optimal-allocation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Compute-optimal allocation"@en ;
  skos:definition "Choosing model size and training data quantity to minimize loss under a fixed training compute budget, using fitted scaling laws."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.compute-optimal-allocation> skos:altLabel "Chinchilla scaling"@en .

<https://mlsysbook.ai/taxonomy/mlsys.training-compute-estimate> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Training compute estimate"@en ;
  skos:definition "Approximating dense transformer training compute as roughly six floating-point operations per parameter per training token."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.training-compute-estimate> skos:altLabel "6ND"@en .

<https://mlsysbook.ai/taxonomy/mlsys.systolic-array> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Systolic array"@en ;
  skos:definition "A grid of processing elements that pass operands rhythmically to neighbors, performing matrix multiplication with high operand reuse and little register-file traffic."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.matrix-unit> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Matrix engine"@en ;
  skos:definition "A functional unit that executes small dense matrix multiply-accumulate tiles per instruction, supplying most of an accelerator's peak low-precision throughput."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.matrix-unit> skos:altLabel "Tensor Core"@en .
<https://mlsysbook.ai/taxonomy/mlsys.matrix-unit> skos:altLabel "MXU"@en .

<https://mlsysbook.ai/taxonomy/mlsys.simt> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "SIMT execution"@en ;
  skos:definition "An execution model in which groups of threads issue common instructions to active lanes, with divergent paths executed under lane masks and architecture-specific reconvergence."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.simt> skos:altLabel "warp"@en .
<https://mlsysbook.ai/taxonomy/mlsys.simt> skos:altLabel "warp divergence"@en .
<https://mlsysbook.ai/taxonomy/mlsys.simt> skos:altLabel "branch divergence"@en .

<https://mlsysbook.ai/taxonomy/mlsys.dataflow> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Accelerator dataflow"@en ;
  skos:definition "The mapping that decides which operands stay resident in local storage while others stream, such as weight-, output-, or row-stationary schedules."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.dataflow> skos:altLabel "stationarity"@en .

<https://mlsysbook.ai/taxonomy/mlsys.domain-specific-architecture> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Domain-specific architecture"@en ;
  skos:definition "Hardware specialized to a class of workloads, trading programmability for higher performance per watt on its target operations."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.domain-specific-architecture> skos:altLabel "DSA"@en .

<https://mlsysbook.ai/taxonomy/mlsys.hbm> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "High-bandwidth memory"@en ;
  skos:definition "Stacked DRAM placed beside the processor on an interposer, providing very high bandwidth with limited capacity per stack."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.hbm> skos:altLabel "HBM"@en .

<https://mlsysbook.ai/taxonomy/mlsys.on-chip-sram> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "On-chip SRAM and scratchpads"@en ;
  skos:definition "Small, fast on-die storage, such as caches, shared memory, and register files, used to stage reused operands near compute units."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.memory-wall> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Memory wall"@en ;
  skos:definition "The widening gap between processor arithmetic throughput and memory bandwidth or latency, which makes data movement the limiting factor."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.scale-up-interconnect> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Scale-up interconnect"@en ;
  skos:definition "High-bandwidth links and switches, such as NVLink-class fabrics, joining accelerators within a node or rack into one tightly coupled domain."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.coherent-interconnect> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Cache-coherent interconnect"@en ;
  skos:definition "A link protocol that lets hosts and devices share or pool memory with hardware coherence, such as CXL over a PCIe physical layer."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.coherent-interconnect> skos:altLabel "CXL"@en .

<https://mlsysbook.ai/taxonomy/mlsys.peer-to-peer-transfer> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Peer-to-peer device transfer"@en ;
  skos:definition "Direct memory access between accelerators, or between accelerators and NICs or storage, without staging data through host memory."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.peer-to-peer-transfer> skos:altLabel "GPUDirect"@en .

<https://mlsysbook.ai/taxonomy/mlsys.tdp> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Thermal design power"@en ;
  skos:definition "The sustained heat dissipation a cooling solution is designed to remove, used as a chip's nominal power envelope."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.tdp> skos:altLabel "TDP"@en .

<https://mlsysbook.ai/taxonomy/mlsys.dvfs> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Dynamic voltage and frequency scaling"@en ;
  skos:definition "Adjusting supply voltage and clock frequency at runtime to trade performance for power, since dynamic power grows superlinearly with voltage."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.dvfs> skos:altLabel "DVFS"@en .

<https://mlsysbook.ai/taxonomy/mlsys.dark-silicon> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Dark silicon"@en ;
  skos:definition "The fraction of a chip that cannot be powered at full frequency simultaneously within its power and thermal budget."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.power-capping> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Power capping"@en ;
  skos:definition "Enforcing a maximum power draw on a device or group by limiting clocks or activity, trading peak throughput for bounded power."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.microcontroller> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Microcontroller-class device"@en ;
  skos:definition "A low-power processor with on-chip flash and kilobytes to a few megabytes of SRAM, typically without an operating system or virtual memory."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.microcontroller> skos:altLabel "MCU"@en .
<https://mlsysbook.ai/taxonomy/mlsys.microcontroller> skos:altLabel "TinyML device"@en .

<https://mlsysbook.ai/taxonomy/mlsys.heterogeneous-soc> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Heterogeneous mobile SoC"@en ;
  skos:definition "A system-on-chip combining CPU, GPU, DSP, and NPU blocks under shared memory and power limits, across which model operators are partitioned."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.edge-npu> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "On-device neural accelerator"@en ;
  skos:definition "An accelerator integrated in mobile or embedded silicon for low-precision neural inference, usually supporting a restricted set of operators."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.edge-npu> skos:altLabel "NPU"@en .

<https://mlsysbook.ai/taxonomy/mlsys.energy-per-inference> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Energy per inference"@en ;
  skos:definition "Energy consumed to process one input end to end on a device, the binding metric for battery-powered and energy-harvesting deployments."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.on-device-memory-budget> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "On-device memory budget"@en ;
  skos:definition "The flash and SRAM limits that bound a deployed model's stored weights and peak activation memory on embedded hardware."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.on-device-memory-budget> skos:altLabel "app memory limit"@en .
<https://mlsysbook.ai/taxonomy/mlsys.on-device-memory-budget> skos:altLabel "mobile memory budget"@en .

<https://mlsysbook.ai/taxonomy/mlsys.tensor> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Tensor"@en ;
  skos:definition "A multidimensional array carrying shape, element type, device, and layout metadata, the core data abstraction of ML frameworks."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.computation-graph> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Computation graph"@en ;
  skos:definition "A directed graph of tensor operations and their data dependencies representing a model program, used for differentiation, optimization, and scheduling."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.eager-execution> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Eager vs. graph execution"@en ;
  skos:definition "The choice between running each operation as the host program issues it and building a whole graph first for later optimization and execution."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.eager-execution> skos:altLabel "define-by-run"@en .

<https://mlsysbook.ai/taxonomy/mlsys.tracing-jit> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Tracing and JIT capture"@en ;
  skos:definition "Recording operations executed on example inputs to build a graph compiled just in time, with guards or retracing when shapes or control flow change."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.tracing-jit> skos:altLabel "JIT compilation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.io-aware-attention> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "IO-aware attention kernel"@en ;
  skos:definition "An exact attention implementation that tiles queries, keys, and values through on-chip memory to avoid materializing the full score matrix in off-chip memory."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.io-aware-attention> skos:altLabel "FlashAttention"@en .

<https://mlsysbook.ai/taxonomy/mlsys.convolution-lowering> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Convolution lowering"@en ;
  skos:definition "Implementing convolution by rearranging input patches into matrices for GEMM, or by direct, FFT, or Winograd algorithms with different memory costs."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.convolution-lowering> skos:altLabel "im2col"@en .

<https://mlsysbook.ai/taxonomy/mlsys.kernel-library> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Vendor kernel library"@en ;
  skos:definition "Tuned implementations of common operators supplied for a hardware platform, which frameworks call rather than generating their own kernels."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.kernel-library> skos:altLabel "cuBLAS"@en .
<https://mlsysbook.ai/taxonomy/mlsys.kernel-library> skos:altLabel "cuDNN"@en .

<https://mlsysbook.ai/taxonomy/mlsys.intermediate-representation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "ML compiler IR"@en ;
  skos:definition "Program representations at graph, tensor, and loop levels on which compilers apply lowering and optimization passes."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.intermediate-representation> skos:altLabel "graph IR"@en .
<https://mlsysbook.ai/taxonomy/mlsys.intermediate-representation> skos:altLabel "MLIR"@en .

<https://mlsysbook.ai/taxonomy/mlsys.autotuning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Kernel autotuning"@en ;
  skos:definition "Searching kernel schedule parameters, such as tile sizes and loop orders, by measurement or learned cost models to find fast implementations for a target."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.kernel-dsl> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Kernel DSL"@en ;
  skos:definition "A domain-specific language for writing tiled tensor kernels above the level of vendor assembly, with the compiler handling memory and thread mapping."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.kernel-dsl> skos:altLabel "Triton"@en .

<https://mlsysbook.ai/taxonomy/mlsys.memory-planning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Static memory planning"@en ;
  skos:definition "Compile-time assignment of tensor buffers to memory with lifetime-based reuse, reducing peak memory and runtime allocation."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.device-streams> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Device streams"@en ;
  skos:definition "Ordered queues of device work that the host enqueues asynchronously, with events expressing dependencies and allowing overlap across queues."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.device-streams> skos:altLabel "CUDA streams"@en .

<https://mlsysbook.ai/taxonomy/mlsys.caching-allocator> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Caching memory allocator"@en ;
  skos:definition "A runtime allocator that retains and reuses freed device memory blocks to avoid costly allocation calls, at the risk of fragmentation."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.graph-replay> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Captured graph replay"@en ;
  skos:definition "Recording a fixed sequence of kernel launches once and replaying it as a unit to remove per-launch host overhead."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.graph-replay> skos:altLabel "CUDA Graphs"@en .

<https://mlsysbook.ai/taxonomy/mlsys.loss-scaling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Loss scaling"@en ;
  skos:definition "Multiplying the loss before backpropagation so small gradients remain representable in reduced-precision formats, then unscaling before the optimizer step."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.block-scaled-format> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Block-scaled number formats"@en ;
  skos:definition "Low-precision formats in which small blocks of values share a scale factor, extending dynamic range for FP8, FP6, FP4, or INT8 elements."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.block-scaled-format> skos:altLabel "MX"@en .
<https://mlsysbook.ai/taxonomy/mlsys.block-scaled-format> skos:altLabel "microscaling"@en .
<https://mlsysbook.ai/taxonomy/mlsys.block-scaled-format> skos:altLabel "MXFP8"@en .
<https://mlsysbook.ai/taxonomy/mlsys.block-scaled-format> skos:altLabel "FP8 with block scaling"@en .

<https://mlsysbook.ai/taxonomy/mlsys.accumulation-precision> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Accumulation precision"@en ;
  skos:definition "The numerical format used to sum products in dot products and reductions, which may differ from input precision and governs rounding-error growth."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.expert-parallel> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Expert parallelism"@en ;
  skos:definition "Placing different experts of a mixture-of-experts layer on different devices and exchanging routed tokens among them."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.expert-parallel> skos:altLabel "EP"@en .

<https://mlsysbook.ai/taxonomy/mlsys.sequence-parallel> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Sequence and context parallelism"@en ;
  skos:definition "Partitioning activations along the sequence dimension across devices, exchanging keys, values, or partial results so long sequences fit."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.sequence-parallel> skos:altLabel "context parallelism"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sequence-parallel> skos:altLabel "ring attention"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sequence-parallel> skos:altLabel "sequence parallelism"@en .

<https://mlsysbook.ai/taxonomy/mlsys.hybrid-parallel> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Hybrid parallelism"@en ;
  skos:definition "Combining data, tensor, pipeline, and other parallelism dimensions, mapped onto the hardware hierarchy so the most communication-intensive dimension uses the fastest links."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.hybrid-parallel> skos:altLabel "3D parallelism"@en .

<https://mlsysbook.ai/taxonomy/mlsys.pipeline-bubble> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Pipeline bubble"@en ;
  skos:definition "Idle device time during pipeline fill and drain, whose fraction shrinks as the number of microbatches grows relative to pipeline stages."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.ring-allreduce> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Ring all-reduce"@en ;
  skos:definition "An all-reduce performed as reduce-scatter then all-gather around a ring, bandwidth-optimal for large messages but with latency linear in participants."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.tree-allreduce> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Tree and hierarchical all-reduce"@en ;
  skos:definition "All-reduce schedules over trees or hierarchical groups, with latency logarithmic in participants, suited to small messages and multi-level networks."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.all-to-all> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "All-to-all exchange"@en ;
  skos:definition "A collective in which every participant sends distinct data to every other, as in expert routing; its throughput is sensitive to bisection bandwidth."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.all-to-all> skos:altLabel "AllToAll"@en .

<https://mlsysbook.ai/taxonomy/mlsys.alpha-beta-model> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Alpha-beta communication model"@en ;
  skos:definition "A cost model estimating message time as a fixed latency term plus message size times a per-byte cost, used to compare collective algorithms."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.alpha-beta-model> skos:altLabel "latency-bandwidth model"@en .
<https://mlsysbook.ai/taxonomy/mlsys.alpha-beta-model> skos:altLabel "network transfer time"@en .
<https://mlsysbook.ai/taxonomy/mlsys.alpha-beta-model> skos:altLabel "transfer time"@en .

<https://mlsysbook.ai/taxonomy/mlsys.gradient-compression> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Gradient compression"@en ;
  skos:definition "Reducing gradient communication through quantization, sparsification, or low-rank approximation, often with error feedback to preserve convergence."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.lease> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Lease"@en ;
  skos:definition "A time-bounded grant of authority or cached state that expires unless renewed, letting a system recover from failed holders without explicit release."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.leader-election> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Leader election"@en ;
  skos:definition "Selecting a single coordinator among replicas, typically through consensus and leases, so control decisions have one authoritative source."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.bounded-staleness> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Bounded staleness"@en ;
  skos:definition "A consistency model in which workers may compute on parameters up to a fixed number of updates old, trading freshness for less waiting."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.bounded-staleness> skos:altLabel "stale synchronous parallel"@en .

<https://mlsysbook.ai/taxonomy/mlsys.federated-averaging> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Federated averaging"@en ;
  skos:definition "A federated algorithm in which sampled clients run several local optimization steps and a server averages their model updates, weighted by data size."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.federated-averaging> skos:altLabel "FedAvg"@en .

<https://mlsysbook.ai/taxonomy/mlsys.non-iid-data> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Statistical heterogeneity"@en ;
  skos:definition "Differences in data distribution and quantity across federated clients, which slow convergence and can bias a shared model."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.non-iid-data> skos:altLabel "non-IID data"@en .

<https://mlsysbook.ai/taxonomy/mlsys.client-sampling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Client selection"@en ;
  skos:definition "Choosing which available devices participate in each federated round, subject to availability, connectivity, and power constraints."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.federation-setting> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Cross-device vs. cross-silo federation"@en ;
  skos:definition "The distinction between federations of many intermittently available devices and federations of a few reliable organizational data holders."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.pue> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Power usage effectiveness"@en ;
  skos:definition "Total facility energy divided by IT equipment energy, measuring overhead from cooling, power conversion, and other non-compute loads."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.pue> skos:altLabel "PUE"@en .

<https://mlsysbook.ai/taxonomy/mlsys.liquid-cooling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Liquid cooling"@en ;
  skos:definition "Removing heat with liquid through cold plates or immersion, enabling rack power densities beyond the practical limits of air cooling."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.rack-power-density> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Rack power density"@en ;
  skos:definition "Electrical power drawn per rack, which determines cooling technology, floor layout, and how many accelerators fit within a facility's power envelope."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.power-oversubscription> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Power oversubscription"@en ;
  skos:definition "Deploying more equipment than the sum of nameplate power a feed supports, relying on non-coincident peaks and power capping to stay within limits."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.warehouse-scale-computer> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Warehouse-scale computer"@en ;
  skos:definition "A datacenter treated as a single computer whose power, cooling, network, and software are co-designed for a common workload."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.warehouse-scale-computer> skos:altLabel "WSC"@en .

<https://mlsysbook.ai/taxonomy/mlsys.rdma> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Remote direct memory access"@en ;
  skos:definition "Network transfers that read or write remote memory directly through the network interface without remote CPU involvement, giving low latency and high throughput."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.rdma> skos:altLabel "RDMA"@en .
<https://mlsysbook.ai/taxonomy/mlsys.rdma> skos:altLabel "InfiniBand"@en .
<https://mlsysbook.ai/taxonomy/mlsys.rdma> skos:altLabel "RoCE"@en .

<https://mlsysbook.ai/taxonomy/mlsys.lossless-fabric> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Lossless network fabric"@en ;
  skos:definition "A network that avoids packet drops through credit-based or priority flow control, as RDMA transports expect, at the risk of head-of-line blocking."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.lossless-fabric> skos:altLabel "PFC"@en .

<https://mlsysbook.ai/taxonomy/mlsys.congestion-control> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Datacenter congestion control"@en ;
  skos:definition "End-host and switch mechanisms, such as ECN-driven rate control, that limit queue buildup from incast and synchronized collective traffic."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.congestion-control> skos:altLabel "DCQCN"@en .

<https://mlsysbook.ai/taxonomy/mlsys.fat-tree> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Fat-tree (Clos) topology"@en ;
  skos:definition "A multistage switch topology providing many equal-cost paths and, without oversubscription, full bisection bandwidth between endpoints."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.fat-tree> skos:altLabel "Clos"@en .

<https://mlsysbook.ai/taxonomy/mlsys.rail-optimized> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Rail-optimized topology"@en ;
  skos:definition "A fabric design connecting the same-index accelerator of every node to a common leaf switch, keeping most collective traffic within one switch hop."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.bisection-bandwidth> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Bisection bandwidth"@en ;
  skos:definition "The minimum total bandwidth across any cut dividing a network into two equal halves, bounding throughput of all-to-all and global exchanges."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.in-network-reduction> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "In-network reduction"@en ;
  skos:definition "Performing collective reductions inside network switches so data crosses each link fewer times, lowering all-reduce traffic and latency."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.in-network-reduction> skos:altLabel "SHARP"@en .

<https://mlsysbook.ai/taxonomy/mlsys.parallel-file-system> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Parallel file system"@en ;
  skos:definition "A distributed file system that stripes data across many storage servers to deliver aggregate bandwidth to many concurrent clients."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.parallel-file-system> skos:altLabel "Lustre"@en .
<https://mlsysbook.ai/taxonomy/mlsys.parallel-file-system> skos:altLabel "GPFS"@en .

<https://mlsysbook.ai/taxonomy/mlsys.object-storage> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Object storage"@en ;
  skos:definition "Storage of immutable named objects behind an HTTP-style interface, offering scalable capacity and throughput with higher per-request latency than file systems."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.input-pipeline> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Training input pipeline"@en ;
  skos:definition "The read, decode, transform, shuffle, and prefetch stages that deliver batches to accelerators; when slower than compute, they cause data stalls."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.checkpoint-io> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Checkpoint I/O"@en ;
  skos:definition "Writing and reading large training-state snapshots, where storage bandwidth, asynchronous persistence, and sharded layout determine checkpoint cost."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.storage-tiering> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Storage tiering and caching"@en ;
  skos:definition "Placing data across tiers, from memory and local NVMe caches to shared and archival storage, according to access frequency and cost."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.gang-scheduling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Gang scheduling"@en ;
  skos:definition "Allocating all resources a parallel job needs at once, or none, so tightly coupled workers start together and partial allocations cannot deadlock."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.job-preemption> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Job preemption"@en ;
  skos:definition "Suspending or evicting a running job to reclaim its resources for higher-priority work, at a cost set by checkpointing and lost progress."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.dominant-resource-fairness> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Dominant resource fairness"@en ;
  skos:definition "A multi-resource fair-sharing policy that equalizes each user's largest share across resource types such as accelerators, CPUs, and memory."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.dominant-resource-fairness> skos:altLabel "DRF"@en .

<https://mlsysbook.ai/taxonomy/mlsys.elastic-training> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Elastic training"@en ;
  skos:definition "Training that continues while the number of workers changes, resharding state and adjusting batch size or learning rate as resources join or leave."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.topology-aware-placement> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Topology-aware placement"@en ;
  skos:definition "Assigning a job's workers to devices and nodes so that heavily communicating groups share fast links or switches."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.bin-packing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Bin packing"@en ;
  skos:definition "Placing jobs onto nodes to minimize fragmentation of resources such as accelerators, trading packing density against interference and locality."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.multi-tenancy> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Multi-tenancy"@en ;
  skos:definition "Sharing infrastructure among teams, jobs, or customers under policies for allocation, isolation, priority, and accounting."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.resource-quota> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Resource quota"@en ;
  skos:definition "A limit on the resources a tenant may hold or request, sometimes with guaranteed minimums and borrowing of idle capacity."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.gpu-partitioning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Accelerator sharing and partitioning"@en ;
  skos:definition "Running several workloads on one accelerator by time-slicing, concurrent contexts, or hardware partitions with dedicated memory and compute slices."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.gpu-partitioning> skos:altLabel "MIG"@en .
<https://mlsysbook.ai/taxonomy/mlsys.gpu-partitioning> skos:altLabel "GPU sharing"@en .

<https://mlsysbook.ai/taxonomy/mlsys.spot-capacity> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Spot and preemptible capacity"@en ;
  skos:definition "Discounted compute that the provider may reclaim at short notice, usable by workloads that tolerate interruption."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.performance-interference> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Performance interference"@en ;
  skos:definition "Slowdown of one workload caused by co-located workloads contending for shared caches, memory bandwidth, network, or power."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.performance-interference> skos:altLabel "noisy neighbor"@en .

<https://mlsysbook.ai/taxonomy/mlsys.weak-supervision> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Weak supervision"@en ;
  skos:definition "Producing training labels from noisy programmatic sources such as heuristics, rules, or distant supervision, then modeling and combining their errors."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.active-learning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Active learning"@en ;
  skos:definition "Selecting which unlabeled examples to annotate next according to their expected value to the model."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.annotator-agreement> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Inter-annotator agreement"@en ;
  skos:definition "The degree to which independent annotators assign the same label to the same item, used to measure label reliability and task ambiguity."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.quality-filtering> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Quality filtering"@en ;
  skos:definition "Removing or down-weighting training examples judged low quality by heuristics, classifiers, or model scores."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-mixture> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data mixture"@en ;
  skos:definition "The proportions in which source domains or datasets are sampled during training."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.data-mixture> skos:altLabel "domain mixture"@en .

<https://mlsysbook.ai/taxonomy/mlsys.synthetic-data> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Synthetic data"@en ;
  skos:definition "Training or evaluation examples generated by simulators, programs, or models rather than collected from the target environment."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-augmentation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data augmentation"@en ;
  skos:definition "Creating additional training examples by applying label-preserving transformations to existing ones."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-validation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data validation"@en ;
  skos:definition "Automated checks of incoming data against expected schema, value ranges, and distributions before it is used for training or serving."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.feature-store> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Feature store"@en ;
  skos:definition "A system that defines, computes, stores, and serves features consistently for offline training and online inference."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.stream-processing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Stream processing"@en ;
  skos:definition "Continuously transforming unbounded event streams with low latency and incrementally maintained state."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.feature-backfill> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Feature backfill"@en ;
  skos:definition "Recomputing a feature's historical values under a new or corrected definition so training data matches what serving will produce."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-versioning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Dataset versioning"@en ;
  skos:definition "Recording immutable, addressable versions of datasets so that a training run or evaluation can identify exactly which data it used."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-dependency> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data dependency debt"@en ;
  skos:definition "Undeclared, unstable, or underused input signals on which a model depends, which can change or break its behavior silently."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.feature-freshness> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Feature freshness"@en ;
  skos:definition "The age of a feature value at the time it is used for a prediction, relative to the freshness assumed during training."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.learning-rate-schedule> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Learning-rate schedule"@en ;
  skos:definition "The planned variation of the optimizer step size over training, such as warmup followed by decay."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.critical-batch-size> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Critical batch size"@en ;
  skos:definition "The batch size beyond which increasing it further yields diminishing reductions in optimization steps to reach a target loss."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.training-instability> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Training instability"@en ;
  skos:definition "Loss spikes, divergence, or collapse during training, often mitigated by gradient clipping, schedule changes, normalization, or restarting from a checkpoint."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.gradient-accumulation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Gradient accumulation"@en ;
  skos:definition "Summing gradients over several micro-batches before one optimizer update to emulate a larger batch within limited memory."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.memory-offloading> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Training-state offloading"@en ;
  skos:definition "Moving optimizer state, parameters, or activations from accelerator memory to host memory or storage between uses."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.experiment-tracking> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Experiment tracking"@en ;
  skos:definition "Recording each run's code, data, configuration, metrics, and artifacts in a queryable store for comparison and reproduction."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.hyperparameter-transfer> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Hyperparameter transfer"@en ;
  skos:definition "Tuning hyperparameters on smaller proxy models and reusing them at larger scale under a parameterization designed to keep them stable."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.hyperparameter-transfer> skos:altLabel "muP"@en .

<https://mlsysbook.ai/taxonomy/mlsys.supervised-fine-tuning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Supervised fine-tuning"@en ;
  skos:definition "Continued training of a pretrained model on input-output demonstrations, such as instruction-response pairs, to shape task behavior."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.supervised-fine-tuning> skos:altLabel "SFT"@en .
<https://mlsysbook.ai/taxonomy/mlsys.supervised-fine-tuning> skos:altLabel "instruction tuning"@en .

<https://mlsysbook.ai/taxonomy/mlsys.lora> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Low-rank adaptation"@en ;
  skos:definition "Fine-tuning by learning low-rank update matrices added to frozen pretrained weights."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.lora> skos:altLabel "LoRA"@en .

<https://mlsysbook.ai/taxonomy/mlsys.rlhf> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "RL from human feedback"@en ;
  skos:definition "Optimizing a model's policy against a reward model trained on human preference comparisons, usually with a penalty for drifting from a reference model."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.rlhf> skos:altLabel "RLHF"@en .

<https://mlsysbook.ai/taxonomy/mlsys.reward-model> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Reward model"@en ;
  skos:definition "A learned model that scores outputs or trajectories to supply the training signal for policy optimization."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.preference-optimization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Direct preference optimization"@en ;
  skos:definition "Training a policy directly on preferred-versus-rejected output pairs with a classification-style loss, without a separate reward model or RL loop."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.preference-optimization> skos:altLabel "DPO"@en .

<https://mlsysbook.ai/taxonomy/mlsys.rlvr> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "RL with verifiable rewards"@en ;
  skos:definition "Reinforcement learning whose rewards come from programmatic outcome checks, making verifier correctness and reward computation part of the training system."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.rlvr> skos:altLabel "RLVR"@en .

<https://mlsysbook.ai/taxonomy/mlsys.rl-rollout> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "RL rollout generation"@en ;
  skos:definition "Sampling responses or trajectories from the current policy, often with an inference engine, to produce experience for policy updates."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.weight-sync> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Policy weight synchronization"@en ;
  skos:definition "Transferring updated policy weights from training workers to rollout workers, whose cost and frequency shape RL post-training throughput."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.policy-staleness> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Policy staleness"@en ;
  skos:definition "The lag between the policy version that generated rollouts and the version being updated, introduced by asynchronous rollout and training."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.policy-staleness> skos:altLabel "off-policy lag"@en .

<https://mlsysbook.ai/taxonomy/mlsys.online-learning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Online learning"@en ;
  skos:definition "Updating a model incrementally as each example or small batch arrives, rather than retraining on a fixed dataset."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.incremental-training> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Incremental training"@en ;
  skos:definition "Continuing training of an existing model from its current weights on new data instead of training from scratch."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.incremental-training> skos:altLabel "stateful training"@en .
<https://mlsysbook.ai/taxonomy/mlsys.incremental-training> skos:altLabel "warm-start training"@en .

<https://mlsysbook.ai/taxonomy/mlsys.catastrophic-forgetting> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Catastrophic forgetting"@en ;
  skos:definition "Loss of previously learned capability when a model is trained on new data or tasks."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.experience-replay> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Experience replay"@en ;
  skos:definition "Mixing stored past examples into updates on new data to reduce forgetting or reuse experience."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.on-device-training> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "On-device training"@en ;
  skos:definition "Updating model parameters on the deployment device using local data under its memory, energy, and compute limits."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.cross-validation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Cross-validation"@en ;
  skos:definition "Estimating performance by repeatedly training on some data partitions and evaluating on the held-out remainder."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.sequential-testing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Sequential testing"@en ;
  skos:definition "Experimental analysis that permits repeated looks at accumulating data while controlling error rates, unlike fixed-horizon tests."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.sequential-testing> skos:altLabel "SPRT"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sequential-testing> skos:altLabel "always-valid inference"@en .

<https://mlsysbook.ai/taxonomy/mlsys.experiment-interference> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Experiment interference"@en ;
  skos:definition "Treatment of one experimental unit affecting outcomes of another, violating the no-interference assumption (SUTVA) of standard A/B analysis."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.experiment-interference> skos:altLabel "SUTVA violation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.conformal-prediction> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Conformal prediction"@en ;
  skos:definition "Constructing prediction sets with finite-sample coverage guarantees under exchangeability, using held-out calibration scores."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.slice-discovery> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Slice discovery"@en ;
  skos:definition "Automatically finding coherent data subsets on which a model underperforms, without predefined slice labels."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.llm-judge> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model-based grading"@en ;
  skos:definition "Using a language model to score or compare generated outputs against a rubric, with its own biases and error rates to be measured."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.llm-judge> skos:altLabel "LLM-as-judge"@en .

<https://mlsysbook.ai/taxonomy/mlsys.pass-at-k> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "pass@k"@en ;
  skos:definition "The probability that at least one of k sampled outputs satisfies a correctness check."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.pairwise-preference-eval> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Pairwise preference evaluation"@en ;
  skos:definition "Ranking models from judgments of which of two outputs is better, typically aggregated with a Bradley-Terry or Elo-style model."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.human-evaluation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Human evaluation"@en ;
  skos:definition "Assessment of system outputs by people following a protocol, used where automatic metrics or model graders are not trusted."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.benchmark-contamination> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Benchmark contamination"@en ;
  skos:definition "Presence of evaluation items, or close variants, in a model's training data, inflating measured performance."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.time-to-train> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Time to train"@en ;
  skos:definition "Wall-clock time for a system to train a specified model to a specified quality target under fixed run rules."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.inference-load-scenario> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Inference load scenario"@en ;
  skos:definition "A specified query-arrival pattern and latency constraint, such as single-stream, server, or offline, under which inference performance is measured."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.metamorphic-testing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Metamorphic testing"@en ;
  skos:definition "Testing by checking that known relations hold between outputs for related inputs, when correct outputs for single inputs are unknown."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.behavioral-testing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Behavioral testing"@en ;
  skos:definition "Testing model capabilities with targeted input suites for invariance, directional change, and minimum functionality, independent of aggregate accuracy."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.production-readiness> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Production-readiness assessment"@en ;
  skos:definition "A structured rubric of data, model, infrastructure, and monitoring tests used to judge whether an ML system is ready to operate."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.online-inference> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Online inference"@en ;
  skos:definition "Producing predictions on demand for individual requests within a latency target."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.online-inference> skos:altLabel "real-time prediction"@en .

<https://mlsysbook.ai/taxonomy/mlsys.batch-inference> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Batch inference"@en ;
  skos:definition "Computing predictions for many inputs in scheduled jobs and storing them for later lookup."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.batch-inference> skos:altLabel "offline prediction"@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-server> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model server"@en ;
  skos:definition "A service that loads model artifacts and executes inference requests behind a network interface, managing versions, batching, and resources."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-server> skos:altLabel "inference server"@en .

<https://mlsysbook.ai/taxonomy/mlsys.multi-model-serving> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Multi-model serving"@en ;
  skos:definition "Hosting many models or adapters on shared serving resources, trading isolation and load time against utilization."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-cascade> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model cascade"@en ;
  skos:definition "Sending a request to cheaper models first and escalating to more capable models only when a confidence or quality criterion is not met."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-routing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model routing"@en ;
  skos:definition "Choosing which model serves each request from request features, predicted quality, and cost."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.ttft> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Time to first token"@en ;
  skos:definition "Latency from request arrival until the first generated token is returned, dominated by queueing and prefill."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.ttft> skos:altLabel "TTFT"@en .

<https://mlsysbook.ai/taxonomy/mlsys.tpot> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Time per output token"@en ;
  skos:definition "For a request producing multiple tokens, its elapsed decoding time after the first output divided by its remaining generated-token count, summarizing average decoding speed at a declared measurement boundary."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.tpot> skos:altLabel "TPOT"@en .

<https://mlsysbook.ai/taxonomy/mlsys.hedged-requests> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Hedged requests"@en ;
  skos:definition "Issuing a duplicate request to another replica when the first has not responded within a delay, and using whichever returns first."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.continuous-batching> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Continuous batching"@en ;
  skos:definition "Scheduling at each generation iteration so finished sequences leave and new requests join a running batch."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.continuous-batching> skos:altLabel "iteration-level batching"@en .
<https://mlsysbook.ai/taxonomy/mlsys.continuous-batching> skos:altLabel "in-flight batching"@en .

<https://mlsysbook.ai/taxonomy/mlsys.load-balancing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Request load balancing"@en ;
  skos:definition "Distributing requests across replicas according to load, locality, or cached state."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.cold-start> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model cold start"@en ;
  skos:definition "Delay before a newly started replica can serve, from provisioning, loading weights, and warming runtime state."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.chunked-prefill> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Chunked prefill"@en ;
  skos:definition "Splitting a long prompt's prefill into chunks interleaved with decode steps to bound per-iteration latency."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.pd-disaggregation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Prefill-decode disaggregation"@en ;
  skos:definition "Running prefill and decode on separate resource pools, transferring KV state between them, so each phase is provisioned and batched independently."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.pd-disaggregation> skos:altLabel "disaggregated serving"@en .

<https://mlsysbook.ai/taxonomy/mlsys.sampling-controls> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Decoding and sampling controls"@en ;
  skos:definition "Parameters and rules, such as greedy, temperature, top-k, and nucleus sampling, that determine how tokens are chosen from a model's distribution."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.constrained-decoding> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Constrained decoding"@en ;
  skos:definition "Masking disallowed tokens at each step, typically from a grammar or schema automaton, so output satisfies a structural constraint."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.constrained-decoding> skos:altLabel "grammar-guided decoding"@en .

<https://mlsysbook.ai/taxonomy/mlsys.output-validation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Output validation"@en ;
  skos:definition "Checking generated output against a schema or rules after generation and repairing, retrying, or rejecting it on failure."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.reasoning-budget> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Reasoning budget"@en ;
  skos:definition "A limit on the intermediate tokens or steps a model may spend before answering, set to trade quality against latency and cost."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.reasoning-budget> skos:altLabel "thinking budget"@en .

<https://mlsysbook.ai/taxonomy/mlsys.best-of-n> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Best-of-n sampling"@en ;
  skos:definition "Generating n candidate outputs and returning the one ranked highest by a scorer or verifier."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.self-consistency> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Self-consistency voting"@en ;
  skos:definition "Sampling multiple reasoning paths and returning the most frequent final answer."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.self-consistency> skos:altLabel "majority voting"@en .

<https://mlsysbook.ai/taxonomy/mlsys.verifier> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Verifier"@en ;
  skos:definition "A model or program that judges whether a candidate output or reasoning step is correct, used for selection, search, or reward."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.verifier> skos:altLabel "outcome reward model"@en .

<https://mlsysbook.ai/taxonomy/mlsys.process-reward-model> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Process reward model"@en ;
  skos:definition "A verifier that scores intermediate reasoning steps rather than only final answers."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.process-reward-model> skos:altLabel "PRM"@en .

<https://mlsysbook.ai/taxonomy/mlsys.inference-time-search> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Inference-time search"@en ;
  skos:definition "Exploring a tree of partial solutions, as in beam or tree search, guided by a scorer, to find a higher-quality output."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.test-time-scaling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Test-time scaling"@en ;
  skos:definition "The empirical relation between inference compute spent per query and output quality, used to allocate compute between model size and inference."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.rag> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Retrieval-augmented generation"@en ;
  skos:definition "Conditioning generation on documents retrieved for the request so outputs can draw on information outside the model's parameters."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.rag> skos:altLabel "RAG"@en .

<https://mlsysbook.ai/taxonomy/mlsys.dense-retrieval> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Dense retrieval"@en ;
  skos:definition "Retrieving records by similarity between learned embeddings of query and records."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.lexical-retrieval> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Lexical retrieval"@en ;
  skos:definition "Retrieving records by weighted term overlap with the query using an inverted index, as in BM25."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.lexical-retrieval> skos:altLabel "sparse retrieval"@en .
<https://mlsysbook.ai/taxonomy/mlsys.lexical-retrieval> skos:altLabel "BM25"@en .

<https://mlsysbook.ai/taxonomy/mlsys.reranking> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Reranking"@en ;
  skos:definition "Reordering a retrieved candidate set with a more expensive relevance model before use."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-conversion> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model conversion"@en ;
  skos:definition "Translating a trained model into the format and operator set of a target runtime, possibly changing numerics and supported operations."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.on-device-runtime> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "On-device inference runtime"@en ;
  skos:definition "An interpreter or compiled engine that executes models locally on personal or embedded devices, including inside browsers, under the target environment's memory, operator, and execution limits."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.on-device-runtime> skos:altLabel "browser inference runtime"@en .
<https://mlsysbook.ai/taxonomy/mlsys.on-device-runtime> skos:altLabel "WebGPU inference"@en .
<https://mlsysbook.ai/taxonomy/mlsys.on-device-runtime> skos:altLabel "WebAssembly inference"@en .

<https://mlsysbook.ai/taxonomy/mlsys.ota-model-update> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Over-the-air model update"@en ;
  skos:definition "Delivering new model versions to deployed devices remotely, with staging, verification, and rollback across the device fleet."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.ota-model-update> skos:altLabel "OTA update"@en .

<https://mlsysbook.ai/taxonomy/mlsys.device-cloud-partitioning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Device-cloud partitioning"@en ;
  skos:definition "Splitting inference between device and server, by layer or by model, to balance latency, energy, bandwidth, and privacy."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.device-cloud-partitioning> skos:altLabel "split computing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.device-cloud-partitioning> skos:altLabel "offloading"@en .

<https://mlsysbook.ai/taxonomy/mlsys.device-heterogeneity> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Device heterogeneity"@en ;
  skos:definition "Variation in hardware, operating system, and runtime capability across a deployed device fleet that a single model release must accommodate."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-registry> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model registry"@en ;
  skos:definition "A versioned store of model artifacts with metadata, lineage, and lifecycle stage used to govern promotion and deployment."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.shadow-deployment> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Shadow deployment"@en ;
  skos:definition "Running a candidate model on live traffic without serving its outputs, to compare it against the production model."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.shadow-deployment> skos:altLabel "shadow mode"@en .

<https://mlsysbook.ai/taxonomy/mlsys.ml-ci-cd> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "CI/CD for ML"@en ;
  skos:definition "Automated building, testing, and deployment of ML code, data checks, and model artifacts on each change."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.release-gate> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Release gate"@en ;
  skos:definition "A predeclared set of checks a candidate model must pass before it advances to a wider deployment stage."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.release-gate> skos:altLabel "validation gate"@en .

<https://mlsysbook.ai/taxonomy/mlsys.drift-detection> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Drift detection"@en ;
  skos:definition "Statistical tests or distances comparing production and reference distributions of inputs, predictions, or outcomes to flag change."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.inference-logging> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Prediction logging"@en ;
  skos:definition "Recording requests, model versions, outputs, and later outcomes so production behavior can be analyzed, debugged, and reused as data."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.alerting> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Alerting"@en ;
  skos:definition "Rules that turn monitored signals into notifications for responders, tuned to balance missed incidents against alert fatigue."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.concept-drift> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Concept drift"@en ;
  skos:definition "Change over time in the relationship between inputs and targets, so the same input warrants a different prediction."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.continuous-training> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Continuous training"@en ;
  skos:definition "An automated pipeline that retrains, validates, and proposes models on a schedule or when triggered by data or performance signals."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.continuous-training> skos:altLabel "CT"@en .

<https://mlsysbook.ai/taxonomy/mlsys.postmortem> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Blameless postmortem"@en ;
  skos:definition "A written analysis after an incident of its timeline, causes, and corrective actions, focused on system fixes rather than blame."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.failure-attribution> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "ML failure attribution"@en ;
  skos:definition "Determining whether a production failure stems from data, model, code, configuration, or infrastructure, or from an adversary."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.configuration-management> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "ML configuration management"@en ;
  skos:definition "Treating model, feature, and pipeline configuration as versioned, reviewed, and tested code."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.infrastructure-as-code> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Infrastructure as code"@en ;
  skos:definition "Declaring compute, storage, and service infrastructure in versioned machine-readable files from which environments are provisioned."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.infrastructure-as-code> skos:altLabel "IaC"@en .

<https://mlsysbook.ai/taxonomy/mlsys.ml-platform> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "ML platform"@en ;
  skos:definition "Shared internal infrastructure and services that standardize how teams train, deploy, and operate models."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.technical-debt> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "ML technical debt"@en ;
  skos:definition "Accumulated system costs from shortcuts in ML code, data dependencies, configuration, and pipelines that make future change slower and riskier."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.entanglement> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Entanglement"@en ;
  skos:definition "The property that changing any input, feature, or hyperparameter of a model can change its behavior on everything else."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.entanglement> skos:altLabel "CACE"@en .

<https://mlsysbook.ai/taxonomy/mlsys.undeclared-consumers> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Undeclared consumers"@en ;
  skos:definition "Systems that use a model's outputs without the model owner's knowledge, creating hidden coupling."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.mlops-maturity> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "MLOps maturity"@en ;
  skos:definition "Staged levels of automation, from manual training and deployment to automated continuous training and delivery."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.ml-roles> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "ML team roles"@en ;
  skos:definition "The division of responsibilities among data, modeling, platform, and operations roles that owns an ML system across its lifecycle."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-deprecation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model deprecation"@en ;
  skos:definition "Planned withdrawal of a model from service, including notifying and migrating its consumers before removing it."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.artifact-archival> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Artifact archival"@en ;
  skos:definition "Preserving retired models, data references, and evaluation records needed for audit, reproduction, or rollback after service ends."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-retention> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data retention"@en ;
  skos:definition "Policy and mechanisms that set how long data, logs, and derived artifacts are kept and when they are deleted."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-flops-utilization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model FLOPs utilization"@en ;
  skos:definition "Model-required floating-point operations per second achieved, divided by the aggregate peak FLOP rate of the hardware used, excluding recomputation."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-flops-utilization> skos:altLabel "MFU"@en .

<https://mlsysbook.ai/taxonomy/mlsys.bottleneck-analysis> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Bottleneck analysis"@en ;
  skos:definition "Identifying the resource or stage, such as compute, memory bandwidth, I/O, or communication, whose capacity limits end-to-end throughput or latency for a workload."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.training-goodput> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Training goodput"@en ;
  skos:definition "The fraction of allocated accelerator time that produces retained training progress, after losses to scheduling, failures, restarts, and lost work."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.training-goodput> skos:altLabel "ML goodput"@en .

<https://mlsysbook.ai/taxonomy/mlsys.pruning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Pruning"@en ;
  skos:definition "Removing weights, neurons, channels, or other structures judged unimportant from a network, usually followed by fine-tuning to recover quality."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.structured-pruning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Structured pruning"@en ;
  skos:definition "Pruning whole channels, filters, heads, or layers so that the remaining model stays dense and runs faster without sparse-execution support."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.low-rank-factorization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Low-rank factorization"@en ;
  skos:definition "Approximating a weight matrix or tensor by a product of smaller factors of reduced rank to cut parameters and operations."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.low-rank-factorization> skos:altLabel "low-rank approximation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.quantization-aware-training> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Quantization-aware training"@en ;
  skos:definition "Training or fine-tuning with simulated quantization in the forward pass so the model adapts to reduced precision, in contrast to post-training quantization."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.quantization-aware-training> skos:altLabel "QAT"@en .

<https://mlsysbook.ai/taxonomy/mlsys.neural-architecture-search> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Neural architecture search"@en ;
  skos:definition "Automated search over a defined space of network architectures for designs that optimize a stated objective such as accuracy under a cost budget."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.neural-architecture-search> skos:altLabel "NAS"@en .

<https://mlsysbook.ai/taxonomy/mlsys.hardware-aware-nas> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Hardware-aware NAS"@en ;
  skos:definition "Architecture search whose objective includes latency, energy, or memory measured or predicted on the target device rather than proxy counts such as FLOPs."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.hardware-aware-nas> skos:altLabel "platform-aware NAS"@en .

<https://mlsysbook.ai/taxonomy/mlsys.depthwise-separable-convolution> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Depthwise separable convolution"@en ;
  skos:definition "Factoring a standard convolution into a per-channel spatial convolution followed by a pointwise convolution, reducing operations and parameters."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.efficiency-frontier> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Accuracy-efficiency frontier"@en ;
  skos:definition "The set of model configurations for which no alternative improves quality without worsening a stated cost measure, such as latency, memory, or energy, on a stated platform."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.efficiency-frontier> skos:altLabel "accuracy-cost frontier"@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-hardware-co-design> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model-hardware co-design"@en ;
  skos:definition "Jointly choosing model architecture and hardware or kernel design so that each exploits the other's structure."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.retry-backoff> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Retry with backoff"@en ;
  skos:definition "Reissuing a failed request after increasing, typically jittered, delays and within a retry budget, so that transient faults recover without overloading dependencies."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.circuit-breaker> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Circuit breaker"@en ;
  skos:definition "A client-side guard that stops sending requests to a failing dependency after an error threshold and probes it before resuming traffic."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.replication-failover> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Replication and failover"@en ;
  skos:definition "Maintaining redundant replicas of a service or state and redirecting work to a healthy replica when one fails."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.graceful-degradation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Graceful degradation"@en ;
  skos:definition "Continuing to serve with reduced quality, features, or freshness under failure or overload instead of failing outright."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.checkpoint-interval> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Optimal checkpoint interval"@en ;
  skos:definition "The checkpoint period that minimizes expected lost time, balancing checkpoint write cost against expected rework, approximately the square root of twice the write cost times MTBF."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.checkpoint-interval> skos:altLabel "Young-Daly interval"@en .

<https://mlsysbook.ai/taxonomy/mlsys.async-checkpointing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Asynchronous checkpointing"@en ;
  skos:definition "Snapshotting training state quickly to host memory and persisting it in the background so computation resumes before the durable write completes."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.silent-data-corruption> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Silent data corruption"@en ;
  skos:definition "Hardware producing wrong computational results without raising an error or crash, so the corruption propagates undetected."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.silent-data-corruption> skos:altLabel "SDC"@en .

<https://mlsysbook.ai/taxonomy/mlsys.mtbf> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Mean time between failures"@en ;
  skos:definition "The expected operating time between failures of a component or system; for independent components, system MTBF shrinks roughly in inverse proportion to component count."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.mtbf> skos:altLabel "MTBF"@en .

<https://mlsysbook.ai/taxonomy/mlsys.availability> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Availability"@en ;
  skos:definition "The fraction of time or requests for which a system performs its specified function, approximately MTBF divided by MTBF plus mean time to repair."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.gray-failure> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Gray failure"@en ;
  skos:definition "A partial or degraded failure that some observers detect and others do not, such as a slow or lossy node that still passes health checks."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.failure-domain> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Failure domain"@en ;
  skos:definition "A set of components that can fail together from a shared cause, such as a rack, power feed, switch, or software release."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.failure-domain> skos:altLabel "correlated failure"@en .

<https://mlsysbook.ai/taxonomy/mlsys.abft> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Algorithm-based fault tolerance"@en ;
  skos:definition "Detecting or correcting computational errors by carrying checksums through an algorithm, such as matrix multiplication, and verifying invariants on its outputs."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.abft> skos:altLabel "ABFT"@en .

<https://mlsysbook.ai/taxonomy/mlsys.chaos-engineering> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Chaos engineering"@en ;
  skos:definition "Running controlled experiments that inject real-world failures into production-like systems to test a hypothesis about steady-state behavior."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.game-day> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Game day"@en ;
  skos:definition "A scheduled exercise in which teams deliberately trigger failure scenarios to rehearse detection, response, and recovery procedures."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.game-day> skos:altLabel "disaster recovery exercise"@en .

<https://mlsysbook.ai/taxonomy/mlsys.hardware-fault-injection> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Hardware fault injection"@en ;
  skos:definition "Emulating hardware faults such as bit flips in weights, activations, or registers to measure how errors propagate to model outputs."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.blast-radius> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Blast radius"@en ;
  skos:definition "The extent of users, components, or effects that a single fault, change, or experiment can impact."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.backdoor> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Backdoor attack"@en ;
  skos:definition "Implanting a hidden behavior in a model, via poisoned data or modified weights, that activates only on inputs containing an attacker-chosen trigger."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.backdoor> skos:altLabel "trojan attack"@en .

<https://mlsysbook.ai/taxonomy/mlsys.jailbreak> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Jailbreak"@en ;
  skos:definition "A user-crafted input that induces a model to bypass its safety training or usage policy and produce disallowed output."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.adversarial-training> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Adversarial training"@en ;
  skos:definition "Training on adversarially perturbed inputs generated during training to increase robustness within a specified perturbation set."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-extraction> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model extraction"@en ;
  skos:definition "Reconstructing a functionally equivalent copy or the parameters of a model by querying its prediction interface."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-extraction> skos:altLabel "model stealing"@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-watermarking> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model watermarking"@en ;
  skos:definition "Embedding a verifiable signature in a model's parameters or behavior so that ownership of copies or derivatives can later be demonstrated."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-watermarking> skos:altLabel "model fingerprinting"@en .

<https://mlsysbook.ai/taxonomy/mlsys.artifact-signing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model artifact signing"@en ;
  skos:definition "Cryptographically signing model files and their provenance metadata so that consumers can verify integrity and origin before loading."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.unsafe-deserialization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Unsafe model deserialization"@en ;
  skos:definition "Code execution triggered by loading a model stored in an executable serialization format, such as pickle, from an untrusted source."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.supply-chain-compromise> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "ML supply-chain compromise"@en ;
  skos:definition "Introducing malicious or vulnerable components into an ML system through third-party datasets, pretrained weights, libraries, build tools, or hardware."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.membership-inference> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Membership inference"@en ;
  skos:definition "Inferring whether a specific record was in a model's training data from the model's outputs or parameters."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-inversion> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model inversion"@en ;
  skos:definition "Reconstructing sensitive attributes or representative training inputs from a model's outputs, confidence scores, or shared parameter gradients."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-inversion> skos:altLabel "gradient inversion"@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-inversion> skos:altLabel "attribute inference"@en .

<https://mlsysbook.ai/taxonomy/mlsys.dp-sgd> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "DP-SGD"@en ;
  skos:definition "Stochastic gradient descent with per-example gradient clipping and calibrated noise, with privacy loss tracked across steps by an accountant."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.dp-sgd> skos:altLabel "differentially private SGD"@en .

<https://mlsysbook.ai/taxonomy/mlsys.machine-unlearning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Machine unlearning"@en ;
  skos:definition "Removing the influence of specified training records from a trained model, either exactly by retraining or approximately at lower cost."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.secure-aggregation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Secure aggregation"@en ;
  skos:definition "A cryptographic protocol that lets a server compute the sum of client updates without seeing any individual client's update."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.least-privilege> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Least privilege"@en ;
  skos:definition "Granting each component or actor only the permissions its task requires, for only as long as it requires them."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.confidential-computing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Confidential computing"@en ;
  skos:definition "Protecting data and models while in use by running computation inside hardware-isolated, attestable trusted execution environments."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.confidential-computing> skos:altLabel "trusted execution environment"@en .
<https://mlsysbook.ai/taxonomy/mlsys.confidential-computing> skos:altLabel "TEE"@en .

<https://mlsysbook.ai/taxonomy/mlsys.remote-attestation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Remote attestation"@en ;
  skos:definition "A procedure by which a platform proves to a remote verifier the identity and measured state of its hardware and software before receiving secrets."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.side-channel> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Side-channel attack"@en ;
  skos:definition "Inferring secrets from observable resource behavior, such as timing, power, memory, or cache contention, across an isolation boundary."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.energy-efficiency> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Energy efficiency"@en ;
  skos:definition "Useful work completed per unit energy, such as inferences or tokens per joule, measured within a stated system boundary."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.energy-efficiency> skos:altLabel "performance per watt"@en .

<https://mlsysbook.ai/taxonomy/mlsys.carbon-intensity> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Grid carbon intensity"@en ;
  skos:definition "Greenhouse-gas emissions per unit of electricity supplied, varying by region, time, and generation mix, in grams CO2-equivalent per kilowatt-hour."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.operational-carbon> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Operational carbon"@en ;
  skos:definition "Emissions from electricity consumed while operating a system, computed from energy use and the carbon intensity of its supply."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.emission-scopes> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Emission scopes"@en ;
  skos:definition "The GHG Protocol classification of emissions into direct (Scope 1), purchased energy (Scope 2), and value-chain (Scope 3) categories."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.emission-scopes> skos:altLabel "Scope 1, 2, and 3 emissions"@en .
<https://mlsysbook.ai/taxonomy/mlsys.emission-scopes> skos:altLabel "GHG scopes"@en .

<https://mlsysbook.ai/taxonomy/mlsys.carbon-aware-scheduling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Carbon-aware scheduling"@en ;
  skos:definition "Shifting flexible workloads in time or location toward periods and regions of lower grid carbon intensity, subject to deadlines and capacity."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.embodied-carbon> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Embodied carbon"@en ;
  skos:definition "Emissions from manufacturing, transporting, and disposing of hardware and facilities, attributed to a system independent of its operation."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.lifecycle-assessment> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Life cycle assessment"@en ;
  skos:definition "A standardized method for compiling and evaluating a product's environmental inputs, outputs, and impacts from raw materials through disposal."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.lifecycle-assessment> skos:altLabel "LCA"@en .

<https://mlsysbook.ai/taxonomy/mlsys.water-footprint> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Water footprint"@en ;
  skos:definition "Water withdrawn or consumed by a system, on site for cooling and off site for electricity generation, per unit of work or over its lifetime."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.water-footprint> skos:altLabel "WUE"@en .

<https://mlsysbook.ai/taxonomy/mlsys.hardware-lifetime> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Hardware service lifetime"@en ;
  skos:definition "The period a hardware asset stays in service before replacement, over which its embodied impacts and capital cost are amortized."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.hardware-lifetime> skos:altLabel "refresh cycle"@en .

<https://mlsysbook.ai/taxonomy/mlsys.e-waste> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Electronic waste"@en ;
  skos:definition "Discarded electronic equipment and components, including retired accelerators and servers, and the hazards and lost materials of their disposal."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.e-waste> skos:altLabel "e-waste"@en .

<https://mlsysbook.ai/taxonomy/mlsys.tco> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Total cost of ownership"@en ;
  skos:definition "The full cost of acquiring and operating a system over its life, including capital, energy, facilities, networking, staff, and amortization."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.tco> skos:altLabel "TCO"@en .

<https://mlsysbook.ai/taxonomy/mlsys.cost-per-token> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Cost per token"@en ;
  skos:definition "Serving or API expenditure divided by tokens processed or generated, often priced separately for input and output tokens."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.cost-attribution> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Cost attribution"@en ;
  skos:definition "Allocating shared infrastructure spend to teams, models, or workloads so that owners see and act on their costs."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.cost-attribution> skos:altLabel "FinOps"@en .
<https://mlsysbook.ai/taxonomy/mlsys.cost-attribution> skos:altLabel "chargeback"@en .

<https://mlsysbook.ai/taxonomy/mlsys.hazard-analysis> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Hazard analysis"@en ;
  skos:definition "Systematically identifying conditions under which a system could contribute to harm, with their causes, severity, and required controls."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.stpa> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "System-theoretic process analysis"@en ;
  skos:definition "Hazard analysis that models a system as a control structure and identifies unsafe control actions and the flawed feedback or process models that cause them."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.stpa> skos:altLabel "STPA"@en .

<https://mlsysbook.ai/taxonomy/mlsys.fmea> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Failure modes and effects analysis"@en ;
  skos:definition "Enumerating each component's possible failure modes and tracing their effects on system behavior to rank and mitigate them."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.fmea> skos:altLabel "FMEA"@en .

<https://mlsysbook.ai/taxonomy/mlsys.functional-insufficiency> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Functional insufficiency (SOTIF)"@en ;
  skos:definition "Hazardous behavior arising without any fault, from limits of a specification or of a component's performance, such as perception errors under particular triggering conditions."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.functional-insufficiency> skos:altLabel "SOTIF"@en .
<https://mlsysbook.ai/taxonomy/mlsys.functional-insufficiency> skos:altLabel "safety of the intended functionality"@en .

<https://mlsysbook.ai/taxonomy/mlsys.safety-filter> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Safety filter"@en ;
  skos:definition "A runtime component that passes a proposed action when it is certified safe and otherwise replaces it with a minimally different safe action."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.control-barrier-function> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Control barrier function"@en ;
  skos:definition "A function whose sign defines a safe set and whose derivative condition yields input constraints that keep the system state inside that set."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.control-barrier-function> skos:altLabel "CBF"@en .

<https://mlsysbook.ai/taxonomy/mlsys.simplex-architecture> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Simplex architecture"@en ;
  skos:definition "Pairing an unverified high-performance controller with a verified safety controller and a decision module that switches to the safety controller before safety is lost."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.minimal-risk-condition> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Minimal-risk condition"@en ;
  skos:definition "A predefined reduced-capability state the system reaches when it can no longer operate safely, often via an ordered ladder of fallback behaviors."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.minimal-risk-condition> skos:altLabel "MRC"@en .
<https://mlsysbook.ai/taxonomy/mlsys.minimal-risk-condition> skos:altLabel "safe fallback"@en .
<https://mlsysbook.ai/taxonomy/mlsys.minimal-risk-condition> skos:altLabel "fallback ladder"@en .

<https://mlsysbook.ai/taxonomy/mlsys.guardrails> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Guardrails"@en ;
  skos:definition "Runtime checks on model inputs and outputs that detect and block, rewrite, or escalate content or actions violating a stated safety policy."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.guardrails> skos:altLabel "content safety filter"@en .
<https://mlsysbook.ai/taxonomy/mlsys.guardrails> skos:altLabel "safety classifier"@en .

<https://mlsysbook.ai/taxonomy/mlsys.scenario-based-testing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Scenario-based testing"@en ;
  skos:definition "Validating a system against a structured catalog of operating scenarios and their parameter ranges, with coverage measured over the operating domain."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.falsification> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Simulation-based falsification"@en ;
  skos:definition "Searching scenario parameters, often guided by temporal-logic robustness, to find counterexamples that violate a safety specification."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.formal-verification> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Formal verification"@en ;
  skos:definition "Mathematically proving that a model of a system satisfies a formal specification for all behaviors within stated assumptions."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.neural-network-verification> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Neural network verification"@en ;
  skos:definition "Proving or refuting input-output properties of a trained network over a bounded input region, such as local robustness, using exact or bound-propagation methods."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.rare-event-validation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Rare-event safety validation"@en ;
  skos:definition "Estimating or bounding failure probabilities too small to observe in feasible exposure, using importance sampling, extreme-value models, or zero-failure statistical bounds."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.xil-testing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "X-in-the-loop testing"@en ;
  skos:definition "A qualification ladder that runs the real software, then real hardware, against simulated or recorded environments before physical trials."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.xil-testing> skos:altLabel "HIL"@en .
<https://mlsysbook.ai/taxonomy/mlsys.xil-testing> skos:altLabel "software-in-the-loop"@en .
<https://mlsysbook.ai/taxonomy/mlsys.xil-testing> skos:altLabel "hardware-in-the-loop"@en .

<https://mlsysbook.ai/taxonomy/mlsys.goal-structuring-notation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Goal Structuring Notation"@en ;
  skos:definition "A graphical notation for safety cases that links goals, strategies, solutions (evidence), context, and assumptions into an explicit argument structure."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.goal-structuring-notation> skos:altLabel "GSN"@en .

<https://mlsysbook.ai/taxonomy/mlsys.functional-safety> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Functional safety"@en ;
  skos:definition "Absence of unreasonable risk from malfunctioning electrical or electronic systems, achieved through a standardized safety lifecycle such as IEC 61508 or ISO 26262."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.safety-integrity-level> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Safety integrity level"@en ;
  skos:definition "A graded risk class assigned to a safety function that sets the rigor of development, verification, and tolerable failure rate required."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.safety-integrity-level> skos:altLabel "SIL"@en .
<https://mlsysbook.ai/taxonomy/mlsys.safety-integrity-level> skos:altLabel "ASIL"@en .

<https://mlsysbook.ai/taxonomy/mlsys.safety-performance-indicator> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Safety performance indicator"@en ;
  skos:definition "A field-measured metric tied to a safety-case claim whose threshold violation signals that the argument may no longer hold."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.safety-performance-indicator> skos:altLabel "SPI"@en .

<https://mlsysbook.ai/taxonomy/mlsys.group-fairness-metric> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Group fairness metrics"@en ;
  skos:definition "Statistics comparing selection rates, error rates, or calibration of a model's decisions across protected groups."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.group-fairness-metric> skos:altLabel "demographic parity"@en .
<https://mlsysbook.ai/taxonomy/mlsys.group-fairness-metric> skos:altLabel "equalized odds"@en .
<https://mlsysbook.ai/taxonomy/mlsys.group-fairness-metric> skos:altLabel "predictive parity"@en .

<https://mlsysbook.ai/taxonomy/mlsys.individual-fairness> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Individual fairness"@en ;
  skos:definition "A requirement that individuals who are similar with respect to the task receive similar outcomes under a stated similarity metric."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.fairness-incompatibility> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Fairness criteria incompatibility"@en ;
  skos:definition "The result that calibration and error-rate parity across groups cannot generally hold together when base rates differ, forcing an explicit choice among criteria."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.bias-mitigation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Bias mitigation"@en ;
  skos:definition "Interventions on data (pre-processing), training objective (in-processing), or decisions (post-processing) that reduce measured disparities, usually at some cost in other metrics."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.feature-attribution> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Feature attribution"@en ;
  skos:definition "Post-hoc explanation assigning each input feature a contribution to a specific prediction."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.feature-attribution> skos:altLabel "SHAP"@en .
<https://mlsysbook.ai/taxonomy/mlsys.feature-attribution> skos:altLabel "LIME"@en .
<https://mlsysbook.ai/taxonomy/mlsys.feature-attribution> skos:altLabel "integrated gradients"@en .
<https://mlsysbook.ai/taxonomy/mlsys.feature-attribution> skos:altLabel "saliency"@en .

<https://mlsysbook.ai/taxonomy/mlsys.counterfactual-explanation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Counterfactual explanation"@en ;
  skos:definition "An explanation stating the smallest feasible change to an input that would change the model's decision."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.interpretable-model> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Inherently interpretable model"@en ;
  skos:definition "A model whose structure, such as a sparse linear model, short rule list, or shallow tree, can be directly inspected to understand its predictions."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-card> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model card"@en ;
  skos:definition "A standardized document reporting a model's intended use, evaluation results across conditions and groups, limitations, and ethical considerations."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.datasheet> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Datasheet for datasets"@en ;
  skos:definition "A standardized document recording a dataset's motivation, composition, collection process, preprocessing, intended uses, and maintenance."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.datasheet> skos:altLabel "data card"@en .

<https://mlsysbook.ai/taxonomy/mlsys.contestability> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Contestability and recourse"@en ;
  skos:definition "The ability of an affected person to understand, challenge, and obtain review or reversal of a consequential automated decision."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.automation-bias> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Automation bias"@en ;
  skos:definition "The tendency of human supervisors to over-rely on automated outputs and to lose the vigilance and skill needed to catch their errors."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.automation-bias> skos:altLabel "automation complacency"@en .
<https://mlsysbook.ai/taxonomy/mlsys.automation-bias> skos:altLabel "ironies of automation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.authority-handover> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Authority handover"@en ;
  skos:definition "Transfer of control between an automated system and a human operator, bounded by human reaction time, situational awareness, and mode clarity."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.authority-handover> skos:altLabel "takeover"@en .
<https://mlsysbook.ai/taxonomy/mlsys.authority-handover> skos:altLabel "shared autonomy"@en .

<https://mlsysbook.ai/taxonomy/mlsys.ai-risk-management> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "AI risk management"@en ;
  skos:definition "An organizational process to govern, map, measure, and manage risks of AI systems throughout their lifecycle."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.ai-risk-management> skos:altLabel "NIST AI RMF"@en .
<https://mlsysbook.ai/taxonomy/mlsys.ai-risk-management> skos:altLabel "ISO/IEC 42001"@en .

<https://mlsysbook.ai/taxonomy/mlsys.impact-assessment> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Algorithmic impact assessment"@en ;
  skos:definition "A structured pre-deployment analysis of who an AI system could affect, how, and with what severity, used to decide mitigations or whether to deploy."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.algorithmic-audit> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Algorithmic audit"@en ;
  skos:definition "An internal or independent examination of an AI system's development records and behavior against stated requirements, standards, or law."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.risk-tiered-regulation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Risk-tiered AI regulation"@en ;
  skos:definition "Law that classifies AI uses by risk level and imposes obligations, such as conformity assessment, documentation, and human oversight, scaled to that level."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.risk-tiered-regulation> skos:altLabel "EU AI Act"@en .

<https://mlsysbook.ai/taxonomy/mlsys.frontier-safety-framework> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Frontier safety framework"@en ;
  skos:definition "A developer policy that ties dangerous-capability evaluation thresholds to required safeguards before further training or deployment of frontier models."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.frontier-safety-framework> skos:altLabel "responsible scaling policy"@en .
<https://mlsysbook.ai/taxonomy/mlsys.frontier-safety-framework> skos:altLabel "preparedness framework"@en .

<https://mlsysbook.ai/taxonomy/mlsys.context-compaction> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Context compaction"@en ;
  skos:definition "Replacing older parts of an agent's context with summaries or structured records so a long task fits the model's input budget."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.context-degradation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Long-context degradation"@en ;
  skos:definition "Decline in a model's use of relevant information as context grows or as that information sits away from the context's start or end."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.context-degradation> skos:altLabel "lost in the middle"@en .
<https://mlsysbook.ai/taxonomy/mlsys.context-degradation> skos:altLabel "context rot"@en .

<https://mlsysbook.ai/taxonomy/mlsys.agent-memory> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Long-term agent memory"@en ;
  skos:definition "A persistent store an agent writes to and retrieves from across calls and sessions, with policies for consolidation, expiry, and invalidation."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.function-calling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Function calling"@en ;
  skos:definition "A model emitting a structured invocation of a declared tool, which the harness validates, executes, and returns as an observation."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.function-calling> skos:altLabel "tool calling"@en .
<https://mlsysbook.ai/taxonomy/mlsys.function-calling> skos:altLabel "tool use"@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-context-protocol> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Tool discovery protocol"@en ;
  skos:definition "A shared client-server interface through which agent hosts discover the tools, resources, and prompts external services expose, with their schemas, reducing custom integration."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-context-protocol> skos:altLabel "Model Context Protocol"@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-context-protocol> skos:altLabel "MCP"@en .

<https://mlsysbook.ai/taxonomy/mlsys.computer-use> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Computer use"@en ;
  skos:definition "An agent operating graphical software through screenshots or accessibility trees and synthesized keyboard and pointer input."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.computer-use> skos:altLabel "GUI agent"@en .
<https://mlsysbook.ai/taxonomy/mlsys.computer-use> skos:altLabel "browser agent"@en .

<https://mlsysbook.ai/taxonomy/mlsys.agent-harness> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Agent harness"@en ;
  skos:definition "The runtime that repeatedly calls a model, dispatches its tool actions, appends observations, and decides whether the trajectory continues, pauses, or ends."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.agent-harness> skos:altLabel "agent loop"@en .
<https://mlsysbook.ai/taxonomy/mlsys.agent-harness> skos:altLabel "agent runtime"@en .

<https://mlsysbook.ai/taxonomy/mlsys.agent-budget> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Agent execution budget"@en ;
  skos:definition "Limits on turns, tokens, wall-clock time, or spend for a trajectory, with stopping rules applied when a limit or completion criterion is reached."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.approval-gate> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Action approval gate"@en ;
  skos:definition "A harness checkpoint that holds a specific proposed action until an authorized human or policy approves it, binding the approval to that exact action."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.approval-gate> skos:altLabel "human-in-the-loop approval"@en .

<https://mlsysbook.ai/taxonomy/mlsys.durable-execution> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Durable execution"@en ;
  skos:definition "Execution that persists workflow progress and reuses recorded results on recovery, with external-effect guarantees determined by endpoint idempotency, transactional boundaries, and reconciliation."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.deterministic-replay> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Record and replay"@en ;
  skos:definition "Re-executing a trajectory from its log by substituting recorded model outputs and tool results, to reproduce, debug, or test a divergence."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.deterministic-replay> skos:altLabel "deterministic replay"@en .

<https://mlsysbook.ai/taxonomy/mlsys.suspend-resume> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Suspend and resume"@en ;
  skos:definition "Persisting a trajectory while it waits on a human, timer, or external event, then resuming with a validated state and authority."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.multi-agent-orchestration> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Multi-agent orchestration"@en ;
  skos:definition "Structuring a task as delegated subtasks among agents under a topology, such as orchestrator-worker or peer, with typed handoffs and result merging."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.multi-agent-orchestration> skos:altLabel "orchestrator-worker"@en .
<https://mlsysbook.ai/taxonomy/mlsys.multi-agent-orchestration> skos:altLabel "delegation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.shared-agent-state> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Shared agent state"@en ;
  skos:definition "Task state read and written by several agents, requiring concurrency control such as leases or optimistic versioning to avoid lost or conflicting updates."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.coordination-failure> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Multi-agent coordination failure"@en ;
  skos:definition "Task failure arising from interaction among agents, such as mis-specified delegation, lost context at handoff, conflicting actions, or premature termination."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.correlated-agent-errors> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Correlated agent errors"@en ;
  skos:definition "Errors shared across agents built on the same model or prompts, which make voting, debate, or cross-checking less independent than assumed."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.robot-perception> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Robot perception"@en ;
  skos:definition "Models that convert raw sensor streams into task-relevant scene estimates, such as detections, segmentation, depth, and pose, under latency limits."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.sensor-fusion> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Sensor fusion"@en ;
  skos:definition "Combining measurements from multiple sensors or modalities, at raw, feature, or decision level, into one estimate more accurate or robust than any single source."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.time-synchronization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Sensor time synchronization"@en ;
  skos:definition "Aligning clocks and timestamps across sensors, compute, and actuators so measurements can be associated with the physical instant they describe."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.recursive-filtering> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Recursive state filtering"@en ;
  skos:definition "Updating a state estimate and its uncertainty by alternating model-based prediction with measurement correction at each step."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.recursive-filtering> skos:altLabel "Kalman filter"@en .
<https://mlsysbook.ai/taxonomy/mlsys.recursive-filtering> skos:altLabel "EKF"@en .
<https://mlsysbook.ai/taxonomy/mlsys.recursive-filtering> skos:altLabel "particle filter"@en .

<https://mlsysbook.ai/taxonomy/mlsys.slam> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Simultaneous localization and mapping"@en ;
  skos:definition "Jointly estimating a platform's pose and a map of an unknown environment from its own sensor observations."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.slam> skos:altLabel "SLAM"@en .

<https://mlsysbook.ai/taxonomy/mlsys.world-model> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Learned world model"@en ;
  skos:definition "A learned model that predicts future observations or latent states conditioned on actions, used for planning, policy training, or simulation."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.motion-planning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Motion planning"@en ;
  skos:definition "Computing a collision-free path or trajectory from a start to a goal configuration using search, sampling, or trajectory optimization."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-predictive-control> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model predictive control"@en ;
  skos:definition "Repeatedly solving a finite-horizon constrained optimal control problem from the current state and applying only the first input."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-predictive-control> skos:altLabel "MPC (control)"@en .

<https://mlsysbook.ai/taxonomy/mlsys.real-time-scheduling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Real-time scheduling"@en ;
  skos:definition "Assigning processor time to periodic and sporadic tasks so that each meets its deadline, with schedulability established by analysis."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.real-time-scheduling> skos:altLabel "rate-monotonic"@en .
<https://mlsysbook.ai/taxonomy/mlsys.real-time-scheduling> skos:altLabel "EDF"@en .
<https://mlsysbook.ai/taxonomy/mlsys.real-time-scheduling> skos:altLabel "response-time analysis"@en .
<https://mlsysbook.ai/taxonomy/mlsys.real-time-scheduling> skos:altLabel "hard real-time deadline"@en .

<https://mlsysbook.ai/taxonomy/mlsys.mixed-criticality> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Mixed-criticality partitioning"@en ;
  skos:definition "Running functions of different assurance levels on shared hardware while preventing lower-criticality work from delaying or corrupting higher-criticality functions."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.vla-model> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Vision-language-action model"@en ;
  skos:definition "A policy built on a pretrained vision-language backbone that maps images and language instructions to robot actions."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.vla-model> skos:altLabel "VLA"@en .
<https://mlsysbook.ai/taxonomy/mlsys.vla-model> skos:altLabel "robot foundation model"@en .

<https://mlsysbook.ai/taxonomy/mlsys.teleoperation-data> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Teleoperation data"@en ;
  skos:definition "Robot demonstrations collected by humans driving the robot remotely, whose cost, coverage, and action-label fidelity bound imitation-learned policies."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.action-chunking> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Action chunking"@en ;
  skos:definition "Predicting a short sequence of future actions per policy inference, decoupling model invocation rate from control rate and reducing compounding error."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.domain-randomization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Domain randomization"@en ;
  skos:definition "Training in simulation over randomized visual and physical parameters so the policy treats the real world as one more variation."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.thread-hierarchy> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Thread hierarchy"@en ;
  skos:definition "The decomposition of a kernel into grids of thread blocks and warps that share on-chip memory and synchronize at defined scopes."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.thread-hierarchy> skos:altLabel "grid/block/warp"@en .

<https://mlsysbook.ai/taxonomy/mlsys.memory-coalescing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Memory coalescing and bank conflicts"@en ;
  skos:definition "Access patterns that merge a warp's loads into few memory transactions, or that serialize on shared-memory banks."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.memory-coalescing> skos:altLabel "coalesced access"@en .

<https://mlsysbook.ai/taxonomy/mlsys.occupancy> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Occupancy and latency hiding"@en ;
  skos:definition "The ratio of resident to maximum warps, and how oversubscribing threads hides memory latency at the cost of registers and shared memory per thread."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.occupancy> skos:altLabel "occupancy"@en .

<https://mlsysbook.ai/taxonomy/mlsys.async-data-movement> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Asynchronous data movement"@en ;
  skos:definition "Hardware-assisted bulk copies into on-chip memory and producer-consumer warp roles that overlap loads with matrix-engine compute."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.async-data-movement> skos:altLabel "warp specialization"@en .
<https://mlsysbook.ai/taxonomy/mlsys.async-data-movement> skos:altLabel "TMA"@en .

<https://mlsysbook.ai/taxonomy/mlsys.matrix-engine-programming> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Matrix-engine programming"@en ;
  skos:definition "Issuing tile-level matrix-multiply-accumulate instructions with the layouts, fragment shapes, and precisions a tensor-core-class unit requires."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.matrix-engine-programming> skos:altLabel "tensor core programming"@en .
<https://mlsysbook.ai/taxonomy/mlsys.matrix-engine-programming> skos:altLabel "MMA"@en .

<https://mlsysbook.ai/taxonomy/mlsys.embedding-table-sharding> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Embedding-table sharding"@en ;
  skos:definition "Partitioning very large sparse embedding tables row-, column-, or table-wise across devices, usually model-parallel beside data-parallel dense layers."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.embedding-table-sharding> skos:altLabel "DLRM sharding"@en .

<https://mlsysbook.ai/taxonomy/mlsys.embedding-cache> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Embedding cache and tiering"@en ;
  skos:definition "Keeping frequently accessed embedding rows in accelerator memory and cold rows in host memory or SSD, exploiting the skew of lookups."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.embedding-cache> skos:altLabel "embedding offload"@en .

<https://mlsysbook.ai/taxonomy/mlsys.parameter-server> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Parameter server"@en ;
  skos:definition "An architecture in which workers pull and push model parameters from sharded server processes, common for sparse recommendation models and asynchronous training."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.parameter-server> skos:altLabel "PS architecture"@en .

<https://mlsysbook.ai/taxonomy/mlsys.ranking-funnel> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Multi-stage retrieval and ranking"@en ;
  skos:definition "Candidate generation followed by progressively costlier ranking stages under one latency budget, the dominant architecture for recommendation and search."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.ranking-funnel> skos:altLabel "ranking funnel"@en .
<https://mlsysbook.ai/taxonomy/mlsys.ranking-funnel> skos:altLabel "candidate generation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.multimodal-model> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Multimodal model"@en ;
  skos:definition "A model that consumes or produces several modalities, such as text, images, audio, or video, through modality encoders feeding a shared backbone."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.multimodal-model> skos:altLabel "vision-language model"@en .
<https://mlsysbook.ai/taxonomy/mlsys.multimodal-model> skos:altLabel "VLM"@en .

<https://mlsysbook.ai/taxonomy/mlsys.modality-encoder> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Modality encoder"@en ;
  skos:definition "A network that turns images, audio, or video into token sequences for a shared backbone; visual tokens often dominate prefill cost and KV size."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.modality-encoder> skos:altLabel "visual tokens"@en .
<https://mlsysbook.ai/taxonomy/mlsys.modality-encoder> skos:altLabel "vision encoder"@en .

<https://mlsysbook.ai/taxonomy/mlsys.encoder-disaggregation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Multimodal encoder disaggregation"@en ;
  skos:definition "Scheduling modality encoders separately from prefill and decode and caching encoder outputs so image or audio inputs do not stall token generation."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.encoder-disaggregation> skos:altLabel "encode-prefill-decode disaggregation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.auto-parallelization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Automatic parallelization"@en ;
  skos:definition "Compiler-derived multi-device partitioning of a single-device program, found by propagating sharding annotations or by searching parallelism strategies under a cost model."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.auto-parallelization> skos:altLabel "auto-sharding"@en .
<https://mlsysbook.ai/taxonomy/mlsys.auto-parallelization> skos:altLabel "automatic parallelism"@en .

<https://mlsysbook.ai/taxonomy/mlsys.sharding-propagation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Sharding annotation and propagation"@en ;
  skos:definition "Annotating a few tensors with layouts over a device mesh and letting the compiler infer the remaining layouts and insert required collectives, yielding one SPMD program."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.sharding-propagation> skos:altLabel "SPMD partitioning"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sharding-propagation> skos:altLabel "GSPMD-style sharding"@en .

<https://mlsysbook.ai/taxonomy/mlsys.device-mesh> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Device mesh"@en ;
  skos:definition "A logical multidimensional arrangement of devices whose axes are assigned to parallelism dimensions, usually aligned so the busiest axis maps to the fastest interconnect."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.function-transformations> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Composable function transformations"@en ;
  skos:definition "Higher-order operations that map pure array functions to new functions, such as differentiation, vectorization, compilation, and sharding, and compose in any order."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.function-transformations> skos:altLabel "grad/vmap/jit"@en .
<https://mlsysbook.ai/taxonomy/mlsys.function-transformations> skos:altLabel "functional transformations"@en .

<https://mlsysbook.ai/taxonomy/mlsys.task-actor-runtime> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Distributed task and actor runtime"@en ;
  skos:definition "A runtime exposing stateless remote tasks and stateful actors as future-returning calls, scheduled across a cluster with a shared object store and lineage-based fault tolerance."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.task-actor-runtime> skos:altLabel "actor model runtime"@en .
<https://mlsysbook.ai/taxonomy/mlsys.task-actor-runtime> skos:altLabel "Ray-style runtime"@en .

<https://mlsysbook.ai/taxonomy/mlsys.single-vs-multi-controller> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Single- vs. multi-controller execution"@en ;
  skos:definition "Whether one coordinating process issues work to all devices or every host runs the same program independently, trading orchestration flexibility against dispatch scalability."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.analytical-performance-model> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Analytical performance model"@en ;
  skos:definition "A closed-form model composing compute, memory, communication, and queueing terms to predict a workload's time, memory, and cost on a configuration without running it."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.performance-simulation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Performance simulation"@en ;
  skos:definition "Predicting system behavior by executing a model of compute, memory, network, or scheduling events at a chosen granularity, trading simulation speed against detail."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.performance-simulation> skos:altLabel "system simulation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-fidelity> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Simulator fidelity"@en ;
  skos:definition "Agreement between a performance model's or simulator's predictions and measured behavior on reference workloads, reported as validation error over stated configurations."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-fidelity> skos:altLabel "validation error"@en .

<https://mlsysbook.ai/taxonomy/mlsys.post-training-quantization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Post-training quantization"@en ;
  skos:definition "Quantizing a trained model without retraining, choosing scales and rounding from a small calibration set of representative inputs."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.post-training-quantization> skos:altLabel "PTQ"@en .
<https://mlsysbook.ai/taxonomy/mlsys.post-training-quantization> skos:altLabel "calibration set"@en .

<https://mlsysbook.ai/taxonomy/mlsys.weight-only-quantization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Weight-only quantization"@en ;
  skos:definition "Storing weights at low bit width while computing in higher-precision activations, cutting memory traffic for bandwidth-bound decoding, with error-compensating or activation-aware rounding."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.weight-only-quantization> skos:altLabel "W4A16"@en .
<https://mlsysbook.ai/taxonomy/mlsys.weight-only-quantization> skos:altLabel "GPTQ"@en .
<https://mlsysbook.ai/taxonomy/mlsys.weight-only-quantization> skos:altLabel "AWQ"@en .

<https://mlsysbook.ai/taxonomy/mlsys.activation-outliers> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Activation outliers"@en ;
  skos:definition "Rare, large-magnitude activation channels in large transformers that inflate quantization ranges, handled by mixed-precision decomposition or by migrating scale into weights."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.activation-outliers> skos:altLabel "outlier features"@en .
<https://mlsysbook.ai/taxonomy/mlsys.activation-outliers> skos:altLabel "SmoothQuant"@en .

<https://mlsysbook.ai/taxonomy/mlsys.kv-cache-quantization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "KV-cache quantization"@en ;
  skos:definition "Storing attention keys and values at reduced precision, often with per-channel keys and per-token values, to raise batch size or context length under fixed memory."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.kv-cache-quantization> skos:altLabel "KV quantization"@en .

<https://mlsysbook.ai/taxonomy/mlsys.nm-sparsity> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "N:M structured sparsity"@en ;
  skos:definition "A fine-grained pattern keeping at most N nonzero values in every group of M, such as 2:4, that matrix engines can skip for real speedup."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.nm-sparsity> skos:altLabel "2:4 sparsity"@en .
<https://mlsysbook.ai/taxonomy/mlsys.nm-sparsity> skos:altLabel "semi-structured sparsity"@en .

<https://mlsysbook.ai/taxonomy/mlsys.kv-cache-offload> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "KV-cache offloading and tiering"@en ;
  skos:definition "Moving KV-cache blocks from accelerator memory to host memory or SSD and reloading them on reuse, extending cache capacity at transfer bandwidth and latency cost."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.kv-cache-offload> skos:altLabel "KV offload"@en .
<https://mlsysbook.ai/taxonomy/mlsys.kv-cache-offload> skos:altLabel "KV tiering"@en .

<https://mlsysbook.ai/taxonomy/mlsys.kv-cache-transfer> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "KV-cache transfer"@en ;
  skos:definition "Shipping KV state between instances or nodes, as in disaggregated prefill and decode or cross-instance prefix reuse, overlapped with compute to hide network latency."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.kv-cache-transfer> skos:altLabel "KV migration"@en .

<https://mlsysbook.ai/taxonomy/mlsys.compound-ai-system> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Compound AI system"@en ;
  skos:definition "An application composing multiple model calls, retrievers, and tools into one program whose components and control flow are tuned and served jointly for quality and cost."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.compound-ai-system> skos:altLabel "LM program"@en .
<https://mlsysbook.ai/taxonomy/mlsys.compound-ai-system> skos:altLabel "LLM pipeline"@en .

<https://mlsysbook.ai/taxonomy/mlsys.lm-program-optimization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "LM program optimization"@en ;
  skos:definition "Automatically tuning the prompts, demonstrations, or weights of each model call in a declared pipeline against an end-to-end metric rather than per call."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.lm-program-optimization> skos:altLabel "prompt optimization"@en .

<https://mlsysbook.ai/taxonomy/mlsys.multi-adapter-serving> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Multi-adapter serving"@en ;
  skos:definition "Serving many low-rank adapters over one shared base model by batching requests for different adapters with heterogeneous kernels and paging adapter weights on demand."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.multi-adapter-serving> skos:altLabel "multi-LoRA serving"@en .
<https://mlsysbook.ai/taxonomy/mlsys.multi-adapter-serving> skos:altLabel "multi-tenant LoRA"@en .

<https://mlsysbook.ai/taxonomy/mlsys.denoising-step-reduction> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Denoising-step reduction"@en ;
  skos:definition "Lowering network evaluations per diffusion sample with faster samplers, step distillation, or consistency models, trading sample quality against latency and cost."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.denoising-step-reduction> skos:altLabel "few-step sampling"@en .
<https://mlsysbook.ai/taxonomy/mlsys.denoising-step-reduction> skos:altLabel "step distillation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.diffusion-feature-caching> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Cross-step feature caching"@en ;
  skos:definition "Reusing intermediate activations that change little between adjacent denoising steps instead of recomputing them, cutting per-step cost at bounded quality loss."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.diffusion-feature-caching> skos:altLabel "diffusion caching"@en .

<https://mlsysbook.ai/taxonomy/mlsys.graph-vector-index> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Graph-based vector index"@en ;
  skos:definition "An approximate nearest-neighbor index linking vectors into a proximity graph, often hierarchical, searched by greedy traversal for high recall at high memory cost."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.graph-vector-index> skos:altLabel "HNSW"@en .
<https://mlsysbook.ai/taxonomy/mlsys.graph-vector-index> skos:altLabel "proximity-graph index"@en .

<https://mlsysbook.ai/taxonomy/mlsys.quantized-vector-index> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Partitioned and quantized vector index"@en ;
  skos:definition "An index that clusters vectors into partitions probed selectively and compresses them with product quantization, trading recall for memory footprint and scan cost."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.quantized-vector-index> skos:altLabel "IVF-PQ"@en .
<https://mlsysbook.ai/taxonomy/mlsys.quantized-vector-index> skos:altLabel "product quantization"@en .

<https://mlsysbook.ai/taxonomy/mlsys.filtered-vector-search> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Filtered vector search"@en ;
  skos:definition "Nearest-neighbor search restricted to records satisfying metadata predicates, where naive pre- or post-filtering loses recall or cost under selective filters."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.filtered-vector-search> skos:altLabel "predicate-constrained ANN"@en .

<https://mlsysbook.ai/taxonomy/mlsys.index-freshness> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Vector index freshness"@en ;
  skos:definition "The delay and recall cost of reflecting inserts, updates, and deletes in an ANN index, managed by incremental insertion, delta indexes, tombstones, and periodic rebuilds."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.index-freshness> skos:altLabel "streaming ANN updates"@en .

<https://mlsysbook.ai/taxonomy/mlsys.numerical-nondeterminism> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Numerical nondeterminism"@en ;
  skos:definition "Run-to-run variation in floating-point results because non-associative reductions change order with atomics, kernel selection, parallel layout, batch composition, or hardware."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.batch-invariance> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Batch invariance"@en ;
  skos:definition "A kernel property that each request's output is bitwise independent of batch size and co-batched requests, required for deterministic serving and matching training to inference numerics."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.batch-invariance> skos:altLabel "batch-invariant kernels"@en .

<https://mlsysbook.ai/taxonomy/mlsys.checkpoint-resharding> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Checkpoint resharding"@en ;
  skos:definition "Loading a checkpoint saved under one parallel layout or world size into another by remapping sharded tensors, needed for elastic restarts and training-to-serving handoff."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.checkpoint-resharding> skos:altLabel "universal checkpoint"@en .
<https://mlsysbook.ai/taxonomy/mlsys.checkpoint-resharding> skos:altLabel "distributed checkpoint"@en .

<https://mlsysbook.ai/taxonomy/mlsys.batch-data-processing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Distributed batch data processing"@en ;
  skos:definition "Transforming bounded datasets with dataflow engines that partition records across workers, shuffle between stages, and re-execute failed tasks, for large-scale preprocessing and feature generation."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.batch-data-processing> skos:altLabel "MapReduce"@en .
<https://mlsysbook.ai/taxonomy/mlsys.batch-data-processing> skos:altLabel "Spark-style dataflow"@en .

<https://mlsysbook.ai/taxonomy/mlsys.distributed-tracing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Distributed tracing"@en ;
  skos:definition "Recording request-scoped, causally linked spans across services so that one request's latency and failures can be attributed to the components it traversed."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.distributed-tracing> skos:altLabel "request tracing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.distributed-tracing> skos:altLabel "spans"@en .

<https://mlsysbook.ai/taxonomy/mlsys.llm-call-tracing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model and agent call tracing"@en ;
  skos:definition "Tracing model calls, retrievals, and tool invocations as spans annotated with prompts, token counts, latency, and cost, so quality and spend are attributable per step."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.llm-call-tracing> skos:altLabel "LLM observability"@en .
<https://mlsysbook.ai/taxonomy/mlsys.llm-call-tracing> skos:altLabel "GenAI tracing"@en .

<https://mlsysbook.ai/taxonomy/mlsys.evaluation-harness> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Evaluation harness"@en ;
  skos:definition "A system running versioned benchmark suites against model checkpoints with fixed prompts, decoding settings, and scorers, sharding and caching work so results stay reproducible and comparable."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.evaluation-harness> skos:altLabel "eval harness"@en .

<https://mlsysbook.ai/taxonomy/mlsys.energy-measurement> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Energy measurement methodology"@en ;
  skos:definition "The declared sensor sources, sampling rate, measurement boundary, and attribution rules by which a workload's energy is measured, from on-chip counters to facility meters."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.energy-measurement> skos:altLabel "power measurement"@en .

<https://mlsysbook.ai/taxonomy/mlsys.idle-dynamic-power> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Idle vs. dynamic power"@en ;
  skos:definition "Separating power drawn by provisioned but idle hardware from the incremental power of active work, which decides how shared energy is attributed to workloads."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.idle-dynamic-power> skos:altLabel "static vs. dynamic power"@en .

<https://mlsysbook.ai/taxonomy/mlsys.he-inference> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Homomorphic-encryption inference"@en ;
  skos:definition "Evaluating a model on encrypted inputs with homomorphic encryption so the server never sees plaintext, at large compute overhead and with polynomial approximations of nonlinearities."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.he-inference> skos:altLabel "HE inference"@en .
<https://mlsysbook.ai/taxonomy/mlsys.he-inference> skos:altLabel "encrypted inference"@en .

<https://mlsysbook.ai/taxonomy/mlsys.secure-computation-inference> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Secure multi-party computation inference"@en ;
  skos:definition "Jointly evaluating a model over secret-shared inputs or weights so no party learns another's data, with cost dominated by communication rounds for nonlinear layers."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.secure-computation-inference> skos:altLabel "secure two-party inference"@en .
<https://mlsysbook.ai/taxonomy/mlsys.secure-computation-inference> skos:altLabel "SMPC inference"@en .
<https://mlsysbook.ai/taxonomy/mlsys.secure-computation-inference> skos:altLabel "2PC inference"@en .

<https://mlsysbook.ai/taxonomy/mlsys.red-teaming> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Red teaming"@en ;
  skos:definition "Structured adversarial probing of a model or system, by people or automated attacker models, to elicit harmful, insecure, or policy-violating behavior before and after release."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.red-teaming> skos:altLabel "AI red teaming"@en .
<https://mlsysbook.ai/taxonomy/mlsys.red-teaming> skos:altLabel "automated red teaming"@en .

<https://mlsysbook.ai/taxonomy/mlsys.dangerous-capability-eval> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Dangerous-capability evaluation"@en ;
  skos:definition "Evaluating whether a model has capabilities, such as cyberoffense, biological uplift, or autonomous replication, that cross thresholds requiring added safeguards."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.dangerous-capability-eval> skos:altLabel "frontier capability evaluation"@en .
<https://mlsysbook.ai/taxonomy/mlsys.dangerous-capability-eval> skos:altLabel "extreme-risk evaluation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.compute-in-memory> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Compute-in-memory"@en ;
  skos:definition "Performing matrix-vector operations inside or beside memory arrays, often in the analog domain, so weights need not move to separate compute units."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.compute-in-memory> skos:altLabel "in-memory computing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.compute-in-memory> skos:altLabel "processing-in-memory"@en .
<https://mlsysbook.ai/taxonomy/mlsys.compute-in-memory> skos:altLabel "PIM"@en .
<https://mlsysbook.ai/taxonomy/mlsys.compute-in-memory> skos:altLabel "analog in-memory computing"@en .

<https://mlsysbook.ai/taxonomy/mlsys.emerging-nvm> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Emerging non-volatile memory"@en ;
  skos:definition "Resistive, phase-change, and magnetic memory devices that retain state without power and can store weights densely or act as analog compute elements."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.emerging-nvm> skos:altLabel "ReRAM"@en .
<https://mlsysbook.ai/taxonomy/mlsys.emerging-nvm> skos:altLabel "phase-change memory"@en .
<https://mlsysbook.ai/taxonomy/mlsys.emerging-nvm> skos:altLabel "MRAM"@en .
<https://mlsysbook.ai/taxonomy/mlsys.emerging-nvm> skos:altLabel "resistive memory"@en .

<https://mlsysbook.ai/taxonomy/mlsys.embedded-dsl> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Embedded ML DSL"@en ;
  skos:definition "A domain-specific language hosted inside a general language such as Python, whose operations build a program representation that a separate compiler or runtime executes."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.embedded-dsl> skos:altLabel "host-embedded DSL"@en .
<https://mlsysbook.ai/taxonomy/mlsys.embedded-dsl> skos:altLabel "staged array language"@en .

<https://mlsysbook.ai/taxonomy/mlsys.differentiable-programming> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Differentiable programming"@en ;
  skos:definition "Writing general programs, including control flow, recursion, and data structures, that the language or framework differentiates end to end by automatic differentiation."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.differentiable-programming> skos:altLabel "differentiable programming language"@en .

<https://mlsysbook.ai/taxonomy/mlsys.persistent-kernel> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Persistent kernel"@en ;
  skos:definition "A long-running kernel that stays resident on the device and executes many operators, or a whole forward pass, from an in-kernel work queue."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.persistent-kernel> skos:altLabel "megakernel"@en .
<https://mlsysbook.ai/taxonomy/mlsys.persistent-kernel> skos:altLabel "mega-kernel"@en .
<https://mlsysbook.ai/taxonomy/mlsys.persistent-kernel> skos:altLabel "persistent megakernel"@en .

<https://mlsysbook.ai/taxonomy/mlsys.graph-superoptimization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Tensor graph superoptimization"@en ;
  skos:definition "Automatically generating and verifying semantics-preserving rewrites of tensor computation graphs or kernels, then searching the rewritten space under a cost model."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.graph-superoptimization> skos:altLabel "graph substitution"@en .
<https://mlsysbook.ai/taxonomy/mlsys.graph-superoptimization> skos:altLabel "TASO-style superoptimization"@en .

<https://mlsysbook.ai/taxonomy/mlsys.llm-training-framework> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Large-model training framework"@en ;
  skos:definition "A library that composes data, tensor, pipeline, and sharded-state parallelism with memory optimizations behind one training configuration for models exceeding one device."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.llm-training-framework> skos:altLabel "Megatron-LM"@en .
<https://mlsysbook.ai/taxonomy/mlsys.llm-training-framework> skos:altLabel "DeepSpeed"@en .
<https://mlsysbook.ai/taxonomy/mlsys.llm-training-framework> skos:altLabel "distributed training library"@en .

<https://mlsysbook.ai/taxonomy/mlsys.cloud-service-model> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Cloud service models"@en ;
  skos:definition "Divisions of responsibility between cloud provider and customer, from rented virtual infrastructure to managed platforms to hosted model APIs."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.cloud-service-model> skos:altLabel "IaaS"@en .
<https://mlsysbook.ai/taxonomy/mlsys.cloud-service-model> skos:altLabel "PaaS"@en .
<https://mlsysbook.ai/taxonomy/mlsys.cloud-service-model> skos:altLabel "SaaS"@en .
<https://mlsysbook.ai/taxonomy/mlsys.cloud-service-model> skos:altLabel "managed ML service"@en .

<https://mlsysbook.ai/taxonomy/mlsys.lakehouse> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data warehouse and lakehouse"@en ;
  skos:definition "Analytical stores of governed tables queried with SQL; a lakehouse adds transactional table formats over open files in object storage."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.lakehouse> skos:altLabel "data warehouse"@en .
<https://mlsysbook.ai/taxonomy/mlsys.lakehouse> skos:altLabel "data lake"@en .
<https://mlsysbook.ai/taxonomy/mlsys.lakehouse> skos:altLabel "lakehouse"@en .

<https://mlsysbook.ai/taxonomy/mlsys.training-power-swings> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Synchronous training power swings"@en ;
  skos:definition "Rapid cluster-wide swings in power draw as synchronized accelerators alternate between compute and communication or stall together at checkpoints and failures."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.training-power-swings> skos:altLabel "training power fluctuations"@en .
<https://mlsysbook.ai/taxonomy/mlsys.training-power-swings> skos:altLabel "training load swings"@en .

<https://mlsysbook.ai/taxonomy/mlsys.facility-energy-storage> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "UPS and battery energy storage"@en ;
  skos:definition "Facility batteries that carry load through outages until generators start and can also buffer fast load swings or shave demand peaks."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.facility-energy-storage> skos:altLabel "UPS"@en .
<https://mlsysbook.ai/taxonomy/mlsys.facility-energy-storage> skos:altLabel "uninterruptible power supply"@en .
<https://mlsysbook.ai/taxonomy/mlsys.facility-energy-storage> skos:altLabel "BESS"@en .

<https://mlsysbook.ai/taxonomy/mlsys.grid-interconnection> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Grid interconnection"@en ;
  skos:definition "The utility connection that fixes how much power a site can draw; its capacity and multi-year lead times increasingly decide where AI datacenters are built."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.grid-interconnection> skos:altLabel "grid connection"@en .
<https://mlsysbook.ai/taxonomy/mlsys.grid-interconnection> skos:altLabel "utility interconnection"@en .

<https://mlsysbook.ai/taxonomy/mlsys.on-site-generation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "On-site power generation"@en ;
  skos:definition "Generators, turbines, fuel cells, or renewables at the datacenter that provide backup power or supply load alongside or instead of the grid."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.on-site-generation> skos:altLabel "behind-the-meter generation"@en .
<https://mlsysbook.ai/taxonomy/mlsys.on-site-generation> skos:altLabel "backup generators"@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-cleaning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data cleaning"@en ;
  skos:definition "Detecting and correcting erroneous, inconsistent, duplicated, or outlying records with rules, statistics, or learned repair models before the data is used for training."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.data-cleaning> skos:altLabel "data cleansing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.data-cleaning> skos:altLabel "data repair"@en .

<https://mlsysbook.ai/taxonomy/mlsys.class-imbalance> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Class imbalance"@en ;
  skos:definition "A skewed label distribution in which some classes are rare, so aggregate accuracy misleads and training favors the majority classes."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.class-imbalance> skos:altLabel "imbalanced data"@en .
<https://mlsysbook.ai/taxonomy/mlsys.class-imbalance> skos:altLabel "imbalanced classes"@en .

<https://mlsysbook.ai/taxonomy/mlsys.rebalancing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Class rebalancing"@en ;
  skos:definition "Changing per-class sampling rates, synthesizing minority examples, or weighting the loss so rare classes contribute adequately to training."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.rebalancing> skos:altLabel "oversampling"@en .
<https://mlsysbook.ai/taxonomy/mlsys.rebalancing> skos:altLabel "undersampling"@en .
<https://mlsysbook.ai/taxonomy/mlsys.rebalancing> skos:altLabel "class weighting"@en .
<https://mlsysbook.ai/taxonomy/mlsys.rebalancing> skos:altLabel "SMOTE"@en .

<https://mlsysbook.ai/taxonomy/mlsys.feature-hashing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Feature hashing"@en ;
  skos:definition "Mapping high-cardinality or open-vocabulary categorical values into a fixed number of buckets with a hash function, bounding table size at the cost of collisions."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.feature-hashing> skos:altLabel "hashing trick"@en .
<https://mlsysbook.ai/taxonomy/mlsys.feature-hashing> skos:altLabel "hashed features"@en .

<https://mlsysbook.ai/taxonomy/mlsys.feature-cross> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Feature cross"@en ;
  skos:definition "A synthetic feature formed from the conjunction of two or more categorical features so a model, especially a linear one, can learn their interaction."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.feature-cross> skos:altLabel "crossed features"@en .
<https://mlsysbook.ai/taxonomy/mlsys.feature-cross> skos:altLabel "feature conjunction"@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-governance> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data governance"@en ;
  skos:definition "Policies, roles, and controls that decide who may collect, access, use, and share which data, for which purposes, and under what accountability."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.data-governance> skos:altLabel "data stewardship"@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-consent> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Consent and purpose limitation"@en ;
  skos:definition "Restricting collection and use of personal data to purposes the data subject agreed to or a legal basis allows, recorded so downstream uses can be checked."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.data-consent> skos:altLabel "purpose limitation"@en .
<https://mlsysbook.ai/taxonomy/mlsys.data-consent> skos:altLabel "data-use consent"@en .

<https://mlsysbook.ai/taxonomy/mlsys.exploratory-data-analysis> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Exploratory data analysis"@en ;
  skos:definition "Summarizing and plotting distributions, correlations, and anomalies in a dataset before modeling to inform cleaning, feature design, and validation rules."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.exploratory-data-analysis> skos:altLabel "EDA"@en .
<https://mlsysbook.ai/taxonomy/mlsys.exploratory-data-analysis> skos:altLabel "data profiling"@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-visualization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model and prediction visualization"@en ;
  skos:definition "Plotting training curves, activations, embeddings, and prediction errors such as confusion matrices to inspect what a model learned and where it fails."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-visualization> skos:altLabel "training dashboards"@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-visualization> skos:altLabel "embedding projection"@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-visualization> skos:altLabel "confusion-matrix plots"@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-selection> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model selection"@en ;
  skos:definition "Choosing among candidate model families, architectures, and hyperparameters by validated performance under the system's accuracy, cost, and latency constraints."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-selection> skos:altLabel "model development"@en .

<https://mlsysbook.ai/taxonomy/mlsys.pretraining> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Pretraining"@en ;
  skos:definition "Training a model from scratch on a large, broad corpus with a self-supervised objective to produce a general base model for later adaptation."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.pretraining> skos:altLabel "base-model pretraining"@en .
<https://mlsysbook.ai/taxonomy/mlsys.pretraining> skos:altLabel "pretraining run"@en .

<https://mlsysbook.ai/taxonomy/mlsys.causal-lm> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Causal language modeling"@en ;
  skos:definition "Training a model to predict each token from the tokens before it, maximizing the likelihood of text under a left-to-right factorization."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.causal-lm> skos:altLabel "next-token prediction"@en .
<https://mlsysbook.ai/taxonomy/mlsys.causal-lm> skos:altLabel "autoregressive language modeling"@en .

<https://mlsysbook.ai/taxonomy/mlsys.gan> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Generative adversarial network"@en ;
  skos:definition "A generator and a discriminator trained against each other, so the generator learns to produce samples the discriminator cannot tell apart from data."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.gan> skos:altLabel "GAN"@en .

<https://mlsysbook.ai/taxonomy/mlsys.mode-collapse> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Mode collapse"@en ;
  skos:definition "A generative-training failure in which the model covers only a few modes of the data distribution and produces low-diversity samples."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.perplexity> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Perplexity"@en ;
  skos:definition "The exponentiated average negative log-likelihood per token of held-out text, measuring how well a language model predicts that text."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.reference-match-scoring> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Reference-match scoring"@en ;
  skos:definition "Scoring a generated output by exact or token-overlap agreement with reference answers; cheap and reproducible but blind to valid answers phrased differently."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.reference-match-scoring> skos:altLabel "exact match"@en .
<https://mlsysbook.ai/taxonomy/mlsys.reference-match-scoring> skos:altLabel "token-overlap F1"@en .
<https://mlsysbook.ai/taxonomy/mlsys.reference-match-scoring> skos:altLabel "BLEU"@en .
<https://mlsysbook.ai/taxonomy/mlsys.reference-match-scoring> skos:altLabel "ROUGE"@en .

<https://mlsysbook.ai/taxonomy/mlsys.error-analysis> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Error analysis"@en ;
  skos:definition "Inspecting a model's mistakes, grouping them into categories, and ranking categories by frequency and fixability to decide the next data or model change."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.training-diagnostics> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Training diagnostics"@en ;
  skos:definition "Checks such as overfitting a tiny batch, reading learning curves, and tracking gradient and activation statistics that localize bugs in training code, data, and configuration."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.training-diagnostics> skos:altLabel "overfit-one-batch test"@en .
<https://mlsysbook.ai/taxonomy/mlsys.training-diagnostics> skos:altLabel "learning-curve diagnosis"@en .

<https://mlsysbook.ai/taxonomy/mlsys.keyed-predictions> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Request correlation keys"@en ;
  skos:definition "Passing a client-supplied key through inference unchanged so outputs of batch or asynchronous requests can be matched to their inputs regardless of order."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.keyed-predictions> skos:altLabel "keyed predictions"@en .
<https://mlsysbook.ai/taxonomy/mlsys.keyed-predictions> skos:altLabel "pass-through keys"@en .

<https://mlsysbook.ai/taxonomy/mlsys.stateless-serving-function> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Stateless model serving"@en ;
  skos:definition "Exporting a model as a stateless function from request inputs to prediction, so any replica can serve any request and replicas scale horizontally."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.stateless-serving-function> skos:altLabel "stateless serving function"@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-gateway> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model gateway"@en ;
  skos:definition "A proxy in front of one or more model providers that centralizes authentication, routing, rate limits, fallbacks, and usage logging for model calls."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-gateway> skos:altLabel "LLM gateway"@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-gateway> skos:altLabel "AI gateway"@en .

<https://mlsysbook.ai/taxonomy/mlsys.semantic-cache> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Semantic cache"@en ;
  skos:definition "Returning a stored model response when a new request is close in embedding space to an earlier one, trading answer fidelity for latency and cost."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.semantic-cache> skos:altLabel "semantic caching"@en .

<https://mlsysbook.ai/taxonomy/mlsys.glue-code> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Glue code"@en ;
  skos:definition "Supporting code written to move data into and out of general-purpose ML packages, often far larger than the model code and binding the system to package specifics."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.pipeline-jungle> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Pipeline jungle"@en ;
  skos:definition "Data preparation grown incrementally into a tangle of scrapes, joins, and intermediate outputs that is hard to test, trace, and change."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.build-vs-buy> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Build-versus-buy decision"@en ;
  skos:definition "Choosing whether to build an ML platform component in house, adopt open source, or buy a managed service, weighing fit, cost, lock-in, and team capacity."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.build-vs-buy> skos:altLabel "build vs. buy"@en .
<https://mlsysbook.ai/taxonomy/mlsys.build-vs-buy> skos:altLabel "MLOps tool selection"@en .

<https://mlsysbook.ai/taxonomy/mlsys.user-feedback> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "User feedback collection"@en ;
  skos:definition "Capturing explicit signals such as ratings and corrections and implicit signals such as clicks, edits, and abandonment, for use as labels or quality signals."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.user-feedback> skos:altLabel "explicit feedback"@en .
<https://mlsysbook.ai/taxonomy/mlsys.user-feedback> skos:altLabel "implicit feedback"@en .

<https://mlsysbook.ai/taxonomy/mlsys.human-ai-interaction> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Human-AI interaction design"@en ;
  skos:definition "Designing how a system conveys its capabilities, uncertainty, and errors to users and lets them correct, override, or dismiss its outputs."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.human-ai-interaction> skos:altLabel "human-centered AI"@en .
<https://mlsysbook.ai/taxonomy/mlsys.human-ai-interaction> skos:altLabel "human-AI guidelines"@en .

<https://mlsysbook.ai/taxonomy/mlsys.demand-response> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Datacenter demand response"@en ;
  skos:definition "Shifting, shedding, or capping datacenter power in response to grid signals, made practical by deferrable training and batch work."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.demand-response> skos:altLabel "flexible datacenter load"@en .
<https://mlsysbook.ai/taxonomy/mlsys.demand-response> skos:altLabel "grid-interactive datacenter"@en .

<https://mlsysbook.ai/taxonomy/mlsys.prompt-engineering> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Prompt engineering"@en ;
  skos:definition "Designing instructions, examples, and input layout for a model call to elicit desired behavior without changing the model's weights."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.prompt-engineering> skos:altLabel "prompt design"@en .

<https://mlsysbook.ai/taxonomy/mlsys.in-context-learning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "In-context learning"@en ;
  skos:definition "A pretrained model performing a task from instructions or examples supplied in its input at inference time, with no weight updates."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.in-context-learning> skos:altLabel "few-shot prompting"@en .
<https://mlsysbook.ai/taxonomy/mlsys.in-context-learning> skos:altLabel "zero-shot prompting"@en .

<https://mlsysbook.ai/taxonomy/mlsys.streaming-asr> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Streaming speech recognition"@en ;
  skos:definition "Serving speech recognition incrementally: consuming audio in chunks and emitting partial transcripts within a fixed lag, with encoder state carried between chunks."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.streaming-asr> skos:altLabel "streaming ASR"@en .
<https://mlsysbook.ai/taxonomy/mlsys.streaming-asr> skos:altLabel "on-device speech recognition"@en .

<https://mlsysbook.ai/taxonomy/mlsys.voice-pipeline> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Voice interaction pipeline"@en ;
  skos:definition "Serving a spoken interaction as one latency-budgeted pipeline of streaming speech recognition, a language model, and speech synthesis, with turn detection and interruption handling between stages."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.voice-pipeline> skos:altLabel "voice agent"@en .
<https://mlsysbook.ai/taxonomy/mlsys.voice-pipeline> skos:altLabel "ASR-LLM-TTS cascade"@en .
<https://mlsysbook.ai/taxonomy/mlsys.voice-pipeline> skos:altLabel "speech-to-speech model"@en .

<https://mlsysbook.ai/taxonomy/mlsys.kv-cache-eviction> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "KV-cache eviction"@en ;
  skos:definition "Retaining only a selected subset of cached key-value entries, chosen by attention scores, recency, or learned importance, to bound KV memory during long generation."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.kv-cache-eviction> skos:altLabel "KV token eviction"@en .
<https://mlsysbook.ai/taxonomy/mlsys.kv-cache-eviction> skos:altLabel "KV-cache sparsification"@en .
<https://mlsysbook.ai/taxonomy/mlsys.kv-cache-eviction> skos:altLabel "heavy-hitter retention"@en .
<https://mlsysbook.ai/taxonomy/mlsys.kv-cache-eviction> skos:altLabel "attention sink retention"@en .
<https://mlsysbook.ai/taxonomy/mlsys.kv-cache-eviction> skos:altLabel "sink-aware KV eviction"@en .

<https://mlsysbook.ai/taxonomy/mlsys.dynamic-sparse-attention> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Dynamic sparse attention"@en ;
  skos:definition "Attention that computes only the query-key blocks predicted important for each input at runtime, rather than a fixed pattern, to cut long-context cost."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.dynamic-sparse-attention> skos:altLabel "content-adaptive sparse attention"@en .
<https://mlsysbook.ai/taxonomy/mlsys.dynamic-sparse-attention> skos:altLabel "input-dependent sparse attention"@en .

<https://mlsysbook.ai/taxonomy/mlsys.cpu-gpu-hybrid-inference> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "CPU-GPU hybrid inference"@en ;
  skos:definition "Splitting inference so the host CPU computes some operations, such as attention or rarely active neurons, from host memory when model or KV state exceeds accelerator memory."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.cpu-gpu-hybrid-inference> skos:altLabel "host-assisted inference"@en .
<https://mlsysbook.ai/taxonomy/mlsys.cpu-gpu-hybrid-inference> skos:altLabel "CPU offloaded attention"@en .

<https://mlsysbook.ai/taxonomy/mlsys.heterogeneous-accelerator-execution> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Heterogeneous-accelerator training and serving"@en ;
  skos:definition "Partitioning one training or serving job across accelerators of different types or generations, sizing stages and batch shares to each device's compute, memory, and links."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.heterogeneous-accelerator-execution> skos:altLabel "heterogeneous GPU clusters"@en .
<https://mlsysbook.ai/taxonomy/mlsys.heterogeneous-accelerator-execution> skos:altLabel "mixed-generation GPU training"@en .

<https://mlsysbook.ai/taxonomy/mlsys.graph-neural-network> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Graph neural network"@en ;
  skos:definition "Neural network that computes node, edge, or graph representations by repeatedly aggregating features from each node's neighbors along graph edges."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.graph-neural-network> skos:altLabel "GNN"@en .
<https://mlsysbook.ai/taxonomy/mlsys.graph-neural-network> skos:altLabel "message-passing neural network"@en .

<https://mlsysbook.ai/taxonomy/mlsys.neighbor-sampling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Neighbor sampling"@en ;
  skos:definition "Building GNN mini-batches from sampled subsets of each node's multi-hop neighborhood, bounding the exponential neighbor growth that makes full-neighborhood computation exceed memory."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.neighbor-sampling> skos:altLabel "graph sampling"@en .
<https://mlsysbook.ai/taxonomy/mlsys.neighbor-sampling> skos:altLabel "mini-batch graph sampling"@en .

<https://mlsysbook.ai/taxonomy/mlsys.dynamic-resharding> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Dynamic re-parallelization"@en ;
  skos:definition "Redistributing model weights among devices at runtime so successive phases, such as generation and training or prefill and decode, each run under a better parallel layout."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.dynamic-resharding> skos:altLabel "parameter reallocation"@en .
<https://mlsysbook.ai/taxonomy/mlsys.dynamic-resharding> skos:altLabel "runtime resharding"@en .

<https://mlsysbook.ai/taxonomy/mlsys.activation-sparsity> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Contextual activation sparsity"@en ;
  skos:definition "Skipping neurons, heads, or channels whose activations are predicted negligible for the current input, reducing per-token compute and weight reads at inference."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.activation-sparsity> skos:altLabel "dynamic activation sparsity"@en .
<https://mlsysbook.ai/taxonomy/mlsys.activation-sparsity> skos:altLabel "contextual sparsity"@en .

<https://mlsysbook.ai/taxonomy/mlsys.non-prefix-kv-reuse> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Non-prefix KV reuse"@en ;
  skos:definition "Reusing precomputed KV entries for text chunks appearing at arbitrary positions across requests, selectively recomputing cross-chunk attention instead of the full prefill."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.non-prefix-kv-reuse> skos:altLabel "position-independent KV caching"@en .
<https://mlsysbook.ai/taxonomy/mlsys.non-prefix-kv-reuse> skos:altLabel "KV cache blending"@en .

<https://mlsysbook.ai/taxonomy/mlsys.ml-aware-scheduling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "ML-aware cluster scheduling"@en ;
  skos:definition "Allocating cluster accelerators using ML job properties, such as scaling curves, iteration time, and parallelism choice, to optimize objectives like job completion time or goodput."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.ml-aware-scheduling> skos:altLabel "deep-learning cluster scheduling"@en .
<https://mlsysbook.ai/taxonomy/mlsys.ml-aware-scheduling> skos:altLabel "goodput-aware scheduling"@en .

<https://mlsysbook.ai/taxonomy/mlsys.adaptive-routing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Adaptive routing"@en ;
  skos:definition "Choosing network paths per packet or flowlet from current congestion, avoiding the hash collisions static ECMP suffers with few large, synchronized training flows."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.adaptive-routing> skos:altLabel "flowlet switching"@en .
<https://mlsysbook.ai/taxonomy/mlsys.adaptive-routing> skos:altLabel "packet spraying"@en .
<https://mlsysbook.ai/taxonomy/mlsys.adaptive-routing> skos:altLabel "ECMP collision avoidance"@en .

<https://mlsysbook.ai/taxonomy/mlsys.incast> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Incast congestion"@en ;
  skos:definition "Congestion that occurs when many senders transmit to one receiver at once, overflowing its switch port buffer and causing queueing, drops, or pause propagation."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.incast> skos:altLabel "incast"@en .
<https://mlsysbook.ai/taxonomy/mlsys.incast> skos:altLabel "many-to-one congestion"@en .

<https://mlsysbook.ai/taxonomy/mlsys.context-selection> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Context selection"@en ;
  skos:definition "Choosing which instructions, tool descriptions, retrieved items, state, and observations enter a model's limited context at each step, within a token budget."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.context-selection> skos:altLabel "context budget allocation"@en .
<https://mlsysbook.ai/taxonomy/mlsys.context-selection> skos:altLabel "tool selection"@en .
<https://mlsysbook.ai/taxonomy/mlsys.context-selection> skos:altLabel "working-set selection"@en .

<https://mlsysbook.ai/taxonomy/mlsys.context-staleness> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Context staleness"@en ;
  skos:definition "Observations held in an agent's context or memory that no longer reflect the environment after later actions or external changes, yet still steer decisions unless invalidated."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.context-staleness> skos:altLabel "stale observations"@en .
<https://mlsysbook.ai/taxonomy/mlsys.context-staleness> skos:altLabel "context invalidation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.multi-hop-retrieval> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Iterative multi-hop retrieval"@en ;
  skos:definition "Retrieval that issues successive queries, each formulated from previously retrieved evidence or reasoning steps, to answer questions no single lookup resolves."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.multi-hop-retrieval> skos:altLabel "agentic retrieval"@en .
<https://mlsysbook.ai/taxonomy/mlsys.multi-hop-retrieval> skos:altLabel "multi-hop RAG"@en .

<https://mlsysbook.ai/taxonomy/mlsys.capability-based-security> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Capability-based authorization"@en ;
  skos:definition "Authorization in which holding an unforgeable, scoped reference grants a specific right that can be delegated with attenuated scope and later revoked."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.capability-based-security> skos:altLabel "capability tokens"@en .
<https://mlsysbook.ai/taxonomy/mlsys.capability-based-security> skos:altLabel "object capabilities"@en .
<https://mlsysbook.ai/taxonomy/mlsys.capability-based-security> skos:altLabel "attenuated credentials"@en .

<https://mlsysbook.ai/taxonomy/mlsys.ephemeral-sandbox> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Ephemeral sandbox"@en ;
  skos:definition "An isolated execution environment created per task from a snapshot, often copy-on-write, and destroyed or reset afterward so no state carries across tasks or tenants."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.ephemeral-sandbox> skos:altLabel "copy-on-write workspace"@en .
<https://mlsysbook.ai/taxonomy/mlsys.ephemeral-sandbox> skos:altLabel "disposable execution environment"@en .
<https://mlsysbook.ai/taxonomy/mlsys.ephemeral-sandbox> skos:altLabel "microVM sandbox"@en .

<https://mlsysbook.ai/taxonomy/mlsys.egress-control> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Network egress control"@en ;
  skos:definition "Restricting which external network destinations a workload or sandbox may contact, typically through default-deny allowlists, to block exfiltration and unintended remote actions."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.egress-control> skos:altLabel "egress filtering"@en .
<https://mlsysbook.ai/taxonomy/mlsys.egress-control> skos:altLabel "outbound allowlist"@en .

<https://mlsysbook.ai/taxonomy/mlsys.information-flow-control> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Information-flow control"@en ;
  skos:definition "Labeling data with confidentiality and integrity tags and propagating them through computation so policy can block untrusted inputs from steering privileged actions or secrets from leaking."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.information-flow-control> skos:altLabel "taint tracking"@en .
<https://mlsysbook.ai/taxonomy/mlsys.information-flow-control> skos:altLabel "data-flow labels"@en .

<https://mlsysbook.ai/taxonomy/mlsys.compounding-error> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Compounding error in sequential decisions"@en ;
  skos:definition "Per-step errors of a learned sequential policy or generator push later inputs away from the training distribution, so failure probability grows with horizon length."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.compounding-error> skos:altLabel "covariate shift in imitation"@en .
<https://mlsysbook.ai/taxonomy/mlsys.compounding-error> skos:altLabel "exposure bias"@en .
<https://mlsysbook.ai/taxonomy/mlsys.compounding-error> skos:altLabel "horizon error compounding"@en .

<https://mlsysbook.ai/taxonomy/mlsys.interactive-imitation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Interactive imitation learning"@en ;
  skos:definition "Imitation learning that queries an expert for corrective labels on states the learner's own policy visits and aggregates them into training data over rounds."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.interactive-imitation> skos:altLabel "DAgger"@en .
<https://mlsysbook.ai/taxonomy/mlsys.interactive-imitation> skos:altLabel "dataset aggregation"@en .
<https://mlsysbook.ai/taxonomy/mlsys.interactive-imitation> skos:altLabel "recovery demonstrations"@en .

<https://mlsysbook.ai/taxonomy/mlsys.loss-masking> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Loss masking and token normalization"@en ;
  skos:definition "Excluding prompt, tool-output, and other non-target tokens from the training loss, and choosing how remaining token losses are averaged across turns and sequences."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.loss-masking> skos:altLabel "prompt masking"@en .
<https://mlsysbook.ai/taxonomy/mlsys.loss-masking> skos:altLabel "assistant-only loss"@en .

<https://mlsysbook.ai/taxonomy/mlsys.credit-assignment> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Credit assignment"@en ;
  skos:definition "Attributing a delayed or episode-level reward to the individual actions, turns, or tokens that produced it, so updates reinforce the responsible decisions."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.credit-assignment> skos:altLabel "temporal credit assignment"@en .
<https://mlsysbook.ai/taxonomy/mlsys.credit-assignment> skos:altLabel "multi-turn credit assignment"@en .

<https://mlsysbook.ai/taxonomy/mlsys.actuator-limits> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Actuator limits"@en ;
  skos:definition "Bounds on the force, torque, speed, and sustained duty an actuator can deliver, set by drive current limits, gearing, and motor heating."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.actuator-limits> skos:altLabel "torque saturation"@en .
<https://mlsysbook.ai/taxonomy/mlsys.actuator-limits> skos:altLabel "thermal duty limits"@en .

<https://mlsysbook.ai/taxonomy/mlsys.watchdog-timer> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Watchdog timer"@en ;
  skos:definition "A timer that a monitored component must refresh within a deadline or window; expiry triggers a defined safe response such as reset or revoking control authority."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.watchdog-timer> skos:altLabel "heartbeat timeout"@en .
<https://mlsysbook.ai/taxonomy/mlsys.watchdog-timer> skos:altLabel "windowed watchdog"@en .
<https://mlsysbook.ai/taxonomy/mlsys.watchdog-timer> skos:altLabel "authority-expiry timer"@en .

<https://mlsysbook.ai/taxonomy/mlsys.closed-loop-evaluation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Closed-loop policy evaluation"@en ;
  skos:definition "Evaluating a policy by letting its own actions determine subsequent observations, in simulation or deployment, rather than scoring its predictions against logged data."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.closed-loop-evaluation> skos:altLabel "closed-loop testing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.closed-loop-evaluation> skos:altLabel "interactive policy evaluation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.event-data-recorder> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Event data recorder"@en ;
  skos:definition "Tamper-evident onboard logging of inputs, decisions, control authority, and safety interventions around events, retained for incident reconstruction and assurance evidence."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.event-data-recorder> skos:altLabel "black-box recorder"@en .
<https://mlsysbook.ai/taxonomy/mlsys.event-data-recorder> skos:altLabel "safety event log"@en .
<https://mlsysbook.ai/taxonomy/mlsys.event-data-recorder> skos:altLabel "authority record"@en .

<https://mlsysbook.ai/taxonomy/mlsys.decision-accountability> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Decision accountability record"@en ;
  skos:definition "A record of who authorized each consequential decision, policy, or automated action and on what evidence, so responsibility can be assigned and reviewed later."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.decision-accountability> skos:altLabel "decision ownership"@en .
<https://mlsysbook.ai/taxonomy/mlsys.decision-accountability> skos:altLabel "accountability assignment"@en .
<https://mlsysbook.ai/taxonomy/mlsys.decision-accountability> skos:altLabel "approval record"@en .

<https://mlsysbook.ai/taxonomy/mlsys.agent-interruption> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Agent interruption and cancellation"@en ;
  skos:definition "Operator controls that pause, redirect, cancel, or terminate a running agent at defined boundaries while settling in-flight tool calls into a known state."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.agent-interruption> skos:altLabel "pause and cancel"@en .
<https://mlsysbook.ai/taxonomy/mlsys.agent-interruption> skos:altLabel "operator interrupt"@en .
<https://mlsysbook.ai/taxonomy/mlsys.agent-interruption> skos:altLabel "agent kill switch"@en .

<https://mlsysbook.ai/taxonomy/mlsys.agent-loop-detection> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Agent loop detection"@en ;
  skos:definition "Monitoring an agent trajectory for repeated actions, cycling states, or absent progress, and halting or escalating when the agent appears stuck."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.agent-loop-detection> skos:altLabel "semantic watchdog"@en .
<https://mlsysbook.ai/taxonomy/mlsys.agent-loop-detection> skos:altLabel "livelock detection"@en .
<https://mlsysbook.ai/taxonomy/mlsys.agent-loop-detection> skos:altLabel "repetition detection"@en .

<https://mlsysbook.ai/taxonomy/mlsys.task-and-motion-planning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Task and motion planning"@en ;
  skos:definition "Planning that jointly searches discrete symbolic action sequences and continuous motions, accepting a task plan only when each step admits a feasible motion."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.task-and-motion-planning> skos:altLabel "TAMP"@en .

<https://mlsysbook.ai/taxonomy/mlsys.multi-object-tracking> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Multi-object tracking"@en ;
  skos:definition "Maintaining identities and states of multiple moving objects over time by associating new detections with existing tracks and starting or ending tracks."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.multi-object-tracking> skos:altLabel "MOT"@en .
<https://mlsysbook.ai/taxonomy/mlsys.multi-object-tracking> skos:altLabel "data association"@en .
<https://mlsysbook.ai/taxonomy/mlsys.multi-object-tracking> skos:altLabel "track management"@en .

<https://mlsysbook.ai/taxonomy/mlsys.change-impact-analysis> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Safety change-impact analysis"@en ;
  skos:definition "Determining which hazards, safety-case claims, and evidence a change to a model, software, data, or operating domain invalidates, and what must be re-verified."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.change-impact-analysis> skos:altLabel "impact analysis"@en .
<https://mlsysbook.ai/taxonomy/mlsys.change-impact-analysis> skos:altLabel "safety-case maintenance"@en .

<https://mlsysbook.ai/taxonomy/mlsys.sparse-tensor-kernels> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Sparse tensor kernels"@en ;
  skos:definition "Kernels such as sparse-dense matrix multiply, sampled dense-dense multiply, and sparse convolution that compute over compressed nonzero structure, trading irregular access for skipped work."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.sparse-tensor-kernels> skos:altLabel "SpMM"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sparse-tensor-kernels> skos:altLabel "SDDMM"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sparse-tensor-kernels> skos:altLabel "sparse convolution"@en .

<https://mlsysbook.ai/taxonomy/mlsys.local-sgd> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Local SGD"@en ;
  skos:definition "Data-parallel training in which workers take several local optimizer steps between parameter synchronizations, cutting communication frequency for low-bandwidth or geo-distributed settings."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.local-sgd> skos:altLabel "periodic model averaging"@en .
<https://mlsysbook.ai/taxonomy/mlsys.local-sgd> skos:altLabel "DiLoCo-style training"@en .
<https://mlsysbook.ai/taxonomy/mlsys.local-sgd> skos:altLabel "low-communication training"@en .

<https://mlsysbook.ai/taxonomy/mlsys.expert-placement> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Expert replication and placement"@en ;
  skos:definition "Assigning mixture-of-experts experts to devices, and replicating frequently routed ones, to balance per-device token load under skewed routing."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.expert-placement> skos:altLabel "expert load balancing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.expert-placement> skos:altLabel "redundant experts"@en .

<https://mlsysbook.ai/taxonomy/mlsys.memory-efficient-optimizer> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Memory-efficient optimizer"@en ;
  skos:definition "Optimizers that shrink per-parameter state through factorization, low-rank projection, or low-precision storage, cutting the memory adaptive methods such as Adam otherwise require."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.memory-efficient-optimizer> skos:altLabel "low-rank optimizer state"@en .
<https://mlsysbook.ai/taxonomy/mlsys.memory-efficient-optimizer> skos:altLabel "8-bit optimizer"@en .

<https://mlsysbook.ai/taxonomy/mlsys.execution-trace> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Operator execution trace"@en ;
  skos:definition "A recorded graph of a training or inference step's compute and communication operators with their dependencies and timings, replayable for simulation and benchmarking."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.execution-trace> skos:altLabel "execution graph trace"@en .
<https://mlsysbook.ai/taxonomy/mlsys.execution-trace> skos:altLabel "Chakra trace"@en .

<https://mlsysbook.ai/taxonomy/mlsys.offline-rl> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Offline reinforcement learning"@en ;
  skos:definition "Learning a policy from a fixed dataset of previously logged interactions without further environment access, limited by how well the data covers states the policy would visit."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.offline-rl> skos:altLabel "batch reinforcement learning"@en .
<https://mlsysbook.ai/taxonomy/mlsys.offline-rl> skos:altLabel "offline RL"@en .

<https://mlsysbook.ai/taxonomy/mlsys.byzantine-robust-aggregation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Byzantine-robust aggregation"@en ;
  skos:definition "Combining worker or client updates with robust statistics, such as medians, trimmed means, or Krum, so a bounded fraction of arbitrary malicious updates cannot steer training."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.byzantine-robust-aggregation> skos:altLabel "robust gradient aggregation"@en .
<https://mlsysbook.ai/taxonomy/mlsys.byzantine-robust-aggregation> skos:altLabel "Krum"@en .

<https://mlsysbook.ai/taxonomy/mlsys.cluster-manager> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Cluster manager"@en ;
  skos:definition "The control plane that admits jobs, places their tasks on machines, enforces quotas and priorities, and reconciles running state toward declared intent across a cluster."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.cluster-manager> skos:altLabel "cluster orchestrator"@en .
<https://mlsysbook.ai/taxonomy/mlsys.cluster-manager> skos:altLabel "cluster control plane"@en .
<https://mlsysbook.ai/taxonomy/mlsys.cluster-manager> skos:altLabel "Kubernetes"@en .

<https://mlsysbook.ai/taxonomy/mlsys.rebound-effect> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Rebound effect"@en ;
  skos:definition "Efficiency gains lower the cost of a service enough that total demand, and with it total energy or resource use, grows, partly or fully offsetting the savings."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.rebound-effect> skos:altLabel "Jevons paradox"@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-cascade> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data cascade"@en ;
  skos:definition "Compounding downstream harm from upstream data problems, such as poor collection or labeling, that surface late, often after deployment, and are costly to trace."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.data-cascade> skos:altLabel "compounding data defects"@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-valuation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data valuation"@en ;
  skos:definition "Estimating each training example's or data source's contribution to model quality, for example through influence or Shapley-style attribution, to guide selection, pricing, or removal."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.data-valuation> skos:altLabel "Data Shapley"@en .
<https://mlsysbook.ai/taxonomy/mlsys.data-valuation> skos:altLabel "data attribution"@en .

<https://mlsysbook.ai/taxonomy/mlsys.diffusion-policy> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Diffusion or flow-matching policy"@en ;
  skos:definition "Robot policies that generate continuous actions through iterative denoising or learned-flow integration, representing multiple action modes while spending an inference-iteration budget."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.diffusion-policy> skos:altLabel "flow-matching policy"@en .
<https://mlsysbook.ai/taxonomy/mlsys.diffusion-policy> skos:altLabel "diffusion policy"@en .

<https://mlsysbook.ai/taxonomy/mlsys.sensor-spoofing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Sensor spoofing"@en ;
  skos:definition "Attacks that inject false signals into a sensor's physical channel, such as fabricated LiDAR returns or GPS and acoustic spoofing, so perception receives counterfeit measurements."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.sensor-spoofing> skos:altLabel "transduction attack"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sensor-spoofing> skos:altLabel "physical sensor attack"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sensor-spoofing> skos:altLabel "LiDAR spoofing"@en .

<https://mlsysbook.ai/taxonomy/mlsys.paired-comparison> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Paired comparison and noninferiority testing"@en ;
  skos:definition "Comparing two systems on the same items or units and testing per-item differences, including whether a candidate is no worse than a baseline by a preset margin."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.paired-comparison> skos:altLabel "paired difference test"@en .
<https://mlsysbook.ai/taxonomy/mlsys.paired-comparison> skos:altLabel "noninferiority test"@en .

<https://mlsysbook.ai/taxonomy/mlsys.cpu-execution-architecture> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "CPU execution architecture"@en ;
  skos:definition "Organization of general-purpose processor cores, SIMD vector units, and multilevel caches that runs host code, preprocessing, classical models, and CPU inference."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.cpu-execution-architecture> skos:altLabel "general-purpose CPU"@en .
<https://mlsysbook.ai/taxonomy/mlsys.cpu-execution-architecture> skos:altLabel "host CPU"@en .
<https://mlsysbook.ai/taxonomy/mlsys.cpu-execution-architecture> skos:altLabel "CPU vector units"@en .

<https://mlsysbook.ai/taxonomy/mlsys.cpu-threading-numa> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "CPU threading and NUMA placement"@en ;
  skos:definition "Configuring thread pools, core affinity, and memory placement across NUMA domains so CPU operators parallelize without oversubscription or remote-memory penalties."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.cpu-threading-numa> skos:altLabel "thread affinity"@en .
<https://mlsysbook.ai/taxonomy/mlsys.cpu-threading-numa> skos:altLabel "intra-op and inter-op threads"@en .
<https://mlsysbook.ai/taxonomy/mlsys.cpu-threading-numa> skos:altLabel "NUMA-aware execution"@en .

<https://mlsysbook.ai/taxonomy/mlsys.dynamic-shapes> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Dynamic shapes and shape specialization"@en ;
  skos:definition "Handling inputs whose tensor dimensions vary across calls by specializing compiled code per shape, padding into buckets, or compiling with symbolic dimensions."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.dynamic-shapes> skos:altLabel "symbolic shapes"@en .
<https://mlsysbook.ai/taxonomy/mlsys.dynamic-shapes> skos:altLabel "shape bucketing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.dynamic-shapes> skos:altLabel "shape recompilation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.rule-based-graph-rewriting> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Rule-based graph rewriting"@en ;
  skos:definition "Applying hand-written semantics-preserving transformations to a computation graph, such as constant folding, dead-code elimination, operator substitution, and algebraic simplification."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.rule-based-graph-rewriting> skos:altLabel "constant folding"@en .
<https://mlsysbook.ai/taxonomy/mlsys.rule-based-graph-rewriting> skos:altLabel "algebraic simplification"@en .
<https://mlsysbook.ai/taxonomy/mlsys.rule-based-graph-rewriting> skos:altLabel "operator substitution"@en .
<https://mlsysbook.ai/taxonomy/mlsys.rule-based-graph-rewriting> skos:altLabel "graph optimization passes"@en .
<https://mlsysbook.ai/taxonomy/mlsys.rule-based-graph-rewriting> skos:altLabel "graph rewriting"@en .

<https://mlsysbook.ai/taxonomy/mlsys.sparse-ragged-tensors> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Sparse and ragged tensor representation"@en ;
  skos:definition "Storing tensors with mostly zero entries or variable-length dimensions in compressed formats such as COO, CSR, or offset-indexed ragged layouts instead of padded dense arrays."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.sparse-ragged-tensors> skos:altLabel "ragged tensor"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sparse-ragged-tensors> skos:altLabel "nested tensor"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sparse-ragged-tensors> skos:altLabel "jagged tensor"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sparse-ragged-tensors> skos:altLabel "CSR format"@en .

<https://mlsysbook.ai/taxonomy/mlsys.execution-providers> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Execution providers and operator fallback"@en ;
  skos:definition "Partitioning a model graph across runtime backends by operator support, running supported subgraphs on accelerators and falling back to a CPU backend otherwise."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.execution-providers> skos:altLabel "execution provider"@en .
<https://mlsysbook.ai/taxonomy/mlsys.execution-providers> skos:altLabel "backend delegation"@en .
<https://mlsysbook.ai/taxonomy/mlsys.execution-providers> skos:altLabel "operator fallback"@en .

<https://mlsysbook.ai/taxonomy/mlsys.large-language-model> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Large language model"@en ;
  skos:definition "A language model large enough that parameter memory, attention state that grows with context, and token-by-token decoding usually dominate its training and serving cost. Tag it only when an item is about that workload class itself, not merely because an LLM is involved."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.large-language-model> skos:altLabel "LLM"@en .
<https://mlsysbook.ai/taxonomy/mlsys.large-language-model> skos:altLabel "foundation model"@en .
<https://mlsysbook.ai/taxonomy/mlsys.large-language-model> skos:altLabel "LLM workload"@en .

<https://mlsysbook.ai/taxonomy/mlsys.inference-compute-estimate> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Inference compute and memory estimate"@en ;
  skos:definition "Approximating dense transformer inference as about two FLOPs per parameter per token, plus KV-cache bytes from layers, KV heads, head dimension, context length, batch, and precision."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.inference-compute-estimate> skos:altLabel "2N FLOPs per token"@en .
<https://mlsysbook.ai/taxonomy/mlsys.inference-compute-estimate> skos:altLabel "KV-cache sizing"@en .

<https://mlsysbook.ai/taxonomy/mlsys.sync-async-training> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Synchronous vs. asynchronous training"@en ;
  skos:definition "Choosing whether workers apply an update only after every gradient for a step is combined, or apply updates independently on possibly stale parameters."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.sync-async-training> skos:altLabel "synchronous SGD"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sync-async-training> skos:altLabel "asynchronous SGD"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sync-async-training> skos:altLabel "async SGD"@en .

<https://mlsysbook.ai/taxonomy/mlsys.input-prefetching> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Input prefetching"@en ;
  skos:definition "Preparing upcoming batches in background workers and buffers while the accelerator processes the current batch, overlapping input delivery with computation."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.input-prefetching> skos:altLabel "data prefetching"@en .
<https://mlsysbook.ai/taxonomy/mlsys.input-prefetching> skos:altLabel "prefetch buffer"@en .

<https://mlsysbook.ai/taxonomy/mlsys.event-time-windowing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Event-time windowing and watermarks"@en ;
  skos:definition "Grouping stream events into windows by when they occurred, using watermarks to estimate completeness and explicit policies for events arriving after a window closes."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.event-time-windowing> skos:altLabel "stream watermarks"@en .
<https://mlsysbook.ai/taxonomy/mlsys.event-time-windowing> skos:altLabel "late data handling"@en .
<https://mlsysbook.ai/taxonomy/mlsys.event-time-windowing> skos:altLabel "windowed aggregation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.token-streaming> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Token streaming"@en ;
  skos:definition "Delivering generated output to the client incrementally as tokens are produced, holding per-stream state and stopping generation when the client cancels or disconnects."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.token-streaming> skos:altLabel "incremental response delivery"@en .
<https://mlsysbook.ai/taxonomy/mlsys.token-streaming> skos:altLabel "server-sent events"@en .

<https://mlsysbook.ai/taxonomy/mlsys.serverless-inference> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Serverless inference"@en ;
  skos:definition "Running models on a managed platform that provisions replicas on demand, bills per use, and can scale to zero, exposing requests to cold-start latency."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.serverless-inference> skos:altLabel "scale-to-zero"@en .
<https://mlsysbook.ai/taxonomy/mlsys.serverless-inference> skos:altLabel "function-as-a-service inference"@en .

<https://mlsysbook.ai/taxonomy/mlsys.llm-request-scheduling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "LLM request scheduling and preemption"@en ;
  skos:definition "Ordering, prioritizing, and preempting in-flight generation requests at iteration granularity, swapping or recomputing their KV state, to meet latency targets and fairness goals."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.llm-request-scheduling> skos:altLabel "request preemption"@en .
<https://mlsysbook.ai/taxonomy/mlsys.llm-request-scheduling> skos:altLabel "iteration-level scheduling"@en .

<https://mlsysbook.ai/taxonomy/mlsys.containerization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Containerization"@en ;
  skos:definition "Packaging a model, its code, and its dependencies as an immutable image that runs unchanged across machines. Scheduling those containers across a cluster belongs to the cluster manager."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.containerization> skos:altLabel "containers"@en .
<https://mlsysbook.ai/taxonomy/mlsys.containerization> skos:altLabel "Docker"@en .

<https://mlsysbook.ai/taxonomy/mlsys.distributed-hang-diagnosis> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Distributed job hang diagnosis"@en ;
  skos:definition "Detecting and localizing stalled distributed jobs through collective timeouts, heartbeats, per-rank progress traces, and node health checks, so faulty ranks can be isolated."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.distributed-hang-diagnosis> skos:altLabel "collective timeout"@en .
<https://mlsysbook.ai/taxonomy/mlsys.distributed-hang-diagnosis> skos:altLabel "NCCL watchdog"@en .
<https://mlsysbook.ai/taxonomy/mlsys.distributed-hang-diagnosis> skos:altLabel "node health checks"@en .

<https://mlsysbook.ai/taxonomy/mlsys.benchmark-representativeness> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Benchmark representativeness"@en ;
  skos:definition "The degree to which a benchmark's workload, scale, and measurement boundary predict production behavior, from isolated microbenchmarks to end-to-end application runs."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.benchmark-representativeness> skos:altLabel "microbenchmark vs. end-to-end benchmark"@en .
<https://mlsysbook.ai/taxonomy/mlsys.benchmark-representativeness> skos:altLabel "benchmark realism"@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-model-licensing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data and model licensing"@en ;
  skos:definition "Legal terms governing how datasets and model weights may be used, modified, redistributed, or deployed, which constrain acquisition, fine-tuning, and release decisions."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.data-model-licensing> skos:altLabel "dataset license"@en .
<https://mlsysbook.ai/taxonomy/mlsys.data-model-licensing> skos:altLabel "model license"@en .
<https://mlsysbook.ai/taxonomy/mlsys.data-model-licensing> skos:altLabel "open-weight license"@en .

<https://mlsysbook.ai/taxonomy/mlsys.content-provenance> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Content provenance"@en ;
  skos:definition "Cryptographically signed metadata attached to media that records its origin and edit history, including model generation, so recipients can verify source claims."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.content-provenance> skos:altLabel "C2PA"@en .
<https://mlsysbook.ai/taxonomy/mlsys.content-provenance> skos:altLabel "content credentials"@en .

<https://mlsysbook.ai/taxonomy/mlsys.fleet-data-engine> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Fleet data engine"@en ;
  skos:definition "Collecting training data from deployed devices through on-device triggers that flag rare or uncertain events, uploading selected samples under bandwidth budgets for labeling and retraining."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.fleet-data-engine> skos:altLabel "data engine"@en .
<https://mlsysbook.ai/taxonomy/mlsys.fleet-data-engine> skos:altLabel "triggered data collection"@en .
<https://mlsysbook.ai/taxonomy/mlsys.fleet-data-engine> skos:altLabel "edge-case mining"@en .
<https://mlsysbook.ai/taxonomy/mlsys.fleet-data-engine> skos:altLabel "data flywheel"@en .

<https://mlsysbook.ai/taxonomy/mlsys.robotics-middleware> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Robotics middleware and dataflow"@en ;
  skos:definition "Software connecting sensing, perception, planning, and control processes as nodes that exchange typed messages over publish-subscribe topics with configurable delivery and timing policies."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.robotics-middleware> skos:altLabel "ROS 2"@en .
<https://mlsysbook.ai/taxonomy/mlsys.robotics-middleware> skos:altLabel "publish-subscribe middleware"@en .
<https://mlsysbook.ai/taxonomy/mlsys.robotics-middleware> skos:altLabel "DDS"@en .

<https://mlsysbook.ai/taxonomy/mlsys.parallel-simulation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Parallel physics simulation"@en ;
  skos:definition "Running many simulated robot environments concurrently, often batched on accelerators, so policy learning and data generation gather experience faster than physical collection."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.parallel-simulation> skos:altLabel "GPU-parallel simulation"@en .
<https://mlsysbook.ai/taxonomy/mlsys.parallel-simulation> skos:altLabel "simulated environments"@en .
<https://mlsysbook.ai/taxonomy/mlsys.parallel-simulation> skos:altLabel "vectorized environments"@en .

<https://mlsysbook.ai/taxonomy/mlsys.agent-credentials> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Agent credentials and delegated authority"@en ;
  skos:definition "Issuing tool-using agents scoped, short-lived credentials that act on a user's behalf, brokering secrets outside model context so authority stays bounded and revocable."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.agent-credentials> skos:altLabel "agent identity"@en .
<https://mlsysbook.ai/taxonomy/mlsys.agent-credentials> skos:altLabel "delegated tokens"@en .
<https://mlsysbook.ai/taxonomy/mlsys.agent-credentials> skos:altLabel "secret brokering"@en .

<https://mlsysbook.ai/taxonomy/mlsys.gnn-graph-partitioning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Graph partitioning for GNN training"@en ;
  skos:definition "Splitting a large graph across workers to balance computation while minimizing cut edges, whose cross-partition neighbor features must be fetched remotely."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.gnn-graph-partitioning> skos:altLabel "graph partitioning"@en .
<https://mlsysbook.ai/taxonomy/mlsys.gnn-graph-partitioning> skos:altLabel "METIS partitioning"@en .
<https://mlsysbook.ai/taxonomy/mlsys.gnn-graph-partitioning> skos:altLabel "distributed GNN training"@en .

<https://mlsysbook.ai/taxonomy/mlsys.host-data-loader> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Host-side data loading"@en ;
  skos:definition "Reading, decoding, augmenting, and collating examples on host CPU worker processes and staging batches in pinned memory so that a single machine's accelerators are not left waiting for input."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.host-data-loader> skos:altLabel "data loader"@en .
<https://mlsysbook.ai/taxonomy/mlsys.host-data-loader> skos:altLabel "DataLoader workers"@en .
<https://mlsysbook.ai/taxonomy/mlsys.host-data-loader> skos:altLabel "pinned memory"@en .

<https://mlsysbook.ai/taxonomy/mlsys.streaming-inference> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Streaming inference"@en ;
  skos:definition "Serving a model over an open stream of input, producing outputs incrementally from partial input while carrying state between chunks, rather than answering one complete request at a time."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.streaming-inference> skos:altLabel "incremental inference"@en .
<https://mlsysbook.ai/taxonomy/mlsys.streaming-inference> skos:altLabel "online streaming inference"@en .

<https://mlsysbook.ai/taxonomy/mlsys.inference-api> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Inference API and payload serialization"@en ;
  skos:definition "The request and response protocol of a model server, including the transport (HTTP, gRPC, streaming connections), the tensor and payload encoding, and the cost of serializing inputs and outputs."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.inference-api> skos:altLabel "prediction API"@en .
<https://mlsysbook.ai/taxonomy/mlsys.inference-api> skos:altLabel "gRPC inference"@en .
<https://mlsysbook.ai/taxonomy/mlsys.inference-api> skos:altLabel "tensor serialization"@en .

<https://mlsysbook.ai/taxonomy/mlsys.request-throughput> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Request throughput"@en ;
  skos:definition "The number of requests, or tokens, a serving system completes per unit time at a stated load and latency target."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.request-throughput> skos:altLabel "queries per second"@en .
<https://mlsysbook.ai/taxonomy/mlsys.request-throughput> skos:altLabel "QPS"@en .
<https://mlsysbook.ai/taxonomy/mlsys.request-throughput> skos:altLabel "tokens per second"@en .

<https://mlsysbook.ai/taxonomy/mlsys.latency-percentiles> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Latency percentiles"@en ;
  skos:definition "Summarizing a latency distribution by percentiles such as p50, p95, and p99, so that a service is judged by the experience of most requests and of the slow tail rather than by the mean."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.latency-percentiles> skos:altLabel "p50"@en .
<https://mlsysbook.ai/taxonomy/mlsys.latency-percentiles> skos:altLabel "p99"@en .
<https://mlsysbook.ai/taxonomy/mlsys.latency-percentiles> skos:altLabel "percentile latency"@en .

<https://mlsysbook.ai/taxonomy/mlsys.cache-aware-routing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Cache-aware request routing"@en ;
  skos:definition "Sending each request to the replica that already holds a reusable prefix or KV cache for it, trading load balance against cache reuse."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.cache-aware-routing> skos:altLabel "prefix-affinity routing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.cache-aware-routing> skos:altLabel "KV-aware routing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.cache-aware-routing> skos:altLabel "session affinity"@en .

<https://mlsysbook.ai/taxonomy/mlsys.process-group-rendezvous> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Distributed job launch and process groups"@en ;
  skos:definition "Starting the processes of a distributed job, having them discover each other through a rendezvous, assigning ranks, and forming the process groups and communicators that collectives run over."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.process-group-rendezvous> skos:altLabel "rendezvous"@en .
<https://mlsysbook.ai/taxonomy/mlsys.process-group-rendezvous> skos:altLabel "ranks"@en .
<https://mlsysbook.ai/taxonomy/mlsys.process-group-rendezvous> skos:altLabel "communicator initialization"@en .
<https://mlsysbook.ai/taxonomy/mlsys.process-group-rendezvous> skos:altLabel "torchrun"@en .

<https://mlsysbook.ai/taxonomy/mlsys.agentic-workload> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Agentic workload"@en ;
  skos:definition "The load an agent places on the serving stack, including context that grows each turn, idle gaps while tools run, many short dependent model calls, and reuse of KV state across steps."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.agentic-workload> skos:altLabel "agent workload"@en .
<https://mlsysbook.ai/taxonomy/mlsys.agentic-workload> skos:altLabel "multi-turn inference load"@en .

<https://mlsysbook.ai/taxonomy/mlsys.performance-regression-testing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Performance regression testing"@en ;
  skos:definition "Benchmarking every change to code, kernels, models, or configuration continuously and failing the change when throughput, latency, or memory degrades beyond a set tolerance."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.performance-regression-testing> skos:altLabel "continuous benchmarking"@en .
<https://mlsysbook.ai/taxonomy/mlsys.performance-regression-testing> skos:altLabel "perf regression gate"@en .

<https://mlsysbook.ai/taxonomy/mlsys.measurement-variability> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Performance measurement variability"@en ;
  skos:definition "Run-to-run variation in measured time and throughput from warm-up, asynchronous execution, clock and thermal state, and contention, handled by synchronizing, repeating runs, and reporting spread."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.measurement-variability> skos:altLabel "benchmark noise"@en .
<https://mlsysbook.ai/taxonomy/mlsys.measurement-variability> skos:altLabel "warm-up effects"@en .
<https://mlsysbook.ai/taxonomy/mlsys.measurement-variability> skos:altLabel "timing variance"@en .

<https://mlsysbook.ai/taxonomy/mlsys.pii-deidentification> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "PII detection and de-identification"@en ;
  skos:definition "Finding personal identifiers in training corpora, logs, and prompts and removing, masking, or pseudonymizing them before the data is stored, trained on, or shared."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.pii-deidentification> skos:altLabel "PII scrubbing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.pii-deidentification> skos:altLabel "data anonymization"@en .
<https://mlsysbook.ai/taxonomy/mlsys.pii-deidentification> skos:altLabel "redaction"@en .

<https://mlsysbook.ai/taxonomy/mlsys.gradient-clipping> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Gradient clipping"@en ;
  skos:definition "Rescaling or truncating gradients whose norm exceeds a threshold so that a single large update cannot destabilize training."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.gradient-clipping> skos:altLabel "gradient norm clipping"@en .

<https://mlsysbook.ai/taxonomy/mlsys.weight-initialization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Weight initialization"@en ;
  skos:definition "Choosing the scale and distribution of initial parameters so that activations and gradients keep stable variance through depth at the start of training."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.weight-initialization> skos:altLabel "Xavier initialization"@en .
<https://mlsysbook.ai/taxonomy/mlsys.weight-initialization> skos:altLabel "He initialization"@en .

<https://mlsysbook.ai/taxonomy/mlsys.delivery-semantics> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Processing delivery semantics"@en ;
  skos:definition "The guarantee a data pipeline gives about how often each record takes effect (at most once, at least once, or effectively once) under retries, replays, and failures, and the idempotent or transactional sinks that achieve it."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.delivery-semantics> skos:altLabel "exactly-once processing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.delivery-semantics> skos:altLabel "at-least-once delivery"@en .
<https://mlsysbook.ai/taxonomy/mlsys.delivery-semantics> skos:altLabel "duplicate events"@en .

<https://mlsysbook.ai/taxonomy/mlsys.online-feature-consistency> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Online and offline feature consistency"@en ;
  skos:definition "Keeping the feature values materialized in the low-latency online store consistent with the offline values used for training, as features are recomputed, backfilled, and updated."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.online-feature-consistency> skos:altLabel "feature materialization"@en .
<https://mlsysbook.ai/taxonomy/mlsys.online-feature-consistency> skos:altLabel "online store consistency"@en .

<https://mlsysbook.ai/taxonomy/mlsys.ood-detection> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Out-of-distribution detection"@en ;
  skos:definition "Flagging individual inputs that differ from the training distribution so the system can abstain, defer, or fall back instead of trusting the prediction."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.ood-detection> skos:altLabel "OOD detection"@en .
<https://mlsysbook.ai/taxonomy/mlsys.ood-detection> skos:altLabel "novelty detection"@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-feature-compatibility> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model and feature compatibility"@en ;
  skos:definition "Ensuring that a model version, its tokenizer and feature transformations, the schemas it reads, and the consumers of its outputs remain compatible as each is versioned and released independently."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-feature-compatibility> skos:altLabel "interface compatibility"@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-feature-compatibility> skos:altLabel "tokenizer compatibility"@en .

<https://mlsysbook.ai/taxonomy/mlsys.secrets-management> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Workload identity and secrets management"@en ;
  skos:definition "Giving training jobs, model servers, and pipelines verifiable identities and provisioning, rotating, and revoking the keys and credentials they use, without embedding secrets in code or images."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.secrets-management> skos:altLabel "secrets management"@en .
<https://mlsysbook.ai/taxonomy/mlsys.secrets-management> skos:altLabel "workload identity"@en .
<https://mlsysbook.ai/taxonomy/mlsys.secrets-management> skos:altLabel "credential rotation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.deletion-propagation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data deletion propagation"@en ;
  skos:definition "Carrying a deletion request through every copy and derivative of the data, including datasets, features, caches, replicas, backups, and models trained on it."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.deletion-propagation> skos:altLabel "right to erasure"@en .
<https://mlsysbook.ai/taxonomy/mlsys.deletion-propagation> skos:altLabel "deletion requests"@en .

<https://mlsysbook.ai/taxonomy/mlsys.memory-fragmentation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Runtime memory fragmentation"@en ;
  skos:definition "Free device memory split into blocks too small to satisfy new allocations, so a job runs out of memory while reserved memory exceeds what live tensors use."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.memory-fragmentation> skos:altLabel "allocator fragmentation"@en .
<https://mlsysbook.ai/taxonomy/mlsys.memory-fragmentation> skos:altLabel "reserved versus allocated memory"@en .

<https://mlsysbook.ai/taxonomy/mlsys.perception-latency-budget> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Perception latency budget"@en ;
  skos:definition "The share of a robot's sense-to-act deadline allotted to sensing and perception, which bounds model size, input resolution, and frame rate on the onboard computer."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.perception-latency-budget> skos:altLabel "sense-to-act latency budget"@en .

<https://mlsysbook.ai/taxonomy/mlsys.onboard-compute-partitioning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Onboard compute partitioning"@en ;
  skos:definition "Assigning perception, planning, and control workloads to the CPUs, accelerators, and microcontrollers of a robot, or offloading them, so each meets its deadline and criticality level."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.onboard-compute-partitioning> skos:altLabel "onboard workload placement"@en .
<https://mlsysbook.ai/taxonomy/mlsys.onboard-compute-partitioning> skos:altLabel "robot compute offloading"@en .

<https://mlsysbook.ai/taxonomy/mlsys.health-checks> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Health checks and readiness probes"@en ;
  skos:definition "Periodic liveness and readiness checks that let an orchestrator or load balancer stop routing traffic to, or restart, a replica that is unhealthy or still loading its model."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.health-checks> skos:altLabel "readiness probe"@en .
<https://mlsysbook.ai/taxonomy/mlsys.health-checks> skos:altLabel "liveness probe"@en .
<https://mlsysbook.ai/taxonomy/mlsys.health-checks> skos:altLabel "health endpoint"@en .

<https://mlsysbook.ai/taxonomy/mlsys.python-gil> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Python GIL and host-language concurrency"@en ;
  skos:definition "The CPython global interpreter lock serializes Python bytecode across threads, so ML host code achieves concurrency through native kernels that release the lock, multiple processes, or asynchronous I/O."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.python-gil> skos:altLabel "GIL"@en .
<https://mlsysbook.ai/taxonomy/mlsys.python-gil> skos:altLabel "global interpreter lock"@en .
<https://mlsysbook.ai/taxonomy/mlsys.python-gil> skos:altLabel "multiprocessing workers"@en .

<https://mlsysbook.ai/taxonomy/mlsys.flash-endurance> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Flash write endurance"@en ;
  skos:definition "Flash memory cells wear out after a limited number of program and erase cycles, which bounds how often embedded and edge devices can write logs, checkpoints, or model updates; wear leveling spreads writes to extend life."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.flash-endurance> skos:altLabel "flash wear-out"@en .
<https://mlsysbook.ai/taxonomy/mlsys.flash-endurance> skos:altLabel "wear leveling"@en .
<https://mlsysbook.ai/taxonomy/mlsys.flash-endurance> skos:altLabel "program/erase cycles"@en .

<https://mlsysbook.ai/taxonomy/mlsys.intermittent-computing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Energy-harvesting intermittent computing"@en ;
  skos:definition "Running inference on devices powered by harvested energy that lose power unpredictably, which requires checkpointing progress to nonvolatile memory so computation resumes rather than restarts."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.intermittent-computing> skos:altLabel "energy harvesting"@en .
<https://mlsysbook.ai/taxonomy/mlsys.intermittent-computing> skos:altLabel "batteryless inference"@en .
<https://mlsysbook.ai/taxonomy/mlsys.intermittent-computing> skos:altLabel "intermittent inference"@en .

<https://mlsysbook.ai/taxonomy/mlsys.mmap-weights> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Memory-mapped model weights"@en ;
  skos:definition "Mapping a weight file into virtual memory so pages load on demand and read-only weights are shared across processes, cutting load time and duplicate memory at the cost of page faults."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.mmap-weights> skos:altLabel "mmap weights"@en .
<https://mlsysbook.ai/taxonomy/mlsys.mmap-weights> skos:altLabel "shared weight mapping"@en .
<https://mlsysbook.ai/taxonomy/mlsys.mmap-weights> skos:altLabel "zero-copy model loading"@en .

<https://mlsysbook.ai/taxonomy/mlsys.os-memory-pressure> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "OS memory pressure and paging"@en ;
  skos:definition "How an operating system reclaims memory from a model process under pressure, by evicting file-backed pages, swapping or compressing memory, or killing the app, which shows up as page thrashing, latency spikes, or abrupt termination."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.os-memory-pressure> skos:altLabel "page thrashing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.os-memory-pressure> skos:altLabel "low-memory killer"@en .
<https://mlsysbook.ai/taxonomy/mlsys.os-memory-pressure> skos:altLabel "memory reclamation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.managed-runtime-interop> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Managed-runtime interop and garbage collection"@en ;
  skos:definition "Crossing between a managed language runtime (Java, Kotlin, Swift, C#) and native inference code, where buffer copies, object pinning, and garbage-collection pauses add latency and memory."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.managed-runtime-interop> skos:altLabel "JNI overhead"@en .
<https://mlsysbook.ai/taxonomy/mlsys.managed-runtime-interop> skos:altLabel "GC pauses"@en .
<https://mlsysbook.ai/taxonomy/mlsys.managed-runtime-interop> skos:altLabel "native interop"@en .

<https://mlsysbook.ai/taxonomy/mlsys.zero-copy-dma> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Zero-copy sensor input via DMA"@en ;
  skos:definition "Having sensors or peripherals write input directly into model input buffers by direct memory access, avoiding CPU copies between capture and inference."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.zero-copy-dma> skos:altLabel "DMA input buffers"@en .
<https://mlsysbook.ai/taxonomy/mlsys.zero-copy-dma> skos:altLabel "zero-copy capture"@en .
<https://mlsysbook.ai/taxonomy/mlsys.zero-copy-dma> skos:altLabel "double buffering"@en .

<https://mlsysbook.ai/taxonomy/mlsys.sensor-interference> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Active sensor interference"@en ;
  skos:definition "Crosstalk between active sensors, such as lidars, radars, or structured-light cameras, that emit into the same environment and corrupt each other's measurements."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.sensor-interference> skos:altLabel "sensor crosstalk"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sensor-interference> skos:altLabel "lidar interference"@en .

<https://mlsysbook.ai/taxonomy/mlsys.network-propagation-delay> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Network propagation delay"@en ;
  skos:definition "The minimum latency set by the distance a signal travels at the speed of light in fiber, which bounds round trips between regions regardless of bandwidth."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.network-propagation-delay> skos:altLabel "speed-of-light latency"@en .
<https://mlsysbook.ai/taxonomy/mlsys.network-propagation-delay> skos:altLabel "round-trip time"@en .
<https://mlsysbook.ai/taxonomy/mlsys.network-propagation-delay> skos:altLabel "RTT"@en .

<https://mlsysbook.ai/taxonomy/mlsys.cap-tradeoff> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Consistency-availability trade-off"@en ;
  skos:definition "Under a network partition, a replicated system must choose between answering with possibly stale state and refusing requests until replicas agree."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.cap-tradeoff> skos:altLabel "CAP theorem"@en .
<https://mlsysbook.ai/taxonomy/mlsys.cap-tradeoff> skos:altLabel "partition tolerance"@en .

<https://mlsysbook.ai/taxonomy/mlsys.gossip-averaging> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Decentralized gossip averaging"@en ;
  skos:definition "Training in which each worker averages its model with a few neighbors instead of a central server or global all-reduce, so updates diffuse through the communication graph."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.gossip-averaging> skos:altLabel "gossip SGD"@en .
<https://mlsysbook.ai/taxonomy/mlsys.gossip-averaging> skos:altLabel "decentralized SGD"@en .

<https://mlsysbook.ai/taxonomy/mlsys.interrupt-latency> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Interrupt latency"@en ;
  skos:definition "The delay between a hardware event and its interrupt handler running, plus the handler's own run time, which must fit inside a real-time sensing or control budget alongside inference."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.interrupt-latency> skos:altLabel "ISR latency"@en .
<https://mlsysbook.ai/taxonomy/mlsys.interrupt-latency> skos:altLabel "interrupt service routine budget"@en .

<https://mlsysbook.ai/taxonomy/mlsys.transformer-variants> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Encoder-only, decoder-only, and encoder-decoder Transformers"@en ;
  skos:definition "The three arrangements of Transformer stacks, which differ in whether inputs are processed bidirectionally, outputs are generated autoregressively, or both, and therefore in how they are trained, cached, and served."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.transformer-variants> skos:altLabel "encoder-only model"@en .
<https://mlsysbook.ai/taxonomy/mlsys.transformer-variants> skos:altLabel "decoder-only model"@en .
<https://mlsysbook.ai/taxonomy/mlsys.transformer-variants> skos:altLabel "encoder-decoder model"@en .
<https://mlsysbook.ai/taxonomy/mlsys.transformer-variants> skos:altLabel "seq2seq Transformer"@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-transfer-cost> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data transfer cost"@en ;
  skos:definition "The money charged for moving data across network, zone, region, or provider boundaries, such as cloud egress fees, which can dominate the cost of distributing data, checkpoints, or responses."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.data-transfer-cost> skos:altLabel "egress cost"@en .
<https://mlsysbook.ai/taxonomy/mlsys.data-transfer-cost> skos:altLabel "egress fees"@en .
<https://mlsysbook.ai/taxonomy/mlsys.data-transfer-cost> skos:altLabel "network transfer cost"@en .

<https://mlsysbook.ai/taxonomy/mlsys.duty-cycling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Duty cycling and sleep states"@en ;
  skos:definition "Keeping a device in a low-power sleep state most of the time and waking it briefly to sense and infer, so average power is set by the active fraction and the cost of each wake-up."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.duty-cycling> skos:altLabel "duty cycle"@en .
<https://mlsysbook.ai/taxonomy/mlsys.duty-cycling> skos:altLabel "sleep modes"@en .
<https://mlsysbook.ai/taxonomy/mlsys.duty-cycling> skos:altLabel "active and sleep power states"@en .
<https://mlsysbook.ai/taxonomy/mlsys.duty-cycling> skos:altLabel "low-power modes"@en .

<https://mlsysbook.ai/taxonomy/mlsys.priority-inversion> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Priority inversion"@en ;
  skos:definition "A high-priority task waiting on a resource held by a lower-priority task, which a medium-priority task then preempts, so the high-priority task misses its deadline unless priority inheritance or ceilings are used."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.priority-inversion> skos:altLabel "priority inheritance"@en .
<https://mlsysbook.ai/taxonomy/mlsys.priority-inversion> skos:altLabel "priority ceiling"@en .

<https://mlsysbook.ai/taxonomy/mlsys.randomized-smoothing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Certified robustness by randomized smoothing"@en ;
  skos:definition "Classifying many noise-perturbed copies of an input and taking the majority vote, which yields a provable radius within which no adversarial perturbation can change the prediction, at the cost of many inferences per input."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.randomized-smoothing> skos:altLabel "randomized smoothing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.randomized-smoothing> skos:altLabel "certified defense"@en .

<https://mlsysbook.ai/taxonomy/mlsys.sensor-interconnect> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Sensor interconnect bandwidth"@en ;
  skos:definition "The data rate of the links that carry sensor data into an embedded processor (MIPI CSI-2 for cameras, I2S for audio, SPI and I2C for low-rate sensors), which bounds the resolution, frame rate, and number of sensors a device can ingest."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.sensor-interconnect> skos:altLabel "MIPI CSI-2"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sensor-interconnect> skos:altLabel "I2S"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sensor-interconnect> skos:altLabel "SPI bandwidth"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sensor-interconnect> skos:altLabel "camera link bandwidth"@en .

<https://mlsysbook.ai/taxonomy/mlsys.finite-buffer> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Finite buffers and overflow"@en ;
  skos:definition "A queue with bounded capacity drops or blocks arrivals once full, so its size trades memory and added delay against the loss rate under bursty input."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.finite-buffer> skos:altLabel "buffer overflow"@en .
<https://mlsysbook.ai/taxonomy/mlsys.finite-buffer> skos:altLabel "bounded queue"@en .
<https://mlsysbook.ai/taxonomy/mlsys.finite-buffer> skos:altLabel "finite-capacity queue"@en .
<https://mlsysbook.ai/taxonomy/mlsys.finite-buffer> skos:altLabel "backlog"@en .

<https://mlsysbook.ai/taxonomy/mlsys.ui-thread-inference> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Asynchronous on-device inference"@en ;
  skos:definition "Running inference off the application's main thread, so a model call does not block rendering and input handling, with results delivered back by callback or message."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.ui-thread-inference> skos:altLabel "UI-thread blocking"@en .
<https://mlsysbook.ai/taxonomy/mlsys.ui-thread-inference> skos:altLabel "background inference thread"@en .
<https://mlsysbook.ai/taxonomy/mlsys.ui-thread-inference> skos:altLabel "main-thread jank"@en .

<https://mlsysbook.ai/taxonomy/mlsys.multi-head-latent-attention> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Multi-head latent attention"@en ;
  skos:definition "Attention that caches one low-rank latent vector per token in place of per-head keys and values, reconstructing them or absorbing the up-projections into the query and output weights, which shrinks the KV cache and decode memory traffic."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.multi-head-latent-attention> skos:altLabel "MLA"@en .
<https://mlsysbook.ai/taxonomy/mlsys.multi-head-latent-attention> skos:altLabel "latent KV attention"@en .

<https://mlsysbook.ai/taxonomy/mlsys.training-data-extraction> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Training data extraction"@en ;
  skos:definition "Recovering particular training examples or their sensitive contents through a trained model's outputs, exposing information that was not intended for release."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.training-data-extraction> skos:altLabel "memorization attack"@en .
<https://mlsysbook.ai/taxonomy/mlsys.training-data-extraction> skos:altLabel "training data regurgitation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.system-identification> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "System identification"@en ;
  skos:definition "Estimating the parameters of a dynamics model, such as masses, friction, delays, and actuator gains, from measured input-output data of the physical system."@en ;
  skos:editorialNote "Draft concept."@en .

<https://mlsysbook.ai/taxonomy/mlsys.off-policy-evaluation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Off-policy evaluation"@en ;
  skos:definition "Estimating a proposed policy's expected outcomes from interactions collected under another policy, by propensity reweighting, outcome modeling, or doubly robust estimators, subject to assumptions about action coverage and confounding."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.off-policy-evaluation> skos:altLabel "OPE"@en .
<https://mlsysbook.ai/taxonomy/mlsys.off-policy-evaluation> skos:altLabel "counterfactual policy evaluation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.pipeline-schedule> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Pipeline schedule"@en ;
  skos:definition "The order in which pipeline stages run the forward and backward passes of microbatches (fill-drain, one-forward-one-backward, interleaved), which sets the bubble fraction and how many microbatches' activations each stage holds."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.pipeline-schedule> skos:altLabel "GPipe schedule"@en .
<https://mlsysbook.ai/taxonomy/mlsys.pipeline-schedule> skos:altLabel "1F1B"@en .
<https://mlsysbook.ai/taxonomy/mlsys.pipeline-schedule> skos:altLabel "interleaved 1F1B"@en .
<https://mlsysbook.ai/taxonomy/mlsys.pipeline-schedule> skos:altLabel "zero-bubble schedule"@en .

<https://mlsysbook.ai/taxonomy/mlsys.sequence-packing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Sequence packing"@en ;
  skos:definition "Combining variable-length training examples into packed token buffers with explicit example boundaries and attention semantics to reduce padding work without unintended cross-example attention."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.sequence-packing> skos:altLabel "sample packing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sequence-packing> skos:altLabel "packed-sequence training"@en .

<https://mlsysbook.ai/taxonomy/mlsys.document-chunking> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Document chunking"@en ;
  skos:definition "Dividing source documents into retrievable units with chosen boundaries, overlap, and source identifiers so retrieval granularity fits embedding and generation budgets."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.document-chunking> skos:altLabel "retrieval chunking"@en .
<https://mlsysbook.ai/taxonomy/mlsys.document-chunking> skos:altLabel "passage segmentation"@en .
<https://mlsysbook.ai/taxonomy/mlsys.document-chunking> skos:altLabel "semantic chunking"@en .

<https://mlsysbook.ai/taxonomy/mlsys.resource-exhaustion-attack> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Resource-exhaustion attack"@en ;
  skos:definition "Crafting inputs that maximize a model service's compute, energy, output length, or tool calls, degrading service for other users or running up the operator's cost."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.resource-exhaustion-attack> skos:altLabel "sponge examples"@en .
<https://mlsysbook.ai/taxonomy/mlsys.resource-exhaustion-attack> skos:altLabel "denial of wallet"@en .
<https://mlsysbook.ai/taxonomy/mlsys.resource-exhaustion-attack> skos:altLabel "model denial of service"@en .
<https://mlsysbook.ai/taxonomy/mlsys.resource-exhaustion-attack> skos:altLabel "unbounded consumption"@en .
<https://mlsysbook.ai/taxonomy/mlsys.resource-exhaustion-attack> skos:altLabel "reasoning slowdown attack"@en .

<https://mlsysbook.ai/taxonomy/mlsys.generated-content-watermarking> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Generated-content watermarking"@en ;
  skos:definition "Embedding a statistically detectable signal into generated text, images, or audio at generation time, such as by biasing token sampling, so that content can later be identified as model-generated."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.generated-content-watermarking> skos:altLabel "output watermarking"@en .
<https://mlsysbook.ai/taxonomy/mlsys.generated-content-watermarking> skos:altLabel "text watermarking"@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-merging> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model merging"@en ;
  skos:definition "Combining compatible model parameters or parameter updates, by averaging or arithmetic on weight differences, into one model that consolidates capabilities without further training or serving the sources separately."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-merging> skos:altLabel "model soup"@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-merging> skos:altLabel "task arithmetic"@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-merging> skos:altLabel "TIES-merging"@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-merging> skos:altLabel "weight merging"@en .

<https://mlsysbook.ai/taxonomy/mlsys.optical-circuit-switching> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Optical circuit switching"@en ;
  skos:definition "Reconfiguring optical connections between endpoints to match communication demand, trading switching delay and topology coordination against delivered bandwidth and network power."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.optical-circuit-switching> skos:altLabel "OCS"@en .
<https://mlsysbook.ai/taxonomy/mlsys.optical-circuit-switching> skos:altLabel "reconfigurable optical fabric"@en .

<https://mlsysbook.ai/taxonomy/mlsys.co-packaged-optics> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Co-packaged optics"@en ;
  skos:definition "Placing optical transceivers inside the switch or accelerator package beside the silicon, so electrical paths shrink and energy per bit falls, at the cost of field serviceability and added package heat."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.co-packaged-optics> skos:altLabel "CPO"@en .
<https://mlsysbook.ai/taxonomy/mlsys.co-packaged-optics> skos:altLabel "co-packaged optical interconnect"@en .

<https://mlsysbook.ai/taxonomy/mlsys.advanced-accelerator-packaging> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Advanced accelerator packaging"@en ;
  skos:definition "Integrating compute and memory dies through chiplets, interposers, or three-dimensional bonding to trade local bandwidth and manufacturing flexibility against power-delivery and heat-removal constraints."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.advanced-accelerator-packaging> skos:altLabel "chiplet integration"@en .
<https://mlsysbook.ai/taxonomy/mlsys.advanced-accelerator-packaging> skos:altLabel "multi-die package"@en .
<https://mlsysbook.ai/taxonomy/mlsys.advanced-accelerator-packaging> skos:altLabel "heterogeneous die integration"@en .
<https://mlsysbook.ai/taxonomy/mlsys.advanced-accelerator-packaging> skos:altLabel "2.5D interposer"@en .
<https://mlsysbook.ai/taxonomy/mlsys.advanced-accelerator-packaging> skos:altLabel "die-to-die interconnect"@en .

<https://mlsysbook.ai/taxonomy/mlsys.motion-forecasting> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Motion forecasting"@en ;
  skos:definition "Predicting the future trajectories of other moving agents, usually as several weighted hypotheses, from their tracked history and the map, so a planner can avoid where they will be rather than where they are."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.motion-forecasting> skos:altLabel "behavior prediction"@en .
<https://mlsysbook.ai/taxonomy/mlsys.motion-forecasting> skos:altLabel "trajectory prediction"@en .
<https://mlsysbook.ai/taxonomy/mlsys.motion-forecasting> skos:altLabel "agent motion prediction"@en .

<https://mlsysbook.ai/taxonomy/mlsys.representational-bias-evaluation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Representational bias evaluation"@en ;
  skos:definition "Measuring stereotyped, demeaning, or unequal portrayals of groups in generated outputs, revealing representational harms that aggregate quality or decision-rate metrics can miss."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.representational-bias-evaluation> skos:altLabel "generative bias evaluation"@en .
<https://mlsysbook.ai/taxonomy/mlsys.representational-bias-evaluation> skos:altLabel "social bias benchmark"@en .
<https://mlsysbook.ai/taxonomy/mlsys.representational-bias-evaluation> skos:altLabel "stereotype evaluation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.group-relative-policy-optimization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Group relative policy optimization"@en ;
  skos:definition "A policy-gradient method that scores each sampled response against the mean reward of a group of responses to the same prompt, removing the learned critic at the cost of generating several rollouts per prompt."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.group-relative-policy-optimization> skos:altLabel "GRPO"@en .

<https://mlsysbook.ai/taxonomy/mlsys.inter-token-latency> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Inter-token latency"@en ;
  skos:definition "The time between consecutive output tokens or chunks delivered to a streaming client, whose distribution, not only its mean, exposes decode stalls that an average time per output token hides."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.inter-token-latency> skos:altLabel "ITL"@en .

<https://mlsysbook.ai/taxonomy/mlsys.hybrid-retrieval> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Hybrid retrieval"@en ;
  skos:definition "Combining lexical and dense retrieval results through score or rank fusion to recover complementary matches while managing additional search cost and ranking calibration."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.hybrid-retrieval> skos:altLabel "hybrid search"@en .
<https://mlsysbook.ai/taxonomy/mlsys.hybrid-retrieval> skos:altLabel "lexical-dense retrieval"@en .
<https://mlsysbook.ai/taxonomy/mlsys.hybrid-retrieval> skos:altLabel "reciprocal rank fusion"@en .

<https://mlsysbook.ai/taxonomy/mlsys.fpga-acceleration> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "FPGA-based ML acceleration"@en ;
  skos:definition "Mapping ML operations to reconfigurable logic, arithmetic blocks, and local memories so datapaths can match a workload at the cost of hardware compilation and resource constraints."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.fpga-acceleration> skos:altLabel "FPGA inference"@en .
<https://mlsysbook.ai/taxonomy/mlsys.fpga-acceleration> skos:altLabel "reconfigurable ML acceleration"@en .

<https://mlsysbook.ai/taxonomy/mlsys.device-initiated-communication> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Device-initiated communication"@en ;
  skos:definition "Communication in which kernels on the accelerator issue and synchronize inter-device transfers themselves, without a host call per exchange, allowing fine-grained fusion of compute and communication at the cost of explicit ordering and completion handling."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.device-initiated-communication> skos:altLabel "GPU-initiated communication"@en .
<https://mlsysbook.ai/taxonomy/mlsys.device-initiated-communication> skos:altLabel "accelerator-initiated communication"@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-collapse> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model collapse"@en ;
  skos:definition "Loss of coverage of the original data distribution across generations trained on model-generated data, making provenance and real-versus-synthetic mixture policies part of quality control."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-collapse> skos:altLabel "recursive synthetic-data collapse"@en .

<https://mlsysbook.ai/taxonomy/mlsys.action-tokenization> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Action tokenization"@en ;
  skos:definition "Encoding continuous robot actions or action sequences as discrete model tokens, making reconstruction error and token count determinants of policy fidelity and execution cost."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.action-tokenization> skos:altLabel "robot action tokenization"@en .
<https://mlsysbook.ai/taxonomy/mlsys.action-tokenization> skos:altLabel "action-sequence tokenization"@en .

<https://mlsysbook.ai/taxonomy/mlsys.wafer-scale-acceleration> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Wafer-scale acceleration"@en ;
  skos:definition "Executing ML on a compute-and-memory array spanning most of a semiconductor wafer, making spatial placement and communication between tiles central to performance."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.wafer-scale-acceleration> skos:altLabel "wafer-scale accelerator"@en .
<https://mlsysbook.ai/taxonomy/mlsys.wafer-scale-acceleration> skos:altLabel "wafer-scale engine"@en .

<https://mlsysbook.ai/taxonomy/mlsys.embedding-migration> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Embedding model migration"@en ;
  skos:definition "Changing the encoder behind a vector index while keeping queries and stored vectors comparable, by re-encoding the corpus, validated mappings, or backward-compatible training, with a controlled serving cutover."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.embedding-migration> skos:altLabel "re-embedding"@en .
<https://mlsysbook.ai/taxonomy/mlsys.embedding-migration> skos:altLabel "vector index backfill"@en .
<https://mlsysbook.ai/taxonomy/mlsys.embedding-migration> skos:altLabel "embedding version upgrade"@en .

<https://mlsysbook.ai/taxonomy/mlsys.register-pressure> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Register pressure"@en ;
  skos:definition "Demand for registers from simultaneously live kernel values, which can reduce resident threads or force values to spill into slower memory."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.register-pressure> skos:altLabel "register spilling"@en .
<https://mlsysbook.ai/taxonomy/mlsys.register-pressure> skos:altLabel "register file pressure"@en .

<https://mlsysbook.ai/taxonomy/mlsys.software-pipelining> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Software pipelining"@en ;
  skos:definition "Scheduling independent operations from different loop iterations to overlap, such as loading the next tile while computing the current one, hiding latency at the cost of extra live state and buffering."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.software-pipelining> skos:altLabel "multi-stage pipelining"@en .
<https://mlsysbook.ai/taxonomy/mlsys.software-pipelining> skos:altLabel "kernel double buffering"@en .

<https://mlsysbook.ai/taxonomy/mlsys.ecc-memory> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Error-correcting code memory"@en ;
  skos:definition "Memory protected by redundant check bits that correct supported error patterns and report detectable uncorrectable errors, reducing the risk of silent corruption."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.ecc-memory> skos:altLabel "ECC"@en .
<https://mlsysbook.ai/taxonomy/mlsys.ecc-memory> skos:altLabel "SECDED"@en .

<https://mlsysbook.ai/taxonomy/mlsys.integer-only-inference> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Integer-only inference"@en ;
  skos:definition "Executing a quantized model with integer arithmetic throughout its operator graph, including accumulation and rescaling, so no floating-point operations are needed at inference time."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.integer-only-inference> skos:altLabel "integer-only quantization"@en .
<https://mlsysbook.ai/taxonomy/mlsys.integer-only-inference> skos:altLabel "fixed-point inference"@en .
<https://mlsysbook.ai/taxonomy/mlsys.integer-only-inference> skos:altLabel "dyadic rescaling"@en .

<https://mlsysbook.ai/taxonomy/mlsys.execute-in-place> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Execute-in-place weights"@en ;
  skos:definition "Reading immutable model weights from memory-mapped flash during inference without first copying them into SRAM, reducing working memory while exposing flash-access latency."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.execute-in-place> skos:altLabel "XIP"@en .
<https://mlsysbook.ai/taxonomy/mlsys.execute-in-place> skos:altLabel "flash-resident weights"@en .

<https://mlsysbook.ai/taxonomy/mlsys.confused-deputy> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Confused deputy"@en ;
  skos:definition "A security failure in which a component uses its legitimate authority for an untrusted party's purpose because it does not distinguish the requester's authority from its own."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.confused-deputy> skos:altLabel "confused deputy attack"@en .
<https://mlsysbook.ai/taxonomy/mlsys.confused-deputy> skos:altLabel "tool privilege misuse"@en .

<https://mlsysbook.ai/taxonomy/mlsys.judge-bias> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model-grader bias"@en ;
  skos:definition "Systematic scoring errors in model-based graders, such as preferences for response position, length, or style, that distort comparisons independently of task quality."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.judge-bias> skos:altLabel "LLM-as-judge bias"@en .
<https://mlsysbook.ai/taxonomy/mlsys.judge-bias> skos:altLabel "position bias"@en .
<https://mlsysbook.ai/taxonomy/mlsys.judge-bias> skos:altLabel "verbosity bias"@en .
<https://mlsysbook.ai/taxonomy/mlsys.judge-bias> skos:altLabel "self-preference bias"@en .

<https://mlsysbook.ai/taxonomy/mlsys.over-refusal> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Over-refusal"@en ;
  skos:definition "Refusing benign requests that resemble harmful ones, the false-positive side of a safety filter or refusal policy, which is traded against missed harmful requests when setting the operating point."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.over-refusal> skos:altLabel "false refusal"@en .
<https://mlsysbook.ai/taxonomy/mlsys.over-refusal> skos:altLabel "exaggerated safety"@en .

<https://mlsysbook.ai/taxonomy/mlsys.coordinate-frames> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Coordinate frames and transforms"@en ;
  skos:definition "Reference frames and the spatial transforms between them that express sensor observations, robot geometry, and actions in consistent coordinates."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.coordinate-frames> skos:altLabel "TF tree"@en .
<https://mlsysbook.ai/taxonomy/mlsys.coordinate-frames> skos:altLabel "rigid-body transforms"@en .
<https://mlsysbook.ai/taxonomy/mlsys.coordinate-frames> skos:altLabel "frame transforms"@en .

<https://mlsysbook.ai/taxonomy/mlsys.sensor-degradation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Sensor degradation"@en ;
  skos:definition "Loss of sensor measurement fidelity under environmental or operating conditions, such as glare, rain, fog, dust, or a dirty lens, that degrades perception even when the sensing hardware has not failed."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.sensor-degradation> skos:altLabel "sensor occlusion"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sensor-degradation> skos:altLabel "adverse-weather degradation"@en .
<https://mlsysbook.ai/taxonomy/mlsys.sensor-degradation> skos:altLabel "perceptual degradation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.data-curriculum> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Data curriculum and annealing"@en ;
  skos:definition "Changing the training data distribution over a run, such as raising the share of high-quality or long-sequence data during the final learning-rate decay, to improve final capability per unit of compute."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.data-curriculum> skos:altLabel "curriculum learning"@en .
<https://mlsysbook.ai/taxonomy/mlsys.data-curriculum> skos:altLabel "data annealing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.data-curriculum> skos:altLabel "sequence-length warmup"@en .

<https://mlsysbook.ai/taxonomy/mlsys.streaming-dataset-format> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Sharded streaming dataset format"@en ;
  skos:definition "Organizing training examples into sequentially readable shard files so workers can stream records from remote storage with few small-object reads and bounded local staging."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.streaming-dataset-format> skos:altLabel "shard streaming"@en .
<https://mlsysbook.ai/taxonomy/mlsys.streaming-dataset-format> skos:altLabel "WebDataset-style shards"@en .

<https://mlsysbook.ai/taxonomy/mlsys.collective-algorithm-selection> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Collective algorithm selection"@en ;
  skos:definition "Choosing, per call, among collective algorithms (ring, tree, switch-offloaded) and wire protocols by message size, participant count, and link hierarchy, to minimize latency for small messages and maximize bandwidth for large ones."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.collective-algorithm-selection> skos:altLabel "collective protocol selection"@en .
<https://mlsysbook.ai/taxonomy/mlsys.collective-algorithm-selection> skos:altLabel "ring versus tree crossover"@en .

<https://mlsysbook.ai/taxonomy/mlsys.always-on-cascade> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Always-on sensing cascade"@en ;
  skos:definition "Using a low-power sensing or inference stage to wake a more expensive stage only when needed, cutting continuous-monitoring energy at the risk of missed triggers and wake latency."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.always-on-cascade> skos:altLabel "wake-word cascade"@en .
<https://mlsysbook.ai/taxonomy/mlsys.always-on-cascade> skos:altLabel "sensor-hub gating"@en .

<https://mlsysbook.ai/taxonomy/mlsys.fault-tree-analysis> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Fault tree analysis"@en ;
  skos:definition "Top-down hazard analysis that decomposes an undesired top event into Boolean combinations of contributing faults, so minimal cut sets and their probabilities can be computed."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.fault-tree-analysis> skos:altLabel "FTA"@en .

<https://mlsysbook.ai/taxonomy/mlsys.metastable-failure> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Metastable failure"@en ;
  skos:definition "A state in which a transient trigger, such as a load spike or slowdown, starts a self-sustaining loop of retries, cache misses, or timeouts that keeps a system overloaded after the trigger is gone."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.metastable-failure> skos:altLabel "metastability"@en .
<https://mlsysbook.ai/taxonomy/mlsys.metastable-failure> skos:altLabel "self-sustaining overload"@en .

<https://mlsysbook.ai/taxonomy/mlsys.fan-out-tail-amplification> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Fan-out tail amplification"@en ;
  skos:definition "The growth in a request's latency tail when it waits on many parallel subrequests, because the chance that at least one subrequest is slow rises with the fan-out."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.fan-out-tail-amplification> skos:altLabel "tail at scale"@en .

<https://mlsysbook.ai/taxonomy/mlsys.proxy-discrimination> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Proxy discrimination"@en ;
  skos:definition "Decisions driven by features that encode protected-group membership, so group disparities persist even when the protected attribute itself is omitted."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.proxy-discrimination> skos:altLabel "redundant encoding"@en .
<https://mlsysbook.ai/taxonomy/mlsys.proxy-discrimination> skos:altLabel "proxy variables"@en .

<https://mlsysbook.ai/taxonomy/mlsys.cross-embodiment-training> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Cross-embodiment training"@en ;
  skos:definition "Training one policy across datasets from several robot embodiments, aligning observations and action interfaces so learning is shared despite differences in sensors and control."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.cross-embodiment-training> skos:altLabel "cross-embodiment pretraining"@en .
<https://mlsysbook.ai/taxonomy/mlsys.cross-embodiment-training> skos:altLabel "multi-robot data pooling"@en .

<https://mlsysbook.ai/taxonomy/mlsys.dual-rate-hierarchical-policy> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Dual-rate hierarchical policy"@en ;
  skos:definition "Splitting a robot policy into a slow high-level model that sets goals or latent commands and a fast low-level controller that tracks them at control rate, so large-model latency does not set the control loop's rate."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.dual-rate-hierarchical-policy> skos:altLabel "slow-fast policy"@en .
<https://mlsysbook.ai/taxonomy/mlsys.dual-rate-hierarchical-policy> skos:altLabel "high-level and low-level policy"@en .
<https://mlsysbook.ai/taxonomy/mlsys.dual-rate-hierarchical-policy> skos:altLabel "System 1 / System 2 control"@en .

<https://mlsysbook.ai/taxonomy/mlsys.robot-kinematics> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Robot kinematics"@en ;
  skos:definition "The geometric mapping between joint positions and velocities and the pose and velocity of a robot's links and end effector, including inverse solutions and singular configurations where motion authority is lost."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.robot-kinematics> skos:altLabel "forward kinematics"@en .
<https://mlsysbook.ai/taxonomy/mlsys.robot-kinematics> skos:altLabel "inverse kinematics"@en .
<https://mlsysbook.ai/taxonomy/mlsys.robot-kinematics> skos:altLabel "manipulator Jacobian"@en .

<https://mlsysbook.ai/taxonomy/mlsys.quantization-granularity> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Quantization granularity"@en ;
  skos:definition "The grouping of values that share quantization parameters, such as a scale and an optional zero point, from per tensor to per channel to small groups, trading approximation error against metadata and kernel cost."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.quantization-granularity> skos:altLabel "per-tensor quantization"@en .
<https://mlsysbook.ai/taxonomy/mlsys.quantization-granularity> skos:altLabel "per-channel quantization"@en .
<https://mlsysbook.ai/taxonomy/mlsys.quantization-granularity> skos:altLabel "group-wise quantization"@en .

<https://mlsysbook.ai/taxonomy/mlsys.agent-training-environment> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Agent training environment"@en ;
  skos:definition "A task system that supplies observations, accepts actions, and manages episode state for training tool-using policies, whose throughput and reset fidelity limit rollout collection."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.agent-training-environment> skos:altLabel "agent rollout environment"@en .
<https://mlsysbook.ai/taxonomy/mlsys.agent-training-environment> skos:altLabel "agentic RL environment"@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-directed-control-flow> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model-directed control flow"@en ;
  skos:definition "A control structure in which model outputs select the next step, tool call, or stopping decision within runtime-enforced limits, increasing flexibility while making cost and behavior harder to predict and test."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-directed-control-flow> skos:altLabel "agent autonomy level"@en .

<https://mlsysbook.ai/taxonomy/mlsys.misuse-monitoring> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Misuse monitoring"@en ;
  skos:definition "Detecting policy-violating use of a deployed model across requests, sessions, and accounts, such as coordinated abuse or capability probing, and responding with throttling, review, or account action."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.misuse-monitoring> skos:altLabel "abuse detection"@en .
<https://mlsysbook.ai/taxonomy/mlsys.misuse-monitoring> skos:altLabel "usage-policy enforcement"@en .
<https://mlsysbook.ai/taxonomy/mlsys.misuse-monitoring> skos:altLabel "trust and safety monitoring"@en .

<https://mlsysbook.ai/taxonomy/mlsys.masked-diffusion-decoding> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Masked diffusion decoding"@en ;
  skos:definition "Generating text by repeatedly predicting and committing masked positions in parallel, trading refinement passes for token parallelism while weakening the attention-state reuse that autoregressive decoding relies on."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.masked-diffusion-decoding> skos:altLabel "masked diffusion language decoding"@en .
<https://mlsysbook.ai/taxonomy/mlsys.masked-diffusion-decoding> skos:altLabel "parallel masked-token decoding"@en .

<https://mlsysbook.ai/taxonomy/mlsys.residual-connection> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Residual connection"@en ;
  skos:definition "A connection that adds a block's input, or a projection of it, to the block's output, so information and gradients can bypass the block and deep stacks stay trainable."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.residual-connection> skos:altLabel "additive skip connection"@en .

<https://mlsysbook.ai/taxonomy/mlsys.multi-task-learning> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Multi-task learning"@en ;
  skos:definition "Jointly learning several tasks through shared parameters, often a shared backbone with task-specific heads, so their training signals can help or interfere with one another."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.multi-task-learning> skos:altLabel "multitask learning"@en .
<https://mlsysbook.ai/taxonomy/mlsys.multi-task-learning> skos:altLabel "shared-backbone multi-task model"@en .

<https://mlsysbook.ai/taxonomy/mlsys.recovery-objectives> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Recovery time and point objectives"@en ;
  skos:definition "Stated limits on how long restoring service may take (RTO) and how far recovered state may lag the state before the failure (RPO), which constrain checkpointing, replication, and failover design."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.recovery-objectives> skos:altLabel "RTO"@en .
<https://mlsysbook.ai/taxonomy/mlsys.recovery-objectives> skos:altLabel "RPO"@en .
<https://mlsysbook.ai/taxonomy/mlsys.recovery-objectives> skos:altLabel "recovery time objective"@en .
<https://mlsysbook.ai/taxonomy/mlsys.recovery-objectives> skos:altLabel "recovery point objective"@en .
<https://mlsysbook.ai/taxonomy/mlsys.recovery-objectives> skos:altLabel "recovery time accounting"@en .

<https://mlsysbook.ai/taxonomy/mlsys.incremental-checkpointing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Incremental checkpointing"@en ;
  skos:definition "Persisting only the state that changed since the preceding checkpoint, with periodic full checkpoints as bases, which cuts write volume when updates are sparse at the cost of reconstructing state from a chain on restore."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.incremental-checkpointing> skos:altLabel "delta checkpoint"@en .

<https://mlsysbook.ai/taxonomy/mlsys.multiple-comparisons> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Multiple comparisons correction"@en ;
  skos:definition "Adjusting significance thresholds when many hypotheses, metrics, or slices are tested together, so the chance of a false declared effect, by family-wise error or false discovery rate, stays controlled."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.multiple-comparisons> skos:altLabel "multiple hypothesis testing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.multiple-comparisons> skos:altLabel "multiplicity correction"@en .
<https://mlsysbook.ai/taxonomy/mlsys.multiple-comparisons> skos:altLabel "Bonferroni correction"@en .
<https://mlsysbook.ai/taxonomy/mlsys.multiple-comparisons> skos:altLabel "Benjamini-Hochberg procedure"@en .

<https://mlsysbook.ai/taxonomy/mlsys.model-assisted-labeling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Model-assisted labeling"@en ;
  skos:definition "Using a model's predictions as draft labels that annotators accept or correct, which raises labeling throughput but can anchor annotators to the model's errors."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-assisted-labeling> skos:altLabel "pre-labeling"@en .
<https://mlsysbook.ai/taxonomy/mlsys.model-assisted-labeling> skos:altLabel "model-in-the-loop annotation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.forward-error-correction> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Forward error correction"@en ;
  skos:definition "Adding redundant bits to transmitted data so the receiver corrects supported error patterns without retransmission, at the cost of coding overhead and decoding delay."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.forward-error-correction> skos:altLabel "FEC"@en .
<https://mlsysbook.ai/taxonomy/mlsys.forward-error-correction> skos:altLabel "link-layer FEC"@en .

<https://mlsysbook.ai/taxonomy/mlsys.erasure-coding> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Erasure coding"@en ;
  skos:definition "Encoding stored data into data and parity fragments so it can be reconstructed after a bounded number of fragment losses, trading storage overhead against encoding and recovery work."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.erasure-coding> skos:altLabel "Reed-Solomon coding"@en .
<https://mlsysbook.ai/taxonomy/mlsys.erasure-coding> skos:altLabel "erasure-coded storage"@en .

<https://mlsysbook.ai/taxonomy/mlsys.bandwidth-delay-product> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Bandwidth-delay product"@en ;
  skos:definition "A path's bottleneck bandwidth times its round-trip time, the amount of outstanding data a window-controlled flow must sustain to keep the path full."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.bandwidth-delay-product> skos:altLabel "BDP"@en .

<https://mlsysbook.ai/taxonomy/mlsys.backfill-scheduling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Backfill scheduling"@en ;
  skos:definition "Running lower-priority jobs in idle resource-time gaps without delaying the reserved start of a higher-priority job, which raises cluster utilization."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.backfill-scheduling> skos:altLabel "backfilling"@en .
<https://mlsysbook.ai/taxonomy/mlsys.backfill-scheduling> skos:altLabel "EASY backfilling"@en .

<https://mlsysbook.ai/taxonomy/mlsys.traffic-classes> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Network traffic classes and QoS"@en ;
  skos:definition "Classifying traffic on a shared network into separately scheduled queues with configured priorities or bandwidth shares, limiting interference between collective, storage, and control traffic."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.traffic-classes> skos:altLabel "quality of service"@en .
<https://mlsysbook.ai/taxonomy/mlsys.traffic-classes> skos:altLabel "traffic class isolation"@en .

<https://mlsysbook.ai/taxonomy/mlsys.telemetry-sampling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Telemetry sampling and cardinality control"@en ;
  skos:definition "Choosing which traces, events, and metric label combinations to keep, by sampling and by bounding or aggregating label values, so fleet telemetry stays affordable at the risk of losing rare failures and fine-grained detail."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.telemetry-sampling> skos:altLabel "trace sampling"@en .
<https://mlsysbook.ai/taxonomy/mlsys.telemetry-sampling> skos:altLabel "tail-based sampling"@en .
<https://mlsysbook.ai/taxonomy/mlsys.telemetry-sampling> skos:altLabel "metric cardinality management"@en .

<https://mlsysbook.ai/taxonomy/mlsys.dma-cache-maintenance> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "DMA cache maintenance"@en ;
  skos:definition "Cleaning and invalidating processor caches around DMA transfers on hardware without coherent DMA, with buffers aligned to cache lines, so a device and the CPU do not read stale copies of a shared buffer; each maintenance step adds latency."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.dma-cache-maintenance> skos:altLabel "cache clean and invalidate for DMA"@en .
<https://mlsysbook.ai/taxonomy/mlsys.dma-cache-maintenance> skos:altLabel "DMA buffer synchronization"@en .

<https://mlsysbook.ai/taxonomy/mlsys.expert-offloading> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Expert offloading"@en ;
  skos:definition "Keeping some mixture-of-experts weights in host memory or storage and fetching the experts a batch needs into accelerator memory, often prefetching predicted ones, which lets a model larger than accelerator memory run at the cost of transfers."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.expert-offloading> skos:altLabel "MoE expert offloading"@en .
<https://mlsysbook.ai/taxonomy/mlsys.expert-offloading> skos:altLabel "expert-weight offloading"@en .

<https://mlsysbook.ai/taxonomy/mlsys.variable-length-parallelism> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Variable-length parallelism planning"@en ;
  skos:definition "Choosing, for each training step, sequence or context parallel degrees and how packed documents are sharded across ranks from that step's sequence lengths and attention patterns, so ranks receive balanced attention work."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.variable-length-parallelism> skos:altLabel "dynamic context parallelism"@en .
<https://mlsysbook.ai/taxonomy/mlsys.variable-length-parallelism> skos:altLabel "workload-balanced sequence parallelism"@en .

<https://mlsysbook.ai/taxonomy/mlsys.fine-grained-accelerator-sharing> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Fine-grained accelerator sharing"@en ;
  skos:definition "Scheduling co-located workloads on one accelerator in small units of a kernel, so latency-sensitive work can preempt background work quickly and interference stays bounded."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.fine-grained-accelerator-sharing> skos:altLabel "sub-kernel GPU sharing"@en .
<https://mlsysbook.ai/taxonomy/mlsys.fine-grained-accelerator-sharing> skos:altLabel "kernel-slice preemption"@en .

<https://mlsysbook.ai/taxonomy/mlsys.intra-device-overlap> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Intra-device overlap of bottlenecks"@en ;
  skos:definition "Scheduling generative-inference operations with complementary compute, memory, or communication demands concurrently on one accelerator, using small batches or fused kernels so several hardware resources stay busy together."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.intra-device-overlap> skos:altLabel "nano-batching"@en .
<https://mlsysbook.ai/taxonomy/mlsys.intra-device-overlap> skos:altLabel "intra-device operation overlap"@en .

<https://mlsysbook.ai/taxonomy/mlsys.graph-pipeline-parallelism> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Graph pipeline parallelism"@en ;
  skos:definition "Pipeline parallelism that partitions a model whose layers form a branching graph into stages that follow the graph, so independent branches, such as separate modality encoders, run concurrently in parallel stages instead of being serialized into one chain."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.graph-pipeline-parallelism> skos:altLabel "branch-parallel pipelining"@en .
<https://mlsysbook.ai/taxonomy/mlsys.graph-pipeline-parallelism> skos:altLabel "multi-branch pipeline scheduling"@en .

<https://mlsysbook.ai/taxonomy/mlsys.rag-pipeline-scheduling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "RAG pipeline scheduling"@en ;
  skos:definition "Coordinating the retrieval and generation work of retrieval-augmented requests across requests and processors, overlapping and batching work across the stage boundary and optionally adapting retrieval settings per query, to meet latency and answer-quality targets."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.rag-pipeline-scheduling> skos:altLabel "retrieval-generation co-scheduling"@en .

<https://mlsysbook.ai/taxonomy/mlsys.cross-stack-profiling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/mlsysbook-taxonomy> ;
  skos:prefLabel "Cross-stack profiling"@en ;
  skos:definition "Profiling that correlates timestamped events and calling contexts from model code, frameworks, native libraries, and accelerator kernels, so that device time and stalls can be attributed to the operations that launched them."@en ;
  skos:editorialNote "Draft concept."@en .
<https://mlsysbook.ai/taxonomy/mlsys.cross-stack-profiling> skos:altLabel "framework-to-kernel attribution"@en .
<https://mlsysbook.ai/taxonomy/mlsys.cross-stack-profiling> skos:altLabel "host-device trace correlation"@en .
