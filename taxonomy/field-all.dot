digraph concepts {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.85", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#88949d", penwidth=1.15, fontname="Helvetica Neue", fontsize=16, margin="0.18,0.12"];
edge [fontname="Helvetica Neue", fontsize=12, color="#7a858e", fontcolor="#47535d", arrowsize=0.65];
graph [rankdir=LR];
graph [pack=true, packmode="array_u3"];
"mlsys.requirements" [id="concept-mlsys.requirements", label="System requirements", tooltip="Measurable desired behavior and constraints for a specified workload."];
"mlsys.baseline" [id="concept-mlsys.baseline", label="Baseline", tooltip="A reference method or system used to justify the value of a proposed change."];
"mlsys.proxy-objective" [id="concept-mlsys.proxy-objective", label="Proxy objective", tooltip="A measurable target used in place of the outcome actually desired."];
"mlsys.slo" [id="concept-mlsys.slo", label="Service-level objective", tooltip="A target for a defined service measure over a specified population and window."];
"mlsys.workload" [id="concept-mlsys.workload", label="Workload\ncharacterization", tooltip="The input, request, model, and execution distributions that a system must support."];
"mlsys.placement" [id="concept-mlsys.placement", label="Execution placement", tooltip="The choice of where system components execute, such as device, edge, or datacenter."];
"mlsys.data-quality" [id="concept-mlsys.data-quality", label="Data quality", tooltip="Fitness of recorded examples for the intended task, including validity, coverage, and error."];
"mlsys.data-acquisition" [id="concept-mlsys.data-acquisition", label="Data acquisition and\nsampling", tooltip="The observation and selection process that determines which examples and populations enter a dataset."];
"mlsys.features" [id="concept-mlsys.features", label="Feature engineering", tooltip="Constructing model inputs whose semantics and availability match the task."];
"mlsys.missing-data" [id="concept-mlsys.missing-data", label="Missing data", tooltip="Absent observations whose pattern and treatment can change learned behavior."];
"mlsys.leakage" [id="concept-mlsys.leakage", label="Data leakage", tooltip="Information unavailable at the intended prediction boundary entering development or evaluation."];
"mlsys.point-in-time" [id="concept-mlsys.point-in-time", label="Point-in-time\ncorrectness", tooltip="Constructing examples using only information available at their stated prediction time."];
"mlsys.lineage" [id="concept-mlsys.lineage", label="Data lineage", tooltip="Recorded dependencies that identify the sources and transformations of a dataset or artifact."];
"mlsys.train-serve-skew" [id="concept-mlsys.train-serve-skew", label="Training-serving skew", tooltip="A mismatch between the data transformations or feature semantics used in training and serving."];
"mlsys.data-selection" [id="concept-mlsys.data-selection", label="Data selection", tooltip="Allocating learning effort to examples according to value, coverage, and acquisition cost."];
"mlsys.deduplication" [id="concept-mlsys.deduplication", label="Dataset deduplication", tooltip="Finding and managing exact or near-duplicate examples within a corpus and overlaps with evaluation data to control sample weighting, redundant compute, memorization, and contamination."];
"mlsys.embeddings" [id="concept-mlsys.embeddings", label="Embeddings", tooltip="Vector representations of tokens, items, or inputs, learned or constructed, whose dimension and lookup or encoder implementation determine storage and computation costs."];
"mlsys.distribution-shift" [id="concept-mlsys.distribution-shift", label="Distribution shift", tooltip="A difference between development and deployment data-generating distributions."];
"mlsys.linear-model" [id="concept-mlsys.linear-model", label="Linear models", tooltip="Models whose score is linear in their supplied features, with a possible output link function."];
"mlsys.tree-ensemble" [id="concept-mlsys.tree-ensemble", label="Tree ensembles", tooltip="Collections of decision trees whose branch traversal and aggregation determine predictions."];
"mlsys.kernel-method" [id="concept-mlsys.kernel-method", label="Kernel methods", tooltip="Models that score an input by a kernel similarity to retained training examples or to an explicit feature approximation, so storage and evaluation cost grow with the number of retained examples unless the kernel is approximated."];
"mlsys.nearest-neighbor" [id="concept-mlsys.nearest-neighbor", label="Nearest-neighbor models", tooltip="Predictions or retrieval based on similarity to stored examples or vectors."];
"mlsys.neural-network" [id="concept-mlsys.neural-network", label="Neural networks", tooltip="Parameterized compositions of differentiable operations used to learn representations and predictions."];
"mlsys.inductive-bias" [id="concept-mlsys.inductive-bias", label="Inductive bias", tooltip="Structural assumptions that favor some learned functions over others."];
"mlsys.attention" [id="concept-mlsys.attention", label="Attention", tooltip="Input-dependent aggregation of value vectors using query-key compatibility scores."];
"mlsys.position-encoding" [id="concept-mlsys.position-encoding", label="Position encoding", tooltip="Representations that make sequence position available to a model."];
"mlsys.tokenization" [id="concept-mlsys.tokenization", label="Tokenization", tooltip="Mapping text into vocabulary-dependent token identifiers, which sets sequence lengths and so influences context usage, embedding size, and processing cost."];
"mlsys.loss" [id="concept-mlsys.loss", label="Training loss", tooltip="A computable criterion optimized on training examples."];
"mlsys.autodiff" [id="concept-mlsys.autodiff", label="Automatic\ndifferentiation", tooltip="Computing derivatives by composing local derivative rules through an execution graph."];
"mlsys.optimizer" [id="concept-mlsys.optimizer", label="Optimization algorithm", tooltip="A rule that uses training information to update model parameters and optimizer state."];
"mlsys.regularization" [id="concept-mlsys.regularization", label="Regularization", tooltip="Constraints or training procedures used to control sensitivity and generalization behavior."];
"mlsys.batch-size" [id="concept-mlsys.batch-size", label="Training batch size", tooltip="The number of examples contributing to an optimization update or microstep."];
"mlsys.training-state" [id="concept-mlsys.training-state", label="Training state", tooltip="The parameters, gradients, optimizer variables, and other state needed to continue training."];
"mlsys.activation-recompute" [id="concept-mlsys.activation-recompute", label="Activation\nrecomputation", tooltip="Recreating forward intermediates during backward execution to reduce retained memory."];
"mlsys.scaling-laws" [id="concept-mlsys.scaling-laws", label="Empirical scaling laws", tooltip="Fitted relationships between resources, data, model size, and observed model performance."];
"mlsys.hyperparameter-search" [id="concept-mlsys.hyperparameter-search", label="Hyperparameter search", tooltip="Choosing model or training settings through a sequence of evaluations."];
"mlsys.experiment-budget" [id="concept-mlsys.experiment-budget", label="Experiment-budget\nallocation", tooltip="Dividing a finite evaluation budget across configurations, repetitions, and fidelities."];
"mlsys.transfer-learning" [id="concept-mlsys.transfer-learning", label="Transfer learning", tooltip="Adapting representations or parameters learned from one setting to another."];
"mlsys.peft" [id="concept-mlsys.peft", label="Parameter-efficient\nadaptation", tooltip="Adapting a model by changing a limited parameter subset or added parameterization."];
"mlsys.tensor-layout" [id="concept-mlsys.tensor-layout", label="Tensor layout", tooltip="The mapping from tensor indices to storage locations, including strides and materialization."];
"mlsys.matrix-multiply" [id="concept-mlsys.matrix-multiply", label="Matrix multiplication", tooltip="The dense product of two matrices, a central arithmetic workload in many neural networks, whose operand shapes, tiling, and precision determine execution cost on a specified processor."];
"mlsys.precision" [id="concept-mlsys.precision", label="Numerical precision", tooltip="The representable values and arithmetic behavior of a numerical format."];
"mlsys.mixed-precision" [id="concept-mlsys.mixed-precision", label="Mixed-precision\ntraining", tooltip="Training with multiple numerical formats and explicit handling of their range and accumulation behavior."];
"mlsys.numerical-stability" [id="concept-mlsys.numerical-stability", label="Numerical stability", tooltip="Sensitivity of a computed result to finite-precision operations and intermediate representations."];
"mlsys.quantization" [id="concept-mlsys.quantization", label="Quantization", tooltip="Representing values using a reduced discrete set with a specified encoding and approximation rule."];
"mlsys.sparsity" [id="concept-mlsys.sparsity", label="Sparsity", tooltip="A pattern of absent or zero values whose execution benefit depends on representation and support."];
"mlsys.distillation" [id="concept-mlsys.distillation", label="Knowledge distillation", tooltip="Training a student to match output distributions or internal signals from a teacher model or ensemble, potentially reducing serving cost when the student is cheaper while requiring validation of retained quality."];
"mlsys.compilation" [id="concept-mlsys.compilation", label="Graph compilation", tooltip="Transforming a model or execution graph into an executable representation."];
"mlsys.fusion" [id="concept-mlsys.fusion", label="Kernel fusion", tooltip="Combining compatible operations to reduce intermediate materialization or dispatch."];
"mlsys.dispatch" [id="concept-mlsys.dispatch", label="Host dispatch overhead", tooltip="Host-side work required to launch or orchestrate device operations."];
"mlsys.memory-hierarchy" [id="concept-mlsys.memory-hierarchy", label="Memory hierarchy", tooltip="Arrangement of storage levels and transfer paths with differing capacity, latency, bandwidth, access control, and management mechanisms. The available levels depend on the platform."];
"mlsys.memory-capacity" [id="concept-mlsys.memory-capacity", label="Memory capacity", tooltip="Available storage for concurrently resident state and intermediates."];
"mlsys.accelerator-execution-architecture" [id="concept-mlsys.accelerator-execution-architecture", label="Accelerator execution\narchitecture", tooltip="Organization of arithmetic units, execution lanes or threads, scheduling resources, and local storage that determines how supported operations run. SIMD/SIMT, matrix units, and systolic arrays are distinct examples."];
"mlsys.arithmetic-intensity" [id="concept-mlsys.arithmetic-intensity", label="Arithmetic intensity", tooltip="Arithmetic work per byte transferred at a specified memory boundary."];
"mlsys.roofline" [id="concept-mlsys.roofline", label="Roofline bound", tooltip="A performance bound combining a compute ceiling with an intensity-dependent bandwidth ceiling."];
"mlsys.locality" [id="concept-mlsys.locality", label="Data locality", tooltip="Reuse of data near its consumers across time or execution locations."];
"mlsys.tiling" [id="concept-mlsys.tiling", label="Tiling", tooltip="Partitioning computation so working data can be reused within a chosen storage level."];
"mlsys.profiling" [id="concept-mlsys.profiling", label="Profiling", tooltip="Measuring execution to attribute time, work, stalls, and resource use."];
"mlsys.execution-time" [id="concept-mlsys.execution-time", label="Execution time", tooltip="Elapsed time for a specified execution boundary, workload, and operating condition."];
"mlsys.serial-fraction" [id="concept-mlsys.serial-fraction", label="Serial fraction", tooltip="The portion of execution that a proposed parallel or accelerated transformation leaves unchanged."];
"mlsys.collectives" [id="concept-mlsys.collectives", label="Collective\ncommunication", tooltip="Coordinated data exchange and reduction across a process group."];
"mlsys.data-parallel" [id="concept-mlsys.data-parallel", label="Data parallelism", tooltip="Executing model replicas on different examples while coordinating learning state."];
"mlsys.tensor-parallel" [id="concept-mlsys.tensor-parallel", label="Tensor parallelism", tooltip="Partitioning a layer's tensors and operations across devices so each computes a slice, reducing per-device state while adding communication along the partitioned dimensions, usually within a fast scale-up domain."];
"mlsys.pipeline-parallel" [id="concept-mlsys.pipeline-parallel", label="Pipeline parallelism", tooltip="Partitioning a computation into stages that process different microbatches concurrently."];
"mlsys.state-sharding" [id="concept-mlsys.state-sharding", label="Training-state sharding", tooltip="Partitioning parameters, gradients, or optimizer state across workers."];
"mlsys.communication-overlap" [id="concept-mlsys.communication-overlap", label="Communication overlap", tooltip="Scheduling communication concurrently with independent computation."];
"mlsys.network-topology" [id="concept-mlsys.network-topology", label="Network topology", tooltip="The connectivity and capacity structure that constrains communication paths."];
"mlsys.stragglers" [id="concept-mlsys.stragglers", label="Stragglers", tooltip="Workers or tasks whose delayed completion holds back coordinated work."];
"mlsys.checkpoint" [id="concept-mlsys.checkpoint", label="Recovery checkpoint", tooltip="A persisted state from which a specified computation can resume."];
"mlsys.consistent-cut" [id="concept-mlsys.consistent-cut", label="Consistent checkpoint\ncut", tooltip="A set of per-worker checkpoint states taken so that no saved state depends on an update or message that another worker's saved state has not yet recorded, so restoring all of them together yields one coherent global state."];
"mlsys.consensus" [id="concept-mlsys.consensus", label="Replicated-log\nconsensus", tooltip="Agreement on an ordered state history under specified timing and failure assumptions."];
"mlsys.fencing" [id="concept-mlsys.fencing", label="Fencing", tooltip="Rejecting effects from an actor whose epoch or authority is stale."];
"mlsys.federated-learning" [id="concept-mlsys.federated-learning", label="Federated learning", tooltip="Coordinating model learning across separately controlled data holders."];
"mlsys.arrival-rate" [id="concept-mlsys.arrival-rate", label="Arrival rate", tooltip="The frequency and distribution of requests reaching a service boundary."];
"mlsys.service-capacity" [id="concept-mlsys.service-capacity", label="Service capacity", tooltip="The completion rate supported by a service under a stated workload and operating point."];
"mlsys.queueing" [id="concept-mlsys.queueing", label="Queueing delay", tooltip="Time a request waits for a resource before receiving service."];
"mlsys.tail-latency" [id="concept-mlsys.tail-latency", label="Tail latency", tooltip="A high quantile of a defined request-latency distribution."];
"mlsys.batching" [id="concept-mlsys.batching", label="Request batching", tooltip="Executing requests together to share work or improve resource use."];
"mlsys.admission" [id="concept-mlsys.admission", label="Admission control", tooltip="Accepting, delaying, or rejecting work according to capacity, policy, and service constraints."];
"mlsys.autoscaling" [id="concept-mlsys.autoscaling", label="Autoscaling", tooltip="Changing provisioned service resources in response to measured or predicted demand."];
"mlsys.kv-cache" [id="concept-mlsys.kv-cache", label="KV cache", tooltip="Retained attention keys and values reused during autoregressive execution."];
"mlsys.prefill-decode" [id="concept-mlsys.prefill-decode", label="Prefill and decode", tooltip="The prompt-processing and incremental token-generation phases of autoregressive inference."];
"mlsys.paged-kv" [id="concept-mlsys.paged-kv", label="Paged KV allocation", tooltip="Managing attention state in blocks to reduce allocation waste and support sharing."];
"mlsys.prefix-cache" [id="concept-mlsys.prefix-cache", label="Prefix caching", tooltip="Reusing compatible computed state for an identical request prefix."];
"mlsys.speculative-decoding" [id="concept-mlsys.speculative-decoding", label="Speculative decoding", tooltip="Using proposed tokens and a validating procedure to accelerate generation while preserving a specified output distribution."];
"mlsys.slo-goodput" [id="concept-mlsys.slo-goodput", label="SLO goodput", tooltip="The rate of useful completed work that satisfies the specified quality and service criteria."];
"mlsys.generalization" [id="concept-mlsys.generalization", label="Generalization", tooltip="Performance on relevant examples or conditions beyond those used to fit the system."];
"mlsys.evaluation-split" [id="concept-mlsys.evaluation-split", label="Evaluation split", tooltip="A partitioning protocol that separates learning, selection, and final assessment."];
"mlsys.selection-bias" [id="concept-mlsys.selection-bias", label="Model-selection\noptimism", tooltip="Overstated performance caused by choosing a winner using noisy evaluation results."];
"mlsys.metrics" [id="concept-mlsys.metrics", label="Evaluation metrics", tooltip="Specified measurements of predictive or task behavior, with explicit populations and aggregation."];
"mlsys.calibration" [id="concept-mlsys.calibration", label="Probability calibration", tooltip="Agreement between predicted probabilities and observed event frequencies under an evaluation distribution."];
"mlsys.statistical-uncertainty" [id="concept-mlsys.statistical-uncertainty", label="Statistical uncertainty", tooltip="Uncertainty in an estimated quantity due to finite and dependent observations."];
"mlsys.benchmark" [id="concept-mlsys.benchmark", label="Benchmark protocol", tooltip="A reproducible specification of workload, measurement boundary, run rules, and comparison procedure that lets results from different systems be compared and lets a system be judged against a baseline."];
"mlsys.online-experiment" [id="concept-mlsys.online-experiment", label="Online experimentation", tooltip="A controlled intervention used to estimate effects on deployed-system outcomes."];
"mlsys.sliced-evaluation" [id="concept-mlsys.sliced-evaluation", label="Sliced evaluation", tooltip="Measuring behavior separately on relevant populations, conditions, or workload groups."];
"mlsys.selective-prediction" [id="concept-mlsys.selective-prediction", label="Selective prediction", tooltip="Decision-gating mechanism that emits model outputs only for admitted cases and abstains on or defers the remaining cases."];
"mlsys.artifact-version" [id="concept-mlsys.artifact-version", label="Artifact versioning", tooltip="Identifying the exact model, code, data, configuration, and dependencies in an execution or release."];
"mlsys.monitoring" [id="concept-mlsys.monitoring", label="Production monitoring", tooltip="Collecting and interpreting signals about deployed system behavior and health."];
"mlsys.rollout" [id="concept-mlsys.rollout", label="Staged rollout", tooltip="Increasing exposure to a candidate system through bounded release stages."];
"mlsys.rollback" [id="concept-mlsys.rollback", label="Rollback", tooltip="Returning to a previously accepted deployment configuration with compatible state."];
"mlsys.concept-drift" [id="concept-mlsys.concept-drift", label="Concept drift", tooltip="Change over time in the relationship between inputs and targets, so the same input warrants a different prediction."];
"mlsys.delayed-outcomes" [id="concept-mlsys.delayed-outcomes", label="Delayed outcomes", tooltip="Target outcomes that become observable only after a delay or for a selected subset of cases."];
"mlsys.incident-response" [id="concept-mlsys.incident-response", label="Incident response", tooltip="Detecting, containing, diagnosing, and recovering from unexpected system behavior."];
"mlsys.observability" [id="concept-mlsys.observability", label="System observability", tooltip="Instrumentation that permits investigation of internal execution from recorded outputs, traces, and metrics."];
"mlsys.threat-model" [id="concept-mlsys.threat-model", label="Threat modeling", tooltip="Specifying adversaries, assets, interfaces, capabilities, and failure consequences."];
"mlsys.poisoning" [id="concept-mlsys.poisoning", label="Data poisoning", tooltip="Adversarial manipulation of learning data or signals to alter learned behavior."];
"mlsys.evasion" [id="concept-mlsys.evasion", label="Adversarial evasion", tooltip="Inputs chosen or perturbed at inference time so that a model misclassifies or misbehaves, within an adversary's stated knowledge of the model and perturbation budget, without any change to the model or its training data."];
"mlsys.privacy" [id="concept-mlsys.privacy", label="Privacy requirements", tooltip="Requirements governing the collection, use, retention, and disclosure of information about people or records."];
"mlsys.differential-privacy" [id="concept-mlsys.differential-privacy", label="Differential privacy", tooltip="A parameterized bound on changes in output distributions under a specified neighboring-dataset relation."];
"mlsys.fairness" [id="concept-mlsys.fairness", label="Fairness criteria", tooltip="Explicit requirements for how system outcomes or errors are distributed across affected groups."];
"mlsys.authorization" [id="concept-mlsys.authorization", label="Authorization", tooltip="Determining whether an actor may perform a specified action on a resource."];
"mlsys.isolation" [id="concept-mlsys.isolation", label="Execution isolation", tooltip="Restricting which resources and effects a computation can access."];
"mlsys.human-oversight" [id="concept-mlsys.human-oversight", label="Human oversight", tooltip="An arrangement in which people can understand, intervene in, and contest consequential system behavior."];
"mlsys.energy" [id="concept-mlsys.energy", label="Operating energy", tooltip="Energy consumed by a specified system boundary over a defined workload or interval."];
"mlsys.carbon" [id="concept-mlsys.carbon", label="Lifecycle carbon", tooltip="Emissions attributed to operation and embodied system resources under declared accounting boundaries."];
"mlsys.unit-cost" [id="concept-mlsys.unit-cost", label="Cost per useful outcome", tooltip="Total relevant expenditure divided by outcomes meeting a specified acceptance criterion."];
"mlsys.capacity-planning" [id="concept-mlsys.capacity-planning", label="Capacity planning", tooltip="Provisioning resources for a workload distribution and service objectives."];
"mlsys.trajectory" [id="concept-mlsys.trajectory", label="Agent trajectory", tooltip="A sequence of observations, model proposals, tool actions, and external outcomes for a task."];
"mlsys.planning" [id="concept-mlsys.planning", label="Agent planning", tooltip="Constructing and revising prospective actions in response to goals, dependencies, and observations."];
"mlsys.sliding-window-attention" [id="concept-mlsys.sliding-window-attention", label="Sparse and sliding-\nwindow attention", tooltip="Attention restricted to local windows or predetermined sparse patterns, reducing attended query-key pairs; cost is linear in sequence length when the attended positions per query remain bounded."];
"mlsys.retrieval" [id="concept-mlsys.retrieval", label="Retrieval", tooltip="Selecting relevant records from an external collection using an explicit query and ranking process."];
"mlsys.ann" [id="concept-mlsys.ann", label="Approximate nearest-\nneighbor search", tooltip="Trading exact neighbor recovery for reduced search cost using an index or approximation."];
"mlsys.hallucination" [id="concept-mlsys.hallucination", label="Hallucination", tooltip="Generated factual assertions or summaries not supported by the relevant source or evidence."];
"mlsys.tool-contract" [id="concept-mlsys.tool-contract", label="Tool contract", tooltip="A specification of tool inputs, outputs, authority, effects, and failure behavior."];
"mlsys.failure-model" [id="concept-mlsys.failure-model", label="Failure model", tooltip="The declared classes of faults and timing assumptions under which a mechanism is analyzed."];
"mlsys.idempotency" [id="concept-mlsys.idempotency", label="Idempotency", tooltip="A specified operation's repeated execution having the same intended effect as one execution."];
"mlsys.prompt-injection" [id="concept-mlsys.prompt-injection", label="Prompt injection", tooltip="Untrusted content attempting to redirect model-driven behavior across an instruction or authority boundary."];
"mlsys.agent-evaluation" [id="concept-mlsys.agent-evaluation", label="Trajectory evaluation", tooltip="Assessing task outcomes, intermediate effects, and constraint compliance across a complete agent run."];
"mlsys.rlhf" [id="concept-mlsys.rlhf", label="RL from human feedback", tooltip="Optimizing a model's policy against a reward model trained on human preference comparisons, usually with a penalty for drifting from a reference model."];
"mlsys.dynamics" [id="concept-mlsys.dynamics", label="Physical dynamics", tooltip="The evolution of a physical system under inputs, disturbances, and constraints."];
"mlsys.sensing" [id="concept-mlsys.sensing", label="Sensor calibration", tooltip="Establishing how observations relate to physical quantities, coordinates, and time."];
"mlsys.state-estimation" [id="concept-mlsys.state-estimation", label="State estimation", tooltip="Inferring latent physical state and uncertainty from observations and a model."];
"mlsys.state-observability" [id="concept-mlsys.state-observability", label="State observability", tooltip="Whether distinct internal states can be distinguished through the available observations and model."];
"mlsys.observation-age" [id="concept-mlsys.observation-age", label="Observation age", tooltip="Elapsed time between a physical observation and its use in a decision."];
"mlsys.feedback-delay" [id="concept-mlsys.feedback-delay", label="Feedback delay", tooltip="The total delay around the sense-compute-communicate-actuate loop, which erodes a controller's stability margin and adds motion before any response can begin, so it must be budgeted end to end rather than stage by stage."];
"mlsys.wcet" [id="concept-mlsys.wcet", label="Worst-case execution\ntime", tooltip="A justified execution-time upper bound under specified hardware and execution assumptions."];
"mlsys.feedback-control" [id="concept-mlsys.feedback-control", label="Feedback control", tooltip="Selecting inputs using measured or estimated deviation from desired behavior."];
"mlsys.trajectory-feasibility" [id="concept-mlsys.trajectory-feasibility", label="Trajectory feasibility", tooltip="Satisfaction of motion, state, input, and dynamic constraints along a proposed trajectory."];
"mlsys.contact-compliance" [id="concept-mlsys.contact-compliance", label="Contact and compliance", tooltip="Mechanical interaction whose forces depend on geometry, motion, stiffness, and damping."];
"mlsys.sim-to-real" [id="concept-mlsys.sim-to-real", label="Simulation-to-real\ntransfer", tooltip="Transferring a policy trained in simulation to physical hardware, where differences in dynamics, sensing, contact, and timing can degrade behavior and motivate randomization, system identification, or adaptation on real experience."];
"mlsys.runtime-assurance" [id="concept-mlsys.runtime-assurance", label="Runtime assurance", tooltip="Monitoring and constraining execution using explicitly stated safety premises and fallback mechanisms."];
"mlsys.stopping-envelope" [id="concept-mlsys.stopping-envelope", label="Stopping envelope", tooltip="The state and clearance conditions within which a specified stopping response remains feasible."];
"mlsys.operating-domain" [id="concept-mlsys.operating-domain", label="Operational design\ndomain", tooltip="The declared set of conditions, covering environment, inputs, actors, and system state, within which a system is designed to perform and outside which its safety claims and evidence do not apply."];
"mlsys.safety-case" [id="concept-mlsys.safety-case", label="Safety case", tooltip="A structured, reviewable argument, with its evidence, assumptions, and defeaters, that a defined system is acceptably safe for a stated use within a stated operating domain."];
"mlsys.grammar" [id="concept-mlsys.grammar", label="Structured output\nconstraint", tooltip="A contract on the admissible syntax or schema of model outputs, enforced during generation by constrained decoding or checked afterward by output validation, which establishes form but not factual correctness or authority."];
"mlsys.labels" [id="concept-mlsys.labels", label="Label quality", tooltip="The correctness, consistency, and coverage of recorded supervision relative to the intended task, which bound the training signal and the trustworthiness of evaluation."];
"mlsys.data-contract" [id="concept-mlsys.data-contract", label="Data contract", tooltip="A specification of schema, semantics, validity rules, and availability for data exchanged between components."];
"mlsys.feedback-loop" [id="concept-mlsys.feedback-loop", label="Deployment feedback\nloop", tooltip="A deployed system's outputs changing the data or behavior encountered by future learning or evaluation."];
"mlsys.decision-policy" [id="concept-mlsys.decision-policy", label="Decision policy", tooltip="The rule that converts model outputs and system state into actions, thresholds, abstentions, or escalation."];
"mlsys.robustness-evaluation" [id="concept-mlsys.robustness-evaluation", label="Robustness evaluation", tooltip="Testing behavior under explicitly chosen shifts, perturbations, faults, or operating stresses."];
"mlsys.supervised-learning" [id="concept-mlsys.supervised-learning", label="Supervised learning", tooltip="Learning a prediction rule from examples with target outputs."];
"mlsys.self-supervised-learning" [id="concept-mlsys.self-supervised-learning", label="Self-supervised\nlearning", tooltip="Learning from targets constructed from the observed data itself."];
"mlsys.unsupervised-learning" [id="concept-mlsys.unsupervised-learning", label="Unsupervised learning", tooltip="Learning structure in data without externally supplied example-level targets."];
"mlsys.reinforcement-learning" [id="concept-mlsys.reinforcement-learning", label="Reinforcement learning", tooltip="Learning a policy from action-dependent observations and reward signals."];
"mlsys.imitation-learning" [id="concept-mlsys.imitation-learning", label="Imitation learning", tooltip="Learning a policy from demonstrated behavior and possibly corrective interaction."];
"mlsys.model-artifact" [id="concept-mlsys.model-artifact", label="Model artifact", tooltip="The learned parameters, structures, example stores, and metadata required to execute a model."];
"mlsys.compensation" [id="concept-mlsys.compensation", label="Compensating action", tooltip="An explicit action intended to remedy an earlier effect whose direct reversal is unavailable."];
"mlsys.backpressure" [id="concept-mlsys.backpressure", label="Backpressure", tooltip="A mechanism that signals downstream saturation to limit or slow upstream production."];
"mlsys.privacy-leakage" [id="concept-mlsys.privacy-leakage", label="Privacy leakage", tooltip="Information about people or records revealed through data, artifacts, or model interaction."];
"mlsys.utilization" [id="concept-mlsys.utilization", label="Resource utilization", tooltip="The fraction of a resource's defined service capacity that is occupied over a stated interval."];
"mlsys.irreversible-effects" [id="concept-mlsys.irreversible-effects", label="Irreversible effects", tooltip="External consequences that cannot be fully undone by restoring software state, retrying, or performing a compensating action."];
"mlsys.dataset-storage-layout" [id="concept-mlsys.dataset-storage-layout", label="Dataset storage layout", tooltip="Organization of stored dataset records, columns, partitions, and metadata that determines which data an access reads or decodes."];
"mlsys.data-ingestion" [id="concept-mlsys.data-ingestion", label="Data ingestion", tooltip="Reading externally produced records into a processing or learning system under declared delivery, ordering, and timing assumptions."];
"mlsys.schema-evolution" [id="concept-mlsys.schema-evolution", label="Schema evolution", tooltip="Changing a data schema while explicitly managing how existing data and producers or consumers remain interpretable and compatible."];
"mlsys.test-oracle" [id="concept-mlsys.test-oracle", label="Test oracle", tooltip="A specification, procedure, reference, or informed judgment used to assess whether observed behavior satisfies stated expectations for a test."];
"mlsys.integration-testing" [id="concept-mlsys.integration-testing", label="Integration testing", tooltip="Testing interactions among assembled components against stated interface and behavior expectations."];
"mlsys.failure-injection" [id="concept-mlsys.failure-injection", label="Failure injection", tooltip="Deliberately introducing selected faults or disruptive conditions to observe system response under controlled experimental boundaries."];
"mlsys.dependency-environment" [id="concept-mlsys.dependency-environment", label="Dependency environment", tooltip="The software packages, versions, native libraries, and runtime configuration on which an execution depends."];
"mlsys.workflow-orchestration" [id="concept-mlsys.workflow-orchestration", label="Workflow orchestration", tooltip="Coordinating dependent computation steps, their data or control flow, execution conditions, and failure handling."];
"mlsys.experiment-reproducibility" [id="concept-mlsys.experiment-reproducibility", label="Experiment\nreproducibility", tooltip="The ability to repeat an experimental procedure and obtain results consistent with declared criteria when its inputs, environment, randomness, and execution conditions are specified."];
"mlsys.compute-throughput" [id="concept-mlsys.compute-throughput", label="Compute throughput", tooltip="The sustainable rate of a specified arithmetic workload on an execution resource."];
"mlsys.memory-bandwidth" [id="concept-mlsys.memory-bandwidth", label="Memory bandwidth", tooltip="The sustainable rate at which bytes move across a specified memory interface."];
"mlsys.host-device-interconnect" [id="concept-mlsys.host-device-interconnect", label="Host-device\ninterconnect", tooltip="Communication path through which a host and accelerator exchange data and control, with transport, topology, and memory-access semantics that affect transfers."];
"mlsys.power-delivery" [id="concept-mlsys.power-delivery", label="Power delivery and\nintegrity", tooltip="Supply paths, conversion stages, limits, and transient behavior that must maintain required voltages while workloads and actuators draw or return power."];
"mlsys.thermal-dynamics" [id="concept-mlsys.thermal-dynamics", label="Thermal behavior and\nthrottling", tooltip="Evolution of temperature under heat generation and removal, and the performance controls or operating restrictions that follow under a platform thermal policy."];
"mlsys.sli" [id="concept-mlsys.sli", label="Service-level indicator", tooltip="A quantitative measure of one aspect of delivered service, such as latency, availability, or accepted-output rate, computed over a stated population and window."];
"mlsys.error-budget" [id="concept-mlsys.error-budget", label="Error budget", tooltip="The amount of service-level-objective violation permitted over a window, used to pace changes and risk against a reliability target."];
"mlsys.latency-budget" [id="concept-mlsys.latency-budget", label="Latency budget", tooltip="An allocation of an end-to-end latency target across the stages of a request path, such as network, preprocessing, inference, and postprocessing."];
"mlsys.flop-accounting" [id="concept-mlsys.flop-accounting", label="Operation and byte\naccounting", tooltip="Estimating a workload's arithmetic operations and bytes moved per example, token, or step from model shapes, to predict cost before measurement."];
"mlsys.memory-footprint" [id="concept-mlsys.memory-footprint", label="Memory footprint", tooltip="The peak memory a workload occupies, summed over parameters, activations, optimizer or cache state, and runtime buffers."];
"mlsys.workload-trace" [id="concept-mlsys.workload-trace", label="Workload trace", tooltip="A recorded sequence of requests or jobs with arrival times, sizes, and durations, replayed to evaluate capacity, scheduling, or serving policies."];
"mlsys.cost-sensitive-decision" [id="concept-mlsys.cost-sensitive-decision", label="Cost-sensitive decision", tooltip="Choosing actions or thresholds to minimize expected cost when different error types carry unequal consequences."];
"mlsys.pareto-frontier" [id="concept-mlsys.pareto-frontier", label="Pareto frontier", tooltip="The set of configurations for which no objective, such as accuracy, latency, or cost, can improve without worsening another."];
"mlsys.transformer" [id="concept-mlsys.transformer", label="Transformer", tooltip="A neural architecture of stacked attention and feed-forward blocks with residual connections and normalization, processing all sequence positions in parallel during training."];
"mlsys.recommendation-model" [id="concept-mlsys.recommendation-model", label="Deep recommendation\nmodel", tooltip="Models combining large sparse embedding tables for categorical features with dense layers, whose cost is often dominated by embedding lookups and memory capacity."];
"mlsys.diffusion-model" [id="concept-mlsys.diffusion-model", label="Diffusion model", tooltip="A generative model that learns to reverse a gradual noising process, producing samples through many iterative denoising network evaluations."];
"mlsys.convolution" [id="concept-mlsys.convolution", label="Convolution", tooltip="A locally connected operation applying shared filters across spatial or temporal positions, giving high weight reuse and arithmetic intensity."];
"mlsys.recurrence" [id="concept-mlsys.recurrence", label="Recurrent computation", tooltip="Computation that updates a hidden state step by step over a sequence, creating sequential dependencies that limit parallelism across time."];
"mlsys.normalization-layer" [id="concept-mlsys.normalization-layer", label="Normalization layers", tooltip="Layers that rescale activations using batch, layer, or root-mean-square statistics to stabilize and speed training of deep networks."];
"mlsys.mixture-of-experts" [id="concept-mlsys.mixture-of-experts", label="Mixture of experts", tooltip="An architecture in which a learned router activates a small subset of expert subnetworks per token, decoupling total parameter count from per-token compute."];
"mlsys.expert-routing" [id="concept-mlsys.expert-routing", label="Expert routing", tooltip="The gating function that assigns each token to one or more experts, such as top-k softmax gating or expert-choice routing."];
"mlsys.expert-capacity" [id="concept-mlsys.expert-capacity", label="Expert capacity", tooltip="The maximum number of tokens an expert processes per batch, set by a capacity factor; tokens beyond it are dropped or rerouted."];
"mlsys.load-balancing-loss" [id="concept-mlsys.load-balancing-loss", label="Load-balancing loss", tooltip="An auxiliary training objective that penalizes uneven token assignment across experts so routing stays balanced."];
"mlsys.active-parameters" [id="concept-mlsys.active-parameters", label="Active parameters", tooltip="The parameters actually used to process one token or example, as distinct from total stored parameters in conditionally computed models."];
"mlsys.early-exit" [id="concept-mlsys.early-exit", label="Early exit", tooltip="Terminating inference at an intermediate layer once a confidence criterion is met, so per-input compute varies with input difficulty."];
"mlsys.linear-attention" [id="concept-mlsys.linear-attention", label="Linear attention", tooltip="Attention reformulated with kernel feature maps so it is computed in linear time with a fixed-size recurrent state."];
"mlsys.state-space-model" [id="concept-mlsys.state-space-model", label="State-space sequence\nmodel", tooltip="Sequence models built on discretized linear state-space recurrences, trainable in parallel and run with constant-size state per step at inference."];
"mlsys.grouped-query-attention" [id="concept-mlsys.grouped-query-attention", label="Grouped-query attention", tooltip="Attention in which groups of query heads share key and value heads, shrinking the key-value cache and decode memory traffic."];
"mlsys.context-extension" [id="concept-mlsys.context-extension", label="Context-length\nextension", tooltip="Techniques that extend a trained model's usable sequence length, such as position-encoding interpolation followed by long-sequence fine-tuning."];
"mlsys.context" [id="concept-mlsys.context", label="Context window", tooltip="The maximum token span a model supports in a stated execution mode, bounding the history it can use and the longest sequences the system must process."];
"mlsys.weight-serialization" [id="concept-mlsys.weight-serialization", label="Weight serialization\nformat", tooltip="The on-disk encoding of a model's parameter tensors and metadata, governing load time, memory mapping, and safety of deserialization."];
"mlsys.model-exchange-format" [id="concept-mlsys.model-exchange-format", label="Model exchange format", tooltip="A framework-neutral representation of a model's operator graph and weights used to move models between training frameworks and inference runtimes."];
"mlsys.model-export" [id="concept-mlsys.model-export", label="Model export", tooltip="Converting a framework model into an artifact with an explicit computation and input contract that a compatible runtime can execute."];
"mlsys.model-signature" [id="concept-mlsys.model-signature", label="Model signature", tooltip="The declared names, types, and shapes of a model artifact's inputs and outputs, forming its interface contract with callers."];
"mlsys.ridge-point" [id="concept-mlsys.ridge-point", label="Ridge point", tooltip="The arithmetic intensity at which a roofline's bandwidth and compute ceilings meet, equal to peak compute throughput divided by peak memory bandwidth."];
"mlsys.bound-regime" [id="concept-mlsys.bound-regime", label="Compute-bound vs.\nmemory-bound", tooltip="Classifying a kernel or phase by what limits it: the roofline's arithmetic ceiling, its bandwidth ceiling, or, for operations too small to approach either, fixed per-operation overhead, indicating whether more throughput, more bandwidth, or fewer and larger operations would help."];
"mlsys.data-movement-energy" [id="concept-mlsys.data-movement-energy", label="Data-movement energy", tooltip="The energy cost of moving operands between storage levels, which grows with distance and typically exceeds the energy of the arithmetic performed on them."];
"mlsys.amdahls-law" [id="concept-mlsys.amdahls-law", label="Amdahl's law", tooltip="The bound that overall speedup from accelerating part of an execution is limited by the fraction left unaccelerated."];
"mlsys.strong-scaling" [id="concept-mlsys.strong-scaling", label="Strong scaling", tooltip="How time to solution changes as resources increase for a fixed total problem size."];
"mlsys.weak-scaling" [id="concept-mlsys.weak-scaling", label="Weak scaling", tooltip="How time to solution changes as resources and problem size grow proportionally, keeping work per resource fixed."];
"mlsys.parallel-efficiency" [id="concept-mlsys.parallel-efficiency", label="Parallel scaling\nefficiency", tooltip="Achieved speedup divided by the factor of added resources, measuring how much additional hardware turns into useful progress."];
"mlsys.littles-law" [id="concept-mlsys.littles-law", label="Little's law", tooltip="The relation that the mean number of items in a stable system equals mean arrival rate times mean time in the system."];
"mlsys.latency-throughput-curve" [id="concept-mlsys.latency-throughput-curve", label="Latency-throughput\ncurve", tooltip="The relationship between offered load and latency, in which queueing delay grows sharply as utilization approaches capacity."];
"mlsys.arrival-burstiness" [id="concept-mlsys.arrival-burstiness", label="Arrival burstiness", tooltip="Variability of request inter-arrival times or sizes beyond a Poisson baseline, which raises queueing delay at a given mean utilization."];
"mlsys.compute-optimal-allocation" [id="concept-mlsys.compute-optimal-allocation", label="Compute-optimal\nallocation", tooltip="Choosing model size and training data quantity to minimize loss under a fixed training compute budget, using fitted scaling laws."];
"mlsys.training-compute-estimate" [id="concept-mlsys.training-compute-estimate", label="Training compute\nestimate", tooltip="Approximating dense transformer training compute as roughly six floating-point operations per parameter per training token."];
"mlsys.systolic-array" [id="concept-mlsys.systolic-array", label="Systolic array", tooltip="A grid of processing elements that pass operands rhythmically to neighbors, performing matrix multiplication with high operand reuse and little register-file traffic."];
"mlsys.matrix-unit" [id="concept-mlsys.matrix-unit", label="Matrix engine", tooltip="A functional unit that executes small dense matrix multiply-accumulate tiles per instruction, supplying most of an accelerator's peak low-precision throughput."];
"mlsys.simt" [id="concept-mlsys.simt", label="SIMT execution", tooltip="An execution model in which groups of threads issue common instructions to active lanes, with divergent paths executed under lane masks and architecture-specific reconvergence."];
"mlsys.dataflow" [id="concept-mlsys.dataflow", label="Accelerator dataflow", tooltip="The mapping that decides which operands stay resident in local storage while others stream, such as weight-, output-, or row-stationary schedules."];
"mlsys.domain-specific-architecture" [id="concept-mlsys.domain-specific-architecture", label="Domain-specific\narchitecture", tooltip="Hardware specialized to a class of workloads, trading programmability for higher performance per watt on its target operations."];
"mlsys.hbm" [id="concept-mlsys.hbm", label="High-bandwidth memory", tooltip="Stacked DRAM placed beside the processor on an interposer, providing very high bandwidth with limited capacity per stack."];
"mlsys.on-chip-sram" [id="concept-mlsys.on-chip-sram", label="On-chip SRAM and\nscratchpads", tooltip="Small, fast on-die storage, such as caches, shared memory, and register files, used to stage reused operands near compute units."];
"mlsys.memory-wall" [id="concept-mlsys.memory-wall", label="Memory wall", tooltip="The widening gap between processor arithmetic throughput and memory bandwidth or latency, which makes data movement the limiting factor."];
"mlsys.scale-up-interconnect" [id="concept-mlsys.scale-up-interconnect", label="Scale-up interconnect", tooltip="High-bandwidth links and switches, such as NVLink-class fabrics, joining accelerators within a node or rack into one tightly coupled domain."];
"mlsys.coherent-interconnect" [id="concept-mlsys.coherent-interconnect", label="Cache-coherent\ninterconnect", tooltip="A link protocol that lets hosts and devices share or pool memory with hardware coherence, such as CXL over a PCIe physical layer."];
"mlsys.peer-to-peer-transfer" [id="concept-mlsys.peer-to-peer-transfer", label="Peer-to-peer device\ntransfer", tooltip="Direct memory access between accelerators, or between accelerators and NICs or storage, without staging data through host memory."];
"mlsys.tdp" [id="concept-mlsys.tdp", label="Thermal design power", tooltip="The sustained heat dissipation a cooling solution is designed to remove, used as a chip's nominal power envelope."];
"mlsys.dvfs" [id="concept-mlsys.dvfs", label="Dynamic voltage and\nfrequency scaling", tooltip="Adjusting supply voltage and clock frequency at runtime to trade performance for power, since dynamic power grows superlinearly with voltage."];
"mlsys.dark-silicon" [id="concept-mlsys.dark-silicon", label="Dark silicon", tooltip="The fraction of a chip that cannot be powered at full frequency simultaneously within its power and thermal budget."];
"mlsys.power-capping" [id="concept-mlsys.power-capping", label="Power capping", tooltip="Enforcing a maximum power draw on a device or group by limiting clocks or activity, trading peak throughput for bounded power."];
"mlsys.microcontroller" [id="concept-mlsys.microcontroller", label="Microcontroller-class\ndevice", tooltip="A low-power processor with on-chip flash and kilobytes to a few megabytes of SRAM, typically without an operating system or virtual memory."];
"mlsys.heterogeneous-soc" [id="concept-mlsys.heterogeneous-soc", label="Heterogeneous mobile\nSoC", tooltip="A system-on-chip combining CPU, GPU, DSP, and NPU blocks under shared memory and power limits, across which model operators are partitioned."];
"mlsys.edge-npu" [id="concept-mlsys.edge-npu", label="On-device neural\naccelerator", tooltip="An accelerator integrated in mobile or embedded silicon for low-precision neural inference, usually supporting a restricted set of operators."];
"mlsys.energy-efficiency" [id="concept-mlsys.energy-efficiency", label="Energy efficiency", tooltip="Useful work completed per unit energy, such as inferences or tokens per joule, measured within a stated system boundary."];
"mlsys.on-device-memory-budget" [id="concept-mlsys.on-device-memory-budget", label="On-device memory budget", tooltip="The flash and SRAM limits that bound a deployed model's stored weights and peak activation memory on embedded hardware."];
"mlsys.tensor" [id="concept-mlsys.tensor", label="Tensor", tooltip="A multidimensional array carrying shape, element type, device, and layout metadata, the core data abstraction of ML frameworks."];
"mlsys.computation-graph" [id="concept-mlsys.computation-graph", label="Computation graph", tooltip="A directed graph of tensor operations and their data dependencies representing a model program, used for differentiation, optimization, and scheduling."];
"mlsys.eager-execution" [id="concept-mlsys.eager-execution", label="Eager vs. graph\nexecution", tooltip="The choice between running each operation as the host program issues it and building a whole graph first for later optimization and execution."];
"mlsys.tracing-jit" [id="concept-mlsys.tracing-jit", label="Graph tracing", tooltip="Recording supported operations during a program execution with concrete or abstract inputs to construct an intermediate graph for transformation, compilation, or export."];
"mlsys.io-aware-attention" [id="concept-mlsys.io-aware-attention", label="IO-aware attention\nkernel", tooltip="An exact attention implementation that tiles queries, keys, and values through on-chip memory to avoid materializing the full score matrix in off-chip memory."];
"mlsys.convolution-lowering" [id="concept-mlsys.convolution-lowering", label="Convolution lowering", tooltip="Implementing convolution by rearranging input patches into matrices for GEMM, or by direct, FFT, or Winograd algorithms with different memory costs."];
"mlsys.kernel-library" [id="concept-mlsys.kernel-library", label="Vendor kernel library", tooltip="Tuned implementations of common operators supplied for a hardware platform, which frameworks call rather than generating their own kernels."];
"mlsys.intermediate-representation" [id="concept-mlsys.intermediate-representation", label="ML compiler IR", tooltip="Program representations at graph, tensor, and loop levels on which compilers apply lowering and optimization passes."];
"mlsys.autotuning" [id="concept-mlsys.autotuning", label="Kernel autotuning", tooltip="Searching kernel schedule parameters, such as tile sizes and loop orders, by measurement or learned cost models to find fast implementations for a target."];
"mlsys.kernel-dsl" [id="concept-mlsys.kernel-dsl", label="Kernel DSL", tooltip="A domain-specific language for writing tiled tensor kernels above the level of vendor assembly, with the compiler handling memory and thread mapping."];
"mlsys.memory-planning" [id="concept-mlsys.memory-planning", label="Static memory planning", tooltip="Compile-time assignment of tensor buffers to memory with lifetime-based reuse, reducing peak memory and runtime allocation."];
"mlsys.device-streams" [id="concept-mlsys.device-streams", label="Device streams", tooltip="Ordered queues of device work that the host enqueues asynchronously, with events expressing dependencies and allowing overlap across queues."];
"mlsys.caching-allocator" [id="concept-mlsys.caching-allocator", label="Caching memory\nallocator", tooltip="A runtime allocator that retains and reuses freed device memory blocks to avoid costly allocation calls, at the risk of fragmentation."];
"mlsys.graph-replay" [id="concept-mlsys.graph-replay", label="Captured graph replay", tooltip="Recording a fixed sequence of kernel launches once and replaying it as a unit to remove per-launch host overhead."];
"mlsys.loss-scaling" [id="concept-mlsys.loss-scaling", label="Loss scaling", tooltip="Multiplying the loss before backpropagation so small gradients remain representable in reduced-precision formats, then unscaling before the optimizer step."];
"mlsys.block-scaled-format" [id="concept-mlsys.block-scaled-format", label="Block-scaled number\nformats", tooltip="Low-precision formats in which small blocks of values share a scale factor, extending dynamic range for FP8, FP6, FP4, or INT8 elements."];
"mlsys.accumulation-precision" [id="concept-mlsys.accumulation-precision", label="Accumulation precision", tooltip="The numerical format used to sum products in dot products and reductions, which may differ from input precision and governs rounding-error growth."];
"mlsys.expert-parallel" [id="concept-mlsys.expert-parallel", label="Expert parallelism", tooltip="Placing different experts of a mixture-of-experts layer on different devices and exchanging routed tokens among them."];
"mlsys.sequence-parallel" [id="concept-mlsys.sequence-parallel", label="Sequence and context\nparallelism", tooltip="Partitioning activations along the sequence dimension across devices, exchanging keys, values, or partial results so long sequences fit."];
"mlsys.hybrid-parallel" [id="concept-mlsys.hybrid-parallel", label="Hybrid parallelism", tooltip="Combining data, tensor, pipeline, and other parallelism dimensions, mapped onto the hardware hierarchy so the most communication-intensive dimension uses the fastest links."];
"mlsys.pipeline-bubble" [id="concept-mlsys.pipeline-bubble", label="Pipeline bubble", tooltip="Idle device time during pipeline fill and drain, whose fraction shrinks as the number of microbatches grows relative to pipeline stages."];
"mlsys.ring-allreduce" [id="concept-mlsys.ring-allreduce", label="Ring all-reduce", tooltip="An all-reduce performed as reduce-scatter then all-gather around a ring, bandwidth-optimal for large messages but with latency linear in participants."];
"mlsys.tree-allreduce" [id="concept-mlsys.tree-allreduce", label="Tree and hierarchical\nall-reduce", tooltip="All-reduce schedules over trees or hierarchical groups, with latency logarithmic in participants, suited to small messages and multi-level networks."];
"mlsys.all-to-all" [id="concept-mlsys.all-to-all", label="All-to-all exchange", tooltip="A collective in which every participant sends distinct data to every other, as in expert routing; its throughput is sensitive to bisection bandwidth."];
"mlsys.alpha-beta-model" [id="concept-mlsys.alpha-beta-model", label="Alpha-beta\ncommunication model", tooltip="A cost model estimating message time as a fixed latency term plus message size times a per-byte cost, used to compare collective algorithms."];
"mlsys.gradient-compression" [id="concept-mlsys.gradient-compression", label="Gradient compression", tooltip="Reducing gradient communication through quantization, sparsification, or low-rank approximation, often with error feedback to preserve convergence."];
"mlsys.lease" [id="concept-mlsys.lease", label="Lease", tooltip="A time-bounded grant of authority or cached state that expires unless renewed, letting a system recover from failed holders without explicit release."];
"mlsys.leader-election" [id="concept-mlsys.leader-election", label="Leader election", tooltip="Selecting a single coordinator among replicas, typically through consensus and leases, so control decisions have one authoritative source."];
"mlsys.bounded-staleness" [id="concept-mlsys.bounded-staleness", label="Bounded staleness", tooltip="A consistency model in which workers may compute on parameters up to a fixed number of updates old, trading freshness for less waiting."];
"mlsys.federated-averaging" [id="concept-mlsys.federated-averaging", label="Federated averaging", tooltip="A federated algorithm in which sampled clients run several local optimization steps and a server averages their model updates, weighted by data size."];
"mlsys.non-iid-data" [id="concept-mlsys.non-iid-data", label="Statistical\nheterogeneity", tooltip="Differences in data distribution and quantity across federated clients, which slow convergence and can bias a shared model."];
"mlsys.client-sampling" [id="concept-mlsys.client-sampling", label="Client selection", tooltip="Choosing which available devices participate in each federated round, subject to availability, connectivity, and power constraints."];
"mlsys.federation-setting" [id="concept-mlsys.federation-setting", label="Cross-device vs. cross-\nsilo federation", tooltip="The distinction between federations of many intermittently available devices and federations of a few reliable organizational data holders."];
"mlsys.pue" [id="concept-mlsys.pue", label="Power usage\neffectiveness", tooltip="Total facility energy divided by IT equipment energy, measuring overhead from cooling, power conversion, and other non-compute loads."];
"mlsys.liquid-cooling" [id="concept-mlsys.liquid-cooling", label="Liquid cooling", tooltip="Removing heat with liquid through cold plates or immersion, enabling rack power densities beyond the practical limits of air cooling."];
"mlsys.rack-power-density" [id="concept-mlsys.rack-power-density", label="Rack power density", tooltip="Electrical power drawn per rack, which determines cooling technology, floor layout, and how many accelerators fit within a facility's power envelope."];
"mlsys.power-oversubscription" [id="concept-mlsys.power-oversubscription", label="Power oversubscription", tooltip="Deploying more equipment than the sum of nameplate power a feed supports, relying on non-coincident peaks and power capping to stay within limits."];
"mlsys.warehouse-scale-computer" [id="concept-mlsys.warehouse-scale-computer", label="Warehouse-scale\ncomputer", tooltip="A datacenter treated as a single computer whose power, cooling, network, and software are co-designed for a common workload."];
"mlsys.rdma" [id="concept-mlsys.rdma", label="Remote direct memory\naccess", tooltip="Network transfers that read or write remote memory directly through the network interface without remote CPU involvement, giving low latency and high throughput."];
"mlsys.lossless-fabric" [id="concept-mlsys.lossless-fabric", label="Lossless network fabric", tooltip="A network that avoids packet drops through credit-based or priority flow control, as RDMA transports expect, at the risk of head-of-line blocking."];
"mlsys.congestion-control" [id="concept-mlsys.congestion-control", label="Datacenter congestion\ncontrol", tooltip="End-host and switch mechanisms, such as ECN-driven rate control, that limit queue buildup from incast and synchronized collective traffic."];
"mlsys.fat-tree" [id="concept-mlsys.fat-tree", label="Fat-tree (Clos)\ntopology", tooltip="A multistage switch topology providing many equal-cost paths and, without oversubscription, full bisection bandwidth between endpoints."];
"mlsys.rail-optimized" [id="concept-mlsys.rail-optimized", label="Rail-optimized topology", tooltip="A fabric design connecting the same-index accelerator of every node to a common leaf switch, keeping most collective traffic within one switch hop."];
"mlsys.bisection-bandwidth" [id="concept-mlsys.bisection-bandwidth", label="Bisection bandwidth", tooltip="The minimum total bandwidth across any cut dividing a network into two equal halves, bounding throughput of all-to-all and global exchanges."];
"mlsys.in-network-reduction" [id="concept-mlsys.in-network-reduction", label="In-network reduction", tooltip="Performing collective reductions inside network switches so data crosses each link fewer times, lowering all-reduce traffic and latency."];
"mlsys.parallel-file-system" [id="concept-mlsys.parallel-file-system", label="Parallel file system", tooltip="A distributed file system that stripes data across many storage servers to deliver aggregate bandwidth to many concurrent clients."];
"mlsys.object-storage" [id="concept-mlsys.object-storage", label="Object storage", tooltip="Storage of immutable named objects behind an HTTP-style interface, offering scalable capacity and throughput with higher per-request latency than file systems."];
"mlsys.input-pipeline" [id="concept-mlsys.input-pipeline", label="Training input pipeline", tooltip="The read, decode, transform, shuffle, and prefetch stages that deliver batches to accelerators; when slower than compute, they cause data stalls."];
"mlsys.checkpoint-io" [id="concept-mlsys.checkpoint-io", label="Checkpoint I/O", tooltip="Writing and reading large training-state snapshots, where storage bandwidth, asynchronous persistence, and sharded layout determine checkpoint cost."];
"mlsys.storage-tiering" [id="concept-mlsys.storage-tiering", label="Storage tiering and\ncaching", tooltip="Placing data across tiers, from memory and local NVMe caches to shared and archival storage, according to access frequency and cost."];
"mlsys.gang-scheduling" [id="concept-mlsys.gang-scheduling", label="Gang scheduling", tooltip="Allocating all resources a parallel job needs at once, or none, so tightly coupled workers start together and partial allocations cannot deadlock."];
"mlsys.job-preemption" [id="concept-mlsys.job-preemption", label="Job preemption", tooltip="Suspending or evicting a running job to reclaim its resources for higher-priority work, at a cost set by checkpointing and lost progress."];
"mlsys.dominant-resource-fairness" [id="concept-mlsys.dominant-resource-fairness", label="Dominant resource\nfairness", tooltip="A multi-resource fair-sharing policy that equalizes each user's largest share across resource types such as accelerators, CPUs, and memory."];
"mlsys.elastic-training" [id="concept-mlsys.elastic-training", label="Elastic training", tooltip="Training that continues while the number of workers changes, resharding state and adjusting batch size or learning rate as resources join or leave."];
"mlsys.topology-aware-placement" [id="concept-mlsys.topology-aware-placement", label="Topology-aware\nplacement", tooltip="Assigning a job's workers to devices and nodes so that heavily communicating groups share fast links or switches."];
"mlsys.bin-packing" [id="concept-mlsys.bin-packing", label="Bin packing", tooltip="Placing jobs onto nodes to minimize fragmentation of resources such as accelerators, trading packing density against interference and locality."];
"mlsys.multi-tenancy" [id="concept-mlsys.multi-tenancy", label="Multi-tenancy", tooltip="Sharing infrastructure among teams, jobs, or customers under policies for allocation, isolation, priority, and accounting."];
"mlsys.resource-quota" [id="concept-mlsys.resource-quota", label="Resource quota", tooltip="A limit on the resources a tenant may hold or request, sometimes with guaranteed minimums and borrowing of idle capacity."];
"mlsys.gpu-partitioning" [id="concept-mlsys.gpu-partitioning", label="Accelerator sharing and\npartitioning", tooltip="Running several workloads on one accelerator by time-slicing, concurrent contexts, or hardware partitions with dedicated memory and compute slices."];
"mlsys.spot-capacity" [id="concept-mlsys.spot-capacity", label="Spot and preemptible\ncapacity", tooltip="Discounted compute that the provider may reclaim at short notice, usable by workloads that tolerate interruption."];
"mlsys.performance-interference" [id="concept-mlsys.performance-interference", label="Performance\ninterference", tooltip="Slowdown of one workload caused by co-located workloads contending for shared caches, memory bandwidth, network, or power."];
"mlsys.weak-supervision" [id="concept-mlsys.weak-supervision", label="Weak supervision", tooltip="Producing training labels from noisy programmatic sources such as heuristics, rules, or distant supervision, then modeling and combining their errors."];
"mlsys.active-learning" [id="concept-mlsys.active-learning", label="Active learning", tooltip="Selecting which unlabeled examples to annotate next according to their expected value to the model."];
"mlsys.annotator-agreement" [id="concept-mlsys.annotator-agreement", label="Inter-annotator\nagreement", tooltip="The degree to which independent annotators assign the same label to the same item, used to measure label reliability and task ambiguity."];
"mlsys.quality-filtering" [id="concept-mlsys.quality-filtering", label="Quality filtering", tooltip="Removing or down-weighting training examples judged low quality by heuristics, classifiers, or model scores."];
"mlsys.data-mixture" [id="concept-mlsys.data-mixture", label="Data mixture", tooltip="The proportions in which source domains or datasets are sampled during training."];
"mlsys.synthetic-data" [id="concept-mlsys.synthetic-data", label="Synthetic data", tooltip="Training or evaluation examples generated by simulators, programs, or models rather than collected from the target environment."];
"mlsys.data-augmentation" [id="concept-mlsys.data-augmentation", label="Data augmentation", tooltip="Creating additional training examples by applying label-preserving transformations to existing ones."];
"mlsys.data-validation" [id="concept-mlsys.data-validation", label="Data validation", tooltip="Automated checks of incoming data against expected schema, value ranges, and distributions before it is used for training or serving."];
"mlsys.feature-store" [id="concept-mlsys.feature-store", label="Feature store", tooltip="A system that defines, computes, stores, and serves features consistently for offline training and online inference."];
"mlsys.stream-processing" [id="concept-mlsys.stream-processing", label="Stream processing", tooltip="Continuously transforming unbounded event streams with low latency and incrementally maintained state."];
"mlsys.feature-backfill" [id="concept-mlsys.feature-backfill", label="Feature backfill", tooltip="Recomputing a feature's historical values under a new or corrected definition so training data matches what serving will produce."];
"mlsys.data-versioning" [id="concept-mlsys.data-versioning", label="Dataset versioning", tooltip="Recording immutable, addressable versions of datasets so that a training run or evaluation can identify exactly which data it used."];
"mlsys.data-dependency" [id="concept-mlsys.data-dependency", label="Data dependency debt", tooltip="Undeclared, unstable, or underused input signals on which a model depends, which can change or break its behavior silently."];
"mlsys.feature-freshness" [id="concept-mlsys.feature-freshness", label="Feature freshness", tooltip="How recent a feature's value is at the moment it is used for a prediction, relative to the recency assumed when training examples were built; stale values shift inputs away from the training distribution."];
"mlsys.learning-rate-schedule" [id="concept-mlsys.learning-rate-schedule", label="Learning-rate schedule", tooltip="The planned variation of the optimizer step size over training, such as warmup followed by decay."];
"mlsys.critical-batch-size" [id="concept-mlsys.critical-batch-size", label="Critical batch size", tooltip="The batch size beyond which increasing it further yields diminishing reductions in optimization steps to reach a target loss."];
"mlsys.training-instability" [id="concept-mlsys.training-instability", label="Training instability", tooltip="Loss spikes, divergence, or collapse during training, often mitigated by gradient clipping, schedule changes, normalization, or restarting from a checkpoint."];
"mlsys.gradient-accumulation" [id="concept-mlsys.gradient-accumulation", label="Gradient accumulation", tooltip="Summing gradients over several micro-batches before one optimizer update to emulate a larger batch within limited memory."];
"mlsys.memory-offloading" [id="concept-mlsys.memory-offloading", label="Training-state\noffloading", tooltip="Moving optimizer state, parameters, or activations from accelerator memory to host memory or storage between uses."];
"mlsys.experiment-tracking" [id="concept-mlsys.experiment-tracking", label="Experiment tracking", tooltip="Recording each run's code, data, configuration, metrics, and artifacts in a queryable store for comparison and reproduction."];
"mlsys.hyperparameter-transfer" [id="concept-mlsys.hyperparameter-transfer", label="Hyperparameter transfer", tooltip="Tuning hyperparameters on smaller proxy models and reusing them at larger scale under a parameterization designed to keep them stable."];
"mlsys.supervised-fine-tuning" [id="concept-mlsys.supervised-fine-tuning", label="Supervised fine-tuning", tooltip="Continued training of a pretrained model on input-output demonstrations, such as instruction-response pairs, to shape task behavior."];
"mlsys.lora" [id="concept-mlsys.lora", label="Low-rank adaptation", tooltip="Fine-tuning by learning low-rank update matrices added to frozen pretrained weights."];
"mlsys.reward-model" [id="concept-mlsys.reward-model", label="Reward model", tooltip="A learned model that scores outputs or trajectories to supply the training signal for policy optimization."];
"mlsys.preference-optimization" [id="concept-mlsys.preference-optimization", label="Direct preference\noptimization", tooltip="Training a policy directly on preferred-versus-rejected output pairs with a classification-style loss, without a separate reward model or RL loop."];
"mlsys.rlvr" [id="concept-mlsys.rlvr", label="RL with verifiable\nrewards", tooltip="Reinforcement learning whose rewards come from programmatic outcome checks, making verifier correctness and reward computation part of the training system."];
"mlsys.rl-rollout" [id="concept-mlsys.rl-rollout", label="RL rollout generation", tooltip="Sampling responses or trajectories from the current policy, often with an inference engine, to produce experience for policy updates."];
"mlsys.weight-sync" [id="concept-mlsys.weight-sync", label="Policy weight\nsynchronization", tooltip="Transferring updated policy weights from training workers to rollout workers, whose cost and frequency shape RL post-training throughput."];
"mlsys.policy-staleness" [id="concept-mlsys.policy-staleness", label="Policy staleness", tooltip="The lag between the policy version that generated rollouts and the version being updated, introduced by asynchronous rollout and training."];
"mlsys.credit-assignment" [id="concept-mlsys.credit-assignment", label="Credit assignment", tooltip="Attributing a delayed or episode-level reward to the individual actions, turns, or tokens that produced it, so updates reinforce the responsible decisions."];
"mlsys.online-learning" [id="concept-mlsys.online-learning", label="Online learning", tooltip="Updating a model incrementally as each example or small batch arrives, rather than retraining on a fixed dataset."];
"mlsys.incremental-training" [id="concept-mlsys.incremental-training", label="Incremental training", tooltip="Continuing training of an existing model from its current weights on new data instead of training from scratch."];
"mlsys.catastrophic-forgetting" [id="concept-mlsys.catastrophic-forgetting", label="Catastrophic forgetting", tooltip="Loss of previously learned capability when a model is trained on new data or tasks."];
"mlsys.experience-replay" [id="concept-mlsys.experience-replay", label="Experience replay", tooltip="Mixing stored past examples into updates on new data to reduce forgetting or reuse experience."];
"mlsys.on-device-training" [id="concept-mlsys.on-device-training", label="On-device training", tooltip="Updating model parameters on the deployment device using local data under its memory, energy, and compute limits."];
"mlsys.cross-validation" [id="concept-mlsys.cross-validation", label="Cross-validation", tooltip="Estimating performance by repeatedly training on some data partitions and evaluating on the held-out remainder."];
"mlsys.sequential-testing" [id="concept-mlsys.sequential-testing", label="Sequential testing", tooltip="Experimental analysis that permits repeated looks at accumulating data while controlling error rates, unlike fixed-horizon tests."];
"mlsys.experiment-interference" [id="concept-mlsys.experiment-interference", label="Experiment interference", tooltip="Treatment of one experimental unit affecting outcomes of another, violating the no-interference assumption (SUTVA) of standard A/B analysis."];
"mlsys.conformal-prediction" [id="concept-mlsys.conformal-prediction", label="Conformal prediction", tooltip="Constructing prediction sets from conformity scores with finite-sample coverage guarantees under stated assumptions, such as exchangeability."];
"mlsys.slice-discovery" [id="concept-mlsys.slice-discovery", label="Slice discovery", tooltip="Automatically finding coherent data subsets on which a model underperforms, without predefined slice labels."];
"mlsys.llm-judge" [id="concept-mlsys.llm-judge", label="Model-based grading", tooltip="Using a language model to score or compare generated outputs against a rubric, with its own biases and error rates to be measured."];
"mlsys.pass-at-k" [id="concept-mlsys.pass-at-k", label="pass@k", tooltip="The probability that at least one of k sampled outputs satisfies a correctness check."];
"mlsys.pairwise-preference-eval" [id="concept-mlsys.pairwise-preference-eval", label="Pairwise preference\nevaluation", tooltip="Ranking models from judgments of which of two outputs is better, typically aggregated with a Bradley-Terry or Elo-style model."];
"mlsys.human-evaluation" [id="concept-mlsys.human-evaluation", label="Human evaluation", tooltip="Assessment of system outputs by people following a protocol, used where automatic metrics or model graders are not trusted."];
"mlsys.benchmark-contamination" [id="concept-mlsys.benchmark-contamination", label="Benchmark contamination", tooltip="Presence of evaluation items, or close variants, in a model's training data, inflating measured performance."];
"mlsys.time-to-train" [id="concept-mlsys.time-to-train", label="Time to train", tooltip="Wall-clock time for a system to train a specified model to a specified quality target under fixed run rules."];
"mlsys.inference-load-scenario" [id="concept-mlsys.inference-load-scenario", label="Inference load scenario", tooltip="A specified query-arrival pattern and latency constraint, such as single-stream, server, or offline, under which inference performance is measured."];
"mlsys.metamorphic-testing" [id="concept-mlsys.metamorphic-testing", label="Metamorphic testing", tooltip="Testing by checking that known relations hold between outputs for related inputs, when correct outputs for single inputs are unknown."];
"mlsys.behavioral-testing" [id="concept-mlsys.behavioral-testing", label="Behavioral testing", tooltip="Testing model capabilities with targeted input suites for invariance, directional change, and minimum functionality, independent of aggregate accuracy."];
"mlsys.production-readiness" [id="concept-mlsys.production-readiness", label="Production-readiness\nassessment", tooltip="A structured rubric of data, model, infrastructure, and monitoring tests used to judge whether an ML system is ready to operate."];
"mlsys.online-inference" [id="concept-mlsys.online-inference", label="Online inference", tooltip="Producing predictions on demand for individual requests within a latency target."];
"mlsys.batch-inference" [id="concept-mlsys.batch-inference", label="Batch inference", tooltip="Computing predictions for many inputs in scheduled jobs and storing them for later lookup."];
"mlsys.model-server" [id="concept-mlsys.model-server", label="Model server", tooltip="A service that loads model artifacts and executes inference requests behind a network interface, managing versions, batching, and resources."];
"mlsys.multi-model-serving" [id="concept-mlsys.multi-model-serving", label="Multi-model serving", tooltip="Hosting many models or adapters on shared serving resources, trading isolation and load time against utilization."];
"mlsys.compound-ai-system" [id="concept-mlsys.compound-ai-system", label="Compound AI system", tooltip="An application composing multiple model calls, retrievers, and tools into one program whose components and control flow are tuned and served jointly for quality and cost."];
"mlsys.lm-program-optimization" [id="concept-mlsys.lm-program-optimization", label="LM program optimization", tooltip="Automatically tuning the prompts, demonstrations, or weights of each model call in a declared pipeline against an end-to-end metric rather than per call."];
"mlsys.ttft" [id="concept-mlsys.ttft", label="Time to first token", tooltip="Latency from request arrival until the first generated token is returned, dominated by queueing and prefill."];
"mlsys.tpot" [id="concept-mlsys.tpot", label="Time per output token", tooltip="For a request producing multiple tokens, its elapsed decoding time after the first output divided by its remaining generated-token count, summarizing average decoding speed at a declared measurement boundary."];
"mlsys.hedged-requests" [id="concept-mlsys.hedged-requests", label="Hedged requests", tooltip="Issuing a duplicate request to another replica when the first has not responded within a delay, and using whichever returns first."];
"mlsys.continuous-batching" [id="concept-mlsys.continuous-batching", label="Continuous batching", tooltip="Scheduling at each generation iteration so finished sequences leave and new requests join a running batch."];
"mlsys.load-balancing" [id="concept-mlsys.load-balancing", label="Request load balancing", tooltip="Distributing requests across replicas according to load, locality, or cached state."];
"mlsys.cold-start" [id="concept-mlsys.cold-start", label="Model cold start", tooltip="Delay before a newly started replica can serve, from provisioning, loading weights, and warming runtime state."];
"mlsys.chunked-prefill" [id="concept-mlsys.chunked-prefill", label="Chunked prefill", tooltip="Splitting a long prompt's prefill into chunks interleaved with decode steps to bound per-iteration latency."];
"mlsys.pd-disaggregation" [id="concept-mlsys.pd-disaggregation", label="Prefill-decode\ndisaggregation", tooltip="Running prefill and decode on separate resource pools, transferring KV state between them, so each phase is provisioned and batched independently."];
"mlsys.sampling-controls" [id="concept-mlsys.sampling-controls", label="Decoding and sampling\ncontrols", tooltip="Parameters and rules, such as greedy, temperature, top-k, and nucleus sampling, that determine how tokens are chosen from a model's distribution."];
"mlsys.constrained-decoding" [id="concept-mlsys.constrained-decoding", label="Constrained decoding", tooltip="A generation mechanism that restricts token choices to continuations permitted by an output constraint, so a successfully completed output satisfies the supported syntax or schema constraints."];
"mlsys.output-validation" [id="concept-mlsys.output-validation", label="Output validation", tooltip="Checking generated output against declared schemas or rules and reporting whether it satisfies them."];
"mlsys.reasoning-budget" [id="concept-mlsys.reasoning-budget", label="Reasoning budget", tooltip="A limit on the intermediate tokens or steps a model may spend before answering, set to trade quality against latency and cost."];
"mlsys.best-of-n" [id="concept-mlsys.best-of-n", label="Best-of-n sampling", tooltip="Generating n candidate outputs and returning the one ranked highest by a scorer or verifier."];
"mlsys.self-consistency" [id="concept-mlsys.self-consistency", label="Self-consistency voting", tooltip="Sampling multiple reasoning paths and returning the most frequent final answer."];
"mlsys.verifier" [id="concept-mlsys.verifier", label="Verifier", tooltip="A model or program that judges whether a candidate output or reasoning step is correct, used for selection, search, or reward."];
"mlsys.process-reward-model" [id="concept-mlsys.process-reward-model", label="Process reward model", tooltip="A verifier that scores intermediate reasoning steps rather than only final answers."];
"mlsys.inference-time-search" [id="concept-mlsys.inference-time-search", label="Inference-time search", tooltip="Exploring a tree of partial solutions, as in beam or tree search, guided by a scorer, to find a higher-quality output."];
"mlsys.test-time-scaling" [id="concept-mlsys.test-time-scaling", label="Test-time scaling", tooltip="The empirical relation between inference compute spent per query and output quality, used to allocate compute between model size and inference."];
"mlsys.rag" [id="concept-mlsys.rag", label="Retrieval-augmented\ngeneration", tooltip="Conditioning generation on documents retrieved for the request so outputs can draw on information outside the model's parameters."];
"mlsys.dense-retrieval" [id="concept-mlsys.dense-retrieval", label="Dense retrieval", tooltip="Retrieving records by similarity between learned embeddings of query and records."];
"mlsys.lexical-retrieval" [id="concept-mlsys.lexical-retrieval", label="Lexical retrieval", tooltip="Retrieving records by weighted term overlap with the query using an inverted index, as in BM25."];
"mlsys.reranking" [id="concept-mlsys.reranking", label="Reranking", tooltip="Reordering a retrieved candidate set with a more expensive relevance model before use."];
"mlsys.model-conversion" [id="concept-mlsys.model-conversion", label="Model conversion", tooltip="Translating a trained model into the format and operator set of a target runtime, possibly changing numerics and supported operations."];
"mlsys.on-device-runtime" [id="concept-mlsys.on-device-runtime", label="On-device inference\nruntime", tooltip="An interpreter or compiled engine that executes models locally on personal or embedded devices, including inside browsers, under the target environment's memory, operator, and execution limits."];
"mlsys.ota-model-update" [id="concept-mlsys.ota-model-update", label="Over-the-air model\nupdate", tooltip="Delivering model weights to deployed devices remotely, whether the first download after installation or a later version, with staging, verification, and rollback across the device fleet."];
"mlsys.device-cloud-partitioning" [id="concept-mlsys.device-cloud-partitioning", label="Device-cloud\npartitioning", tooltip="Splitting inference between device and server, by layer or by model, to balance latency, energy, bandwidth, and privacy."];
"mlsys.device-heterogeneity" [id="concept-mlsys.device-heterogeneity", label="Device heterogeneity", tooltip="Variation in hardware, operating system, and runtime capability across a deployed device fleet that a single model release must accommodate."];
"mlsys.model-registry" [id="concept-mlsys.model-registry", label="Model registry", tooltip="A versioned store of model artifacts with metadata, lineage, and lifecycle stage used to govern promotion and deployment."];
"mlsys.shadow-deployment" [id="concept-mlsys.shadow-deployment", label="Shadow deployment", tooltip="Running a candidate model on live traffic without serving its outputs, to compare it against the production model."];
"mlsys.ml-ci-cd" [id="concept-mlsys.ml-ci-cd", label="CI/CD for ML", tooltip="Automated building, testing, and deployment of ML code, data checks, and model artifacts on each change."];
"mlsys.release-gate" [id="concept-mlsys.release-gate", label="Release gate", tooltip="A predeclared set of checks a candidate model must pass before it advances to a wider deployment stage."];
"mlsys.drift-detection" [id="concept-mlsys.drift-detection", label="Drift detection", tooltip="Statistical tests or distances comparing production and reference distributions of inputs, predictions, or outcomes to flag change."];
"mlsys.inference-logging" [id="concept-mlsys.inference-logging", label="Prediction logging", tooltip="Recording requests, model versions, outputs, and later outcomes so production behavior can be analyzed, debugged, and reused as data."];
"mlsys.alerting" [id="concept-mlsys.alerting", label="Alerting", tooltip="Rules that turn monitored signals into notifications for responders, tuned to balance missed incidents against alert fatigue."];
"mlsys.retraining" [id="concept-mlsys.retraining", label="Retraining", tooltip="Training a replacement version of a deployed model on updated or revised data, with timing and data chosen to balance staleness against training and validation cost."];
"mlsys.continuous-training" [id="concept-mlsys.continuous-training", label="Continuous training", tooltip="An automated pipeline that retrains, validates, and proposes models on a schedule or when triggered by data or performance signals."];
"mlsys.postmortem" [id="concept-mlsys.postmortem", label="Blameless postmortem", tooltip="A written analysis after an incident of its timeline, causes, and corrective actions, focused on system fixes rather than blame."];
"mlsys.failure-attribution" [id="concept-mlsys.failure-attribution", label="ML failure attribution", tooltip="Determining whether a production failure stems from data, model, code, configuration, or infrastructure, or from an adversary."];
"mlsys.configuration-management" [id="concept-mlsys.configuration-management", label="ML configuration\nmanagement", tooltip="Treating model, feature, and pipeline configuration as versioned, reviewed, and tested code."];
"mlsys.infrastructure-as-code" [id="concept-mlsys.infrastructure-as-code", label="Infrastructure as code", tooltip="Declaring compute, storage, and service infrastructure in versioned machine-readable files from which environments are provisioned."];
"mlsys.ml-platform" [id="concept-mlsys.ml-platform", label="ML platform", tooltip="Shared internal infrastructure and services that standardize how teams train, deploy, and operate models."];
"mlsys.technical-debt" [id="concept-mlsys.technical-debt", label="ML technical debt", tooltip="Accumulated system costs from shortcuts in ML code, data dependencies, configuration, and pipelines that make future change slower and riskier."];
"mlsys.entanglement" [id="concept-mlsys.entanglement", label="Entanglement", tooltip="The property that changing any input, feature, or hyperparameter of a model can change its behavior on everything else."];
"mlsys.undeclared-consumers" [id="concept-mlsys.undeclared-consumers", label="Undeclared consumers", tooltip="Systems that use a model's outputs without the model owner's knowledge, creating hidden coupling."];
"mlsys.mlops-maturity" [id="concept-mlsys.mlops-maturity", label="MLOps maturity", tooltip="Staged levels of automation, from manual training and deployment to automated continuous training and delivery."];
"mlsys.ml-roles" [id="concept-mlsys.ml-roles", label="ML team roles", tooltip="The division of responsibilities among data, modeling, platform, and operations roles that owns an ML system across its lifecycle."];
"mlsys.model-deprecation" [id="concept-mlsys.model-deprecation", label="Model deprecation", tooltip="Planned withdrawal of a model from service, including notifying and migrating its consumers before removing it."];
"mlsys.artifact-archival" [id="concept-mlsys.artifact-archival", label="Artifact archival", tooltip="Preserving retired models, data references, and evaluation records needed for audit, reproduction, or rollback after service ends."];
"mlsys.data-retention" [id="concept-mlsys.data-retention", label="Data retention", tooltip="Policy and mechanisms that set how long data, logs, and derived artifacts are kept and when they are deleted."];
"mlsys.model-flops-utilization" [id="concept-mlsys.model-flops-utilization", label="Model FLOPs utilization", tooltip="Model-required floating-point operations per second achieved, divided by the aggregate peak FLOP rate of the hardware used, excluding recomputation."];
"mlsys.bottleneck-analysis" [id="concept-mlsys.bottleneck-analysis", label="Bottleneck analysis", tooltip="Identifying the resource or stage, such as compute, memory bandwidth, I/O, or communication, whose capacity limits end-to-end throughput or latency for a workload."];
"mlsys.training-goodput" [id="concept-mlsys.training-goodput", label="Training goodput", tooltip="The fraction of allocated accelerator time that produces retained training progress, after losses to scheduling, failures, restarts, and lost work."];
"mlsys.pruning" [id="concept-mlsys.pruning", label="Pruning", tooltip="Removing weights, neurons, channels, or other structures judged unimportant from a network, usually followed by fine-tuning to recover quality."];
"mlsys.structured-pruning" [id="concept-mlsys.structured-pruning", label="Structured pruning", tooltip="Pruning whole channels, filters, heads, or layers so that the remaining model stays dense and runs faster without sparse-execution support."];
"mlsys.low-rank-factorization" [id="concept-mlsys.low-rank-factorization", label="Low-rank factorization", tooltip="Approximating a weight matrix or tensor by a product of smaller factors of reduced rank to cut parameters and operations."];
"mlsys.quantization-aware-training" [id="concept-mlsys.quantization-aware-training", label="Quantization-aware\ntraining", tooltip="Training or fine-tuning with simulated quantization in the forward pass so the model adapts to reduced precision, in contrast to post-training quantization."];
"mlsys.neural-architecture-search" [id="concept-mlsys.neural-architecture-search", label="Neural architecture\nsearch", tooltip="Automated search over a defined space of network architectures for designs that optimize a stated objective such as accuracy under a cost budget."];
"mlsys.hardware-aware-nas" [id="concept-mlsys.hardware-aware-nas", label="Hardware-aware NAS", tooltip="Architecture search whose objective includes latency, energy, or memory measured or predicted on the target device rather than proxy counts such as FLOPs."];
"mlsys.depthwise-separable-convolution" [id="concept-mlsys.depthwise-separable-convolution", label="Depthwise separable\nconvolution", tooltip="Factoring a standard convolution into a per-channel spatial convolution followed by a pointwise convolution, reducing operations and parameters."];
"mlsys.efficiency-frontier" [id="concept-mlsys.efficiency-frontier", label="Accuracy-efficiency\nfrontier", tooltip="The set of model configurations for which no alternative improves quality without worsening a stated cost measure, such as latency, memory, or energy, on a stated platform."];
"mlsys.model-hardware-co-design" [id="concept-mlsys.model-hardware-co-design", label="Model-hardware co-\ndesign", tooltip="Jointly choosing model architecture and hardware or kernel design so that each exploits the other's structure."];
"mlsys.retry-backoff" [id="concept-mlsys.retry-backoff", label="Retry with backoff", tooltip="Reissuing a failed request after increasing, typically jittered, delays and within a retry budget, so that transient faults recover without overloading dependencies."];
"mlsys.circuit-breaker" [id="concept-mlsys.circuit-breaker", label="Circuit breaker", tooltip="A client-side guard that stops sending requests to a failing dependency after an error threshold and probes it before resuming traffic."];
"mlsys.replication-failover" [id="concept-mlsys.replication-failover", label="Replication and\nfailover", tooltip="Maintaining redundant replicas of a service or state and redirecting work to a healthy replica when one fails."];
"mlsys.graceful-degradation" [id="concept-mlsys.graceful-degradation", label="Graceful degradation", tooltip="Continuing to serve with reduced quality, features, or freshness under failure or overload instead of failing outright."];
"mlsys.checkpoint-interval" [id="concept-mlsys.checkpoint-interval", label="Optimal checkpoint\ninterval", tooltip="The checkpoint period that minimizes expected lost time, balancing checkpoint write cost against expected rework, approximately the square root of twice the write cost times MTBF."];
"mlsys.async-checkpointing" [id="concept-mlsys.async-checkpointing", label="Asynchronous\ncheckpointing", tooltip="Snapshotting training state quickly to host memory and persisting it in the background so computation resumes before the durable write completes."];
"mlsys.silent-data-corruption" [id="concept-mlsys.silent-data-corruption", label="Silent data corruption", tooltip="Hardware producing wrong computational results without raising an error or crash, so the corruption propagates undetected."];
"mlsys.mtbf" [id="concept-mlsys.mtbf", label="Mean time between\nfailures", tooltip="The expected operating time between failures of a component or system; for independent components, system MTBF shrinks roughly in inverse proportion to component count."];
"mlsys.availability" [id="concept-mlsys.availability", label="Availability", tooltip="The fraction of time or requests for which a system performs its specified function, approximately MTBF divided by MTBF plus mean time to repair."];
"mlsys.gray-failure" [id="concept-mlsys.gray-failure", label="Gray failure", tooltip="A partial or degraded failure that some observers detect and others do not, such as a slow or lossy node that still passes health checks."];
"mlsys.failure-domain" [id="concept-mlsys.failure-domain", label="Failure domain", tooltip="A set of components that can fail together from a shared cause, such as a rack, power feed, switch, or software release."];
"mlsys.abft" [id="concept-mlsys.abft", label="Algorithm-based fault\ntolerance", tooltip="Detecting or correcting computational errors by carrying checksums through an algorithm, such as matrix multiplication, and verifying invariants on its outputs."];
"mlsys.chaos-engineering" [id="concept-mlsys.chaos-engineering", label="Chaos engineering", tooltip="Running controlled experiments that inject real-world failures into production-like systems to test a hypothesis about steady-state behavior."];
"mlsys.game-day" [id="concept-mlsys.game-day", label="Game day", tooltip="A scheduled exercise in which teams deliberately trigger failure scenarios to rehearse detection, response, and recovery procedures."];
"mlsys.hardware-fault-injection" [id="concept-mlsys.hardware-fault-injection", label="Hardware fault\ninjection", tooltip="Emulating hardware faults such as bit flips in weights, activations, or registers to measure how errors propagate to model outputs."];
"mlsys.blast-radius" [id="concept-mlsys.blast-radius", label="Blast radius", tooltip="The extent of users, components, or effects that a single fault, change, or experiment can impact."];
"mlsys.backdoor" [id="concept-mlsys.backdoor", label="Backdoor attack", tooltip="Implanting a hidden behavior in a model, via poisoned data or modified weights, that activates only on inputs containing an attacker-chosen trigger."];
"mlsys.jailbreak" [id="concept-mlsys.jailbreak", label="Jailbreak", tooltip="A user-crafted input that induces a model to bypass its safety training or usage policy and produce disallowed output."];
"mlsys.adversarial-training" [id="concept-mlsys.adversarial-training", label="Adversarial training", tooltip="Training on adversarially perturbed inputs generated during training to increase robustness within a specified perturbation set."];
"mlsys.model-extraction" [id="concept-mlsys.model-extraction", label="Model extraction", tooltip="Reconstructing a functionally equivalent copy or the parameters of a model by querying its prediction interface."];
"mlsys.model-watermarking" [id="concept-mlsys.model-watermarking", label="Model watermarking", tooltip="Embedding a verifiable signature in a model's parameters or its behavior on trigger inputs so that ownership of copies or derivatives can later be demonstrated, with survival under fine-tuning, pruning, and distillation deciding its value."];
"mlsys.artifact-signing" [id="concept-mlsys.artifact-signing", label="Model artifact signing", tooltip="Cryptographically signing model files and their provenance metadata so that consumers can verify integrity and origin before loading."];
"mlsys.unsafe-deserialization" [id="concept-mlsys.unsafe-deserialization", label="Unsafe model\ndeserialization", tooltip="Code execution triggered by loading a model stored in an executable serialization format, such as pickle, from an untrusted source."];
"mlsys.supply-chain-compromise" [id="concept-mlsys.supply-chain-compromise", label="ML supply-chain\ncompromise", tooltip="Introducing malicious or vulnerable components into an ML system through third-party datasets, pretrained weights, libraries, build tools, or hardware."];
"mlsys.membership-inference" [id="concept-mlsys.membership-inference", label="Membership inference", tooltip="Inferring whether a specific record was in a model's training data from the model's outputs or parameters."];
"mlsys.model-inversion" [id="concept-mlsys.model-inversion", label="Model inversion", tooltip="Reconstructing sensitive attributes or representative training inputs from a model's outputs, confidence scores, or shared parameter gradients."];
"mlsys.dp-sgd" [id="concept-mlsys.dp-sgd", label="DP-SGD", tooltip="Stochastic gradient descent with per-example gradient clipping and calibrated noise, with privacy loss tracked across steps by an accountant."];
"mlsys.machine-unlearning" [id="concept-mlsys.machine-unlearning", label="Machine unlearning", tooltip="Removing the influence of specified training records from a trained model, either exactly by retraining or approximately at lower cost."];
"mlsys.secure-aggregation" [id="concept-mlsys.secure-aggregation", label="Secure aggregation", tooltip="A cryptographic protocol that lets a server compute the sum of client updates without seeing any individual client's update."];
"mlsys.least-privilege" [id="concept-mlsys.least-privilege", label="Least privilege", tooltip="Granting each component or actor only the permissions its task requires, for only as long as it requires them."];
"mlsys.confidential-computing" [id="concept-mlsys.confidential-computing", label="Confidential computing", tooltip="Protecting data and models while in use by running computation inside hardware-isolated, attestable trusted execution environments."];
"mlsys.remote-attestation" [id="concept-mlsys.remote-attestation", label="Remote attestation", tooltip="A procedure by which a platform proves to a remote verifier the identity and measured state of its hardware and software before receiving secrets."];
"mlsys.side-channel" [id="concept-mlsys.side-channel", label="Side-channel attack", tooltip="Inferring secrets from observable resource behavior, such as timing, power, memory, or cache contention, across an isolation boundary."];
"mlsys.carbon-intensity" [id="concept-mlsys.carbon-intensity", label="Grid carbon intensity", tooltip="Greenhouse-gas emissions per unit of electricity supplied, varying by region, time, and generation mix, in grams CO2-equivalent per kilowatt-hour."];
"mlsys.operational-carbon" [id="concept-mlsys.operational-carbon", label="Operational carbon", tooltip="Emissions from electricity consumed while operating a system, computed from energy use and the carbon intensity of its supply."];
"mlsys.emission-scopes" [id="concept-mlsys.emission-scopes", label="Emission scopes", tooltip="The GHG Protocol classification of emissions into direct (Scope 1), purchased energy (Scope 2), and value-chain (Scope 3) categories."];
"mlsys.carbon-aware-scheduling" [id="concept-mlsys.carbon-aware-scheduling", label="Carbon-aware scheduling", tooltip="Shifting flexible workloads in time or location toward periods and regions of lower grid carbon intensity, subject to deadlines and capacity."];
"mlsys.energy-per-inference" [id="concept-mlsys.energy-per-inference", label="Energy per inference", tooltip="Energy consumed to process one input end to end on a device, the binding metric for battery-powered and energy-harvesting deployments."];
"mlsys.embodied-carbon" [id="concept-mlsys.embodied-carbon", label="Embodied carbon", tooltip="Emissions from manufacturing, transporting, and disposing of hardware and facilities, attributed to a system independent of its operation."];
"mlsys.lifecycle-assessment" [id="concept-mlsys.lifecycle-assessment", label="Life cycle assessment", tooltip="A standardized method for compiling and evaluating a product's environmental inputs, outputs, and impacts from raw materials through disposal."];
"mlsys.water-footprint" [id="concept-mlsys.water-footprint", label="Water footprint", tooltip="Water withdrawn or consumed by a system, on site for cooling and off site for electricity generation, per unit of work or over its lifetime."];
"mlsys.hardware-lifetime" [id="concept-mlsys.hardware-lifetime", label="Hardware service\nlifetime", tooltip="The period a hardware asset stays in service before replacement, over which its embodied impacts and capital cost are amortized."];
"mlsys.e-waste" [id="concept-mlsys.e-waste", label="Electronic waste", tooltip="Discarded electronic equipment and components, including retired accelerators and servers, and the hazards and lost materials of their disposal."];
"mlsys.tco" [id="concept-mlsys.tco", label="Total cost of ownership", tooltip="The full cost of acquiring and operating a system over its life, including capital, energy, facilities, networking, staff, and amortization."];
"mlsys.cost-per-token" [id="concept-mlsys.cost-per-token", label="Cost per token", tooltip="Serving or API expenditure divided by tokens processed or generated, often priced separately for input and output tokens."];
"mlsys.cost-attribution" [id="concept-mlsys.cost-attribution", label="Cost attribution", tooltip="Allocating shared infrastructure spend to teams, models, or workloads so that owners see and act on their costs."];
"mlsys.hazard-analysis" [id="concept-mlsys.hazard-analysis", label="Hazard analysis", tooltip="Systematically identifying conditions under which a system could contribute to harm, with their causes, severity, and required controls."];
"mlsys.stpa" [id="concept-mlsys.stpa", label="System-theoretic\nprocess analysis", tooltip="Hazard analysis that models a system as a control structure and identifies unsafe control actions and the flawed feedback or process models that cause them."];
"mlsys.fmea" [id="concept-mlsys.fmea", label="Failure modes and\neffects analysis", tooltip="Enumerating each component's possible failure modes and tracing their effects on system behavior to rank and mitigate them."];
"mlsys.functional-insufficiency" [id="concept-mlsys.functional-insufficiency", label="Functional\ninsufficiency", tooltip="An insufficiency in the specification or performance of an intended function that can contribute to hazardous behavior without a fault covered by functional-safety analysis."];
"mlsys.safety-filter" [id="concept-mlsys.safety-filter", label="Safety filter", tooltip="A runtime component that passes a proposed action when it is certified safe and otherwise replaces it with a minimally different safe action."];
"mlsys.control-barrier-function" [id="concept-mlsys.control-barrier-function", label="Control barrier\nfunction", tooltip="A function whose sign defines a safe set and whose derivative condition yields input constraints that keep the system state inside that set."];
"mlsys.simplex-architecture" [id="concept-mlsys.simplex-architecture", label="Simplex architecture", tooltip="Pairing an unverified high-performance controller with a verified safety controller and a decision module that switches to the safety controller before safety is lost."];
"mlsys.minimal-risk-condition" [id="concept-mlsys.minimal-risk-condition", label="Minimal-risk condition", tooltip="A predefined reduced-capability state the system reaches when it can no longer operate safely, often via an ordered ladder of fallback behaviors."];
"mlsys.guardrails" [id="concept-mlsys.guardrails", label="Guardrails", tooltip="Runtime checks on model inputs and outputs that detect and block, rewrite, or escalate content or actions violating a stated safety policy."];
"mlsys.scenario-based-testing" [id="concept-mlsys.scenario-based-testing", label="Scenario-based testing", tooltip="Validating a system against a structured catalog of operating scenarios and their parameter ranges, with coverage measured over the operating domain."];
"mlsys.falsification" [id="concept-mlsys.falsification", label="Simulation-based\nfalsification", tooltip="Searching scenario parameters, often guided by temporal-logic robustness, to find counterexamples that violate a safety specification."];
"mlsys.formal-verification" [id="concept-mlsys.formal-verification", label="Formal verification", tooltip="Mathematically proving that a model of a system satisfies a formal specification for all behaviors within stated assumptions."];
"mlsys.neural-network-verification" [id="concept-mlsys.neural-network-verification", label="Neural network\nverification", tooltip="Proving or refuting input-output properties of a trained network over a bounded input region, such as local robustness, using exact or bound-propagation methods."];
"mlsys.rare-event-validation" [id="concept-mlsys.rare-event-validation", label="Rare-event safety\nvalidation", tooltip="Estimating or bounding failure probabilities too small to observe in feasible exposure, using importance sampling, extreme-value models, or zero-failure statistical bounds."];
"mlsys.xil-testing" [id="concept-mlsys.xil-testing", label="X-in-the-loop testing", tooltip="A qualification ladder that runs the real software, then real hardware, against simulated or recorded environments before physical trials."];
"mlsys.goal-structuring-notation" [id="concept-mlsys.goal-structuring-notation", label="Goal Structuring\nNotation", tooltip="A graphical notation for safety cases that links goals, strategies, solutions (evidence), context, and assumptions into an explicit argument structure."];
"mlsys.functional-safety" [id="concept-mlsys.functional-safety", label="Functional safety", tooltip="Absence of unreasonable risk from malfunctioning electrical or electronic systems, achieved through a standardized safety lifecycle such as IEC 61508 or ISO 26262."];
"mlsys.safety-integrity-level" [id="concept-mlsys.safety-integrity-level", label="Safety integrity level", tooltip="A graded risk class assigned to a safety function that sets the rigor of development, verification, and tolerable failure rate required."];
"mlsys.safety-performance-indicator" [id="concept-mlsys.safety-performance-indicator", label="Safety performance\nindicator", tooltip="A field-measured metric tied to a safety-case claim whose threshold violation signals that the argument may no longer hold."];
"mlsys.group-fairness-metric" [id="concept-mlsys.group-fairness-metric", label="Group fairness metrics", tooltip="Statistics comparing selection rates, error rates, or calibration of a model's decisions across protected groups."];
"mlsys.individual-fairness" [id="concept-mlsys.individual-fairness", label="Individual fairness", tooltip="A requirement that individuals who are similar with respect to the task receive similar outcomes under a stated similarity metric."];
"mlsys.fairness-incompatibility" [id="concept-mlsys.fairness-incompatibility", label="Fairness criteria\nincompatibility", tooltip="The result that calibration and error-rate parity across groups cannot generally hold together when base rates differ, forcing an explicit choice among criteria."];
"mlsys.bias-mitigation" [id="concept-mlsys.bias-mitigation", label="Bias mitigation", tooltip="Interventions on data (pre-processing), training objective (in-processing), or decisions (post-processing) that reduce measured disparities, usually at some cost in other metrics."];
"mlsys.feature-attribution" [id="concept-mlsys.feature-attribution", label="Feature attribution", tooltip="Post-hoc explanation assigning each input feature a contribution to a specific prediction."];
"mlsys.counterfactual-explanation" [id="concept-mlsys.counterfactual-explanation", label="Counterfactual\nexplanation", tooltip="An explanation stating the smallest feasible change to an input that would change the model's decision."];
"mlsys.interpretable-model" [id="concept-mlsys.interpretable-model", label="Inherently\ninterpretable model", tooltip="A model whose structure, such as a sparse linear model, short rule list, or shallow tree, can be directly inspected to understand its predictions."];
"mlsys.model-card" [id="concept-mlsys.model-card", label="Model card", tooltip="A standardized document reporting a model's intended use, evaluation results across conditions and groups, limitations, and ethical considerations."];
"mlsys.datasheet" [id="concept-mlsys.datasheet", label="Datasheet for datasets", tooltip="A standardized document recording a dataset's motivation, composition, collection process, preprocessing, intended uses, and maintenance."];
"mlsys.contestability" [id="concept-mlsys.contestability", label="Contestability and\nrecourse", tooltip="The ability of an affected person to understand, challenge, and obtain review or reversal of a consequential automated decision."];
"mlsys.automation-bias" [id="concept-mlsys.automation-bias", label="Automation bias", tooltip="The tendency of human supervisors to over-rely on automated outputs and to lose the vigilance and skill needed to catch their errors."];
"mlsys.authority-handover" [id="concept-mlsys.authority-handover", label="Authority handover", tooltip="Transfer of control between an automated system and a human operator, bounded by human reaction time, situational awareness, and mode clarity."];
"mlsys.ai-risk-management" [id="concept-mlsys.ai-risk-management", label="AI risk management", tooltip="An organizational process to govern, map, measure, and manage risks of AI systems throughout their lifecycle."];
"mlsys.impact-assessment" [id="concept-mlsys.impact-assessment", label="Algorithmic impact\nassessment", tooltip="A structured pre-deployment analysis of who an AI system could affect, how, and with what severity, used to decide mitigations or whether to deploy."];
"mlsys.algorithmic-audit" [id="concept-mlsys.algorithmic-audit", label="Algorithmic audit", tooltip="An internal or independent examination of an AI system's development records and behavior against stated requirements, standards, or law."];
"mlsys.risk-tiered-regulation" [id="concept-mlsys.risk-tiered-regulation", label="Risk-tiered AI\nregulation", tooltip="Law that classifies AI uses by risk level and imposes obligations, such as conformity assessment, documentation, and human oversight, scaled to that level."];
"mlsys.frontier-safety-framework" [id="concept-mlsys.frontier-safety-framework", label="Frontier safety\nframework", tooltip="A developer policy that ties dangerous-capability evaluation thresholds to required safeguards before further training or deployment of frontier models."];
"mlsys.context-compaction" [id="concept-mlsys.context-compaction", label="Context compaction", tooltip="Replacing older parts of an agent's context with summaries or structured records so a long task fits the model's input budget."];
"mlsys.context-degradation" [id="concept-mlsys.context-degradation", label="Long-context\ndegradation", tooltip="Decline in a model's use of relevant information as context grows or as that information sits away from the context's start or end."];
"mlsys.agent-memory" [id="concept-mlsys.agent-memory", label="Long-term agent memory", tooltip="A persistent store an agent writes to and retrieves from across calls and sessions, with policies for consolidation, expiry, and invalidation."];
"mlsys.function-calling" [id="concept-mlsys.function-calling", label="Function calling", tooltip="A model emitting a structured invocation of a declared tool, which the harness validates, executes, and returns as an observation."];
"mlsys.model-context-protocol" [id="concept-mlsys.model-context-protocol", label="Tool discovery protocol", tooltip="A shared client-server interface through which agent hosts discover the tools, resources, and prompts external services expose, with their schemas, reducing custom integration."];
"mlsys.computer-use" [id="concept-mlsys.computer-use", label="Computer use", tooltip="An agent operating graphical software through screenshots or accessibility trees and synthesized keyboard and pointer input."];
"mlsys.agent-harness" [id="concept-mlsys.agent-harness", label="Agent harness", tooltip="The runtime that repeatedly calls a model, dispatches its tool actions, appends observations, and decides whether the trajectory continues, pauses, or ends."];
"mlsys.agent-budget" [id="concept-mlsys.agent-budget", label="Agent execution budget", tooltip="Limits on turns, tokens, wall-clock time, or spend for a trajectory, with stopping rules applied when a limit or completion criterion is reached."];
"mlsys.approval-gate" [id="concept-mlsys.approval-gate", label="Action approval gate", tooltip="A harness checkpoint that holds a specific proposed action until an authorized human or policy approves it, binding the approval to that exact action."];
"mlsys.durable-execution" [id="concept-mlsys.durable-execution", label="Durable execution", tooltip="Execution that persists workflow progress and reuses recorded results on recovery, with external-effect guarantees determined by endpoint idempotency, transactional boundaries, and reconciliation."];
"mlsys.deterministic-replay" [id="concept-mlsys.deterministic-replay", label="Record and replay", tooltip="Re-executing a trajectory from its log by substituting recorded model outputs and tool results, to reproduce, debug, or test a divergence."];
"mlsys.suspend-resume" [id="concept-mlsys.suspend-resume", label="Suspend and resume", tooltip="Persisting a trajectory while it waits on a human, timer, or external event, then resuming with a validated state and authority."];
"mlsys.multi-agent-orchestration" [id="concept-mlsys.multi-agent-orchestration", label="Multi-agent\norchestration", tooltip="Structuring a task as delegated subtasks among agents under a topology, such as orchestrator-worker or peer, with typed handoffs and result merging."];
"mlsys.shared-agent-state" [id="concept-mlsys.shared-agent-state", label="Shared agent state", tooltip="Task state read and written by several agents, requiring concurrency control such as leases or optimistic versioning to avoid lost or conflicting updates."];
"mlsys.coordination-failure" [id="concept-mlsys.coordination-failure", label="Multi-agent\ncoordination failure", tooltip="Task failure arising from interaction among agents, such as mis-specified delegation, lost context at handoff, conflicting actions, or premature termination."];
"mlsys.correlated-agent-errors" [id="concept-mlsys.correlated-agent-errors", label="Correlated agent errors", tooltip="Errors shared across agents built on the same model or prompts, which make voting, debate, or cross-checking less independent than assumed."];
"mlsys.robot-perception" [id="concept-mlsys.robot-perception", label="Robot perception", tooltip="Models that convert raw sensor streams into task-relevant scene estimates, such as detections, segmentation, depth, and pose, under latency limits."];
"mlsys.sensor-fusion" [id="concept-mlsys.sensor-fusion", label="Sensor fusion", tooltip="Combining measurements from multiple sensors or modalities, at raw, feature, or decision level, into one estimate more accurate or robust than any single source."];
"mlsys.time-synchronization" [id="concept-mlsys.time-synchronization", label="Sensor time\nsynchronization", tooltip="Aligning clocks and timestamps across sensors, compute, and actuators so measurements can be associated with the physical instant they describe."];
"mlsys.recursive-filtering" [id="concept-mlsys.recursive-filtering", label="Recursive state\nfiltering", tooltip="Updating a state estimate and its uncertainty by alternating model-based prediction with measurement correction at each step."];
"mlsys.slam" [id="concept-mlsys.slam", label="Simultaneous\nlocalization and\nmapping", tooltip="Jointly estimating a platform's pose and a map of an unknown environment from its own sensor observations."];
"mlsys.world-model" [id="concept-mlsys.world-model", label="Learned world model", tooltip="A learned model that predicts future observations or latent states conditioned on actions, used for planning, policy training, or simulation."];
"mlsys.motion-planning" [id="concept-mlsys.motion-planning", label="Motion planning", tooltip="Computing a collision-free path or trajectory from a start to a goal configuration using search, sampling, or trajectory optimization."];
"mlsys.model-predictive-control" [id="concept-mlsys.model-predictive-control", label="Model predictive\ncontrol", tooltip="Repeatedly solving a finite-horizon constrained optimal control problem from the current state and applying only the first input."];
"mlsys.real-time-scheduling" [id="concept-mlsys.real-time-scheduling", label="Real-time scheduling", tooltip="Assigning processor time to periodic and sporadic tasks so that each meets its deadline, with schedulability established by analysis."];
"mlsys.mixed-criticality" [id="concept-mlsys.mixed-criticality", label="Mixed-criticality\npartitioning", tooltip="Running functions of different assurance levels on shared hardware while preventing lower-criticality work from delaying or corrupting higher-criticality functions."];
"mlsys.vla-model" [id="concept-mlsys.vla-model", label="Vision-language-action\nmodel", tooltip="A policy built on a pretrained vision-language backbone that maps images and language instructions to robot actions."];
"mlsys.teleoperation-data" [id="concept-mlsys.teleoperation-data", label="Teleoperation data", tooltip="Robot demonstrations collected by humans driving the robot remotely, whose cost, coverage, and action-label fidelity bound imitation-learned policies."];
"mlsys.action-chunking" [id="concept-mlsys.action-chunking", label="Action chunking", tooltip="Predicting a short sequence of future actions per policy inference, decoupling model invocation rate from control rate and reducing compounding error."];
"mlsys.domain-randomization" [id="concept-mlsys.domain-randomization", label="Domain randomization", tooltip="Training in simulation over randomized visual and physical parameters so the policy treats the real world as one more variation."];
"mlsys.thread-hierarchy" [id="concept-mlsys.thread-hierarchy", label="Thread hierarchy", tooltip="The decomposition of a kernel into grids of thread blocks and warps that share on-chip memory and synchronize at defined scopes."];
"mlsys.memory-coalescing" [id="concept-mlsys.memory-coalescing", label="Memory coalescing", tooltip="Combining memory requests from threads in a warp into fewer global-memory transactions, reducing wasted memory traffic."];
"mlsys.occupancy" [id="concept-mlsys.occupancy", label="Occupancy and latency\nhiding", tooltip="The ratio of resident to maximum warps, and how oversubscribing threads hides memory latency at the cost of registers and shared memory per thread."];
"mlsys.async-data-movement" [id="concept-mlsys.async-data-movement", label="Asynchronous data\nmovement", tooltip="Transferring data into on-chip memory while independent computation proceeds, with explicit synchronization on the transfer's completion; hardware copy engines and producer-consumer warp roles are its implementations."];
"mlsys.matrix-engine-programming" [id="concept-mlsys.matrix-engine-programming", label="Matrix-engine\nprogramming", tooltip="Issuing tile-level matrix-multiply-accumulate instructions with the layouts, fragment shapes, and precisions a tensor-core-class unit requires."];
"mlsys.embedding-table-sharding" [id="concept-mlsys.embedding-table-sharding", label="Embedding-table\nsharding", tooltip="Partitioning very large sparse embedding tables row-, column-, or table-wise across devices, usually model-parallel beside data-parallel dense layers."];
"mlsys.embedding-cache" [id="concept-mlsys.embedding-cache", label="Embedding cache and\ntiering", tooltip="Keeping frequently accessed embedding rows in accelerator memory and cold rows in host memory or SSD, exploiting the skew of lookups."];
"mlsys.parameter-server" [id="concept-mlsys.parameter-server", label="Parameter server", tooltip="An architecture in which workers pull and push model parameters from sharded server processes, common for sparse recommendation models and asynchronous training."];
"mlsys.ranking-funnel" [id="concept-mlsys.ranking-funnel", label="Multi-stage retrieval\nand ranking", tooltip="Candidate generation followed by progressively costlier ranking stages under one latency budget, the dominant architecture for recommendation and search."];
"mlsys.multimodal-model" [id="concept-mlsys.multimodal-model", label="Multimodal model", tooltip="A model that consumes or produces several modalities, such as text, images, audio, or video, through modality encoders feeding a shared backbone."];
"mlsys.modality-encoder" [id="concept-mlsys.modality-encoder", label="Modality encoder", tooltip="A network that turns images, audio, or video into token sequences for a shared backbone; visual tokens often dominate prefill cost and KV size."];
"mlsys.encoder-disaggregation" [id="concept-mlsys.encoder-disaggregation", label="Multimodal encoder\ndisaggregation", tooltip="Scheduling modality encoders separately from prefill and decode and caching encoder outputs so image or audio inputs do not stall token generation."];
"mlsys.auto-parallelization" [id="concept-mlsys.auto-parallelization", label="Automatic\nparallelization", tooltip="Compiler-derived multi-device partitioning of a single-device program, found by propagating sharding annotations or by searching parallelism strategies under a cost model."];
"mlsys.sharding-propagation" [id="concept-mlsys.sharding-propagation", label="Sharding annotation and\npropagation", tooltip="Annotating a few tensors with layouts over a device mesh and letting the compiler infer the remaining layouts and insert required collectives, yielding one SPMD program."];
"mlsys.device-mesh" [id="concept-mlsys.device-mesh", label="Device mesh", tooltip="A logical multidimensional arrangement of devices whose axes are assigned to parallelism dimensions, usually aligned so the busiest axis maps to the fastest interconnect."];
"mlsys.function-transformations" [id="concept-mlsys.function-transformations", label="Composable function\ntransformations", tooltip="Higher-order operations that map pure array functions to new functions, such as differentiation, vectorization, compilation, and sharding, and compose subject to each transformation's input, output, and tracing contract."];
"mlsys.task-actor-runtime" [id="concept-mlsys.task-actor-runtime", label="Distributed task and\nactor runtime", tooltip="A runtime exposing stateless remote tasks and stateful actors as future-returning calls scheduled across a cluster; implementations add a shared object store and lineage-based recovery."];
"mlsys.single-vs-multi-controller" [id="concept-mlsys.single-vs-multi-controller", label="Single- vs. multi-\ncontroller execution", tooltip="Whether one coordinating process issues work to all devices or every host runs the same program independently, trading orchestration flexibility against dispatch scalability."];
"mlsys.analytical-performance-model" [id="concept-mlsys.analytical-performance-model", label="Analytical performance\nmodel", tooltip="A closed-form model composing compute, memory, communication, and queueing terms to predict a workload's time, memory, and cost on a configuration without running it."];
"mlsys.performance-simulation" [id="concept-mlsys.performance-simulation", label="Performance simulation", tooltip="Predicting system behavior by executing a model of compute, memory, network, or scheduling events at a chosen granularity, trading simulation speed against detail."];
"mlsys.model-fidelity" [id="concept-mlsys.model-fidelity", label="Simulator fidelity", tooltip="Agreement between a performance model's or simulator's predictions and measured behavior on reference workloads, reported as validation error over stated configurations."];
"mlsys.post-training-quantization" [id="concept-mlsys.post-training-quantization", label="Post-training\nquantization", tooltip="Quantizing a trained model without retraining, choosing scales and rounding from statistics of the weights and, for many methods, a small calibration set of representative inputs."];
"mlsys.weight-only-quantization" [id="concept-mlsys.weight-only-quantization", label="Weight-only\nquantization", tooltip="Storing weights at low bit width while computing in higher-precision activations, cutting memory traffic for bandwidth-bound decoding, with error-compensating or activation-aware rounding."];
"mlsys.activation-outliers" [id="concept-mlsys.activation-outliers", label="Activation outliers", tooltip="Rare, large-magnitude activation channels in large transformers that inflate quantization ranges, handled by mixed-precision decomposition or by migrating scale into weights."];
"mlsys.kv-cache-quantization" [id="concept-mlsys.kv-cache-quantization", label="KV-cache quantization", tooltip="Storing attention keys and values at reduced precision, often with per-channel keys and per-token values, to raise batch size or context length under fixed memory."];
"mlsys.nm-sparsity" [id="concept-mlsys.nm-sparsity", label="N:M structured sparsity", tooltip="A fine-grained pattern keeping at most N nonzero values in every group of M, such as 2:4, that matrix engines can skip for real speedup."];
"mlsys.kv-cache-offload" [id="concept-mlsys.kv-cache-offload", label="KV-cache offloading and\ntiering", tooltip="Moving KV-cache blocks from accelerator memory to host memory or SSD and reloading them on reuse, extending cache capacity at transfer bandwidth and latency cost."];
"mlsys.kv-cache-transfer" [id="concept-mlsys.kv-cache-transfer", label="KV-cache transfer", tooltip="Shipping KV state between instances or nodes, as in disaggregated prefill and decode or cross-instance prefix reuse, overlapped with compute to hide network latency."];
"mlsys.model-routing" [id="concept-mlsys.model-routing", label="Model routing", tooltip="Choosing which model serves each request from request features, predicted quality, and cost."];
"mlsys.model-gateway" [id="concept-mlsys.model-gateway", label="Model gateway", tooltip="A proxy in front of one or more model providers that centralizes authentication, routing, rate limits, fallbacks, and usage logging for model calls."];
"mlsys.multi-adapter-serving" [id="concept-mlsys.multi-adapter-serving", label="Multi-adapter serving", tooltip="Serving many low-rank adapters over one shared base model by batching requests for different adapters with heterogeneous kernels and paging adapter weights on demand."];
"mlsys.kv-cache-eviction" [id="concept-mlsys.kv-cache-eviction", label="KV-cache eviction", tooltip="Retaining only a selected subset of cached key-value entries, chosen by attention scores, recency, or learned importance, to bound KV memory during long generation."];
"mlsys.cpu-gpu-hybrid-inference" [id="concept-mlsys.cpu-gpu-hybrid-inference", label="CPU-GPU hybrid\ninference", tooltip="Splitting inference so the host CPU computes some operations, such as attention or rarely active neurons, from host memory when model or KV state exceeds accelerator memory."];
"mlsys.graph-vector-index" [id="concept-mlsys.graph-vector-index", label="Graph-based vector\nindex", tooltip="An approximate nearest-neighbor index linking vectors into a proximity graph, often hierarchical, searched by greedy traversal for high recall at high memory cost."];
"mlsys.quantized-vector-index" [id="concept-mlsys.quantized-vector-index", label="Partitioned and\nquantized vector index", tooltip="An index that clusters vectors into partitions probed selectively and compresses them with product quantization, trading recall for memory footprint and scan cost."];
"mlsys.filtered-vector-search" [id="concept-mlsys.filtered-vector-search", label="Filtered vector search", tooltip="Nearest-neighbor search restricted to records satisfying metadata predicates, where naive pre- or post-filtering loses recall or cost under selective filters."];
"mlsys.index-freshness" [id="concept-mlsys.index-freshness", label="Vector index freshness", tooltip="The delay and recall cost of reflecting inserts, updates, and deletes in an ANN index, managed by incremental insertion, delta indexes, tombstones, and periodic rebuilds."];
"mlsys.numerical-nondeterminism" [id="concept-mlsys.numerical-nondeterminism", label="Numerical\nnondeterminism", tooltip="Run-to-run variation in floating-point results because non-associative reductions change order with atomics, kernel selection, parallel layout, batch composition, or hardware."];
"mlsys.batch-invariance" [id="concept-mlsys.batch-invariance", label="Batch invariance", tooltip="A kernel property that each request's output is bitwise independent of batch size and co-batched requests, one way to remove a source of run-to-run numerical variation in serving."];
"mlsys.checkpoint-resharding" [id="concept-mlsys.checkpoint-resharding", label="Checkpoint resharding", tooltip="Loading a checkpoint saved under one parallel layout or world size into another by remapping sharded tensors, needed for elastic restarts and training-to-serving handoff."];
"mlsys.batch-data-processing" [id="concept-mlsys.batch-data-processing", label="Distributed batch data\nprocessing", tooltip="Transforming bounded datasets with dataflow engines that partition records across workers, shuffle between stages, and re-execute failed tasks, for large-scale preprocessing and feature generation."];
"mlsys.distributed-tracing" [id="concept-mlsys.distributed-tracing", label="Distributed tracing", tooltip="Recording request-scoped, causally linked spans across services so that one request's latency and failures can be attributed to the components it traversed."];
"mlsys.llm-call-tracing" [id="concept-mlsys.llm-call-tracing", label="Model and agent call\ntracing", tooltip="Tracing model calls, retrievals, and tool invocations as spans annotated with prompts, token counts, latency, and cost, so quality and spend are attributable per step."];
"mlsys.evaluation-harness" [id="concept-mlsys.evaluation-harness", label="Evaluation harness", tooltip="A system running versioned benchmark suites against model checkpoints with fixed prompts, decoding settings, and scorers, sharding and caching work so results stay reproducible and comparable."];
"mlsys.energy-measurement" [id="concept-mlsys.energy-measurement", label="Energy measurement\nmethodology", tooltip="The declared sensor sources, sampling rate, measurement boundary, and attribution rules by which a workload's energy is measured, from on-chip counters to facility meters."];
"mlsys.idle-dynamic-power" [id="concept-mlsys.idle-dynamic-power", label="Idle vs. dynamic power", tooltip="Separating power drawn by provisioned but idle hardware from the incremental power of active work, which decides how shared energy is attributed to workloads."];
"mlsys.he-inference" [id="concept-mlsys.he-inference", label="Homomorphic-encryption\ninference", tooltip="Evaluating a model on encrypted inputs with homomorphic encryption so the server never sees plaintext, at large compute overhead and with polynomial approximations of nonlinearities."];
"mlsys.secure-computation-inference" [id="concept-mlsys.secure-computation-inference", label="Secure multi-party\ncomputation inference", tooltip="Jointly evaluating a model over secret-shared inputs or weights so no party learns another's data, with cost dominated by communication rounds for nonlinear layers."];
"mlsys.red-teaming" [id="concept-mlsys.red-teaming", label="Red teaming", tooltip="Structured adversarial probing of a model or system, by people or automated attacker models, to elicit harmful, insecure, or policy-violating behavior before and after release."];
"mlsys.dangerous-capability-eval" [id="concept-mlsys.dangerous-capability-eval", label="Dangerous-capability\nevaluation", tooltip="Evaluating whether a model has capabilities, such as cyberoffense, biological uplift, or autonomous replication, that cross thresholds requiring added safeguards."];
"mlsys.compute-in-memory" [id="concept-mlsys.compute-in-memory", label="Compute-in-memory", tooltip="Performing matrix-vector operations inside or beside memory arrays, often in the analog domain, so weights need not move to separate compute units."];
"mlsys.emerging-nvm" [id="concept-mlsys.emerging-nvm", label="Emerging non-volatile\nmemory", tooltip="Resistive, phase-change, and magnetic memory devices that retain state without power and can store weights densely or act as analog compute elements."];
"mlsys.embedded-dsl" [id="concept-mlsys.embedded-dsl", label="Embedded ML DSL", tooltip="A domain-specific language hosted inside a general language such as Python, whose operations build a program representation that a separate compiler or runtime executes."];
"mlsys.differentiable-programming" [id="concept-mlsys.differentiable-programming", label="Differentiable\nprogramming", tooltip="Writing general programs, including control flow, recursion, and data structures, that the language or framework differentiates end to end by automatic differentiation."];
"mlsys.persistent-kernel" [id="concept-mlsys.persistent-kernel", label="Persistent kernel", tooltip="A long-running kernel that stays resident on the device and executes many operators, or a whole forward pass, from an in-kernel work queue."];
"mlsys.graph-superoptimization" [id="concept-mlsys.graph-superoptimization", label="Tensor graph\nsuperoptimization", tooltip="Automatically generating and verifying semantics-preserving rewrites of tensor computation graphs or kernels, then searching the rewritten space under a cost model."];
"mlsys.llm-training-framework" [id="concept-mlsys.llm-training-framework", label="Large-model training\nframework", tooltip="A library that composes data, tensor, pipeline, and sharded-state parallelism with memory optimizations behind one training configuration for models exceeding one device."];
"mlsys.cloud-service-model" [id="concept-mlsys.cloud-service-model", label="Cloud service models", tooltip="Divisions of responsibility between cloud provider and customer, from rented virtual infrastructure to managed platforms to hosted model APIs."];
"mlsys.lakehouse" [id="concept-mlsys.lakehouse", label="Data warehouse and\nlakehouse", tooltip="Analytical stores of governed tables queried with SQL; a lakehouse adds transactional table formats over open files in object storage."];
"mlsys.training-power-swings" [id="concept-mlsys.training-power-swings", label="Synchronous training\npower swings", tooltip="Rapid cluster-wide swings in power draw as synchronized accelerators alternate between compute and communication or stall together at checkpoints and failures."];
"mlsys.facility-energy-storage" [id="concept-mlsys.facility-energy-storage", label="UPS and battery energy\nstorage", tooltip="Facility batteries that carry load through outages until generators start and can also buffer fast load swings or shave demand peaks."];
"mlsys.grid-interconnection" [id="concept-mlsys.grid-interconnection", label="Grid interconnection", tooltip="The utility connection that fixes how much power a site can draw; its capacity and multi-year lead times increasingly decide where AI datacenters are built."];
"mlsys.on-site-generation" [id="concept-mlsys.on-site-generation", label="On-site power\ngeneration", tooltip="Generators, turbines, fuel cells, or renewables at the datacenter that provide backup power or supply load alongside or instead of the grid."];
"mlsys.data-cleaning" [id="concept-mlsys.data-cleaning", label="Data cleaning", tooltip="Detecting and correcting erroneous, inconsistent, duplicated, or outlying records with rules, statistics, or learned repair models before the data is used for training."];
"mlsys.class-imbalance" [id="concept-mlsys.class-imbalance", label="Class imbalance", tooltip="A skewed label distribution in which some classes are rare, so aggregate accuracy misleads and training favors the majority classes."];
"mlsys.rebalancing" [id="concept-mlsys.rebalancing", label="Class rebalancing", tooltip="Changing per-class sampling rates, synthesizing minority examples, or weighting the loss so rare classes contribute adequately to training."];
"mlsys.feature-hashing" [id="concept-mlsys.feature-hashing", label="Feature hashing", tooltip="Mapping high-cardinality or open-vocabulary categorical values into a fixed number of buckets with a hash function, bounding table size at the cost of collisions."];
"mlsys.feature-cross" [id="concept-mlsys.feature-cross", label="Feature cross", tooltip="A synthetic feature formed from the conjunction of two or more categorical features so a model, especially a linear one, can learn their interaction."];
"mlsys.data-governance" [id="concept-mlsys.data-governance", label="Data governance", tooltip="Policies, roles, and controls that decide who may collect, access, use, and share which data, for which purposes, and under what accountability."];
"mlsys.data-consent" [id="concept-mlsys.data-consent", label="Consent and purpose\nlimitation", tooltip="Restricting collection and use of personal data to purposes the data subject agreed to or a legal basis allows, recorded so downstream uses can be checked."];
"mlsys.exploratory-data-analysis" [id="concept-mlsys.exploratory-data-analysis", label="Exploratory data\nanalysis", tooltip="Summarizing and plotting distributions, correlations, and anomalies in a dataset before modeling to inform cleaning, feature design, and validation rules."];
"mlsys.model-visualization" [id="concept-mlsys.model-visualization", label="Model and prediction\nvisualization", tooltip="Plotting training curves, activations, embeddings, and prediction errors such as confusion matrices to inspect what a model learned and where it fails."];
"mlsys.model-selection" [id="concept-mlsys.model-selection", label="Model selection", tooltip="Choosing among candidate model families, architectures, and hyperparameters by validated performance under the system's accuracy, cost, and latency constraints."];
"mlsys.pretraining" [id="concept-mlsys.pretraining", label="Pretraining", tooltip="Training a model from scratch on a large, broad corpus with a self-supervised objective to produce a general base model for later adaptation."];
"mlsys.causal-lm" [id="concept-mlsys.causal-lm", label="Causal language\nmodeling", tooltip="Training a model to predict each token from the tokens before it, maximizing the likelihood of text under a left-to-right factorization."];
"mlsys.gan" [id="concept-mlsys.gan", label="Generative adversarial\nnetwork", tooltip="A generator and a discriminator trained against each other, so the generator learns to produce samples the discriminator cannot tell apart from data."];
"mlsys.mode-collapse" [id="concept-mlsys.mode-collapse", label="Mode collapse", tooltip="A generative-training failure in which the model covers only a few modes of the data distribution and produces low-diversity samples."];
"mlsys.perplexity" [id="concept-mlsys.perplexity", label="Perplexity", tooltip="The exponentiated average negative log-likelihood per token of held-out text, measuring how well a language model predicts that text."];
"mlsys.reference-match-scoring" [id="concept-mlsys.reference-match-scoring", label="Reference-match scoring", tooltip="Scoring a generated output by exact or token-overlap agreement with reference answers; cheap and reproducible but blind to valid answers phrased differently."];
"mlsys.error-analysis" [id="concept-mlsys.error-analysis", label="Error analysis", tooltip="Inspecting a model's mistakes, grouping them into categories, and ranking categories by frequency and fixability to decide the next data or model change."];
"mlsys.training-diagnostics" [id="concept-mlsys.training-diagnostics", label="Training diagnostics", tooltip="Checks such as overfitting a tiny batch, reading learning curves, and tracking gradient and activation statistics that localize bugs in training code, data, and configuration."];
"mlsys.keyed-predictions" [id="concept-mlsys.keyed-predictions", label="Request correlation\nkeys", tooltip="Passing a client-supplied key through inference unchanged so outputs of batch or asynchronous requests can be matched to their inputs regardless of order."];
"mlsys.stateless-serving-function" [id="concept-mlsys.stateless-serving-function", label="Stateless model serving", tooltip="Exporting a model as a stateless function from request inputs to prediction, so any replica can serve any request and replicas scale horizontally."];
"mlsys.semantic-cache" [id="concept-mlsys.semantic-cache", label="Semantic cache", tooltip="Returning a stored model response when a new request is close in embedding space to an earlier one, trading answer fidelity for latency and cost."];
"mlsys.model-cascade" [id="concept-mlsys.model-cascade", label="Model cascade", tooltip="Sending a request to cheaper models first and escalating to more capable models only when a confidence or quality criterion is not met."];
"mlsys.glue-code" [id="concept-mlsys.glue-code", label="Glue code", tooltip="Supporting code written to move data into and out of general-purpose ML packages, often far larger than the model code and binding the system to package specifics."];
"mlsys.pipeline-jungle" [id="concept-mlsys.pipeline-jungle", label="Pipeline jungle", tooltip="Data preparation grown incrementally into a tangle of scrapes, joins, and intermediate outputs that is hard to test, trace, and change."];
"mlsys.build-vs-buy" [id="concept-mlsys.build-vs-buy", label="Build-versus-buy\ndecision", tooltip="Choosing whether to build an ML platform component in house, adopt open source, or buy a managed service, weighing fit, cost, lock-in, and team capacity."];
"mlsys.user-feedback" [id="concept-mlsys.user-feedback", label="User feedback\ncollection", tooltip="Capturing explicit signals such as ratings and corrections and implicit signals such as clicks, edits, and abandonment, for use as labels or quality signals."];
"mlsys.human-ai-interaction" [id="concept-mlsys.human-ai-interaction", label="Human-AI interaction\ndesign", tooltip="Designing how a system conveys its capabilities, uncertainty, and errors to users and lets them correct, override, or dismiss its outputs."];
"mlsys.demand-response" [id="concept-mlsys.demand-response", label="Datacenter demand\nresponse", tooltip="Shifting, shedding, or capping datacenter power in response to grid signals, made practical by deferrable training and batch work."];
"mlsys.prompt-engineering" [id="concept-mlsys.prompt-engineering", label="Prompt engineering", tooltip="Designing instructions, examples, and input layout for a model call to elicit desired behavior without changing the model's weights."];
"mlsys.loss-masking" [id="concept-mlsys.loss-masking", label="Loss masking and token\nnormalization", tooltip="Excluding prompt, tool-output, and other non-target tokens from the training loss, and choosing how remaining token losses are averaged across turns and sequences."];
"mlsys.serverless-inference" [id="concept-mlsys.serverless-inference", label="Serverless inference", tooltip="Running models on a managed platform that provisions replicas on demand, bills per use, and can scale to zero, exposing requests to cold-start latency."];
"mlsys.streaming-asr" [id="concept-mlsys.streaming-asr", label="Streaming speech\nrecognition", tooltip="Serving speech recognition incrementally: consuming audio in chunks and emitting partial transcripts within a fixed lag, with encoder state carried between chunks."];
"mlsys.non-prefix-kv-reuse" [id="concept-mlsys.non-prefix-kv-reuse", label="Non-prefix KV reuse", tooltip="Reusing precomputed KV entries for text chunks appearing at arbitrary positions across requests, selectively recomputing cross-chunk attention instead of the full prefill."];
"mlsys.dynamic-sparse-attention" [id="concept-mlsys.dynamic-sparse-attention", label="Dynamic sparse\nattention", tooltip="Attention that computes only the query-key blocks predicted important for each input at runtime, rather than a fixed pattern, to cut long-context cost."];
"mlsys.token-streaming" [id="concept-mlsys.token-streaming", label="Token streaming", tooltip="Delivering generated output to the client incrementally as tokens are produced, holding per-stream state and stopping generation when the client cancels or disconnects."];
"mlsys.heterogeneous-accelerator-execution" [id="concept-mlsys.heterogeneous-accelerator-execution", label="Heterogeneous-\naccelerator training\nand serving", tooltip="Partitioning one training or serving job across accelerators of different types or generations, sizing stages and batch shares to each device's compute, memory, and links."];
"mlsys.graph-neural-network" [id="concept-mlsys.graph-neural-network", label="Graph neural network", tooltip="Neural network that computes node, edge, or graph representations by repeatedly aggregating features from each node's neighbors along graph edges."];
"mlsys.input-prefetching" [id="concept-mlsys.input-prefetching", label="Input prefetching", tooltip="Preparing upcoming batches in background workers and buffers while the accelerator processes the current batch, overlapping input delivery with computation."];
"mlsys.dynamic-resharding" [id="concept-mlsys.dynamic-resharding", label="Dynamic re-\nparallelization", tooltip="Redistributing model weights among devices at runtime so successive phases, such as generation and training or prefill and decode, each run under a better parallel layout."];
"mlsys.activation-sparsity" [id="concept-mlsys.activation-sparsity", label="Contextual activation\nsparsity", tooltip="Skipping neurons, heads, or channels whose activations are predicted negligible for the current input, reducing per-token compute and weight reads at inference."];
"mlsys.denoising-step-reduction" [id="concept-mlsys.denoising-step-reduction", label="Denoising-step\nreduction", tooltip="Lowering network evaluations per diffusion sample with faster samplers, step distillation, or consistency models, trading sample quality against latency and cost."];
"mlsys.ml-aware-scheduling" [id="concept-mlsys.ml-aware-scheduling", label="ML-aware cluster\nscheduling", tooltip="Allocating cluster accelerators using ML job properties, such as scaling curves, iteration time, and parallelism choice, to optimize objectives like job completion time or goodput."];
"mlsys.adaptive-routing" [id="concept-mlsys.adaptive-routing", label="Adaptive routing", tooltip="Choosing network paths per packet or flowlet from current congestion, avoiding the hash collisions static ECMP suffers with few large, synchronized training flows."];
"mlsys.incast" [id="concept-mlsys.incast", label="Incast congestion", tooltip="Congestion that occurs when many senders transmit to one receiver at once, overflowing its switch port buffer and causing queueing, drops, or pause propagation."];
"mlsys.context-selection" [id="concept-mlsys.context-selection", label="Context selection", tooltip="Choosing which instructions, tool descriptions, retrieved items, state, and observations enter a model's limited context at each step, within a token budget."];
"mlsys.context-staleness" [id="concept-mlsys.context-staleness", label="Context staleness", tooltip="Observations held in an agent's context or memory that no longer reflect the environment after later actions or external changes, yet still steer decisions unless invalidated."];
"mlsys.multi-hop-retrieval" [id="concept-mlsys.multi-hop-retrieval", label="Iterative multi-hop\nretrieval", tooltip="Retrieval that issues successive queries, each formulated from previously retrieved evidence or reasoning steps, to answer questions no single lookup resolves."];
"mlsys.capability-based-security" [id="concept-mlsys.capability-based-security", label="Capability-based\nauthorization", tooltip="Authorization in which holding an unforgeable, scoped reference grants a specific right that can be delegated with attenuated scope and later revoked."];
"mlsys.ephemeral-sandbox" [id="concept-mlsys.ephemeral-sandbox", label="Ephemeral sandbox", tooltip="An isolated execution environment created per task from a snapshot, often copy-on-write, and destroyed or reset afterward so no state carries across tasks or tenants."];
"mlsys.egress-control" [id="concept-mlsys.egress-control", label="Network egress control", tooltip="Restricting which external network destinations a workload or sandbox may contact, typically through default-deny allowlists, to block exfiltration and unintended remote actions."];
"mlsys.information-flow-control" [id="concept-mlsys.information-flow-control", label="Information-flow\ncontrol", tooltip="Labeling data with confidentiality and integrity tags and propagating them through computation so policy can block untrusted inputs from steering privileged actions or secrets from leaking."];
"mlsys.compounding-error" [id="concept-mlsys.compounding-error", label="Compounding error in\nsequential decisions", tooltip="Per-step errors of a learned sequential policy or generator push later inputs away from the training distribution, so failure probability grows with horizon length."];
"mlsys.interactive-imitation" [id="concept-mlsys.interactive-imitation", label="Interactive imitation\nlearning", tooltip="Imitation learning that queries an expert for corrective labels on states the learner's own policy visits and aggregates them into training data over rounds."];
"mlsys.in-context-learning" [id="concept-mlsys.in-context-learning", label="In-context learning", tooltip="A pretrained model performing a task from instructions or examples supplied in its input at inference time, with no weight updates."];
"mlsys.reward-hacking" [id="concept-mlsys.reward-hacking", label="Reward hacking", tooltip="Improving a measured reward through behavior that fails the intended task objective."];
"mlsys.actuator-limits" [id="concept-mlsys.actuator-limits", label="Actuator limits", tooltip="Bounds on the force, torque, speed, and sustained duty an actuator can deliver, set by drive current limits, gearing, and motor heating."];
"mlsys.watchdog-timer" [id="concept-mlsys.watchdog-timer", label="Watchdog timer", tooltip="A timer that a monitored component must refresh within a deadline or window; expiry triggers a defined safe response such as reset or revoking control authority."];
"mlsys.closed-loop-evaluation" [id="concept-mlsys.closed-loop-evaluation", label="Closed-loop policy\nevaluation", tooltip="Evaluating a policy by letting its own actions determine subsequent observations, in simulation or deployment, rather than scoring its predictions against logged data."];
"mlsys.event-data-recorder" [id="concept-mlsys.event-data-recorder", label="Event data recorder", tooltip="Tamper-evident onboard logging of inputs, decisions, control authority, and safety interventions around events, retained for incident reconstruction and assurance evidence."];
"mlsys.decision-accountability" [id="concept-mlsys.decision-accountability", label="Decision accountability\nrecord", tooltip="A record of who authorized each consequential decision, policy, or automated action and on what evidence, so responsibility can be assigned and reviewed later."];
"mlsys.agent-interruption" [id="concept-mlsys.agent-interruption", label="Agent interruption and\ncancellation", tooltip="Operator controls that pause, redirect, cancel, or terminate a running agent at defined boundaries while settling in-flight tool calls into a known state."];
"mlsys.agent-loop-detection" [id="concept-mlsys.agent-loop-detection", label="Agent loop detection", tooltip="Monitoring an agent trajectory for repeated actions, cycling states, or absent progress, and halting or escalating when the agent appears stuck."];
"mlsys.task-and-motion-planning" [id="concept-mlsys.task-and-motion-planning", label="Task and motion\nplanning", tooltip="Planning that jointly searches discrete symbolic action sequences and continuous motions, accepting a task plan only when each step admits a feasible motion."];
"mlsys.multi-object-tracking" [id="concept-mlsys.multi-object-tracking", label="Multi-object tracking", tooltip="Maintaining identities and states of multiple moving objects over time by associating new detections with existing tracks and starting or ending tracks."];
"mlsys.change-impact-analysis" [id="concept-mlsys.change-impact-analysis", label="Safety change-impact\nanalysis", tooltip="Determining which hazards, safety-case claims, and evidence a change to a model, software, data, or operating domain invalidates, and what must be re-verified."];
"mlsys.sparse-tensor-kernels" [id="concept-mlsys.sparse-tensor-kernels", label="Sparse tensor kernels", tooltip="Kernels such as sparse-dense matrix multiply, sampled dense-dense multiply, and sparse convolution that compute over compressed nonzero structure, trading irregular access for skipped work."];
"mlsys.local-sgd" [id="concept-mlsys.local-sgd", label="Local SGD", tooltip="Data-parallel training in which workers take several local optimizer steps between parameter synchronizations, cutting communication frequency for low-bandwidth or geo-distributed settings."];
"mlsys.expert-placement" [id="concept-mlsys.expert-placement", label="Expert replication and\nplacement", tooltip="Assigning mixture-of-experts experts to devices, and replicating frequently routed ones, to balance per-device token load under skewed routing."];
"mlsys.memory-efficient-optimizer" [id="concept-mlsys.memory-efficient-optimizer", label="Memory-efficient\noptimizer", tooltip="Optimizers that shrink per-parameter state through factorization, low-rank projection, or low-precision storage, cutting the memory adaptive methods such as Adam otherwise require."];
"mlsys.execution-trace" [id="concept-mlsys.execution-trace", label="Operator execution\ntrace", tooltip="A recorded graph of a training or inference step's compute and communication operators with their dependencies and timings, replayable for simulation and benchmarking."];
"mlsys.offline-rl" [id="concept-mlsys.offline-rl", label="Offline reinforcement\nlearning", tooltip="Learning a policy from a fixed dataset of previously logged interactions without further environment access, limited by how well the data covers states the policy would visit."];
"mlsys.byzantine-robust-aggregation" [id="concept-mlsys.byzantine-robust-aggregation", label="Byzantine-robust\naggregation", tooltip="Combining worker or client updates with robust statistics, such as medians, trimmed means, or Krum, so a bounded fraction of arbitrary malicious updates cannot steer training."];
"mlsys.cluster-manager" [id="concept-mlsys.cluster-manager", label="Cluster manager", tooltip="The control plane that admits jobs, places their tasks on machines, enforces quotas and priorities, and reconciles running state toward declared intent across a cluster."];
"mlsys.rebound-effect" [id="concept-mlsys.rebound-effect", label="Rebound effect", tooltip="Efficiency gains lower the cost of a service enough that total demand, and with it total energy or resource use, grows, partly or fully offsetting the savings."];
"mlsys.data-cascade" [id="concept-mlsys.data-cascade", label="Data cascade", tooltip="Compounding downstream harm from upstream data problems, such as poor collection or labeling, that surface late, often after deployment, and are costly to trace."];
"mlsys.data-valuation" [id="concept-mlsys.data-valuation", label="Data valuation", tooltip="Estimating each training example's or data source's contribution to model quality, for example through influence or Shapley-style attribution, to guide selection, pricing, or removal."];
"mlsys.diffusion-policy" [id="concept-mlsys.diffusion-policy", label="Diffusion or flow-\nmatching policy", tooltip="Robot policies that generate continuous actions through iterative denoising or learned-flow integration, representing multiple action modes while spending an inference-iteration budget."];
"mlsys.sensor-spoofing" [id="concept-mlsys.sensor-spoofing", label="Sensor spoofing", tooltip="Attacks that inject false signals into a sensor's physical channel, such as fabricated LiDAR returns or GPS and acoustic spoofing, so perception receives counterfeit measurements."];
"mlsys.paired-comparison" [id="concept-mlsys.paired-comparison", label="Paired comparison and\nnoninferiority testing", tooltip="Comparing two systems on the same items or units and testing per-item differences, including whether a candidate is no worse than a baseline by a preset margin."];
"mlsys.cpu-execution-architecture" [id="concept-mlsys.cpu-execution-architecture", label="CPU execution\narchitecture", tooltip="Organization of general-purpose processor cores, SIMD vector units, and multilevel caches that runs host code, preprocessing, classical models, and CPU inference."];
"mlsys.cpu-threading-numa" [id="concept-mlsys.cpu-threading-numa", label="CPU threading and NUMA\nplacement", tooltip="Configuring thread pools, core affinity, and memory placement across NUMA domains so CPU operators parallelize without oversubscription or remote-memory penalties."];
"mlsys.dynamic-shapes" [id="concept-mlsys.dynamic-shapes", label="Dynamic shapes and\nshape specialization", tooltip="Handling inputs whose tensor dimensions vary across calls by specializing compiled code per shape, padding into buckets, or compiling with symbolic dimensions."];
"mlsys.rule-based-graph-rewriting" [id="concept-mlsys.rule-based-graph-rewriting", label="Rule-based graph\nrewriting", tooltip="Applying hand-written semantics-preserving transformations to a computation graph, such as constant folding, dead-code elimination, operator substitution, and algebraic simplification."];
"mlsys.sparse-ragged-tensors" [id="concept-mlsys.sparse-ragged-tensors", label="Sparse and ragged\ntensor representation", tooltip="Storing tensors with mostly zero entries or variable-length dimensions in compressed formats such as COO, CSR, or offset-indexed ragged layouts instead of padded dense arrays."];
"mlsys.execution-providers" [id="concept-mlsys.execution-providers", label="Execution providers and\noperator fallback", tooltip="Partitioning a model graph across runtime backends by operator support, running supported subgraphs on accelerators and falling back to a CPU backend otherwise."];
"mlsys.large-language-model" [id="concept-mlsys.large-language-model", label="Large language model", tooltip="A language model large enough that parameter memory, attention state that grows with context, and, when serving, token-by-token decoding dominate its resource demands."];
"mlsys.inference-compute-estimate" [id="concept-mlsys.inference-compute-estimate", label="Inference compute and\nmemory estimate", tooltip="Approximating dense transformer inference as about two FLOPs per parameter per token, plus KV-cache bytes from layers, KV heads, head dimension, context length, batch, and precision."];
"mlsys.sync-async-training" [id="concept-mlsys.sync-async-training", label="Synchronous vs.\nasynchronous training", tooltip="Choosing whether workers apply an update only after every gradient for a step is combined, or apply updates independently on possibly stale parameters."];
"mlsys.neighbor-sampling" [id="concept-mlsys.neighbor-sampling", label="Neighbor sampling", tooltip="Building GNN mini-batches from sampled subsets of each node's multi-hop neighborhood, bounding the exponential neighbor growth that makes full-neighborhood computation exceed memory."];
"mlsys.event-time-windowing" [id="concept-mlsys.event-time-windowing", label="Event-time windowing\nand watermarks", tooltip="Grouping stream events into windows by when they occurred, using watermarks to estimate completeness and explicit policies for events arriving after a window closes."];
"mlsys.diffusion-feature-caching" [id="concept-mlsys.diffusion-feature-caching", label="Cross-step feature\ncaching", tooltip="Reusing intermediate activations that change little between adjacent denoising steps instead of recomputing them, cutting per-step cost at bounded quality loss."];
"mlsys.voice-pipeline" [id="concept-mlsys.voice-pipeline", label="Voice interaction\npipeline", tooltip="Serving a spoken interaction as one latency-budgeted pipeline of streaming speech recognition, a language model, and speech synthesis, with turn detection and interruption handling between stages."];
"mlsys.llm-request-scheduling" [id="concept-mlsys.llm-request-scheduling", label="LLM request scheduling\nand preemption", tooltip="Ordering, prioritizing, and preempting in-flight generation requests at iteration granularity, swapping or recomputing their KV state, to meet latency targets and fairness goals."];
"mlsys.containerization" [id="concept-mlsys.containerization", label="Containerization", tooltip="Packaging a model, its code, and its dependencies as an immutable image that runs unchanged across machines, leaving the scheduling of those containers across a cluster to the cluster manager."];
"mlsys.distributed-hang-diagnosis" [id="concept-mlsys.distributed-hang-diagnosis", label="Distributed job hang\ndiagnosis", tooltip="Detecting and localizing stalled distributed jobs through collective timeouts, heartbeats, per-rank progress traces, and node health checks, so faulty ranks can be isolated."];
"mlsys.benchmark-representativeness" [id="concept-mlsys.benchmark-representativeness", label="Benchmark\nrepresentativeness", tooltip="The degree to which a benchmark's workload, scale, and measurement boundary predict production behavior, from isolated microbenchmarks to end-to-end application runs."];
"mlsys.data-model-licensing" [id="concept-mlsys.data-model-licensing", label="Data and model\nlicensing", tooltip="Legal terms governing how datasets and model weights may be used, modified, redistributed, or deployed, which constrain acquisition, fine-tuning, and release decisions."];
"mlsys.content-provenance" [id="concept-mlsys.content-provenance", label="Content provenance", tooltip="Cryptographically signed metadata attached to media that records its origin and edit history, including model generation, so recipients can verify source claims."];
"mlsys.fleet-data-engine" [id="concept-mlsys.fleet-data-engine", label="Fleet data engine", tooltip="Collecting training data from deployed devices through on-device triggers that flag rare or uncertain events, uploading selected samples under bandwidth budgets for labeling and retraining."];
"mlsys.robotics-middleware" [id="concept-mlsys.robotics-middleware", label="Robotics middleware and\ndataflow", tooltip="Software connecting sensing, perception, planning, and control processes as nodes that exchange typed messages over publish-subscribe topics with configurable delivery and timing policies."];
"mlsys.parallel-simulation" [id="concept-mlsys.parallel-simulation", label="Parallel physics\nsimulation", tooltip="Running many simulated robot environments concurrently, often batched on accelerators, so policy learning and data generation gather experience faster than physical collection."];
"mlsys.agent-credentials" [id="concept-mlsys.agent-credentials", label="Agent credentials and\ndelegated authority", tooltip="Issuing tool-using agents scoped, short-lived credentials that act on a user's behalf, brokering secrets outside model context so authority stays bounded and revocable."];
"mlsys.gnn-graph-partitioning" [id="concept-mlsys.gnn-graph-partitioning", label="Graph partitioning for\nGNN training", tooltip="Splitting a large graph across workers to balance computation while minimizing cut edges, whose cross-partition neighbor features must be fetched remotely."];
"mlsys.host-data-loader" [id="concept-mlsys.host-data-loader", label="Host-side data loading", tooltip="Reading, decoding, augmenting, and collating examples on host CPU worker processes and staging batches in pinned memory so that a single machine's accelerators are not left waiting for input."];
"mlsys.streaming-inference" [id="concept-mlsys.streaming-inference", label="Streaming inference", tooltip="Serving a model over an open stream of input, producing outputs incrementally from partial input while carrying state between chunks, rather than answering one complete request at a time."];
"mlsys.inference-api" [id="concept-mlsys.inference-api", label="Inference API and\npayload serialization", tooltip="The request and response protocol of a model server, including the transport (HTTP, gRPC, streaming connections), the tensor and payload encoding, and the cost of serializing inputs and outputs."];
"mlsys.request-throughput" [id="concept-mlsys.request-throughput", label="Request throughput", tooltip="The number of requests, or tokens, a serving system completes per unit time at a stated load and latency target."];
"mlsys.latency-percentiles" [id="concept-mlsys.latency-percentiles", label="Latency percentiles", tooltip="Summarizing a latency distribution by percentiles such as p50, p95, and p99, so that a service is judged by the experience of most requests and of the slow tail rather than by the mean."];
"mlsys.cache-aware-routing" [id="concept-mlsys.cache-aware-routing", label="Cache-aware request\nrouting", tooltip="Sending each request to the replica that already holds a reusable prefix or KV cache for it, trading load balance against cache reuse."];
"mlsys.process-group-rendezvous" [id="concept-mlsys.process-group-rendezvous", label="Distributed job launch\nand process groups", tooltip="Starting the processes of a distributed job, having them discover each other through a rendezvous, assigning ranks, and forming the process groups and communicators that collectives run over."];
"mlsys.agentic-workload" [id="concept-mlsys.agentic-workload", label="Agentic workload", tooltip="The load an agent places on the serving stack, including context that grows each turn, idle gaps while tools run, many short dependent model calls, and reuse of KV state across steps."];
"mlsys.performance-regression-testing" [id="concept-mlsys.performance-regression-testing", label="Performance regression\ntesting", tooltip="Benchmarking every change to code, kernels, models, or configuration continuously and failing the change when throughput, latency, or memory degrades beyond a set tolerance."];
"mlsys.measurement-variability" [id="concept-mlsys.measurement-variability", label="Performance measurement\nvariability", tooltip="Run-to-run variation in measured time and throughput from warm-up, asynchronous execution, clock and thermal state, and contention, handled by synchronizing, repeating runs, and reporting spread."];
"mlsys.training-data-extraction" [id="concept-mlsys.training-data-extraction", label="Training data\nextraction", tooltip="Recovering particular training examples or their sensitive contents through a trained model's outputs, exposing information that was not intended for release."];
"mlsys.gradient-clipping" [id="concept-mlsys.gradient-clipping", label="Gradient clipping", tooltip="Rescaling or truncating gradients whose norm exceeds a threshold so that a single large update cannot destabilize training."];
"mlsys.weight-initialization" [id="concept-mlsys.weight-initialization", label="Weight initialization", tooltip="Choosing the scale and distribution of initial parameters so that activations and gradients keep stable variance through depth at the start of training."];
"mlsys.delivery-semantics" [id="concept-mlsys.delivery-semantics", label="Processing delivery\nsemantics", tooltip="The guarantee a data pipeline gives about how often each record takes effect (at most once, at least once, or effectively once) under retries, replays, and failures, and the idempotent or transactional sinks that achieve it."];
"mlsys.online-feature-consistency" [id="concept-mlsys.online-feature-consistency", label="Online and offline\nfeature consistency", tooltip="Keeping the feature values materialized in the low-latency online store consistent with the offline values used for training, as features are recomputed, backfilled, and updated."];
"mlsys.ood-detection" [id="concept-mlsys.ood-detection", label="Out-of-distribution\ndetection", tooltip="Flagging individual inputs that differ from the training distribution so the system can abstain, defer, or fall back instead of trusting the prediction."];
"mlsys.model-feature-compatibility" [id="concept-mlsys.model-feature-compatibility", label="Model and feature\ncompatibility", tooltip="Ensuring that a model version, its tokenizer and feature transformations, the schemas it reads, and the consumers of its outputs remain compatible as each is versioned and released independently."];
"mlsys.secrets-management" [id="concept-mlsys.secrets-management", label="Workload identity and\nsecrets management", tooltip="Giving training jobs, model servers, and pipelines verifiable identities and provisioning, rotating, and revoking the keys and credentials they use, without embedding secrets in code or images."];
"mlsys.deletion-propagation" [id="concept-mlsys.deletion-propagation", label="Data deletion\npropagation", tooltip="Carrying a deletion request through every copy and derivative of the data, including datasets, features, caches, replicas, backups, and models trained on it."];
"mlsys.memory-fragmentation" [id="concept-mlsys.memory-fragmentation", label="Runtime memory\nfragmentation", tooltip="Free device memory split into blocks too small to satisfy new allocations, so a job runs out of memory while reserved memory exceeds what live tensors use."];
"mlsys.perception-latency-budget" [id="concept-mlsys.perception-latency-budget", label="Perception latency\nbudget", tooltip="The share of a robot's sense-to-act deadline allotted to sensing and perception, which bounds model size, input resolution, and frame rate on the onboard computer."];
"mlsys.onboard-compute-partitioning" [id="concept-mlsys.onboard-compute-partitioning", label="Onboard compute\npartitioning", tooltip="Assigning perception, planning, and control workloads to the CPUs, accelerators, and microcontrollers of a robot, or offloading them, so each meets its deadline and criticality level."];
"mlsys.health-checks" [id="concept-mlsys.health-checks", label="Health checks and\nreadiness probes", tooltip="Periodic liveness and readiness checks that let an orchestrator or load balancer stop routing traffic to, or restart, a replica that is unhealthy or still loading its model."];
"mlsys.python-gil" [id="concept-mlsys.python-gil", label="Python GIL and host-\nlanguage concurrency", tooltip="In GIL-enabled CPython, the global interpreter lock serializes Python bytecode across threads, so ML host code achieves concurrency through native kernels that release the lock, multiple processes, or asynchronous I/O."];
"mlsys.flash-endurance" [id="concept-mlsys.flash-endurance", label="Flash write endurance", tooltip="Flash memory cells wear out after a limited number of program and erase cycles, which bounds how often embedded and edge devices can write logs, checkpoints, or model updates; wear leveling spreads writes to extend life."];
"mlsys.intermittent-computing" [id="concept-mlsys.intermittent-computing", label="Energy-harvesting\nintermittent computing", tooltip="Running inference on devices powered by harvested energy that lose power unpredictably, which requires checkpointing progress to nonvolatile memory so computation resumes rather than restarts."];
"mlsys.mmap-weights" [id="concept-mlsys.mmap-weights", label="Memory-mapped model\nweights", tooltip="Mapping a weight file into virtual memory so pages load on demand and read-only weights are shared across processes, cutting load time and duplicate memory at the cost of page faults."];
"mlsys.os-memory-pressure" [id="concept-mlsys.os-memory-pressure", label="OS memory pressure and\npaging", tooltip="How an operating system reclaims memory from a model process under pressure, by evicting file-backed pages, swapping or compressing memory, or killing the app, which shows up as page thrashing, latency spikes, or abrupt termination."];
"mlsys.managed-runtime-interop" [id="concept-mlsys.managed-runtime-interop", label="Managed-runtime interop\nand garbage collection", tooltip="Crossing between a managed language runtime (Java, Kotlin, Swift, C#) and native inference code, where buffer copies, object pinning, and garbage-collection pauses add latency and memory."];
"mlsys.zero-copy-dma" [id="concept-mlsys.zero-copy-dma", label="Zero-copy sensor input\nvia DMA", tooltip="Having sensors or peripherals write input directly into model input buffers by direct memory access, avoiding CPU copies between capture and inference."];
"mlsys.sensor-interference" [id="concept-mlsys.sensor-interference", label="Active sensor\ninterference", tooltip="Crosstalk between active sensors, such as lidars, radars, or structured-light cameras, that emit into the same environment and corrupt each other's measurements."];
"mlsys.network-propagation-delay" [id="concept-mlsys.network-propagation-delay", label="Network propagation\ndelay", tooltip="The minimum latency set by the distance a signal travels through the medium, which sets a floor under round-trip time between regions regardless of bandwidth."];
"mlsys.cap-tradeoff" [id="concept-mlsys.cap-tradeoff", label="Consistency-\navailability trade-off", tooltip="Under a network partition, a replicated system must choose between answering with possibly stale state and refusing requests until replicas agree."];
"mlsys.gossip-averaging" [id="concept-mlsys.gossip-averaging", label="Decentralized gossip\naveraging", tooltip="Training in which each worker averages its model with a few neighbors instead of a central server or global all-reduce, so updates diffuse through the communication graph."];
"mlsys.interrupt-latency" [id="concept-mlsys.interrupt-latency", label="Interrupt latency", tooltip="The delay from an interrupt request to the start of its handler, which contributes to event-response time alongside handler execution and subsequent processing."];
"mlsys.transformer-variants" [id="concept-mlsys.transformer-variants", label="Encoder-only, decoder-\nonly, and encoder-\ndecoder Transformers", tooltip="The three arrangements of Transformer stacks, which differ in whether inputs are processed bidirectionally, outputs are generated autoregressively, or both, and therefore in how they are trained, cached, and served."];
"mlsys.data-transfer-cost" [id="concept-mlsys.data-transfer-cost", label="Data transfer cost", tooltip="The money charged for moving data across network, zone, region, or provider boundaries, such as cloud egress fees, which can dominate the cost of distributing data, checkpoints, or responses."];
"mlsys.duty-cycling" [id="concept-mlsys.duty-cycling", label="Duty cycling and sleep\nstates", tooltip="Keeping a device in a low-power sleep state most of the time and waking it briefly to sense and infer, so average power is set by the active fraction and the cost of each wake-up."];
"mlsys.priority-inversion" [id="concept-mlsys.priority-inversion", label="Priority inversion", tooltip="A high-priority task blocked on a resource held by a lower-priority task while a medium-priority task preempts the holder, so the high-priority task's blocking time is unbounded and can exceed its deadline unless the scheduler bounds it."];
"mlsys.randomized-smoothing" [id="concept-mlsys.randomized-smoothing", label="Certified robustness by\nrandomized smoothing", tooltip="Classifying many noise-perturbed copies of an input and taking the majority vote, which yields a provable radius within which no adversarial perturbation can change the prediction, at the cost of many inferences per input."];
"mlsys.sensor-interconnect" [id="concept-mlsys.sensor-interconnect", label="Sensor interconnect\nbandwidth", tooltip="The data rate of the links that carry sensor data into an embedded processor (MIPI CSI-2 for cameras, I2S for audio, SPI and I2C for low-rate sensors), which bounds the resolution, frame rate, and number of sensors a device can ingest."];
"mlsys.finite-buffer" [id="concept-mlsys.finite-buffer", label="Finite buffers and\noverflow", tooltip="A queue with bounded capacity drops or blocks arrivals once full, so its size trades memory and added delay against the loss rate under bursty input."];
"mlsys.ui-thread-inference" [id="concept-mlsys.ui-thread-inference", label="Asynchronous on-device\ninference", tooltip="Running inference off the application's main thread, so a model call does not block rendering and input handling, with results delivered back by callback or message."];
"mlsys.multi-head-latent-attention" [id="concept-mlsys.multi-head-latent-attention", label="Multi-head latent\nattention", tooltip="Attention that caches one low-rank latent vector per token in place of per-head keys and values, reconstructing them or absorbing the up-projections into the query and output weights, which shrinks the KV cache and decode memory traffic."];
"mlsys.pii-deidentification" [id="concept-mlsys.pii-deidentification", label="PII detection and de-\nidentification", tooltip="Finding personal identifiers in training corpora, logs, and prompts and removing, masking, or pseudonymizing them before the data is stored, trained on, or shared."];
"mlsys.system-identification" [id="concept-mlsys.system-identification", label="System identification", tooltip="Estimating the parameters of a dynamics model, such as masses, friction, delays, and actuator gains, from measured input-output data of the physical system."];
"mlsys.off-policy-evaluation" [id="concept-mlsys.off-policy-evaluation", label="Off-policy evaluation", tooltip="Estimating a proposed policy's expected outcomes from interactions collected under another policy, by propensity reweighting, outcome modeling, or doubly robust estimators, subject to assumptions about action coverage and confounding."];
"mlsys.pipeline-schedule" [id="concept-mlsys.pipeline-schedule", label="Pipeline schedule", tooltip="The order in which pipeline stages run the forward and backward passes of microbatches (fill-drain, one-forward-one-backward, interleaved), which sets the bubble fraction and how many microbatches' activations each stage holds."];
"mlsys.sequence-packing" [id="concept-mlsys.sequence-packing", label="Sequence packing", tooltip="Combining variable-length training examples into packed token buffers with explicit example boundaries and attention semantics to reduce padding work without unintended cross-example attention."];
"mlsys.document-chunking" [id="concept-mlsys.document-chunking", label="Document chunking", tooltip="Dividing source documents into retrievable units with chosen boundaries, overlap, and source identifiers so retrieval granularity fits embedding and generation budgets."];
"mlsys.resource-exhaustion-attack" [id="concept-mlsys.resource-exhaustion-attack", label="Resource-exhaustion\nattack", tooltip="Crafting inputs that maximize a model service's compute, energy, output length, or tool calls, degrading service for other users or running up the operator's cost."];
"mlsys.generated-content-watermarking" [id="concept-mlsys.generated-content-watermarking", label="Generated-content\nwatermarking", tooltip="Embedding a statistically detectable signal into generated text, images, or audio at generation time, such as by biasing token sampling, so that content can later be identified as model-generated."];
"mlsys.model-merging" [id="concept-mlsys.model-merging", label="Model merging", tooltip="Combining compatible model parameters or parameter updates, by averaging or arithmetic on weight differences, into one model that consolidates capabilities without further training or serving the sources separately."];
"mlsys.optical-circuit-switching" [id="concept-mlsys.optical-circuit-switching", label="Optical circuit\nswitching", tooltip="Reconfiguring optical connections between endpoints to match communication demand, trading switching delay and topology coordination against delivered bandwidth and network power."];
"mlsys.co-packaged-optics" [id="concept-mlsys.co-packaged-optics", label="Co-packaged optics", tooltip="Placing optical transceivers inside the switch or accelerator package beside the silicon, so electrical paths shrink and energy per bit falls, at the cost of field serviceability and added package heat."];
"mlsys.advanced-accelerator-packaging" [id="concept-mlsys.advanced-accelerator-packaging", label="Advanced accelerator\npackaging", tooltip="Integrating compute and memory dies through chiplets, interposers, or three-dimensional bonding to trade local bandwidth and manufacturing flexibility against power-delivery and heat-removal constraints."];
"mlsys.motion-forecasting" [id="concept-mlsys.motion-forecasting", label="Motion forecasting", tooltip="Predicting the future trajectories of other moving agents, usually as several weighted hypotheses, from their tracked history and the map, so a planner can avoid where they will be rather than where they are."];
"mlsys.representational-bias-evaluation" [id="concept-mlsys.representational-bias-evaluation", label="Representational bias\nevaluation", tooltip="Measuring stereotyped, demeaning, or unequal portrayals of groups in generated outputs, revealing representational harms that aggregate quality or decision-rate metrics can miss."];
"mlsys.group-relative-policy-optimization" [id="concept-mlsys.group-relative-policy-optimization", label="Group relative policy\noptimization", tooltip="A policy-gradient method that scores each sampled response against the mean reward of a group of responses to the same prompt, removing the learned critic at the cost of generating several rollouts per prompt."];
"mlsys.inter-token-latency" [id="concept-mlsys.inter-token-latency", label="Inter-token latency", tooltip="The time between consecutive output tokens or chunks delivered to a streaming client, whose distribution, not only its mean, exposes decode stalls that an average time per output token hides."];
"mlsys.hybrid-retrieval" [id="concept-mlsys.hybrid-retrieval", label="Hybrid retrieval", tooltip="Combining lexical and dense retrieval results through score or rank fusion to recover complementary matches while managing additional search cost and ranking calibration."];
"mlsys.fpga-acceleration" [id="concept-mlsys.fpga-acceleration", label="FPGA-based ML\nacceleration", tooltip="Mapping ML operations to reconfigurable logic, arithmetic blocks, and local memories so datapaths can match a workload at the cost of hardware compilation and resource constraints."];
"mlsys.device-initiated-communication" [id="concept-mlsys.device-initiated-communication", label="Device-initiated\ncommunication", tooltip="Communication in which kernels on the accelerator issue and synchronize inter-device transfers themselves, without a host call per exchange, allowing fine-grained fusion of compute and communication at the cost of explicit ordering and completion handling."];
"mlsys.model-collapse" [id="concept-mlsys.model-collapse", label="Model collapse", tooltip="Loss of coverage of the original data distribution across generations trained on model-generated data, making provenance and real-versus-synthetic mixture policies part of quality control."];
"mlsys.action-tokenization" [id="concept-mlsys.action-tokenization", label="Action tokenization", tooltip="Encoding continuous robot actions or action sequences as discrete model tokens, making reconstruction error and token count determinants of policy fidelity and execution cost."];
"mlsys.wafer-scale-acceleration" [id="concept-mlsys.wafer-scale-acceleration", label="Wafer-scale\nacceleration", tooltip="Executing ML on a compute-and-memory array spanning most of a semiconductor wafer, making spatial placement and communication between tiles central to performance."];
"mlsys.embedding-migration" [id="concept-mlsys.embedding-migration", label="Embedding model\nmigration", tooltip="Changing the encoder behind a vector index while keeping queries and stored vectors comparable, by re-encoding the corpus, validated mappings, or backward-compatible training, with a controlled serving cutover."];
"mlsys.register-pressure" [id="concept-mlsys.register-pressure", label="Register pressure", tooltip="Demand for registers from simultaneously live kernel values, which can reduce resident threads or force values to spill into slower memory."];
"mlsys.software-pipelining" [id="concept-mlsys.software-pipelining", label="Software pipelining", tooltip="Scheduling independent operations from different loop iterations to overlap, such as loading the next tile while computing the current one, hiding latency at the cost of extra live state and buffering."];
"mlsys.ecc-memory" [id="concept-mlsys.ecc-memory", label="Error-correcting code\nmemory", tooltip="Memory protected by redundant check bits that correct supported error patterns and report detectable uncorrectable errors, reducing the risk of silent corruption."];
"mlsys.integer-only-inference" [id="concept-mlsys.integer-only-inference", label="Integer-only inference", tooltip="Executing a quantized model with integer arithmetic throughout its operator graph, including accumulation and rescaling, so no floating-point operations are needed at inference time."];
"mlsys.execute-in-place" [id="concept-mlsys.execute-in-place", label="Execute-in-place\nweights", tooltip="Reading immutable model weights from memory-mapped flash during inference without first copying them into SRAM, reducing working memory while exposing flash-access latency."];
"mlsys.confused-deputy" [id="concept-mlsys.confused-deputy", label="Confused deputy", tooltip="A security failure in which a component uses its legitimate authority for an untrusted party's purpose because it does not distinguish the requester's authority from its own."];
"mlsys.judge-bias" [id="concept-mlsys.judge-bias", label="Model-grader bias", tooltip="Systematic scoring errors in model-based graders, such as preferences for response position, length, or style, that distort comparisons independently of task quality."];
"mlsys.over-refusal" [id="concept-mlsys.over-refusal", label="Over-refusal", tooltip="Refusing benign requests that resemble harmful ones, the false-positive side of a safety filter or refusal policy, which is traded against missed harmful requests when setting the operating point."];
"mlsys.coordinate-frames" [id="concept-mlsys.coordinate-frames", label="Coordinate frames and\ntransforms", tooltip="Reference frames and the spatial transforms between them that express sensor observations, robot geometry, and actions in consistent coordinates."];
"mlsys.sensor-degradation" [id="concept-mlsys.sensor-degradation", label="Sensor degradation", tooltip="Loss of sensor measurement fidelity under environmental or operating conditions, such as glare, rain, fog, dust, or a dirty lens, that degrades perception even when the sensing hardware has not failed."];
"mlsys.data-curriculum" [id="concept-mlsys.data-curriculum", label="Data curriculum and\nannealing", tooltip="Changing the training data distribution over a run, such as raising the share of high-quality or long-sequence data during the final learning-rate decay, to improve final capability per unit of compute."];
"mlsys.streaming-dataset-format" [id="concept-mlsys.streaming-dataset-format", label="Sharded streaming\ndataset format", tooltip="Organizing training examples into sequentially readable shard files so workers can stream records from remote storage with few small-object reads and bounded local staging."];
"mlsys.collective-algorithm-selection" [id="concept-mlsys.collective-algorithm-selection", label="Collective algorithm\nselection", tooltip="Choosing, per call, among collective algorithms (ring, tree, switch-offloaded) and wire protocols by message size, participant count, and link hierarchy, to minimize latency for small messages and maximize bandwidth for large ones."];
"mlsys.always-on-cascade" [id="concept-mlsys.always-on-cascade", label="Always-on sensing\ncascade", tooltip="Using a low-power sensing or inference stage to wake a more expensive stage only when needed, cutting continuous-monitoring energy at the risk of missed triggers and wake latency."];
"mlsys.fault-tree-analysis" [id="concept-mlsys.fault-tree-analysis", label="Fault tree analysis", tooltip="Top-down hazard analysis that decomposes an undesired top event into Boolean combinations of contributing faults, so minimal cut sets and their probabilities can be computed."];
"mlsys.metastable-failure" [id="concept-mlsys.metastable-failure", label="Metastable failure", tooltip="A state in which a transient trigger, such as a load spike or slowdown, starts a self-sustaining loop of retries, cache misses, or timeouts that keeps a system overloaded after the trigger is gone."];
"mlsys.fan-out-tail-amplification" [id="concept-mlsys.fan-out-tail-amplification", label="Fan-out tail\namplification", tooltip="The growth in a request's latency tail when it waits on many parallel subrequests, because the chance that at least one subrequest is slow rises with the fan-out."];
"mlsys.proxy-discrimination" [id="concept-mlsys.proxy-discrimination", label="Proxy discrimination", tooltip="Decisions driven by features that encode protected-group membership, so group disparities persist even when the protected attribute itself is omitted."];
"mlsys.cross-embodiment-training" [id="concept-mlsys.cross-embodiment-training", label="Cross-embodiment\ntraining", tooltip="Training one policy across datasets from several robot embodiments, aligning observations and action interfaces so learning is shared despite differences in sensors and control."];
"mlsys.dual-rate-hierarchical-policy" [id="concept-mlsys.dual-rate-hierarchical-policy", label="Dual-rate hierarchical\npolicy", tooltip="Splitting a robot policy into a slow high-level model that sets goals or latent commands and a fast low-level controller that tracks them at control rate, so large-model latency does not set the control loop's rate."];
"mlsys.robot-kinematics" [id="concept-mlsys.robot-kinematics", label="Robot kinematics", tooltip="The geometric mapping between joint positions and velocities and the pose and velocity of a robot's links and end effector, including inverse solutions and singular configurations where motion authority is lost."];
"mlsys.quantization-granularity" [id="concept-mlsys.quantization-granularity", label="Quantization\ngranularity", tooltip="The grouping of values that share quantization parameters, such as a scale and an optional zero point, from per tensor to per channel to small groups, trading approximation error against metadata and kernel cost."];
"mlsys.agent-training-environment" [id="concept-mlsys.agent-training-environment", label="Agent training\nenvironment", tooltip="A task system that supplies observations, accepts actions, and manages episode state for training tool-using policies, whose throughput and reset fidelity limit rollout collection."];
"mlsys.model-directed-control-flow" [id="concept-mlsys.model-directed-control-flow", label="Model-directed control\nflow", tooltip="A control structure in which model outputs select the next step, tool call, or stopping decision within runtime-enforced limits, increasing flexibility while making cost and behavior harder to predict and test."];
"mlsys.misuse-monitoring" [id="concept-mlsys.misuse-monitoring", label="Misuse monitoring", tooltip="Detecting policy-violating use of a deployed model across requests, sessions, and accounts, such as coordinated abuse or capability probing, and responding with throttling, review, or account action."];
"mlsys.masked-diffusion-decoding" [id="concept-mlsys.masked-diffusion-decoding", label="Masked diffusion\ndecoding", tooltip="Generating text by repeatedly predicting and committing masked positions in parallel, trading refinement passes for token parallelism while weakening the attention-state reuse that autoregressive decoding relies on."];
"mlsys.residual-connection" [id="concept-mlsys.residual-connection", label="Residual connection", tooltip="A connection that adds a block's input, or a projection of it, to the block's output, so information and gradients can bypass the block and deep stacks stay trainable."];
"mlsys.multi-task-learning" [id="concept-mlsys.multi-task-learning", label="Multi-task learning", tooltip="Jointly learning several tasks through shared parameters, often a shared backbone with task-specific heads, so their training signals can help or interfere with one another."];
"mlsys.recovery-objectives" [id="concept-mlsys.recovery-objectives", label="Recovery time and point\nobjectives", tooltip="Stated limits on how long restoring service may take (RTO) and how far recovered state may lag the state before the failure (RPO), which constrain checkpointing, replication, and failover design."];
"mlsys.incremental-checkpointing" [id="concept-mlsys.incremental-checkpointing", label="Incremental\ncheckpointing", tooltip="Persisting only the state that changed since the preceding checkpoint, with periodic full checkpoints as bases, which cuts write volume when updates are sparse at the cost of reconstructing state from a chain on restore."];
"mlsys.multiple-comparisons" [id="concept-mlsys.multiple-comparisons", label="Multiple comparisons\ncorrection", tooltip="Adjusting significance thresholds when many hypotheses, metrics, or slices are tested together, so the chance of a false declared effect, by family-wise error or false discovery rate, stays controlled."];
"mlsys.model-assisted-labeling" [id="concept-mlsys.model-assisted-labeling", label="Model-assisted labeling", tooltip="Using a model's predictions as draft labels that annotators accept or correct, which raises labeling throughput but can anchor annotators to the model's errors."];
"mlsys.forward-error-correction" [id="concept-mlsys.forward-error-correction", label="Forward error\ncorrection", tooltip="Adding redundant bits to transmitted data so the receiver corrects supported error patterns without retransmission, at the cost of coding overhead and decoding delay."];
"mlsys.erasure-coding" [id="concept-mlsys.erasure-coding", label="Erasure coding", tooltip="Encoding stored data into data and parity fragments so it can be reconstructed after a bounded number of fragment losses, trading storage overhead against encoding and recovery work."];
"mlsys.bandwidth-delay-product" [id="concept-mlsys.bandwidth-delay-product", label="Bandwidth-delay product", tooltip="A path's bottleneck bandwidth times its round-trip time, the amount of outstanding data a window-controlled flow must sustain to keep the path full."];
"mlsys.backfill-scheduling" [id="concept-mlsys.backfill-scheduling", label="Backfill scheduling", tooltip="Running lower-priority jobs in idle resource-time gaps without delaying the reserved start of a higher-priority job, which raises cluster utilization."];
"mlsys.traffic-classes" [id="concept-mlsys.traffic-classes", label="Network traffic classes\nand QoS", tooltip="Classifying traffic on a shared network into separately scheduled queues with configured priorities or bandwidth shares, limiting interference between collective, storage, and control traffic."];
"mlsys.telemetry-sampling" [id="concept-mlsys.telemetry-sampling", label="Telemetry sampling and\ncardinality control", tooltip="Choosing which traces, events, and metric label combinations to keep, by sampling and by bounding or aggregating label values, so fleet telemetry stays affordable at the risk of losing rare failures and fine-grained detail."];
"mlsys.dma-cache-maintenance" [id="concept-mlsys.dma-cache-maintenance", label="DMA cache maintenance", tooltip="Cleaning and invalidating processor caches around DMA transfers on hardware without coherent DMA, with buffers aligned to cache lines, so a device and the CPU do not read stale copies of a shared buffer; each maintenance step adds latency."];
"mlsys.expert-offloading" [id="concept-mlsys.expert-offloading", label="Expert offloading", tooltip="Keeping some mixture-of-experts weights in host memory or storage and fetching the experts a batch needs into accelerator memory, often prefetching predicted ones, which lets a model larger than accelerator memory run at the cost of transfers."];
"mlsys.variable-length-parallelism" [id="concept-mlsys.variable-length-parallelism", label="Variable-length\nparallelism planning", tooltip="Choosing, for each training step, sequence or context parallel degrees and how packed documents are sharded across ranks from that step's sequence lengths and attention patterns, so ranks receive balanced attention work."];
"mlsys.fine-grained-accelerator-sharing" [id="concept-mlsys.fine-grained-accelerator-sharing", label="Fine-grained\naccelerator sharing", tooltip="Scheduling co-located workloads on one accelerator in small units of a kernel, so latency-sensitive work can preempt background work quickly and interference stays bounded."];
"mlsys.intra-device-overlap" [id="concept-mlsys.intra-device-overlap", label="Intra-device overlap of\nbottlenecks", tooltip="Scheduling generative-inference operations with complementary compute, memory, or communication demands concurrently on one accelerator, using small batches or fused kernels so several hardware resources stay busy together."];
"mlsys.graph-pipeline-parallelism" [id="concept-mlsys.graph-pipeline-parallelism", label="Graph pipeline\nparallelism", tooltip="Pipeline parallelism that partitions a model whose layers form a branching graph into stages that follow the graph, so independent branches, such as separate modality encoders, run concurrently in parallel stages instead of being serialized into one chain."];
"mlsys.rag-pipeline-scheduling" [id="concept-mlsys.rag-pipeline-scheduling", label="RAG pipeline scheduling", tooltip="Coordinating the retrieval and generation work of retrieval-augmented requests across requests and processors, overlapping and batching work across the stage boundary and optionally adapting retrieval settings per query, to meet latency and answer-quality targets."];
"mlsys.cross-stack-profiling" [id="concept-mlsys.cross-stack-profiling", label="Cross-stack profiling", tooltip="Profiling that correlates timestamped events and calling contexts from model code, frameworks, native libraries, and accelerator kernels, so that device time and stalls can be attributed to the operations that launched them."];
"mlsys.model-swapping" [id="concept-mlsys.model-swapping", label="Model swapping and\nresidency", tooltip="Keeping some models' weights resident in accelerator memory and loading others from host memory or storage on demand, so a shared accelerator serves more models than fit at once, at the cost of transfer latency."];
"mlsys.kv-memory-allocation" [id="concept-mlsys.kv-memory-allocation", label="KV-cache memory\nallocation", tooltip="Laying out and allocating accelerator memory for cached attention state, which trades fragmentation and sharing against kernel compatibility and allocation cost."];
"mlsys.feed-forward-block" [id="concept-mlsys.feed-forward-block", label="Feed-forward block", tooltip="The per-position subnetwork of learned projections and a nonlinearity paired with attention in each Transformer block, which in most architectures holds the largest share of a dense model's parameters, executes as large matrix multiplications, and is the sublayer that mixture-of-experts routing replaces."];
"mlsys.service-level-agreement" [id="concept-mlsys.service-level-agreement", label="Service-level agreement", tooltip="A contract binding a provider to stated service targets, with declared consequences such as credits or penalties when they are missed, whose targets are usually set looser than the internal objectives that trigger engineering response."];
"mlsys.head-of-line-blocking" [id="concept-mlsys.head-of-line-blocking", label="Head-of-line blocking", tooltip="Delay imposed on short or ready work because a queue serves in arrival order and a long or stalled item ahead holds the service point, so an item's wait depends on what is in front of it rather than on its own cost."];
"mlsys.open-closed-loop-load" [id="concept-mlsys.open-closed-loop-load", label="Open-loop vs. closed-\nloop load", tooltip="A distinction between arrivals scheduled independently of responses and arrivals triggered by prior completions, which changes offered-load feedback and the queueing behavior a load test exposes."];
"mlsys.all-reduce" [id="concept-mlsys.all-reduce", label="All-reduce", tooltip="A collective in which every participant ends with the same reduction, usually the sum, of all participants' equal-shaped tensors, the operation that synchronizes gradients across replicas in data-parallel training."];
"mlsys.reduce-scatter-all-gather" [id="concept-mlsys.reduce-scatter-all-gather", label="Reduce-scatter and all-\ngather", tooltip="The complementary collectives in which each participant receives one reduced shard of the group's tensors (reduce-scatter) or the concatenation of every participant's shard (all-gather), the pair that moves sharded parameters and gradients in fully sharded training and composes into a bandwidth-optimal all-reduce."];
"mlsys.torus-topology" [id="concept-mlsys.torus-topology", label="Torus topology", tooltip="A fabric in which accelerator nodes form a multidimensional grid with wraparound links to fixed neighbors rather than tiers of switches, so neighbor and ring traffic can run at link rate while global exchanges are routed hop by hop with lower bisection bandwidth that depends on dimensions, routing, and contention."];
"mlsys.network-oversubscription" [id="concept-mlsys.network-oversubscription", label="Network\noversubscription", tooltip="Provisioning less uplink capacity at a switch tier than the downlink capacity it serves, written as a downlink-to-uplink ratio, which cuts fabric cost but makes cross-tier bandwidth contend when many endpoints communicate at once, as synchronized collectives do."];
"mlsys.host-memory" [id="concept-mlsys.host-memory", label="Host memory tier", tooltip="Memory directly managed by the host processor and used for input staging or offloaded model state, whose capacity and accelerator access costs depend on the platform's memory and interconnect design."];
"mlsys.schedule-separation" [id="concept-mlsys.schedule-separation", label="Algorithm-schedule\nseparation", tooltip="A compiler design in which what an operator computes is written once and how it runs, meaning loop order, tiling, vectorization, unrolling, memory placement, and parallel mapping, is a separate composable schedule, so the same algorithm can be retargeted and tuned without changing its semantics."];
"mlsys.kernel-synchronization" [id="concept-mlsys.kernel-synchronization", label="Kernel synchronization\nand atomics", tooltip="The barriers, memory fences, and atomic read-modify-write operations through which threads of a kernel coordinate access to shared data, where barrier stalls and contended atomics serialize work that the thread hierarchy otherwise runs in parallel."];
"mlsys.link-reach" [id="concept-mlsys.link-reach", label="Link reach limit\n(copper versus optics)", tooltip="The maximum distance over which a link meets its signal-quality requirements for a specified medium and signaling scheme, constraining cabling, retiming, and the geometry of connected accelerator domains."];
"mlsys.storage-access-pattern" [id="concept-mlsys.storage-access-pattern", label="Sequential versus\nrandom storage access", tooltip="Whether a workload reads storage in large contiguous ranges or in many small scattered requests, which decides whether sequential throughput or per-request latency and IOPS bound it, and so which media, layout, and shard sizes suit it."];
"mlsys.dataset-shuffling" [id="concept-mlsys.dataset-shuffling", label="Dataset shuffling", tooltip="Randomizing the order in which training examples are visited, by a full permutation or an approximate buffered shuffle over sharded files, trading the randomness that stochastic optimization assumes against the sequential reads that storage delivers cheaply."];
"mlsys.overfitting" [id="concept-mlsys.overfitting", label="Overfitting", tooltip="Fitting training-specific variation that does not persist in new data, causing training performance to overstate generalization."];
"mlsys.predictive-uncertainty" [id="concept-mlsys.predictive-uncertainty", label="Predictive uncertainty\nestimation", tooltip="An estimate of uncertainty in an individual prediction, sometimes decomposed into data noise and model uncertainty, used to support abstention, deferral, or data acquisition."];
"mlsys.statistical-power" [id="concept-mlsys.statistical-power", label="Statistical power", tooltip="The probability that an experiment detects an effect of a stated size, fixed by sample size, outcome variance, and the significance level, which decides how much traffic or how many evaluation items a comparison needs before its answer can be trusted."];
"mlsys.retrieval-metrics" [id="concept-mlsys.retrieval-metrics", label="Retrieval quality\nmetrics", tooltip="Measures of a retriever's ranked results against relevance judgments, such as recall at k, mean reciprocal rank, and normalized discounted cumulative gain, which show the retrieval depth and ranking quality a downstream reranker or generator can rely on."];
"mlsys.rejection-sampling-fine-tuning" [id="concept-mlsys.rejection-sampling-fine-tuning", label="Rejection-sampling\nfine-tuning", tooltip="Generating candidate responses, filtering them with an acceptance criterion, and fine-tuning on accepted responses to turn a selection signal into supervised training data, with repeated filtering potentially reducing diversity."];
"mlsys.early-stopping" [id="concept-mlsys.early-stopping", label="Early stopping", tooltip="Ending training according to a held-out validation criterion and selecting a checkpoint under that criterion, limiting additional compute and potentially reducing overfitting."];
"mlsys.group-dro" [id="concept-mlsys.group-dro", label="Group distributionally\nrobust optimization", tooltip="Training to minimize the highest expected loss among predefined groups so that poor subgroup performance is not hidden by average loss."];
"mlsys.chat-template" [id="concept-mlsys.chat-template", label="Chat template", tooltip="The fixed scheme of role markers and special tokens that serializes system instructions, user and assistant turns, and tool calls into one token sequence, which must match between fine-tuning and serving or the model misreads turn boundaries."];
"mlsys.generation-stopping" [id="concept-mlsys.generation-stopping", label="Stop conditions and\noutput-length limits", tooltip="Rules that terminate autoregressive generation when a stopping criterion is met, including an end token, a stop sequence, or an output-token limit."];
"mlsys.runbook" [id="concept-mlsys.runbook", label="Runbook", tooltip="A written or automated procedure attached to an alert that says how to confirm, mitigate, and escalate a known failure, so that response speed does not depend on who is on call."];
"mlsys.rl-training-colocation" [id="concept-mlsys.rl-training-colocation", label="Colocated versus\ndisaggregated RL post-\ntraining", tooltip="Whether rollout generation and policy updates share the same accelerators, alternating phases and re-sharding weights in place, or run on separate pools that exchange weights and samples, trading idle time within each phase against transfer cost and policy staleness."];
"mlsys.sequential-revision" [id="concept-mlsys.sequential-revision", label="Sequential revision", tooltip="Refining an answer through successive model calls conditioned on earlier drafts and internal or external feedback, spending additional inference compute on dependent revisions."];
"mlsys.semi-supervised-learning" [id="concept-mlsys.semi-supervised-learning", label="Semi-supervised\nlearning", tooltip="Learning from a small labeled set together with a large unlabeled one, typically by training on confident model predictions for unlabeled examples or by enforcing consistent predictions under perturbation, which lowers labeling cost but can reinforce the model's own early mistakes."];
"mlsys.contrastive-learning" [id="concept-mlsys.contrastive-learning", label="Contrastive learning", tooltip="A self-supervised or paired-data objective that pulls representations of matched views or pairs together and pushes mismatched ones apart, whose quality depends on how many negatives each step sees, which makes large batches and their memory a systems cost."];
"mlsys.training-memory-estimate" [id="concept-mlsys.training-memory-estimate", label="Training memory\nestimate", tooltip="Approximating a training step's accelerator memory as a per-parameter cost for weights, gradients, and optimizer state in their chosen precisions, plus activation memory that grows with batch size, sequence length, and depth, to decide what fits before a run is launched."];
"mlsys.privacy-budget" [id="concept-mlsys.privacy-budget", label="Privacy budget and\naccounting", tooltip="A declared bound on cumulative privacy loss across releases involving overlapping individuals, tracked through composition accounting to constrain further releases."];
"mlsys.bias-sources" [id="concept-mlsys.bias-sources", label="Sources of bias in the\npipeline", tooltip="The distinct points at which disparity enters an ML system, from the world the data records, who is sampled, how labels and features are measured, pooling heterogeneous groups into one model, an unrepresentative evaluation set, and use outside the intended context, each of which calls for a different remedy."];
"mlsys.carbon-accounting-method" [id="concept-mlsys.carbon-accounting-method", label="Location-based vs.\nmarket-based carbon\naccounting", tooltip="Accounting for purchased-electricity emissions using grid-average emission factors or qualifying contractual instruments, which changes the emissions attributed to the same electricity consumption."];
"mlsys.request-timeout" [id="concept-mlsys.request-timeout", label="Timeouts and deadline\npropagation", tooltip="A caller's time limit propagated to dependencies so they can stop work after the remaining budget expires, bounding caller wait and reducing abandoned work when cancellation is enforced."];
"mlsys.data-protection-regulation" [id="concept-mlsys.data-protection-regulation", label="Data protection\nregulation", tooltip="Law governing the collection, use, retention, and automated use of personal data, which imposes obligations such as consent, purpose limitation, deletion, impact assessment, and rights over automated decisions that an ML system must implement in its data pipeline, models, and decision flow."];
"mlsys.weight-exfiltration" [id="concept-mlsys.weight-exfiltration", label="Model weight theft", tooltip="Theft of a model's parameter files from training, storage, or serving infrastructure by insiders or intruders, as distinct from reconstructing the model through its query interface, which the owner counters with access control, encryption at rest, attested execution, and egress limits."];
"mlsys.ai-bill-of-materials" [id="concept-mlsys.ai-bill-of-materials", label="AI bill of materials", tooltip="An inventory of the datasets, base weights, libraries, and build steps that produced a model, with versions and hashes, so consumers can check every component against vulnerability and trust lists before depending on the model."];
"mlsys.ai-incident-reporting" [id="concept-mlsys.ai-incident-reporting", label="AI incident reporting", tooltip="Recording and disclosing harms and near-misses caused by a deployed AI system to an internal register or an external authority or database, as regulation or policy requires, so that patterns across deployments feed back into risk management."];
"mlsys.mechanistic-interpretability" [id="concept-mlsys.mechanistic-interpretability", label="Mechanistic\ninterpretability", tooltip="Investigating how a network's internal representations and computations produce behavior through analysis and interventions, to test explanations at the level of internal components."];
"mlsys.safety-certification" [id="concept-mlsys.safety-certification", label="Safety certification", tooltip="An independent assessment that a system meets specified safety requirements for a stated use, providing evidence for deployment approval and review of relevant changes."];
"mlsys.tolerable-risk" [id="concept-mlsys.tolerable-risk", label="Risk acceptance\ncriteria", tooltip="Criteria used to judge whether residual risk is acceptable or tolerable in a stated application and whether additional risk reduction is required."];
"mlsys.fleet-hardware-screening" [id="concept-mlsys.fleet-hardware-screening", label="Fleet hardware\nscreening tests", tooltip="Periodically running test workloads with known outputs on fleet accelerators and processors, at intake and during production, to find defective or silently miscomputing units before they corrupt jobs, at the cost of fleet time spent on tests."];
"mlsys.hardware-performance-counters" [id="concept-mlsys.hardware-performance-counters", label="Hardware performance\ncounters", tooltip="On-chip event counters, such as cycles, issued instructions, cache misses, bytes moved, and active compute units, that profilers sample to compute achieved bandwidth and arithmetic rate and to attribute stalls to their cause rather than to elapsed time alone."];
"mlsys.trajectory-log" [id="concept-mlsys.trajectory-log", label="Trajectory log", tooltip="An append-only harness-owned record of intents before dispatch and outcomes after execution, together with approvals and budget state, that supports recovery, replay, evaluation, and audit."];
"mlsys.odometry" [id="concept-mlsys.odometry", label="Odometry and dead\nreckoning", tooltip="Estimating a platform's pose change by integrating its own motion measurements, from wheel encoders, inertial units, or feature motion in camera and lidar frames, whose error grows without bound with distance traveled unless corrected by loop closure or an external reference."];
"mlsys.capture-epoch" [id="concept-mlsys.capture-epoch", label="Capture timing and\nrolling shutter", tooltip="The time or interval over which a measurement is acquired, whose spread across rows or beams can require motion compensation before observations are fused."];
"mlsys.timing-jitter" [id="concept-mlsys.timing-jitter", label="Timing jitter", tooltip="Variation in the period or completion time of a periodic sensing, inference, or control task, which degrades a controller designed for a fixed sample interval even when every deadline is met, so real-time budgets bound the spread of completion times and not only their worst case."];
"mlsys.deterministic-field-network" [id="concept-mlsys.deterministic-field-network", label="Real-time fieldbus", tooltip="A device network engineered to provide bounded delivery under stated traffic and scheduling assumptions, whose cycle time and occupancy constrain sensing and control deadlines."];
"mlsys.loop-stability-margin" [id="concept-mlsys.loop-stability-margin", label="Loop stability margin", tooltip="The allowed gain or phase variation before a specified feedback loop becomes unstable, used to budget delay and model uncertainty around an operating point."];
"mlsys.impedance-force-control" [id="concept-mlsys.impedance-force-control", label="Impedance and force\ncontrol", tooltip="Feedback control that regulates the relationship between motion and contact force, by commanding a virtual stiffness and damping or by tracking a force setpoint, so a robot can touch, push, and insert without the force spikes that pure position control produces at contact."];
"mlsys.in-doubt-action" [id="concept-mlsys.in-doubt-action", label="In-doubt action", tooltip="An external action whose outcome is unknown after dispatch, requiring reconciliation or retry-safe endpoint semantics before recovery chooses whether to repeat or skip it."];
"mlsys.model-bandwidth-utilization" [id="concept-mlsys.model-bandwidth-utilization", label="Model bandwidth\nutilization", tooltip="Model-required bytes of weights and KV cache per decoding step divided by step time and by the aggregate peak memory bandwidth of the participating devices, the memory-bound counterpart of model FLOPs utilization, stated for a given batch and cache configuration."];
"mlsys.hot-spare-capacity" [id="concept-mlsys.hot-spare-capacity", label="Hot-spare capacity", tooltip="Idle, pre-provisioned accelerators or nodes reserved to replace failed workers, reducing the delay of acquiring replacement resources at the cost of reserved capacity."];
"mlsys.geo-distributed-training" [id="concept-mlsys.geo-distributed-training", label="Geo-distributed\ntraining", tooltip="Planning one training job across accelerators in several datacenters by placing the low-communication parallelism dimension (pipeline stages, local-SGD replicas, or asynchronous hierarchies) on the long, narrow inter-site links and the bandwidth-hungry dimensions inside each site, and scheduling the WAN transfers against its latency and bandwidth."];
"mlsys.quarantined-model-pattern" [id="concept-mlsys.quarantined-model-pattern", label="Quarantined-model\npattern", tooltip="Separating privileged planning from an unprivileged model that parses untrusted content, so that parsed values reach the planner only as references and a trusted runtime, often with provenance tracking, checks derived values before tool execution."];
"mlsys.sycophancy-evaluation" [id="concept-mlsys.sycophancy-evaluation", label="Sycophancy evaluation", tooltip="Measuring how often a model abandons a correct answer or endorses a user's mistaken claim under pushback, authority cues, or social pressure, usually across several turns, so that agreement-seeking is measured separately from task accuracy."];
"mlsys.communication-intensity" [id="concept-mlsys.communication-intensity", label="Communication-to-\ncomputation ratio", tooltip="The bytes a parallel plan must exchange per unit of local arithmetic, which, set against link bandwidth and the accelerator's FLOP rate, says whether a stage is communication-bound in the same way arithmetic intensity says whether a kernel is memory-bound."];
"mlsys.technology-scaling" [id="concept-mlsys.technology-scaling", label="Technology scaling", tooltip="The historical trends by which transistor density doubled on a steady cadence while, for a long period, power density stayed constant as transistors shrank; the end of constant power density is why added transistors can no longer all be clocked at once, pushing designs toward parallelism and specialization."];
"mlsys.compression-composition" [id="concept-mlsys.compression-composition", label="Compression technique\ncomposition", tooltip="Applying several compression methods in a chosen sequence, whose interactions can reinforce or diminish their individual savings and must be evaluated jointly for quality and execution cost."];
"mlsys.fidelity-adaptive-serving" [id="concept-mlsys.fidelity-adaptive-serving", label="Fidelity-adaptive\nserving", tooltip="Meeting a latency target under rising load by switching requests to a cheaper variant of the same model, such as a lower-precision copy, a pruned subnetwork, or fewer layers, so capacity is bought with controlled quality loss instead of queueing or rejection."];
"mlsys.compound-workflow-pipelining" [id="concept-mlsys.compound-workflow-pipelining", label="Compound workflow\npipelining", tooltip="Overlapping stages of a compound ML application by streaming intermediate results to downstream stages as their dependencies become available, reducing critical-path latency while preserving dependency order."];
"mlsys.reachability-analysis" [id="concept-mlsys.reachability-analysis", label="Reachability analysis", tooltip="Computing the set of states a system, or another agent in its workspace, can reach within a time horizon under its dynamics and bounded inputs or disturbances, used to prove a safe set invariant, to size clearance margins, and to screen proposed motions against where other agents could be."];
"mlsys.fairness-monitoring" [id="concept-mlsys.fairness-monitoring", label="Fairness monitoring", tooltip="Tracking group fairness metrics on production traffic over time, with the sampling, delayed-label, and protected-attribute availability problems that make subgroup estimates noisier than aggregate ones, so that disparities introduced by drift or retraining are caught before they accumulate."];
"mlsys.link-signal-integrity" [id="concept-mlsys.link-signal-integrity", label="Link signal degradation\nand flaps", tooltip="Physical-link degradation that produces excessive bit errors, retraining, or intermittent disconnections, causing retransmission and communication stalls when protection mechanisms cannot absorb it."];
"mlsys.activation-function" [id="concept-mlsys.activation-function", label="Activation function", tooltip="The elementwise or gated nonlinearity applied between a network's linear layers, whose choice sets whether activations contain exact zeros, whether a block needs an extra gating projection, and how cheaply the operation fuses into the preceding matrix multiply."];
"mlsys.attention-ffn-disaggregation" [id="concept-mlsys.attention-ffn-disaggregation", label="Attention-FFN\ndisaggregation", tooltip="Running attention layers and the feed-forward or expert layers on separate accelerator pools during decode, so memory-bound attention over the KV cache and compute-bound expert matmuls are each batched and provisioned on hardware suited to them, at the cost of streaming activations between pools at every layer."];
"mlsys.label-shift-estimation" [id="concept-mlsys.label-shift-estimation", label="Label-shift estimation\nand prior correction", tooltip="Estimating deployment class priors from unlabeled predictions under stable class-conditional input distributions and adjusting weights or probabilities to reduce errors from the changed priors."];
"mlsys.map-representation" [id="concept-mlsys.map-representation", label="Map representation", tooltip="The data structure a robot keeps of its environment, such as an occupancy grid, signed-distance field, point cloud, mesh, or semantic layer, chosen by the queries that planning and collision checking must answer at their rates and by the memory and update cost the onboard computer can afford."];
"mlsys.compute-cost-estimate" [id="concept-mlsys.compute-cost-estimate", label="Compute cost estimate", tooltip="Estimating accelerator time from workload demand and effective hardware performance, then applying resource prices to estimate monetary compute cost under a stated deployment plan."];
"mlsys.precision-recall" [id="concept-mlsys.precision-recall", label="Precision, recall, and\nROC analysis", tooltip="Classifier metrics that separate the two error types, false positives and false negatives, and the curves (ROC, precision-recall) that show how a decision threshold trades them, which matter whenever classes are imbalanced or the two errors cost differently."];
"mlsys.instruction-hierarchy" [id="concept-mlsys.instruction-hierarchy", label="Instruction privilege\nlevels", tooltip="Giving instructions from the system, the user, and retrieved or tool-returned content distinct privilege levels, through prompt formatting, delimiting, or training, so that lower-privilege content is less able to override higher-privilege instructions."];
"mlsys.restart-free-recovery" [id="concept-mlsys.restart-free-recovery", label="Restart-free failure\nrecovery", tooltip="Reconfiguring distributed training around surviving replicas of model and optimizer state so that the job resumes after supported worker failures without a full-job restart or durable-checkpoint reload, reducing recovery delay at the cost of redundancy and reconfiguration."];
"mlsys.shared-memory-bank-conflict" [id="concept-mlsys.shared-memory-bank-conflict", label="Shared-memory bank\nconflict", tooltip="Serialization of a shared-memory request when threads access different addresses in the same bank, reducing effective shared-memory bandwidth."];
