        "label": "Selective prediction",
        "home": "metrics-uncertainty",
        "before_definition": "Predicting on admitted cases and abstaining or deferring the rest.",
        "after_definition": "Output-gating mechanism that returns model outputs for admitted cases and abstains on or defers the rest.",
        "before_aliases": [],
        "after_aliases": [
          "selective classification"
        ]
      },
      {
        "id": "mlsys.constrained-decoding",
        "label": "Constrained decoding",
        "home": "structured-generation",
        "before_definition": "Masking disallowed tokens at each step, typically from a grammar or schema automaton, so output satisfies a structural constraint.",
        "after_definition": "Generation-control mechanism that restricts token selection or emits deterministic token spans, typically via a grammar or schema automaton, so generated output conforms to a required syntax or schema.",
        "before_aliases": [
          "grammar-guided decoding"
        ],
        "after_aliases": [
          "grammar-guided decoding",
          "FSM-guided decoding"
        ]
      }
    ],
    "final_patch": {
      "concepts_update": [
        {
          "id": "mlsys.batching",
          "definition": "Request-execution mechanism that groups queued requests for joint processing to share work or improve resource use.",
          "add_aliases": [
            "dynamic batching"
          ],
          "alias_metadata": {
            "dynamic batching": {
              "type": "upward-posting",
              "source": "Huyen, Designing Machine Learning Systems (O'Reilly, 2022), Ch. 7 (dev unit P4-S1-DMLS-01, S1); Crankshaw et al., Clipper (NSDI 2017).",
              "dev_lineages_requiring_separation": 0,
              "checked_dev_units": [
                "P4-S1-DMLS-01",
                "P4-COV-mlsysbook-vol1-vol2-primary-168",
                "P4-S3-ORCA-2022"
              ],
              "scope_note": "Online run-time coalescing of queued requests into a batch under wait-time or batch-size bounds is posted upward to Request batching. Offline mlsys.batch-inference, iteration-level mlsys.continuous-batching, and framework-level batching of operations across dynamic computation graphs are excluded; pf_huyen_dmls names dynamic batching, and 0 checked dev lineages require indexing it separately from Request batching."
            }
          }
        },
        {
          "id": "mlsys.constrained-decoding",
          "definition": "Generation-control mechanism that restricts token selection or emits deterministic token spans, typically via a grammar or schema automaton, so generated output conforms to a required syntax or schema.",
          "add_aliases": [
            "FSM-guided decoding"
          ],
          "alias_metadata": {
            "FSM-guided decoding": {
              "type": "upward-posting",
              "source": "Willard & Louf, Efficient Guided Generation for Large Language Models (2023, Outlines). Checked dev units P4-S2-CMU11868-02 (S2) and P4-S3-SGLANG-2024 (S3) attest finite-state-automaton token masking and compressed finite-state jump-forward decoding under constrained decoding, not this literal alias.",
              "dev_lineages_requiring_separation": 0,
              "checked_dev_units": [
                "P4-S2-CMU11868-02",
                "P4-S3-SGLANG-2024"
              ],
              "scope_note": "Finite-state-machine enforcement of structural output rules is posted upward to Constrained decoding alongside grammar-guided decoding. CMU 11-868 describes FSM token masking while SGLang describes compressed finite-state jump-forward execution of deterministic spans during grammar-constrained decoding; 0 checked dev lineages require indexing FSM-guided decoding separately from Constrained decoding."
            }
          }
        },
        {
          "id": "mlsys.selective-prediction",
          "definition": "Output-gating mechanism that returns model outputs for admitted cases and abstains on or defers the rest.",
          "add_aliases": [
            "selective classification"
          ],
          "alias_metadata": {
            "selective classification": {
              "type": "upward-posting",
              "source": "El-Yaniv & Wiener (JMLR 2010); Geifman & El-Yaniv (NeurIPS 2017). Checked dev unit Q4-S2-STANFORD-CS329T-01 (S2) attests the parent concept as 'selective abstention', not this alias.",
              "dev_lineages_requiring_separation": 0,
              "checked_dev_units": [
                "Q4-S2-STANFORD-CS329T-01"
              ],
              "scope_note": "Classification-specific selective abstention is posted upward to Selective prediction (0 checked dev lineages require separating classification-only abstention from general selective prediction; unqualified 'reject-option classification' is excluded to prevent Z39.19 section 5.3.1 homograph collision with Q5 fairness post-processing)."
            }
          }
        },
        {
          "id": "mlsys.benchmark",
          "remove_aliases": [
            "MLPerf",
            "benchmark suite"
          ]
        },
        {
          "id": "mlsys.online-experiment",
          "remove_aliases": [
            "preregistered analysis plan"
          ]
        }
      ],
      "subject_updates": [
        {
          "row": "on-device-deployment",
          "add_secondary_concepts": [
            "mlsys.memory-planning"
          ],
          "rationale": "On-device deployment under SRAM and mobile memory ceilings relies on compile-time static tensor buffer memory planning (dev unit P4-S2-MIT65940-01, S2), homed in Stack area S2 (ml-compilers)."
        }
      ]
    },
