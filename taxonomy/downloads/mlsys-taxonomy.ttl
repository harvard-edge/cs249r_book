  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.efficiency-frontier> ;
  rdfs:label "can shift outward"@en ;
  taxmeta:condition "When model structure and hardware or kernels are designed together rather than one being fixed while the other is tuned."@en .

_:statement426 a rdf:Statement ;
