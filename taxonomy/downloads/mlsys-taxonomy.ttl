  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.checkpoint-interval> ;
  rdfs:label "shortens"@en ;
  taxmeta:condition "When the blocking snapshot to host memory costs much less than the durable write, lowering the effective checkpoint cost."@en .

_:statement435 a rdf:Statement ;
  dct:identifier "rel.elastic-training.checkpoint"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.elastic-training> ;
  rdf:predicate mlsys:uses ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.checkpoint> ;
  rdfs:label "resumes from"@en ;
  taxmeta:condition "When the job restarts on a changed worker set and state must be resharded from the latest consistent checkpoint."@en .

_:statement436 a rdf:Statement ;
  dct:identifier "rel.elastic-training.training-goodput"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.elastic-training> ;
  rdf:predicate mlsys:increases ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.training-goodput> ;
  rdfs:label "can raise"@en ;
  taxmeta:condition "When replacing failed nodes takes longer than continuing at reduced width and the optimizer tolerates the batch-size change."@en .

_:statement437 a rdf:Statement ;
  dct:identifier "rel.abft.silent-data-corruption"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.abft> ;
