  taxmeta:entryTerm "rotary position embedding"@en ;
  taxmeta:entryTerm "RoPE"@en ;
  taxmeta:entryTerm "ALiBi"@en ;
  taxmeta:entryTerm "relative position encoding"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Representations that make sequence position available to a model."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.context> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.tokenization> a skos:Concept ;
