_:statement440 a rdf:Statement ;
  dct:identifier "rel.chaos-engineering.blast-radius"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.blast-radius> ;
  rdf:predicate mlsys:limits ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.chaos-engineering> ;
  rdfs:label "bounds"@en ;
