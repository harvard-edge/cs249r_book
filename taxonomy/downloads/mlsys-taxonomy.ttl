  rdfs:label "is a cheaper, approximate alternative to full"@en ;
  taxmeta:condition "Exact unlearning equals retraining without the removed records; approximate methods trade the strength of the guarantee for lower cost."@en .

_:statement461 a rdf:Statement ;
  dct:identifier "rel.machine-unlearning.lineage"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.machine-unlearning> ;
