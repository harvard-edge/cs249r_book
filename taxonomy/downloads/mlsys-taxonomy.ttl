  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Available storage for concurrently resident state and intermediates."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.batch-size> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.training-state> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.kv-cache> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.batching> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-footprint> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.on-device-training> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.on-device-runtime> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.accelerator-execution-architecture> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Accelerator execution architecture"@en ;
  taxmeta:entryTerm "GPU architecture"@en ;
  taxmeta:entryTerm "streaming multiprocessor"@en ;
  taxmeta:entryTerm "SM"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Organization of arithmetic units, execution lanes or threads, scheduling resources, and local storage that determines how supported operations run. SIMD/SIMT, matrix units, and systolic arrays are distinct examples."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.matrix-multiply> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.arithmetic-intensity> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Arithmetic intensity"@en ;
  taxmeta:entryTerm "operational intensity"@en ;
  taxmeta:entryTerm "FLOPs per byte"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Arithmetic work per byte transferred at a specified memory boundary."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.roofline> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.roofline> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Roofline bound"@en ;
  taxmeta:entryTerm "roofline model"@en ;
  taxmeta:entryTerm "roofline analysis"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "A performance bound combining a compute ceiling with an intensity-dependent bandwidth ceiling."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.execution-time> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.model-flops-utilization> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.locality> a skos:Concept ;
