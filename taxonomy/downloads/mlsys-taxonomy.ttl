_:statement447 a rdf:Statement ;
  dct:identifier "rel.adversarial-training.evasion"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.adversarial-training> ;
  rdf:predicate mlsys:mitigates ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.evasion> ;
