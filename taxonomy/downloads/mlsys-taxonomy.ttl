  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Adapting a model by changing a limited parameter subset or added parameterization."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.transfer-learning> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.training-state> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.catastrophic-forgetting> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.tensor-layout> a skos:Concept ;
