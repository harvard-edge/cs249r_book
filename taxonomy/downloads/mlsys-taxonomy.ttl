_:statement443 a rdf:Statement ;
  dct:identifier "rel.hardware-fault-injection.silent-data-corruption"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.hardware-fault-injection> ;
  rdf:predicate mlsys:measures ;
