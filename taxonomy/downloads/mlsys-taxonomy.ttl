_:statement460 a rdf:Statement ;
  dct:identifier "rel.machine-unlearning.retraining"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.machine-unlearning> ;
  rdf:predicate mlsys:alternative-to ;
