_:statement448 a rdf:Statement ;
  dct:identifier "rel.adversarial-training.generalization"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.adversarial-training> ;
  rdf:predicate mlsys:trades-off ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.generalization> ;
  rdfs:label "trades off against clean"@en ;
  taxmeta:condition "Robust training typically costs clean accuracy and multiplies training compute by the cost of generating adversaries."@en .

_:statement449 a rdf:Statement ;
  dct:identifier "rel.model-extraction.model-artifact"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.model-extraction> ;
  rdf:predicate mlsys:produces ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.model-artifact> ;
  rdfs:label "produces a functional copy of"@en ;
