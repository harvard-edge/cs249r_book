  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Recreating forward intermediates during backward execution to reduce retained memory."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-footprint> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.execution-time> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-offloading> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.model-flops-utilization> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.scaling-laws> a skos:Concept ;
