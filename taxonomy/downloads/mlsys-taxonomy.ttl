  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.precision> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.metrics> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.block-scaled-format> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.cost-per-token> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-footprint> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.energy-per-inference> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.sparsity> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Sparsity"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "A pattern of absent or zero values whose execution benefit depends on representation and support."@en .

<https://mlsysbook.ai/taxonomy/concept/mlsys.distillation> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Knowledge distillation"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Training a student to match output distributions or internal signals from a teacher model or ensemble, potentially reducing serving cost when the student is cheaper while requiring validation of retained quality."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.neural-network> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-footprint> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.speculative-decoding> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.model-watermarking> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.compilation> a skos:Concept ;
