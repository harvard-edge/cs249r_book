  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.queueing> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.graceful-degradation> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.resource-exhaustion-attack> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.metastable-failure> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.kv-cache> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.autoscaling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Autoscaling"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Changing provisioned service resources in response to measured or predicted demand."@en ;
