_:statement454 a rdf:Statement ;
  dct:identifier "rel.unsafe-deserialization.supply-chain-compromise"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.unsafe-deserialization> ;
