  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "A high quantile of a defined request-latency distribution."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.online-inference> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.batching> a skos:Concept ;
