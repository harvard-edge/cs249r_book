_:statement453 a rdf:Statement ;
  dct:identifier "rel.artifact-signing.lineage"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.artifact-signing> ;
  rdf:predicate mlsys:uses ;
