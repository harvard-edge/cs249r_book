  rdfs:label "can use, to hide individual client updates,"@en ;
  taxmeta:condition "When enough clients participate per round that the aggregate does not reveal any single client's update."@en .

_:statement463 a rdf:Statement ;
  dct:identifier "rel.secure-aggregation.poisoning"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.secure-aggregation> ;
  rdf:predicate mlsys:increases ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.poisoning> ;
  rdfs:label "hinders detection of, increasing exposure to"@en ;
  taxmeta:condition "Because the server sees only aggregated updates, it cannot inspect individual client updates for anomalies."@en .

_:statement464 a rdf:Statement ;
  dct:identifier "rel.least-privilege.authorization"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.least-privilege> ;
  rdf:predicate mlsys:limits ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.authorization> ;
  rdfs:label "constrains grants made by"@en ;
  taxmeta:condition "When permissions are scoped to the task and expire or are revoked when the task ends."@en .

_:statement465 a rdf:Statement ;
  dct:identifier "rel.least-privilege.prompt-injection"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.least-privilege> ;
  rdf:predicate mlsys:mitigates ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.prompt-injection> ;
  rdfs:label "limits the consequences of"@en ;
  taxmeta:condition "When a model-driven component processes untrusted content and can act only through narrowly scoped credentials and tools."@en .

_:statement466 a rdf:Statement ;
  dct:identifier "rel.confidential-computing.isolation"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.confidential-computing> ;
  rdf:predicate mlsys:specializes ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.isolation> ;
  rdfs:label "is a hardware-attested form of"@en ;
  taxmeta:condition "When the trusted execution environment's hardware and firmware are trusted and the host operator is not."@en .

_:statement467 a rdf:Statement ;
  dct:identifier "rel.remote-attestation.confidential-computing"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.remote-attestation> ;
  rdf:predicate mlsys:enables ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.confidential-computing> ;
  rdfs:label "establishes trust in"@en ;
  taxmeta:condition "When the verifier checks attestation evidence against reference values before releasing keys, data, or model weights."@en .

_:statement468 a rdf:Statement ;
  dct:identifier "rel.side-channel.isolation"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.side-channel> ;
  rdf:predicate mlsys:limits ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.isolation> ;
  rdfs:label "can bypass"@en ;
  taxmeta:condition "When tenants share accelerators, caches, memory, or interconnect whose timing or contention is observable across the boundary."@en .

_:statement469 a rdf:Statement ;
  dct:identifier "rel.operational-carbon.carbon"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.operational-carbon> ;
  rdf:predicate mlsys:part-of ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.carbon> ;
  rdfs:label "is a component of"@en ;
  taxmeta:condition "Lifecycle carbon sums operational and embodied components under one declared accounting boundary."@en .

_:statement470 a rdf:Statement ;
  dct:identifier "rel.embodied-carbon.carbon"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.embodied-carbon> ;
  rdf:predicate mlsys:part-of ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.carbon> ;
  rdfs:label "is a component of"@en ;
  taxmeta:condition "Lifecycle carbon sums operational and embodied components under one declared accounting boundary."@en .

_:statement471 a rdf:Statement ;
  dct:identifier "rel.carbon-intensity.operational-carbon"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.carbon-intensity> ;
  rdf:predicate mlsys:increases ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.operational-carbon> ;
  rdfs:label "scales"@en ;
  taxmeta:condition "Operational carbon is energy consumed times the carbon intensity of supply at the time and place of consumption."@en .

_:statement472 a rdf:Statement ;
  dct:identifier "rel.carbon-aware-scheduling.carbon-intensity"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.carbon-aware-scheduling> ;
  rdf:predicate mlsys:uses ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.carbon-intensity> ;
  rdfs:label "exploits variation in"@en ;
  taxmeta:condition "When workloads are deferrable or relocatable and intensity varies materially across hours or regions."@en .

_:statement473 a rdf:Statement ;
  dct:identifier "rel.carbon-aware-scheduling.slo"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.carbon-aware-scheduling> ;
  rdf:predicate mlsys:trades-off ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.slo> ;
  rdfs:label "trades off against"@en ;
  taxmeta:condition "When shifting work in time or place delays completion or adds latency beyond a stated objective."@en .

_:statement474 a rdf:Statement ;
  dct:identifier "rel.energy-efficiency.energy"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.energy-efficiency> ;
  rdf:predicate mlsys:reduces ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.energy> ;
  rdfs:label "lowers, for a fixed amount of work,"@en ;
  taxmeta:condition "When useful work and energy are measured over the same system boundary and workload."@en .

_:statement475 a rdf:Statement ;
  dct:identifier "rel.emission-scopes.embodied-carbon"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.emission-scopes> ;
  rdf:predicate mlsys:determines ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.embodied-carbon> ;
  rdfs:label "classifies as value-chain (Scope 3)"@en ;
  taxmeta:condition "For an operator buying hardware, manufacturing emissions fall in Scope 3 while purchased electricity falls in Scope 2."@en .

_:statement476 a rdf:Statement ;
  dct:identifier "rel.lifecycle-assessment.embodied-carbon"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.lifecycle-assessment> ;
  rdf:predicate mlsys:measures ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.embodied-carbon> ;
  rdfs:label "estimates"@en ;
  taxmeta:condition "When the assessment's goal, scope, and functional unit are stated and manufacturer data are available or proxied."@en .

_:statement477 a rdf:Statement ;
  dct:identifier "rel.water-footprint.energy"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.energy> ;
  rdf:predicate mlsys:increases ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.water-footprint> ;
  rdfs:label "increases"@en ;
  taxmeta:condition "Through on-site evaporative cooling and off-site water used in electricity generation, both of which scale with energy use."@en .

_:statement478 a rdf:Statement ;
  dct:identifier "rel.water-footprint.carbon-aware-scheduling"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.water-footprint> ;
  rdf:predicate mlsys:trades-off ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.carbon-aware-scheduling> ;
  rdfs:label "can conflict with"@en ;
  taxmeta:condition "When low-carbon hours or regions coincide with high cooling water demand, such as hot sunny afternoons."@en .

_:statement479 a rdf:Statement ;
  dct:identifier "rel.hardware-lifetime.embodied-carbon"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.hardware-lifetime> ;
  rdf:predicate mlsys:reduces ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.embodied-carbon> ;
  rdfs:label "amortizes, lowering per-unit-work"@en ;
  taxmeta:condition "When embodied emissions are attributed per year or per unit of work over the asset's service life."@en .

_:statement480 a rdf:Statement ;
  dct:identifier "rel.hardware-lifetime.energy-efficiency"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.hardware-lifetime> ;
  rdf:predicate mlsys:trades-off ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.energy-efficiency> ;
  rdfs:label "trades off against"@en ;
  taxmeta:condition "Keeping older hardware saves embodied emissions and capital but forgoes newer generations' work per joule."@en .

_:statement481 a rdf:Statement ;
  dct:identifier "rel.hardware-lifetime.e-waste"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.hardware-lifetime> ;
  rdf:predicate mlsys:reduces ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.e-waste> ;
  rdfs:label "lowers the annual rate of"@en ;
  taxmeta:condition "For a fleet of fixed size, shorter refresh cycles retire more equipment per year."@en .

_:statement482 a rdf:Statement ;
  dct:identifier "rel.tco.unit-cost"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.tco> ;
  rdf:predicate mlsys:part-of ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.unit-cost> ;
  rdfs:label "supplies the numerator of"@en ;
  taxmeta:condition "When the TCO window and the count of accepted outcomes cover the same period and system boundary."@en .

_:statement483 a rdf:Statement ;
  dct:identifier "rel.tco.hardware-lifetime"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.hardware-lifetime> ;
  rdf:predicate mlsys:determines ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.tco> ;
  rdfs:label "sets the amortization period in"@en ;
  taxmeta:condition "Capital cost enters TCO through amortization over the assumed service life."@en .

_:statement484 a rdf:Statement ;
  dct:identifier "rel.cost-per-token.unit-cost"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.cost-per-token> ;
  rdf:predicate mlsys:measures ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.unit-cost> ;
  rdfs:label "approximates"@en ;
  taxmeta:condition "Only when tokens per accepted outcome are stable; longer reasoning, retries, or context resends make cheap tokens an expensive outcome."@en .

_:statement485 a rdf:Statement ;
  dct:identifier "rel.cost-per-token.batching"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.batching> ;
  rdf:predicate mlsys:reduces ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.cost-per-token> ;
  rdfs:label "reduces"@en ;
  taxmeta:condition "When larger or continuous batches raise tokens per accelerator-second without violating latency objectives."@en .

_:statement486 a rdf:Statement ;
  dct:identifier "rel.model-routing.calibration"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.model-routing> ;
  rdf:predicate mlsys:requires ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.calibration> ;
  rdfs:label "depends on"@en ;
  taxmeta:condition "When routers or cascade gates escalate on predicted quality or confidence, which must be calibrated to the request distribution."@en .

_:statement487 a rdf:Statement ;
  dct:identifier "rel.cost-attribution.unit-cost"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.cost-attribution> ;
  rdf:predicate mlsys:enables ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.unit-cost> ;
  rdfs:label "enables"@en ;
  taxmeta:condition "When shared spend is allocated to the workloads that produce the counted outcomes by a declared allocation rule."@en .

_:statement488 a rdf:Statement ;
  dct:identifier "rel.hazard-analysis.safety-case"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.safety-case> ;
  rdf:predicate mlsys:requires ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.hazard-analysis> ;
  rdfs:label "argues only over hazards from"@en ;
  taxmeta:condition "A safety case is complete only relative to the hazards identified for its stated operating domain."@en .

_:statement489 a rdf:Statement ;
  dct:identifier "rel.stpa.hazard-analysis"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.stpa> ;
  rdf:predicate mlsys:specializes ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.hazard-analysis> ;
  rdfs:label "is a method of"@en ;
  taxmeta:condition "STPA addresses hazards from unsafe interactions and control flaws that component-failure methods can miss."@en .

_:statement490 a rdf:Statement ;
  dct:identifier "rel.fmea.hazard-analysis"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.fmea> ;
  rdf:predicate mlsys:specializes ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.hazard-analysis> ;
  rdfs:label "is a method of"@en ;
  taxmeta:condition "FMEA is bottom-up over component failures and does not by itself capture hazards without a failed component."@en .

_:statement491 a rdf:Statement ;
  dct:identifier "rel.control-barrier-function.safety-filter"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.control-barrier-function> ;
  rdf:predicate mlsys:enables ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.safety-filter> ;
  rdfs:label "provides the certificate for"@en ;
  taxmeta:condition "Guarantees depend on an accurate dynamics model, bounded disturbance, and a feasible filtering problem at each tick."@en .

_:statement492 a rdf:Statement ;
  dct:identifier "rel.safety-filter.runtime-assurance"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.safety-filter> ;
  rdf:predicate mlsys:implements ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.runtime-assurance> ;
  rdfs:label "implements"@en ;
  taxmeta:condition "The filter must run independently of, and with authority over, the component it constrains."@en .

_:statement493 a rdf:Statement ;
  dct:identifier "rel.simplex-architecture.runtime-assurance"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.simplex-architecture> ;
  rdf:predicate mlsys:implements ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.runtime-assurance> ;
  rdfs:label "implements"@en ;
  taxmeta:condition "Switching must occur while the verified controller can still recover the state."@en .

_:statement494 a rdf:Statement ;
  dct:identifier "rel.simplex-architecture.minimal-risk-condition"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.simplex-architecture> ;
  rdf:predicate mlsys:uses ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.minimal-risk-condition> ;
  rdfs:label "falls back toward"@en ;
  taxmeta:condition "Holds when the safety controller's goal is to reach a defined minimal-risk state rather than continue the mission."@en .

_:statement495 a rdf:Statement ;
  dct:identifier "rel.minimal-risk-condition.stopping-envelope"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.stopping-envelope> ;
  rdf:predicate mlsys:limits ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.minimal-risk-condition> ;
  rdfs:label "bounds reachability of"@en ;
  taxmeta:condition "A stop-type fallback is feasible only while the state remains inside its stopping envelope."@en .

_:statement496 a rdf:Statement ;
  dct:identifier "rel.guardrails.prompt-injection"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.guardrails> ;
  rdf:predicate mlsys:detects ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.prompt-injection> ;
  rdfs:label "partially detects"@en ;
  taxmeta:condition "Classifier guardrails are probabilistic and can be evaded, so they do not replace authority boundaries."@en .

_:statement497 a rdf:Statement ;
  dct:identifier "rel.guardrails.runtime-assurance"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.guardrails> ;
  rdf:predicate mlsys:specializes ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.runtime-assurance> ;
  rdfs:label "is a content-level form of"@en ;
  taxmeta:condition "Applies when the safe set is a content or action policy rather than a physical state region."@en .

_:statement498 a rdf:Statement ;
  dct:identifier "rel.falsification.scenario-based-testing"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.falsification> ;
  rdf:predicate mlsys:uses ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.scenario-based-testing> ;
  rdfs:label "searches the parameter space of"@en ;
  taxmeta:condition "Found counterexamples are only as realistic as the scenario model and simulator."@en .

_:statement499 a rdf:Statement ;
  dct:identifier "rel.rare-event-validation.safety-case"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.safety-case> ;
  rdf:predicate mlsys:uses ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.rare-event-validation> ;
  rdfs:label "draws statistical evidence from"@en ;
  taxmeta:condition "Bounds hold for the sampled operating distribution and configuration, not for unmodeled conditions."@en .

_:statement500 a rdf:Statement ;
  dct:identifier "rel.neural-network-verification.formal-verification"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.neural-network-verification> ;
  rdf:predicate mlsys:specializes ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.formal-verification> ;
  rdfs:label "specializes"@en ;
  taxmeta:condition "Exact methods scale poorly with network size; bound-propagation methods trade completeness for scale."@en .

_:statement501 a rdf:Statement ;
  dct:identifier "rel.neural-network-verification.evasion"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.neural-network-verification> ;
  rdf:predicate mlsys:measures ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.evasion> ;
  rdfs:label "certifies absence, within a bounded region, of"@en ;
  taxmeta:condition "Holds only for the specified perturbation set, typically a norm ball around given inputs."@en .

_:statement502 a rdf:Statement ;
  dct:identifier "rel.xil-testing.sim-to-real"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.xil-testing> ;
  rdf:predicate mlsys:measures ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.sim-to-real> ;
  rdfs:label "progressively tests"@en ;
  taxmeta:condition "Each rung adds real software, timing, or hardware but still relies on simulated or recorded environments."@en .

_:statement503 a rdf:Statement ;
  dct:identifier "rel.formal-verification.control-barrier-function"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.formal-verification> ;
  rdf:predicate mlsys:measures ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.control-barrier-function> ;
  rdfs:label "can certify"@en ;
  taxmeta:condition "Certification covers the barrier condition under the modeled dynamics, not the fidelity of the model."@en .

_:statement504 a rdf:Statement ;
  dct:identifier "rel.goal-structuring-notation.safety-case"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.goal-structuring-notation> ;
  rdf:predicate mlsys:implements ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.safety-case> ;
  rdfs:label "expresses"@en ;
  taxmeta:condition "Notation makes the argument structure reviewable; it does not make the argument sound."@en .

_:statement505 a rdf:Statement ;
  dct:identifier "rel.safety-performance-indicator.safety-case"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.safety-performance-indicator> ;
  rdf:predicate mlsys:measures ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.safety-case> ;
  rdfs:label "monitors validity of"@en ;
  taxmeta:condition "Each indicator must trace to a specific claim and have a threshold that triggers review."@en .

_:statement506 a rdf:Statement ;
  dct:identifier "rel.safety-performance-indicator.monitoring"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.safety-performance-indicator> ;
  rdf:predicate mlsys:requires ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.monitoring> ;
  rdfs:label "is collected through"@en ;
  taxmeta:condition "Holds when field telemetry captures the events the indicator counts."@en .

_:statement507 a rdf:Statement ;
  dct:identifier "rel.hazard-analysis.safety-integrity-level"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.hazard-analysis> ;
  rdf:predicate mlsys:determines ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.safety-integrity-level> ;
  rdfs:label "assigns"@en ;
  taxmeta:condition "Integrity levels derive from severity, exposure, and controllability of analyzed hazards."@en .

_:statement508 a rdf:Statement ;
  dct:identifier "rel.group-fairness-metric.fairness"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.group-fairness-metric> ;
  rdf:predicate mlsys:measures ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.fairness> ;
  rdfs:label "measures"@en ;
  taxmeta:condition "A metric measures one criterion on a chosen population and grouping; other criteria remain unmeasured."@en .

_:statement509 a rdf:Statement ;
  dct:identifier "rel.fairness-incompatibility.group-fairness-metric"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.fairness-incompatibility> ;
  rdf:predicate mlsys:limits ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.group-fairness-metric> ;
  rdfs:label "forces a choice among"@en ;
  taxmeta:condition "Holds when base rates differ across groups and the predictor is imperfect."@en .

_:statement510 a rdf:Statement ;
  dct:identifier "rel.individual-fairness.group-fairness-metric"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.individual-fairness> ;
  rdf:predicate mlsys:trades-off ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.group-fairness-metric> ;
  rdfs:label "can conflict with"@en ;
  taxmeta:condition "Holds when similarity under the task metric does not align with group membership."@en .

_:statement511 a rdf:Statement ;
  dct:identifier "rel.bias-mitigation.metrics"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.bias-mitigation> ;
  rdf:predicate mlsys:trades-off ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.metrics> ;
  rdfs:label "trades off against aggregate"@en ;
  taxmeta:condition "Reducing a disparity often lowers aggregate accuracy or shifts error to other groups or metrics."@en .

_:statement512 a rdf:Statement ;
  dct:identifier "rel.feature-attribution.tail-latency"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.feature-attribution> ;
  rdf:predicate mlsys:increases ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.tail-latency> ;
  rdfs:label "adds to"@en ;
  taxmeta:condition "Holds when explanations are computed on the request path; perturbation-based methods need many extra model evaluations."@en .

_:statement513 a rdf:Statement ;
  dct:identifier "rel.counterfactual-explanation.contestability"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.counterfactual-explanation> ;
  rdf:predicate mlsys:enables ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.contestability> ;
  rdfs:label "supports"@en ;
  taxmeta:condition "Useful for recourse only when the suggested changes are feasible and actionable for the person."@en .

_:statement514 a rdf:Statement ;
  dct:identifier "rel.interpretable-model.feature-attribution"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.interpretable-model> ;
  rdf:predicate mlsys:alternative-to ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.feature-attribution> ;
  rdfs:label "removes the need for post-hoc"@en ;
  taxmeta:condition "Holds in high-stakes settings where an interpretable model reaches comparable accuracy."@en .

_:statement515 a rdf:Statement ;
