<https://mlsysbook.ai/taxonomy/group/foundations> a skos:Collection ;
  skos:prefLabel "Foundations"@en ;
  skos:notation "F" ;
  skos:member <https://mlsysbook.ai/taxonomy/area/workloads-requirements>, <https://mlsysbook.ai/taxonomy/area/models-architectures>, <https://mlsysbook.ai/taxonomy/area/system-models> .

<https://mlsysbook.ai/taxonomy/area/workloads-requirements> a skos:Collection ;
  skos:prefLabel "Workloads & requirements"@en ;
  skos:notation "F1" ;
  skos:scopeNote "Targets, workload descriptions, and objectives that every later engineering choice is judged against."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/requirements-slos>, <https://mlsysbook.ai/taxonomy/subject/workload-characterization>, <https://mlsysbook.ai/taxonomy/subject/objectives-decisions> .

<https://mlsysbook.ai/taxonomy/subject/requirements-slos> a skos:Collection ;
  skos:prefLabel "Requirements, SLOs & baselines"@en ;
  skos:notation "F1.1" ;
  skos:scopeNote "Includes: Acceptance criteria and baselines; SLIs, SLOs, error budgets; Latency budgets across a request path Excludes: Measured latency behavior and goodput ([[latency-goodput]]); Statistical evaluation of model quality ([[evaluation]])"@en ;
  skos:definition "Stating measurable targets for a system's behavior and service, and the baselines and budgets against which they are judged."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.requirements>, <https://mlsysbook.ai/taxonomy/concept/mlsys.baseline>, <https://mlsysbook.ai/taxonomy/concept/mlsys.slo>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sli>, <https://mlsysbook.ai/taxonomy/concept/mlsys.error-budget>, <https://mlsysbook.ai/taxonomy/concept/mlsys.latency-budget>, <https://mlsysbook.ai/taxonomy/concept/mlsys.recovery-objectives>, <https://mlsysbook.ai/taxonomy/concept/mlsys.service-level-agreement> .

<https://mlsysbook.ai/taxonomy/subject/workload-characterization> a skos:Collection ;
  skos:prefLabel "Workload characterization"@en ;
  skos:notation "F1.2" ;
  skos:scopeNote "Includes: FLOP, byte, and memory accounting; Deployment tiers from cloud to TinyML; Workload traces Excludes: Node-level job placement ([[cluster-scheduling]]); Measured profiles ([[profiling-utilization]])"@en ;
  skos:definition "Describing a workload's compute, memory, data, and traffic demands, and where it runs, so it can be engineered and provisioned for."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.workload>, <https://mlsysbook.ai/taxonomy/concept/mlsys.placement>, <https://mlsysbook.ai/taxonomy/concept/mlsys.flop-accounting>, <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-footprint>, <https://mlsysbook.ai/taxonomy/concept/mlsys.workload-trace>, <https://mlsysbook.ai/taxonomy/concept/mlsys.inference-compute-estimate> .

<https://mlsysbook.ai/taxonomy/subject/objectives-decisions> a skos:Collection ;
  skos:prefLabel "Objectives, proxies & decision policies"@en ;
  skos:notation "F1.3" ;
  skos:scopeNote "Includes: Proxy objectives and reward hacking; Cost-sensitive thresholds; Multi-objective tradeoffs Excludes: Fairness criteria ([[responsible-ai]]); Optimizer and loss mechanics ([[training]])"@en ;
  skos:definition "How learned outputs become decisions, how optimized proxies relate to intended outcomes, and how competing objectives are traded."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.proxy-objective>, <https://mlsysbook.ai/taxonomy/concept/mlsys.decision-policy>, <https://mlsysbook.ai/taxonomy/concept/mlsys.cost-sensitive-decision>, <https://mlsysbook.ai/taxonomy/concept/mlsys.pareto-frontier> .

<https://mlsysbook.ai/taxonomy/area/models-architectures> a skos:Collection ;
  skos:prefLabel "Models & architectures"@en ;
  skos:notation "F2" ;
  skos:scopeNote "Model families, building blocks, and architectural choices viewed as workloads, plus the artifacts that carry them."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/model-families>, <https://mlsysbook.ai/taxonomy/subject/architecture-blocks>, <https://mlsysbook.ai/taxonomy/subject/conditional-computation>, <https://mlsysbook.ai/taxonomy/subject/efficient-sequence-models>, <https://mlsysbook.ai/taxonomy/subject/model-artifacts> .

<https://mlsysbook.ai/taxonomy/subject/model-families> a skos:Collection ;
  skos:prefLabel "Model families"@en ;
  skos:notation "F2.1" ;
  skos:scopeNote "Includes: Classical models and neural networks; Transformers, recommendation models, diffusion models Excludes: Learning paradigms ([[training]]); Layer-level building blocks ([[architecture-blocks]])"@en ;
  skos:definition "The classical and neural model regimes, with their inductive assumptions, viewed as workloads with characteristic compute and memory profiles."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.linear-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.tree-ensemble>, <https://mlsysbook.ai/taxonomy/concept/mlsys.kernel-method>, <https://mlsysbook.ai/taxonomy/concept/mlsys.nearest-neighbor>, <https://mlsysbook.ai/taxonomy/concept/mlsys.neural-network>, <https://mlsysbook.ai/taxonomy/concept/mlsys.inductive-bias>, <https://mlsysbook.ai/taxonomy/concept/mlsys.transformer>, <https://mlsysbook.ai/taxonomy/concept/mlsys.recommendation-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.diffusion-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.multimodal-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.gan>, <https://mlsysbook.ai/taxonomy/concept/mlsys.graph-neural-network>, <https://mlsysbook.ai/taxonomy/concept/mlsys.large-language-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.transformer-variants> .

<https://mlsysbook.ai/taxonomy/subject/architecture-blocks> a skos:Collection ;
  skos:prefLabel "Architecture building blocks"@en ;
  skos:notation "F2.2" ;
  skos:scopeNote "Includes: Embeddings, attention, position encoding, tokenization; Convolution, recurrence, normalization Excludes: Kernel implementations of these operations ([[tensor-operators]]); Efficient attention variants ([[efficient-sequence-models]])"@en ;
  skos:definition "The layer-level operations from which neural models are composed and whose shapes determine compute, memory, and data movement."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.embeddings>, <https://mlsysbook.ai/taxonomy/concept/mlsys.attention>, <https://mlsysbook.ai/taxonomy/concept/mlsys.position-encoding>, <https://mlsysbook.ai/taxonomy/concept/mlsys.tokenization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.convolution>, <https://mlsysbook.ai/taxonomy/concept/mlsys.recurrence>, <https://mlsysbook.ai/taxonomy/concept/mlsys.normalization-layer>, <https://mlsysbook.ai/taxonomy/concept/mlsys.depthwise-separable-convolution>, <https://mlsysbook.ai/taxonomy/concept/mlsys.modality-encoder>, <https://mlsysbook.ai/taxonomy/concept/mlsys.residual-connection>, <https://mlsysbook.ai/taxonomy/concept/mlsys.feed-forward-block>, <https://mlsysbook.ai/taxonomy/concept/mlsys.activation-function> .

<https://mlsysbook.ai/taxonomy/subject/conditional-computation> a skos:Collection ;
  skos:prefLabel "Sparse & conditional computation"@en ;
  skos:notation "F2.3" ;
  skos:scopeNote "Includes: Mixture of experts, routing, capacity, load balancing; Active vs. total parameters; Early exit Excludes: Weight pruning and static sparsity ([[model-compression]]); Cascades across separate models ([[serving-architecture]])"@en ;
  skos:definition "Model designs in which the computation performed varies per input, such as mixture-of-experts routing and early exit."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.mixture-of-experts>, <https://mlsysbook.ai/taxonomy/concept/mlsys.expert-routing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.expert-capacity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.load-balancing-loss>, <https://mlsysbook.ai/taxonomy/concept/mlsys.active-parameters>, <https://mlsysbook.ai/taxonomy/concept/mlsys.early-exit> .

<https://mlsysbook.ai/taxonomy/subject/efficient-sequence-models> a skos:Collection ;
  skos:prefLabel "Long-context & efficient sequence models"@en ;
  skos:notation "F2.4" ;
  skos:scopeNote "Includes: Sparse, sliding-window, and linear attention; State-space models; grouped-query attention; Context-length extension Excludes: Exact attention kernels such as FlashAttention ([[tensor-operators]]); KV-cache management ([[llm-inference]])"@en ;
  skos:definition "Sequence architectures that change how cost scales with context length, co-designed with the memory and compute they demand."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.sliding-window-attention>, <https://mlsysbook.ai/taxonomy/concept/mlsys.linear-attention>, <https://mlsysbook.ai/taxonomy/concept/mlsys.state-space-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.grouped-query-attention>, <https://mlsysbook.ai/taxonomy/concept/mlsys.context-extension>, <https://mlsysbook.ai/taxonomy/concept/mlsys.context>, <https://mlsysbook.ai/taxonomy/concept/mlsys.context-degradation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.dynamic-sparse-attention>, <https://mlsysbook.ai/taxonomy/concept/mlsys.multi-head-latent-attention> .

<https://mlsysbook.ai/taxonomy/subject/model-artifacts> a skos:Collection ;
  skos:prefLabel "Model artifacts & formats"@en ;
  skos:notation "F2.5" ;
  skos:scopeNote "Includes: Weight serialization and exchange formats; Model export and signatures Excludes: Versioning and registries ([[release-management]]); Training checkpoints for recovery ([[reliability]])"@en ;
  skos:definition "The weights, graphs, metadata, and interface contracts that make a trained model a portable, loadable, deployable artifact."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.model-artifact>, <https://mlsysbook.ai/taxonomy/concept/mlsys.weight-serialization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-exchange-format>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-export>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-signature>, <https://mlsysbook.ai/taxonomy/concept/mlsys.chat-template> .

<https://mlsysbook.ai/taxonomy/area/system-models> a skos:Collection ;
  skos:prefLabel "Quantitative system models"@en ;
  skos:notation "F3" ;
  skos:scopeNote "Analytical and empirical models used to bound performance, capacity, and training cost before or instead of measuring."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/roofline-locality>, <https://mlsysbook.ai/taxonomy/subject/speedup-limits>, <https://mlsysbook.ai/taxonomy/subject/queueing-models>, <https://mlsysbook.ai/taxonomy/subject/scaling-laws> .

<https://mlsysbook.ai/taxonomy/subject/roofline-locality> a skos:Collection ;
  skos:prefLabel "Roofline, performance models & simulation"@en ;
  skos:notation "F3.1" ;
  skos:scopeNote "Includes: Ridge point and compute- vs. memory-bound regimes; Energy cost of data movement Excludes: Measured profiles and MFU ([[profiling-utilization]]); Hardware memory organization ([[memory-systems]])"@en ;
  skos:definition "Bound-based reasoning about whether computation is limited by arithmetic or data movement, and how reuse changes that limit."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.arithmetic-intensity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.roofline>, <https://mlsysbook.ai/taxonomy/concept/mlsys.locality>, <https://mlsysbook.ai/taxonomy/concept/mlsys.ridge-point>, <https://mlsysbook.ai/taxonomy/concept/mlsys.bound-regime>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-movement-energy>, <https://mlsysbook.ai/taxonomy/concept/mlsys.analytical-performance-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.performance-simulation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-fidelity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.execution-trace>, <https://mlsysbook.ai/taxonomy/concept/mlsys.communication-intensity> .

<https://mlsysbook.ai/taxonomy/subject/speedup-limits> a skos:Collection ;
  skos:prefLabel "Amdahl's law & scaling efficiency"@en ;
  skos:notation "F3.2" ;
  skos:scopeNote "Includes: Amdahl's law and serial fractions; Strong and weak scaling; Parallel efficiency Excludes: Communication cost models ([[collectives]])"@en ;
  skos:definition "Models of how much speedup added parallel or accelerated resources can deliver, given serial work and fixed or growing problem sizes."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.serial-fraction>, <https://mlsysbook.ai/taxonomy/concept/mlsys.amdahls-law>, <https://mlsysbook.ai/taxonomy/concept/mlsys.strong-scaling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.weak-scaling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.parallel-efficiency> .

<https://mlsysbook.ai/taxonomy/subject/queueing-models> a skos:Collection ;
  skos:prefLabel "Queueing & capacity models"@en ;
  skos:notation "F3.3" ;
  skos:scopeNote "Includes: Little's law; Latency-throughput curves; Burstiness and variability Excludes: Batching and admission mechanisms ([[request-scheduling]]); Measuring a specific serving system's latency and throughput ([[latency-goodput]])"@en ;
  skos:definition "Models relating arrivals, service rates, utilization, and waiting, used to predict latency and capacity under load."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.arrival-rate>, <https://mlsysbook.ai/taxonomy/concept/mlsys.service-capacity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.queueing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.littles-law>, <https://mlsysbook.ai/taxonomy/concept/mlsys.latency-throughput-curve>, <https://mlsysbook.ai/taxonomy/concept/mlsys.arrival-burstiness>, <https://mlsysbook.ai/taxonomy/concept/mlsys.finite-buffer>, <https://mlsysbook.ai/taxonomy/concept/mlsys.bandwidth-delay-product>, <https://mlsysbook.ai/taxonomy/concept/mlsys.head-of-line-blocking>, <https://mlsysbook.ai/taxonomy/concept/mlsys.open-closed-loop-load> .

<https://mlsysbook.ai/taxonomy/subject/scaling-laws> a skos:Collection ;
  skos:prefLabel "Scaling laws & compute-optimal allocation"@en ;
  skos:notation "F3.4" ;
  skos:scopeNote "Includes: Loss scaling laws; Compute-optimal model/data allocation; Training compute estimates Excludes: Hyperparameter search ([[experiment-management]]); Test-time compute scaling ([[test-time-compute]])"@en ;
  skos:definition "Empirical relationships among parameters, data, and compute and observed quality, used to allocate training budgets."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.scaling-laws>, <https://mlsysbook.ai/taxonomy/concept/mlsys.compute-optimal-allocation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.training-compute-estimate> .

<https://mlsysbook.ai/taxonomy/group/stack> a skos:Collection ;
  skos:prefLabel "Stack"@en ;
  skos:notation "S" ;
  skos:member <https://mlsysbook.ai/taxonomy/area/hardware>, <https://mlsysbook.ai/taxonomy/area/software-stack>, <https://mlsysbook.ai/taxonomy/area/distributed>, <https://mlsysbook.ai/taxonomy/area/infrastructure-fleet> .

<https://mlsysbook.ai/taxonomy/area/hardware> a skos:Collection ;
  skos:prefLabel "Hardware & accelerators"@en ;
  skos:notation "S1" ;
  skos:scopeNote "Compute, memory, interconnect, and power characteristics of ML hardware from datacenter accelerators to microcontrollers."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/accelerator-architecture>, <https://mlsysbook.ai/taxonomy/subject/memory-systems>, <https://mlsysbook.ai/taxonomy/subject/node-interconnect>, <https://mlsysbook.ai/taxonomy/subject/chip-power-thermal>, <https://mlsysbook.ai/taxonomy/subject/edge-embedded-hardware> .

<https://mlsysbook.ai/taxonomy/subject/accelerator-architecture> a skos:Collection ;
  skos:prefLabel "Accelerator architecture"@en ;
  skos:notation "S1.1" ;
  skos:scopeNote "Includes: GPUs, TPUs, NPUs; SIMT and matrix engines; Systolic arrays and dataflows; Domain-specific architectures Excludes: On-device and embedded accelerators ([[edge-embedded-hardware]]); Compiler mapping onto hardware ([[ml-compilers]])"@en ;
  skos:definition "The organization of processors specialized for ML: execution units, threading, dataflow, and the throughput they provide."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.accelerator-execution-architecture>, <https://mlsysbook.ai/taxonomy/concept/mlsys.compute-throughput>, <https://mlsysbook.ai/taxonomy/concept/mlsys.systolic-array>, <https://mlsysbook.ai/taxonomy/concept/mlsys.matrix-unit>, <https://mlsysbook.ai/taxonomy/concept/mlsys.simt>, <https://mlsysbook.ai/taxonomy/concept/mlsys.dataflow>, <https://mlsysbook.ai/taxonomy/concept/mlsys.domain-specific-architecture>, <https://mlsysbook.ai/taxonomy/concept/mlsys.compute-in-memory>, <https://mlsysbook.ai/taxonomy/concept/mlsys.cpu-execution-architecture>, <https://mlsysbook.ai/taxonomy/concept/mlsys.advanced-accelerator-packaging>, <https://mlsysbook.ai/taxonomy/concept/mlsys.fpga-acceleration>, <https://mlsysbook.ai/taxonomy/concept/mlsys.wafer-scale-acceleration> .

<https://mlsysbook.ai/taxonomy/subject/memory-systems> a skos:Collection ;
  skos:prefLabel "Memory hierarchy & bandwidth"@en ;
  skos:notation "S1.2" ;
  skos:scopeNote "Includes: On-chip SRAM and scratchpads; HBM; The memory wall Excludes: Persistent and distributed storage ([[storage-systems]]); Software memory allocation ([[runtime-dispatch]])"@en ;
  skos:definition "The storage levels of an ML processor, from registers and SRAM to HBM, and the capacity and bandwidth limits they impose."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-hierarchy>, <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-capacity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-bandwidth>, <https://mlsysbook.ai/taxonomy/concept/mlsys.hbm>, <https://mlsysbook.ai/taxonomy/concept/mlsys.on-chip-sram>, <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-wall>, <https://mlsysbook.ai/taxonomy/concept/mlsys.emerging-nvm>, <https://mlsysbook.ai/taxonomy/concept/mlsys.host-memory> .

<https://mlsysbook.ai/taxonomy/subject/node-interconnect> a skos:Collection ;
  skos:prefLabel "Host-device & scale-up interconnect"@en ;
  skos:notation "S1.3" ;
  skos:scopeNote "Includes: PCIe host links; NVLink-class scale-up fabrics; CXL and peer-to-peer transfers Excludes: Datacenter scale-out networks ([[network-fabrics]])"@en ;
  skos:definition "Links that move data between hosts and accelerators and among accelerators within a node or rack-scale domain."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.host-device-interconnect>, <https://mlsysbook.ai/taxonomy/concept/mlsys.scale-up-interconnect>, <https://mlsysbook.ai/taxonomy/concept/mlsys.coherent-interconnect>, <https://mlsysbook.ai/taxonomy/concept/mlsys.peer-to-peer-transfer> .

<https://mlsysbook.ai/taxonomy/subject/chip-power-thermal> a skos:Collection ;
  skos:prefLabel "Chip power & thermal limits"@en ;
  skos:notation "S1.4" ;
  skos:scopeNote "Includes: TDP and thermal throttling; DVFS and power capping; Dark silicon Excludes: Facility power and cooling ([[datacenter-facilities]]); Carbon accounting ([[sustainability-cost]])"@en ;
  skos:definition "Electrical and thermal limits at the chip and board level, and the runtime controls that keep execution within them."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.power-delivery>, <https://mlsysbook.ai/taxonomy/concept/mlsys.thermal-dynamics>, <https://mlsysbook.ai/taxonomy/concept/mlsys.tdp>, <https://mlsysbook.ai/taxonomy/concept/mlsys.dvfs>, <https://mlsysbook.ai/taxonomy/concept/mlsys.dark-silicon>, <https://mlsysbook.ai/taxonomy/concept/mlsys.power-capping>, <https://mlsysbook.ai/taxonomy/concept/mlsys.duty-cycling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.technology-scaling> .

<https://mlsysbook.ai/taxonomy/subject/edge-embedded-hardware> a skos:Collection ;
  skos:prefLabel "Edge & embedded hardware"@en ;
  skos:notation "S1.5" ;
  skos:scopeNote "Includes: Microcontrollers and TinyML devices; Heterogeneous mobile SoCs and NPUs; Energy and memory budgets Excludes: On-device runtimes and OTA updates ([[on-device-deployment]]); Robot-specific real-time platforms ([[real-time-systems]])"@en ;
  skos:definition "Hardware for on-device ML, from mobile SoCs to microcontrollers, where memory and energy per inference bind."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.microcontroller>, <https://mlsysbook.ai/taxonomy/concept/mlsys.heterogeneous-soc>, <https://mlsysbook.ai/taxonomy/concept/mlsys.edge-npu>, <https://mlsysbook.ai/taxonomy/concept/mlsys.on-device-memory-budget>, <https://mlsysbook.ai/taxonomy/concept/mlsys.intermittent-computing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sensor-interconnect>, <https://mlsysbook.ai/taxonomy/concept/mlsys.execute-in-place>, <https://mlsysbook.ai/taxonomy/concept/mlsys.always-on-cascade>, <https://mlsysbook.ai/taxonomy/concept/mlsys.dma-cache-maintenance> .

<https://mlsysbook.ai/taxonomy/area/software-stack> a skos:Collection ;
  skos:prefLabel "Frameworks, compilers & runtimes"@en ;
  skos:notation "S2" ;
  skos:scopeNote "The software layers between model code and hardware: programming models, operators, compilers, runtimes, and numerics."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/programming-models>, <https://mlsysbook.ai/taxonomy/subject/tensor-operators>, <https://mlsysbook.ai/taxonomy/subject/gpu-programming>, <https://mlsysbook.ai/taxonomy/subject/ml-compilers>, <https://mlsysbook.ai/taxonomy/subject/runtime-dispatch>, <https://mlsysbook.ai/taxonomy/subject/data-loading>, <https://mlsysbook.ai/taxonomy/subject/numerics> .

<https://mlsysbook.ai/taxonomy/subject/programming-models> a skos:Collection ;
  skos:prefLabel "ML frameworks & programming models"@en ;
  skos:notation "S2.1" ;
  skos:scopeNote "Includes: Tensors and computation graphs; Eager vs. graph execution; tracing JIT; Automatic differentiation Excludes: Compiler optimization passes ([[ml-compilers]]); Framework product catalogs"@en ;
  skos:definition "The abstractions with which ML programs are written: tensors, computation graphs, execution modes, and automatic differentiation."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.autodiff>, <https://mlsysbook.ai/taxonomy/concept/mlsys.tensor>, <https://mlsysbook.ai/taxonomy/concept/mlsys.computation-graph>, <https://mlsysbook.ai/taxonomy/concept/mlsys.eager-execution>, <https://mlsysbook.ai/taxonomy/concept/mlsys.tracing-jit>, <https://mlsysbook.ai/taxonomy/concept/mlsys.function-transformations>, <https://mlsysbook.ai/taxonomy/concept/mlsys.task-actor-runtime>, <https://mlsysbook.ai/taxonomy/concept/mlsys.single-vs-multi-controller>, <https://mlsysbook.ai/taxonomy/concept/mlsys.embedded-dsl>, <https://mlsysbook.ai/taxonomy/concept/mlsys.differentiable-programming>, <https://mlsysbook.ai/taxonomy/concept/mlsys.llm-training-framework>, <https://mlsysbook.ai/taxonomy/concept/mlsys.python-gil> .

<https://mlsysbook.ai/taxonomy/subject/tensor-operators> a skos:Collection ;
  skos:prefLabel "Tensor operators & memory layout"@en ;
  skos:notation "S2.2" ;
  skos:scopeNote "Includes: GEMM and convolution lowering; IO-aware attention kernels; Vendor kernel libraries Excludes: Compiler-generated kernels and autotuning ([[ml-compilers]]); Architectural changes to attention ([[efficient-sequence-models]])"@en ;
  skos:definition "Implementations of core tensor operations, such as matrix multiply, convolution, and attention, and the layouts that govern their efficiency."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.tensor-layout>, <https://mlsysbook.ai/taxonomy/concept/mlsys.matrix-multiply>, <https://mlsysbook.ai/taxonomy/concept/mlsys.io-aware-attention>, <https://mlsysbook.ai/taxonomy/concept/mlsys.convolution-lowering>, <https://mlsysbook.ai/taxonomy/concept/mlsys.kernel-library>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sparse-tensor-kernels>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sparse-ragged-tensors> .

<https://mlsysbook.ai/taxonomy/subject/gpu-programming> a skos:Collection ;
  skos:prefLabel "Kernel & GPU programming model"@en ;
  skos:notation "S2.3" ;
  skos:scopeNote "Includes: Writing and tuning kernels in CUDA-class or tile-level languages such as Triton; Shared memory, synchronization, and latency hiding Excludes: Choosing kernels for operators ([[tensor-operators]]); Automatic kernel generation and fusion ([[ml-compilers]])"@en ;
  skos:definition "How kernels are written for parallel accelerators: the thread hierarchy, memory access patterns, occupancy, asynchronous data movement, and programming the matrix units."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.thread-hierarchy>, <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-coalescing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.occupancy>, <https://mlsysbook.ai/taxonomy/concept/mlsys.async-data-movement>, <https://mlsysbook.ai/taxonomy/concept/mlsys.matrix-engine-programming>, <https://mlsysbook.ai/taxonomy/concept/mlsys.register-pressure>, <https://mlsysbook.ai/taxonomy/concept/mlsys.kernel-synchronization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.shared-memory-bank-conflict> .

<https://mlsysbook.ai/taxonomy/subject/ml-compilers> a skos:Collection ;
  skos:prefLabel "ML compilers & kernel optimization"@en ;
  skos:notation "S2.4" ;
  skos:scopeNote "Includes: Graph and loop IRs; lowering; Fusion, tiling, autotuning, kernel DSLs; Static memory planning Excludes: Quantization as a compression technique ([[model-compression]])"@en ;
  skos:definition "Transforming model programs through intermediate representations into optimized kernels for target hardware."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.compilation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.fusion>, <https://mlsysbook.ai/taxonomy/concept/mlsys.tiling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.intermediate-representation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.autotuning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.kernel-dsl>, <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-planning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.persistent-kernel>, <https://mlsysbook.ai/taxonomy/concept/mlsys.graph-superoptimization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.dynamic-shapes>, <https://mlsysbook.ai/taxonomy/concept/mlsys.rule-based-graph-rewriting>, <https://mlsysbook.ai/taxonomy/concept/mlsys.software-pipelining>, <https://mlsysbook.ai/taxonomy/concept/mlsys.schedule-separation> .

<https://mlsysbook.ai/taxonomy/subject/runtime-dispatch> a skos:Collection ;
  skos:prefLabel "Runtime execution & dispatch"@en ;
  skos:notation "S2.5" ;
  skos:scopeNote "Includes: Launch overhead and graph replay; Streams and asynchronous execution; Caching allocators Excludes: Request-level serving schedulers ([[request-scheduling]])"@en ;
  skos:definition "How a runtime launches and orders device work and manages device memory during execution."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.dispatch>, <https://mlsysbook.ai/taxonomy/concept/mlsys.device-streams>, <https://mlsysbook.ai/taxonomy/concept/mlsys.caching-allocator>, <https://mlsysbook.ai/taxonomy/concept/mlsys.graph-replay>, <https://mlsysbook.ai/taxonomy/concept/mlsys.cpu-threading-numa>, <https://mlsysbook.ai/taxonomy/concept/mlsys.execution-providers>, <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-fragmentation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.mmap-weights>, <https://mlsysbook.ai/taxonomy/concept/mlsys.os-memory-pressure>, <https://mlsysbook.ai/taxonomy/concept/mlsys.managed-runtime-interop> .

<https://mlsysbook.ai/taxonomy/subject/data-loading> a skos:Collection ;
  skos:prefLabel "Data loading & input pipelines"@en ;
  skos:notation "S2.6" ;
  skos:scopeNote "Includes: Data-loader workers, decoding and augmentation on the host, pinned memory, and prefetching; Minibatch construction for irregular data, such as graph neighborhood sampling Excludes: Building datasets and transformation pipelines ([[data-pipelines]]); Storage systems and parallel file systems that hold the data ([[storage-systems]])"@en ;
  skos:definition "Delivering training and inference inputs to accelerators fast enough: host-side loading and preprocessing, prefetching, and sampling minibatches from large or irregular data such as graphs."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.input-pipeline>, <https://mlsysbook.ai/taxonomy/concept/mlsys.input-prefetching>, <https://mlsysbook.ai/taxonomy/concept/mlsys.neighbor-sampling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.host-data-loader>, <https://mlsysbook.ai/taxonomy/concept/mlsys.zero-copy-dma>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sequence-packing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.dataset-shuffling> .

<https://mlsysbook.ai/taxonomy/subject/numerics> a skos:Collection ;
  skos:prefLabel "Numerical formats & precision"@en ;
  skos:notation "S2.7" ;
  skos:scopeNote "Includes: FP32/BF16/FP8/INT formats and block scaling; Mixed precision and loss scaling; Accumulation precision Excludes: Post-training quantization as compression ([[model-compression]])"@en ;
  skos:definition "Number formats used in ML computation and the techniques that keep training and inference accurate at reduced precision."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.precision>, <https://mlsysbook.ai/taxonomy/concept/mlsys.mixed-precision>, <https://mlsysbook.ai/taxonomy/concept/mlsys.numerical-stability>, <https://mlsysbook.ai/taxonomy/concept/mlsys.loss-scaling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.block-scaled-format>, <https://mlsysbook.ai/taxonomy/concept/mlsys.accumulation-precision>, <https://mlsysbook.ai/taxonomy/concept/mlsys.numerical-nondeterminism>, <https://mlsysbook.ai/taxonomy/concept/mlsys.batch-invariance> .

<https://mlsysbook.ai/taxonomy/area/distributed> a skos:Collection ;
  skos:prefLabel "Parallelism & distributed execution"@en ;
  skos:notation "S3" ;
  skos:scopeNote "Partitioning ML work across devices and participants, the communication it requires, and the coordination that keeps it consistent."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/parallelism>, <https://mlsysbook.ai/taxonomy/subject/parallelism-planning>, <https://mlsysbook.ai/taxonomy/subject/collectives>, <https://mlsysbook.ai/taxonomy/subject/coordination>, <https://mlsysbook.ai/taxonomy/subject/federated-learning> .

<https://mlsysbook.ai/taxonomy/subject/parallelism> a skos:Collection ;
  skos:prefLabel "Parallelism strategies"@en ;
  skos:notation "S3.1" ;
  skos:scopeNote "Includes: Data, tensor, pipeline, sequence, expert parallelism; ZeRO/FSDP state sharding; Hybrid 3D layouts and pipeline bubbles Excludes: Collective algorithms ([[collectives]]); Job placement on the cluster ([[cluster-scheduling]]); Searching for and placing a parallel plan ([[parallelism-planning]])"@en ;
  skos:definition "Ways of partitioning a model's computation and state across devices, and how those dimensions are combined."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.data-parallel>, <https://mlsysbook.ai/taxonomy/concept/mlsys.tensor-parallel>, <https://mlsysbook.ai/taxonomy/concept/mlsys.pipeline-parallel>, <https://mlsysbook.ai/taxonomy/concept/mlsys.state-sharding>, <https://mlsysbook.ai/taxonomy/concept/mlsys.expert-parallel>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sequence-parallel>, <https://mlsysbook.ai/taxonomy/concept/mlsys.hybrid-parallel>, <https://mlsysbook.ai/taxonomy/concept/mlsys.pipeline-bubble>, <https://mlsysbook.ai/taxonomy/concept/mlsys.embedding-table-sharding>, <https://mlsysbook.ai/taxonomy/concept/mlsys.parameter-server>, <https://mlsysbook.ai/taxonomy/concept/mlsys.local-sgd>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sync-async-training>, <https://mlsysbook.ai/taxonomy/concept/mlsys.gnn-graph-partitioning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.pipeline-schedule>, <https://mlsysbook.ai/taxonomy/concept/mlsys.graph-pipeline-parallelism> .

<https://mlsysbook.ai/taxonomy/subject/parallelism-planning> a skos:Collection ;
  skos:prefLabel "Parallelization planning & placement"@en ;
  skos:notation "S3.2" ;
  skos:scopeNote "Includes: Automatic parallelization and sharding propagation; Device meshes, expert placement, and dynamic resharding Excludes: The parallelism strategies themselves ([[parallelism]])"@en ;
  skos:definition "Choosing and changing how a model is partitioned across devices: describing devices as a mesh, searching or propagating sharding decisions, placing experts and stages on heterogeneous hardware, and resharding at run time."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.auto-parallelization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sharding-propagation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.device-mesh>, <https://mlsysbook.ai/taxonomy/concept/mlsys.heterogeneous-accelerator-execution>, <https://mlsysbook.ai/taxonomy/concept/mlsys.dynamic-resharding>, <https://mlsysbook.ai/taxonomy/concept/mlsys.expert-placement>, <https://mlsysbook.ai/taxonomy/concept/mlsys.variable-length-parallelism>, <https://mlsysbook.ai/taxonomy/concept/mlsys.geo-distributed-training> .

<https://mlsysbook.ai/taxonomy/subject/collectives> a skos:Collection ;
  skos:prefLabel "Collective communication"@en ;
  skos:notation "S3.3" ;
  skos:scopeNote "Includes: All-reduce, all-gather, all-to-all; Ring and tree algorithms; alpha-beta cost model; Overlap and gradient compression Excludes: Physical fabric design ([[network-fabrics]])"@en ;
  skos:definition "Group communication primitives and algorithms used by parallel ML, their cost models, and techniques to reduce or hide their cost."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.collectives>, <https://mlsysbook.ai/taxonomy/concept/mlsys.communication-overlap>, <https://mlsysbook.ai/taxonomy/concept/mlsys.stragglers>, <https://mlsysbook.ai/taxonomy/concept/mlsys.ring-allreduce>, <https://mlsysbook.ai/taxonomy/concept/mlsys.tree-allreduce>, <https://mlsysbook.ai/taxonomy/concept/mlsys.all-to-all>, <https://mlsysbook.ai/taxonomy/concept/mlsys.alpha-beta-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.gradient-compression>, <https://mlsysbook.ai/taxonomy/concept/mlsys.process-group-rendezvous>, <https://mlsysbook.ai/taxonomy/concept/mlsys.device-initiated-communication>, <https://mlsysbook.ai/taxonomy/concept/mlsys.collective-algorithm-selection>, <https://mlsysbook.ai/taxonomy/concept/mlsys.all-reduce>, <https://mlsysbook.ai/taxonomy/concept/mlsys.reduce-scatter-all-gather> .

<https://mlsysbook.ai/taxonomy/subject/coordination> a skos:Collection ;
  skos:prefLabel "Coordination & consensus"@en ;
  skos:notation "S3.4" ;
  skos:scopeNote "Includes: Consensus and leader election; Leases and fencing; Bounded-staleness consistency Excludes: Checkpoint and recovery protocols ([[reliability]]); Retry and compensation semantics ([[failure-semantics]])"@en ;
  skos:definition "Mechanisms by which distributed components agree on authoritative control state and tolerate stale or failed participants."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.consensus>, <https://mlsysbook.ai/taxonomy/concept/mlsys.fencing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.lease>, <https://mlsysbook.ai/taxonomy/concept/mlsys.leader-election>, <https://mlsysbook.ai/taxonomy/concept/mlsys.bounded-staleness>, <https://mlsysbook.ai/taxonomy/concept/mlsys.cap-tradeoff> .

<https://mlsysbook.ai/taxonomy/subject/federated-learning> a skos:Collection ;
  skos:prefLabel "Federated & decentralized learning"@en ;
  skos:notation "S3.5" ;
  skos:scopeNote "Includes: Federated averaging; Client heterogeneity and selection; Cross-device vs. cross-silo Excludes: Secure aggregation and differential privacy ([[security-privacy]])"@en ;
  skos:definition "Training across devices or organizations that keep their data local, coordinated through a shared model."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.federated-learning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.federated-averaging>, <https://mlsysbook.ai/taxonomy/concept/mlsys.non-iid-data>, <https://mlsysbook.ai/taxonomy/concept/mlsys.client-sampling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.federation-setting>, <https://mlsysbook.ai/taxonomy/concept/mlsys.gossip-averaging> .

<https://mlsysbook.ai/taxonomy/area/infrastructure-fleet> a skos:Collection ;
  skos:prefLabel "Datacenter infrastructure & fleet"@en ;
  skos:notation "S4" ;
  skos:scopeNote "Facilities, networks, storage, and cluster management that turn many accelerators into a shared ML fleet."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/datacenter-facilities>, <https://mlsysbook.ai/taxonomy/subject/network-fabrics>, <https://mlsysbook.ai/taxonomy/subject/storage-systems>, <https://mlsysbook.ai/taxonomy/subject/cluster-scheduling>, <https://mlsysbook.ai/taxonomy/subject/capacity-provisioning> .

<https://mlsysbook.ai/taxonomy/subject/datacenter-facilities> a skos:Collection ;
  skos:prefLabel "Datacenter power, cooling & facilities"@en ;
  skos:notation "S4.1" ;
  skos:scopeNote "Includes: Facility power and oversubscription; Air and liquid cooling; rack density; PUE Excludes: Carbon and water accounting ([[sustainability-cost]]); Chip-level power limits ([[chip-power-thermal]])"@en ;
  skos:definition "Engineering of the buildings that house ML fleets: power provisioning, cooling, density, and facility efficiency."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.pue>, <https://mlsysbook.ai/taxonomy/concept/mlsys.liquid-cooling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.rack-power-density>, <https://mlsysbook.ai/taxonomy/concept/mlsys.power-oversubscription>, <https://mlsysbook.ai/taxonomy/concept/mlsys.warehouse-scale-computer>, <https://mlsysbook.ai/taxonomy/concept/mlsys.training-power-swings>, <https://mlsysbook.ai/taxonomy/concept/mlsys.facility-energy-storage>, <https://mlsysbook.ai/taxonomy/concept/mlsys.grid-interconnection>, <https://mlsysbook.ai/taxonomy/concept/mlsys.on-site-generation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.demand-response> .

<https://mlsysbook.ai/taxonomy/subject/network-fabrics> a skos:Collection ;
  skos:prefLabel "Network fabrics"@en ;
  skos:notation "S4.2" ;
  skos:scopeNote "Includes: RDMA over InfiniBand and RoCE; lossless flow control; Fat-tree, rail-optimized, torus topologies; Congestion control; in-network reduction Excludes: Intra-node links ([[node-interconnect]]); Collective algorithms ([[collectives]])"@en ;
  skos:definition "Datacenter networks that connect accelerator nodes: transports, topologies, flow and congestion control, and in-network compute."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.network-topology>, <https://mlsysbook.ai/taxonomy/concept/mlsys.rdma>, <https://mlsysbook.ai/taxonomy/concept/mlsys.lossless-fabric>, <https://mlsysbook.ai/taxonomy/concept/mlsys.congestion-control>, <https://mlsysbook.ai/taxonomy/concept/mlsys.fat-tree>, <https://mlsysbook.ai/taxonomy/concept/mlsys.rail-optimized>, <https://mlsysbook.ai/taxonomy/concept/mlsys.bisection-bandwidth>, <https://mlsysbook.ai/taxonomy/concept/mlsys.in-network-reduction>, <https://mlsysbook.ai/taxonomy/concept/mlsys.adaptive-routing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.incast>, <https://mlsysbook.ai/taxonomy/concept/mlsys.network-propagation-delay>, <https://mlsysbook.ai/taxonomy/concept/mlsys.optical-circuit-switching>, <https://mlsysbook.ai/taxonomy/concept/mlsys.co-packaged-optics>, <https://mlsysbook.ai/taxonomy/concept/mlsys.forward-error-correction>, <https://mlsysbook.ai/taxonomy/concept/mlsys.traffic-classes>, <https://mlsysbook.ai/taxonomy/concept/mlsys.torus-topology>, <https://mlsysbook.ai/taxonomy/concept/mlsys.network-oversubscription>, <https://mlsysbook.ai/taxonomy/concept/mlsys.link-reach>, <https://mlsysbook.ai/taxonomy/concept/mlsys.link-signal-integrity> .

<https://mlsysbook.ai/taxonomy/subject/storage-systems> a skos:Collection ;
  skos:prefLabel "Storage & data delivery"@en ;
  skos:notation "S4.3" ;
  skos:scopeNote "Includes: Parallel file systems and object stores; Input pipelines and data stalls; Checkpoint I/O and storage tiering Excludes: Dataset formats and schema ([[data-pipelines]]); Checkpoint frequency and recovery semantics ([[reliability]]); Host-side loading and prefetching of batches ([[data-loading]])"@en ;
  skos:definition "Storage systems that hold training data, checkpoints, and artifacts at scale and deliver them to accelerators fast enough."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.parallel-file-system>, <https://mlsysbook.ai/taxonomy/concept/mlsys.object-storage>, <https://mlsysbook.ai/taxonomy/concept/mlsys.checkpoint-io>, <https://mlsysbook.ai/taxonomy/concept/mlsys.storage-tiering>, <https://mlsysbook.ai/taxonomy/concept/mlsys.embedding-cache>, <https://mlsysbook.ai/taxonomy/concept/mlsys.erasure-coding>, <https://mlsysbook.ai/taxonomy/concept/mlsys.storage-access-pattern> .

<https://mlsysbook.ai/taxonomy/subject/cluster-scheduling> a skos:Collection ;
  skos:prefLabel "Cluster scheduling & orchestration"@en ;
  skos:notation "S4.4" ;
  skos:scopeNote "Includes: Gang scheduling and backfill; Fair sharing, preemption, elastic jobs; Topology-aware placement and bin packing Excludes: Request-level serving autoscaling ([[request-scheduling]]); Workflow DAG orchestration ([[pipelines-reproducibility]]); Packaging code and dependencies as images ([[pipelines-reproducibility]])"@en ;
  skos:definition "Allocating a shared cluster's accelerators to jobs over time: placement, gang allocation, fairness, preemption, and elasticity."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.gang-scheduling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.job-preemption>, <https://mlsysbook.ai/taxonomy/concept/mlsys.dominant-resource-fairness>, <https://mlsysbook.ai/taxonomy/concept/mlsys.elastic-training>, <https://mlsysbook.ai/taxonomy/concept/mlsys.topology-aware-placement>, <https://mlsysbook.ai/taxonomy/concept/mlsys.bin-packing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.ml-aware-scheduling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.cluster-manager>, <https://mlsysbook.ai/taxonomy/concept/mlsys.backfill-scheduling> .

<https://mlsysbook.ai/taxonomy/subject/capacity-provisioning> a skos:Collection ;
  skos:prefLabel "Capacity planning & multi-tenancy"@en ;
  skos:notation "S4.5" ;
  skos:scopeNote "Includes: Capacity planning and quotas; Accelerator sharing and partitioning; Spot capacity and interference Excludes: Security isolation guarantees ([[access-isolation]]); Unit-cost economics ([[sustainability-cost]])"@en ;
  skos:definition "Provisioning fleet capacity and sharing it among tenants through quotas, accelerator sharing, and interference control."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.capacity-planning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.multi-tenancy>, <https://mlsysbook.ai/taxonomy/concept/mlsys.resource-quota>, <https://mlsysbook.ai/taxonomy/concept/mlsys.gpu-partitioning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.spot-capacity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.performance-interference>, <https://mlsysbook.ai/taxonomy/concept/mlsys.cloud-service-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.fine-grained-accelerator-sharing> .

<https://mlsysbook.ai/taxonomy/group/lifecycle> a skos:Collection ;
  skos:prefLabel "Lifecycle"@en ;
  skos:notation "P" ;
  skos:member <https://mlsysbook.ai/taxonomy/area/data>, <https://mlsysbook.ai/taxonomy/area/training>, <https://mlsysbook.ai/taxonomy/area/evaluation>, <https://mlsysbook.ai/taxonomy/area/serving>, <https://mlsysbook.ai/taxonomy/area/operations> .

<https://mlsysbook.ai/taxonomy/area/data> a skos:Collection ;
  skos:prefLabel "Data engineering"@en ;
  skos:notation "P1" ;
  skos:scopeNote "Acquisition and labeling, corpus curation, validation and features, pipelines and storage formats, lineage, and temporal correctness of training and serving data."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/data-collection>, <https://mlsysbook.ai/taxonomy/subject/data-curation>, <https://mlsysbook.ai/taxonomy/subject/data-quality>, <https://mlsysbook.ai/taxonomy/subject/data-pipelines>, <https://mlsysbook.ai/taxonomy/subject/data-lineage>, <https://mlsysbook.ai/taxonomy/subject/data-leakage-skew> .

<https://mlsysbook.ai/taxonomy/subject/data-collection> a skos:Collection ;
  skos:prefLabel "Data collection & labeling"@en ;
  skos:notation "P1.1" ;
  skos:scopeNote "Includes: Sampling design, human and programmatic labeling, labeling budgets.; Annotation quality and agreement. Excludes: Sensor design and calibration ([[perception-sensing]]); Corpus filtering and mixtures ([[data-curation]])"@en ;
  skos:definition "Obtaining observations and supervisory targets whose sampling, coverage, and label quality are known and fit the task."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.data-acquisition>, <https://mlsysbook.ai/taxonomy/concept/mlsys.labels>, <https://mlsysbook.ai/taxonomy/concept/mlsys.weak-supervision>, <https://mlsysbook.ai/taxonomy/concept/mlsys.active-learning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.annotator-agreement>, <https://mlsysbook.ai/taxonomy/concept/mlsys.class-imbalance>, <https://mlsysbook.ai/taxonomy/concept/mlsys.rebalancing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-assisted-labeling> .

<https://mlsysbook.ai/taxonomy/subject/data-curation> a skos:Collection ;
  skos:prefLabel "Data selection & curation"@en ;
  skos:notation "P1.2" ;
  skos:scopeNote "Includes: Web-scale corpus filtering, deduplication, and domain mixtures.; Augmentation and synthetic or model-generated data.; Trajectory and demonstration curation for agents and robots. Excludes: Labeling processes ([[data-collection]]); Teacher-student compression ([[model-compression]])"@en ;
  skos:definition "Choosing, filtering, deduplicating, mixing, augmenting, and synthesizing training examples to maximize learning value per unit of compute and labeling cost."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.data-selection>, <https://mlsysbook.ai/taxonomy/concept/mlsys.deduplication>, <https://mlsysbook.ai/taxonomy/concept/mlsys.quality-filtering>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-mixture>, <https://mlsysbook.ai/taxonomy/concept/mlsys.synthetic-data>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-augmentation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-valuation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-collapse>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-curriculum> .

<https://mlsysbook.ai/taxonomy/subject/data-quality> a skos:Collection ;
  skos:prefLabel "Data validation & feature engineering"@en ;
  skos:notation "P1.3" ;
  skos:scopeNote "Includes: Schema and distribution checks before training and serving.; Feature construction and shared feature stores. Excludes: Learned representations inside the model ([[models-architectures]]); Production drift monitoring ([[monitoring]])"@en ;
  skos:definition "Checking that recorded data is fit for use and transforming it into model inputs whose semantics and availability match training and serving."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.data-quality>, <https://mlsysbook.ai/taxonomy/concept/mlsys.features>, <https://mlsysbook.ai/taxonomy/concept/mlsys.missing-data>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-validation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.feature-store>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-cleaning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.feature-hashing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.feature-cross>, <https://mlsysbook.ai/taxonomy/concept/mlsys.exploratory-data-analysis>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-cascade> .

<https://mlsysbook.ai/taxonomy/subject/data-pipelines> a skos:Collection ;
  skos:prefLabel "Data pipelines & storage formats"@en ;
  skos:notation "P1.4" ;
  skos:scopeNote "Includes: ETL/ELT, batch and stream processing, columnar formats.; Data loaders that keep accelerators fed. Excludes: Tensor layout in working memory ([[tensor-operators]]); Delivering batches to accelerators ([[data-loading]])"@en ;
  skos:definition "Engineering ingestion, batch and stream transformation, event-time semantics, storage formats, and schemas for training and serving data."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.dataset-storage-layout>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-ingestion>, <https://mlsysbook.ai/taxonomy/concept/mlsys.schema-evolution>, <https://mlsysbook.ai/taxonomy/concept/mlsys.stream-processing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.feature-backfill>, <https://mlsysbook.ai/taxonomy/concept/mlsys.batch-data-processing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.lakehouse>, <https://mlsysbook.ai/taxonomy/concept/mlsys.event-time-windowing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.delivery-semantics>, <https://mlsysbook.ai/taxonomy/concept/mlsys.streaming-dataset-format> .

<https://mlsysbook.ai/taxonomy/subject/data-lineage> a skos:Collection ;
  skos:prefLabel "Data contracts, versioning & lineage"@en ;
  skos:notation "P1.5" ;
  skos:scopeNote "Includes: Dataset versions, snapshots, and provenance records.; Producer-consumer contracts and dependency hygiene. Excludes: Model and code artifact versioning ([[release-management]]); Dataset documentation such as datasheets ([[transparency-explainability]])"@en ;
  skos:definition "Specifying, versioning, and tracing the datasets a system consumes so that dependencies, provenance, and changes are explicit."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.lineage>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-contract>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-versioning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-dependency>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-governance>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-consent>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-model-licensing> .

<https://mlsysbook.ai/taxonomy/subject/data-leakage-skew> a skos:Collection ;
  skos:prefLabel "Leakage & training-serving skew"@en ;
  skos:notation "P1.6" ;
  skos:scopeNote "Includes: Point-in-time joins and temporal leakage.; Feature staleness and skew between offline and online paths. Excludes: Deployment distribution change ([[drift-retraining]])"@en ;
  skos:definition "Ensuring examples use only information available at prediction time and that training and serving compute features identically and equally fresh."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.leakage>, <https://mlsysbook.ai/taxonomy/concept/mlsys.point-in-time>, <https://mlsysbook.ai/taxonomy/concept/mlsys.train-serve-skew>, <https://mlsysbook.ai/taxonomy/concept/mlsys.feature-freshness>, <https://mlsysbook.ai/taxonomy/concept/mlsys.online-feature-consistency> .

<https://mlsysbook.ai/taxonomy/area/training> a skos:Collection ;
  skos:prefLabel "Training & adaptation"@en ;
  skos:notation "P2" ;
  skos:scopeNote "Learning paradigms, optimization dynamics, training memory, experiment management, fine-tuning, post-training, and continual learning."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/learning-paradigms>, <https://mlsysbook.ai/taxonomy/subject/training-optimization>, <https://mlsysbook.ai/taxonomy/subject/training-memory>, <https://mlsysbook.ai/taxonomy/subject/experiment-management>, <https://mlsysbook.ai/taxonomy/subject/fine-tuning>, <https://mlsysbook.ai/taxonomy/subject/post-training>, <https://mlsysbook.ai/taxonomy/subject/continual-learning> .

<https://mlsysbook.ai/taxonomy/subject/learning-paradigms> a skos:Collection ;
  skos:prefLabel "Learning paradigms"@en ;
  skos:notation "P2.1" ;
  skos:scopeNote "Includes: Supervised, self-supervised, unsupervised, reinforcement, and imitation learning. Excludes: Preference and RL post-training of pretrained models ([[post-training]])"@en ;
  skos:definition "The ways supervision, self-generated targets, interaction, and demonstration produce learning signals, each with distinct data and compute demands."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.supervised-learning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.self-supervised-learning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.unsupervised-learning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.reinforcement-learning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.imitation-learning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.pretraining>, <https://mlsysbook.ai/taxonomy/concept/mlsys.causal-lm>, <https://mlsysbook.ai/taxonomy/concept/mlsys.compounding-error>, <https://mlsysbook.ai/taxonomy/concept/mlsys.interactive-imitation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.offline-rl>, <https://mlsysbook.ai/taxonomy/concept/mlsys.multi-task-learning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.semi-supervised-learning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.contrastive-learning> .

<https://mlsysbook.ai/taxonomy/subject/training-optimization> a skos:Collection ;
  skos:prefLabel "Optimization & training dynamics"@en ;
  skos:notation "P2.2" ;
  skos:scopeNote "Includes: Optimizers, learning-rate warmup and decay, large-batch scaling.; Loss spikes, divergence, and their mitigations. Excludes: Floating-point formats and overflow ([[numerics]])"@en ;
  skos:definition "The objectives, update rules, schedules, and batch regimes that determine whether and how efficiently training converges."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.loss>, <https://mlsysbook.ai/taxonomy/concept/mlsys.optimizer>, <https://mlsysbook.ai/taxonomy/concept/mlsys.regularization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.batch-size>, <https://mlsysbook.ai/taxonomy/concept/mlsys.learning-rate-schedule>, <https://mlsysbook.ai/taxonomy/concept/mlsys.critical-batch-size>, <https://mlsysbook.ai/taxonomy/concept/mlsys.training-instability>, <https://mlsysbook.ai/taxonomy/concept/mlsys.mode-collapse>, <https://mlsysbook.ai/taxonomy/concept/mlsys.gradient-clipping>, <https://mlsysbook.ai/taxonomy/concept/mlsys.weight-initialization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.overfitting>, <https://mlsysbook.ai/taxonomy/concept/mlsys.early-stopping>, <https://mlsysbook.ai/taxonomy/concept/mlsys.group-dro> .

<https://mlsysbook.ai/taxonomy/subject/training-memory> a skos:Collection ;
  skos:prefLabel "Training memory & state"@en ;
  skos:notation "P2.3" ;
  skos:scopeNote "Includes: Activation recomputation, gradient accumulation, CPU/NVMe offload. Excludes: Sharding state across devices ([[parallelism]]); Persisting state for recovery ([[checkpoint-recovery]])"@en ;
  skos:definition "Accounting for and reducing the parameters, gradients, optimizer state, and activations a training step must hold."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.training-state>, <https://mlsysbook.ai/taxonomy/concept/mlsys.activation-recompute>, <https://mlsysbook.ai/taxonomy/concept/mlsys.gradient-accumulation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-offloading>, <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-efficient-optimizer>, <https://mlsysbook.ai/taxonomy/concept/mlsys.training-memory-estimate> .

<https://mlsysbook.ai/taxonomy/subject/experiment-management> a skos:Collection ;
  skos:prefLabel "Hyperparameter search & experiment management"@en ;
  skos:notation "P2.4" ;
  skos:scopeNote "Includes: Random, Bayesian, and multi-fidelity search; small-scale proxies.; Run metadata and experiment tracking. Excludes: Pipeline orchestration ([[pipelines-reproducibility]])"@en ;
  skos:definition "Allocating a finite budget of training runs across configurations, and recording runs so their outcomes can be compared and reproduced."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.hyperparameter-search>, <https://mlsysbook.ai/taxonomy/concept/mlsys.experiment-budget>, <https://mlsysbook.ai/taxonomy/concept/mlsys.experiment-tracking>, <https://mlsysbook.ai/taxonomy/concept/mlsys.hyperparameter-transfer>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-selection> .

<https://mlsysbook.ai/taxonomy/subject/fine-tuning> a skos:Collection ;
  skos:prefLabel "Adaptation: fine-tuning, prompting & transfer"@en ;
  skos:notation "P2.5" ;
  skos:scopeNote "Includes: Instruction and supervised fine-tuning, adapters, LoRA, and model merging.; Prompt engineering and in-context learning without parameter updates. Excludes: Preference or reward-driven training ([[post-training]]); Assembling context for agents ([[context-memory]])"@en ;
  skos:definition "Adapting a pretrained model to a new task or behavior, by continued training of all or part of its parameters or by prompting without parameter updates."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.transfer-learning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.peft>, <https://mlsysbook.ai/taxonomy/concept/mlsys.supervised-fine-tuning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.lora>, <https://mlsysbook.ai/taxonomy/concept/mlsys.prompt-engineering>, <https://mlsysbook.ai/taxonomy/concept/mlsys.loss-masking>, <https://mlsysbook.ai/taxonomy/concept/mlsys.in-context-learning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-merging> .

<https://mlsysbook.ai/taxonomy/subject/post-training> a skos:Collection ;
  skos:prefLabel "Preference & RL post-training"@en ;
  skos:notation "P2.6" ;
  skos:scopeNote "Includes: RLHF, DPO-style preference optimization, RL with verifiable rewards.; Rollout generation, reward scoring, colocated vs disaggregated actor/learner, weight sync. Excludes: General RL theory ([[learning-paradigms]]); Reward exploitation as a specification failure ([[objectives-decisions]])"@en ;
  skos:definition "Training pretrained models against preference, reward-model, or verifiable-reward signals, and the rollout, scoring, and weight-synchronization systems that loop requires."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.rlhf>, <https://mlsysbook.ai/taxonomy/concept/mlsys.reward-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.preference-optimization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.rlvr>, <https://mlsysbook.ai/taxonomy/concept/mlsys.rl-rollout>, <https://mlsysbook.ai/taxonomy/concept/mlsys.weight-sync>, <https://mlsysbook.ai/taxonomy/concept/mlsys.policy-staleness>, <https://mlsysbook.ai/taxonomy/concept/mlsys.credit-assignment>, <https://mlsysbook.ai/taxonomy/concept/mlsys.reward-hacking>, <https://mlsysbook.ai/taxonomy/concept/mlsys.group-relative-policy-optimization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.agent-training-environment>, <https://mlsysbook.ai/taxonomy/concept/mlsys.rejection-sampling-fine-tuning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.rl-training-colocation> .

<https://mlsysbook.ai/taxonomy/subject/continual-learning> a skos:Collection ;
  skos:prefLabel "Continual & online learning"@en ;
  skos:notation "P2.7" ;
  skos:scopeNote "Includes: Online and incremental updates, forgetting and replay.; Personalization and adaptation on device. Excludes: Deciding when to retrain ([[drift-retraining]]); Federated aggregation protocols ([[federated-learning]])"@en ;
  skos:definition "Updating deployed models incrementally from new or streaming data while retaining prior competence."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.online-learning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.incremental-training>, <https://mlsysbook.ai/taxonomy/concept/mlsys.catastrophic-forgetting>, <https://mlsysbook.ai/taxonomy/concept/mlsys.experience-replay>, <https://mlsysbook.ai/taxonomy/concept/mlsys.on-device-training> .

<https://mlsysbook.ai/taxonomy/area/evaluation> a skos:Collection ;
  skos:prefLabel "Model evaluation & testing"@en ;
  skos:notation "P3" ;
  skos:scopeNote "Evaluation design, metrics and uncertainty, slices and robustness, evaluation of generative and agentic outputs, and ML testing and debugging."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/evaluation-protocols>, <https://mlsysbook.ai/taxonomy/subject/metrics-uncertainty>, <https://mlsysbook.ai/taxonomy/subject/robustness-slices>, <https://mlsysbook.ai/taxonomy/subject/generative-agent-eval>, <https://mlsysbook.ai/taxonomy/subject/ml-testing> .

<https://mlsysbook.ai/taxonomy/subject/evaluation-protocols> a skos:Collection ;
  skos:prefLabel "Evaluation design & experiments"@en ;
  skos:notation "P3.1" ;
  skos:scopeNote "Includes: Holdout, temporal, and cross-validation splits.; A/B tests, sequential monitoring, interference between units. Excludes: Release staging mechanics ([[release-management]])"@en ;
  skos:definition "Constructing offline splits and online experiments whose comparisons support the conclusions drawn from them."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.evaluation-split>, <https://mlsysbook.ai/taxonomy/concept/mlsys.selection-bias>, <https://mlsysbook.ai/taxonomy/concept/mlsys.online-experiment>, <https://mlsysbook.ai/taxonomy/concept/mlsys.cross-validation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sequential-testing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.experiment-interference>, <https://mlsysbook.ai/taxonomy/concept/mlsys.evaluation-harness>, <https://mlsysbook.ai/taxonomy/concept/mlsys.closed-loop-evaluation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.paired-comparison>, <https://mlsysbook.ai/taxonomy/concept/mlsys.off-policy-evaluation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.multiple-comparisons>, <https://mlsysbook.ai/taxonomy/concept/mlsys.statistical-power> .

<https://mlsysbook.ai/taxonomy/subject/metrics-uncertainty> a skos:Collection ;
  skos:prefLabel "Metrics, calibration & uncertainty"@en ;
  skos:notation "P3.2" ;
  skos:scopeNote "Includes: Task metrics, calibration, confidence intervals, abstention.; Distribution-free prediction sets. Excludes: Choosing what to optimize ([[objectives-decisions]])"@en ;
  skos:definition "Specifying what is measured and quantifying how far estimates and predicted probabilities can be trusted."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.generalization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.metrics>, <https://mlsysbook.ai/taxonomy/concept/mlsys.calibration>, <https://mlsysbook.ai/taxonomy/concept/mlsys.statistical-uncertainty>, <https://mlsysbook.ai/taxonomy/concept/mlsys.selective-prediction>, <https://mlsysbook.ai/taxonomy/concept/mlsys.conformal-prediction>, <https://mlsysbook.ai/taxonomy/concept/mlsys.ood-detection>, <https://mlsysbook.ai/taxonomy/concept/mlsys.predictive-uncertainty>, <https://mlsysbook.ai/taxonomy/concept/mlsys.retrieval-metrics>, <https://mlsysbook.ai/taxonomy/concept/mlsys.precision-recall> .

<https://mlsysbook.ai/taxonomy/subject/robustness-slices> a skos:Collection ;
  skos:prefLabel "Sliced & robustness evaluation"@en ;
  skos:notation "P3.3" ;
  skos:scopeNote "Includes: Subgroup and condition slices, shift and perturbation tests. Excludes: Fairness criteria themselves ([[fairness-bias]]); Adversarial attack mechanics ([[security-privacy]])"@en ;
  skos:definition "Measuring behavior separately across populations and conditions, and under deliberate shift or perturbation, rather than only in aggregate."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.sliced-evaluation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.robustness-evaluation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.slice-discovery> .

<https://mlsysbook.ai/taxonomy/subject/generative-agent-eval> a skos:Collection ;
  skos:prefLabel "Evaluating generative & agentic systems"@en ;
  skos:notation "P3.4" ;
  skos:scopeNote "Includes: Model graders, pairwise and human preference, pass@k.; Contamination of benchmarks by training data. Excludes: Verifiers used to select outputs at inference ([[test-time-compute]])"@en ;
  skos:definition "Assessing open-ended outputs and multi-step runs where no single reference answer exists, using graders, sampling-aware metrics, and contamination controls."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.hallucination>, <https://mlsysbook.ai/taxonomy/concept/mlsys.agent-evaluation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.llm-judge>, <https://mlsysbook.ai/taxonomy/concept/mlsys.pass-at-k>, <https://mlsysbook.ai/taxonomy/concept/mlsys.pairwise-preference-eval>, <https://mlsysbook.ai/taxonomy/concept/mlsys.human-evaluation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.benchmark-contamination>, <https://mlsysbook.ai/taxonomy/concept/mlsys.dangerous-capability-eval>, <https://mlsysbook.ai/taxonomy/concept/mlsys.perplexity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.reference-match-scoring>, <https://mlsysbook.ai/taxonomy/concept/mlsys.judge-bias>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sycophancy-evaluation> .

<https://mlsysbook.ai/taxonomy/subject/ml-testing> a skos:Collection ;
  skos:prefLabel "ML testing & debugging"@en ;
  skos:notation "P3.5" ;
  skos:scopeNote "Includes: Oracles, metamorphic and behavioral tests, readiness rubrics.; Integration testing, training diagnostics, and error analysis. Excludes: Fault injection into infrastructure ([[fault-injection]])"@en ;
  skos:definition "Testing data, models, pipelines, and their integration against stated expectations when exact expected outputs are often unknown."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.test-oracle>, <https://mlsysbook.ai/taxonomy/concept/mlsys.integration-testing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.metamorphic-testing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.behavioral-testing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.production-readiness>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-visualization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.error-analysis>, <https://mlsysbook.ai/taxonomy/concept/mlsys.training-diagnostics> .

<https://mlsysbook.ai/taxonomy/area/serving> a skos:Collection ;
  skos:prefLabel "Deployment & serving"@en ;
  skos:notation "P4" ;
  skos:scopeNote "Serving architectures, latency and goodput, request scheduling, LLM inference mechanisms, structured generation, test-time compute, retrieval, and on-device deployment."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/serving-architecture>, <https://mlsysbook.ai/taxonomy/subject/compound-ai>, <https://mlsysbook.ai/taxonomy/subject/latency-goodput>, <https://mlsysbook.ai/taxonomy/subject/request-scheduling>, <https://mlsysbook.ai/taxonomy/subject/llm-inference>, <https://mlsysbook.ai/taxonomy/subject/structured-generation>, <https://mlsysbook.ai/taxonomy/subject/test-time-compute>, <https://mlsysbook.ai/taxonomy/subject/retrieval-rag>, <https://mlsysbook.ai/taxonomy/subject/on-device-deployment> .

<https://mlsysbook.ai/taxonomy/subject/serving-architecture> a skos:Collection ;
  skos:prefLabel "Serving architectures"@en ;
  skos:notation "P4.1" ;
  skos:scopeNote "Includes: Batch vs online prediction, inference servers, serverless endpoints, and APIs.; Multi-model and multi-adapter hosting, ranking funnels, and streaming/voice pipelines. Excludes: Replica load balancing ([[request-scheduling]]); Routing and composing calls across models ([[compound-ai]]); Second-stage reranking inside retrieval ([[retrieval-rag]])"@en ;
  skos:definition "The structure through which predictions are produced and delivered, from offline batch scoring to online and serverless model servers, multi-model and multi-adapter hosting, and streaming speech services."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.online-inference>, <https://mlsysbook.ai/taxonomy/concept/mlsys.batch-inference>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-server>, <https://mlsysbook.ai/taxonomy/concept/mlsys.multi-model-serving>, <https://mlsysbook.ai/taxonomy/concept/mlsys.ranking-funnel>, <https://mlsysbook.ai/taxonomy/concept/mlsys.multi-adapter-serving>, <https://mlsysbook.ai/taxonomy/concept/mlsys.keyed-predictions>, <https://mlsysbook.ai/taxonomy/concept/mlsys.stateless-serving-function>, <https://mlsysbook.ai/taxonomy/concept/mlsys.serverless-inference>, <https://mlsysbook.ai/taxonomy/concept/mlsys.streaming-asr>, <https://mlsysbook.ai/taxonomy/concept/mlsys.voice-pipeline>, <https://mlsysbook.ai/taxonomy/concept/mlsys.streaming-inference>, <https://mlsysbook.ai/taxonomy/concept/mlsys.inference-api>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-swapping> .

<https://mlsysbook.ai/taxonomy/subject/compound-ai> a skos:Collection ;
  skos:prefLabel "Compound AI systems & model routing"@en ;
  skos:notation "P4.2" ;
  skos:scopeNote "Includes: Language-model programs and their optimization; Model routing, cascades, gateways, and semantic caches Excludes: Single-model serving infrastructure ([[serving-architecture]]); Agent loops that plan and act through tools ([[agent-harness]])"@en ;
  skos:definition "Composing several models, retrievers, and tools into one application, and routing, cascading, caching, and gating requests across models to meet quality and cost targets."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.compound-ai-system>, <https://mlsysbook.ai/taxonomy/concept/mlsys.lm-program-optimization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-routing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-gateway>, <https://mlsysbook.ai/taxonomy/concept/mlsys.semantic-cache>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-cascade>, <https://mlsysbook.ai/taxonomy/concept/mlsys.compound-workflow-pipelining> .

<https://mlsysbook.ai/taxonomy/subject/latency-goodput> a skos:Collection ;
  skos:prefLabel "Latency, throughput & goodput"@en ;
  skos:notation "P4.3" ;
  skos:scopeNote "Includes: Latency budgets, tail latency, TTFT and inter-token latency.; Tail-tolerant request techniques. Excludes: Analytic queueing models ([[queueing-models]]); General measurement methodology and profiling ([[profiling-utilization]]); analytic queueing models ([[queueing-models]])"@en ;
  skos:definition "Defining and meeting per-request latency and useful-throughput targets, including tail behavior and token-level latency for generative services."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.tail-latency>, <https://mlsysbook.ai/taxonomy/concept/mlsys.slo-goodput>, <https://mlsysbook.ai/taxonomy/concept/mlsys.ttft>, <https://mlsysbook.ai/taxonomy/concept/mlsys.tpot>, <https://mlsysbook.ai/taxonomy/concept/mlsys.hedged-requests>, <https://mlsysbook.ai/taxonomy/concept/mlsys.request-throughput>, <https://mlsysbook.ai/taxonomy/concept/mlsys.latency-percentiles>, <https://mlsysbook.ai/taxonomy/concept/mlsys.inter-token-latency>, <https://mlsysbook.ai/taxonomy/concept/mlsys.fan-out-tail-amplification> .

<https://mlsysbook.ai/taxonomy/subject/request-scheduling> a skos:Collection ;
  skos:prefLabel "Batching, admission & autoscaling"@en ;
  skos:notation "P4.4" ;
  skos:scopeNote "Includes: Dynamic and iteration-level batching, admission, load balancing.; Autoscaling and model cold start. Excludes: Cluster-level job scheduling ([[cluster-scheduling]])"@en ;
  skos:definition "Policies that group, admit, distribute, and provision for requests so a service meets its targets under varying load."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.batching>, <https://mlsysbook.ai/taxonomy/concept/mlsys.admission>, <https://mlsysbook.ai/taxonomy/concept/mlsys.autoscaling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.backpressure>, <https://mlsysbook.ai/taxonomy/concept/mlsys.continuous-batching>, <https://mlsysbook.ai/taxonomy/concept/mlsys.load-balancing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.cold-start>, <https://mlsysbook.ai/taxonomy/concept/mlsys.llm-request-scheduling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.cache-aware-routing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.fidelity-adaptive-serving> .

<https://mlsysbook.ai/taxonomy/subject/llm-inference> a skos:Collection ;
  skos:prefLabel "LLM & generative inference"@en ;
  skos:notation "P4.5" ;
  skos:scopeNote "Includes: KV cache management, prefix reuse, speculative decoding.; Chunked prefill and prefill/decode disaggregation.; Denoising-step reduction and feature caching for diffusion models. Excludes: Weight quantization ([[model-compression]]); Context selection and compaction ([[context-memory]])"@en ;
  skos:definition "Mechanisms specific to generative inference: managing attention state, separating prompt processing from token generation, accelerating autoregressive decoding, and reducing iterative denoising cost."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.kv-cache>, <https://mlsysbook.ai/taxonomy/concept/mlsys.prefill-decode>, <https://mlsysbook.ai/taxonomy/concept/mlsys.paged-kv>, <https://mlsysbook.ai/taxonomy/concept/mlsys.prefix-cache>, <https://mlsysbook.ai/taxonomy/concept/mlsys.speculative-decoding>, <https://mlsysbook.ai/taxonomy/concept/mlsys.chunked-prefill>, <https://mlsysbook.ai/taxonomy/concept/mlsys.pd-disaggregation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.encoder-disaggregation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.kv-cache-offload>, <https://mlsysbook.ai/taxonomy/concept/mlsys.kv-cache-transfer>, <https://mlsysbook.ai/taxonomy/concept/mlsys.kv-cache-eviction>, <https://mlsysbook.ai/taxonomy/concept/mlsys.cpu-gpu-hybrid-inference>, <https://mlsysbook.ai/taxonomy/concept/mlsys.non-prefix-kv-reuse>, <https://mlsysbook.ai/taxonomy/concept/mlsys.token-streaming>, <https://mlsysbook.ai/taxonomy/concept/mlsys.denoising-step-reduction>, <https://mlsysbook.ai/taxonomy/concept/mlsys.diffusion-feature-caching>, <https://mlsysbook.ai/taxonomy/concept/mlsys.masked-diffusion-decoding>, <https://mlsysbook.ai/taxonomy/concept/mlsys.expert-offloading>, <https://mlsysbook.ai/taxonomy/concept/mlsys.intra-device-overlap>, <https://mlsysbook.ai/taxonomy/concept/mlsys.kv-memory-allocation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.attention-ffn-disaggregation> .

<https://mlsysbook.ai/taxonomy/subject/structured-generation> a skos:Collection ;
  skos:prefLabel "Decoding, sampling & structured output"@en ;
  skos:notation "P4.6" ;
  skos:scopeNote "Includes: Temperature and nucleus sampling, grammar-constrained decoding, schema checks. Excludes: Tool authority and effects ([[tool-interfaces]])"@en ;
  skos:definition "Controlling how tokens are selected and constraining generated output to required syntax or schemas."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.grammar>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sampling-controls>, <https://mlsysbook.ai/taxonomy/concept/mlsys.constrained-decoding>, <https://mlsysbook.ai/taxonomy/concept/mlsys.output-validation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.generation-stopping> .

<https://mlsysbook.ai/taxonomy/subject/test-time-compute> a skos:Collection ;
  skos:prefLabel "Test-time compute"@en ;
  skos:notation "P4.7" ;
  skos:scopeNote "Includes: Reasoning budgets, parallel sampling and selection, verifiers, tree search.; Trading inference compute against model size. Excludes: Agent control loops and tool use ([[agent-harness]]); Pass@k as an evaluation metric ([[generative-agent-eval]])"@en ;
  skos:definition "Spending additional inference computation on reasoning, sampling, search, and verification to raise output quality under a budget."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.reasoning-budget>, <https://mlsysbook.ai/taxonomy/concept/mlsys.best-of-n>, <https://mlsysbook.ai/taxonomy/concept/mlsys.self-consistency>, <https://mlsysbook.ai/taxonomy/concept/mlsys.verifier>, <https://mlsysbook.ai/taxonomy/concept/mlsys.process-reward-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.inference-time-search>, <https://mlsysbook.ai/taxonomy/concept/mlsys.test-time-scaling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sequential-revision> .

<https://mlsysbook.ai/taxonomy/subject/retrieval-rag> a skos:Collection ;
  skos:prefLabel "Retrieval & vector search"@en ;
  skos:notation "P4.8" ;
  skos:scopeNote "Includes: Retrieval-augmented generation, ANN indexes and vector stores, reranking. Excludes: Agent memory write and consolidation policy ([[context-memory]])"@en ;
  skos:definition "Selecting relevant records from an external corpus by lexical, dense, or hybrid search and supplying them to a model at inference."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.retrieval>, <https://mlsysbook.ai/taxonomy/concept/mlsys.ann>, <https://mlsysbook.ai/taxonomy/concept/mlsys.rag>, <https://mlsysbook.ai/taxonomy/concept/mlsys.dense-retrieval>, <https://mlsysbook.ai/taxonomy/concept/mlsys.lexical-retrieval>, <https://mlsysbook.ai/taxonomy/concept/mlsys.reranking>, <https://mlsysbook.ai/taxonomy/concept/mlsys.graph-vector-index>, <https://mlsysbook.ai/taxonomy/concept/mlsys.quantized-vector-index>, <https://mlsysbook.ai/taxonomy/concept/mlsys.filtered-vector-search>, <https://mlsysbook.ai/taxonomy/concept/mlsys.index-freshness>, <https://mlsysbook.ai/taxonomy/concept/mlsys.multi-hop-retrieval>, <https://mlsysbook.ai/taxonomy/concept/mlsys.document-chunking>, <https://mlsysbook.ai/taxonomy/concept/mlsys.hybrid-retrieval>, <https://mlsysbook.ai/taxonomy/concept/mlsys.embedding-migration>, <https://mlsysbook.ai/taxonomy/concept/mlsys.rag-pipeline-scheduling> .

<https://mlsysbook.ai/taxonomy/subject/on-device-deployment> a skos:Collection ;
  skos:prefLabel "On-device & edge deployment"@en ;
  skos:notation "P4.9" ;
  skos:scopeNote "Includes: Export and conversion, on-device runtimes, device/cloud split.; Over-the-air model updates across heterogeneous fleets. Excludes: Edge silicon ([[edge-embedded-hardware]]); Compression techniques ([[model-compression]])"@en ;
  skos:definition "Converting, packaging, executing, and updating models on phones, embedded devices, and microcontrollers under memory, energy, and connectivity limits."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.model-conversion>, <https://mlsysbook.ai/taxonomy/concept/mlsys.on-device-runtime>, <https://mlsysbook.ai/taxonomy/concept/mlsys.ota-model-update>, <https://mlsysbook.ai/taxonomy/concept/mlsys.device-cloud-partitioning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.device-heterogeneity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.ui-thread-inference> .

<https://mlsysbook.ai/taxonomy/area/operations> a skos:Collection ;
  skos:prefLabel "MLOps & operations"@en ;
  skos:notation "P5" ;
  skos:scopeNote "Release management, monitoring, drift and retraining, incident response, pipelines and reproducibility, platforms and teams, and retirement."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/release-management>, <https://mlsysbook.ai/taxonomy/subject/monitoring>, <https://mlsysbook.ai/taxonomy/subject/drift-retraining>, <https://mlsysbook.ai/taxonomy/subject/incident-response>, <https://mlsysbook.ai/taxonomy/subject/pipelines-reproducibility>, <https://mlsysbook.ai/taxonomy/subject/ml-platforms>, <https://mlsysbook.ai/taxonomy/subject/retirement> .

<https://mlsysbook.ai/taxonomy/subject/release-management> a skos:Collection ;
  skos:prefLabel "Versioning, rollout & rollback"@en ;
  skos:notation "P5.1" ;
  skos:scopeNote "Includes: Registries, CI/CD for models, release gates.; Shadow, canary, and staged rollout; rollback. Excludes: Statistical design of experiments ([[evaluation-protocols]])"@en ;
  skos:definition "Identifying, gating, and progressively exposing model releases, with the ability to return to a known-good configuration."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.artifact-version>, <https://mlsysbook.ai/taxonomy/concept/mlsys.rollout>, <https://mlsysbook.ai/taxonomy/concept/mlsys.rollback>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-registry>, <https://mlsysbook.ai/taxonomy/concept/mlsys.shadow-deployment>, <https://mlsysbook.ai/taxonomy/concept/mlsys.ml-ci-cd>, <https://mlsysbook.ai/taxonomy/concept/mlsys.release-gate>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-feature-compatibility> .

<https://mlsysbook.ai/taxonomy/subject/monitoring> a skos:Collection ;
  skos:prefLabel "Monitoring & observability"@en ;
  skos:notation "P5.2" ;
  skos:scopeNote "Includes: Prediction logging, drift statistics, alerting and alert fatigue.; Metrics, logs, traces for model services and agents. Excludes: Responding to detected incidents ([[incident-response]])"@en ;
  skos:definition "Instrumenting deployed systems and detecting, from logged signals, changes in inputs, outputs, quality, and health."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.monitoring>, <https://mlsysbook.ai/taxonomy/concept/mlsys.observability>, <https://mlsysbook.ai/taxonomy/concept/mlsys.drift-detection>, <https://mlsysbook.ai/taxonomy/concept/mlsys.inference-logging>, <https://mlsysbook.ai/taxonomy/concept/mlsys.alerting>, <https://mlsysbook.ai/taxonomy/concept/mlsys.distributed-tracing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.llm-call-tracing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.misuse-monitoring>, <https://mlsysbook.ai/taxonomy/concept/mlsys.telemetry-sampling> .

<https://mlsysbook.ai/taxonomy/subject/drift-retraining> a skos:Collection ;
  skos:prefLabel "Drift, feedback loops & retraining"@en ;
  skos:notation "P5.3" ;
  skos:scopeNote "Includes: Covariate and concept drift, delayed labels, hidden feedback loops.; Scheduled and triggered retraining, continuous training. Excludes: Incremental learning algorithms ([[continual-learning]])"@en ;
  skos:definition "Understanding how deployment data and outcomes change, including changes the system itself causes, and deciding when and how to update the model."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.distribution-shift>, <https://mlsysbook.ai/taxonomy/concept/mlsys.concept-drift>, <https://mlsysbook.ai/taxonomy/concept/mlsys.delayed-outcomes>, <https://mlsysbook.ai/taxonomy/concept/mlsys.feedback-loop>, <https://mlsysbook.ai/taxonomy/concept/mlsys.retraining>, <https://mlsysbook.ai/taxonomy/concept/mlsys.continuous-training>, <https://mlsysbook.ai/taxonomy/concept/mlsys.user-feedback>, <https://mlsysbook.ai/taxonomy/concept/mlsys.fleet-data-engine>, <https://mlsysbook.ai/taxonomy/concept/mlsys.label-shift-estimation> .

<https://mlsysbook.ai/taxonomy/subject/incident-response> a skos:Collection ;
  skos:prefLabel "Incident response"@en ;
  skos:notation "P5.4" ;
  skos:scopeNote "Includes: Triage, mitigation, blameless postmortems, on-call. Excludes: Failure semantics and recovery mechanisms ([[reliability]])"@en ;
  skos:definition "Detecting, triaging, mitigating, and learning from production failures, including attributing them to data, model, or infrastructure causes."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.incident-response>, <https://mlsysbook.ai/taxonomy/concept/mlsys.postmortem>, <https://mlsysbook.ai/taxonomy/concept/mlsys.failure-attribution>, <https://mlsysbook.ai/taxonomy/concept/mlsys.runbook> .

<https://mlsysbook.ai/taxonomy/subject/pipelines-reproducibility> a skos:Collection ;
  skos:prefLabel "ML pipelines & reproducibility"@en ;
  skos:notation "P5.5" ;
  skos:scopeNote "Includes: Orchestrated pipelines, environment pinning, configuration as code. Excludes: Experiment search strategy ([[experiment-management]]); Scheduling containers across a cluster ([[cluster-scheduling]])"@en ;
  skos:definition "Automating the steps that produce models and controlling their environments and configuration so runs can be repeated."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.dependency-environment>, <https://mlsysbook.ai/taxonomy/concept/mlsys.workflow-orchestration>, <https://mlsysbook.ai/taxonomy/concept/mlsys.experiment-reproducibility>, <https://mlsysbook.ai/taxonomy/concept/mlsys.configuration-management>, <https://mlsysbook.ai/taxonomy/concept/mlsys.infrastructure-as-code>, <https://mlsysbook.ai/taxonomy/concept/mlsys.containerization> .

<https://mlsysbook.ai/taxonomy/subject/ml-platforms> a skos:Collection ;
  skos:prefLabel "ML platforms, teams & technical debt"@en ;
  skos:notation "P5.6" ;
  skos:scopeNote "Includes: Platform-as-product, maturity levels, ownership and roles.; ML-specific technical debt and anti-patterns. Excludes: Fleet hardware and scheduling ([[infrastructure-fleet]]); Governance and regulation ([[governance-regulation]])"@en ;
  skos:definition "Shared internal platforms, team structures, and debt management that let an organization operate many models at sustainable cost."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.ml-platform>, <https://mlsysbook.ai/taxonomy/concept/mlsys.technical-debt>, <https://mlsysbook.ai/taxonomy/concept/mlsys.entanglement>, <https://mlsysbook.ai/taxonomy/concept/mlsys.undeclared-consumers>, <https://mlsysbook.ai/taxonomy/concept/mlsys.mlops-maturity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.ml-roles>, <https://mlsysbook.ai/taxonomy/concept/mlsys.glue-code>, <https://mlsysbook.ai/taxonomy/concept/mlsys.pipeline-jungle>, <https://mlsysbook.ai/taxonomy/concept/mlsys.build-vs-buy> .

<https://mlsysbook.ai/taxonomy/subject/retirement> a skos:Collection ;
  skos:prefLabel "Model retirement"@en ;
  skos:notation "P5.7" ;
  skos:scopeNote "Includes: Deprecation with consumer migration, archival for audit, retention and deletion. Excludes: Removing learned influence of specific records ([[privacy-dp]])"@en ;
  skos:definition "Ending a model's service by migrating its consumers, archiving what must be kept, and deleting data and resources that are no longer justified."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.model-deprecation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.artifact-archival>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-retention>, <https://mlsysbook.ai/taxonomy/concept/mlsys.deletion-propagation> .

<https://mlsysbook.ai/taxonomy/group/qualities> a skos:Collection ;
  skos:prefLabel "Qualities"@en ;
  skos:notation "Q" ;
  skos:member <https://mlsysbook.ai/taxonomy/area/efficiency>, <https://mlsysbook.ai/taxonomy/area/reliability>, <https://mlsysbook.ai/taxonomy/area/security-privacy>, <https://mlsysbook.ai/taxonomy/area/safety-assurance>, <https://mlsysbook.ai/taxonomy/area/responsible-ai>, <https://mlsysbook.ai/taxonomy/area/sustainability-cost> .

<https://mlsysbook.ai/taxonomy/area/efficiency> a skos:Collection ;
  skos:prefLabel "Performance, efficiency & benchmarking"@en ;
  skos:notation "Q1" ;
  skos:scopeNote "Measuring and benchmarking where time, memory, and energy go, and the cross-layer techniques whose primary purpose is to reduce them, such as compression and hardware-aware design."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/profiling-utilization>, <https://mlsysbook.ai/taxonomy/subject/system-benchmarking>, <https://mlsysbook.ai/taxonomy/subject/model-compression>, <https://mlsysbook.ai/taxonomy/subject/hardware-aware-design> .

<https://mlsysbook.ai/taxonomy/subject/profiling-utilization> a skos:Collection ;
  skos:prefLabel "Profiling & utilization"@en ;
  skos:notation "Q1.1" ;
  skos:scopeNote "Includes: Profilers and execution-time breakdowns; Utilization metrics such as MFU and training goodput; Bottleneck attribution across compute, memory, I/O, and communication Excludes: Standardized benchmark suites and reporting rules ([[system-benchmarking]]); Worst-case execution-time bounds ([[real-time-systems]]); Serving-specific latency and goodput targets ([[latency-goodput]])"@en ;
  skos:definition "Measuring where execution time and resources go under a stated workload, and expressing how much of the hardware's capacity does useful model work."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.profiling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.execution-time>, <https://mlsysbook.ai/taxonomy/concept/mlsys.utilization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-flops-utilization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.bottleneck-analysis>, <https://mlsysbook.ai/taxonomy/concept/mlsys.training-goodput>, <https://mlsysbook.ai/taxonomy/concept/mlsys.cross-stack-profiling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.hardware-performance-counters>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-bandwidth-utilization> .

<https://mlsysbook.ai/taxonomy/subject/system-benchmarking> a skos:Collection ;
  skos:prefLabel "System benchmarking"@en ;
  skos:notation "Q1.2" ;
  skos:scopeNote "Includes: MLPerf-style time-to-quality and scenario-based inference metrics. Excludes: Profiling a single workload ([[profiling-utilization]])"@en ;
  skos:definition "Measuring training and inference system performance under specified workloads, quality targets, load scenarios, and run rules so results are comparable."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.benchmark>, <https://mlsysbook.ai/taxonomy/concept/mlsys.time-to-train>, <https://mlsysbook.ai/taxonomy/concept/mlsys.inference-load-scenario>, <https://mlsysbook.ai/taxonomy/concept/mlsys.benchmark-representativeness>, <https://mlsysbook.ai/taxonomy/concept/mlsys.performance-regression-testing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.measurement-variability> .

<https://mlsysbook.ai/taxonomy/subject/model-compression> a skos:Collection ;
  skos:prefLabel "Model compression"@en ;
  skos:notation "Q1.3" ;
  skos:scopeNote "Includes: Quantization (post-training and quantization-aware); Pruning (structured and unstructured) and sparsity exploitation; Knowledge distillation and low-rank factorization Excludes: Numeric format definitions and mixed-precision training ([[numerics]]); Parameter-efficient fine-tuning such as LoRA, whose purpose is adaptation ([[fine-tuning]])"@en ;
  skos:definition "Techniques that shrink a trained or training model's parameters, precision, or rank to reduce memory, compute, and latency at a measured cost in quality."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.quantization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sparsity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.distillation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.pruning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.structured-pruning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.low-rank-factorization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.quantization-aware-training>, <https://mlsysbook.ai/taxonomy/concept/mlsys.post-training-quantization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.weight-only-quantization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.activation-outliers>, <https://mlsysbook.ai/taxonomy/concept/mlsys.kv-cache-quantization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.nm-sparsity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.activation-sparsity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.integer-only-inference>, <https://mlsysbook.ai/taxonomy/concept/mlsys.quantization-granularity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.compression-composition> .

<https://mlsysbook.ai/taxonomy/subject/hardware-aware-design> a skos:Collection ;
  skos:prefLabel "Hardware-aware model design"@en ;
  skos:notation "Q1.4" ;
  skos:scopeNote "Includes: Neural architecture search, including hardware-aware objectives; Efficient building blocks and the accuracy-efficiency frontier; Joint model and hardware co-design Excludes: Mixture-of-experts and early exit ([[conditional-computation]]); Efficient attention and state-space models ([[efficient-sequence-models]])"@en ;
  skos:definition "Choosing or searching model architectures against a target device's measured cost, so that quality and efficiency are optimized together rather than compressed after the fact."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.neural-architecture-search>, <https://mlsysbook.ai/taxonomy/concept/mlsys.hardware-aware-nas>, <https://mlsysbook.ai/taxonomy/concept/mlsys.efficiency-frontier>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-hardware-co-design> .

<https://mlsysbook.ai/taxonomy/area/reliability> a skos:Collection ;
  skos:prefLabel "Reliability & fault tolerance"@en ;
  skos:notation "Q2" ;
  skos:scopeNote "Infrastructure and service fault tolerance, from failure assumptions and recovery semantics to fleet failure rates, checkpoint economics, and resilience testing."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/failure-semantics>, <https://mlsysbook.ai/taxonomy/subject/checkpoint-recovery>, <https://mlsysbook.ai/taxonomy/subject/hardware-faults>, <https://mlsysbook.ai/taxonomy/subject/fault-injection> .

<https://mlsysbook.ai/taxonomy/subject/failure-semantics> a skos:Collection ;
  skos:prefLabel "Failure models, retries & degradation"@en ;
  skos:notation "Q2.1" ;
  skos:scopeNote "Includes: Failure models and recovery semantics (idempotency, compensation); Retries, circuit breakers, replication, and failover; Graceful degradation of quality or features under failure Excludes: Physical safety fallbacks and stopping envelopes ([[runtime-enforcement]]); Durable agent execution and replay ([[durable-execution]])"@en ;
  skos:definition "Declared failure assumptions and the service-level mechanisms (retries, idempotency, replication, circuit breaking, degradation) that keep requests correct and available when components fail."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.failure-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.idempotency>, <https://mlsysbook.ai/taxonomy/concept/mlsys.compensation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.irreversible-effects>, <https://mlsysbook.ai/taxonomy/concept/mlsys.retry-backoff>, <https://mlsysbook.ai/taxonomy/concept/mlsys.circuit-breaker>, <https://mlsysbook.ai/taxonomy/concept/mlsys.replication-failover>, <https://mlsysbook.ai/taxonomy/concept/mlsys.graceful-degradation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.health-checks>, <https://mlsysbook.ai/taxonomy/concept/mlsys.metastable-failure>, <https://mlsysbook.ai/taxonomy/concept/mlsys.request-timeout>, <https://mlsysbook.ai/taxonomy/concept/mlsys.in-doubt-action> .

<https://mlsysbook.ai/taxonomy/subject/checkpoint-recovery> a skos:Collection ;
  skos:prefLabel "Checkpointing & elastic recovery"@en ;
  skos:notation "Q2.2" ;
  skos:scopeNote "Includes: Checkpoints and consistent cuts for distributed state; Optimal checkpoint interval (Young-Daly) and asynchronous checkpointing; Elastic recovery on a changed set of workers Excludes: Activation recomputation, sometimes called gradient checkpointing ([[training-memory]]); Checkpoint storage bandwidth and I/O systems ([[storage-systems]])"@en ;
  skos:definition "Persisting recoverable state for long-running jobs and choosing checkpoint frequency and recovery strategy to minimize lost work and restart cost under a given failure rate."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.checkpoint>, <https://mlsysbook.ai/taxonomy/concept/mlsys.consistent-cut>, <https://mlsysbook.ai/taxonomy/concept/mlsys.checkpoint-interval>, <https://mlsysbook.ai/taxonomy/concept/mlsys.async-checkpointing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.checkpoint-resharding>, <https://mlsysbook.ai/taxonomy/concept/mlsys.incremental-checkpointing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.hot-spare-capacity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.restart-free-recovery> .

<https://mlsysbook.ai/taxonomy/subject/hardware-faults> a skos:Collection ;
  skos:prefLabel "Hardware faults & silent data corruption"@en ;
  skos:notation "Q2.3" ;
  skos:scopeNote "Includes: Fail-stop, gray, and silent failures and their detection; Fleet failure rates (MTBF composition) and availability; Correlated failures and failure domains Excludes: Distribution shift and adversarial robustness ([[drift-retraining]]; [[ml-attacks]]); Chip power and thermal limits as design constraints ([[chip-power-thermal]])"@en ;
  skos:definition "How hardware fails in a fleet, from fail-stop crashes to gray and silent faults, how often it fails, and how such faults are detected and contained."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.silent-data-corruption>, <https://mlsysbook.ai/taxonomy/concept/mlsys.mtbf>, <https://mlsysbook.ai/taxonomy/concept/mlsys.availability>, <https://mlsysbook.ai/taxonomy/concept/mlsys.gray-failure>, <https://mlsysbook.ai/taxonomy/concept/mlsys.failure-domain>, <https://mlsysbook.ai/taxonomy/concept/mlsys.abft>, <https://mlsysbook.ai/taxonomy/concept/mlsys.distributed-hang-diagnosis>, <https://mlsysbook.ai/taxonomy/concept/mlsys.flash-endurance>, <https://mlsysbook.ai/taxonomy/concept/mlsys.ecc-memory>, <https://mlsysbook.ai/taxonomy/concept/mlsys.fleet-hardware-screening> .

<https://mlsysbook.ai/taxonomy/subject/fault-injection> a skos:Collection ;
  skos:prefLabel "Fault injection & resilience testing"@en ;
  skos:notation "Q2.4" ;
  skos:scopeNote "Includes: Chaos engineering and failure injection in production-like settings; Game days and recovery rehearsals; Hardware fault injection to estimate model error resilience Excludes: Functional ML tests and test oracles ([[ml-testing]]); Scenario-based safety validation ([[verification-validation]])"@en ;
  skos:definition "Deliberately introducing software, infrastructure, or hardware faults under controlled scope to verify that detection, recovery, and degradation work as designed."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.failure-injection>, <https://mlsysbook.ai/taxonomy/concept/mlsys.chaos-engineering>, <https://mlsysbook.ai/taxonomy/concept/mlsys.game-day>, <https://mlsysbook.ai/taxonomy/concept/mlsys.hardware-fault-injection>, <https://mlsysbook.ai/taxonomy/concept/mlsys.blast-radius> .

<https://mlsysbook.ai/taxonomy/area/security-privacy> a skos:Collection ;
  skos:prefLabel "Security & privacy"@en ;
  skos:notation "Q3" ;
  skos:scopeNote "Adversaries and defenses across data, model, artifact, and execution boundaries, and the leakage of information about people or records through learned systems."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/ml-attacks>, <https://mlsysbook.ai/taxonomy/subject/model-supply-chain>, <https://mlsysbook.ai/taxonomy/subject/privacy-dp>, <https://mlsysbook.ai/taxonomy/subject/access-isolation> .

<https://mlsysbook.ai/taxonomy/subject/ml-attacks> a skos:Collection ;
  skos:prefLabel "Threat models & adversarial attacks"@en ;
  skos:notation "Q3.1" ;
  skos:scopeNote "Includes: Threat models for ML assets and interfaces; Poisoning, backdoors, evasion, jailbreaks, and prompt injection; Defenses such as adversarial training Excludes: Robustness evaluation methodology ([[robustness-slices]]); Theft and integrity of model artifacts ([[model-supply-chain]])"@en ;
  skos:definition "Specifying adversaries against learned systems and the attacks they mount on training data, model inputs, and instruction boundaries, with the defenses aimed at each."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.threat-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.poisoning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.evasion>, <https://mlsysbook.ai/taxonomy/concept/mlsys.prompt-injection>, <https://mlsysbook.ai/taxonomy/concept/mlsys.backdoor>, <https://mlsysbook.ai/taxonomy/concept/mlsys.jailbreak>, <https://mlsysbook.ai/taxonomy/concept/mlsys.adversarial-training>, <https://mlsysbook.ai/taxonomy/concept/mlsys.red-teaming>, <https://mlsysbook.ai/taxonomy/concept/mlsys.byzantine-robust-aggregation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sensor-spoofing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.randomized-smoothing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.resource-exhaustion-attack>, <https://mlsysbook.ai/taxonomy/concept/mlsys.instruction-hierarchy> .

<https://mlsysbook.ai/taxonomy/subject/model-supply-chain> a skos:Collection ;
  skos:prefLabel "Model & supply-chain security"@en ;
  skos:notation "Q3.2" ;
  skos:scopeNote "Includes: Model extraction and ownership evidence (watermarking); Artifact signing and provenance; Malicious weights, serialization formats, and dependencies Excludes: Artifact versioning and registries as release tooling ([[release-management]]); Data lineage as a data-engineering practice ([[data-lineage]])"@en ;
  skos:definition "Protecting models as valuable artifacts from theft and tampering, and protecting the chain of datasets, pretrained weights, libraries, and builds that produce them."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.model-extraction>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-watermarking>, <https://mlsysbook.ai/taxonomy/concept/mlsys.artifact-signing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.unsafe-deserialization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.supply-chain-compromise>, <https://mlsysbook.ai/taxonomy/concept/mlsys.weight-exfiltration>, <https://mlsysbook.ai/taxonomy/concept/mlsys.ai-bill-of-materials> .

<https://mlsysbook.ai/taxonomy/subject/privacy-dp> a skos:Collection ;
  skos:prefLabel "Privacy leakage & differential privacy"@en ;
  skos:notation "Q3.3" ;
  skos:scopeNote "Includes: Membership inference and model inversion; Differential privacy and DP-SGD; Machine unlearning and secure aggregation Excludes: Federated training protocols and client scheduling ([[federated-learning]]); Privacy regulation and governance processes ([[governance-regulation]])"@en ;
  skos:definition "Privacy requirements for data about people, the attacks that extract it from models and outputs, and formal or architectural mechanisms that bound or remove that leakage."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.privacy>, <https://mlsysbook.ai/taxonomy/concept/mlsys.differential-privacy>, <https://mlsysbook.ai/taxonomy/concept/mlsys.privacy-leakage>, <https://mlsysbook.ai/taxonomy/concept/mlsys.membership-inference>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-inversion>, <https://mlsysbook.ai/taxonomy/concept/mlsys.dp-sgd>, <https://mlsysbook.ai/taxonomy/concept/mlsys.machine-unlearning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.secure-aggregation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.he-inference>, <https://mlsysbook.ai/taxonomy/concept/mlsys.secure-computation-inference>, <https://mlsysbook.ai/taxonomy/concept/mlsys.training-data-extraction>, <https://mlsysbook.ai/taxonomy/concept/mlsys.pii-deidentification>, <https://mlsysbook.ai/taxonomy/concept/mlsys.privacy-budget> .

<https://mlsysbook.ai/taxonomy/subject/access-isolation> a skos:Collection ;
  skos:prefLabel "Access control & isolation"@en ;
  skos:notation "Q3.4" ;
  skos:scopeNote "Includes: Authorization, least privilege, and sandboxed execution; Confidential computing and remote attestation; Side channels across shared accelerators and caches Excludes: Tenant quotas and resource isolation for performance ([[capacity-provisioning]]); Agent tool contracts and action approval ([[tool-interfaces]])"@en ;
  skos:definition "Constraining who may act, what code may reach, and which parties can observe data in use, through authorization, least privilege, isolation, and hardware-rooted trust."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.authorization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.isolation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.least-privilege>, <https://mlsysbook.ai/taxonomy/concept/mlsys.confidential-computing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.remote-attestation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.side-channel>, <https://mlsysbook.ai/taxonomy/concept/mlsys.capability-based-security>, <https://mlsysbook.ai/taxonomy/concept/mlsys.ephemeral-sandbox>, <https://mlsysbook.ai/taxonomy/concept/mlsys.egress-control>, <https://mlsysbook.ai/taxonomy/concept/mlsys.information-flow-control>, <https://mlsysbook.ai/taxonomy/concept/mlsys.agent-credentials>, <https://mlsysbook.ai/taxonomy/concept/mlsys.secrets-management>, <https://mlsysbook.ai/taxonomy/concept/mlsys.confused-deputy>, <https://mlsysbook.ai/taxonomy/concept/mlsys.quarantined-model-pattern> .

<https://mlsysbook.ai/taxonomy/area/safety-assurance> a skos:Collection ;
  skos:prefLabel "Safety & assurance"@en ;
  skos:notation "Q4" ;
  skos:scopeNote "Identifying hazards, bounding the operating domain, enforcing safety at runtime, verifying and validating behavior, and arguing acceptable residual risk against recognized standards."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/hazards-operating-domain>, <https://mlsysbook.ai/taxonomy/subject/runtime-enforcement>, <https://mlsysbook.ai/taxonomy/subject/verification-validation>, <https://mlsysbook.ai/taxonomy/subject/safety-cases> .

<https://mlsysbook.ai/taxonomy/subject/hazards-operating-domain> a skos:Collection ;
  skos:prefLabel "Hazard analysis & operating domains"@en ;
  skos:notation "Q4.1" ;
  skos:scopeNote "Includes: Hazard identification and analysis (STPA, FMEA, fault trees) applied to learned components.; Operational design domains and triggering conditions for functional insufficiency (SOTIF). Excludes: Adversary-driven threat modeling ([[ml-attacks]]); Infrastructure fault models ([[failure-semantics]])"@en ;
  skos:definition "Identifying how a system can contribute to harm, including hazards from functional insufficiency rather than faults, and fixing the operating conditions within which safety claims are made."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.operating-domain>, <https://mlsysbook.ai/taxonomy/concept/mlsys.hazard-analysis>, <https://mlsysbook.ai/taxonomy/concept/mlsys.stpa>, <https://mlsysbook.ai/taxonomy/concept/mlsys.fmea>, <https://mlsysbook.ai/taxonomy/concept/mlsys.functional-insufficiency>, <https://mlsysbook.ai/taxonomy/concept/mlsys.fault-tree-analysis>, <https://mlsysbook.ai/taxonomy/concept/mlsys.tolerable-risk> .

<https://mlsysbook.ai/taxonomy/subject/runtime-enforcement> a skos:Collection ;
  skos:prefLabel "Runtime assurance & safety filters"@en ;
  skos:notation "Q4.2" ;
  skos:scopeNote "Includes: Safety filters, control barrier functions, Simplex switching, and fallback to a minimal-risk condition.; Input and output guardrails that block or rewrite unsafe generated content or actions. Excludes: Human approval of agent actions ([[agent-harness]]); Retry, failover, and graceful degradation for availability ([[reliability]])"@en ;
  skos:definition "Mechanisms that monitor a learned component at run time and override, constrain, or replace its outputs so the system stays within a verified safe set."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.runtime-assurance>, <https://mlsysbook.ai/taxonomy/concept/mlsys.stopping-envelope>, <https://mlsysbook.ai/taxonomy/concept/mlsys.safety-filter>, <https://mlsysbook.ai/taxonomy/concept/mlsys.control-barrier-function>, <https://mlsysbook.ai/taxonomy/concept/mlsys.simplex-architecture>, <https://mlsysbook.ai/taxonomy/concept/mlsys.minimal-risk-condition>, <https://mlsysbook.ai/taxonomy/concept/mlsys.guardrails>, <https://mlsysbook.ai/taxonomy/concept/mlsys.over-refusal>, <https://mlsysbook.ai/taxonomy/concept/mlsys.reachability-analysis> .

<https://mlsysbook.ai/taxonomy/subject/verification-validation> a skos:Collection ;
  skos:prefLabel "Safety verification & validation"@en ;
  skos:notation "Q4.3" ;
  skos:scopeNote "Includes: Scenario coverage, simulation-based falsification, and software/hardware-in-the-loop qualification.; Formal and statistical guarantees, including verification of neural networks and rare-event estimation. Excludes: Average-case model metrics and benchmarks ([[evaluation]])"@en ;
  skos:definition "Producing evidence that a system meets its safety requirements across its operating domain, through scenario testing, falsification, formal proof, and statistical validation of rare failures."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.scenario-based-testing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.falsification>, <https://mlsysbook.ai/taxonomy/concept/mlsys.formal-verification>, <https://mlsysbook.ai/taxonomy/concept/mlsys.neural-network-verification>, <https://mlsysbook.ai/taxonomy/concept/mlsys.rare-event-validation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.xil-testing> .

<https://mlsysbook.ai/taxonomy/subject/safety-cases> a skos:Collection ;
  skos:prefLabel "Safety cases, standards & certification"@en ;
  skos:notation "Q4.4" ;
  skos:scopeNote "Includes: Safety-case structure and notation (claims, arguments, evidence; GSN).; Functional-safety and autonomy standards (ISO 26262, IEC 61508, ISO 21448, UL 4600) and integrity levels. Excludes: Regulatory compliance not specific to safety, such as the EU AI Act ([[governance-regulation]])"@en ;
  skos:definition "Structured arguments that a system is acceptably safe for a defined use, the standards that set what evidence is required, and the field indicators that keep the argument valid after release."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.safety-case>, <https://mlsysbook.ai/taxonomy/concept/mlsys.goal-structuring-notation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.functional-safety>, <https://mlsysbook.ai/taxonomy/concept/mlsys.safety-integrity-level>, <https://mlsysbook.ai/taxonomy/concept/mlsys.safety-performance-indicator>, <https://mlsysbook.ai/taxonomy/concept/mlsys.event-data-recorder>, <https://mlsysbook.ai/taxonomy/concept/mlsys.change-impact-analysis>, <https://mlsysbook.ai/taxonomy/concept/mlsys.safety-certification> .

<https://mlsysbook.ai/taxonomy/area/responsible-ai> a skos:Collection ;
  skos:prefLabel "Responsible AI"@en ;
  skos:notation "Q5" ;
  skos:scopeNote "Measuring and mitigating unfair outcomes, explaining and documenting models and data, keeping people able to oversee and contest decisions, and governing AI risk under organizational and legal regimes."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/fairness-bias>, <https://mlsysbook.ai/taxonomy/subject/transparency-explainability>, <https://mlsysbook.ai/taxonomy/subject/human-oversight>, <https://mlsysbook.ai/taxonomy/subject/governance-regulation> .

<https://mlsysbook.ai/taxonomy/subject/fairness-bias> a skos:Collection ;
  skos:prefLabel "Fairness & bias"@en ;
  skos:notation "Q5.1" ;
  skos:scopeNote "Includes: Group and individual fairness criteria and the metrics that measure them.; Pre-, in-, and post-processing mitigation and its accuracy cost. Excludes: Per-slice measurement machinery in general ([[robustness-slices]]); Scheduler fair sharing ([[cluster-scheduling]])"@en ;
  skos:definition "Specifying, measuring, and mitigating how a system's outcomes and errors differ across people and groups."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.fairness>, <https://mlsysbook.ai/taxonomy/concept/mlsys.group-fairness-metric>, <https://mlsysbook.ai/taxonomy/concept/mlsys.individual-fairness>, <https://mlsysbook.ai/taxonomy/concept/mlsys.fairness-incompatibility>, <https://mlsysbook.ai/taxonomy/concept/mlsys.bias-mitigation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.representational-bias-evaluation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.proxy-discrimination>, <https://mlsysbook.ai/taxonomy/concept/mlsys.bias-sources>, <https://mlsysbook.ai/taxonomy/concept/mlsys.fairness-monitoring> .

<https://mlsysbook.ai/taxonomy/subject/transparency-explainability> a skos:Collection ;
  skos:prefLabel "Explainability & documentation"@en ;
  skos:notation "Q5.2" ;
  skos:scopeNote "Includes: Post-hoc explanations (feature attribution, counterfactuals) and inherently interpretable models.; Model cards, datasheets, and the serving cost of producing explanations. Excludes: Debugging-oriented model inspection ([[ml-testing]]); Data provenance records ([[data-lineage]])"@en ;
  skos:definition "Making model behavior understandable to the people who build, deploy, and are affected by it, through explanations, interpretable models, and standardized documentation of models and data."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.feature-attribution>, <https://mlsysbook.ai/taxonomy/concept/mlsys.counterfactual-explanation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.interpretable-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-card>, <https://mlsysbook.ai/taxonomy/concept/mlsys.datasheet>, <https://mlsysbook.ai/taxonomy/concept/mlsys.mechanistic-interpretability> .

<https://mlsysbook.ai/taxonomy/subject/human-oversight> a skos:Collection ;
  skos:prefLabel "Human oversight & contestability"@en ;
  skos:notation "Q5.3" ;
  skos:scopeNote "Includes: Human-in-the-loop and on-the-loop control, recourse and appeal, and control handover.; Automation bias, complacency, and the ironies of automation. Excludes: The mechanics of agent approval gates ([[agent-harness]])"@en ;
  skos:definition "Arrangements that let people supervise, intervene in, take over from, and challenge consequential system decisions, and the human-factors limits on doing so."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.human-oversight>, <https://mlsysbook.ai/taxonomy/concept/mlsys.contestability>, <https://mlsysbook.ai/taxonomy/concept/mlsys.automation-bias>, <https://mlsysbook.ai/taxonomy/concept/mlsys.authority-handover>, <https://mlsysbook.ai/taxonomy/concept/mlsys.human-ai-interaction> .

<https://mlsysbook.ai/taxonomy/subject/governance-regulation> a skos:Collection ;
  skos:prefLabel "AI governance, audit & regulation"@en ;
  skos:notation "Q5.4" ;
  skos:scopeNote "Includes: NIST AI RMF and ISO/IEC 42001 management systems; internal and external audits.; Risk-tiered regulation (EU AI Act) and frontier-model capability thresholds. Excludes: Data-protection mechanisms such as differential privacy ([[security-privacy]]); Safety-standard certification ([[safety-cases]])"@en ;
  skos:definition "Organizational and legal mechanisms that identify, assess, and control AI risk across a system's life, including risk-management frameworks, impact assessments, audits, and regulation."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.ai-risk-management>, <https://mlsysbook.ai/taxonomy/concept/mlsys.impact-assessment>, <https://mlsysbook.ai/taxonomy/concept/mlsys.algorithmic-audit>, <https://mlsysbook.ai/taxonomy/concept/mlsys.risk-tiered-regulation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.frontier-safety-framework>, <https://mlsysbook.ai/taxonomy/concept/mlsys.decision-accountability>, <https://mlsysbook.ai/taxonomy/concept/mlsys.content-provenance>, <https://mlsysbook.ai/taxonomy/concept/mlsys.generated-content-watermarking>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-protection-regulation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.ai-incident-reporting> .

<https://mlsysbook.ai/taxonomy/area/sustainability-cost> a skos:Collection ;
  skos:prefLabel "Sustainability & cost"@en ;
  skos:notation "Q6" ;
  skos:scopeNote "Accounting for environmental and monetary consequences of ML systems under declared boundaries, and the decisions that reduce them per useful outcome."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/energy-carbon>, <https://mlsysbook.ai/taxonomy/subject/embodied-lifecycle>, <https://mlsysbook.ai/taxonomy/subject/cost-economics> .

<https://mlsysbook.ai/taxonomy/subject/energy-carbon> a skos:Collection ;
  skos:prefLabel "Energy & carbon accounting"@en ;
  skos:notation "Q6.1" ;
  skos:scopeNote "Includes: Energy measurement and energy efficiency (work per joule); Grid carbon intensity and operational carbon; Carbon-aware placement and scheduling Excludes: Facility power, cooling, and PUE ([[datacenter-facilities]]); Manufacturing emissions and hardware end of life ([[embodied-lifecycle]])"@en ;
  skos:definition "Measuring the energy a workload consumes and converting it to operational emissions under declared boundaries, and scheduling work to reduce both."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.energy>, <https://mlsysbook.ai/taxonomy/concept/mlsys.carbon>, <https://mlsysbook.ai/taxonomy/concept/mlsys.energy-efficiency>, <https://mlsysbook.ai/taxonomy/concept/mlsys.carbon-intensity>, <https://mlsysbook.ai/taxonomy/concept/mlsys.operational-carbon>, <https://mlsysbook.ai/taxonomy/concept/mlsys.emission-scopes>, <https://mlsysbook.ai/taxonomy/concept/mlsys.carbon-aware-scheduling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.energy-per-inference>, <https://mlsysbook.ai/taxonomy/concept/mlsys.energy-measurement>, <https://mlsysbook.ai/taxonomy/concept/mlsys.idle-dynamic-power>, <https://mlsysbook.ai/taxonomy/concept/mlsys.rebound-effect>, <https://mlsysbook.ai/taxonomy/concept/mlsys.carbon-accounting-method> .

<https://mlsysbook.ai/taxonomy/subject/embodied-lifecycle> a skos:Collection ;
  skos:prefLabel "Embodied carbon & lifecycle impact"@en ;
  skos:notation "Q6.2" ;
  skos:scopeNote "Includes: Embodied carbon and lifecycle assessment; Water consumption of training and serving; Hardware lifetime, refresh, and e-waste Excludes: Operational emissions from electricity ([[energy-carbon]]); Model retirement and decommissioning ([[retirement]])"@en ;
  skos:definition "Environmental impacts beyond operating energy, from manufacturing emissions and water to hardware lifetime and disposal, assessed over the full hardware lifecycle."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.embodied-carbon>, <https://mlsysbook.ai/taxonomy/concept/mlsys.lifecycle-assessment>, <https://mlsysbook.ai/taxonomy/concept/mlsys.water-footprint>, <https://mlsysbook.ai/taxonomy/concept/mlsys.hardware-lifetime>, <https://mlsysbook.ai/taxonomy/concept/mlsys.e-waste> .

<https://mlsysbook.ai/taxonomy/subject/cost-economics> a skos:Collection ;
  skos:prefLabel "Cost, TCO & unit economics"@en ;
  skos:notation "Q6.3" ;
  skos:scopeNote "Includes: Total cost of ownership and cost attribution (FinOps); Cost per token and cost per accepted outcome; Model routing and cascades chosen for cost Excludes: Capacity provisioning and quotas ([[capacity-provisioning]]); Spot and preemption scheduling mechanics ([[cluster-scheduling]])"@en ;
  skos:definition "Monetary accounting for ML systems, from total cost of ownership to cost per token or accepted outcome, and the architectural choices that lower cost at fixed quality."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.unit-cost>, <https://mlsysbook.ai/taxonomy/concept/mlsys.tco>, <https://mlsysbook.ai/taxonomy/concept/mlsys.cost-per-token>, <https://mlsysbook.ai/taxonomy/concept/mlsys.cost-attribution>, <https://mlsysbook.ai/taxonomy/concept/mlsys.data-transfer-cost>, <https://mlsysbook.ai/taxonomy/concept/mlsys.compute-cost-estimate> .

<https://mlsysbook.ai/taxonomy/group/system-types> a skos:Collection ;
  skos:prefLabel "System types"@en ;
  skos:notation "T" ;
  skos:member <https://mlsysbook.ai/taxonomy/area/agentic>, <https://mlsysbook.ai/taxonomy/area/embodied> .

<https://mlsysbook.ai/taxonomy/area/agentic> a skos:Collection ;
  skos:prefLabel "Agentic systems"@en ;
  skos:notation "T1" ;
  skos:scopeNote "Context engineering and agent memory, tool and action interfaces, the agent harness and its control loop, durable agent state, and multi-agent coordination."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/context-memory>, <https://mlsysbook.ai/taxonomy/subject/tool-interfaces>, <https://mlsysbook.ai/taxonomy/subject/agent-harness>, <https://mlsysbook.ai/taxonomy/subject/durable-execution>, <https://mlsysbook.ai/taxonomy/subject/multi-agent> .

<https://mlsysbook.ai/taxonomy/subject/context-memory> a skos:Collection ;
  skos:prefLabel "Context engineering & agent memory"@en ;
  skos:notation "T1.1" ;
  skos:scopeNote "Includes: Working-set selection, ordering for prefix reuse, compaction, and long-context degradation.; Long-term memory write paths, consolidation, expiry, and invalidation. Excludes: Retrieval and vector indexes in general ([[retrieval-rag]]); KV-cache management ([[llm-inference]])"@en ;
  skos:definition "Deciding what information enters each model call over a long task, and maintaining persistent memory the agent can write, consolidate, and retrieve across calls and sessions."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.context-compaction>, <https://mlsysbook.ai/taxonomy/concept/mlsys.agent-memory>, <https://mlsysbook.ai/taxonomy/concept/mlsys.context-selection>, <https://mlsysbook.ai/taxonomy/concept/mlsys.context-staleness> .

<https://mlsysbook.ai/taxonomy/subject/tool-interfaces> a skos:Collection ;
  skos:prefLabel "Tool use & action interfaces"@en ;
  skos:notation "T1.2" ;
  skos:scopeNote "Includes: Tool schemas, preconditions, function calling, and MCP-style discovery.; Computer-use agents and the handling of irreversible effects. Excludes: Sandboxing and capability isolation ([[access-isolation]]); Prompt injection ([[ml-attacks]])"@en ;
  skos:definition "The interfaces through which a model acts on the world, including structured tool calls, tool discovery protocols, computer use, and the effects and authority those actions carry."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.tool-contract>, <https://mlsysbook.ai/taxonomy/concept/mlsys.function-calling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-context-protocol>, <https://mlsysbook.ai/taxonomy/concept/mlsys.computer-use> .

<https://mlsysbook.ai/taxonomy/subject/agent-harness> a skos:Collection ;
  skos:prefLabel "Agent harness & control loop"@en ;
  skos:notation "T1.3" ;
  skos:scopeNote "Includes: Reason-act loops, workflows versus model-directed loops, and plan revision.; Turn, token, time, and spend budgets; stopping rules; human approval gates. Excludes: Inference-time search and reasoning budgets per call ([[test-time-compute]]); Trajectory-level evaluation ([[generative-agent-eval]])"@en ;
  skos:definition "The runtime that owns an agent's loop of model calls and tool actions, enforcing budgets, stopping rules, and approval gates and recording the trajectory."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.trajectory>, <https://mlsysbook.ai/taxonomy/concept/mlsys.planning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.agent-harness>, <https://mlsysbook.ai/taxonomy/concept/mlsys.agent-budget>, <https://mlsysbook.ai/taxonomy/concept/mlsys.approval-gate>, <https://mlsysbook.ai/taxonomy/concept/mlsys.agent-interruption>, <https://mlsysbook.ai/taxonomy/concept/mlsys.agent-loop-detection>, <https://mlsysbook.ai/taxonomy/concept/mlsys.agentic-workload>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-directed-control-flow> .

<https://mlsysbook.ai/taxonomy/subject/durable-execution> a skos:Collection ;
  skos:prefLabel "Durable execution & agent state"@en ;
  skos:notation "T1.4" ;
  skos:scopeNote "Includes: Event-sourced trajectory logs, resume protocols, and record-and-replay.; Pausing for human or external events and resuming safely. Excludes: General checkpointing, idempotency, and sagas ([[reliability]])"@en ;
  skos:definition "Persisting an agent's progress so long-running trajectories survive crashes, pauses, and redeployments without repeating completed effects, and can be replayed for debugging."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.durable-execution>, <https://mlsysbook.ai/taxonomy/concept/mlsys.deterministic-replay>, <https://mlsysbook.ai/taxonomy/concept/mlsys.suspend-resume>, <https://mlsysbook.ai/taxonomy/concept/mlsys.trajectory-log> .

<https://mlsysbook.ai/taxonomy/subject/multi-agent> a skos:Collection ;
  skos:prefLabel "Multi-agent orchestration"@en ;
  skos:notation "T1.5" ;
  skos:scopeNote "Includes: Orchestrator-worker and peer topologies, typed task envelopes, and delegation.; Coordination failures and correlated errors among agents sharing a base model. Excludes: Distributed consensus for infrastructure state ([[coordination]])"@en ;
  skos:definition "Decomposing a task across several model-driven agents and coordinating their delegation, shared state, and results, including when coordination costs outweigh the benefit."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.multi-agent-orchestration>, <https://mlsysbook.ai/taxonomy/concept/mlsys.shared-agent-state>, <https://mlsysbook.ai/taxonomy/concept/mlsys.coordination-failure>, <https://mlsysbook.ai/taxonomy/concept/mlsys.correlated-agent-errors> .

<https://mlsysbook.ai/taxonomy/area/embodied> a skos:Collection ;
  skos:prefLabel "Embodied & physical systems"@en ;
  skos:notation "T2" ;
  skos:scopeNote "Sensing and perception, state estimation and mapping, motion planning and control, real-time and mixed-criticality computing, and robot learning from demonstration and simulation."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/subject/perception-sensing>, <https://mlsysbook.ai/taxonomy/subject/state-estimation>, <https://mlsysbook.ai/taxonomy/subject/planning-control>, <https://mlsysbook.ai/taxonomy/subject/real-time-systems>, <https://mlsysbook.ai/taxonomy/subject/robot-learning> .

<https://mlsysbook.ai/taxonomy/subject/perception-sensing> a skos:Collection ;
  skos:prefLabel "Sensing, perception & fusion"@en ;
  skos:notation "T2.1" ;
  skos:scopeNote "Includes: Camera, LiDAR, radar, event, and tactile sensing; calibration chains.; Detection, segmentation, learned depth, and multi-sensor fusion. Excludes: Sensor spoofing ([[ml-attacks]])"@en ;
  skos:definition "Turning time-stamped measurements from physical sensors into task-relevant estimates of the scene, including calibration, synchronization, and fusion across modalities."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.sensing>, <https://mlsysbook.ai/taxonomy/concept/mlsys.robot-perception>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sensor-fusion>, <https://mlsysbook.ai/taxonomy/concept/mlsys.time-synchronization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.perception-latency-budget>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sensor-interference>, <https://mlsysbook.ai/taxonomy/concept/mlsys.coordinate-frames>, <https://mlsysbook.ai/taxonomy/concept/mlsys.sensor-degradation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.capture-epoch> .

<https://mlsysbook.ai/taxonomy/subject/state-estimation> a skos:Collection ;
  skos:prefLabel "State estimation, localization & mapping"@en ;
  skos:notation "T2.2" ;
  skos:scopeNote "Includes: Kalman and particle filters, tracking and data association, SLAM, metric and semantic maps.; Learned world models used for prediction and planning. Excludes: Software observability of services ([[monitoring]])"@en ;
  skos:definition "Inferring a robot's and its environment's latent state and uncertainty over time, through recursive filtering, localization and mapping, and learned predictive world models."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.state-estimation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.state-observability>, <https://mlsysbook.ai/taxonomy/concept/mlsys.recursive-filtering>, <https://mlsysbook.ai/taxonomy/concept/mlsys.slam>, <https://mlsysbook.ai/taxonomy/concept/mlsys.world-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.multi-object-tracking>, <https://mlsysbook.ai/taxonomy/concept/mlsys.motion-forecasting>, <https://mlsysbook.ai/taxonomy/concept/mlsys.odometry>, <https://mlsysbook.ai/taxonomy/concept/mlsys.map-representation> .

<https://mlsysbook.ai/taxonomy/subject/planning-control> a skos:Collection ;
  skos:prefLabel "Motion planning & control"@en ;
  skos:notation "T2.3" ;
  skos:scopeNote "Includes: Sampling- and optimization-based motion planning, task and motion planning.; Feedback control, MPC, and contact-rich manipulation. Excludes: Runtime safety filters over a planner's output ([[runtime-enforcement]])"@en ;
  skos:definition "Generating feasible, collision-free motions and closing feedback loops that drive a physical system along them under dynamics, contact, and actuation limits."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.dynamics>, <https://mlsysbook.ai/taxonomy/concept/mlsys.feedback-control>, <https://mlsysbook.ai/taxonomy/concept/mlsys.trajectory-feasibility>, <https://mlsysbook.ai/taxonomy/concept/mlsys.contact-compliance>, <https://mlsysbook.ai/taxonomy/concept/mlsys.motion-planning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.model-predictive-control>, <https://mlsysbook.ai/taxonomy/concept/mlsys.actuator-limits>, <https://mlsysbook.ai/taxonomy/concept/mlsys.task-and-motion-planning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.system-identification>, <https://mlsysbook.ai/taxonomy/concept/mlsys.robot-kinematics>, <https://mlsysbook.ai/taxonomy/concept/mlsys.loop-stability-margin>, <https://mlsysbook.ai/taxonomy/concept/mlsys.impedance-force-control> .

<https://mlsysbook.ai/taxonomy/subject/real-time-systems> a skos:Collection ;
  skos:prefLabel "Real-time & mixed-criticality computing"@en ;
  skos:notation "T2.4" ;
  skos:scopeNote "Includes: Multi-rate scheduling, response-time analysis, WCET, and real-time buses.; Mixed-criticality partitioning and hypervisors on shared silicon. Excludes: Throughput-oriented profiling and utilization ([[profiling-utilization]])"@en ;
  skos:definition "Guaranteeing that sensing, inference, and control complete within deadlines on shared embedded hardware, and isolating safety-critical functions from less trusted ones."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.observation-age>, <https://mlsysbook.ai/taxonomy/concept/mlsys.feedback-delay>, <https://mlsysbook.ai/taxonomy/concept/mlsys.wcet>, <https://mlsysbook.ai/taxonomy/concept/mlsys.real-time-scheduling>, <https://mlsysbook.ai/taxonomy/concept/mlsys.mixed-criticality>, <https://mlsysbook.ai/taxonomy/concept/mlsys.watchdog-timer>, <https://mlsysbook.ai/taxonomy/concept/mlsys.robotics-middleware>, <https://mlsysbook.ai/taxonomy/concept/mlsys.onboard-compute-partitioning>, <https://mlsysbook.ai/taxonomy/concept/mlsys.interrupt-latency>, <https://mlsysbook.ai/taxonomy/concept/mlsys.priority-inversion>, <https://mlsysbook.ai/taxonomy/concept/mlsys.timing-jitter>, <https://mlsysbook.ai/taxonomy/concept/mlsys.deterministic-field-network> .

<https://mlsysbook.ai/taxonomy/subject/robot-learning> a skos:Collection ;
  skos:prefLabel "Robot learning & sim-to-real"@en ;
  skos:notation "T2.5" ;
  skos:scopeNote "Includes: Vision-language-action models, action chunking, and cross-embodiment pretraining.; Teleoperation data collection, domain randomization, and sim-to-real transfer. Excludes: Imitation and reinforcement learning as general paradigms ([[learning-paradigms]]); Closed-loop robot evaluation statistics ([[evaluation]])"@en ;
  skos:definition "Learning robot policies from teleoperated demonstrations, simulation, and pretrained vision-language backbones, and transferring them to physical hardware."@en ;
  skos:member <https://mlsysbook.ai/taxonomy/concept/mlsys.sim-to-real>, <https://mlsysbook.ai/taxonomy/concept/mlsys.vla-model>, <https://mlsysbook.ai/taxonomy/concept/mlsys.teleoperation-data>, <https://mlsysbook.ai/taxonomy/concept/mlsys.action-chunking>, <https://mlsysbook.ai/taxonomy/concept/mlsys.domain-randomization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.diffusion-policy>, <https://mlsysbook.ai/taxonomy/concept/mlsys.parallel-simulation>, <https://mlsysbook.ai/taxonomy/concept/mlsys.action-tokenization>, <https://mlsysbook.ai/taxonomy/concept/mlsys.cross-embodiment-training>, <https://mlsysbook.ai/taxonomy/concept/mlsys.dual-rate-hierarchical-policy> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.requirements> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "System requirements"@en ;
  taxmeta:entryTerm "acceptance criteria"@en ;
  taxmeta:entryTerm "non-functional requirements"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Measurable desired behavior and constraints for a specified workload."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.metrics> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.slo> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.placement> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.service-level-agreement> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.baseline> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Baseline"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "A reference method or system used to justify the value of a proposed change."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.benchmark> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.online-experiment> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.proxy-objective> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Proxy objective"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "A measurable target used in place of the outcome actually desired."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.requirements> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.reward-hacking> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.slo> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Service-level objective"@en ;
  taxmeta:entryTerm "SLO"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "A target for a defined service measure over a specified population and window."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.slo-goodput> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.error-budget> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.latency-budget> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.workload> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Workload characterization"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "The input, request, model, and execution distributions that a system must support."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.capacity-planning> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.workload-trace> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.agentic-workload> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.placement> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Execution placement"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "The choice of where system components execute, such as device, edge, or datacenter."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.tail-latency> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.data-quality> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Data quality"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Fitness of recorded examples for the intended task, including validity, coverage, and error."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.generalization> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.data-acquisition> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Data acquisition and sampling"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "The observation and selection process that determines which examples and populations enter a dataset."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.evaluation-split> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.distribution-shift> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.features> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Feature engineering"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Constructing model inputs whose semantics and availability match the task."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.point-in-time> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.missing-data> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Missing data"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Absent observations whose pattern and treatment can change learned behavior."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.features> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.train-serve-skew> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.leakage> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Data leakage"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Information unavailable at the intended prediction boundary entering development or evaluation."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.metrics> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.point-in-time> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Point-in-time correctness"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Constructing examples using only information available at their stated prediction time."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.leakage> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.data-ingestion> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.lineage> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Data lineage"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Recorded dependencies that identify the sources and transformations of a dataset or artifact."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.data-dependency> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.data-versioning> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.train-serve-skew> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Training-serving skew"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "A mismatch between the data transformations or feature semantics used in training and serving."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.generalization> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.data-selection> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Data selection"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Allocating learning effort to examples according to value, coverage, and acquisition cost."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.generalization> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.deduplication> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Dataset deduplication"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Finding and managing exact or near-duplicate examples within a corpus and overlaps with evaluation data to control sample weighting, redundant compute, memorization, and contamination."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.data-selection> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.benchmark-contamination> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.training-data-extraction> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.embeddings> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Embeddings"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Vector representations of tokens, items, or inputs, learned or constructed, whose dimension and lookup or encoder implementation determine storage and computation costs."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-capacity> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.distribution-shift> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Distribution shift"@en ;
  taxmeta:entryTerm "dataset shift"@en ;
  taxmeta:entryTerm "covariate shift"@en ;
  taxmeta:entryTerm "label shift"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "A difference between development and deployment data-generating distributions."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.calibration> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.compounding-error> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.offline-rl> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.linear-model> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Linear models"@en ;
  taxmeta:entryTerm "logistic regression"@en ;
  taxmeta:entryTerm "linear regression"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Models whose score is linear in their supplied features, with a possible output link function."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.features> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.model-artifact> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.tree-ensemble> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.feature-cross> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.tree-ensemble> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Tree ensembles"@en ;
  taxmeta:entryTerm "gradient-boosted decision trees"@en ;
  taxmeta:entryTerm "GBDT"@en ;
  taxmeta:entryTerm "random forest"@en ;
  taxmeta:entryTerm "XGBoost"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Collections of decision trees whose branch traversal and aggregation determine predictions."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.model-artifact> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.features> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.kernel-method> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Kernel methods"@en ;
  taxmeta:entryTerm "support vector machine"@en ;
  taxmeta:entryTerm "SVM"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Models that score an input by a kernel similarity to retained training examples or to an explicit feature approximation, so storage and evaluation cost grow with the number of retained examples unless the kernel is approximated."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.model-artifact> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-footprint> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.inductive-bias> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.nearest-neighbor> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Nearest-neighbor models"@en ;
  taxmeta:entryTerm "k-nearest neighbors"@en ;
  taxmeta:entryTerm "kNN"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Predictions or retrieval based on similarity to stored examples or vectors."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.ann> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.model-artifact> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.embeddings> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.neural-network> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Neural networks"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Parameterized compositions of differentiable operations used to learn representations and predictions."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.autodiff> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.model-artifact> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.matrix-multiply> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.inductive-bias> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Inductive bias"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Structural assumptions that favor some learned functions over others."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.generalization> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.attention> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Attention"@en ;
  taxmeta:entryTerm "self-attention"@en ;
  taxmeta:entryTerm "multi-head attention"@en ;
  taxmeta:entryTerm "cross-attention"@en ;
  taxmeta:entryTerm "scaled dot-product attention"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Input-dependent aggregation of value vectors using query-key compatibility scores."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.position-encoding> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.kv-cache> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.position-encoding> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Position encoding"@en ;
