_:statement450 a rdf:Statement ;
  dct:identifier "rel.model-extraction.evasion"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.model-extraction> ;
  rdf:predicate mlsys:enables ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.evasion> ;
  rdfs:label "enables transfer attacks for"@en ;
  taxmeta:condition "When adversarial inputs crafted against the extracted surrogate transfer to the deployed model."@en .

_:statement451 a rdf:Statement ;
