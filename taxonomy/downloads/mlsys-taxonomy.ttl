  rdfs:label "requires"@en ;
  taxmeta:condition "Retrying an operation with external effects is safe only when the operation is idempotent or deduplicated."@en .

_:statement428 a rdf:Statement ;
  dct:identifier "rel.circuit-breaker.retry-backoff"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.circuit-breaker> ;
