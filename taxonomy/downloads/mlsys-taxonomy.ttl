_:statement452 a rdf:Statement ;
  dct:identifier "rel.artifact-signing.model-artifact"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.artifact-signing> ;
  rdf:predicate mlsys:measures ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.model-artifact> ;
