  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.arithmetic-intensity> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.activation-function> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.dispatch> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Host dispatch overhead"@en ;
  taxmeta:entryTerm "kernel launch overhead"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
