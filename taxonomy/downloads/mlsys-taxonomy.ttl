  skos:prefLabel "Data locality"@en ;
  taxmeta:entryTerm "temporal locality"@en ;
  taxmeta:entryTerm "spatial locality"@en ;
  taxmeta:entryTerm "data reuse"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Reuse of data near its consumers across time or execution locations."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.arithmetic-intensity> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.data-movement-energy> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.tiling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Tiling"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Partitioning computation so working data can be reused within a chosen storage level."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.locality> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.profiling> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Profiling"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Measuring execution to attribute time, work, stalls, and resource use."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.utilization> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.execution-time> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.bottleneck-analysis> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.execution-trace> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-footprint> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.stragglers> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.hardware-performance-counters> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.execution-time> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Execution time"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Elapsed time for a specified execution boundary, workload, and operating condition."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.tail-latency> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.serial-fraction> a skos:Concept ;
