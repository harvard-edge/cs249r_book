  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "The number of examples contributing to an optimization update or microstep."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.optimizer> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.learning-rate-schedule> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.contrastive-learning> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.bound-regime> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.training-state> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Training state"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "The parameters, gradients, optimizer variables, and other state needed to continue training."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.checkpoint> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.activation-recompute> a skos:Concept ;
