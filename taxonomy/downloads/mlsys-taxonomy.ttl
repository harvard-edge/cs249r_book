  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.backdoor> ;
  rdf:predicate mlsys:uses ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.poisoning> ;
