  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.arithmetic-intensity> ;
  rdfs:label "lowers"@en ;
  taxmeta:condition "Fewer operations per output come with less data reuse, so memory-bound depthwise layers may not speed up in proportion to the FLOP reduction."@en .

_:statement424 a rdf:Statement ;
  dct:identifier "rel.efficiency-frontier.metrics"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.efficiency-frontier> ;
  rdf:predicate mlsys:requires ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.metrics> ;
  rdfs:label "is defined only for stated"@en ;
  taxmeta:condition "A frontier is defined only for a stated quality metric, cost measure, and target platform."@en .

_:statement425 a rdf:Statement ;
