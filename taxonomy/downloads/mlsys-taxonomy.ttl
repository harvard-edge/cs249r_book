  skos:prefLabel "Tokenization"@en ;
  taxmeta:entryTerm "subword tokenization"@en ;
  taxmeta:entryTerm "BPE"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Mapping text into vocabulary-dependent token identifiers, which sets sequence lengths and so influences context usage, embedding size, and processing cost."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.attention> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.embeddings> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.context> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.perplexity> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.loss> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Training loss"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "A computable criterion optimized on training examples."@en .

<https://mlsysbook.ai/taxonomy/concept/mlsys.autodiff> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Automatic differentiation"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
