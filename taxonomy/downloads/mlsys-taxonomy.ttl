_:statement441 a rdf:Statement ;
  dct:identifier "rel.blast-radius.failure-domain"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.failure-domain> ;
  rdf:predicate mlsys:limits ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.blast-radius> ;
  rdfs:label "bounds"@en ;
  taxmeta:condition "When isolation between failure domains holds, so a fault does not propagate across shared dependencies."@en .

_:statement442 a rdf:Statement ;
  dct:identifier "rel.game-day.incident-response"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.game-day> ;
