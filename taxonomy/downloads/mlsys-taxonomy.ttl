  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.training-state> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.gradient-compression> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.gang-scheduling> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.all-reduce> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.hybrid-parallel> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.state-sharding> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.tensor-parallel> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Tensor parallelism"@en ;
  taxmeta:entryTerm "intra-layer model parallelism"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Partitioning a layer's tensors and operations across devices so each computes a slice, reducing per-device state while adding communication along the partitioned dimensions, usually within a fast scale-up domain."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.collectives> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.matrix-multiply> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.reduce-scatter-all-gather> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.hybrid-parallel> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-footprint> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.tpot> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.pipeline-parallel> a skos:Concept ;
  skos:inScheme <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:prefLabel "Pipeline parallelism"@en ;
  taxmeta:entryTerm "inter-layer model parallelism"@en ;
  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Partitioning a computation into stages that process different microbatches concurrently."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.pipeline-bubble> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.memory-footprint> ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.hybrid-parallel> .

<https://mlsysbook.ai/taxonomy/concept/mlsys.state-sharding> a skos:Concept ;
