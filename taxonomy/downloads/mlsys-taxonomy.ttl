  skos:historyNote "Added in 0.1-draft."@en ;
  skos:topConceptOf <https://mlsysbook.ai/taxonomy/scheme> ;
  skos:definition "Measuring behavior separately on relevant populations, conditions, or workload groups."@en ;
  skos:related <https://mlsysbook.ai/taxonomy/concept/mlsys.fairness> ;
