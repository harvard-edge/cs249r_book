_:statement429 a rdf:Statement ;
  dct:identifier "rel.replication-failover.availability"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.replication-failover> ;
  rdf:predicate mlsys:increases ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.availability> ;
  rdfs:label "raises"@en ;
  taxmeta:condition "When replica failures are independent and failover completes faster than the outage it masks."@en .

_:statement430 a rdf:Statement ;
  dct:identifier "rel.failure-domain.replication-failover"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.failure-domain> ;
  rdf:predicate mlsys:limits ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.replication-failover> ;
  rdfs:label "limits the protection of"@en ;
  taxmeta:condition "When replicas share a failure domain, a single cause can take out all of them together."@en .

_:statement431 a rdf:Statement ;
  dct:identifier "rel.mtbf.checkpoint-interval"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.mtbf> ;
  rdf:predicate mlsys:determines ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.checkpoint-interval> ;
  rdfs:label "determines"@en ;
  taxmeta:condition "Under approximately exponential failure times, where the optimal interval scales with the square root of checkpoint cost times MTBF."@en .

_:statement432 a rdf:Statement ;
  dct:identifier "rel.mtbf.availability"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.mtbf> ;
  rdf:predicate mlsys:increases ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.availability> ;
  rdfs:label "raises"@en ;
  taxmeta:condition "For a repairable component in steady state, availability is approximately MTBF divided by MTBF plus mean time to repair."@en .

_:statement433 a rdf:Statement ;
  dct:identifier "rel.checkpoint-interval.training-goodput"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.checkpoint-interval> ;
  rdf:predicate mlsys:determines ;
  rdf:object <https://mlsysbook.ai/taxonomy/concept/mlsys.training-goodput> ;
  rdfs:label "maximizes, when well chosen,"@en ;
  taxmeta:condition "Under a stated MTBF and checkpoint write cost, the interval trades checkpoint overhead against expected lost work."@en .

_:statement434 a rdf:Statement ;
  dct:identifier "rel.async-checkpointing.checkpoint-interval"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.async-checkpointing> ;
