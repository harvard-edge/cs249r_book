_:statement423 a rdf:Statement ;
  dct:identifier "rel.depthwise-separable-convolution.arithmetic-intensity"@en ;
  rdf:subject <https://mlsysbook.ai/taxonomy/concept/mlsys.depthwise-separable-convolution> ;
