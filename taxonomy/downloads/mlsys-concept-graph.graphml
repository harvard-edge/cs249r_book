    <edge id="e0" source="mlsys.requirements" target="mlsys.metrics"><data key="relation">determines</data><data key="statement">sets acceptance thresholds for</data><data key="conditions">The operational outcome, evaluation population, and threshold must be declared.</data></edge>
    <edge id="e1" source="mlsys.requirements" target="mlsys.slo"><data key="relation">determines</data><data key="statement">sets targets for</data><data key="conditions">Service targets are part of the stated deployment requirements.</data></edge>
    <edge id="e2" source="mlsys.baseline" target="mlsys.benchmark"><data key="relation">part-of</data><data key="statement">is the reference point within</data><data key="conditions">The baseline must be measured using the same protocol.</data></edge>
    <edge id="e3" source="mlsys.proxy-objective" target="mlsys.requirements"><data key="relation">measures</data><data key="statement">stands in for, and can diverge from,</data><data key="conditions">Improving a measurable proxy need not improve the intended outcome.</data></edge>
    <edge id="e4" source="mlsys.workload" target="mlsys.capacity-planning"><data key="relation">determines</data><data key="statement">determines resource demand for</data><data key="conditions">Sizing must include input and request distributions, not just a representative average.</data></edge>
    <edge id="e5" source="mlsys.placement" target="mlsys.tail-latency"><data key="relation">determines</data><data key="statement">changes attainable</data><data key="conditions">Communication paths, locality, and available service resources depend on placement.</data></edge>
    <edge id="e6" source="mlsys.data-quality" target="mlsys.generalization"><data key="relation">limits</data><data key="statement">bounds achievable</data><data key="conditions">The effect depends on task, coverage, errors, and the learning procedure.</data></edge>
    <edge id="e7" source="mlsys.labels" target="mlsys.loss"><data key="relation">determines</data><data key="statement">determines the reliability of the supervision in</data><data key="conditions">For supervised learning; label errors change the optimization signal.</data></edge>
    <edge id="e8" source="mlsys.missing-data" target="mlsys.features"><data key="relation">determines</data><data key="statement">forces imputation and indicator decisions in</data><data key="conditions">Treatment must preserve the meaning and availability of inputs.</data></edge>
    <edge id="e9" source="mlsys.features" target="mlsys.point-in-time"><data key="relation">requires</data><data key="statement">must preserve</data><data key="conditions">For predictions whose inputs become available over time.</data></edge>
    <edge id="e10" source="mlsys.leakage" target="mlsys.metrics"><data key="relation">determines</data><data key="statement">can invalidate</data><data key="conditions">When evaluation uses information unavailable at the intended prediction boundary.</data></edge>
    <edge id="e11" source="mlsys.point-in-time" target="mlsys.leakage"><data key="relation">mitigates</data><data key="statement">prevents</data><data key="conditions">Only when source availability and temporal joins are modeled correctly.</data></edge>
    <edge id="e12" source="mlsys.artifact-version" target="mlsys.lineage"><data key="relation">enables</data><data key="statement">records the dependencies behind</data><data key="conditions">Provenance must identify versions and transformations sufficient for reconstruction.</data></edge>
    <edge id="e13" source="mlsys.train-serve-skew" target="mlsys.generalization"><data key="relation">reduces</data><data key="statement">can degrade deployed</data><data key="conditions">A deployed pipeline may compute different inputs from those used in development.</data></edge>
    <edge id="e14" source="mlsys.deduplication" target="mlsys.data-selection"><data key="relation">part-of</data><data key="statement">is a curation stage of</data><data key="conditions">Removing duplicates changes sample weights and must preserve required coverage.</data></edge>
