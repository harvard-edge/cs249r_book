    <edge id="e123" source="mlsys.imitation-learning" target="mlsys.distribution-shift"><data key="relation">causes</data><data key="statement">induces compounding state-distribution shift</data><data key="conditions">Policy actions change the states visited relative to demonstration data.</data></edge>
    <edge id="e124" source="mlsys.model-artifact" target="mlsys.memory-capacity"><data key="relation">requires</data><data key="statement">must be resident within</data><data key="conditions">Residency can include parameters, tree structure, support vectors, or stored examples, depending on the model.</data></edge>
    <edge id="e125" source="mlsys.linear-model" target="mlsys.model-artifact"><data key="relation">determines</data><data key="statement">determines the contents of</data><data key="conditions">Feature transforms and output rules are part of the execution contract.</data></edge>
    <edge id="e126" source="mlsys.tree-ensemble" target="mlsys.model-artifact"><data key="relation">determines</data><data key="statement">determines the contents of</data><data key="conditions">Tree structures, thresholds, leaf values, and aggregation rules require storage and compatible execution.</data></edge>
    <edge id="e127" source="mlsys.kernel-method" target="mlsys.model-artifact"><data key="relation">determines</data><data key="statement">determines the size of</data><data key="conditions">Support vectors or an explicit approximation affect the stored state and evaluation cost.</data></edge>
    <edge id="e128" source="mlsys.nearest-neighbor" target="mlsys.model-artifact"><data key="relation">determines</data><data key="statement">determines the contents of</data><data key="conditions">Stored vectors, metadata, and optional indexes contribute capacity and search cost.</data></edge>
    <edge id="e129" source="mlsys.failure-model" target="mlsys.consensus"><data key="relation">limits</data><data key="statement">bounds the guarantees of</data><data key="conditions">Fault classes, membership, quorum availability, and timing assumptions bound the agreement claim.</data></edge>
    <edge id="e130" source="mlsys.failure-model" target="mlsys.checkpoint"><data key="relation">determines</data><data key="statement">determines the recovery requirements for</data><data key="conditions">Recovery semantics must cover the faults and state dependencies actually assumed.</data></edge>
    <edge id="e131" source="mlsys.backpressure" target="mlsys.arrival-rate"><data key="relation">limits</data><data key="statement">limits offered</data><data key="conditions">The signal must reach producers in time and avoid shifting overload into unbounded buffers.</data></edge>
    <edge id="e132" source="mlsys.privacy" target="mlsys.privacy-leakage"><data key="relation">limits</data><data key="statement">bounds acceptable</data><data key="conditions">Risk depends on the information, recipient, purpose, consent, and declared protections.</data></edge>
    <edge id="e133" source="mlsys.roofline" target="mlsys.execution-time"><data key="relation">limits</data><data key="statement">implies a lower bound on</data><data key="conditions">For fixed arithmetic work, a throughput ceiling implies a lower execution-time bound. Additional overheads can lengthen actual runtime.</data></edge>
    <edge id="e134" source="mlsys.execution-time" target="mlsys.tail-latency"><data key="relation">increases</data><data key="statement">contributes to</data><data key="conditions">Execution contributes to each request latency; component quantiles cannot generally be added to obtain an end-to-end quantile.</data></edge>
    <edge id="e135" source="mlsys.memory-capacity" target="mlsys.batching"><data key="relation">limits</data><data key="statement">limits feasible</data><data key="conditions">Model state, request state, intermediates, and allocator overhead must fit for the selected execution strategy.</data></edge>
    <edge id="e136" source="mlsys.metrics" target="mlsys.generalization"><data key="relation">measures</data><data key="statement">measure</data><data key="conditions">The metric, sampling protocol, and target distribution determine what the estimate means.</data></edge>
    <edge id="e137" source="mlsys.metrics" target="mlsys.rollout"><data key="relation">determines</data><data key="statement">gate advancement during</data><data key="conditions">Release criteria and populations must be specified before interpreting candidate results.</data></edge>
    <edge id="e138" source="mlsys.monitoring" target="mlsys.metrics"><data key="relation">measures</data><data key="statement">tracks deployed</data><data key="conditions">Observed task metrics can be delayed, biased, or unavailable; system health alone does not establish task quality.</data></edge>
    <edge id="e139" source="mlsys.data-parallel" target="mlsys.training-state"><data key="relation">increases</data><data key="statement">replicates, multiplying the total footprint of,</data><data key="conditions">Conventional replicated data parallelism keeps model and update state at each worker; ZeRO and hybrid strategies shard selected components.</data></edge>
    <edge id="e140" source="mlsys.tensor-parallel" target="mlsys.matrix-multiply"><data key="relation">uses</data><data key="statement">partitions</data><data key="conditions">For tensor decompositions whose operand and reduction partitions require compatible communication and layout.</data></edge>
    <edge id="e141" source="mlsys.profiling" target="mlsys.execution-time"><data key="relation">measures</data><data key="statement">measures observed</data><data key="conditions">Measurement boundaries, instrumentation, and workload determine the observation; a sample is not a universal time bound.</data></edge>
    <edge id="e142" source="mlsys.fairness" target="mlsys.decision-policy"><data key="relation">limits</data><data key="statement">constrains acceptable</data><data key="conditions">The protected populations, outcome criterion, operating conditions, and trade-offs must be stated; one criterion does not establish all fairness goals.</data></edge>
    <edge id="e143" source="mlsys.threat-model" target="mlsys.robustness-evaluation"><data key="relation">determines</data><data key="statement">selects attack cases for</data><data key="conditions">Tests exercise a declared adversary and interface; passing selected attacks does not establish universal robustness.</data></edge>
    <edge id="e144" source="mlsys.failure-model" target="mlsys.incident-response"><data key="relation">limits</data><data key="statement">bounds planned recovery in</data><data key="conditions">A design's recovery guarantees are limited to its declared faults and assumptions; operations may also encounter unmodeled incidents.</data></edge>
    <edge id="e145" source="mlsys.feedback-control" target="mlsys.state-estimation"><data key="relation">uses</data><data key="statement">uses estimated state from</data><data key="conditions">For controllers using estimated state, uncertainty and observation timing matter; other output-feedback designs need not reconstruct full state.</data></edge>
    <edge id="e146" source="mlsys.dynamics" target="mlsys.feedback-control"><data key="relation">determines</data><data key="statement">governs the plant response to</data><data key="conditions">The closed-loop response depends on the plant, disturbances, constraints, sensing, and controller implementation.</data></edge>
    <edge id="e147" source="mlsys.runtime-assurance" target="mlsys.state-estimation"><data key="relation">uses</data><data key="statement">relies on qualified</data><data key="conditions">State-dependent checks need valid observation timing and error bounds; the guarantee remains conditional on those premises.</data></edge>
    <edge id="e148" source="mlsys.operating-domain" target="mlsys.robustness-evaluation"><data key="relation">determines</data><data key="statement">scopes the relevant conditions for</data><data key="conditions">The intended domain identifies relevant stresses and coupled corners, but finite selected tests do not exhaust continuous operating conditions.</data></edge>
    <edge id="e149" source="mlsys.service-capacity" target="mlsys.slo-goodput"><data key="relation">limits</data><data key="statement">bounds sustainable</data><data key="conditions">Only for matching work units, counting boundary, workload, operating state, and horizon. A measured throughput is not a universal capacity ceiling.</data></edge>
    <edge id="e150" source="mlsys.energy" target="mlsys.unit-cost"><data key="relation">increases</data><data key="statement">adds monetary cost to</data><data key="conditions">Convert energy through the applicable tariff or cost model; do not add it again when already included in cloud or facility charges.</data></edge>
    <edge id="e151" source="mlsys.irreversible-effects" target="mlsys.rollback"><data key="relation">limits</data><data key="statement">can prevent full reversal by</data><data key="conditions">Restoring software or configuration cannot necessarily undo physical, informational, financial, or human consequences already caused.</data></edge>
    <edge id="e152" source="mlsys.irreversible-effects" target="mlsys.compensation"><data key="relation">limits</data><data key="statement">can remain after</data><data key="conditions">A remedy may address an obligation or consequence without restoring the original world state.</data></edge>
    <edge id="e153" source="mlsys.runtime-assurance" target="mlsys.irreversible-effects"><data key="relation">mitigates</data><data key="statement">can gate prospective</data><data key="conditions">Only when the mechanism mediates the relevant pre-actuation path with sufficient timing and authority. Detection can occur after an effect, and fallback can itself be irreversible.</data></edge>
    <edge id="e154" source="mlsys.privacy-leakage" target="mlsys.irreversible-effects"><data key="relation">causes</data><data key="statement">can create</data><data key="conditions">Disclosed information may be copied or retained outside the system's control, so subsequent deletion cannot guarantee full retraction.</data></edge>
    <edge id="e155" source="mlsys.human-oversight" target="mlsys.authorization"><data key="relation">limits</data><data key="statement">can constrain</data><data key="conditions">People need usable evidence, sufficient time, and effective authority; a nominal approval step alone does not establish meaningful control.</data></edge>
    <edge id="e156" source="mlsys.neural-network" target="mlsys.model-artifact"><data key="relation">determines</data><data key="statement">determines the contents of</data><data key="conditions">Execution requires compatible parameters, operators, and configuration. Training state can include additional data not needed for inference.</data></edge>
    <edge id="e157" source="mlsys.metrics" target="mlsys.hallucination"><data key="relation">measures</data><data key="statement">can assess support for</data><data key="conditions">For tasks requiring factual or source-grounded assertions, evaluate support in addition to fluency or schema validity; not every task has the same truth criterion.</data></edge>
    <edge id="e158" source="mlsys.dataset-storage-layout" target="mlsys.data-ingestion"><data key="relation">determines</data><data key="statement">sets the I/O required by</data><data key="conditions">Effects depend on access pattern, projection/filtering, encoding, storage medium, and caching; a layout does not guarantee higher throughput.</data></edge>
    <edge id="e159" source="mlsys.schema-evolution" target="mlsys.data-contract"><data key="relation">requires</data><data key="statement">requires compatibility rules in</data><data key="conditions">Contracts must identify producers/consumers, field meaning, allowed changes, defaults, and migration expectations; format-supported changes need not preserve application semantics.</data></edge>
    <edge id="e160" source="mlsys.data-ingestion" target="mlsys.backpressure"><data key="relation">uses</data><data key="statement">applies, under overload,</data><data key="conditions">When record arrival exceeds sustainable processing capacity and the source permits slowing producers; sources that cannot be slowed need buffering or shedding instead.</data></edge>
    <edge id="e161" source="mlsys.point-in-time" target="mlsys.data-ingestion"><data key="relation">requires</data><data key="statement">requires event-time-preserving</data><data key="conditions">When downstream features or evaluation depend on event-time correctness, ingestion/availability timestamps and late-data policies must be retained; arrival order alone is insufficient.</data></edge>
    <edge id="e162" source="mlsys.integration-testing" target="mlsys.test-oracle"><data key="relation">requires</data><data key="statement">requires expectations from a</data><data key="conditions">The oracle may be partial, probabilistic, or human-assisted and only covers declared properties and tested cases.</data></edge>
    <edge id="e163" source="mlsys.integration-testing" target="mlsys.train-serve-skew"><data key="relation">detects</data><data key="statement">can expose</data><data key="conditions">Tests compare relevant preprocessing and model interfaces across representative paths; untested distributions or deployment differences can remain.</data></edge>
    <edge id="e164" source="mlsys.integration-testing" target="mlsys.dependency-environment"><data key="relation">measures</data><data key="statement">tests compatibility within</data><data key="conditions">Test environments must represent the target packages, binaries, resources, and configuration; passing one environment does not validate all others.</data></edge>
    <edge id="e165" source="mlsys.failure-model" target="mlsys.failure-injection"><data key="relation">determines</data><data key="statement">selects candidate scenarios for</data><data key="conditions">Injected faults instantiate selected assumptions; realistic timing, combinations, observation criteria, and containment must be declared.</data></edge>
    <edge id="e166" source="mlsys.failure-injection" target="mlsys.incident-response"><data key="relation">measures</data><data key="statement">exercises</data><data key="conditions">A controlled scenario can test detection and response paths; success does not demonstrate preparedness for every incident.</data></edge>
    <edge id="e167" source="mlsys.failure-injection" target="mlsys.test-oracle"><data key="relation">requires</data><data key="statement">requires observable acceptance criteria from</data><data key="conditions">Criteria may evaluate latency, error rates, recovery behavior, or invariants; injecting a fault without assessing outcomes is not sufficient evidence.</data></edge>
    <edge id="e168" source="mlsys.experiment-reproducibility" target="mlsys.dependency-environment"><data key="relation">requires</data><data key="statement">requires a pinned</data><data key="conditions">Package identity alone is insufficient: hardware, data, seeds, nondeterministic operations, external services, and acceptance criteria may also matter.</data></edge>
    <edge id="e169" source="mlsys.artifact-version" target="mlsys.experiment-reproducibility"><data key="relation">enables</data><data key="statement">identifies the exact inputs for</data><data key="conditions">Reproduction requires resolvable versions and the execution procedure/environment; version labels alone do not reproduce results.</data></edge>
    <edge id="e170" source="mlsys.workflow-orchestration" target="mlsys.lineage"><data key="relation">produces</data><data key="statement">can record execution evidence as</data><data key="conditions">Only when actual input/output artifacts, parameters, steps, and execution identities are captured; orchestration alone does not establish complete provenance.</data></edge>
    <edge id="e171" source="mlsys.workflow-orchestration" target="mlsys.idempotency"><data key="relation">requires</data><data key="statement">requires retry-safe steps through</data><data key="conditions">When steps can be retried after ambiguous completion, repeated external effects need explicit handling; idempotency is one option rather than a universal orchestration guarantee.</data></edge>
    <edge id="e172" source="mlsys.benchmark" target="mlsys.experiment-reproducibility"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">The benchmark protocol must state tolerances, repetitions, environment, and workload; reproducibility does not establish external validity.</data></edge>
    <edge id="e173" source="mlsys.memory-hierarchy" target="mlsys.locality"><data key="relation">enables</data><data key="statement">provides storage levels for</data><data key="conditions">The algorithm, placement, and implementation determine which levels actually serve an access; effective rates depend on contention and access pattern.</data></edge>
    <edge id="e174" source="mlsys.host-device-interconnect" target="mlsys.execution-time"><data key="relation">increases</data><data key="statement">can add transfer delay to</data><data key="conditions">When the measured execution boundary includes traffic crossing the host-device path, transport, topology, contention, reuse, and overlap determine its contribution; fully hidden transfers need not increase end-to-end time.</data></edge>
    <edge id="e175" source="mlsys.accelerator-execution-architecture" target="mlsys.matrix-multiply"><data key="relation">determines</data><data key="statement">constrains supported mappings of</data><data key="conditions">Operations, data types, shapes, and implementation must match the execution resources; peak throughput is not achieved throughput.</data></edge>
    <edge id="e176" source="mlsys.power-delivery" target="mlsys.compute-throughput"><data key="relation">limits</data><data key="statement">constrains feasible operating points for</data><data key="conditions">Supply limits, voltage integrity, and platform power management can constrain sustained execution; power is distinct from energy.</data></edge>
    <edge id="e177" source="mlsys.thermal-dynamics" target="mlsys.execution-time"><data key="relation">increases</data><data key="statement">can increase</data><data key="conditions">When thermal controls reduce frequency or service rate or suspend operation, a cold unloaded timing measurement need not characterize sustained or shared operation.</data></edge>
    <edge id="e178" source="mlsys.thermal-dynamics" target="mlsys.energy"><data key="relation">increases</data><data key="statement">adds cooling overhead to</data><data key="conditions">The system boundary and cooling overhead must be stated; carbon conclusions additionally require energy mix and lifecycle assumptions.</data></edge>
    <edge id="e179" source="mlsys.sli" target="mlsys.slo"><data key="relation">part-of</data><data key="statement">is the measured quantity in</data><data key="conditions">The indicator's population, window, and aggregation must match the objective's.</data></edge>
    <edge id="e180" source="mlsys.slo" target="mlsys.error-budget"><data key="relation">determines</data><data key="statement">sets the size of</data><data key="conditions">The objective is stated as a fraction over a defined window.</data></edge>
    <edge id="e181" source="mlsys.error-budget" target="mlsys.rollout"><data key="relation">determines</data><data key="statement">paces</data><data key="conditions">Teams agree to slow or halt changes when the remaining budget is exhausted.</data></edge>
    <edge id="e182" source="mlsys.latency-budget" target="mlsys.tail-latency"><data key="relation">limits</data><data key="statement">allocates permitted</data><data key="conditions">Stage latencies compose along a request path whose end-to-end target is fixed.</data></edge>
    <edge id="e183" source="mlsys.flop-accounting" target="mlsys.arithmetic-intensity"><data key="relation">measures</data><data key="statement">supplies the operation and byte counts for</data><data key="conditions">Operation and byte counts are taken at the same memory boundary.</data></edge>
    <edge id="e184" source="mlsys.memory-capacity" target="mlsys.memory-footprint"><data key="relation">limits</data><data key="statement">caps</data><data key="conditions">All resident state is counted at its peak, including runtime buffers.</data></edge>
    <edge id="e185" source="mlsys.capacity-planning" target="mlsys.workload-trace"><data key="relation">uses</data><data key="statement">grounds demand estimates in</data><data key="conditions">The trace is representative of the arrival, size, and mix distribution being provisioned for.</data></edge>
    <edge id="e186" source="mlsys.flop-accounting" target="mlsys.workload"><data key="relation">measures</data><data key="statement">estimates the operations and bytes of</data><data key="conditions">Model shapes and input sizes are known.</data></edge>
    <edge id="e187" source="mlsys.cost-sensitive-decision" target="mlsys.decision-policy"><data key="relation">determines</data><data key="statement">sets thresholds in</data><data key="conditions">Error costs and class priors can be stated for the deployment context.</data></edge>
    <edge id="e188" source="mlsys.pareto-frontier" target="mlsys.requirements"><data key="relation">limits</data><data key="statement">bounds the non-dominated trade-offs available to</data><data key="conditions">Two or more objectives are measured on the same workload and cannot all be optimized at once.</data></edge>
    <edge id="e189" source="mlsys.transformer" target="mlsys.attention"><data key="relation">uses</data><data key="statement">is built from</data><data key="conditions">The architecture uses attention layers interleaved with feed-forward blocks.</data></edge>
    <edge id="e190" source="mlsys.recommendation-model" target="mlsys.embeddings"><data key="relation">uses</data><data key="statement">is dominated by lookups in</data><data key="conditions">Categorical features are encoded through large embedding tables.</data></edge>
    <edge id="e191" source="mlsys.diffusion-model" target="mlsys.execution-time"><data key="relation">increases</data><data key="statement">multiplies by sampling step count</data><data key="conditions">Generation runs the denoising network once per sampling step.</data></edge>
    <edge id="e192" source="mlsys.convolution" target="mlsys.arithmetic-intensity"><data key="relation">increases</data><data key="statement">typically raises</data><data key="conditions">Filters are reused across many spatial positions within one kernel.</data></edge>
    <edge id="e193" source="mlsys.recurrence" target="mlsys.serial-fraction"><data key="relation">increases</data><data key="statement">adds sequential dependence to</data><data key="conditions">Each step depends on the previous hidden state, preventing parallelism across time steps.</data></edge>
    <edge id="e194" source="mlsys.normalization-layer" target="mlsys.numerical-stability"><data key="relation">increases</data><data key="statement">improves</data><data key="conditions">Activation statistics would otherwise drift with depth or batch composition.</data></edge>
    <edge id="e195" source="mlsys.mixture-of-experts" target="mlsys.active-parameters"><data key="relation">reduces</data><data key="statement">reduces relative to total parameters</data><data key="conditions">Each token is routed to only a small subset of experts.</data></edge>
    <edge id="e196" source="mlsys.mixture-of-experts" target="mlsys.memory-capacity"><data key="relation">requires</data><data key="statement">still requires storing all experts within</data><data key="conditions">Every expert must be resident somewhere in the system even if inactive for a token.</data></edge>
    <edge id="e197" source="mlsys.expert-routing" target="mlsys.all-to-all"><data key="relation">determines</data><data key="statement">determines token traffic in</data><data key="conditions">Experts are placed on different devices from the tokens routed to them.</data></edge>
    <edge id="e198" source="mlsys.expert-capacity" target="mlsys.expert-routing"><data key="relation">limits</data><data key="statement">bounds assignments made by</data><data key="conditions">A fixed per-expert buffer is allocated per batch.</data></edge>
    <edge id="e199" source="mlsys.load-balancing-loss" target="mlsys.expert-routing"><data key="relation">determines</data><data key="statement">regularizes toward balance</data><data key="conditions">The auxiliary loss weight is large enough to counter router collapse without dominating the task loss.</data></edge>
    <edge id="e200" source="mlsys.active-parameters" target="mlsys.flop-accounting"><data key="relation">determines</data><data key="statement">determines per-token compute in</data><data key="conditions">Compute is counted for the experts actually activated rather than all stored parameters.</data></edge>
    <edge id="e201" source="mlsys.early-exit" target="mlsys.execution-time"><data key="relation">reduces</data><data key="statement">reduces average, and makes input-dependent,</data><data key="conditions">Exit criteria differ across inputs, so latency varies with input difficulty.</data></edge>
    <edge id="e202" source="mlsys.context" target="mlsys.kv-cache"><data key="relation">increases</data><data key="statement">scales the size of</data><data key="conditions">Autoregressive decoding retains keys and values for every prior position.</data></edge>
    <edge id="e203" source="mlsys.sliding-window-attention" target="mlsys.context"><data key="relation">enables</data><data key="statement">makes longer contexts more affordable by reducing attention cost over</data><data key="conditions">The attention pattern reduces attended query-key pairs relative to dense attention; linear cost requires bounded attended positions per query, and quality on long-range tasks may change.</data></edge>
    <edge id="e204" source="mlsys.linear-attention" target="mlsys.kv-cache"><data key="relation">reduces</data><data key="statement">replaces with a fixed-size state</data><data key="conditions">The attention kernel is approximated by a feature map that permits a recurrent formulation.</data></edge>
    <edge id="e205" source="mlsys.state-space-model" target="mlsys.recurrence"><data key="relation">uses</data><data key="statement">updates its state through</data><data key="conditions">When the state update runs step by step at inference.</data></edge>
    <edge id="e206" source="mlsys.grouped-query-attention" target="mlsys.kv-cache"><data key="relation">reduces</data><data key="statement">reduces the size of</data><data key="conditions">Fewer key-value heads are stored than query heads.</data></edge>
    <edge id="e207" source="mlsys.context-extension" target="mlsys.position-encoding"><data key="relation">uses</data><data key="statement">rescales or interpolates</data><data key="conditions">The model uses a position encoding, such as rotary embeddings, that can be rescaled or interpolated.</data></edge>
    <edge id="e208" source="mlsys.weight-serialization" target="mlsys.model-artifact"><data key="relation">part-of</data><data key="statement">persists the parameters of</data><data key="conditions">The artifact's weights are persisted for later loading.</data></edge>
    <edge id="e209" source="mlsys.model-exchange-format" target="mlsys.compilation"><data key="relation">enables</data><data key="statement">provides input to</data><data key="conditions">The target runtime or compiler supports the exchanged operator set.</data></edge>
    <edge id="e210" source="mlsys.model-export" target="mlsys.model-exchange-format"><data key="relation">produces</data><data key="statement">can emit</data><data key="conditions">The program's operators and control flow are expressible in the format.</data></edge>
    <edge id="e211" source="mlsys.integration-testing" target="mlsys.model-signature"><data key="relation">measures</data><data key="statement">checks callers against</data><data key="conditions">Callers and the artifact agree on input and output names, types, and shapes.</data></edge>
    <edge id="e212" source="mlsys.ridge-point" target="mlsys.bound-regime"><data key="relation">determines</data><data key="statement">separates</data><data key="conditions">Throughput and bandwidth ceilings are measured for the same device and memory level.</data></edge>
    <edge id="e213" source="mlsys.prefill-decode" target="mlsys.bound-regime"><data key="relation">determines</data><data key="statement">classifies prefill as compute-bound and decode as memory-bound in</data><data key="conditions">Prefill processes many tokens per weight read while decode processes few.</data></edge>
    <edge id="e214" source="mlsys.data-movement-energy" target="mlsys.energy"><data key="relation">increases</data><data key="statement">often dominates</data><data key="conditions">Operands are fetched from off-chip memory rather than reused locally.</data></edge>
    <edge id="e215" source="mlsys.locality" target="mlsys.data-movement-energy"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">Reused data is served from nearer, lower-energy storage levels.</data></edge>
    <edge id="e216" source="mlsys.amdahls-law" target="mlsys.serial-fraction"><data key="relation">uses</data><data key="statement">parameterizes</data><data key="conditions">The unaccelerated fraction is measured on the same workload as the speedup.</data></edge>
    <edge id="e217" source="mlsys.amdahls-law" target="mlsys.strong-scaling"><data key="relation">limits</data><data key="statement">bounds speedup under</data><data key="conditions">Problem size is fixed while resources grow.</data></edge>
    <edge id="e218" source="mlsys.stragglers" target="mlsys.parallel-efficiency"><data key="relation">reduces</data><data key="statement">reduce</data><data key="conditions">Workers synchronize so the slowest determines step time.</data></edge>
    <edge id="e219" source="mlsys.collectives" target="mlsys.parallel-efficiency"><data key="relation">reduces</data><data key="statement">can reduce</data><data key="conditions">Communication time is exposed rather than overlapped with computation.</data></edge>
    <edge id="e220" source="mlsys.littles-law" target="mlsys.arrival-rate"><data key="relation">uses</data><data key="statement">relates system occupancy to</data><data key="conditions">The system is stable and averages are taken over a long window.</data></edge>
    <edge id="e221" source="mlsys.latency-throughput-curve" target="mlsys.slo-goodput"><data key="relation">determines</data><data key="statement">locates the maximum load meeting</data><data key="conditions">Latency is measured at the percentile the objective specifies.</data></edge>
    <edge id="e222" source="mlsys.arrival-burstiness" target="mlsys.queueing"><data key="relation">increases</data><data key="statement">increases</data><data key="conditions">Mean utilization is held fixed while inter-arrival variability grows.</data></edge>
    <edge id="e223" source="mlsys.compute-optimal-allocation" target="mlsys.scaling-laws"><data key="relation">requires</data><data key="statement">is derived from</data><data key="conditions">The fitted law is used within the range of model and data sizes it was fit on.</data></edge>
    <edge id="e224" source="mlsys.compute-optimal-allocation" target="mlsys.training-compute-estimate"><data key="relation">uses</data><data key="statement">uses</data><data key="conditions">Dense models are trained where the six-operations-per-parameter-per-token approximation holds.</data></edge>
