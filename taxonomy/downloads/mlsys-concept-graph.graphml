    <edge id="e1595" source="mlsys.admission" target="mlsys.metastable-failure"><data key="relation">mitigates</data><data key="statement">sheds the excess load that sustains</data><data key="conditions">When early rejection lowers admitted load below the degraded system's recovery threshold long enough to break the feedback loop.</data></edge>
    <edge id="e1596" source="mlsys.fan-out-tail-amplification" target="mlsys.tail-latency"><data key="relation">increases</data><data key="statement">raises</data><data key="conditions">When completion waits for all subrequests and their slow events are not perfectly coincident.</data></edge>
