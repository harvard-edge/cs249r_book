    <edge id="e1568" source="mlsys.prompt-injection" target="mlsys.confused-deputy"><data key="relation">causes</data><data key="statement">can steer a privileged agent into</data><data key="conditions">When injected instructions induce a privileged agent to perform an action the untrusted party was not authorized to request.</data></edge>
