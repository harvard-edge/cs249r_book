    <edge id="e1603" source="mlsys.dual-rate-hierarchical-policy" target="mlsys.vla-model"><data key="relation">uses</data><data key="statement">queries, as its slow high-level layer,</data><data key="conditions">When the slow layer is a vision-language-action model.</data></edge>
