    <edge id="e330" source="mlsys.lora" target="mlsys.peft"><data key="relation">specializes</data><data key="statement">is an instance of</data><data key="conditions">Always; LoRA restricts updates to low-rank added matrices.</data></edge>
    <edge id="e331" source="mlsys.supervised-fine-tuning" target="mlsys.catastrophic-forgetting"><data key="relation">causes</data><data key="statement">can cause</data><data key="conditions">Holds when fine-tuning data are narrow relative to pretraining and no replay or regularization is used.</data></edge>
    <edge id="e332" source="mlsys.reward-model" target="mlsys.rlhf"><data key="relation">part-of</data><data key="statement">supplies the training signal in</data><data key="conditions">Holds for RLHF pipelines that learn a reward model from human comparisons.</data></edge>
    <edge id="e333" source="mlsys.rlhf" target="mlsys.reward-hacking"><data key="relation">causes</data><data key="statement">is exposed to</data><data key="conditions">Holds when the policy optimizes a learned reward beyond the region where it tracks human preference; a reference-model penalty reduces but does not remove it.</data></edge>
    <edge id="e334" source="mlsys.rlvr" target="mlsys.verifier"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">Rewards are only as reliable as the programmatic checker; exploitable checkers produce reward hacking.</data></edge>
    <edge id="e335" source="mlsys.weight-sync" target="mlsys.policy-staleness"><data key="relation">determines</data><data key="statement">frequency determines</data><data key="conditions">Holds when rollout workers continue generating between synchronizations.</data></edge>
    <edge id="e336" source="mlsys.policy-staleness" target="mlsys.training-instability"><data key="relation">causes</data><data key="statement">can induce</data><data key="conditions">Holds when the update rule assumes on-policy data and lag is not corrected by importance weighting or clipping.</data></edge>
    <edge id="e337" source="mlsys.online-learning" target="mlsys.feedback-loop"><data key="relation">determines</data><data key="statement">shortens the cycle of</data><data key="conditions">Holds when the model's own predictions influence the data it next learns from.</data></edge>
    <edge id="e338" source="mlsys.incremental-training" target="mlsys.retraining"><data key="relation">implements</data><data key="statement">is one way to carry out</data><data key="conditions">When warm-started training produces the replacement for a deployed model.</data></edge>
    <edge id="e339" source="mlsys.experience-replay" target="mlsys.catastrophic-forgetting"><data key="relation">mitigates</data><data key="statement">mitigates</data><data key="conditions">Effectiveness depends on buffer size and how representative stored examples are of earlier tasks.</data></edge>
    <edge id="e340" source="mlsys.memory-capacity" target="mlsys.on-device-training"><data key="relation">limits</data><data key="statement">constrains</data><data key="conditions">Holds on devices whose memory cannot hold full activations and optimizer state, forcing sparse or partial updates.</data></edge>
    <edge id="e341" source="mlsys.cross-validation" target="mlsys.statistical-uncertainty"><data key="relation">reduces</data><data key="statement">reduces variance of estimates under</data><data key="conditions">Holds for i.i.d. data; temporal or grouped data need splits that respect dependence.</data></edge>
    <edge id="e342" source="mlsys.sequential-testing" target="mlsys.online-experiment"><data key="relation">enables</data><data key="statement">enables valid early stopping of</data><data key="conditions">Holds when the analysis uses a sequential procedure; repeated peeking at fixed-horizon tests inflates false positives.</data></edge>
    <edge id="e343" source="mlsys.experiment-interference" target="mlsys.online-experiment"><data key="relation">limits</data><data key="statement">can bias estimates from</data><data key="conditions">Holds when units share resources, markets, or networks, so treatment of one unit affects others.</data></edge>
    <edge id="e344" source="mlsys.conformal-prediction" target="mlsys.selective-prediction"><data key="relation">enables</data><data key="statement">provides coverage-calibrated sets for</data><data key="conditions">Prediction sets inform an abstention rule; ordinary marginal coverage under exchangeability does not automatically guarantee coverage under distribution shift or conditional accuracy among accepted predictions.</data></edge>
    <edge id="e345" source="mlsys.slice-discovery" target="mlsys.sliced-evaluation"><data key="relation">enables</data><data key="statement">proposes slices for</data><data key="conditions">Discovered slices require human review for coherence and multiple-comparison effects.</data></edge>
    <edge id="e346" source="mlsys.llm-judge" target="mlsys.human-evaluation"><data key="relation">requires</data><data key="statement">must be calibrated against</data><data key="conditions">Holds whenever model-graded scores are used as evidence; judges show position, length, and self-preference biases.</data></edge>
    <edge id="e347" source="mlsys.pass-at-k" target="mlsys.best-of-n"><data key="relation">limits</data><data key="statement">upper-bounds accuracy of</data><data key="conditions">Best-of-n reaches pass@n only with a perfect selector; real verifiers lose part of the gap.</data></edge>
    <edge id="e348" source="mlsys.statistical-uncertainty" target="mlsys.pairwise-preference-eval"><data key="relation">limits</data><data key="statement">bounds the ranking resolution of</data><data key="conditions">Holds because rankings from finite pairwise votes carry sampling error that can reorder close models.</data></edge>
    <edge id="e349" source="mlsys.benchmark-contamination" target="mlsys.leakage"><data key="relation">specializes</data><data key="statement">is a form of</data><data key="conditions">Holds when evaluation items or near-duplicates appear in training corpora; detection needs overlap checks against training data.</data></edge>
    <edge id="e350" source="mlsys.deduplication" target="mlsys.benchmark-contamination"><data key="relation">mitigates</data><data key="statement">reduces</data><data key="conditions">Holds when deduplication is run against evaluation sets, not only within the training corpus.</data></edge>
    <edge id="e351" source="mlsys.time-to-train" target="mlsys.benchmark"><data key="relation">part-of</data><data key="statement">is the headline metric of a training</data><data key="conditions">Holds for training benchmarks that fix model, dataset, and quality target under run rules.</data></edge>
    <edge id="e352" source="mlsys.inference-load-scenario" target="mlsys.tail-latency"><data key="relation">limits</data><data key="statement">sets the latency-percentile constraint on</data><data key="conditions">Holds for server-style scenarios that report throughput only at a stated latency percentile.</data></edge>
    <edge id="e353" source="mlsys.metamorphic-testing" target="mlsys.test-oracle"><data key="relation">implements</data><data key="statement">substitutes output relations for a missing</data><data key="conditions">Holds when a valid metamorphic relation between inputs and outputs is known.</data></edge>
    <edge id="e354" source="mlsys.production-readiness" target="mlsys.release-gate"><data key="relation">determines</data><data key="statement">supplies criteria for</data><data key="conditions">Holds when rubric items are converted into automated or reviewed checks.</data></edge>
    <edge id="e355" source="mlsys.tail-latency" target="mlsys.online-inference"><data key="relation">measures</data><data key="statement">is the judging metric of</data><data key="conditions">Holds for user-facing request paths with latency targets.</data></edge>
    <edge id="e356" source="mlsys.model-server" target="mlsys.batching"><data key="relation">uses</data><data key="statement">hosts</data><data key="conditions">Holds for servers that queue concurrent requests to batch them on shared accelerators.</data></edge>
    <edge id="e357" source="mlsys.multi-model-serving" target="mlsys.cold-start"><data key="relation">increases</data><data key="statement">increases exposure to load-time</data><data key="conditions">Holds when more models than fit in memory share resources, so infrequently used models must be loaded on demand.</data></edge>
    <edge id="e358" source="mlsys.model-cascade" target="mlsys.unit-cost"><data key="relation">reduces</data><data key="statement">can reduce</data><data key="conditions">Holds when most requests are resolved by cheap models and the escalation criterion is reliable.</data></edge>
    <edge id="e359" source="mlsys.model-cascade" target="mlsys.selective-prediction"><data key="relation">requires</data><data key="statement">relies on</data><data key="conditions">Each stage must abstain and defer when confidence is low; poorly calibrated scores misroute requests.</data></edge>
    <edge id="e360" source="mlsys.slo" target="mlsys.latency-budget"><data key="relation">determines</data><data key="statement">sets the total allocated by</data><data key="conditions">Holds when the end-to-end SLO is decomposed into per-stage targets that sum within it.</data></edge>
    <edge id="e361" source="mlsys.prefill-decode" target="mlsys.ttft"><data key="relation">determines</data><data key="statement">prefill phase dominates</data><data key="conditions">Holds when queueing delay is small relative to prompt processing time.</data></edge>
    <edge id="e362" source="mlsys.memory-bandwidth" target="mlsys.tpot"><data key="relation">limits</data><data key="statement">bounds</data><data key="conditions">Holds in decode at small batch, where each step reads weights and KV cache with low arithmetic intensity.</data></edge>
    <edge id="e363" source="mlsys.hedged-requests" target="mlsys.tail-latency"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">Holds when slow responses come from replica-specific variability and the extra load from duplicates is small.</data></edge>
    <edge id="e364" source="mlsys.continuous-batching" target="mlsys.batching"><data key="relation">specializes</data><data key="statement">specializes</data><data key="conditions">Applies to iterative generation, where requests finish at different steps.</data></edge>
    <edge id="e365" source="mlsys.continuous-batching" target="mlsys.slo-goodput"><data key="relation">increases</data><data key="statement">increases</data><data key="conditions">Holds when KV memory admits enough concurrent sequences; interference between prefill and decode can raise latency.</data></edge>
    <edge id="e366" source="mlsys.load-balancing" target="mlsys.prefix-cache"><data key="relation">determines</data><data key="statement">determines hit rate of</data><data key="conditions">Holds when cached prefixes are replica-local, so cache-aware routing raises reuse but can unbalance load.</data></edge>
    <edge id="e367" source="mlsys.cold-start" target="mlsys.autoscaling"><data key="relation">limits</data><data key="statement">bounds the reaction time of</data><data key="conditions">When new replicas must load large weights before serving, so scaling must anticipate demand rather than follow it.</data></edge>
    <edge id="e368" source="mlsys.chunked-prefill" target="mlsys.tpot"><data key="relation">reduces</data><data key="statement">reduces decode stalls in</data><data key="conditions">Holds when long prefills would otherwise stall decode iterations of co-batched requests; it can raise TTFT for the long prompt.</data></edge>
    <edge id="e369" source="mlsys.pd-disaggregation" target="mlsys.prefill-decode"><data key="relation">determines</data><data key="statement">provisions separate resources for each phase of</data><data key="conditions">Pays off when interference between phases costs more than transferring KV state between pools.</data></edge>
    <edge id="e370" source="mlsys.pd-disaggregation" target="mlsys.slo-goodput"><data key="relation">increases</data><data key="statement">can increase</data><data key="conditions">Holds when TTFT and TPOT targets would otherwise force over-provisioning of a colocated deployment.</data></edge>
    <edge id="e371" source="mlsys.constrained-decoding" target="mlsys.grammar"><data key="relation">implements</data><data key="statement">enforces</data><data key="conditions">The constraint representation is supported, enforcement is compatible with the tokenizer, and generation completes successfully.</data></edge>
    <edge id="e372" source="mlsys.output-validation" target="mlsys.constrained-decoding"><data key="relation">alternative-to</data><data key="statement">is a post-generation alternative for structural checks to</data><data key="conditions">For the same expressible structural constraint, checking after generation can substitute for enforcing it during generation; other checks may still follow constrained decoding.</data></edge>
    <edge id="e373" source="mlsys.self-consistency" target="mlsys.sampling-controls"><data key="relation">requires</data><data key="statement">requires sampling diversity from</data><data key="conditions">For the sampled-reasoning-path procedure, diversity comes from stochastic decoding; repeated deterministic greedy generation with the same model and prompt produces the same path.</data></edge>
    <edge id="e374" source="mlsys.reasoning-budget" target="mlsys.tail-latency"><data key="relation">increases</data><data key="statement">larger budgets increase</data><data key="conditions">Holds because generated reasoning length varies widely across requests and adds decode steps.</data></edge>
    <edge id="e375" source="mlsys.verifier" target="mlsys.best-of-n"><data key="relation">limits</data><data key="statement">precision bounds the gains of</data><data key="conditions">Holds as n grows, since selection pressure increasingly exploits verifier errors.</data></edge>
    <edge id="e376" source="mlsys.process-reward-model" target="mlsys.verifier"><data key="relation">specializes</data><data key="statement">is a step-level form of</data><data key="conditions">Requires step-level labels or estimates of step correctness.</data></edge>
    <edge id="e377" source="mlsys.inference-time-search" target="mlsys.process-reward-model"><data key="relation">uses</data><data key="statement">uses for pruning</data><data key="conditions">Holds for searches that score partial solutions before completion.</data></edge>
    <edge id="e378" source="mlsys.test-time-scaling" target="mlsys.scaling-laws"><data key="relation">specializes</data><data key="statement">extends to inference compute</data><data key="conditions">Holds within task families where extra samples or reasoning steps improve accuracy; gains saturate and vary by difficulty.</data></edge>
    <edge id="e379" source="mlsys.test-time-scaling" target="mlsys.unit-cost"><data key="relation">determines</data><data key="statement">sets the quality gained per unit of</data><data key="conditions">Holds whenever additional per-query compute is billed or consumes shared serving capacity.</data></edge>
    <edge id="e380" source="mlsys.rag" target="mlsys.hallucination"><data key="relation">mitigates</data><data key="statement">can reduce</data><data key="conditions">Holds when retrieved passages are relevant and the model grounds its claims in them; irrelevant retrievals can mislead.</data></edge>
    <edge id="e381" source="mlsys.rag" target="mlsys.retrieval"><data key="relation">requires</data><data key="statement">depends on</data><data key="conditions">Generation quality is bounded by retrieval recall for the facts the answer needs.</data></edge>
    <edge id="e382" source="mlsys.dense-retrieval" target="mlsys.ann"><data key="relation">uses</data><data key="statement">uses at scale</data><data key="conditions">Holds when the collection is too large for exact similarity search within latency limits.</data></edge>
    <edge id="e383" source="mlsys.lexical-retrieval" target="mlsys.dense-retrieval"><data key="relation">alternative-to</data><data key="statement">is a complementary alternative to</data><data key="conditions">Lexical matching handles rare terms and exact identifiers that embeddings may miss; hybrid systems combine both scores.</data></edge>
    <edge id="e384" source="mlsys.reranking" target="mlsys.retrieval"><data key="relation">part-of</data><data key="statement">is the precision stage of</data><data key="conditions">Holds when first-stage recall is adequate and reranker cost fits the latency budget.</data></edge>
    <edge id="e385" source="mlsys.model-conversion" target="mlsys.quantization"><data key="relation">uses</data><data key="statement">often applies</data><data key="conditions">Holds for integer-only targets; converted models must be re-evaluated because numerics change.</data></edge>
    <edge id="e386" source="mlsys.memory-capacity" target="mlsys.on-device-runtime"><data key="relation">limits</data><data key="statement">constrains</data><data key="conditions">Holds on microcontrollers and mobile devices where weights, activations, and runtime must fit in limited RAM and flash.</data></edge>
    <edge id="e387" source="mlsys.ota-model-update" target="mlsys.rollout"><data key="relation">uses</data><data key="statement">applies staged exposure from</data><data key="conditions">Holds for device fleets where updates are staged by cohort and devices may be offline.</data></edge>
    <edge id="e388" source="mlsys.device-cloud-partitioning" target="mlsys.placement"><data key="relation">specializes</data><data key="statement">is a form of</data><data key="conditions">Holds when part of the computation can run on either side of a network link.</data></edge>
    <edge id="e389" source="mlsys.device-heterogeneity" target="mlsys.model-conversion"><data key="relation">increases</data><data key="statement">multiplies targets and effort for</data><data key="conditions">Holds when devices differ in supported operators, precision, or accelerators.</data></edge>
    <edge id="e390" source="mlsys.model-registry" target="mlsys.artifact-version"><data key="relation">implements</data><data key="statement">stores and governs</data><data key="conditions">Holds when every deployable model is registered with its lineage and stage.</data></edge>
    <edge id="e391" source="mlsys.shadow-deployment" target="mlsys.rollout"><data key="relation">part-of</data><data key="statement">is the zero-exposure stage before</data><data key="conditions">Holds when candidate outputs can be compared without user exposure; shadowing cannot measure effects of users reacting to the new model.</data></edge>
    <edge id="e392" source="mlsys.ml-ci-cd" target="mlsys.release-gate"><data key="relation">implements</data><data key="statement">automates</data><data key="conditions">Holds when gate criteria are machine-checkable; some require human review.</data></edge>
    <edge id="e393" source="mlsys.release-gate" target="mlsys.rollout"><data key="relation">determines</data><data key="statement">controls advancement of</data><data key="conditions">Holds when each rollout stage has predeclared pass criteria.</data></edge>
    <edge id="e394" source="mlsys.drift-detection" target="mlsys.distribution-shift"><data key="relation">detects</data><data key="statement">detects</data><data key="conditions">Holds for shifts visible in monitored statistics; detected drift need not degrade quality, and some harmful shifts are not detected.</data></edge>
    <edge id="e395" source="mlsys.inference-logging" target="mlsys.privacy-leakage"><data key="relation">causes</data><data key="statement">can increase exposure to</data><data key="conditions">Holds when logs retain personal inputs or outputs without redaction, access control, or retention limits.</data></edge>
    <edge id="e396" source="mlsys.alerting" target="mlsys.incident-response"><data key="relation">part-of</data><data key="statement">initiates</data><data key="conditions">Holds when alerts are actionable; excessive alerting degrades response through fatigue.</data></edge>
    <edge id="e397" source="mlsys.retraining" target="mlsys.concept-drift"><data key="relation">mitigates</data><data key="statement">mitigates, given fresh labels,</data><data key="conditions">Holds because input monitoring alone cannot reveal changed input-target relations; updated outcomes are needed.</data></edge>
    <edge id="e398" source="mlsys.continuous-training" target="mlsys.retraining"><data key="relation">implements</data><data key="statement">automates</data><data key="conditions">Holds when data validation and release gates are automated so retrained models can be promoted without manual steps.</data></edge>
    <edge id="e399" source="mlsys.postmortem" target="mlsys.incident-response"><data key="relation">part-of</data><data key="statement">closes the loop on</data><data key="conditions">Holds when corrective actions are tracked to completion.</data></edge>
    <edge id="e400" source="mlsys.failure-attribution" target="mlsys.observability"><data key="relation">requires</data><data key="statement">depends on</data><data key="conditions">Distinguishing data, model, and infrastructure causes requires versioned, correlated signals from each layer.</data></edge>
    <edge id="e401" source="mlsys.configuration-management" target="mlsys.technical-debt"><data key="relation">reduces</data><data key="statement">reduces configuration</data><data key="conditions">Holds when configuration is reviewed, tested, and versioned like code.</data></edge>
    <edge id="e402" source="mlsys.infrastructure-as-code" target="mlsys.dependency-environment"><data key="relation">determines</data><data key="statement">declares and reproduces</data><data key="conditions">Holds when declarations pin versions and are applied without manual drift.</data></edge>
    <edge id="e403" source="mlsys.ml-platform" target="mlsys.technical-debt"><data key="relation">reduces</data><data key="statement">can amortize</data><data key="conditions">Holds when many teams adopt shared components; a poorly maintained platform becomes debt itself.</data></edge>
    <edge id="e404" source="mlsys.undeclared-consumers" target="mlsys.feedback-loop"><data key="relation">causes</data><data key="statement">can create hidden</data><data key="conditions">Holds when unknown consumers act on model outputs in ways that change future training data.</data></edge>
    <edge id="e405" source="mlsys.entanglement" target="mlsys.technical-debt"><data key="relation">increases</data><data key="statement">is a source of</data><data key="conditions">Holds for models where inputs interact, so isolated changes have non-local effects.</data></edge>
    <edge id="e406" source="mlsys.continuous-training" target="mlsys.mlops-maturity"><data key="relation">part-of</data><data key="statement">is a defining capability of higher levels of</data><data key="conditions">Holds for maturity models that define levels by degree of pipeline automation.</data></edge>
    <edge id="e407" source="mlsys.ml-roles" target="mlsys.ml-platform"><data key="relation">determines</data><data key="statement">assigns ownership of</data><data key="conditions">Holds in organizations large enough to separate platform engineering from model development.</data></edge>
    <edge id="e408" source="mlsys.undeclared-consumers" target="mlsys.model-deprecation"><data key="relation">limits</data><data key="statement">can block or break</data><data key="conditions">Holds when consumers cannot be identified and migrated before the model is removed.</data></edge>
    <edge id="e409" source="mlsys.artifact-archival" target="mlsys.experiment-reproducibility"><data key="relation">enables</data><data key="statement">preserves</data><data key="conditions">Holds when archives include data references, environments, and configuration as well as weights.</data></edge>
    <edge id="e410" source="mlsys.data-retention" target="mlsys.privacy"><data key="relation">implements</data><data key="statement">implements requirements of</data><data key="conditions">Holds when retention limits apply to raw data, logs, and derived artifacts such as features and models.</data></edge>
    <edge id="e411" source="mlsys.data-retention" target="mlsys.artifact-archival"><data key="relation">trades-off</data><data key="statement">trades off against</data><data key="conditions">Holds when audit or reproduction needs conflict with deletion obligations.</data></edge>
    <edge id="e412" source="mlsys.model-flops-utilization" target="mlsys.utilization"><data key="relation">specializes</data><data key="statement">specializes</data><data key="conditions">Holds when utilization is defined as model-required FLOPs per second over aggregate peak FLOP rate, excluding recomputed work.</data></edge>
    <edge id="e413" source="mlsys.roofline" target="mlsys.model-flops-utilization"><data key="relation">limits</data><data key="statement">bounds attainable</data><data key="conditions">For a given kernel mix, attainable MFU cannot exceed the roofline bound implied by each kernel's arithmetic intensity.</data></edge>
    <edge id="e414" source="mlsys.profiling" target="mlsys.bottleneck-analysis"><data key="relation">enables</data><data key="statement">supplies evidence for</data><data key="conditions">When the profile covers the same workload, configuration, and execution boundary as the bottleneck claim.</data></edge>
    <edge id="e415" source="mlsys.bottleneck-analysis" target="mlsys.roofline"><data key="relation">uses</data><data key="statement">uses</data><data key="conditions">When the candidate bottleneck is a kernel's compute or memory-bandwidth bound rather than I/O, scheduling, or communication.</data></edge>
    <edge id="e416" source="mlsys.pruning" target="mlsys.sparsity"><data key="relation">produces</data><data key="statement">produces</data><data key="conditions">When pruning removes individual weights, leaving an irregular zero pattern whose speedup depends on sparse-execution support.</data></edge>
    <edge id="e417" source="mlsys.structured-pruning" target="mlsys.pruning"><data key="relation">specializes</data><data key="statement">specializes</data><data key="conditions">When the pruned unit is a whole channel, filter, head, or layer rather than an individual weight.</data></edge>
    <edge id="e418" source="mlsys.low-rank-factorization" target="mlsys.matrix-multiply"><data key="relation">reduces</data><data key="statement">reduces the cost of</data><data key="conditions">When weight matrices are well approximated at a rank much smaller than their dimensions and the smaller products still run efficiently.</data></edge>
    <edge id="e419" source="mlsys.quantization-aware-training" target="mlsys.quantization"><data key="relation">uses</data><data key="statement">simulates during training</data><data key="conditions">When training models the rounding of the format the model will deploy in.</data></edge>
    <edge id="e420" source="mlsys.neural-architecture-search" target="mlsys.hyperparameter-search"><data key="relation">specializes</data><data key="statement">is a structured form of</data><data key="conditions">When architectural choices are treated as a structured search space evaluated under an experiment budget.</data></edge>
    <edge id="e421" source="mlsys.hardware-aware-nas" target="mlsys.neural-architecture-search"><data key="relation">specializes</data><data key="statement">specializes</data><data key="conditions">When the search objective includes a cost measured or predicted on the target platform.</data></edge>
    <edge id="e422" source="mlsys.hardware-aware-nas" target="mlsys.execution-time"><data key="relation">reduces</data><data key="statement">optimizes measured</data><data key="conditions">When latency on the target device is measured or predicted directly, since FLOP counts can rank architectures differently from real latency.</data></edge>
    <edge id="e423" source="mlsys.depthwise-separable-convolution" target="mlsys.arithmetic-intensity"><data key="relation">reduces</data><data key="statement">lowers</data><data key="conditions">Fewer operations per output come with less data reuse, so memory-bound depthwise layers may not speed up in proportion to the FLOP reduction.</data></edge>
    <edge id="e424" source="mlsys.efficiency-frontier" target="mlsys.metrics"><data key="relation">requires</data><data key="statement">is defined only for stated</data><data key="conditions">A frontier is defined only for a stated quality metric, cost measure, and target platform.</data></edge>
    <edge id="e425" source="mlsys.model-hardware-co-design" target="mlsys.efficiency-frontier"><data key="relation">determines</data><data key="statement">can shift outward</data><data key="conditions">When model structure and hardware or kernels are designed together rather than one being fixed while the other is tuned.</data></edge>
    <edge id="e426" source="mlsys.model-hardware-co-design" target="mlsys.accelerator-execution-architecture"><data key="relation">determines</data><data key="statement">jointly specifies</data><data key="conditions">When the accelerator's dataflow, precision support, or memory hierarchy is a design variable alongside the model.</data></edge>
    <edge id="e427" source="mlsys.retry-backoff" target="mlsys.idempotency"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">Retrying an operation with external effects is safe only when the operation is idempotent or deduplicated.</data></edge>
    <edge id="e428" source="mlsys.circuit-breaker" target="mlsys.retry-backoff"><data key="relation">limits</data><data key="statement">bounds</data><data key="conditions">When the breaker's error threshold trips before retries saturate the failing dependency.</data></edge>
    <edge id="e429" source="mlsys.replication-failover" target="mlsys.availability"><data key="relation">increases</data><data key="statement">raises</data><data key="conditions">When replica failures are independent and failover completes faster than the outage it masks.</data></edge>
    <edge id="e430" source="mlsys.failure-domain" target="mlsys.replication-failover"><data key="relation">limits</data><data key="statement">limits the protection of</data><data key="conditions">When replicas share a failure domain, a single cause can take out all of them together.</data></edge>
    <edge id="e431" source="mlsys.mtbf" target="mlsys.checkpoint-interval"><data key="relation">determines</data><data key="statement">determines</data><data key="conditions">Under approximately exponential failure times, where the optimal interval scales with the square root of checkpoint cost times MTBF.</data></edge>
    <edge id="e432" source="mlsys.mtbf" target="mlsys.availability"><data key="relation">increases</data><data key="statement">raises</data><data key="conditions">For a repairable component in steady state, availability is approximately MTBF divided by MTBF plus mean time to repair.</data></edge>
    <edge id="e433" source="mlsys.checkpoint-interval" target="mlsys.training-goodput"><data key="relation">determines</data><data key="statement">maximizes, when well chosen,</data><data key="conditions">Under a stated MTBF and checkpoint write cost, the interval trades checkpoint overhead against expected lost work.</data></edge>
    <edge id="e434" source="mlsys.async-checkpointing" target="mlsys.checkpoint-interval"><data key="relation">reduces</data><data key="statement">shortens</data><data key="conditions">When the blocking snapshot to host memory costs much less than the durable write, lowering the effective checkpoint cost.</data></edge>
    <edge id="e435" source="mlsys.elastic-training" target="mlsys.checkpoint"><data key="relation">uses</data><data key="statement">resumes from</data><data key="conditions">When the job restarts on a changed worker set and state must be resharded from the latest consistent checkpoint.</data></edge>
    <edge id="e436" source="mlsys.elastic-training" target="mlsys.training-goodput"><data key="relation">increases</data><data key="statement">can raise</data><data key="conditions">When replacing failed nodes takes longer than continuing at reduced width and the optimizer tolerates the batch-size change.</data></edge>
    <edge id="e437" source="mlsys.abft" target="mlsys.silent-data-corruption"><data key="relation">detects</data><data key="statement">detects</data><data key="conditions">For linear-algebra operations whose input checksums predict output checksums, within the floating-point tolerance used for comparison.</data></edge>
    <edge id="e438" source="mlsys.gray-failure" target="mlsys.stragglers"><data key="relation">causes</data><data key="statement">can manifest as</data><data key="conditions">In synchronous distributed jobs, where one degraded but live node slows every step.</data></edge>
    <edge id="e439" source="mlsys.chaos-engineering" target="mlsys.failure-injection"><data key="relation">uses</data><data key="statement">uses</data><data key="conditions">When injected faults are framed as experiments against a stated steady-state hypothesis.</data></edge>
    <edge id="e440" source="mlsys.blast-radius" target="mlsys.chaos-engineering"><data key="relation">limits</data><data key="statement">bounds</data><data key="conditions">When experiments run against production traffic and must limit the users and components they can affect.</data></edge>
    <edge id="e441" source="mlsys.failure-domain" target="mlsys.blast-radius"><data key="relation">limits</data><data key="statement">bounds</data><data key="conditions">When isolation between failure domains holds, so a fault does not propagate across shared dependencies.</data></edge>
    <edge id="e442" source="mlsys.game-day" target="mlsys.incident-response"><data key="relation">measures</data><data key="statement">rehearses</data><data key="conditions">When the exercise uses the same detection, paging, and runbook paths as real incidents.</data></edge>
    <edge id="e443" source="mlsys.hardware-fault-injection" target="mlsys.silent-data-corruption"><data key="relation">measures</data><data key="statement">estimates model sensitivity to</data><data key="conditions">When the injected fault model, location, and rate approximate the hardware's actual failure modes.</data></edge>
    <edge id="e444" source="mlsys.backdoor" target="mlsys.poisoning"><data key="relation">uses</data><data key="statement">is commonly implanted through</data><data key="conditions">When the trigger enters through manipulated training data rather than direct weight modification.</data></edge>
    <edge id="e445" source="mlsys.supply-chain-compromise" target="mlsys.backdoor"><data key="relation">causes</data><data key="statement">can implant a</data><data key="conditions">When pretrained weights or fine-tuning data come from parties outside the defender's trust boundary.</data></edge>
    <edge id="e446" source="mlsys.jailbreak" target="mlsys.evasion"><data key="relation">specializes</data><data key="statement">specializes</data><data key="conditions">When the adversarial input is a user prompt aimed at bypassing safety training rather than at a task prediction; it differs from prompt injection, where untrusted third-party content crosses an authority boundary.</data></edge>
    <edge id="e447" source="mlsys.adversarial-training" target="mlsys.evasion"><data key="relation">mitigates</data><data key="statement">reduces success of</data><data key="conditions">Only within the perturbation set and threat model used to generate training adversaries.</data></edge>
    <edge id="e448" source="mlsys.adversarial-training" target="mlsys.generalization"><data key="relation">trades-off</data><data key="statement">trades off against clean</data><data key="conditions">Robust training typically costs clean accuracy and multiplies training compute by the cost of generating adversaries.</data></edge>
    <edge id="e449" source="mlsys.model-extraction" target="mlsys.model-artifact"><data key="relation">produces</data><data key="statement">produces a functional copy of</data><data key="conditions">When the attacker has sufficient query access and output detail, such as confidence scores, relative to model complexity.</data></edge>
    <edge id="e450" source="mlsys.model-extraction" target="mlsys.evasion"><data key="relation">enables</data><data key="statement">enables transfer attacks for</data><data key="conditions">When adversarial inputs crafted against the extracted surrogate transfer to the deployed model.</data></edge>
    <edge id="e451" source="mlsys.model-watermarking" target="mlsys.model-extraction"><data key="relation">detects</data><data key="statement">provides ownership evidence against</data><data key="conditions">When the watermark survives the adversary's fine-tuning, pruning, or distillation of the copied model.</data></edge>
    <edge id="e452" source="mlsys.artifact-signing" target="mlsys.model-artifact"><data key="relation">measures</data><data key="statement">verifies integrity of</data><data key="conditions">When consumers check signatures against trusted identities before loading and the signing key is not compromised.</data></edge>
    <edge id="e453" source="mlsys.artifact-signing" target="mlsys.lineage"><data key="relation">uses</data><data key="statement">binds provenance from</data><data key="conditions">When the signature covers provenance metadata such as training data and build inputs, not only the weight bytes.</data></edge>
    <edge id="e454" source="mlsys.unsafe-deserialization" target="mlsys.supply-chain-compromise"><data key="relation">enables</data><data key="statement">enables</data><data key="conditions">When model files in executable serialization formats are loaded from untrusted sources without a data-only format such as safetensors.</data></edge>
    <edge id="e455" source="mlsys.dependency-environment" target="mlsys.supply-chain-compromise"><data key="relation">causes</data><data key="statement">can introduce, when unpinned or unverified,</data><data key="conditions">When dependencies are resolved from mutable or unverified sources at build or load time.</data></edge>
    <edge id="e456" source="mlsys.membership-inference" target="mlsys.privacy-leakage"><data key="relation">measures</data><data key="statement">measures</data><data key="conditions">When attack advantage over a baseline is used as an empirical estimate of record-level leakage.</data></edge>
    <edge id="e457" source="mlsys.differential-privacy" target="mlsys.membership-inference"><data key="relation">limits</data><data key="statement">bounds the advantage of</data><data key="conditions">At the unit defined by the neighboring-dataset relation; the bound weakens as epsilon and delta grow.</data></edge>
    <edge id="e458" source="mlsys.model-inversion" target="mlsys.privacy-leakage"><data key="relation">causes</data><data key="statement">causes</data><data key="conditions">When outputs, confidence scores, or shared gradients carry enough information about sensitive attributes or inputs.</data></edge>
    <edge id="e459" source="mlsys.dp-sgd" target="mlsys.differential-privacy"><data key="relation">implements</data><data key="statement">implements</data><data key="conditions">When clipping norm, noise multiplier, sampling rate, and step count are tracked by a privacy accountant.</data></edge>
    <edge id="e460" source="mlsys.machine-unlearning" target="mlsys.retraining"><data key="relation">alternative-to</data><data key="statement">is a cheaper, approximate alternative to full</data><data key="conditions">Exact unlearning equals retraining without the removed records; approximate methods trade the strength of the guarantee for lower cost.</data></edge>
    <edge id="e461" source="mlsys.machine-unlearning" target="mlsys.lineage"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">To locate every model, shard, and derived artifact that was trained on the records to be removed.</data></edge>
    <edge id="e462" source="mlsys.federated-learning" target="mlsys.secure-aggregation"><data key="relation">uses</data><data key="statement">can use, to hide individual client updates,</data><data key="conditions">When enough clients participate per round that the aggregate does not reveal any single client's update.</data></edge>
    <edge id="e463" source="mlsys.secure-aggregation" target="mlsys.poisoning"><data key="relation">increases</data><data key="statement">hinders detection of, increasing exposure to</data><data key="conditions">Because the server sees only aggregated updates, it cannot inspect individual client updates for anomalies.</data></edge>
    <edge id="e464" source="mlsys.least-privilege" target="mlsys.authorization"><data key="relation">limits</data><data key="statement">constrains grants made by</data><data key="conditions">When permissions are scoped to the task and expire or are revoked when the task ends.</data></edge>
    <edge id="e465" source="mlsys.least-privilege" target="mlsys.prompt-injection"><data key="relation">mitigates</data><data key="statement">limits the consequences of</data><data key="conditions">When a model-driven component processes untrusted content and can act only through narrowly scoped credentials and tools.</data></edge>
    <edge id="e466" source="mlsys.confidential-computing" target="mlsys.isolation"><data key="relation">specializes</data><data key="statement">is a hardware-attested form of</data><data key="conditions">When the trusted execution environment's hardware and firmware are trusted and the host operator is not.</data></edge>
    <edge id="e467" source="mlsys.remote-attestation" target="mlsys.confidential-computing"><data key="relation">enables</data><data key="statement">establishes trust in</data><data key="conditions">When the verifier checks attestation evidence against reference values before releasing keys, data, or model weights.</data></edge>
    <edge id="e468" source="mlsys.side-channel" target="mlsys.isolation"><data key="relation">limits</data><data key="statement">can bypass</data><data key="conditions">When tenants share accelerators, caches, memory, or interconnect whose timing or contention is observable across the boundary.</data></edge>
    <edge id="e469" source="mlsys.operational-carbon" target="mlsys.carbon"><data key="relation">part-of</data><data key="statement">is a component of</data><data key="conditions">Lifecycle carbon sums operational and embodied components under one declared accounting boundary.</data></edge>
    <edge id="e470" source="mlsys.embodied-carbon" target="mlsys.carbon"><data key="relation">part-of</data><data key="statement">is a component of</data><data key="conditions">Lifecycle carbon sums operational and embodied components under one declared accounting boundary.</data></edge>
    <edge id="e471" source="mlsys.carbon-intensity" target="mlsys.operational-carbon"><data key="relation">increases</data><data key="statement">scales</data><data key="conditions">Operational carbon is energy consumed times the carbon intensity of supply at the time and place of consumption.</data></edge>
    <edge id="e472" source="mlsys.carbon-aware-scheduling" target="mlsys.carbon-intensity"><data key="relation">uses</data><data key="statement">exploits variation in</data><data key="conditions">When workloads are deferrable or relocatable and intensity varies materially across hours or regions.</data></edge>
    <edge id="e473" source="mlsys.carbon-aware-scheduling" target="mlsys.slo"><data key="relation">trades-off</data><data key="statement">trades off against</data><data key="conditions">When shifting work in time or place delays completion or adds latency beyond a stated objective.</data></edge>
    <edge id="e474" source="mlsys.energy-efficiency" target="mlsys.energy"><data key="relation">reduces</data><data key="statement">lowers, for a fixed amount of work,</data><data key="conditions">When useful work and energy are measured over the same system boundary and workload.</data></edge>
    <edge id="e475" source="mlsys.emission-scopes" target="mlsys.embodied-carbon"><data key="relation">determines</data><data key="statement">classifies as value-chain (Scope 3)</data><data key="conditions">For an operator buying hardware, manufacturing emissions fall in Scope 3 while purchased electricity falls in Scope 2.</data></edge>
    <edge id="e476" source="mlsys.lifecycle-assessment" target="mlsys.embodied-carbon"><data key="relation">measures</data><data key="statement">estimates</data><data key="conditions">When the assessment's goal, scope, and functional unit are stated and manufacturer data are available or proxied.</data></edge>
    <edge id="e477" source="mlsys.energy" target="mlsys.water-footprint"><data key="relation">increases</data><data key="statement">increases</data><data key="conditions">Through on-site evaporative cooling and off-site water used in electricity generation, both of which scale with energy use.</data></edge>
    <edge id="e478" source="mlsys.water-footprint" target="mlsys.carbon-aware-scheduling"><data key="relation">trades-off</data><data key="statement">can conflict with</data><data key="conditions">When low-carbon hours or regions coincide with high cooling water demand, such as hot sunny afternoons.</data></edge>
    <edge id="e479" source="mlsys.hardware-lifetime" target="mlsys.embodied-carbon"><data key="relation">reduces</data><data key="statement">amortizes, lowering per-unit-work</data><data key="conditions">When embodied emissions are attributed per year or per unit of work over the asset's service life.</data></edge>
    <edge id="e480" source="mlsys.hardware-lifetime" target="mlsys.energy-efficiency"><data key="relation">trades-off</data><data key="statement">trades off against</data><data key="conditions">Keeping older hardware saves embodied emissions and capital but forgoes newer generations' work per joule.</data></edge>
    <edge id="e481" source="mlsys.hardware-lifetime" target="mlsys.e-waste"><data key="relation">reduces</data><data key="statement">lowers the annual rate of</data><data key="conditions">For a fleet of fixed size, shorter refresh cycles retire more equipment per year.</data></edge>
    <edge id="e482" source="mlsys.tco" target="mlsys.unit-cost"><data key="relation">part-of</data><data key="statement">supplies the numerator of</data><data key="conditions">When the TCO window and the count of accepted outcomes cover the same period and system boundary.</data></edge>
    <edge id="e483" source="mlsys.hardware-lifetime" target="mlsys.tco"><data key="relation">determines</data><data key="statement">sets the amortization period in</data><data key="conditions">Capital cost enters TCO through amortization over the assumed service life.</data></edge>
    <edge id="e484" source="mlsys.cost-per-token" target="mlsys.unit-cost"><data key="relation">measures</data><data key="statement">approximates</data><data key="conditions">Only when tokens per accepted outcome are stable; longer reasoning, retries, or context resends make cheap tokens an expensive outcome.</data></edge>
    <edge id="e485" source="mlsys.batching" target="mlsys.cost-per-token"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">When larger or continuous batches raise tokens per accelerator-second without violating latency objectives.</data></edge>
    <edge id="e486" source="mlsys.model-routing" target="mlsys.calibration"><data key="relation">requires</data><data key="statement">depends on</data><data key="conditions">When routers or cascade gates escalate on predicted quality or confidence, which must be calibrated to the request distribution.</data></edge>
    <edge id="e487" source="mlsys.cost-attribution" target="mlsys.unit-cost"><data key="relation">enables</data><data key="statement">enables</data><data key="conditions">When shared spend is allocated to the workloads that produce the counted outcomes by a declared allocation rule.</data></edge>
    <edge id="e488" source="mlsys.safety-case" target="mlsys.hazard-analysis"><data key="relation">requires</data><data key="statement">argues only over hazards from</data><data key="conditions">A safety case is complete only relative to the hazards identified for its stated operating domain.</data></edge>
    <edge id="e489" source="mlsys.stpa" target="mlsys.hazard-analysis"><data key="relation">specializes</data><data key="statement">is a method of</data><data key="conditions">STPA addresses hazards from unsafe interactions and control flaws that component-failure methods can miss.</data></edge>
    <edge id="e490" source="mlsys.fmea" target="mlsys.hazard-analysis"><data key="relation">specializes</data><data key="statement">is a method of</data><data key="conditions">FMEA is bottom-up over component failures and does not by itself capture hazards without a failed component.</data></edge>
    <edge id="e491" source="mlsys.control-barrier-function" target="mlsys.safety-filter"><data key="relation">enables</data><data key="statement">provides the certificate for</data><data key="conditions">Guarantees depend on an accurate dynamics model, bounded disturbance, and a feasible filtering problem at each tick.</data></edge>
    <edge id="e492" source="mlsys.safety-filter" target="mlsys.runtime-assurance"><data key="relation">implements</data><data key="statement">implements</data><data key="conditions">The filter must run independently of, and with authority over, the component it constrains.</data></edge>
    <edge id="e493" source="mlsys.simplex-architecture" target="mlsys.runtime-assurance"><data key="relation">implements</data><data key="statement">implements</data><data key="conditions">Switching must occur while the verified controller can still recover the state.</data></edge>
    <edge id="e494" source="mlsys.simplex-architecture" target="mlsys.minimal-risk-condition"><data key="relation">uses</data><data key="statement">falls back toward</data><data key="conditions">Holds when the safety controller's goal is to reach a defined minimal-risk state rather than continue the mission.</data></edge>
    <edge id="e495" source="mlsys.stopping-envelope" target="mlsys.minimal-risk-condition"><data key="relation">limits</data><data key="statement">bounds reachability of</data><data key="conditions">A stop-type fallback is feasible only while the state remains inside its stopping envelope.</data></edge>
    <edge id="e496" source="mlsys.guardrails" target="mlsys.prompt-injection"><data key="relation">detects</data><data key="statement">partially detects</data><data key="conditions">Classifier guardrails are probabilistic and can be evaded, so they do not replace authority boundaries.</data></edge>
    <edge id="e497" source="mlsys.guardrails" target="mlsys.runtime-assurance"><data key="relation">specializes</data><data key="statement">is a content-level form of</data><data key="conditions">Applies when the safe set is a content or action policy rather than a physical state region.</data></edge>
    <edge id="e498" source="mlsys.falsification" target="mlsys.scenario-based-testing"><data key="relation">uses</data><data key="statement">searches the parameter space of</data><data key="conditions">Found counterexamples are only as realistic as the scenario model and simulator.</data></edge>
    <edge id="e499" source="mlsys.safety-case" target="mlsys.rare-event-validation"><data key="relation">uses</data><data key="statement">draws statistical evidence from</data><data key="conditions">Bounds hold for the sampled operating distribution and configuration, not for unmodeled conditions.</data></edge>
    <edge id="e500" source="mlsys.neural-network-verification" target="mlsys.formal-verification"><data key="relation">specializes</data><data key="statement">specializes</data><data key="conditions">Exact methods scale poorly with network size; bound-propagation methods trade completeness for scale.</data></edge>
    <edge id="e501" source="mlsys.neural-network-verification" target="mlsys.evasion"><data key="relation">measures</data><data key="statement">certifies absence, within a bounded region, of</data><data key="conditions">Holds only for the specified perturbation set, typically a norm ball around given inputs.</data></edge>
    <edge id="e502" source="mlsys.xil-testing" target="mlsys.sim-to-real"><data key="relation">measures</data><data key="statement">progressively tests</data><data key="conditions">Each rung adds real software, timing, or hardware but still relies on simulated or recorded environments.</data></edge>
    <edge id="e503" source="mlsys.formal-verification" target="mlsys.control-barrier-function"><data key="relation">measures</data><data key="statement">can certify</data><data key="conditions">Certification covers the barrier condition under the modeled dynamics, not the fidelity of the model.</data></edge>
    <edge id="e504" source="mlsys.goal-structuring-notation" target="mlsys.safety-case"><data key="relation">implements</data><data key="statement">expresses</data><data key="conditions">Notation makes the argument structure reviewable; it does not make the argument sound.</data></edge>
    <edge id="e505" source="mlsys.safety-performance-indicator" target="mlsys.safety-case"><data key="relation">measures</data><data key="statement">monitors validity of</data><data key="conditions">Each indicator must trace to a specific claim and have a threshold that triggers review.</data></edge>
    <edge id="e506" source="mlsys.safety-performance-indicator" target="mlsys.monitoring"><data key="relation">requires</data><data key="statement">is collected through</data><data key="conditions">Holds when field telemetry captures the events the indicator counts.</data></edge>
    <edge id="e507" source="mlsys.hazard-analysis" target="mlsys.safety-integrity-level"><data key="relation">determines</data><data key="statement">assigns</data><data key="conditions">Integrity levels derive from severity, exposure, and controllability of analyzed hazards.</data></edge>
    <edge id="e508" source="mlsys.group-fairness-metric" target="mlsys.fairness"><data key="relation">measures</data><data key="statement">measures</data><data key="conditions">A metric measures one criterion on a chosen population and grouping; other criteria remain unmeasured.</data></edge>
    <edge id="e509" source="mlsys.fairness-incompatibility" target="mlsys.group-fairness-metric"><data key="relation">limits</data><data key="statement">forces a choice among</data><data key="conditions">Holds when base rates differ across groups and the predictor is imperfect.</data></edge>
    <edge id="e510" source="mlsys.individual-fairness" target="mlsys.group-fairness-metric"><data key="relation">trades-off</data><data key="statement">can conflict with</data><data key="conditions">Holds when similarity under the task metric does not align with group membership.</data></edge>
    <edge id="e511" source="mlsys.bias-mitigation" target="mlsys.metrics"><data key="relation">trades-off</data><data key="statement">trades off against aggregate</data><data key="conditions">Reducing a disparity often lowers aggregate accuracy or shifts error to other groups or metrics.</data></edge>
    <edge id="e512" source="mlsys.feature-attribution" target="mlsys.tail-latency"><data key="relation">increases</data><data key="statement">adds to</data><data key="conditions">Holds when explanations are computed on the request path; perturbation-based methods need many extra model evaluations.</data></edge>
    <edge id="e513" source="mlsys.counterfactual-explanation" target="mlsys.contestability"><data key="relation">enables</data><data key="statement">supports</data><data key="conditions">Useful for recourse only when the suggested changes are feasible and actionable for the person.</data></edge>
    <edge id="e514" source="mlsys.interpretable-model" target="mlsys.feature-attribution"><data key="relation">alternative-to</data><data key="statement">removes the need for post-hoc</data><data key="conditions">Holds in high-stakes settings where an interpretable model reaches comparable accuracy.</data></edge>
    <edge id="e515" source="mlsys.model-card" target="mlsys.sliced-evaluation"><data key="relation">uses</data><data key="statement">reports results of</data><data key="conditions">A model card is informative only for the conditions and groups actually evaluated.</data></edge>
    <edge id="e516" source="mlsys.datasheet" target="mlsys.lineage"><data key="relation">uses</data><data key="statement">summarizes, in human-readable form, provenance from</data><data key="conditions">A datasheet summarizes provenance; machine-checkable lineage is still needed for reproducibility.</data></edge>
    <edge id="e517" source="mlsys.automation-bias" target="mlsys.human-oversight"><data key="relation">reduces</data><data key="statement">undermines</data><data key="conditions">Holds when automation is usually right, error cues are weak, and reviewers face time pressure.</data></edge>
    <edge id="e518" source="mlsys.feedback-delay" target="mlsys.authority-handover"><data key="relation">limits</data><data key="statement">bounds, through human reaction time,</data><data key="conditions">Takeover is safe only if human reaction and re-orientation time fits within the remaining safety margin.</data></edge>
    <edge id="e519" source="mlsys.contestability" target="mlsys.human-oversight"><data key="relation">part-of</data><data key="statement">extends to affected people</data><data key="conditions">Requires a channel, decision records, and authority to reverse outcomes.</data></edge>
    <edge id="e520" source="mlsys.impact-assessment" target="mlsys.ai-risk-management"><data key="relation">part-of</data><data key="statement">is part of</data><data key="conditions">Mapping risks to affected parties precedes measuring and managing them.</data></edge>
    <edge id="e521" source="mlsys.algorithmic-audit" target="mlsys.model-card"><data key="relation">uses</data><data key="statement">draws evidence from</data><data key="conditions">Audits also need access to data, code, and logs; documentation alone is insufficient evidence.</data></edge>
    <edge id="e522" source="mlsys.risk-tiered-regulation" target="mlsys.human-oversight"><data key="relation">requires</data><data key="statement">mandates for high-risk uses</data><data key="conditions">Applies to systems classified high-risk under the governing regulation.</data></edge>
    <edge id="e523" source="mlsys.risk-tiered-regulation" target="mlsys.algorithmic-audit"><data key="relation">requires</data><data key="statement">requires conformity assessment by</data><data key="conditions">Applies to high-risk categories; obligations differ by role (provider, deployer).</data></edge>
    <edge id="e524" source="mlsys.frontier-safety-framework" target="mlsys.ai-risk-management"><data key="relation">implements</data><data key="statement">is a developer's instrument for</data><data key="conditions">When a developer's published capability thresholds and commitments govern its model releases.</data></edge>
    <edge id="e525" source="mlsys.context-compaction" target="mlsys.prefix-cache"><data key="relation">trades-off</data><data key="statement">trades saved tokens against the prefix reuse lost in</data><data key="conditions">When rewriting earlier context invalidates the cached prefix, so compaction pays off only when the saved execution work over the remaining session exceeds the summarization and prefix-recompute cost.</data></edge>
    <edge id="e526" source="mlsys.context-degradation" target="mlsys.context"><data key="relation">limits</data><data key="statement">limits useful size of</data><data key="conditions">Holds even when the context fits the nominal window; strength varies by model and task.</data></edge>
    <edge id="e527" source="mlsys.agent-memory" target="mlsys.retrieval"><data key="relation">uses</data><data key="statement">is read through</data><data key="conditions">Memory recall quality is bounded by the retrieval contract and index freshness.</data></edge>
    <edge id="e528" source="mlsys.function-calling" target="mlsys.tool-contract"><data key="relation">requires</data><data key="statement">is validated against</data><data key="conditions">The harness must validate calls against the contract; schema conformance does not imply authority.</data></edge>
    <edge id="e529" source="mlsys.model-context-protocol" target="mlsys.function-calling"><data key="relation">enables</data><data key="statement">standardizes tool discovery for</data><data key="conditions">Discovering a tool through a protocol does not grant authority to use it.</data></edge>
    <edge id="e530" source="mlsys.computer-use" target="mlsys.irreversible-effects"><data key="relation">increases</data><data key="statement">raises exposure to</data><data key="conditions">GUI actions often lack typed preconditions, idempotency keys, or undo, unlike designed tool APIs.</data></edge>
    <edge id="e531" source="mlsys.computer-use" target="mlsys.prompt-injection"><data key="relation">increases</data><data key="statement">widens the surface for</data><data key="conditions">Holds when on-screen content from untrusted sources is read as part of the agent's context.</data></edge>
    <edge id="e532" source="mlsys.agent-harness" target="mlsys.trajectory"><data key="relation">produces</data><data key="statement">produces and records</data><data key="conditions">The harness, not the model, owns continuation and the authoritative trajectory record.</data></edge>
    <edge id="e533" source="mlsys.agent-budget" target="mlsys.unit-cost"><data key="relation">determines</data><data key="statement">caps per-trajectory</data><data key="conditions">Budgets cap spend per trajectory; cost per accepted task also depends on success rate.</data></edge>
    <edge id="e534" source="mlsys.approval-gate" target="mlsys.human-oversight"><data key="relation">implements</data><data key="statement">implements</data><data key="conditions">Effective only if approvals bind to the exact action and reviewers can judge it; see automation bias.</data></edge>
    <edge id="e535" source="mlsys.approval-gate" target="mlsys.irreversible-effects"><data key="relation">mitigates</data><data key="statement">guards against</data><data key="conditions">Holds when the gate is placed before dispatch of actions classified irreversible.</data></edge>
    <edge id="e536" source="mlsys.durable-execution" target="mlsys.idempotency"><data key="relation">requires</data><data key="statement">relies on</data><data key="conditions">Resuming after a crash between dispatch and record can re-issue a step, which is safe only for idempotent or deduplicated effects.</data></edge>
    <edge id="e537" source="mlsys.deterministic-replay" target="mlsys.durable-execution"><data key="relation">uses</data><data key="statement">reuses the log of</data><data key="conditions">Replay is exact only if every nondeterministic input, including model samples and tool results, was recorded.</data></edge>
    <edge id="e538" source="mlsys.suspend-resume" target="mlsys.approval-gate"><data key="relation">enables</data><data key="statement">enables long waits for</data><data key="conditions">Resumption must revalidate state and authority that may have changed during the wait.</data></edge>
    <edge id="e539" source="mlsys.suspend-resume" target="mlsys.fencing"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">Holds when a resumed worker could race a stale one that still believes it owns the trajectory.</data></edge>
    <edge id="e540" source="mlsys.multi-agent-orchestration" target="mlsys.coordination-failure"><data key="relation">causes</data><data key="statement">can introduce</data><data key="conditions">Each delegation and handoff adds a point where specification or context can be lost.</data></edge>
    <edge id="e541" source="mlsys.multi-agent-orchestration" target="mlsys.baseline"><data key="relation">uses</data><data key="statement">is justified by comparison against a single-agent</data><data key="conditions">When the orchestration's added cost is evaluated against a single agent at matched total compute or token budget.</data></edge>
    <edge id="e542" source="mlsys.shared-agent-state" target="mlsys.fencing"><data key="relation">uses</data><data key="statement">uses</data><data key="conditions">Holds when leases can expire while a slow agent still attempts writes.</data></edge>
    <edge id="e543" source="mlsys.correlated-agent-errors" target="mlsys.multi-agent-orchestration"><data key="relation">limits</data><data key="statement">limits the benefit of</data><data key="conditions">Holds when agents share a base model, prompts, or retrieved evidence.</data></edge>
    <edge id="e544" source="mlsys.sensor-fusion" target="mlsys.time-synchronization"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">Timestamp error translates to spatial error proportional to relative motion.</data></edge>
    <edge id="e545" source="mlsys.sensor-fusion" target="mlsys.sensing"><data key="relation">requires</data><data key="statement">requires extrinsic calibration from</data><data key="conditions">Fused estimates inherit calibration errors between sensor frames.</data></edge>
    <edge id="e546" source="mlsys.robot-perception" target="mlsys.observation-age"><data key="relation">increases</data><data key="statement">adds inference latency to</data><data key="conditions">Inference time adds directly to the age of the state used by planning and control.</data></edge>
    <edge id="e547" source="mlsys.recursive-filtering" target="mlsys.state-estimation"><data key="relation">implements</data><data key="statement">implements</data><data key="conditions">Kalman-family filters assume approximately Gaussian, well-modeled noise; violations make reported covariance overconfident.</data></edge>
    <edge id="e548" source="mlsys.slam" target="mlsys.state-estimation"><data key="relation">specializes</data><data key="statement">specializes</data><data key="conditions">Drift accumulates without loop closure or external references.</data></edge>
    <edge id="e549" source="mlsys.model-predictive-control" target="mlsys.world-model"><data key="relation">uses</data><data key="statement">can use as its prediction model a</data><data key="conditions">Plans exploit model errors, so performance depends on accuracy in the regions the optimizer visits.</data></edge>
    <edge id="e550" source="mlsys.motion-planning" target="mlsys.trajectory-feasibility"><data key="relation">requires</data><data key="statement">must satisfy</data><data key="conditions">Geometric planners need a later step to enforce dynamic and actuation limits.</data></edge>
    <edge id="e551" source="mlsys.model-predictive-control" target="mlsys.wcet"><data key="relation">requires</data><data key="statement">requires a solver WCET within its control period, i.e. a</data><data key="conditions">Holds when each optimization must finish within the control period; warm starts and horizon length trade quality for time.</data></edge>
    <edge id="e552" source="mlsys.model-predictive-control" target="mlsys.feedback-control"><data key="relation">specializes</data><data key="statement">is a form of</data><data key="conditions">Re-solving from each new state estimate closes the loop.</data></edge>
    <edge id="e553" source="mlsys.real-time-scheduling" target="mlsys.wcet"><data key="relation">requires</data><data key="statement">takes as input</data><data key="conditions">Schedulability results are valid only if WCET bounds hold on the deployed platform.</data></edge>
    <edge id="e554" source="mlsys.mixed-criticality" target="mlsys.runtime-assurance"><data key="relation">enables</data><data key="statement">protects the timing of</data><data key="conditions">Holds when the safety monitor shares hardware with learned components that can overrun or contend for memory.</data></edge>
    <edge id="e555" source="mlsys.mixed-criticality" target="mlsys.isolation"><data key="relation">requires</data><data key="statement">requires temporal and spatial</data><data key="conditions">Shared caches, memory controllers, and buses can break isolation that address-space separation provides.</data></edge>
    <edge id="e556" source="mlsys.vla-model" target="mlsys.observation-age"><data key="relation">increases</data><data key="statement">increases</data><data key="conditions">Holds when billion-parameter inference on robot compute runs slower than the control loop.</data></edge>
    <edge id="e557" source="mlsys.vla-model" target="mlsys.action-chunking"><data key="relation">uses</data><data key="statement">uses, to decouple control rate from inference rate,</data><data key="conditions">Chunks executed open-loop delay reaction to new observations until the next inference.</data></edge>
    <edge id="e558" source="mlsys.teleoperation-data" target="mlsys.imitation-learning"><data key="relation">enables</data><data key="statement">supplies demonstrations for</data><data key="conditions">Policy quality is bounded by demonstration coverage, consistency, and action-label timing.</data></edge>
    <edge id="e559" source="mlsys.domain-randomization" target="mlsys.sim-to-real"><data key="relation">enables</data><data key="statement">improves</data><data key="conditions">Holds when the randomized ranges cover the real parameters without making the task unlearnable.</data></edge>
    <edge id="e560" source="mlsys.thread-hierarchy" target="mlsys.simt"><data key="relation">uses</data><data key="statement">is executed through</data><data key="conditions">Warps of a thread block are scheduled together on one streaming multiprocessor.</data></edge>
    <edge id="e561" source="mlsys.memory-coalescing" target="mlsys.memory-bandwidth"><data key="relation">determines</data><data key="statement">helps determine achieved</data><data key="conditions">For global-memory accesses by a warp, coalescing reduces wasted transactions; achieved bandwidth also depends on the workload and hardware.</data></edge>
    <edge id="e562" source="mlsys.async-data-movement" target="mlsys.communication-overlap"><data key="relation">implements</data><data key="statement">applies within a device the idea of</data><data key="conditions">Loads into on-chip memory proceed while matrix units compute on the previous tile.</data></edge>
    <edge id="e563" source="mlsys.matrix-engine-programming" target="mlsys.compute-throughput"><data key="relation">enables</data><data key="statement">is required to reach peak</data><data key="conditions">Peak matrix throughput is available only to instructions with supported shapes, layouts, and precisions.</data></edge>
    <edge id="e564" source="mlsys.thread-hierarchy" target="mlsys.tiling"><data key="relation">implements</data><data key="statement">maps output tiles onto thread blocks in</data><data key="conditions">Each thread block typically computes one output tile staged through shared memory.</data></edge>
    <edge id="e565" source="mlsys.embedding-table-sharding" target="mlsys.recommendation-model"><data key="relation">enables</data><data key="statement">makes trainable</data><data key="conditions">Embedding tables exceed one device's memory and must be partitioned across devices.</data></edge>
    <edge id="e566" source="mlsys.embedding-table-sharding" target="mlsys.collectives"><data key="relation">requires</data><data key="statement">requires all-to-all</data><data key="conditions">Lookups for a batch touch rows held on other devices, so activations are exchanged.</data></edge>
    <edge id="e567" source="mlsys.parameter-server" target="mlsys.bounded-staleness"><data key="relation">uses</data><data key="statement">commonly operates under</data><data key="conditions">Workers may read parameters that lag the latest updates by a bounded number of steps.</data></edge>
    <edge id="e568" source="mlsys.latency-budget" target="mlsys.ranking-funnel"><data key="relation">limits</data><data key="statement">bounds the per-stage cost of</data><data key="conditions">Each stage receives a share of the end-to-end budget and a candidate count it can afford to score.</data></edge>
    <edge id="e569" source="mlsys.ranking-funnel" target="mlsys.ann"><data key="relation">uses</data><data key="statement">uses for candidate generation</data><data key="conditions">The first stage retrieves candidates by approximate similarity before learned ranking.</data></edge>
    <edge id="e570" source="mlsys.multimodal-model" target="mlsys.modality-encoder"><data key="relation">uses</data><data key="statement">is composed with</data><data key="conditions">Non-text inputs are encoded into tokens the shared backbone attends over.</data></edge>
    <edge id="e571" source="mlsys.encoder-disaggregation" target="mlsys.tail-latency"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">Large media inputs would otherwise block token generation for requests sharing the batch.</data></edge>
    <edge id="e572" source="mlsys.auto-parallelization" target="mlsys.hybrid-parallel"><data key="relation">produces</data><data key="statement">derives</data><data key="conditions">The compiler's cost model must reflect the target device mesh's compute and link bandwidths for the chosen plan to be competitive.</data></edge>
    <edge id="e573" source="mlsys.sharding-propagation" target="mlsys.auto-parallelization"><data key="relation">implements</data><data key="statement">implements</data><data key="conditions">Holds when users supply seed annotations and the compiler propagates layouts through operators with known sharding rules.</data></edge>
    <edge id="e574" source="mlsys.sharding-propagation" target="mlsys.collectives"><data key="relation">produces</data><data key="statement">inserts</data><data key="conditions">Collectives are inserted wherever an operator's input layouts differ from what its sharded implementation requires.</data></edge>
    <edge id="e575" source="mlsys.sharding-propagation" target="mlsys.device-mesh"><data key="relation">requires</data><data key="statement">is defined over the axes of</data><data key="conditions">Tensor dimensions are sharded over named mesh axes, so mesh shape bounds which layouts are expressible.</data></edge>
    <edge id="e576" source="mlsys.function-transformations" target="mlsys.autodiff"><data key="relation">implements</data><data key="statement">exposes as a transform</data><data key="conditions">Holds when programs are pure functions so differentiation composes with vectorization and compilation.</data></edge>
    <edge id="e577" source="mlsys.function-transformations" target="mlsys.tracing-jit"><data key="relation">requires</data><data key="statement">relies on</data><data key="conditions">For transformations implemented over a traced intermediate representation, such as JAX transformations; this is not a requirement for every transformation implementation.</data></edge>
    <edge id="e578" source="mlsys.task-actor-runtime" target="mlsys.rl-rollout"><data key="relation">enables</data><data key="statement">orchestrates</data><data key="conditions">Applies when rollout workers, trainers, and reward models run as separate stateful actors exchanging data through the runtime.</data></edge>
    <edge id="e579" source="mlsys.single-vs-multi-controller" target="mlsys.task-actor-runtime"><data key="relation">determines</data><data key="statement">is a design axis of</data><data key="conditions">A single controller simplifies heterogeneous pipelines but must keep per-step dispatch off the critical path to scale.</data></edge>
    <edge id="e580" source="mlsys.analytical-performance-model" target="mlsys.roofline"><data key="relation">uses</data><data key="statement">composes</data><data key="conditions">Per-operator roofline bounds are summed or overlapped with communication and queueing terms under stated overlap assumptions.</data></edge>
    <edge id="e581" source="mlsys.analytical-performance-model" target="mlsys.alpha-beta-model"><data key="relation">uses</data><data key="statement">composes</data><data key="conditions">Communication terms use per-collective latency and bandwidth parameters measured or specified for the target fabric.</data></edge>
    <edge id="e582" source="mlsys.model-fidelity" target="mlsys.analytical-performance-model"><data key="relation">measures</data><data key="statement">bounds trust in</data><data key="conditions">Predictions are credible only within the configurations where validation error against measurement has been reported.</data></edge>
    <edge id="e583" source="mlsys.performance-simulation" target="mlsys.analytical-performance-model"><data key="relation">alternative-to</data><data key="statement">trades speed for detail against</data><data key="conditions">Simulation captures contention and scheduling effects closed forms omit, at much higher evaluation cost per configuration.</data></edge>
    <edge id="e584" source="mlsys.post-training-quantization" target="mlsys.quantization"><data key="relation">specializes</data><data key="statement">applies</data><data key="conditions">Holds when the calibration set is representative of deployment inputs; otherwise chosen ranges misfit and accuracy drops.</data></edge>
    <edge id="e585" source="mlsys.weight-only-quantization" target="mlsys.post-training-quantization"><data key="relation">uses</data><data key="statement">is commonly produced by</data><data key="conditions">For GPTQ- and AWQ-class methods applied after training.</data></edge>
    <edge id="e586" source="mlsys.activation-outliers" target="mlsys.quantization"><data key="relation">limits</data><data key="statement">can degrade the accuracy of</data><data key="conditions">Applies to per-tensor activation quantization of large transformers; per-channel handling or scale migration mitigates it.</data></edge>
    <edge id="e587" source="mlsys.kv-cache-quantization" target="mlsys.kv-cache"><data key="relation">reduces</data><data key="statement">shrinks</data><data key="conditions">Capacity gains translate into throughput only when serving is KV-memory-bound and attention kernels read the quantized format directly.</data></edge>
    <edge id="e588" source="mlsys.nm-sparsity" target="mlsys.matrix-unit"><data key="relation">requires</data><data key="statement">requires support in</data><data key="conditions">Speedup materializes only on matrix engines with sparse-operand instructions for the specific N:M ratio.</data></edge>
    <edge id="e589" source="mlsys.nm-sparsity" target="mlsys.sparsity"><data key="relation">specializes</data><data key="statement">specializes</data><data key="conditions">Constrains sparsity to a fixed per-group pattern so hardware can index nonzeros with small metadata.</data></edge>
    <edge id="e590" source="mlsys.kv-cache-offload" target="mlsys.prefix-cache"><data key="relation">enables</data><data key="statement">increases the capacity and hit rate of</data><data key="conditions">Pays off when reload time from host or SSD is shorter than recomputing the prefix's prefill.</data></edge>
    <edge id="e591" source="mlsys.pd-disaggregation" target="mlsys.kv-cache-transfer"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">Disaggregation is profitable only when KV transfer between pools is faster than the decode-latency gain it buys.</data></edge>
    <edge id="e592" source="mlsys.compound-ai-system" target="mlsys.model-routing"><data key="relation">uses</data><data key="statement">composes</data><data key="conditions">Holds when the program chooses among models per step, so routing decisions are optimized against end-to-end quality and cost.</data></edge>
    <edge id="e593" source="mlsys.rag" target="mlsys.compound-ai-system"><data key="relation">part-of</data><data key="statement">is a common stage of</data><data key="conditions">When retrieval and generation run as separately served and tuned components.</data></edge>
    <edge id="e594" source="mlsys.lm-program-optimization" target="mlsys.compound-ai-system"><data key="relation">determines</data><data key="statement">tunes the prompts and weights of</data><data key="conditions">Requires a declared program structure and an end-to-end metric evaluable on a training set of inputs.</data></edge>
    <edge id="e595" source="mlsys.multi-adapter-serving" target="mlsys.lora"><data key="relation">uses</data><data key="statement">serves many instances of</data><data key="conditions">Holds when adapters share one frozen base model so base weights are loaded once and only low-rank factors differ per request.</data></edge>
    <edge id="e596" source="mlsys.multi-adapter-serving" target="mlsys.multi-model-serving"><data key="relation">specializes</data><data key="statement">specializes</data><data key="conditions">Applies when hosted variants differ only by adapters, letting requests for different variants share one batch.</data></edge>
    <edge id="e597" source="mlsys.graph-vector-index" target="mlsys.ann"><data key="relation">implements</data><data key="statement">implements</data><data key="conditions">Best recall-latency trade-off when the full graph and vectors fit in memory.</data></edge>
    <edge id="e598" source="mlsys.quantized-vector-index" target="mlsys.ann"><data key="relation">implements</data><data key="statement">implements</data><data key="conditions">Preferred when memory per vector is the binding constraint, accepting lower recall or a reranking pass on exact vectors.</data></edge>
    <edge id="e599" source="mlsys.quantized-vector-index" target="mlsys.graph-vector-index"><data key="relation">alternative-to</data><data key="statement">trades memory against recall versus</data><data key="conditions">Compared at equal query latency on the same corpus and recall target.</data></edge>
    <edge id="e600" source="mlsys.filtered-vector-search" target="mlsys.ann"><data key="relation">uses</data><data key="statement">commonly runs on</data><data key="conditions">When the filter leaves too many candidates for exact search.</data></edge>
    <edge id="e601" source="mlsys.graph-vector-index" target="mlsys.index-freshness"><data key="relation">limits</data><data key="statement">update and delete cost bounds attainable</data><data key="conditions">Deletes and in-place updates degrade graph connectivity unless repaired or periodically rebuilt.</data></edge>
    <edge id="e602" source="mlsys.numerical-nondeterminism" target="mlsys.experiment-reproducibility"><data key="relation">reduces</data><data key="statement">limits</data><data key="conditions">Bitwise reproducibility requires fixing kernels, reduction order, parallel layout, and hardware, not only random seeds.</data></edge>
    <edge id="e603" source="mlsys.accumulation-precision" target="mlsys.numerical-nondeterminism"><data key="relation">determines</data><data key="statement">sets the magnitude of</data><data key="conditions">Order-dependent rounding differences grow as accumulation precision falls and reduction length grows.</data></edge>
    <edge id="e604" source="mlsys.batch-invariance" target="mlsys.numerical-nondeterminism"><data key="relation">mitigates</data><data key="statement">removes the batch-composition source of</data><data key="conditions">Achieved by fixing reduction strategies independent of batch size, typically at some kernel throughput cost.</data></edge>
    <edge id="e605" source="mlsys.batch-invariance" target="mlsys.rl-rollout"><data key="relation">enables</data><data key="statement">aligns inference numerics with training for</data><data key="conditions">Matters when rollout log-probabilities from the serving engine are reused in on-policy training objectives.</data></edge>
    <edge id="e606" source="mlsys.elastic-training" target="mlsys.checkpoint-resharding"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">Holds whenever a restart changes world size or parallel layout relative to the saved checkpoint.</data></edge>
    <edge id="e607" source="mlsys.checkpoint-resharding" target="mlsys.state-sharding"><data key="relation">uses</data><data key="statement">remaps between layouts of</data><data key="conditions">Requires checkpoints that record each shard's global tensor coordinates rather than rank-local layouts.</data></edge>
    <edge id="e608" source="mlsys.batch-data-processing" target="mlsys.deduplication"><data key="relation">enables</data><data key="statement">executes at corpus scale</data><data key="conditions">Applies when the corpus exceeds one machine, so near-duplicate detection is partitioned and shuffled across workers.</data></edge>
    <edge id="e609" source="mlsys.batch-data-processing" target="mlsys.feature-backfill"><data key="relation">enables</data><data key="statement">executes</data><data key="conditions">Backfills over long histories run as bounded batch jobs whose logic must match the serving feature definition.</data></edge>
    <edge id="e610" source="mlsys.distributed-tracing" target="mlsys.observability"><data key="relation">part-of</data><data key="statement">provides request-level evidence within</data><data key="conditions">Requires trace context to be propagated across every service and asynchronous hop the request traverses.</data></edge>
    <edge id="e611" source="mlsys.llm-call-tracing" target="mlsys.distributed-tracing"><data key="relation">specializes</data><data key="statement">specializes</data><data key="conditions">Adds model-specific span attributes such as token counts, model version, and cost under a shared semantic convention.</data></edge>
    <edge id="e612" source="mlsys.llm-call-tracing" target="mlsys.agent-harness"><data key="relation">measures</data><data key="statement">instruments</data><data key="conditions">Each loop iteration, model call, and tool call is emitted as a child span of the task's root span.</data></edge>
    <edge id="e613" source="mlsys.evaluation-harness" target="mlsys.benchmark"><data key="relation">implements</data><data key="statement">implements</data><data key="conditions">Comparability holds only when prompt templates, decoding settings, and scorer versions are pinned with the results.</data></edge>
    <edge id="e614" source="mlsys.evaluation-harness" target="mlsys.experiment-tracking"><data key="relation">uses</data><data key="statement">records results into</data><data key="conditions">Holds when each run logs checkpoint, suite version, and configuration alongside scores.</data></edge>
    <edge id="e615" source="mlsys.energy-measurement" target="mlsys.energy"><data key="relation">measures</data><data key="statement">determines the reported value of</data><data key="conditions">Reported energy is comparable only across measurements with the same boundary, sensor class, and sampling rate.</data></edge>
    <edge id="e616" source="mlsys.idle-dynamic-power" target="mlsys.energy-measurement"><data key="relation">determines</data><data key="statement">sets attribution rules for</data><data key="conditions">Matters when hardware is shared or partly idle, so idle power must be charged by an explicit allocation rule.</data></edge>
    <edge id="e617" source="mlsys.he-inference" target="mlsys.confidential-computing"><data key="relation">alternative-to</data><data key="statement">trades compute overhead for hardware trust versus</data><data key="conditions">Homomorphic encryption avoids trusting server hardware but costs orders of magnitude more compute than enclave execution.</data></edge>
    <edge id="e618" source="mlsys.secure-computation-inference" target="mlsys.he-inference"><data key="relation">alternative-to</data><data key="statement">trades communication for computation versus</data><data key="conditions">Hybrid protocols use homomorphic encryption for linear layers and secret sharing or garbled circuits for nonlinear ones.</data></edge>
    <edge id="e619" source="mlsys.secure-computation-inference" target="mlsys.privacy-leakage"><data key="relation">mitigates</data><data key="statement">prevents input disclosure in</data><data key="conditions">Protects inputs during computation but not leakage from the revealed outputs themselves.</data></edge>
    <edge id="e620" source="mlsys.red-teaming" target="mlsys.jailbreak"><data key="relation">detects</data><data key="statement">discovers</data><data key="conditions">Coverage depends on attacker diversity and budget, so finding no failures does not establish their absence.</data></edge>
    <edge id="e621" source="mlsys.red-teaming" target="mlsys.threat-model"><data key="relation">requires</data><data key="statement">must be scoped by</data><data key="conditions">The adversary capabilities, interfaces, and harms probed must be declared for findings to be interpretable.</data></edge>
    <edge id="e622" source="mlsys.dangerous-capability-eval" target="mlsys.frontier-safety-framework"><data key="relation">part-of</data><data key="statement">supplies the threshold tests that trigger safeguards in</data><data key="conditions">Holds when the framework ties stated capability thresholds to required mitigations before further training or deployment.</data></edge>
    <edge id="e623" source="mlsys.dangerous-capability-eval" target="mlsys.red-teaming"><data key="relation">uses</data><data key="statement">uses elicitation from</data><data key="conditions">Capability estimates are lower bounds unless elicitation, including expert red teaming, is strong.</data></edge>
    <edge id="e624" source="mlsys.efficiency-frontier" target="mlsys.pareto-frontier"><data key="relation">specializes</data><data key="statement">specializes</data><data key="conditions">The objectives are model quality and a stated cost measure on a stated platform.</data></edge>
    <edge id="e625" source="mlsys.energy-per-inference" target="mlsys.energy-efficiency"><data key="relation">measures</data><data key="statement">is the per-input reciprocal of</data><data key="conditions">Both are measured within the same declared system boundary.</data></edge>
    <edge id="e626" source="mlsys.requirements" target="mlsys.placement"><data key="relation">determines</data><data key="statement">determine feasible</data><data key="conditions">Latency, privacy, connectivity, and power requirements rule out some device, edge, or datacenter placements.</data></edge>
    <edge id="e627" source="mlsys.release-gate" target="mlsys.baseline"><data key="relation">requires</data><data key="statement">compares candidates against</data><data key="conditions">A candidate advances only if it beats or matches the incumbent baseline on the gated metrics under the same protocol.</data></edge>
    <edge id="e628" source="mlsys.baseline" target="mlsys.online-experiment"><data key="relation">part-of</data><data key="statement">serves as the control arm of</data><data key="conditions">The incumbent system or model is served to the control group during the experiment.</data></edge>
    <edge id="e629" source="mlsys.benchmark" target="mlsys.workload"><data key="relation">requires</data><data key="statement">is only meaningful for a stated</data><data key="conditions">Benchmark results transfer only to deployments whose input, request, and model distributions match the benchmark workload.</data></edge>
    <edge id="e630" source="mlsys.workload" target="mlsys.workload-trace"><data key="relation">uses</data><data key="statement">is characterized empirically using</data><data key="conditions">The trace window covers the arrival, size, and mix variation that matters for the decision being evaluated.</data></edge>
    <edge id="e631" source="mlsys.reward-model" target="mlsys.reward-hacking"><data key="relation">causes</data><data key="statement">can invite</data><data key="conditions">Policies optimized hard against a learned reward model can exploit its errors, scoring higher while true quality falls.</data></edge>
    <edge id="e632" source="mlsys.monitoring" target="mlsys.sli"><data key="relation">produces</data><data key="statement">computes</data><data key="conditions">Monitoring records the events and counts over the population and window the indicator definition specifies.</data></edge>
    <edge id="e633" source="mlsys.sli" target="mlsys.tail-latency"><data key="relation">measures</data><data key="statement">commonly measures, as a percentile,</data><data key="conditions">Latency indicators are computed as a high percentile over a stated request population and window.</data></edge>
    <edge id="e634" source="mlsys.sli" target="mlsys.availability"><data key="relation">measures</data><data key="statement">commonly measures</data><data key="conditions">Availability indicators count successful requests or uptime over a defined population and window.</data></edge>
    <edge id="e635" source="mlsys.error-budget" target="mlsys.release-gate"><data key="relation">determines</data><data key="statement">can freeze releases through</data><data key="conditions">Teams agree that an exhausted budget blocks or slows promotion of new versions.</data></edge>
    <edge id="e636" source="mlsys.error-budget" target="mlsys.alerting"><data key="relation">determines</data><data key="statement">sets burn-rate thresholds for</data><data key="conditions">Alerts fire when the budget is being consumed faster than the window allows.</data></edge>
    <edge id="e637" source="mlsys.latency-budget" target="mlsys.reasoning-budget"><data key="relation">limits</data><data key="statement">caps the intermediate tokens allowed by</data><data key="conditions">Interactive requests must answer within a fixed end-to-end latency target, so extra reasoning tokens consume the same budget.</data></edge>
    <edge id="e638" source="mlsys.activation-recompute" target="mlsys.memory-footprint"><data key="relation">reduces</data><data key="statement">reduces the peak</data><data key="conditions">Retained activations dominate training memory and spare compute is available to recompute them.</data></edge>
    <edge id="e639" source="mlsys.kv-cache" target="mlsys.memory-footprint"><data key="relation">increases</data><data key="statement">adds per-request state to</data><data key="conditions">Autoregressive serving retains keys and values for every in-flight token; the term grows with batch size and context length.</data></edge>
    <edge id="e640" source="mlsys.workload-trace" target="mlsys.arrival-burstiness"><data key="relation">measures</data><data key="statement">reveals the</data><data key="conditions">Inter-arrival times are recorded at fine enough resolution to show bursts rather than only averages.</data></edge>
    <edge id="e641" source="mlsys.performance-simulation" target="mlsys.workload-trace"><data key="relation">uses</data><data key="statement">replays</data><data key="conditions">Trace-driven simulation is used to compare scheduling, capacity, or serving policies on realistic demand.</data></edge>
    <edge id="e642" source="mlsys.cost-sensitive-decision" target="mlsys.calibration"><data key="relation">requires</data><data key="statement">requires calibrated probabilities from</data><data key="conditions">Expected-cost thresholds are computed from predicted probabilities, which must match observed frequencies on the deployment distribution.</data></edge>
    <edge id="e643" source="mlsys.cost-sensitive-decision" target="mlsys.selective-prediction"><data key="relation">determines</data><data key="statement">sets the abstention threshold in</data><data key="conditions">Deferring to a human or fallback has a known cost that can be compared with the expected cost of each error type.</data></edge>
    <edge id="e644" source="mlsys.tokenization" target="mlsys.context"><data key="relation">determines</data><data key="statement">sets how much text fits in</data><data key="conditions">For a fixed window, a tokenizer that produces more tokens per word admits less source text.</data></edge>
    <edge id="e645" source="mlsys.linear-model" target="mlsys.tree-ensemble"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Both are standard choices for tabular supervised prediction; trees capture interactions linear scores need engineered features for.</data></edge>
    <edge id="e646" source="mlsys.tree-ensemble" target="mlsys.features"><data key="relation">uses</data><data key="statement">splits on</data><data key="conditions">Trees operate on tabular features without requiring scaling; feature engineering still determines what interactions are available.</data></edge>
    <edge id="e647" source="mlsys.kernel-method" target="mlsys.memory-footprint"><data key="relation">increases</data><data key="statement">has a quadratic training</data><data key="conditions">Exact training forms or stores an n-by-n kernel matrix, so memory grows with the square of the training set size unless approximated.</data></edge>
    <edge id="e648" source="mlsys.kernel-method" target="mlsys.inductive-bias"><data key="relation">determines</data><data key="statement">encodes its inductive bias through the choice of kernel in</data><data key="conditions">The kernel function fixes which similarity structure the model can exploit.</data></edge>
    <edge id="e649" source="mlsys.nearest-neighbor" target="mlsys.embeddings"><data key="relation">uses</data><data key="statement">searches over</data><data key="conditions">Neighbors are found by distance in a learned or engineered vector space whose quality determines result quality.</data></edge>
    <edge id="e650" source="mlsys.neural-network" target="mlsys.matrix-multiply"><data key="relation">uses</data><data key="statement">spends most compute in</data><data key="conditions">Dense and attention layers dominate; small or irregular layers can be bound by other operations.</data></edge>
    <edge id="e651" source="mlsys.convolution" target="mlsys.inductive-bias"><data key="relation">implements</data><data key="statement">encodes translation equivariance and locality as an</data><data key="conditions">Weights are shared across positions, so the model assumes local patterns recur across the input.</data></edge>
    <edge id="e652" source="mlsys.position-encoding" target="mlsys.context"><data key="relation">limits</data><data key="statement">bounds the usable length of</data><data key="conditions">Without extension, sequences longer than the positions seen in training degrade quality.</data></edge>
    <edge id="e653" source="mlsys.transformer" target="mlsys.normalization-layer"><data key="relation">uses</data><data key="statement">stabilizes residual blocks with</data><data key="conditions">Each block applies layer or RMS normalization around attention and feed-forward sublayers.</data></edge>
    <edge id="e654" source="mlsys.transformer" target="mlsys.position-encoding"><data key="relation">uses</data><data key="statement">injects order with</data><data key="conditions">Attention alone is permutation equivariant, so the architecture adds absolute, relative, or rotary positions.</data></edge>
    <edge id="e655" source="mlsys.transformer" target="mlsys.neural-network"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">The architecture is a differentiable composition trained by gradient descent.</data></edge>
    <edge id="e656" source="mlsys.ranking-funnel" target="mlsys.recommendation-model"><data key="relation">uses</data><data key="statement">runs in its ranking stages a</data><data key="conditions">Candidate generation narrows the set before costly deep ranking models score it within the latency budget.</data></edge>
    <edge id="e657" source="mlsys.depthwise-separable-convolution" target="mlsys.convolution"><data key="relation">specializes</data><data key="statement">is a factorized kind of</data><data key="conditions">A standard convolution is split into depthwise and pointwise steps.</data></edge>
    <edge id="e658" source="mlsys.depthwise-separable-convolution" target="mlsys.memory-footprint"><data key="relation">reduces</data><data key="statement">cuts parameter storage in</data><data key="conditions">Parameter memory is a significant share of the deployed footprint, as on mobile and embedded targets.</data></edge>
    <edge id="e659" source="mlsys.recurrence" target="mlsys.attention"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Both mix information across sequence positions; recurrence keeps fixed state but serializes time, attention parallelizes but grows cost with length.</data></edge>
    <edge id="e660" source="mlsys.normalization-layer" target="mlsys.training-instability"><data key="relation">mitigates</data><data key="statement">mitigates</data><data key="conditions">Deep networks whose activation scales would otherwise drift with depth or batch composition.</data></edge>
    <edge id="e661" source="mlsys.expert-routing" target="mlsys.mixture-of-experts"><data key="relation">part-of</data><data key="statement">is the gating component of</data><data key="conditions">The layer routes each token to a small subset of experts.</data></edge>
    <edge id="e662" source="mlsys.expert-capacity" target="mlsys.mixture-of-experts"><data key="relation">part-of</data><data key="statement">is a buffer-size parameter of</data><data key="conditions">Experts process fixed-size per-batch buffers so computation shapes stay static.</data></edge>
    <edge id="e663" source="mlsys.expert-capacity" target="mlsys.all-to-all"><data key="relation">increases</data><data key="statement">increases padded token volume in</data><data key="conditions">A higher capacity factor allocates larger per-expert buffers that are exchanged whether or not they are full.</data></edge>
    <edge id="e664" source="mlsys.load-balancing-loss" target="mlsys.stragglers"><data key="relation">mitigates</data><data key="statement">reduces hot-expert imbalance behind</data><data key="conditions">Under expert parallelism, an overloaded expert's device finishes last and holds back the step.</data></edge>
    <edge id="e665" source="mlsys.load-balancing-loss" target="mlsys.mixture-of-experts"><data key="relation">part-of</data><data key="statement">is an auxiliary objective in training of</data><data key="conditions">Routing is learned and can otherwise collapse onto a few experts.</data></edge>
    <edge id="e666" source="mlsys.active-parameters" target="mlsys.training-compute-estimate"><data key="relation">determines</data><data key="statement">sets the parameter count used in</data><data key="conditions">For conditionally computed models, the six-operations-per-parameter-per-token estimate uses active rather than total parameters.</data></edge>
    <edge id="e667" source="mlsys.early-exit" target="mlsys.calibration"><data key="relation">requires</data><data key="statement">relies on confidence quality assessed by</data><data key="conditions">Exit decisions threshold an intermediate confidence; overconfident exits return wrong answers early.</data></edge>
    <edge id="e668" source="mlsys.early-exit" target="mlsys.energy-per-inference"><data key="relation">reduces</data><data key="statement">reduces average</data><data key="conditions">Many inputs are easy enough to exit at an early classifier and the exit overhead is small.</data></edge>
    <edge id="e669" source="mlsys.sliding-window-attention" target="mlsys.attention"><data key="relation">specializes</data><data key="statement">is a restricted kind of</data><data key="conditions">Each position attends only within a window or fixed sparse pattern.</data></edge>
    <edge id="e670" source="mlsys.sliding-window-attention" target="mlsys.kv-cache"><data key="relation">reduces</data><data key="statement">caps the size of</data><data key="conditions">During decoding only the most recent window of keys and values must be retained.</data></edge>
    <edge id="e671" source="mlsys.linear-attention" target="mlsys.attention"><data key="relation">specializes</data><data key="statement">is a kernelized variant of</data><data key="conditions">Softmax similarity is replaced by a feature-map inner product, changing model quality.</data></edge>
    <edge id="e672" source="mlsys.linear-attention" target="mlsys.sliding-window-attention"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Both reduce attention cost growth for long sequences, trading different quality losses.</data></edge>
    <edge id="e673" source="mlsys.state-space-model" target="mlsys.attention"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Both serve as the sequence-mixing layer; state-space layers trade exact long-range lookup for linear cost and fixed state.</data></edge>
    <edge id="e674" source="mlsys.state-space-model" target="mlsys.kv-cache"><data key="relation">reduces</data><data key="statement">eliminates the growing</data><data key="conditions">Inference carries a constant-size state per layer instead of keys and values for every prior token.</data></edge>
    <edge id="e675" source="mlsys.grouped-query-attention" target="mlsys.attention"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">Multiple query heads share each key-value head.</data></edge>
    <edge id="e676" source="mlsys.grouped-query-attention" target="mlsys.tpot"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">Decode is bound by reading the KV cache, so fewer key-value heads cut bytes read per token.</data></edge>
    <edge id="e677" source="mlsys.context-extension" target="mlsys.context"><data key="relation">increases</data><data key="statement">extends the usable length of</data><data key="conditions">The model is fine-tuned briefly on longer sequences after rescaling positions; quality at the new length must be checked.</data></edge>
    <edge id="e678" source="mlsys.weight-serialization" target="mlsys.unsafe-deserialization"><data key="relation">determines</data><data key="statement">determines exposure to</data><data key="conditions">Executable formats such as pickle run code on load; data-only formats such as safetensors do not.</data></edge>
    <edge id="e679" source="mlsys.weight-serialization" target="mlsys.cold-start"><data key="relation">determines</data><data key="statement">sets weight-loading time in</data><data key="conditions">Memory-mappable, zero-copy formats load faster than formats requiring full deserialization.</data></edge>
    <edge id="e680" source="mlsys.model-conversion" target="mlsys.model-exchange-format"><data key="relation">uses</data><data key="statement">commonly passes through a</data><data key="conditions">Training and target runtimes differ and both support the exchange format's operator set.</data></edge>
    <edge id="e681" source="mlsys.model-export" target="mlsys.model-artifact"><data key="relation">produces</data><data key="statement">produces a deployable</data><data key="conditions">The artifact represents supported operators, parameters, and input constraints for its target runtime.</data></edge>
    <edge id="e682" source="mlsys.model-export" target="mlsys.tracing-jit"><data key="relation">uses</data><data key="statement">can obtain its graph through</data><data key="conditions">In export workflows that obtain a graph by tracing, such as JAX export; tracing and lowering may precede execution on another machine.</data></edge>
    <edge id="e683" source="mlsys.model-signature" target="mlsys.model-artifact"><data key="relation">part-of</data><data key="statement">is the interface declared in</data><data key="conditions">The artifact records input and output names, types, and shapes.</data></edge>
    <edge id="e684" source="mlsys.model-server" target="mlsys.model-signature"><data key="relation">requires</data><data key="statement">validates requests against</data><data key="conditions">The server decodes and checks requests using the artifact's declared inputs and outputs.</data></edge>
    <edge id="e685" source="mlsys.vla-model" target="mlsys.multimodal-model"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">The model consumes images and language and emits actions through a shared backbone.</data></edge>
    <edge id="e686" source="mlsys.multimodal-model" target="mlsys.transformer"><data key="relation">uses</data><data key="statement">commonly uses as its shared backbone a</data><data key="conditions">Encoded modality tokens are processed together with text tokens by a transformer.</data></edge>
    <edge id="e687" source="mlsys.encoder-disaggregation" target="mlsys.modality-encoder"><data key="relation">uses</data><data key="statement">schedules separately the</data><data key="conditions">Image or audio encoding is heavy enough to stall token generation if co-scheduled.</data></edge>
    <edge id="e688" source="mlsys.context-compaction" target="mlsys.context-degradation"><data key="relation">mitigates</data><data key="statement">mitigates</data><data key="conditions">Older material is summarized so relevant information stays short and near the end of the window.</data></edge>
    <edge id="e689" source="mlsys.reranking" target="mlsys.context-degradation"><data key="relation">mitigates</data><data key="statement">mitigates position effects behind</data><data key="conditions">Reranked evidence is placed where models use it best, near the start or end of the context.</data></edge>
    <edge id="e690" source="mlsys.autodiff" target="mlsys.memory-footprint"><data key="relation">increases</data><data key="statement">retains forward activations, increasing</data><data key="conditions">Reverse-mode differentiation stores intermediates from the forward pass for use in the backward pass.</data></edge>
    <edge id="e691" source="mlsys.tensor-layout" target="mlsys.memory-coalescing"><data key="relation">determines</data><data key="statement">determines whether accesses achieve</data><data key="conditions">Strides decide whether adjacent threads touch adjacent addresses.</data></edge>
    <edge id="e692" source="mlsys.mixed-precision" target="mlsys.memory-footprint"><data key="relation">reduces</data><data key="statement">reduces activation and gradient bytes in</data><data key="conditions">Activations and gradients are stored in 16-bit formats while a master copy of weights stays in higher precision.</data></edge>
    <edge id="e693" source="mlsys.mixed-precision" target="mlsys.matrix-unit"><data key="relation">uses</data><data key="statement">gains throughput from</data><data key="conditions">The matrix engine supports the reduced input formats with wider accumulation.</data></edge>
    <edge id="e694" source="mlsys.computation-graph" target="mlsys.tensor"><data key="relation">uses</data><data key="statement">passes between operations a</data><data key="conditions">Edges carry tensors whose shapes and types the graph records.</data></edge>
    <edge id="e695" source="mlsys.tensor" target="mlsys.precision"><data key="relation">uses</data><data key="statement">carries an element type drawn from</data><data key="conditions">Each tensor records a numerical format that kernels must support.</data></edge>
    <edge id="e696" source="mlsys.compilation" target="mlsys.computation-graph"><data key="relation">uses</data><data key="statement">takes as input a</data><data key="conditions">The compiler needs a captured graph rather than one operation at a time.</data></edge>
    <edge id="e697" source="mlsys.eager-execution" target="mlsys.fusion"><data key="relation">determines</data><data key="statement">forecloses cross-operation</data><data key="conditions">Each operation is launched as the host issues it, so no compiler sees neighboring operations.</data></edge>
    <edge id="e698" source="mlsys.io-aware-attention" target="mlsys.attention"><data key="relation">implements</data><data key="statement">exactly computes</data><data key="conditions">The result matches standard softmax attention up to floating-point reordering.</data></edge>
    <edge id="e699" source="mlsys.io-aware-attention" target="mlsys.tiling"><data key="relation">uses</data><data key="statement">is built on</data><data key="conditions">Query, key, and value blocks are staged through on-chip memory with an online softmax.</data></edge>
    <edge id="e700" source="mlsys.convolution-lowering" target="mlsys.memory-footprint"><data key="relation">increases</data><data key="statement">can increase, through duplicated patches,</data><data key="conditions">im2col-style lowering copies overlapping input patches into a larger matrix.</data></edge>
    <edge id="e701" source="mlsys.kernel-library" target="mlsys.matrix-multiply"><data key="relation">implements</data><data key="statement">provides tuned</data><data key="conditions">Vendor libraries supply GEMM and convolution kernels selected per shape and precision.</data></edge>
    <edge id="e702" source="mlsys.kernel-library" target="mlsys.kernel-dsl"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Both supply operator kernels; libraries cover common shapes, DSLs let engineers write fused or novel kernels.</data></edge>
    <edge id="e703" source="mlsys.compilation" target="mlsys.intermediate-representation"><data key="relation">uses</data><data key="statement">lowers through</data><data key="conditions">Graph, tensor, and loop-level representations carry the program between passes.</data></edge>
    <edge id="e704" source="mlsys.sharding-propagation" target="mlsys.intermediate-representation"><data key="relation">uses</data><data key="statement">propagates layouts through</data><data key="conditions">Sharding annotations are attached to operations in the compiler IR.</data></edge>
    <edge id="e705" source="mlsys.autotuning" target="mlsys.profiling"><data key="relation">uses</data><data key="statement">measures candidates with</data><data key="conditions">Candidate schedules are compiled and timed on the target, or a cost model is trained from such measurements.</data></edge>
    <edge id="e706" source="mlsys.autotuning" target="mlsys.compilation"><data key="relation">part-of</data><data key="statement">is a search stage within</data><data key="conditions">The compiler exposes a schedule space whose performance is hard to predict analytically.</data></edge>
    <edge id="e707" source="mlsys.kernel-dsl" target="mlsys.on-chip-sram"><data key="relation">uses</data><data key="statement">lets the compiler manage</data><data key="conditions">Programs are written over blocks while the compiler allocates shared memory and registers.</data></edge>
    <edge id="e708" source="mlsys.kernel-dsl" target="mlsys.fusion"><data key="relation">enables</data><data key="statement">enables custom</data><data key="conditions">Engineers can write a single kernel that combines operations no library provides fused.</data></edge>
    <edge id="e709" source="mlsys.memory-planning" target="mlsys.compilation"><data key="relation">part-of</data><data key="statement">is a pass within</data><data key="conditions">Static shapes let the compiler compute tensor lifetimes ahead of execution.</data></edge>
    <edge id="e710" source="mlsys.memory-planning" target="mlsys.caching-allocator"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Both manage device buffers; static planning needs known lifetimes, caching allocation handles dynamic shapes.</data></edge>
    <edge id="e711" source="mlsys.device-streams" target="mlsys.dispatch"><data key="relation">reduces</data><data key="statement">hides, through asynchronous enqueue, exposed</data><data key="conditions">The host can run ahead of the device, so launch work overlaps device execution until queues drain.</data></edge>
    <edge id="e712" source="mlsys.graph-replay" target="mlsys.device-streams"><data key="relation">uses</data><data key="statement">is captured from and replayed on</data><data key="conditions">Work enqueued on a stream is recorded as a graph and replayed as one launch.</data></edge>
    <edge id="e713" source="mlsys.caching-allocator" target="mlsys.dispatch"><data key="relation">reduces</data><data key="statement">avoids synchronizing allocation calls in</data><data key="conditions">Freed blocks are reused instead of calling the device allocator, which can synchronize the host.</data></edge>
    <edge id="e714" source="mlsys.graph-replay" target="mlsys.tpot"><data key="relation">reduces</data><data key="statement">reduces per-step launch overhead in</data><data key="conditions">Decode steps launch many small kernels with static shapes, so host overhead is a large share of step time.</data></edge>
    <edge id="e715" source="mlsys.loss-scaling" target="mlsys.numerical-stability"><data key="relation">increases</data><data key="statement">keeps small gradients representable, improving</data><data key="conditions">Reduced-precision gradient formats would otherwise underflow; overflow is detected and the step skipped.</data></edge>
    <edge id="e716" source="mlsys.block-scaled-format" target="mlsys.activation-outliers"><data key="relation">mitigates</data><data key="statement">limits the range damage from</data><data key="conditions">A shared scale per small block confines an outlier's effect to its own block.</data></edge>
    <edge id="e717" source="mlsys.quantization" target="mlsys.block-scaled-format"><data key="relation">uses</data><data key="statement">can encode values in</data><data key="conditions">Hardware or kernels support the block-scaled element and scale formats.</data></edge>
    <edge id="e718" source="mlsys.matrix-unit" target="mlsys.accumulation-precision"><data key="relation">determines</data><data key="statement">fixes the available</data><data key="conditions">The matrix engine implements specific accumulation formats for each input format.</data></edge>
    <edge id="e719" source="mlsys.function-transformations" target="mlsys.compilation"><data key="relation">uses</data><data key="statement">exposes as a transform</data><data key="conditions">Pure array functions are traced and handed to an XLA-style compiler.</data></edge>
    <edge id="e720" source="mlsys.single-vs-multi-controller" target="mlsys.dispatch"><data key="relation">determines</data><data key="statement">sets where per-step dispatch cost falls in</data><data key="conditions">One controller issuing work to many devices must keep dispatch asynchronous and off the critical path.</data></edge>
    <edge id="e721" source="mlsys.thread-hierarchy" target="mlsys.on-chip-sram"><data key="relation">uses</data><data key="statement">shares within a thread block</data><data key="conditions">Threads of a block cooperate through shared memory sized per block.</data></edge>
    <edge id="e722" source="mlsys.thread-hierarchy" target="mlsys.memory-coalescing"><data key="relation">determines</data><data key="statement">determines, through thread-to-address mapping,</data><data key="conditions">Adjacent threads of a warp should access adjacent addresses.</data></edge>
    <edge id="e723" source="mlsys.on-chip-sram" target="mlsys.occupancy"><data key="relation">limits</data><data key="statement">bounds</data><data key="conditions">Shared memory and registers per block limit how many warps can be resident.</data></edge>
    <edge id="e724" source="mlsys.thread-hierarchy" target="mlsys.occupancy"><data key="relation">determines</data><data key="statement">sets, through block size and per-thread resources,</data><data key="conditions">Block shape and register or shared-memory use determine resident warps per multiprocessor.</data></edge>
    <edge id="e725" source="mlsys.async-data-movement" target="mlsys.on-chip-sram"><data key="relation">uses</data><data key="statement">stages operands into</data><data key="conditions">Bulk copies land in shared memory while compute proceeds on the previous buffer.</data></edge>
    <edge id="e726" source="mlsys.async-data-movement" target="mlsys.utilization"><data key="relation">increases</data><data key="statement">raises matrix-engine</data><data key="conditions">The kernel would otherwise stall its matrix units waiting on loads.</data></edge>
    <edge id="e727" source="mlsys.matrix-engine-programming" target="mlsys.matrix-unit"><data key="relation">uses</data><data key="statement">issues instructions to</data><data key="conditions">Fragments are loaded in the shapes and layouts the unit accepts.</data></edge>
    <edge id="e728" source="mlsys.matrix-engine-programming" target="mlsys.tensor-layout"><data key="relation">requires</data><data key="statement">requires specific operand</data><data key="conditions">Matrix instructions accept only particular fragment layouts, so data may need rearrangement.</data></edge>
    <edge id="e729" source="mlsys.batch-invariance" target="mlsys.experiment-reproducibility"><data key="relation">enables</data><data key="statement">enables bitwise-reproducible serving within</data><data key="conditions">Kernels use fixed reduction strategies independent of batch size and co-batched requests.</data></edge>
    <edge id="e730" source="mlsys.systolic-array" target="mlsys.accelerator-execution-architecture"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">Processing elements pass operands to neighbors under a fixed schedule.</data></edge>
    <edge id="e731" source="mlsys.simt" target="mlsys.accelerator-execution-architecture"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">Thread groups issue the same instruction and divergent paths serialize.</data></edge>
    <edge id="e732" source="mlsys.matrix-unit" target="mlsys.accelerator-execution-architecture"><data key="relation">part-of</data><data key="statement">is a functional unit within</data><data key="conditions">The accelerator pairs matrix engines with vector or scalar units.</data></edge>
    <edge id="e733" source="mlsys.hbm" target="mlsys.memory-hierarchy"><data key="relation">part-of</data><data key="statement">is the device-memory level of</data><data key="conditions">The accelerator uses stacked DRAM as off-chip device memory.</data></edge>
    <edge id="e734" source="mlsys.on-chip-sram" target="mlsys.memory-hierarchy"><data key="relation">part-of</data><data key="statement">is the fastest managed level of</data><data key="conditions">The platform exposes caches, shared memory, or scratchpads near compute.</data></edge>
    <edge id="e735" source="mlsys.host-device-interconnect" target="mlsys.memory-offloading"><data key="relation">limits</data><data key="statement">bounds the throughput of</data><data key="conditions">Offloaded optimizer state, parameters, or activations cross the host link every step.</data></edge>
    <edge id="e736" source="mlsys.host-device-interconnect" target="mlsys.kv-cache-offload"><data key="relation">limits</data><data key="statement">bounds reload rate in</data><data key="conditions">Offloaded KV blocks return to device memory over the host link on reuse.</data></edge>
    <edge id="e737" source="mlsys.power-delivery" target="mlsys.rack-power-density"><data key="relation">limits</data><data key="statement">bounds</data><data key="conditions">Facility and rack feeds, conversion stages, and breakers limit sustained draw per rack.</data></edge>
    <edge id="e738" source="mlsys.power-delivery" target="mlsys.silent-data-corruption"><data key="relation">causes</data><data key="statement">can cause, through insufficient voltage margin,</data><data key="conditions">Droop or marginal supply under heavy load leaves circuits below the voltage they need for correct timing.</data></edge>
    <edge id="e739" source="mlsys.systolic-array" target="mlsys.data-movement-energy"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">Operands are reused across processing elements instead of being refetched from register files or memory.</data></edge>
    <edge id="e740" source="mlsys.dataflow" target="mlsys.locality"><data key="relation">determines</data><data key="statement">determines</data><data key="conditions">Local storage cannot hold every operand, so the schedule chooses which data is reused in place.</data></edge>
    <edge id="e741" source="mlsys.systolic-array" target="mlsys.dataflow"><data key="relation">uses</data><data key="statement">operates under a chosen</data><data key="conditions">The array keeps one operand stationary, such as weights, while others stream.</data></edge>
    <edge id="e742" source="mlsys.domain-specific-architecture" target="mlsys.energy-efficiency"><data key="relation">increases</data><data key="statement">raises</data><data key="conditions">Target operations dominate the workload and are supported by the specialized hardware.</data></edge>
    <edge id="e743" source="mlsys.hbm" target="mlsys.memory-capacity"><data key="relation">determines</data><data key="statement">sets device</data><data key="conditions">Stack count and stack height fix the capacity attached to each accelerator.</data></edge>
    <edge id="e744" source="mlsys.hbm" target="mlsys.memory-wall"><data key="relation">mitigates</data><data key="statement">narrows, without closing,</data><data key="conditions">Stacking and wide interfaces raise bandwidth, though compute still grows faster across generations.</data></edge>
    <edge id="e745" source="mlsys.memory-wall" target="mlsys.model-flops-utilization"><data key="relation">reduces</data><data key="statement">depresses</data><data key="conditions">Memory-bound phases such as decode cannot feed the arithmetic units at peak rate.</data></edge>
    <edge id="e746" source="mlsys.scale-up-interconnect" target="mlsys.network-topology"><data key="relation">part-of</data><data key="statement">forms the fastest tier of</data><data key="conditions">The cluster topology is hierarchical, with a node or rack domain joined by a slower scale-out fabric.</data></edge>
    <edge id="e747" source="mlsys.coherent-interconnect" target="mlsys.host-device-interconnect"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">The link adds hardware coherence and load-store memory semantics over a host-device physical layer.</data></edge>
    <edge id="e748" source="mlsys.coherent-interconnect" target="mlsys.kv-cache-offload"><data key="relation">enables</data><data key="statement">can provide a pooled tier for</data><data key="conditions">Attached or pooled memory is cheaper than device memory and its higher latency can be overlapped with compute.</data></edge>
    <edge id="e749" source="mlsys.kv-cache-transfer" target="mlsys.peer-to-peer-transfer"><data key="relation">uses</data><data key="statement">moves state with</data><data key="conditions">Direct device or NIC transfers avoid staging KV blocks through host memory.</data></edge>
    <edge id="e750" source="mlsys.rdma" target="mlsys.peer-to-peer-transfer"><data key="relation">enables</data><data key="statement">can read and write device memory through</data><data key="conditions">The NIC and driver support direct access to accelerator memory.</data></edge>
    <edge id="e751" source="mlsys.tdp" target="mlsys.rack-power-density"><data key="relation">determines</data><data key="statement">sets, with accelerators per rack,</data><data key="conditions">Racks are provisioned for the sustained power of the chips they hold.</data></edge>
    <edge id="e752" source="mlsys.tdp" target="mlsys.dark-silicon"><data key="relation">determines</data><data key="statement">sets the fraction of</data><data key="conditions">Transistor counts grow while the power envelope does not.</data></edge>
    <edge id="e753" source="mlsys.power-capping" target="mlsys.dvfs"><data key="relation">uses</data><data key="statement">enforces caps through</data><data key="conditions">The device lowers clocks and voltage when measured power exceeds the cap.</data></edge>
    <edge id="e754" source="mlsys.thermal-dynamics" target="mlsys.dvfs"><data key="relation">uses</data><data key="statement">throttles through</data><data key="conditions">Thermal controls lower frequency and voltage when temperature limits are approached.</data></edge>
    <edge id="e755" source="mlsys.microcontroller" target="mlsys.on-device-runtime"><data key="relation">uses</data><data key="statement">runs models through a lightweight</data><data key="conditions">No operating system or virtual memory is available, so the runtime is statically linked and memory-planned.</data></edge>
    <edge id="e756" source="mlsys.edge-npu" target="mlsys.heterogeneous-soc"><data key="relation">part-of</data><data key="statement">is one block of</data><data key="conditions">The SoC exposes the NPU alongside CPU, GPU, and DSP under shared memory and power.</data></edge>
    <edge id="e757" source="mlsys.on-device-runtime" target="mlsys.heterogeneous-soc"><data key="relation">uses</data><data key="statement">delegates operators across</data><data key="conditions">The runtime partitions supported operators onto the NPU, GPU, or DSP and falls back to CPU.</data></edge>
    <edge id="e758" source="mlsys.edge-npu" target="mlsys.energy-per-inference"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">The model's operators and precisions are supported, so inference avoids CPU fallback.</data></edge>
    <edge id="e759" source="mlsys.hardware-aware-nas" target="mlsys.on-device-memory-budget"><data key="relation">uses</data><data key="statement">searches within</data><data key="conditions">The search treats flash and SRAM limits as hard constraints on candidate models.</data></edge>
    <edge id="e760" source="mlsys.on-device-memory-budget" target="mlsys.on-device-training"><data key="relation">limits</data><data key="statement">bounds</data><data key="conditions">Training must fit weights, activations, and update state in on-chip memory.</data></edge>
    <edge id="e761" source="mlsys.recommendation-model" target="mlsys.embedding-cache"><data key="relation">uses</data><data key="statement">serves hot rows from an</data><data key="conditions">Lookups are skewed so a small set of rows receives most accesses.</data></edge>
    <edge id="e762" source="mlsys.embedding-cache" target="mlsys.storage-tiering"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">Rows are placed across accelerator memory, host memory, and SSD by access frequency.</data></edge>
    <edge id="e763" source="mlsys.pipeline-parallel" target="mlsys.memory-footprint"><data key="relation">reduces</data><data key="statement">divides per-device parameter</data><data key="conditions">Each stage holds only its layers' parameters and their state.</data></edge>
    <edge id="e764" source="mlsys.pipeline-parallel" target="mlsys.hybrid-parallel"><data key="relation">part-of</data><data key="statement">is one dimension of</data><data key="conditions">Pipeline stages are combined with data and tensor parallelism across nodes.</data></edge>
    <edge id="e765" source="mlsys.state-sharding" target="mlsys.collectives"><data key="relation">uses</data><data key="statement">gathers and scatters state through</data><data key="conditions">Sharded parameters are all-gathered before use and gradients reduce-scattered after.</data></edge>
    <edge id="e766" source="mlsys.state-sharding" target="mlsys.memory-footprint"><data key="relation">reduces</data><data key="statement">divides per-worker</data><data key="conditions">Parameters, gradients, or optimizer state are partitioned instead of replicated.</data></edge>
    <edge id="e767" source="mlsys.fat-tree" target="mlsys.network-topology"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">The fabric is built from tiers of commodity switches.</data></edge>
    <edge id="e768" source="mlsys.rail-optimized" target="mlsys.network-topology"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">Same-index accelerators across nodes share a leaf switch.</data></edge>
    <edge id="e769" source="mlsys.expert-parallel" target="mlsys.hybrid-parallel"><data key="relation">part-of</data><data key="statement">is one dimension of</data><data key="conditions">MoE layers place experts across devices alongside data and tensor parallelism.</data></edge>
    <edge id="e770" source="mlsys.sequence-parallel" target="mlsys.hybrid-parallel"><data key="relation">part-of</data><data key="statement">is one dimension of</data><data key="conditions">Long-sequence training adds a sequence axis to the parallel mapping.</data></edge>
    <edge id="e771" source="mlsys.sequence-parallel" target="mlsys.collectives"><data key="relation">uses</data><data key="statement">exchanges keys and values through</data><data key="conditions">Blocks of keys and values circulate among devices while attention is computed.</data></edge>
    <edge id="e772" source="mlsys.gradient-accumulation" target="mlsys.pipeline-bubble"><data key="relation">reduces</data><data key="statement">shrinks, through more microbatches,</data><data key="conditions">More microbatches per optimizer step fill the pipeline relative to the number of stages.</data></edge>
    <edge id="e773" source="mlsys.pipeline-bubble" target="mlsys.model-flops-utilization"><data key="relation">reduces</data><data key="statement">lowers</data><data key="conditions">Devices idle during fill and drain while their peak FLOPs still count in the denominator.</data></edge>
    <edge id="e774" source="mlsys.tree-allreduce" target="mlsys.collectives"><data key="relation">implements</data><data key="statement">is an algorithm for</data><data key="conditions">Participants are arranged in trees or hierarchical groups.</data></edge>
    <edge id="e775" source="mlsys.all-to-all" target="mlsys.collectives"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">Every participant sends distinct data to every other.</data></edge>
    <edge id="e776" source="mlsys.alpha-beta-model" target="mlsys.tree-allreduce"><data key="relation">measures</data><data key="statement">predicts the cost of</data><data key="conditions">Link latency and bandwidth are roughly uniform and contention is ignored.</data></edge>
    <edge id="e777" source="mlsys.gradient-compression" target="mlsys.time-to-train"><data key="relation">reduces</data><data key="statement">can reduce</data><data key="conditions">Training is communication-bound and compression preserves convergence at the chosen ratio.</data></edge>
    <edge id="e778" source="mlsys.gradient-compression" target="mlsys.sparsity"><data key="relation">uses</data><data key="statement">can transmit only top-magnitude gradients, using</data><data key="conditions">Residuals are accumulated locally so dropped values are sent later.</data></edge>
    <edge id="e779" source="mlsys.leader-election" target="mlsys.lease"><data key="relation">uses</data><data key="statement">holds leadership through a</data><data key="conditions">The leader renews a time-bounded grant so a failed leader's authority lapses.</data></edge>
    <edge id="e780" source="mlsys.lease" target="mlsys.replication-failover"><data key="relation">enables</data><data key="statement">enables timed</data><data key="conditions">A standby can take over once the failed holder's lease has expired.</data></edge>
    <edge id="e781" source="mlsys.leader-election" target="mlsys.fencing"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">A deposed leader may still act; resources must reject its stale epoch.</data></edge>
    <edge id="e782" source="mlsys.federated-averaging" target="mlsys.secure-aggregation"><data key="relation">uses</data><data key="statement">can combine updates through</data><data key="conditions">The server must not see individual client updates.</data></edge>
    <edge id="e783" source="mlsys.client-sampling" target="mlsys.federated-averaging"><data key="relation">part-of</data><data key="statement">is the per-round selection step of</data><data key="conditions">Each round samples a subset of available clients.</data></edge>
    <edge id="e784" source="mlsys.federation-setting" target="mlsys.device-heterogeneity"><data key="relation">determines</data><data key="statement">determines exposure to</data><data key="conditions">Cross-device federations span varied hardware and runtimes; cross-silo ones are few and uniform.</data></edge>
    <edge id="e785" source="mlsys.federation-setting" target="mlsys.failure-model"><data key="relation">determines</data><data key="statement">determines the</data><data key="conditions">Cross-device clients drop out routinely, while cross-silo participants are expected to stay available.</data></edge>
    <edge id="e786" source="mlsys.embedding-table-sharding" target="mlsys.hybrid-parallel"><data key="relation">part-of</data><data key="statement">is the model-parallel part of</data><data key="conditions">Dense layers are data-parallel while embedding tables are partitioned.</data></edge>
    <edge id="e787" source="mlsys.parameter-server" target="mlsys.ring-allreduce"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Both aggregate gradients for data-parallel training; servers suit sparse or asynchronous updates, all-reduce suits dense synchronous ones.</data></edge>
    <edge id="e788" source="mlsys.recommendation-model" target="mlsys.parameter-server"><data key="relation">uses</data><data key="statement">commonly trains sparse tables through a</data><data key="conditions">Updates touch only the rows looked up in each batch.</data></edge>
    <edge id="e789" source="mlsys.auto-parallelization" target="mlsys.analytical-performance-model"><data key="relation">uses</data><data key="statement">ranks plans with</data><data key="conditions">The search evaluates candidate partitionings with a cost model of compute and communication.</data></edge>
    <edge id="e790" source="mlsys.network-topology" target="mlsys.device-mesh"><data key="relation">determines</data><data key="statement">determines the axis alignment of</data><data key="conditions">The busiest parallel axis is mapped onto the fastest links.</data></edge>
    <edge id="e791" source="mlsys.hybrid-parallel" target="mlsys.device-mesh"><data key="relation">uses</data><data key="statement">assigns parallel dimensions to the axes of</data><data key="conditions">Each parallelism dimension corresponds to a named mesh axis.</data></edge>
    <edge id="e792" source="mlsys.pue" target="mlsys.warehouse-scale-computer"><data key="relation">measures</data><data key="statement">measures facility overhead of</data><data key="conditions">IT and total facility energy are metered over the same period.</data></edge>
    <edge id="e793" source="mlsys.liquid-cooling" target="mlsys.pue"><data key="relation">reduces</data><data key="statement">can reduce</data><data key="conditions">Cooling energy is a large share of facility overhead and liquid loops need less fan and chiller work.</data></edge>
    <edge id="e794" source="mlsys.liquid-cooling" target="mlsys.thermal-dynamics"><data key="relation">mitigates</data><data key="statement">mitigates throttling in</data><data key="conditions">Air cooling cannot hold chips below their thermal limits at the target power.</data></edge>
    <edge id="e795" source="mlsys.power-oversubscription" target="mlsys.tco"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">More servers share provisioned power capacity because their peaks rarely coincide.</data></edge>
    <edge id="e796" source="mlsys.warehouse-scale-computer" target="mlsys.power-oversubscription"><data key="relation">uses</data><data key="statement">provisions power through</data><data key="conditions">Fleet-wide power measurements show aggregate peaks below summed nameplate.</data></edge>
    <edge id="e797" source="mlsys.warehouse-scale-computer" target="mlsys.tco"><data key="relation">uses</data><data key="statement">is designed against the cost model of</data><data key="conditions">When facility, hardware, and software choices are evaluated as one cost model over the fleet's lifetime.</data></edge>
    <edge id="e798" source="mlsys.lossless-fabric" target="mlsys.congestion-control"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">Priority flow control alone spreads congestion and pauses; end-to-end rate control keeps queues short.</data></edge>
    <edge id="e799" source="mlsys.lossless-fabric" target="mlsys.tail-latency"><data key="relation">increases</data><data key="statement">can inflate</data><data key="conditions">Pause frames cause head-of-line blocking that delays unrelated flows under congestion.</data></edge>
    <edge id="e800" source="mlsys.congestion-control" target="mlsys.performance-interference"><data key="relation">mitigates</data><data key="statement">mitigates network</data><data key="conditions">Jobs share switch queues on a common fabric.</data></edge>
    <edge id="e801" source="mlsys.rail-optimized" target="mlsys.scale-up-interconnect"><data key="relation">uses</data><data key="statement">relies for cross-rail traffic on</data><data key="conditions">Traffic between different rails is forwarded through the node's scale-up domain.</data></edge>
    <edge id="e802" source="mlsys.in-network-reduction" target="mlsys.collectives"><data key="relation">reduces</data><data key="statement">reduces link traffic and latency of</data><data key="conditions">Switches support aggregation for the data types and reduction operations used.</data></edge>
    <edge id="e803" source="mlsys.in-network-reduction" target="mlsys.ring-allreduce"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Both perform all-reduce; switch aggregation shortens paths while rings need only end-host support.</data></edge>
    <edge id="e804" source="mlsys.parallel-file-system" target="mlsys.object-storage"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Both serve shared training data and checkpoints; file systems offer lower latency, object stores cheaper scalable capacity.</data></edge>
    <edge id="e805" source="mlsys.checkpoint-io" target="mlsys.parallel-file-system"><data key="relation">uses</data><data key="statement">commonly writes to a</data><data key="conditions">Sharded checkpoints are written concurrently by many ranks.</data></edge>
    <edge id="e806" source="mlsys.object-storage" target="mlsys.dataset-storage-layout"><data key="relation">determines</data><data key="statement">favors large sequential shards in</data><data key="conditions">Per-request latency is high, so many small reads are slow.</data></edge>
    <edge id="e807" source="mlsys.async-checkpointing" target="mlsys.checkpoint-io"><data key="relation">reduces</data><data key="statement">hides the training stall from</data><data key="conditions">A fast snapshot to host memory lets persistence proceed in the background.</data></edge>
    <edge id="e808" source="mlsys.checkpoint-io" target="mlsys.checkpoint-interval"><data key="relation">determines</data><data key="statement">sets the write-cost input to</data><data key="conditions">The optimal interval scales with the square root of checkpoint cost times MTBF.</data></edge>
    <edge id="e809" source="mlsys.data-parallel" target="mlsys.gang-scheduling"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">Synchronous replicas cannot start or step until every worker holds its allocation.</data></edge>
    <edge id="e810" source="mlsys.gang-scheduling" target="mlsys.queueing"><data key="relation">increases</data><data key="statement">can increase job</data><data key="conditions">Large jobs wait until enough resources are free at once.</data></edge>
    <edge id="e811" source="mlsys.bin-packing" target="mlsys.utilization"><data key="relation">increases</data><data key="statement">raises</data><data key="conditions">Jobs can share nodes without violating resource or isolation constraints.</data></edge>
    <edge id="e812" source="mlsys.bin-packing" target="mlsys.performance-interference"><data key="relation">increases</data><data key="statement">can increase</data><data key="conditions">Dense co-location puts jobs on shared caches, memory bandwidth, and links.</data></edge>
    <edge id="e813" source="mlsys.multi-tenancy" target="mlsys.gpu-partitioning"><data key="relation">uses</data><data key="statement">can share devices through</data><data key="conditions">Tenant workloads are too small to saturate whole accelerators.</data></edge>
    <edge id="e814" source="mlsys.resource-quota" target="mlsys.multi-tenancy"><data key="relation">part-of</data><data key="statement">is a policy within</data><data key="conditions">Tenants share a cluster under stated limits and guarantees.</data></edge>
    <edge id="e815" source="mlsys.resource-quota" target="mlsys.dominant-resource-fairness"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Both divide shared capacity among tenants; quotas are static limits, DRF adapts shares to demand.</data></edge>
    <edge id="e816" source="mlsys.gpu-partitioning" target="mlsys.performance-interference"><data key="relation">mitigates</data><data key="statement">mitigates, with hardware partitions,</data><data key="conditions">Partitions give each workload dedicated memory and compute slices; time-slicing does not.</data></edge>
    <edge id="e817" source="mlsys.elastic-training" target="mlsys.spot-capacity"><data key="relation">enables</data><data key="statement">makes usable</data><data key="conditions">Training continues while preempted workers leave and replacements join.</data></edge>
    <edge id="e818" source="mlsys.ridge-point" target="mlsys.roofline"><data key="relation">part-of</data><data key="statement">is the corner of</data><data key="conditions">Both ceilings refer to the same device and memory level.</data></edge>
    <edge id="e819" source="mlsys.memory-wall" target="mlsys.ridge-point"><data key="relation">increases</data><data key="statement">moves to higher intensity the</data><data key="conditions">Peak compute grows faster than bandwidth across hardware generations.</data></edge>
    <edge id="e820" source="mlsys.parallel-efficiency" target="mlsys.strong-scaling"><data key="relation">measures</data><data key="statement">measures</data><data key="conditions">Problem size is fixed while resources grow.</data></edge>
    <edge id="e821" source="mlsys.parallel-efficiency" target="mlsys.weak-scaling"><data key="relation">measures</data><data key="statement">measures</data><data key="conditions">Work per resource is fixed while resources and problem size grow.</data></edge>
    <edge id="e822" source="mlsys.weak-scaling" target="mlsys.strong-scaling"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Both describe how to use added resources; one grows the problem, the other fixes it.</data></edge>
    <edge id="e823" source="mlsys.critical-batch-size" target="mlsys.weak-scaling"><data key="relation">limits</data><data key="statement">bounds useful data-parallel</data><data key="conditions">Growing the global batch with worker count stops reducing optimization steps beyond the critical batch size.</data></edge>
    <edge id="e824" source="mlsys.capacity-planning" target="mlsys.littles-law"><data key="relation">uses</data><data key="statement">sizes concurrency with</data><data key="conditions">Arrival rate and time in system are measured for a stable operating point.</data></edge>
    <edge id="e825" source="mlsys.batching" target="mlsys.latency-throughput-curve"><data key="relation">determines</data><data key="statement">moves the operating point along</data><data key="conditions">Larger batches raise throughput while adding batch-formation and execution delay.</data></edge>
    <edge id="e826" source="mlsys.queueing" target="mlsys.latency-throughput-curve"><data key="relation">determines</data><data key="statement">bends upward the</data><data key="conditions">Utilization approaches service capacity, so waiting time grows sharply.</data></edge>
    <edge id="e827" source="mlsys.arrival-burstiness" target="mlsys.capacity-planning"><data key="relation">determines</data><data key="statement">raises headroom required by</data><data key="conditions">Capacity is provisioned for bursts at the target latency percentile, not mean load.</data></edge>
    <edge id="e828" source="mlsys.model-fidelity" target="mlsys.performance-simulation"><data key="relation">measures</data><data key="statement">bounds trust in</data><data key="conditions">Simulator predictions are validated against measurement on reference workloads.</data></edge>
    <edge id="e829" source="mlsys.model-fidelity" target="mlsys.profiling"><data key="relation">requires</data><data key="statement">requires measurements from</data><data key="conditions">Validation compares predictions with profiled or benchmarked execution.</data></edge>
    <edge id="e830" source="mlsys.amdahls-law" target="mlsys.parallel-efficiency"><data key="relation">limits</data><data key="statement">bounds</data><data key="conditions">The unparallelized fraction is fixed while workers are added to a fixed-size problem.</data></edge>
    <edge id="e831" source="mlsys.dataset-storage-layout" target="mlsys.input-pipeline"><data key="relation">determines</data><data key="statement">sets the read and decode cost of</data><data key="conditions">Record grouping, compression, and columnar layout decide how many bytes each batch must fetch and decode.</data></edge>
    <edge id="e832" source="mlsys.dark-silicon" target="mlsys.compute-throughput"><data key="relation">limits</data><data key="statement">bounds sustained all-unit</data><data key="conditions">Power and thermal limits prevent every unit from running at full frequency at once.</data></edge>
    <edge id="e833" source="mlsys.fat-tree" target="mlsys.tco"><data key="relation">reduces</data><data key="statement">lowers network cost within</data><data key="conditions">Identical commodity switches replace large high-radix core switches at equal bisection bandwidth.</data></edge>
    <edge id="e834" source="mlsys.lineage" target="mlsys.data-dependency"><data key="relation">detects</data><data key="statement">reveals undeclared and underused</data><data key="conditions">Lineage must be captured at the feature or column level and compared against what the model actually consumes.</data></edge>
    <edge id="e835" source="mlsys.data-contract" target="mlsys.data-dependency"><data key="relation">mitigates</data><data key="statement">makes explicit and versions</data><data key="conditions">Holds when every model input is consumed through a declared, owned contract rather than an ad hoc signal.</data></edge>
    <edge id="e836" source="mlsys.sliced-evaluation" target="mlsys.entanglement"><data key="relation">detects</data><data key="statement">exposes subset regressions caused by</data><data key="conditions">Applies when a change to one input or hyperparameter is evaluated on the same fixed slices before and after.</data></edge>
    <edge id="e837" source="mlsys.configuration-management" target="mlsys.experiment-reproducibility"><data key="relation">enables</data><data key="statement">pins the settings required for</data><data key="conditions">Holds when every run records the exact reviewed configuration version it executed.</data></edge>
    <edge id="e838" source="mlsys.configuration-management" target="mlsys.rollback"><data key="relation">enables</data><data key="statement">makes configuration changes revertible through</data><data key="conditions">Applies when configuration is versioned and deployed through the same pipeline as code.</data></edge>
    <edge id="e839" source="mlsys.feature-store" target="mlsys.ml-platform"><data key="relation">part-of</data><data key="statement">is a shared component of</data><data key="conditions">Typical when an organization centralizes feature definitions for many teams.</data></edge>
    <edge id="e840" source="mlsys.model-registry" target="mlsys.ml-platform"><data key="relation">part-of</data><data key="statement">is a shared component of</data><data key="conditions">Typical when promotion and deployment are standardized across teams.</data></edge>
    <edge id="e841" source="mlsys.infrastructure-as-code" target="mlsys.ml-platform"><data key="relation">enables</data><data key="statement">provisions repeatable environments for</data><data key="conditions">Holds when platform compute, storage, and services are declared in versioned files.</data></edge>
    <edge id="e842" source="mlsys.ml-roles" target="mlsys.incident-response"><data key="relation">determines</data><data key="statement">assigns on-call ownership in</data><data key="conditions">Applies when data, model, and platform owners are named for each production model.</data></edge>
    <edge id="e843" source="mlsys.undeclared-consumers" target="mlsys.technical-debt"><data key="relation">increases</data><data key="statement">add hidden coupling to</data><data key="conditions">Holds whenever model outputs are consumed without access control or registration.</data></edge>
    <edge id="e844" source="mlsys.authorization" target="mlsys.undeclared-consumers"><data key="relation">mitigates</data><data key="statement">prevents unregistered</data><data key="conditions">Applies when prediction endpoints and output tables require granted access per consumer.</data></edge>
    <edge id="e845" source="mlsys.production-readiness" target="mlsys.technical-debt"><data key="relation">measures</data><data key="statement">scores accumulated</data><data key="conditions">The rubric must be applied repeatedly to the same system to track change over time.</data></edge>
    <edge id="e846" source="mlsys.production-readiness" target="mlsys.integration-testing"><data key="relation">requires</data><data key="statement">requires evidence from</data><data key="conditions">Holds for the infrastructure and pipeline sections of the rubric.</data></edge>
    <edge id="e847" source="mlsys.supervised-fine-tuning" target="mlsys.supervised-learning"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">Holds when training uses input-output demonstrations as targets.</data></edge>
    <edge id="e848" source="mlsys.supervised-fine-tuning" target="mlsys.transfer-learning"><data key="relation">implements</data><data key="statement">implements</data><data key="conditions">Applies when a pretrained model is adapted to a new task or behavior.</data></edge>
    <edge id="e849" source="mlsys.rlhf" target="mlsys.supervised-fine-tuning"><data key="relation">requires</data><data key="statement">starts from a policy produced by</data><data key="conditions">Holds for the standard InstructGPT-style pipeline; some recipes skip or shorten the SFT stage.</data></edge>
    <edge id="e850" source="mlsys.synthetic-data" target="mlsys.supervised-fine-tuning"><data key="relation">enables</data><data key="statement">supplies instruction data for</data><data key="conditions">Applies when generated demonstrations are filtered for quality and diversity.</data></edge>
    <edge id="e851" source="mlsys.incremental-training" target="mlsys.catastrophic-forgetting"><data key="relation">causes</data><data key="statement">can cause</data><data key="conditions">Holds when new data differs from the original distribution and old data is not replayed.</data></edge>
    <edge id="e852" source="mlsys.incremental-training" target="mlsys.experience-replay"><data key="relation">uses</data><data key="statement">commonly mixes in</data><data key="conditions">Applies when earlier data is retained and permitted for reuse.</data></edge>
    <edge id="e853" source="mlsys.data-retention" target="mlsys.experience-replay"><data key="relation">limits</data><data key="statement">limits which past examples are available to</data><data key="conditions">Holds when retention or deletion policies remove raw training data after a fixed period.</data></edge>
    <edge id="e854" source="mlsys.process-reward-model" target="mlsys.reward-model"><data key="relation">implements</data><data key="statement">can supply the training signal of</data><data key="conditions">When step scores train the policy rather than only guide inference-time search.</data></edge>
    <edge id="e855" source="mlsys.rlvr" target="mlsys.reinforcement-learning"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">Holds when rewards come from programmatic outcome checks.</data></edge>
    <edge id="e856" source="mlsys.rlvr" target="mlsys.rl-rollout"><data key="relation">requires</data><data key="statement">requires many sampled responses from</data><data key="conditions">Holds for policy-gradient training where rewards are computed on generated outputs.</data></edge>
    <edge id="e857" source="mlsys.verifier" target="mlsys.reward-hacking"><data key="relation">causes</data><data key="statement">imperfect checks can cause</data><data key="conditions">Holds when a policy or search is optimized against a verifier with exploitable false positives.</data></edge>
    <edge id="e858" source="mlsys.best-of-n" target="mlsys.unit-cost"><data key="relation">increases</data><data key="statement">multiplies generation cost in</data><data key="conditions">Generation cost scales roughly linearly with n unless prefixes are shared.</data></edge>
    <edge id="e859" source="mlsys.best-of-n" target="mlsys.self-consistency"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Both spend parallel samples; best-of-n needs a scorer while self-consistency needs answers that can be voted on.</data></edge>
    <edge id="e860" source="mlsys.best-of-n" target="mlsys.sampling-controls"><data key="relation">requires</data><data key="statement">requires candidate diversity from</data><data key="conditions">For repeated generation with the same model and prompt when stochastic token selection supplies candidate diversity; deterministic greedy decoding with unchanged inputs repeats the same output.</data></edge>
    <edge id="e861" source="mlsys.pass-at-k" target="mlsys.metrics"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">Applies when outputs have an automatic correctness check, as in code generation.</data></edge>
    <edge id="e862" source="mlsys.sampling-controls" target="mlsys.pass-at-k"><data key="relation">determines</data><data key="statement">temperature shapes</data><data key="conditions">For a fixed model, task set, sampling procedure, and correctness criterion; the preferred temperature depends on the evaluation setting and sample budget.</data></edge>
    <edge id="e863" source="mlsys.inference-time-search" target="mlsys.unit-cost"><data key="relation">increases</data><data key="statement">multiplies per-query compute in</data><data key="conditions">Holds in proportion to the number of expanded and scored nodes.</data></edge>
    <edge id="e864" source="mlsys.inference-time-search" target="mlsys.prefix-cache"><data key="relation">uses</data><data key="statement">shares partial-solution state through</data><data key="conditions">Applies when branches share prompt and partial-solution prefixes on one server.</data></edge>
    <edge id="e865" source="mlsys.self-consistency" target="mlsys.unit-cost"><data key="relation">increases</data><data key="statement">multiplies generation cost in</data><data key="conditions">Cost scales with the number of sampled reasoning paths.</data></edge>
    <edge id="e866" source="mlsys.test-time-scaling" target="mlsys.verifier"><data key="relation">uses</data><data key="statement">uses search guided by</data><data key="conditions">Applies to the search-based way of spending inference compute, as opposed to sequential revision.</data></edge>
    <edge id="e867" source="mlsys.pairwise-preference-eval" target="mlsys.llm-judge"><data key="relation">uses</data><data key="statement">can use as the judge</data><data key="conditions">Applies when pairwise comparisons are graded by a model rather than people.</data></edge>
    <edge id="e868" source="mlsys.pairwise-preference-eval" target="mlsys.human-evaluation"><data key="relation">uses</data><data key="statement">aggregates votes from</data><data key="conditions">Holds for crowd-sourced arenas where people choose between two outputs.</data></edge>
    <edge id="e869" source="mlsys.annotator-agreement" target="mlsys.human-evaluation"><data key="relation">measures</data><data key="statement">measures reliability of</data><data key="conditions">Requires several raters to judge overlapping items.</data></edge>
    <edge id="e870" source="mlsys.evaluation-harness" target="mlsys.llm-judge"><data key="relation">uses</data><data key="statement">can score open-ended outputs with</data><data key="conditions">Applies when tasks lack exact-match references.</data></edge>
    <edge id="e871" source="mlsys.llm-judge" target="mlsys.hallucination"><data key="relation">detects</data><data key="statement">can flag</data><data key="conditions">Holds when the judge sees the source evidence and its error rate has been measured against people.</data></edge>
    <edge id="e872" source="mlsys.missing-data" target="mlsys.train-serve-skew"><data key="relation">causes</data><data key="statement">can cause</data><data key="conditions">Holds when missingness patterns or imputation differ between offline data and live requests.</data></edge>
    <edge id="e873" source="mlsys.data-validation" target="mlsys.missing-data"><data key="relation">detects</data><data key="statement">flags unexpected</data><data key="conditions">Requires declared expectations on completeness per feature.</data></edge>
    <edge id="e874" source="mlsys.data-validation" target="mlsys.data-quality"><data key="relation">measures</data><data key="statement">checks</data><data key="conditions">Covers only the properties the checks encode, not semantic correctness.</data></edge>
    <edge id="e875" source="mlsys.data-validation" target="mlsys.schema-evolution"><data key="relation">detects</data><data key="statement">flags undeclared</data><data key="conditions">Holds when incoming data is compared against the expected schema version.</data></edge>
    <edge id="e876" source="mlsys.schema-evolution" target="mlsys.train-serve-skew"><data key="relation">causes</data><data key="statement">uncoordinated changes can cause</data><data key="conditions">Holds when training and serving read different schema versions or interpret a changed field differently.</data></edge>
    <edge id="e877" source="mlsys.evaluation-split" target="mlsys.leakage"><data key="relation">mitigates</data><data key="statement">guards against</data><data key="conditions">Holds when splits respect time, entity, and duplicate boundaries.</data></edge>
    <edge id="e878" source="mlsys.evaluation-split" target="mlsys.selection-bias"><data key="relation">mitigates</data><data key="statement">keeps a final test partition free of</data><data key="conditions">Holds only if the final test partition is not used for any selection decision.</data></edge>
    <edge id="e879" source="mlsys.data-mixture" target="mlsys.data-selection"><data key="relation">part-of</data><data key="statement">records the sampling proportions chosen in</data><data key="conditions">When learning effort is allocated across data sources by weighted sampling.</data></edge>
    <edge id="e880" source="mlsys.active-learning" target="mlsys.data-selection"><data key="relation">specializes</data><data key="statement">is label-acquisition</data><data key="conditions">Applies when the cost being allocated is annotation effort.</data></edge>
    <edge id="e881" source="mlsys.weak-supervision" target="mlsys.active-learning"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Both reduce manual labeling cost; one writes labeling heuristics, the other chooses what humans label.</data></edge>
    <edge id="e882" source="mlsys.quality-filtering" target="mlsys.data-quality"><data key="relation">increases</data><data key="statement">raises average</data><data key="conditions">Holds when the filter's notion of quality matches the target task; filters can also remove useful diversity.</data></edge>
    <edge id="e883" source="mlsys.quality-filtering" target="mlsys.batch-data-processing"><data key="relation">uses</data><data key="statement">runs at corpus scale on</data><data key="conditions">Applies to web-scale pretraining corpora.</data></edge>
    <edge id="e884" source="mlsys.data-augmentation" target="mlsys.regularization"><data key="relation">specializes</data><data key="statement">acts as a form of</data><data key="conditions">Holds when transformations are label-preserving.</data></edge>
    <edge id="e885" source="mlsys.data-augmentation" target="mlsys.distribution-shift"><data key="relation">mitigates</data><data key="statement">can reduce sensitivity to</data><data key="conditions">Holds only for shifts that the chosen transformations actually model.</data></edge>
    <edge id="e886" source="mlsys.synthetic-data" target="mlsys.data-augmentation"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Both enlarge training data; augmentation transforms real examples while synthetic data generates new ones.</data></edge>
    <edge id="e887" source="mlsys.domain-randomization" target="mlsys.synthetic-data"><data key="relation">uses</data><data key="statement">generates varied</data><data key="conditions">Applies to simulator-generated training data for transfer to the real world.</data></edge>
    <edge id="e888" source="mlsys.data-acquisition" target="mlsys.distribution-shift"><data key="relation">causes</data><data key="statement">sampling bias can cause</data><data key="conditions">Holds when the collected population differs from the deployment population.</data></edge>
    <edge id="e889" source="mlsys.stream-processing" target="mlsys.batch-data-processing"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Choose by whether the data is unbounded and how fresh outputs must be.</data></edge>
    <edge id="e890" source="mlsys.online-learning" target="mlsys.stream-processing"><data key="relation">uses</data><data key="statement">consumes examples from</data><data key="conditions">Applies when updates happen as events arrive.</data></edge>
    <edge id="e891" source="mlsys.online-learning" target="mlsys.concept-drift"><data key="relation">mitigates</data><data key="statement">adapts to</data><data key="conditions">Holds when labels arrive quickly enough to track the change.</data></edge>
    <edge id="e892" source="mlsys.feature-backfill" target="mlsys.train-serve-skew"><data key="relation">mitigates</data><data key="statement">realigns history to reduce</data><data key="conditions">Holds when the backfill uses the same definition that serving computes.</data></edge>
    <edge id="e893" source="mlsys.data-versioning" target="mlsys.artifact-version"><data key="relation">part-of</data><data key="statement">is part of</data><data key="conditions">Holds when a release records the exact dataset versions it was trained and evaluated on.</data></edge>
    <edge id="e894" source="mlsys.lineage" target="mlsys.data-versioning"><data key="relation">requires</data><data key="statement">references immutable</data><data key="conditions">Lineage is only replayable if the referenced datasets are versioned.</data></edge>
    <edge id="e895" source="mlsys.batch-data-processing" target="mlsys.dataset-storage-layout"><data key="relation">uses</data><data key="statement">prunes reads through</data><data key="conditions">Holds for columnar, partitioned layouts with statistics.</data></edge>
    <edge id="e896" source="mlsys.backpressure" target="mlsys.queueing"><data key="relation">limits</data><data key="statement">bounds queue growth and</data><data key="conditions">Holds when upstream producers honor the signal rather than buffering unboundedly.</data></edge>
    <edge id="e897" source="mlsys.regularization" target="mlsys.membership-inference"><data key="relation">mitigates</data><data key="statement">reduces the overfitting exploited by</data><data key="conditions">Reduces but does not bound leakage; formal bounds need differential privacy.</data></edge>
    <edge id="e898" source="mlsys.critical-batch-size" target="mlsys.batch-size"><data key="relation">limits</data><data key="statement">bounds the useful</data><data key="conditions">Holds for a given target loss and training phase; it grows as loss falls.</data></edge>
    <edge id="e899" source="mlsys.activation-recompute" target="mlsys.execution-time"><data key="relation">increases</data><data key="statement">adds about one extra forward pass to</data><data key="conditions">Holds for full recomputation; selective schemes recompute less.</data></edge>
    <edge id="e900" source="mlsys.activation-recompute" target="mlsys.memory-offloading"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Both relieve accelerator memory; one spends compute, the other interconnect bandwidth.</data></edge>
    <edge id="e901" source="mlsys.self-supervised-learning" target="mlsys.transfer-learning"><data key="relation">enables</data><data key="statement">pretrains representations for</data><data key="conditions">Holds when the pretraining data covers the target domain.</data></edge>
    <edge id="e902" source="mlsys.self-supervised-learning" target="mlsys.embeddings"><data key="relation">produces</data><data key="statement">produces</data><data key="conditions">Applies to contrastive and masked-prediction objectives.</data></edge>
    <edge id="e903" source="mlsys.slice-discovery" target="mlsys.unsupervised-learning"><data key="relation">uses</data><data key="statement">clusters errors with</data><data key="conditions">Applies to methods that group examples without predefined slice labels.</data></edge>
    <edge id="e904" source="mlsys.slice-discovery" target="mlsys.embeddings"><data key="relation">uses</data><data key="statement">searches for coherent slices in</data><data key="conditions">Holds for embedding-based methods such as Domino.</data></edge>
    <edge id="e905" source="mlsys.rlhf" target="mlsys.reinforcement-learning"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">Holds for PPO-style optimization against a learned reward.</data></edge>
    <edge id="e906" source="mlsys.preference-optimization" target="mlsys.rlhf"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Both align to preference data; DPO skips the separate reward model and RL loop.</data></edge>
    <edge id="e907" source="mlsys.preference-optimization" target="mlsys.training-state"><data key="relation">reduces</data><data key="statement">avoids reward and value models in</data><data key="conditions">Holds relative to PPO-based RLHF; a frozen reference model is still needed.</data></edge>
    <edge id="e908" source="mlsys.reward-model" target="mlsys.labels"><data key="relation">requires</data><data key="statement">requires reliable preference</data><data key="conditions">Holds because reward accuracy is bounded by comparison label agreement.</data></edge>
    <edge id="e909" source="mlsys.vla-model" target="mlsys.imitation-learning"><data key="relation">uses</data><data key="statement">is commonly trained by</data><data key="conditions">Applies when robot demonstrations supply the action targets.</data></edge>
    <edge id="e910" source="mlsys.batch-size" target="mlsys.learning-rate-schedule"><data key="relation">determines</data><data key="statement">shifts the best peak rate of</data><data key="conditions">Holds below the critical batch size, where learning rate is typically scaled with batch.</data></edge>
    <edge id="e911" source="mlsys.hyperparameter-transfer" target="mlsys.learning-rate-schedule"><data key="relation">determines</data><data key="statement">carries tuned settings into</data><data key="conditions">Holds under a parameterization such as muP that keeps optima stable across width.</data></edge>
    <edge id="e912" source="mlsys.hyperparameter-transfer" target="mlsys.hyperparameter-search"><data key="relation">uses</data><data key="statement">runs on small proxies</data><data key="conditions">Holds when proxy models share the target's parameterization.</data></edge>
    <edge id="e913" source="mlsys.hyperparameter-search" target="mlsys.experiment-tracking"><data key="relation">uses</data><data key="statement">compares trials through</data><data key="conditions">Applies whenever more than a handful of configurations are evaluated.</data></edge>
    <edge id="e914" source="mlsys.gradient-accumulation" target="mlsys.memory-footprint"><data key="relation">reduces</data><data key="statement">reduces per-step activation</data><data key="conditions">Holds because activation memory scales with micro-batch, not effective batch.</data></edge>
    <edge id="e915" source="mlsys.gradient-accumulation" target="mlsys.collectives"><data key="relation">reduces</data><data key="statement">reduces the frequency of</data><data key="conditions">Holds when gradient all-reduce is deferred to the last micro-batch.</data></edge>
    <edge id="e916" source="mlsys.lora" target="mlsys.low-rank-factorization"><data key="relation">uses</data><data key="statement">parameterizes updates by</data><data key="conditions">Holds when the update rank is much smaller than the frozen weight dimensions.</data></edge>
    <edge id="e917" source="mlsys.weight-sync" target="mlsys.collectives"><data key="relation">uses</data><data key="statement">broadcasts weights through</data><data key="conditions">Applies when training and rollout workers sit on separate device groups.</data></edge>
    <edge id="e918" source="mlsys.weight-sync" target="mlsys.training-goodput"><data key="relation">reduces</data><data key="statement">sync time reduces</data><data key="conditions">Holds when transfers are not overlapped with rollout or training.</data></edge>
    <edge id="e919" source="mlsys.rl-rollout" target="mlsys.policy-staleness"><data key="relation">increases</data><data key="statement">asynchronous generation increases</data><data key="conditions">Holds when rollouts overlap with policy updates.</data></edge>
    <edge id="e920" source="mlsys.on-device-training" target="mlsys.peft"><data key="relation">uses</data><data key="statement">updates sparse parameter subsets via</data><data key="conditions">Applies under tight device memory where full backpropagation does not fit.</data></edge>
    <edge id="e921" source="mlsys.federated-learning" target="mlsys.on-device-training"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">Holds for cross-device federation; cross-silo clients train on servers.</data></edge>
    <edge id="e922" source="mlsys.cross-validation" target="mlsys.evaluation-split"><data key="relation">specializes</data><data key="statement">is a rotating</data><data key="conditions">Applies when data is too scarce for a single fixed validation split and examples are exchangeable.</data></edge>
    <edge id="e923" source="mlsys.conformal-prediction" target="mlsys.evaluation-split"><data key="relation">requires</data><data key="statement">requires a held-out calibration</data><data key="conditions">For split conformal methods, the calibration data are separated from score-function fitting, with the stated exchangeability assumptions required for the coverage guarantee.</data></edge>
    <edge id="e924" source="mlsys.sequential-testing" target="mlsys.rollout"><data key="relation">enables</data><data key="statement">enables early stopping of a harmful stage in</data><data key="conditions">Holds when the test's error guarantees allow continuous monitoring.</data></edge>
    <edge id="e925" source="mlsys.feedback-loop" target="mlsys.experiment-interference"><data key="relation">causes</data><data key="statement">shared retraining data can cause</data><data key="conditions">Holds when control and treatment models learn from logs that both arms influenced.</data></edge>
    <edge id="e926" source="mlsys.benchmark-contamination" target="mlsys.metrics"><data key="relation">increases</data><data key="statement">inflates</data><data key="conditions">Holds when the evaluated items or close variants were seen in training.</data></edge>
    <edge id="e927" source="mlsys.behavioral-testing" target="mlsys.metamorphic-testing"><data key="relation">uses</data><data key="statement">builds invariance and directional tests from</data><data key="conditions">Applies to CheckList-style INV and DIR tests.</data></edge>
    <edge id="e928" source="mlsys.release-gate" target="mlsys.behavioral-testing"><data key="relation">uses</data><data key="statement">can block on failures of</data><data key="conditions">Applies when capability tests are part of the predeclared checks.</data></edge>
    <edge id="e929" source="mlsys.release-gate" target="mlsys.dangerous-capability-eval"><data key="relation">uses</data><data key="statement">can block on thresholds crossed in</data><data key="conditions">Applies to frontier-model releases governed by a scaling policy.</data></edge>
    <edge id="e930" source="mlsys.admission" target="mlsys.queueing"><data key="relation">limits</data><data key="statement">bounds by shedding excess load</data><data key="conditions">Holds when rejected work is not retried immediately into the same queue.</data></edge>
    <edge id="e931" source="mlsys.admission" target="mlsys.graceful-degradation"><data key="relation">implements</data><data key="statement">implements load shedding for</data><data key="conditions">Holds when shedding low-priority work keeps the remaining requests within their SLO.</data></edge>
    <edge id="e932" source="mlsys.autoscaling" target="mlsys.utilization"><data key="relation">increases</data><data key="statement">raises average</data><data key="conditions">Holds when demand varies and scale-down is permitted.</data></edge>
    <edge id="e933" source="mlsys.paged-kv" target="mlsys.prefix-cache"><data key="relation">enables</data><data key="statement">enables block sharing for</data><data key="conditions">Holds when the allocator supports copy-on-write sharing of identical prefix blocks.</data></edge>
    <edge id="e934" source="mlsys.paged-kv" target="mlsys.service-capacity"><data key="relation">increases</data><data key="statement">raises batch size and so</data><data key="conditions">Holds when KV memory fragmentation was limiting concurrency.</data></edge>
    <edge id="e935" source="mlsys.speculative-decoding" target="mlsys.tpot"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">Holds when the draft acceptance rate is high and decode is memory-bound.</data></edge>
    <edge id="e936" source="mlsys.speculative-decoding" target="mlsys.arithmetic-intensity"><data key="relation">increases</data><data key="statement">verifies several tokens per weight read, raising</data><data key="conditions">Holds at small batch sizes where decode is memory-bound.</data></edge>
    <edge id="e937" source="mlsys.prefix-cache" target="mlsys.ttft"><data key="relation">reduces</data><data key="statement">skips recomputed prefill to reduce</data><data key="conditions">Holds when requests share long identical prefixes and the cache hits.</data></edge>
    <edge id="e938" source="mlsys.queueing" target="mlsys.ttft"><data key="relation">increases</data><data key="statement">increases</data><data key="conditions">Holds under load when requests wait for a prefill slot.</data></edge>
    <edge id="e939" source="mlsys.rag" target="mlsys.ttft"><data key="relation">increases</data><data key="statement">lengthens prompts and so</data><data key="conditions">Holds because retrieved passages add prefill tokens and retrieval adds a serial step.</data></edge>
    <edge id="e940" source="mlsys.online-inference" target="mlsys.batch-inference"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Choose by required freshness, latency, and cost per prediction.</data></edge>
    <edge id="e941" source="mlsys.online-inference" target="mlsys.model-server"><data key="relation">uses</data><data key="statement">uses</data><data key="conditions">Applies when predictions are served per request behind a network interface.</data></edge>
    <edge id="e942" source="mlsys.batch-inference" target="mlsys.unit-cost"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">Holds when predictions can be precomputed for a known input set.</data></edge>
    <edge id="e943" source="mlsys.model-server" target="mlsys.model-artifact"><data key="relation">requires</data><data key="statement">loads and executes</data><data key="conditions">Holds for any server that loads serialized weights and graph at startup or on version change.</data></edge>
    <edge id="e944" source="mlsys.multi-model-serving" target="mlsys.utilization"><data key="relation">increases</data><data key="statement">increases</data><data key="conditions">Holds when individual models have low or bursty traffic.</data></edge>
    <edge id="e945" source="mlsys.model-cascade" target="mlsys.model-routing"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Routing decides before calling a model; a cascade escalates after a cheap model's answer.</data></edge>
    <edge id="e946" source="mlsys.hedged-requests" target="mlsys.arrival-rate"><data key="relation">increases</data><data key="statement">adds duplicate load to</data><data key="conditions">Extra load stays small when hedges fire only after a high-percentile delay.</data></edge>
    <edge id="e947" source="mlsys.hedged-requests" target="mlsys.stragglers"><data key="relation">mitigates</data><data key="statement">mitigates</data><data key="conditions">Holds when slowness is replica-specific rather than shared.</data></edge>
    <edge id="e948" source="mlsys.continuous-batching" target="mlsys.paged-kv"><data key="relation">uses</data><data key="statement">relies on dynamic allocation from</data><data key="conditions">Holds for vLLM-style engines where sequences join and leave each iteration.</data></edge>
    <edge id="e949" source="mlsys.load-balancing" target="mlsys.queueing"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">Holds when load signals are fresh and replicas are interchangeable.</data></edge>
    <edge id="e950" source="mlsys.load-balancing" target="mlsys.tail-latency"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">Holds when imbalance, not total capacity, causes the tail.</data></edge>
    <edge id="e951" source="mlsys.chunked-prefill" target="mlsys.pd-disaggregation"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Both limit prefill-decode interference; one colocates with chunking, the other separates pools.</data></edge>
    <edge id="e952" source="mlsys.chunked-prefill" target="mlsys.continuous-batching"><data key="relation">uses</data><data key="statement">piggybacks prefill chunks on</data><data key="conditions">Holds when the scheduler admits work at each iteration under a per-iteration token budget.</data></edge>
    <edge id="e953" source="mlsys.constrained-decoding" target="mlsys.function-calling"><data key="relation">enables</data><data key="statement">guarantees well-formed arguments for</data><data key="conditions">The supported argument constraints are enforced during decoding and the output completes successfully; this does not establish argument truth or tool authorization.</data></edge>
    <edge id="e954" source="mlsys.function-calling" target="mlsys.grammar"><data key="relation">uses</data><data key="statement">constrains arguments with</data><data key="conditions">Applies when tool arguments must match a declared schema.</data></edge>
    <edge id="e955" source="mlsys.output-validation" target="mlsys.grammar"><data key="relation">implements</data><data key="statement">checks after generation</data><data key="conditions">Outputs are checked against the declared schema after generation, whether or not constrained decoding was used.</data></edge>
    <edge id="e956" source="mlsys.output-validation" target="mlsys.tail-latency"><data key="relation">increases</data><data key="statement">retries increase</data><data key="conditions">Validation failure triggers retries on the response’s critical path, compared with an otherwise comparable run without those retries.</data></edge>
    <edge id="e957" source="mlsys.reasoning-budget" target="mlsys.unit-cost"><data key="relation">limits</data><data key="statement">caps the reasoning share of</data><data key="conditions">Holds when reasoning tokens are billed or provisioned like output tokens.</data></edge>
    <edge id="e958" source="mlsys.reasoning-budget" target="mlsys.kv-cache"><data key="relation">limits</data><data key="statement">bounds growth of</data><data key="conditions">Holds because reasoning tokens stay in context until the answer.</data></edge>
    <edge id="e959" source="mlsys.dense-retrieval" target="mlsys.embeddings"><data key="relation">uses</data><data key="statement">uses</data><data key="conditions">Holds for bi-encoder retrieval where queries and records are embedded separately.</data></edge>
    <edge id="e960" source="mlsys.dense-retrieval" target="mlsys.retrieval"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">Applies when relevance is scored by similarity of learned vectors.</data></edge>
    <edge id="e961" source="mlsys.lexical-retrieval" target="mlsys.retrieval"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">Applies when relevance is scored by weighted term overlap over an inverted index.</data></edge>
    <edge id="e962" source="mlsys.reranking" target="mlsys.ranking-funnel"><data key="relation">part-of</data><data key="statement">is a late stage of</data><data key="conditions">Holds when a cheap candidate stage precedes a costlier scoring model under one latency budget.</data></edge>
    <edge id="e963" source="mlsys.reranking" target="mlsys.transformer"><data key="relation">uses</data><data key="statement">commonly uses cross-encoder</data><data key="conditions">Applies to neural rerankers that jointly encode query and candidate.</data></edge>
    <edge id="e964" source="mlsys.on-device-runtime" target="mlsys.model-conversion"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">Holds because runtimes accept only their own formats and operator sets.</data></edge>
    <edge id="e965" source="mlsys.on-device-runtime" target="mlsys.edge-npu"><data key="relation">uses</data><data key="statement">delegates supported operators to</data><data key="conditions">Applies when the device has an accelerator and a delegate for it.</data></edge>
    <edge id="e966" source="mlsys.ota-model-update" target="mlsys.artifact-signing"><data key="relation">requires</data><data key="statement">must verify</data><data key="conditions">Holds for any fleet where tampered models could be pushed.</data></edge>
    <edge id="e967" source="mlsys.ota-model-update" target="mlsys.rollback"><data key="relation">uses</data><data key="statement">relies on on-device</data><data key="conditions">Requires the previous model to stay on the device.</data></edge>
    <edge id="e968" source="mlsys.device-cloud-partitioning" target="mlsys.energy-per-inference"><data key="relation">reduces</data><data key="statement">can reduce on-device</data><data key="conditions">Holds when uplink cost is lower than the compute it moves off device.</data></edge>
    <edge id="e969" source="mlsys.device-heterogeneity" target="mlsys.device-cloud-partitioning"><data key="relation">determines</data><data key="statement">shifts the best split in</data><data key="conditions">Holds because device speed and network differ widely across the fleet.</data></edge>
    <edge id="e970" source="mlsys.model-registry" target="mlsys.rollback"><data key="relation">enables</data><data key="statement">keeps prior versions available for</data><data key="conditions">Holds when prior versions and their serving configuration remain registered and deployable.</data></edge>
    <edge id="e971" source="mlsys.shadow-deployment" target="mlsys.train-serve-skew"><data key="relation">detects</data><data key="statement">can expose</data><data key="conditions">Holds when shadow outputs are compared with offline predictions on the same inputs.</data></edge>
    <edge id="e972" source="mlsys.shadow-deployment" target="mlsys.unit-cost"><data key="relation">increases</data><data key="statement">duplicates inference cost in</data><data key="conditions">Holds for the shadow period because every mirrored request runs on both models.</data></edge>
    <edge id="e973" source="mlsys.ml-ci-cd" target="mlsys.integration-testing"><data key="relation">uses</data><data key="statement">runs</data><data key="conditions">Applies on each change to code, data checks, or model artifacts.</data></edge>
    <edge id="e974" source="mlsys.ml-ci-cd" target="mlsys.mlops-maturity"><data key="relation">part-of</data><data key="statement">marks higher levels of</data><data key="conditions">Holds for maturity models in which automated pipeline delivery defines the top level.</data></edge>
    <edge id="e975" source="mlsys.drift-detection" target="mlsys.monitoring"><data key="relation">part-of</data><data key="statement">is part of</data><data key="conditions">Applies when distribution checks run alongside service and quality signals in production.</data></edge>
    <edge id="e976" source="mlsys.drift-detection" target="mlsys.inference-logging"><data key="relation">requires</data><data key="statement">compares distributions from</data><data key="conditions">Holds because production distributions are reconstructed from logged inputs and predictions.</data></edge>
    <edge id="e977" source="mlsys.delayed-outcomes" target="mlsys.drift-detection"><data key="relation">limits</data><data key="statement">limits outcome-based</data><data key="conditions">Holds when labels arrive late; input-distribution checks remain available.</data></edge>
    <edge id="e978" source="mlsys.alerting" target="mlsys.sli"><data key="relation">uses</data><data key="statement">fires on thresholds over</data><data key="conditions">Applies when alerts are defined over user-facing indicators rather than raw resource metrics.</data></edge>
    <edge id="e979" source="mlsys.concept-drift" target="mlsys.distribution-shift"><data key="relation">specializes</data><data key="statement">is the input-target form of</data><data key="conditions">Holds when P(y|x) changes even if the input distribution does not.</data></edge>
    <edge id="e980" source="mlsys.workflow-orchestration" target="mlsys.continuous-training"><data key="relation">implements</data><data key="statement">runs the pipelines of</data><data key="conditions">Holds when retraining, validation, and registration steps run as an orchestrated pipeline.</data></edge>
    <edge id="e981" source="mlsys.postmortem" target="mlsys.failure-attribution"><data key="relation">uses</data><data key="statement">uses</data><data key="conditions">Applies to ML incidents whose cause could lie in data, model, code, or infrastructure.</data></edge>
    <edge id="e982" source="mlsys.failure-attribution" target="mlsys.lineage"><data key="relation">uses</data><data key="statement">traces data and artifact versions through</data><data key="conditions">Holds when the failing prediction can be tied to the data and artifact versions that produced it.</data></edge>
    <edge id="e983" source="mlsys.distributed-tracing" target="mlsys.failure-attribution"><data key="relation">enables</data><data key="statement">localizes the component behind</data><data key="conditions">Holds when every component a request traverses propagates the trace context.</data></edge>
    <edge id="e984" source="mlsys.llm-call-tracing" target="mlsys.cost-attribution"><data key="relation">enables</data><data key="statement">attributes token spend per step for</data><data key="conditions">Holds when spans record token counts and model identity per call.</data></edge>
    <edge id="e985" source="mlsys.model-deprecation" target="mlsys.lineage"><data key="relation">requires</data><data key="statement">finds downstream consumers through</data><data key="conditions">Holds when lineage records which downstream jobs and services read the model's outputs.</data></edge>
    <edge id="e986" source="mlsys.artifact-archival" target="mlsys.model-deprecation"><data key="relation">part-of</data><data key="statement">is the final stage of</data><data key="conditions">Applies when a retired model must stay reproducible or auditable after removal from service.</data></edge>
    <edge id="e987" source="mlsys.artifact-archival" target="mlsys.algorithmic-audit"><data key="relation">enables</data><data key="statement">preserves evidence for</data><data key="conditions">Holds when evaluation records and data references are kept for the audit horizon.</data></edge>
    <edge id="e988" source="mlsys.kv-cache-offload" target="mlsys.storage-tiering"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">Applies when KV blocks move between accelerator memory, host memory, and SSD by reuse likelihood.</data></edge>
    <edge id="e989" source="mlsys.kv-cache-transfer" target="mlsys.rdma"><data key="relation">uses</data><data key="statement">uses</data><data key="conditions">Applies in disaggregated clusters with RDMA fabrics.</data></edge>
    <edge id="e990" source="mlsys.kv-cache-transfer" target="mlsys.communication-overlap"><data key="relation">uses</data><data key="statement">hides latency with</data><data key="conditions">Holds when layer-wise KV transfer can proceed while later layers still compute.</data></edge>
    <edge id="e991" source="mlsys.lm-program-optimization" target="mlsys.metrics"><data key="relation">requires</data><data key="statement">optimizes against an end-to-end</data><data key="conditions">Holds because the optimizer can only improve what the declared metric scores.</data></edge>
    <edge id="e992" source="mlsys.multi-adapter-serving" target="mlsys.unit-cost"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">Holds relative to one dedicated deployment per fine-tuned model.</data></edge>
    <edge id="e993" source="mlsys.denoising-step-reduction" target="mlsys.distillation"><data key="relation">uses</data><data key="statement">often uses step</data><data key="conditions">Applies to progressive and consistency distillation, not to training-free fast samplers.</data></edge>
    <edge id="e994" source="mlsys.denoising-step-reduction" target="mlsys.execution-time"><data key="relation">reduces</data><data key="statement">reduces per-sample</data><data key="conditions">Holds roughly in proportion to the number of network evaluations removed.</data></edge>
    <edge id="e995" source="mlsys.diffusion-feature-caching" target="mlsys.memory-footprint"><data key="relation">increases</data><data key="statement">increases cached-activation</data><data key="conditions">Holds because cached features from earlier steps must stay resident.</data></edge>
    <edge id="e996" source="mlsys.diffusion-feature-caching" target="mlsys.execution-time"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">Holds when adjacent-step features change little, so skipped blocks lose little quality.</data></edge>
    <edge id="e997" source="mlsys.quantized-vector-index" target="mlsys.memory-footprint"><data key="relation">reduces</data><data key="statement">compresses vectors to reduce</data><data key="conditions">Vectors are stored as shorter quantized codes rather than full-precision coordinates; recall depends on quantization, partition probing, reranking, and the data.</data></edge>
    <edge id="e998" source="mlsys.filtered-vector-search" target="mlsys.graph-vector-index"><data key="relation">uses</data><data key="statement">extends traversal of</data><data key="conditions">Applies to predicate-agnostic methods that densify a proximity graph to keep filtered recall.</data></edge>
    <edge id="e999" source="mlsys.index-freshness" target="mlsys.retrieval"><data key="relation">limits</data><data key="statement">bounds recall on recently changed records in</data><data key="conditions">Holds when inserts and deletes reach the index later than the source of truth.</data></edge>
    <edge id="e1000" source="mlsys.agent-evaluation" target="mlsys.llm-judge"><data key="relation">uses</data><data key="statement">can grade trajectories with</data><data key="conditions">Applies where task success lacks a programmatic check.</data></edge>
    <edge id="e1001" source="mlsys.deterministic-replay" target="mlsys.agent-evaluation"><data key="relation">enables</data><data key="statement">makes repeatable</data><data key="conditions">Holds when tool responses and model outputs are recorded so a run can be re-executed exactly.</data></edge>
    <edge id="e1002" source="mlsys.critical-batch-size" target="mlsys.time-to-train"><data key="relation">limits</data><data key="statement">bounds the data-parallel speedup of</data><data key="conditions">Holds because beyond it more examples per step no longer cut the steps needed to reach the target loss.</data></edge>
    <edge id="e1003" source="mlsys.distillation" target="mlsys.memory-footprint"><data key="relation">reduces</data><data key="statement">reduces the serving memory footprint by producing a smaller student</data><data key="conditions">When the student architecture is smaller than the teacher and reaches acceptable quality on the target metric.</data></edge>
    <edge id="e1004" source="mlsys.distillation" target="mlsys.speculative-decoding"><data key="relation">enables</data><data key="statement">produces well-aligned draft models for</data><data key="conditions">When the draft is distilled from the target model so its token distribution matches closely enough to raise acceptance rates.</data></edge>
    <edge id="e1005" source="mlsys.pruning" target="mlsys.memory-footprint"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">When the pruned weights are stored in a compressed or smaller dense form rather than as explicit zeros.</data></edge>
    <edge id="e1006" source="mlsys.structured-pruning" target="mlsys.execution-time"><data key="relation">reduces</data><data key="statement">reduces dense-hardware</data><data key="conditions">When whole channels, filters, or heads are removed so the remaining layers are smaller dense operations.</data></edge>
    <edge id="e1007" source="mlsys.low-rank-factorization" target="mlsys.memory-footprint"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">When the chosen rank is much smaller than the matrix dimensions and the factored model keeps acceptable accuracy.</data></edge>
    <edge id="e1008" source="mlsys.quantization-aware-training" target="mlsys.post-training-quantization"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">QAT recovers more accuracy at low bit widths but needs a training run; PTQ needs only a calibration set.</data></edge>
    <edge id="e1009" source="mlsys.neural-architecture-search" target="mlsys.efficiency-frontier"><data key="relation">determines</data><data key="statement">searches for points on</data><data key="conditions">When the search objective combines quality and a stated cost measure on the target platform.</data></edge>
    <edge id="e1010" source="mlsys.hardware-aware-nas" target="mlsys.analytical-performance-model"><data key="relation">uses</data><data key="statement">uses latency predictors from</data><data key="conditions">When on-device measurement of every candidate is too slow, so a calibrated cost model ranks candidates.</data></edge>
    <edge id="e1011" source="mlsys.model-hardware-co-design" target="mlsys.nm-sparsity"><data key="relation">enables</data><data key="statement">enables</data><data key="conditions">When the sparsity pattern is chosen to match a sparse matrix-engine instruction, as with 2:4 sparsity on sparse tensor cores.</data></edge>
    <edge id="e1012" source="mlsys.weight-only-quantization" target="mlsys.tpot"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">When small-batch decoding is memory-bandwidth-bound and dequantization is fused into the matrix multiply.</data></edge>
    <edge id="e1013" source="mlsys.weight-only-quantization" target="mlsys.activation-outliers"><data key="relation">mitigates</data><data key="statement">sidesteps</data><data key="conditions">Because activations stay in higher precision, outlier channels never enter a low-bit activation range.</data></edge>
    <edge id="e1014" source="mlsys.transformer" target="mlsys.activation-outliers"><data key="relation">produces</data><data key="statement">develops, at scale,</data><data key="conditions">In large transformers, roughly beyond a few billion parameters, where a few hidden dimensions carry systematic large-magnitude activations.</data></edge>
    <edge id="e1015" source="mlsys.kv-cache-quantization" target="mlsys.tpot"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">When long-context decoding time is dominated by reading the KV cache from memory.</data></edge>
    <edge id="e1016" source="mlsys.kv-cache-quantization" target="mlsys.batching"><data key="relation">enables</data><data key="statement">raises the feasible batch size of</data><data key="conditions">When serving is KV-memory-bound, so freed capacity admits more concurrent sequences.</data></edge>
    <edge id="e1017" source="mlsys.training-goodput" target="mlsys.time-to-train"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">For a fixed model, data, and quality target, since lost and redone work lengthens wall-clock time.</data></edge>
    <edge id="e1018" source="mlsys.inference-load-scenario" target="mlsys.batching"><data key="relation">determines</data><data key="statement">determines the admissible</data><data key="conditions">Offline scenarios permit large batches; server and single-stream scenarios limit batching by their latency constraint.</data></edge>
    <edge id="e1019" source="mlsys.inference-load-scenario" target="mlsys.arrival-rate"><data key="relation">uses</data><data key="statement">specifies the query</data><data key="conditions">In server scenarios, where queries arrive by a stated random process at a target rate.</data></edge>
    <edge id="e1020" source="mlsys.activation-recompute" target="mlsys.model-flops-utilization"><data key="relation">reduces</data><data key="statement">lowers measured</data><data key="conditions">Because recomputed FLOPs are excluded from MFU's model-required count, so MFU falls while hardware FLOPs utilization rises.</data></edge>
    <edge id="e1021" source="mlsys.bottleneck-analysis" target="mlsys.bound-regime"><data key="relation">detects</data><data key="statement">identifies the operating</data><data key="conditions">When per-kernel time, FLOPs, and bytes are measured, so each kernel can be placed relative to the ridge point.</data></edge>
    <edge id="e1022" source="mlsys.job-preemption" target="mlsys.training-goodput"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">When preempted work since the last checkpoint is lost and restart costs are paid on resumption.</data></edge>
    <edge id="e1023" source="mlsys.benchmark" target="mlsys.energy-measurement"><data key="relation">uses</data><data key="statement">uses</data><data key="conditions">For energy or power benchmarks, which must declare sensor class, sampling, and system boundary to be comparable.</data></edge>
    <edge id="e1024" source="mlsys.consistent-cut" target="mlsys.checkpoint-resharding"><data key="relation">enables</data><data key="statement">enables</data><data key="conditions">A sharded checkpoint can be remapped to a new layout only when all shards were saved from the same training step.</data></edge>
    <edge id="e1025" source="mlsys.async-checkpointing" target="mlsys.consistent-cut"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">When every rank snapshots its shard at the same step boundary before background persistence begins.</data></edge>
    <edge id="e1026" source="mlsys.async-checkpointing" target="mlsys.training-goodput"><data key="relation">increases</data><data key="statement">increases</data><data key="conditions">When the blocking snapshot is much cheaper than the durable write, so training stalls less per checkpoint.</data></edge>
    <edge id="e1027" source="mlsys.circuit-breaker" target="mlsys.graceful-degradation"><data key="relation">enables</data><data key="statement">enables</data><data key="conditions">When an open breaker routes requests to a fallback response rather than returning errors.</data></edge>
    <edge id="e1028" source="mlsys.circuit-breaker" target="mlsys.arrival-rate"><data key="relation">reduces</data><data key="statement">cuts the request rate reaching a failing dependency, lowering its</data><data key="conditions">While the breaker is open, which gives the overloaded dependency time to recover.</data></edge>
    <edge id="e1029" source="mlsys.replication-failover" target="mlsys.fencing"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">When a failed-over primary may still be alive, so stale writers must be fenced to avoid split brain.</data></edge>
    <edge id="e1030" source="mlsys.replication-failover" target="mlsys.tco"><data key="relation">increases</data><data key="statement">increases</data><data key="conditions">Redundant replicas add capital and operating cost in proportion to the replication factor.</data></edge>
    <edge id="e1031" source="mlsys.mtbf" target="mlsys.training-goodput"><data key="relation">limits</data><data key="statement">bounds</data><data key="conditions">For large synchronous jobs, where job MTBF shrinks with component count and each failure costs rework plus restart.</data></edge>
    <edge id="e1032" source="mlsys.distributed-tracing" target="mlsys.gray-failure"><data key="relation">detects</data><data key="statement">detects</data><data key="conditions">When traces record the latency and errors that callers actually experience rather than health-check results.</data></edge>
    <edge id="e1033" source="mlsys.network-topology" target="mlsys.failure-domain"><data key="relation">determines</data><data key="statement">helps determine network-related</data><data key="conditions">Components depend on shared network elements; power, software, and other dependencies may define additional or overlapping failure domains.</data></edge>
    <edge id="e1034" source="mlsys.abft" target="mlsys.matrix-multiply"><data key="relation">uses</data><data key="statement">carries checksums through</data><data key="conditions">For linear-algebra kernels whose input checksums predict output checksums.</data></edge>
    <edge id="e1035" source="mlsys.abft" target="mlsys.execution-time"><data key="relation">increases</data><data key="statement">adds checksum overhead to</data><data key="conditions">The overhead is small relative to large matrix multiplications but nonzero.</data></edge>
    <edge id="e1036" source="mlsys.game-day" target="mlsys.alerting"><data key="relation">measures</data><data key="statement">tests whether alerts fire and reach responders through</data><data key="conditions">When the exercise uses real paging and runbook paths.</data></edge>
    <edge id="e1037" source="mlsys.hardware-fault-injection" target="mlsys.failure-injection"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">When the injected faults are bit flips or stuck-at errors in model state rather than service-level faults.</data></edge>
    <edge id="e1038" source="mlsys.rollout" target="mlsys.blast-radius"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">When each stage exposes a small fraction of traffic and gates promotion on health signals.</data></edge>
    <edge id="e1039" source="mlsys.least-privilege" target="mlsys.blast-radius"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">When a compromised or faulty component holds only the permissions its task requires.</data></edge>
    <edge id="e1040" source="mlsys.transfer-learning" target="mlsys.backdoor"><data key="relation">increases</data><data key="statement">increases exposure to</data><data key="conditions">When pretrained weights come from untrusted parties, since backdoors can survive fine-tuning on clean data.</data></edge>
    <edge id="e1041" source="mlsys.guardrails" target="mlsys.jailbreak"><data key="relation">mitigates</data><data key="statement">partially mitigates</data><data key="conditions">Input and output classifiers catch known patterns but can be evaded by novel or obfuscated prompts.</data></edge>
    <edge id="e1042" source="mlsys.rlhf" target="mlsys.jailbreak"><data key="relation">mitigates</data><data key="statement">partially mitigates</data><data key="conditions">Safety training reduces disallowed outputs but fails under competing objectives and mismatched generalization.</data></edge>
    <edge id="e1043" source="mlsys.adversarial-training" target="mlsys.time-to-train"><data key="relation">increases</data><data key="statement">increases</data><data key="conditions">Each training step runs an inner attack, multiplying compute by roughly the number of attack steps.</data></edge>
    <edge id="e1044" source="mlsys.distillation" target="mlsys.model-watermarking"><data key="relation">limits</data><data key="statement">can strip parameter-embedded</data><data key="conditions">For watermarks embedded in weights rather than in behavior on trigger inputs, since a distilled student has new weights.</data></edge>
    <edge id="e1045" source="mlsys.artifact-signing" target="mlsys.supply-chain-compromise"><data key="relation">mitigates</data><data key="statement">mitigates</data><data key="conditions">When consumers verify signatures and provenance against trusted identities before loading artifacts.</data></edge>
    <edge id="e1046" source="mlsys.model-registry" target="mlsys.artifact-signing"><data key="relation">uses</data><data key="statement">uses</data><data key="conditions">When the registry signs artifacts on promotion and verifies them before deployment.</data></edge>
    <edge id="e1047" source="mlsys.isolation" target="mlsys.unsafe-deserialization"><data key="relation">mitigates</data><data key="statement">contains the effects of</data><data key="conditions">When untrusted model files are loaded inside a sandbox with no credentials or network access.</data></edge>
    <edge id="e1048" source="mlsys.generalization" target="mlsys.membership-inference"><data key="relation">reduces</data><data key="statement">lowers the advantage of</data><data key="conditions">Attack advantage grows with the train-test generalization gap, so better-generalizing models leak less membership signal.</data></edge>
    <edge id="e1049" source="mlsys.dp-sgd" target="mlsys.model-inversion"><data key="relation">mitigates</data><data key="statement">mitigates</data><data key="conditions">For reconstruction of individual training records; inference of population-level attributes is not bounded by DP.</data></edge>
    <edge id="e1050" source="mlsys.secure-aggregation" target="mlsys.model-inversion"><data key="relation">mitigates</data><data key="statement">blocks gradient-based</data><data key="conditions">When the server could otherwise reconstruct a client's data from its individual update.</data></edge>
    <edge id="e1051" source="mlsys.data-retention" target="mlsys.machine-unlearning"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">When deletion obligations extend to models trained on the deleted records.</data></edge>
    <edge id="e1052" source="mlsys.remote-attestation" target="mlsys.supply-chain-compromise"><data key="relation">detects</data><data key="statement">detects</data><data key="conditions">For platform firmware or software whose measured state differs from trusted reference values.</data></edge>
    <edge id="e1053" source="mlsys.multi-tenancy" target="mlsys.side-channel"><data key="relation">increases</data><data key="statement">increases exposure to</data><data key="conditions">When tenants share accelerators, caches, memory, or interconnect whose contention is observable.</data></edge>
    <edge id="e1054" source="mlsys.side-channel" target="mlsys.privacy-leakage"><data key="relation">causes</data><data key="statement">can cause</data><data key="conditions">When observed timing, power, or memory behavior correlates with secret inputs or model parameters.</data></edge>
    <edge id="e1055" source="mlsys.he-inference" target="mlsys.execution-time"><data key="relation">increases</data><data key="statement">multiplies</data><data key="conditions">Homomorphic evaluation costs orders of magnitude more compute than plaintext inference, especially for nonlinear layers.</data></edge>
    <edge id="e1056" source="mlsys.secure-computation-inference" target="mlsys.execution-time"><data key="relation">increases</data><data key="statement">increases</data><data key="conditions">Latency is dominated by communication rounds and garbled-circuit evaluation of nonlinear layers.</data></edge>
    <edge id="e1057" source="mlsys.pue" target="mlsys.operational-carbon"><data key="relation">increases</data><data key="statement">multiplies IT energy into</data><data key="conditions">Facility overhead for cooling and power conversion scales IT energy by PUE before carbon intensity applies.</data></edge>
    <edge id="e1058" source="mlsys.emission-scopes" target="mlsys.operational-carbon"><data key="relation">determines</data><data key="statement">classifies purchased-electricity emissions (Scope 2) in</data><data key="conditions">For an operator buying grid electricity under the GHG Protocol.</data></edge>
    <edge id="e1059" source="mlsys.lifecycle-assessment" target="mlsys.water-footprint"><data key="relation">measures</data><data key="statement">measures</data><data key="conditions">When the assessment's inventory includes on-site cooling and off-site generation water.</data></edge>
    <edge id="e1060" source="mlsys.lifecycle-assessment" target="mlsys.e-waste"><data key="relation">measures</data><data key="statement">accounts end-of-life impacts of</data><data key="conditions">When the system boundary includes disposal and recycling stages.</data></edge>
    <edge id="e1061" source="mlsys.spot-capacity" target="mlsys.tco"><data key="relation">reduces</data><data key="statement">reduces</data><data key="conditions">When workloads tolerate preemption through checkpointing or elasticity so the discount is not lost to rework.</data></edge>
    <edge id="e1062" source="mlsys.model-routing" target="mlsys.cost-per-token"><data key="relation">reduces</data><data key="statement">lowers the average</data><data key="conditions">When a router sends requests a cheaper model can handle to that model while meeting the quality target.</data></edge>
    <edge id="e1063" source="mlsys.multi-tenancy" target="mlsys.cost-attribution"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">When shared infrastructure must be charged back to the teams or workloads that consume it.</data></edge>
    <edge id="e1064" source="mlsys.cost-attribution" target="mlsys.idle-dynamic-power"><data key="relation">uses</data><data key="statement">allocates shared idle cost using</data><data key="conditions">When provisioned but idle capacity must be charged to owners by an explicit rule.</data></edge>
    <edge id="e1065" source="mlsys.idle-dynamic-power" target="mlsys.energy-efficiency"><data key="relation">determines</data><data key="statement">determines</data><data key="conditions">At low load, idle power dominates, so poorly energy-proportional hardware loses efficiency.</data></edge>
    <edge id="e1066" source="mlsys.stpa" target="mlsys.feedback-control"><data key="relation">uses</data><data key="statement">models the system as</data><data key="conditions">STPA represents the system as controllers, control actions, and feedback paths.</data></edge>
    <edge id="e1067" source="mlsys.fmea" target="mlsys.failure-model"><data key="relation">uses</data><data key="statement">enumerates component failure modes from</data><data key="conditions">FMEA is bottom-up over declared component failure modes.</data></edge>
    <edge id="e1068" source="mlsys.functional-safety" target="mlsys.hazard-analysis"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">ISO 26262 requires hazard analysis and risk assessment before safety goals are set.</data></edge>
    <edge id="e1069" source="mlsys.functional-safety" target="mlsys.safety-integrity-level"><data key="relation">uses</data><data key="statement">uses</data><data key="conditions">Safety goals are assigned an integrity level, such as an ASIL, that sets development rigor.</data></edge>
    <edge id="e1070" source="mlsys.functional-safety" target="mlsys.fmea"><data key="relation">uses</data><data key="statement">uses</data><data key="conditions">When component failure modes must be traced to effects on safety goals.</data></edge>
    <edge id="e1071" source="mlsys.safety-filter" target="mlsys.model-predictive-control"><data key="relation">uses</data><data key="statement">uses</data><data key="conditions">For predictive safety filters that solve a constrained finite-horizon problem to find the nearest safe action.</data></edge>
    <edge id="e1072" source="mlsys.control-barrier-function" target="mlsys.dynamics"><data key="relation">requires</data><data key="statement">requires a model of</data><data key="conditions">The barrier condition holds only under the modeled dynamics and bounded disturbance.</data></edge>
    <edge id="e1073" source="mlsys.simplex-architecture" target="mlsys.mixed-criticality"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">The verified safety controller and decision module must keep their timing even when the complex controller overruns.</data></edge>
    <edge id="e1074" source="mlsys.minimal-risk-condition" target="mlsys.graceful-degradation"><data key="relation">part-of</data><data key="statement">can be the final stage of</data><data key="conditions">When degradation in a physical system proceeds to a safe stop.</data></edge>
    <edge id="e1075" source="mlsys.minimal-risk-condition" target="mlsys.authority-handover"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">When the system can no longer operate safely, it can either hand control to a human or reach a minimal-risk state itself.</data></edge>
    <edge id="e1076" source="mlsys.operating-domain" target="mlsys.scenario-based-testing"><data key="relation">determines</data><data key="statement">scopes the scenario catalog of</data><data key="conditions">Scenarios and parameter ranges are drawn from the declared operational design domain.</data></edge>
    <edge id="e1077" source="mlsys.safety-case" target="mlsys.scenario-based-testing"><data key="relation">uses</data><data key="statement">draws coverage evidence from</data><data key="conditions">When scenario coverage is traced to hazards and operating-domain conditions.</data></edge>
    <edge id="e1078" source="mlsys.falsification" target="mlsys.rare-event-validation"><data key="relation">enables</data><data key="statement">enables</data><data key="conditions">Failure regions found by falsification can seed importance sampling for failure-probability estimates.</data></edge>
    <edge id="e1079" source="mlsys.falsification" target="mlsys.formal-verification"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">For systems too complex for formal proof, where searching for counterexamples replaces proving their absence.</data></edge>
    <edge id="e1080" source="mlsys.neural-network-verification" target="mlsys.robustness-evaluation"><data key="relation">alternative-to</data><data key="statement">is a certified alternative to empirical</data><data key="conditions">For properties over input regions small enough for the verifier to scale.</data></edge>
    <edge id="e1081" source="mlsys.statistical-uncertainty" target="mlsys.rare-event-validation"><data key="relation">limits</data><data key="statement">limits the confidence achievable in</data><data key="conditions">When the number of observed failures is small, confidence bounds dominate the estimate.</data></edge>
    <edge id="e1082" source="mlsys.xil-testing" target="mlsys.feedback-delay"><data key="relation">measures</data><data key="statement">measures</data><data key="conditions">When the real compute and hardware run in the loop, exposing timing that pure simulation omits.</data></edge>
    <edge id="e1083" source="mlsys.xil-testing" target="mlsys.integration-testing"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">Each rung tests the assembled software or hardware against a simulated or recorded environment.</data></edge>
    <edge id="e1084" source="mlsys.goal-structuring-notation" target="mlsys.algorithmic-audit"><data key="relation">enables</data><data key="statement">enables</data><data key="conditions">When auditors review the assurance argument, not only its evidence artifacts.</data></edge>
    <edge id="e1085" source="mlsys.compensation" target="mlsys.rollback"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Rollback restores software or configuration state; compensation remedies effects when such a reversal is unavailable.</data></edge>
    <edge id="e1086" source="mlsys.runtime-assurance" target="mlsys.stopping-envelope"><data key="relation">uses</data><data key="statement">checks the current state against</data><data key="conditions">When the fallback is a stop and the monitor runs fast enough to trigger it before the state leaves the envelope.</data></edge>
    <edge id="e1087" source="mlsys.hardware-fault-injection" target="mlsys.abft"><data key="relation">measures</data><data key="statement">measures the detection coverage of</data><data key="conditions">When injected faults hit the operations the checksums protect, at realistic rates and locations.</data></edge>
    <edge id="e1088" source="mlsys.individual-fairness" target="mlsys.fairness"><data key="relation">alternative-to</data><data key="statement">states fairness over similar individuals rather than across groups as in</data><data key="conditions">When a system must choose which fairness notion to enforce or audit.</data></edge>
    <edge id="e1089" source="mlsys.individual-fairness" target="mlsys.decision-policy"><data key="relation">limits</data><data key="statement">constrains</data><data key="conditions">When a task-specific similarity metric is declared and accepted by stakeholders.</data></edge>
    <edge id="e1090" source="mlsys.fairness-incompatibility" target="mlsys.calibration"><data key="relation">limits</data><data key="statement">limits per-group</data><data key="conditions">When base rates differ and error-rate parity is also required.</data></edge>
    <edge id="e1091" source="mlsys.fairness-incompatibility" target="mlsys.fairness"><data key="relation">limits</data><data key="statement">limits which criteria can jointly hold in</data><data key="conditions">When base rates differ across groups and the predictor is imperfect.</data></edge>
    <edge id="e1092" source="mlsys.bias-mitigation" target="mlsys.fairness"><data key="relation">implements</data><data key="statement">implements</data><data key="conditions">When the intervention targets a declared criterion and is re-evaluated on held-out data.</data></edge>
    <edge id="e1093" source="mlsys.bias-mitigation" target="mlsys.data-selection"><data key="relation">uses</data><data key="statement">uses reweighting and resampling from</data><data key="conditions">For pre-processing methods that change the training distribution across groups.</data></edge>
    <edge id="e1094" source="mlsys.feature-attribution" target="mlsys.leakage"><data key="relation">detects</data><data key="statement">detects</data><data key="conditions">When a feature unavailable at prediction time dominates attributions.</data></edge>
    <edge id="e1095" source="mlsys.counterfactual-explanation" target="mlsys.feature-attribution"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Both explain one decision post hoc; counterfactuals give actionable changes, attributions give per-feature contributions.</data></edge>
    <edge id="e1096" source="mlsys.interpretable-model" target="mlsys.contestability"><data key="relation">enables</data><data key="statement">enables</data><data key="conditions">When affected people or reviewers can read the decision logic that produced their outcome.</data></edge>
    <edge id="e1097" source="mlsys.interpretable-model" target="mlsys.algorithmic-audit"><data key="relation">enables</data><data key="statement">enables</data><data key="conditions">When auditors can inspect the model directly instead of relying on post-hoc approximations.</data></edge>
    <edge id="e1098" source="mlsys.model-registry" target="mlsys.model-card"><data key="relation">uses</data><data key="statement">stores and versions</data><data key="conditions">When documentation is required for promotion alongside the model artifact.</data></edge>
    <edge id="e1099" source="mlsys.algorithmic-audit" target="mlsys.datasheet"><data key="relation">uses</data><data key="statement">draws evidence from</data><data key="conditions">Datasheets document data provenance and composition but do not replace access to the data.</data></edge>
    <edge id="e1100" source="mlsys.automation-bias" target="mlsys.approval-gate"><data key="relation">limits</data><data key="statement">can reduce to rubber stamps</data><data key="conditions">When reviewers see many correct proposals, weak error cues, and time pressure.</data></edge>
    <edge id="e1101" source="mlsys.automation-bias" target="mlsys.authority-handover"><data key="relation">limits</data><data key="statement">can degrade</data><data key="conditions">When operators lose vigilance and manual skill during long automated stretches.</data></edge>
    <edge id="e1102" source="mlsys.ai-risk-management" target="mlsys.red-teaming"><data key="relation">uses</data><data key="statement">uses</data><data key="conditions">When red-team findings feed the measure and manage functions of the risk process.</data></edge>
    <edge id="e1103" source="mlsys.risk-tiered-regulation" target="mlsys.impact-assessment"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">For deployers of high-risk systems in categories where a fundamental-rights impact assessment is required.</data></edge>
    <edge id="e1104" source="mlsys.impact-assessment" target="mlsys.fairness"><data key="relation">determines</data><data key="statement">identifies the affected groups and criteria for</data><data key="conditions">When the assessment precedes deployment and is revisited after material changes.</data></edge>
    <edge id="e1105" source="mlsys.planning" target="mlsys.inference-time-search"><data key="relation">uses</data><data key="statement">uses</data><data key="conditions">When the agent expands and scores alternative partial plans rather than committing to one chain.</data></edge>
    <edge id="e1106" source="mlsys.agent-evaluation" target="mlsys.planning"><data key="relation">measures</data><data key="statement">measures plan quality through</data><data key="conditions">When intermediate steps, not only final outcomes, are scored across the trajectory.</data></edge>
    <edge id="e1107" source="mlsys.agent-budget" target="mlsys.planning"><data key="relation">limits</data><data key="statement">bounds the search depth of</data><data key="conditions">When turn, token, or time limits cap how many alternatives a plan can explore.</data></edge>
    <edge id="e1108" source="mlsys.tool-contract" target="mlsys.idempotency"><data key="relation">uses</data><data key="statement">declares retry safety in terms of</data><data key="conditions">When the contract states an idempotency key or at-most-once semantics so the harness can decide whether a re-issued call is safe.</data></edge>
    <edge id="e1109" source="mlsys.robot-perception" target="mlsys.sensing"><data key="relation">requires</data><data key="statement">requires calibrated</data><data key="conditions">Detections and depth are only as accurate as the intrinsic, extrinsic, and timing calibration of the sensors.</data></edge>
    <edge id="e1110" source="mlsys.sensor-fusion" target="mlsys.state-observability"><data key="relation">increases</data><data key="statement">increases</data><data key="conditions">When an added modality measures a state the others cannot distinguish, such as scale for monocular vision.</data></edge>
    <edge id="e1111" source="mlsys.state-observability" target="mlsys.slam"><data key="relation">limits</data><data key="statement">bounds drift correction in</data><data key="conditions">Absolute pose and heading are unobservable from relative measurements alone, so drift persists without loop closure or external references.</data></edge>
    <edge id="e1112" source="mlsys.contact-compliance" target="mlsys.sim-to-real"><data key="relation">limits</data><data key="statement">can widen the gap in</data><data key="conditions">Contact forces depend on stiffness, friction, and geometry that simulators approximate poorly.</data></edge>
    <edge id="e1113" source="mlsys.model-context-protocol" target="mlsys.prompt-injection"><data key="relation">increases</data><data key="statement">widens the surface for</data><data key="conditions">When tool descriptions and results from third-party servers enter the model's context as if trusted.</data></edge>
    <edge id="e1114" source="mlsys.model-context-protocol" target="mlsys.authorization"><data key="relation">uses</data><data key="statement">uses</data><data key="conditions">When servers require scoped, delegated credentials before exposing tools or resources.</data></edge>
    <edge id="e1115" source="mlsys.agent-evaluation" target="mlsys.computer-use"><data key="relation">measures</data><data key="statement">measures</data><data key="conditions">When tasks run in real applications and success is checked from the resulting system state.</data></edge>
    <edge id="e1116" source="mlsys.agent-harness" target="mlsys.function-calling"><data key="relation">uses</data><data key="statement">dispatches tool actions through</data><data key="conditions">When the model emits structured calls that the harness validates and executes.</data></edge>
    <edge id="e1117" source="mlsys.agent-harness" target="mlsys.agent-budget"><data key="relation">uses</data><data key="statement">enforces stopping rules from</data><data key="conditions">The harness, not the model, applies turn, token, time, and spend limits.</data></edge>
    <edge id="e1118" source="mlsys.agent-budget" target="mlsys.trajectory"><data key="relation">limits</data><data key="statement">bounds the length of</data><data key="conditions">When limits on turns, tokens, or wall-clock time stop the run before completion.</data></edge>
    <edge id="e1119" source="mlsys.durable-execution" target="mlsys.workflow-orchestration"><data key="relation">specializes</data><data key="statement">is a kind of</data><data key="conditions">When each step's intent and result are logged so recovery reuses recorded results; an effect completed before its result was recorded may need retry, deduplication, or reconciliation.</data></edge>
    <edge id="e1120" source="mlsys.deterministic-replay" target="mlsys.llm-call-tracing"><data key="relation">uses</data><data key="statement">can take recorded model outputs and tool results from</data><data key="conditions">When traces retain full payloads rather than sampled or truncated spans; otherwise replay needs the trajectory log.</data></edge>
    <edge id="e1121" source="mlsys.deterministic-replay" target="mlsys.failure-attribution"><data key="relation">enables</data><data key="statement">enables</data><data key="conditions">When a failing trajectory can be re-run step by step with its original inputs.</data></edge>
    <edge id="e1122" source="mlsys.suspend-resume" target="mlsys.durable-execution"><data key="relation">uses</data><data key="statement">persists waiting state through</data><data key="conditions">When a trajectory must survive process restarts while waiting on a human or external event.</data></edge>
    <edge id="e1123" source="mlsys.shared-agent-state" target="mlsys.multi-agent-orchestration"><data key="relation">part-of</data><data key="statement">is part of</data><data key="conditions">When several agents read and write task state under one orchestration topology.</data></edge>
    <edge id="e1124" source="mlsys.shared-agent-state" target="mlsys.coordination-failure"><data key="relation">causes</data><data key="statement">can cause</data><data key="conditions">When concurrent writes or stale reads go uncontrolled, so agents act on conflicting views of the task.</data></edge>
    <edge id="e1125" source="mlsys.llm-call-tracing" target="mlsys.coordination-failure"><data key="relation">detects</data><data key="statement">detects</data><data key="conditions">When handoffs, delegated instructions, and per-agent outputs are recorded as linked spans.</data></edge>
    <edge id="e1126" source="mlsys.correlated-agent-errors" target="mlsys.self-consistency"><data key="relation">limits</data><data key="statement">limits the benefit of</data><data key="conditions">When the sampled answers or voting agents share a base model and prompt, so their errors are not independent.</data></edge>
    <edge id="e1127" source="mlsys.correlated-agent-errors" target="mlsys.llm-judge"><data key="relation">limits</data><data key="statement">weakens the independence of</data><data key="conditions">When the judge shares a base model with the system it grades.</data></edge>
    <edge id="e1128" source="mlsys.observation-age" target="mlsys.time-synchronization"><data key="relation">requires</data><data key="statement">is measurable across sensors only under</data><data key="conditions">Observation age can be computed only when capture and use timestamps share a synchronized clock.</data></edge>
    <edge id="e1129" source="mlsys.recursive-filtering" target="mlsys.dynamics"><data key="relation">uses</data><data key="statement">predicts state with a model of</data><data key="conditions">The prediction step propagates the estimate through modeled dynamics between measurements.</data></edge>
    <edge id="e1130" source="mlsys.sensor-fusion" target="mlsys.recursive-filtering"><data key="relation">uses</data><data key="statement">uses</data><data key="conditions">When fused measurements arrive asynchronously and are combined through prediction and correction steps.</data></edge>
    <edge id="e1131" source="mlsys.world-model" target="mlsys.reinforcement-learning"><data key="relation">enables</data><data key="statement">enables sample-efficient</data><data key="conditions">When policies are trained on imagined rollouts from the learned model rather than only on environment interaction.</data></edge>
    <edge id="e1132" source="mlsys.motion-planning" target="mlsys.state-estimation"><data key="relation">requires</data><data key="statement">requires</data><data key="conditions">Plans are valid only relative to the estimated pose and map they start from.</data></edge>
    <edge id="e1133" source="mlsys.motion-planning" target="mlsys.slam"><data key="relation">uses</data><data key="statement">plans over maps from</data><data key="conditions">When the environment is not known in advance and the map is built online.</data></edge>
    <edge id="e1134" source="mlsys.mixed-criticality" target="mlsys.real-time-scheduling"><data key="relation">uses</data><data key="statement">uses</data><data key="conditions">Schedulability is analyzed with criticality-dependent WCET estimates for each task.</data></edge>
    <edge id="e1135" source="mlsys.real-time-scheduling" target="mlsys.utilization"><data key="relation">limits</data><data key="statement">bounds</data><data key="conditions">Rate-monotonic scheduling guarantees deadlines only when processor utilization stays below the Liu-Layland bound.</data></edge>
    <edge id="e1136" source="mlsys.vla-model" target="mlsys.transfer-learning"><data key="relation">uses</data><data key="statement">transfers web-scale vision-language knowledge through</data><data key="conditions">When the policy is fine-tuned from a pretrained vision-language backbone.</data></edge>
    <edge id="e1137" source="mlsys.vla-model" target="mlsys.teleoperation-data"><data key="relation">uses</data><data key="statement">is fine-tuned on</data><data key="conditions">When robot action labels come from human-driven demonstrations.</data></edge>
    <edge id="e1138" source="mlsys.synthetic-data" target="mlsys.teleoperation-data"><data key="relation">alternative-to</data><data key="statement">is an alternative to</data><data key="conditions">Simulated demonstrations are cheaper to scale but carry a sim-to-real gap that teleoperated demonstrations avoid.</data></edge>
    <edge id="e1139" source="mlsys.action-chunking" target="mlsys.observation-age"><data key="relation">increases</data><data key="statement">increases, for actions late in a chunk,</data><data key="conditions">When chunks execute open loop, so later actions rest on older observations.</data></edge>
    <edge id="e1140" source="mlsys.imitation-learning" target="mlsys.action-chunking"><data key="relation">uses</data><data key="statement">reduces compounding error with</data><data key="conditions">When the policy predicts short action sequences rather than single steps.</data></edge>
