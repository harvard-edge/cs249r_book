    <edge id="e1619" source="mlsys.residual-connection" target="mlsys.training-instability"><data key="relation">mitigates</data><data key="statement">helps keep deep stacks trainable to limit</data><data key="conditions">When identity shortcuts and residual-branch scaling are used in networks deep enough that gradients through stacked layers would otherwise degrade.</data></edge>
    <edge id="e1620" source="mlsys.multi-task-learning" target="mlsys.multi-model-serving"><data key="relation">alternative-to</data><data key="statement">consolidates several tasks into one shared-backbone model instead of hosting separate models in</data><data key="conditions">When tasks share inputs and enough representation that one backbone serves them without unacceptable quality loss.</data></edge>
