@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix taxmeta: <https://mlsysbook.ai/taxonomy/scheme#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mlsys: <https://mlsysbook.ai/taxonomy/relation/> .

<https://mlsysbook.ai/taxonomy/relation/> a owl:Ontology ;
  dct:title "ML Systems Taxonomy relations"@en ;
  owl:versionInfo "0.4-draft" ;
  dct:creator "Vijay Janapa Reddi"@en ;
  dct:license <https://creativecommons.org/licenses/by/4.0/> ;
  owl:imports <http://www.w3.org/2004/02/skos/core> .

mlsys:specializes a owl:ObjectProperty ;
  rdfs:subPropertyOf skos:broader ;
  rdfs:isDefinedBy <https://mlsysbook.ai/taxonomy/relation/> ;
  rdfs:label "is a kind of"@en ;
  rdfs:comment "A is a narrower or more specific case of B."@en .

mlsys:part-of a owl:ObjectProperty ;
  rdfs:subPropertyOf skos:related ;
  rdfs:isDefinedBy <https://mlsysbook.ai/taxonomy/relation/> ;
  rdfs:label "is part of"@en ;
  rdfs:comment "A is a component or stage within B."@en .

mlsys:alternative-to a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:subPropertyOf skos:related ;
  rdfs:isDefinedBy <https://mlsysbook.ai/taxonomy/relation/> ;
  rdfs:label "is an alternative to"@en ;
  rdfs:comment "A and B are competing options for the same job (symmetric)."@en .

mlsys:requires a owl:ObjectProperty ;
  rdfs:subPropertyOf skos:related ;
  rdfs:isDefinedBy <https://mlsysbook.ai/taxonomy/relation/> ;
  rdfs:label "requires"@en ;
  rdfs:comment "A cannot work, or cannot be correct, without B."@en .

mlsys:uses a owl:ObjectProperty ;
  rdfs:subPropertyOf skos:related ;
  rdfs:isDefinedBy <https://mlsysbook.ai/taxonomy/relation/> ;
  rdfs:label "uses"@en ;
  rdfs:comment "A commonly relies on B as a building block, without strict necessity."@en .

mlsys:implements a owl:ObjectProperty ;
  rdfs:subPropertyOf skos:related ;
  rdfs:isDefinedBy <https://mlsysbook.ai/taxonomy/relation/> ;
  rdfs:label "implements"@en ;
  rdfs:comment "A is a concrete mechanism or technique that realizes B."@en .

mlsys:enables a owl:ObjectProperty ;
  rdfs:subPropertyOf skos:related ;
  rdfs:isDefinedBy <https://mlsysbook.ai/taxonomy/relation/> ;
  rdfs:label "enables"@en ;
  rdfs:comment "A makes B possible or practical."@en .

mlsys:produces a owl:ObjectProperty ;
  rdfs:subPropertyOf skos:related ;
  rdfs:isDefinedBy <https://mlsysbook.ai/taxonomy/relation/> ;
  rdfs:label "produces"@en ;
  rdfs:comment "A creates or emits B as an output or artifact."@en .

mlsys:reduces a owl:ObjectProperty ;
  rdfs:subPropertyOf skos:related ;
  rdfs:isDefinedBy <https://mlsysbook.ai/taxonomy/relation/> ;
  rdfs:label "reduces"@en ;
  rdfs:comment "A lowers the amount, cost, or magnitude of B."@en .

mlsys:increases a owl:ObjectProperty ;
  rdfs:subPropertyOf skos:related ;
  rdfs:isDefinedBy <https://mlsysbook.ai/taxonomy/relation/> ;
  rdfs:label "increases"@en ;
  rdfs:comment "A raises the amount, cost, or magnitude of B."@en .

mlsys:determines a owl:ObjectProperty ;
  rdfs:subPropertyOf skos:related ;
  rdfs:isDefinedBy <https://mlsysbook.ai/taxonomy/relation/> ;
  rdfs:label "determines"@en ;
  rdfs:comment "A sets or shapes B (direction not simply up/down)."@en .

mlsys:limits a owl:ObjectProperty ;
  rdfs:subPropertyOf skos:related ;
  rdfs:isDefinedBy <https://mlsysbook.ai/taxonomy/relation/> ;
  rdfs:label "limits"@en ;
  rdfs:comment "A places a limit or ceiling on B."@en .

mlsys:trades-off a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:subPropertyOf skos:related ;
  rdfs:isDefinedBy <https://mlsysbook.ai/taxonomy/relation/> ;
  rdfs:label "trades off against"@en ;
  rdfs:comment "Improving A tends to worsen B, or vice versa (symmetric)."@en .

mlsys:measures a owl:ObjectProperty ;
  rdfs:subPropertyOf skos:related ;
  rdfs:isDefinedBy <https://mlsysbook.ai/taxonomy/relation/> ;
  rdfs:label "measures"@en ;
  rdfs:comment "A quantifies, evaluates, or tests B."@en .

mlsys:detects a owl:ObjectProperty ;
  rdfs:subPropertyOf skos:related ;
  rdfs:isDefinedBy <https://mlsysbook.ai/taxonomy/relation/> ;
  rdfs:label "detects"@en ;
  rdfs:comment "A reveals or identifies occurrences of B."@en .

mlsys:causes a owl:ObjectProperty ;
  rdfs:subPropertyOf skos:related ;
  rdfs:isDefinedBy <https://mlsysbook.ai/taxonomy/relation/> ;
  rdfs:label "can cause"@en ;
  rdfs:comment "A can lead to the failure, harm, or degradation B."@en .

mlsys:mitigates a owl:ObjectProperty ;
  rdfs:subPropertyOf skos:related ;
  rdfs:isDefinedBy <https://mlsysbook.ai/taxonomy/relation/> ;
  rdfs:label "mitigates"@en ;
  rdfs:comment "A protects against, prevents, or recovers from B."@en .

taxmeta:entryTerm a owl:DatatypeProperty ;
  rdfs:domain skos:Concept ; rdfs:range rdf:langString ;
  rdfs:label "search entry term"@en ;
  rdfs:comment "Legacy retrieval term; may be a synonym, narrower term, or implementation name. Does not assert lexical equivalence."@en .

taxmeta:condition a owl:DatatypeProperty ;
  rdfs:domain rdf:Statement ; rdfs:range rdf:langString ;
  rdfs:label "application condition"@en ;
  rdfs:comment "Human-readable applicability condition for a described engineering relationship; not an executable logical rule."@en .

