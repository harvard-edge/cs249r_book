"vol2.goal.420b33ad4a107d28" -> "vol2.goal.11073f680b31f1e3" [id="relation-vol2.connection.b1debe3cdc516a63", label="must sustain the rates\nrequired by"];
"vol2.goal.11073f680b31f1e3" -> "vol2.goal.393c5e1657839837" [id="relation-vol2.connection.a30dd83c27f624de", label="must keep up with"];
"vol2.goal.d7ff5aa2f1be7d77" -> "vol2.goal.95cc3aac16f5667d" [id="relation-vol2.connection.243e4e24217c79f1", label="provides gradient\nsynchronization for"];
"vol2.goal.58332711d6709f7c" -> "vol2.goal.a32e55386de43997" [id="relation-vol2.connection.19ac9a152d1bb6da", label="meets a byte bound but\nstill pays startup in"];
"vol2.goal.a32e55386de43997" -> "vol2.goal.d7ff5aa2f1be7d77" [id="relation-vol2.connection.47b4b3c9fcf40583", label="prices implementations\nof"];
"vol2.goal.d41daac52c76751a" -> "vol2.goal.d7ff5aa2f1be7d77" [id="relation-vol2.connection.d69784104e0c8962", label="replaces replication\nwith shard collectives\nfrom"];
"vol2.goal.bb70e497bef71c64" -> "vol2.goal.3d1c31dbaccf1ae1" [id="relation-vol2.connection.cf1e9045840de950", label="is amplified by\ncommunication tails in"];
"vol2.goal.4be33bc83e766be3" -> "vol2.goal.359fae8c2ee9b4e1" [id="relation-vol2.connection.e8c8799407380590", label="makes consistent\nrecovery necessary for"];
"vol2.goal.b60299bc5a4335d5" -> "vol2.goal.0b6434e748f1636f" [id="relation-vol2.connection.68c1298ff55d6537", label="separates silent faults\nrequiring"];
"vol2.goal.0b6434e748f1636f" -> "vol2.goal.d7ff5aa2f1be7d77" [id="relation-vol2.connection.54a04cc5746a1e1c", label="is not guaranteed by"];
"vol2.goal.4be33bc83e766be3" -> "vol2.goal.927d3db05d93b697" [id="relation-vol2.connection.9839383e578fa2b6", label="requires replacement\nand reconciliation by"];
"vol2.goal.927d3db05d93b697" -> "vol2.goal.2f32b6f5ded59c77" [id="relation-vol2.connection.e8863aa039b90cc5", label="must reserve atomic\nbundles through"];
"vol2.goal.cbc2711bc7bf92d7" -> "vol2.goal.2f32b6f5ded59c77" [id="relation-vol2.connection.b7c336df3353cec3", label="filters feasible gangs\nbefore"];
"vol2.goal.2f32b6f5ded59c77" -> "vol2.goal.bb70e497bef71c64" [id="relation-vol2.connection.6c8cb8c3d0b6e776", label="supplies all workers\nrequired by"];
"vol2.goal.989ebb30b0a9b7a3" -> "vol2.goal.927d3db05d93b697" [id="relation-vol2.connection.e8e91a131a2e2167", label="accounts for scheduling\nlosses under"];
"vol2.goal.8f9362df8e147e71" -> "vol2.goal.989ebb30b0a9b7a3" [id="relation-vol2.connection.ba56f11cf94663f8", label="makes claims\nreproducible about"];
"vol2.goal.fe3140f3e57cf2ad" -> "vol2.goal.989ebb30b0a9b7a3" [id="relation-vol2.connection.c005515703a19fd9", label="localizes losses in"];
"vol2.goal.eb80ca6398332174" -> "vol2.goal.e171eebe81274129" [id="relation-vol2.connection.1b1bc0cb86a60f16", label="makes cost depend on\nuseful serving output\nin"];
"vol2.goal.8f9c3fee512742c1" -> "vol2.goal.e171eebe81274129" [id="relation-vol2.connection.82aa898e7c6ebddc", label="trades throughput\nagainst"];
"vol2.goal.e171eebe81274129" -> "vol2.goal.3d1c31dbaccf1ae1" [id="relation-vol2.connection.daaedbff976cd634", label="includes network\ncompletion costs from"];
"vol2.goal.8f9c3fee512742c1" -> "vol2.goal.989ed9c7e5080a72" [id="relation-vol2.connection.9102e13e3338dcde", label="trades concurrency\nagainst memory\nfeasibility in"];
"vol2.goal.b2350ae86fbe3e11" -> "vol2.goal.d0f77e5097de244b" [id="relation-vol2.connection.d637e5ba6e072e36", label="must fit the update\nstate bounded by"];
"vol2.goal.7406b5a98bcf5ea8" -> "vol2.goal.e20cfecffc456354" [id="relation-vol2.connection.ebd12b60009b3de1", label="checks local versions\nof power and energy\nlimits in"];
"vol2.goal.7406b5a98bcf5ea8" -> "vol2.goal.b2350ae86fbe3e11" [id="relation-vol2.connection.a5c41a709ce29c80", label="admits or revokes"];
"vol2.goal.3abd5fc859d724bd" -> "vol2.goal.8faab063bb750917" [id="relation-vol2.connection.79cab4c6a6287d83", label="requires impact\ntracking through"];
"vol2.goal.0fbbb4ff7b964ddf" -> "vol2.goal.11073f680b31f1e3" [id="relation-vol2.connection.9bd86a919c9dc93f", label="adds freshness and\nconsistency to"];
"vol2.goal.5df000014c37ce5a" -> "vol2.goal.c53826fc802fdd92" [id="relation-vol2.connection.16a3bd9d9b267202", label="includes query-driven\ntheft limited by"];
