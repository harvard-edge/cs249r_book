digraph concepts {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.85", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#88949d", penwidth=1.15, fontname="Helvetica Neue", fontsize=16, margin="0.18,0.12"];
edge [fontname="Helvetica Neue", fontsize=12, color="#7a858e", fontcolor="#47535d", arrowsize=0.65];
"vol2.goal.62df2da88d4f9b18" [id="concept-vol2.goal.62df2da88d4f9b18", label="Scale moment", tooltip="Leaving one machine is a discontinuity, not an extrapolation: the binding constraint moves from the local memory wall to the network and then the energy wall while component failure becomes routine, so the unit of engineering becomes the fleet.", fillcolor="#fcebed", color="#a51c30", penwidth=1.8];
"vol2.goal.359fae8c2ee9b4e1" [id="concept-vol2.goal.359fae8c2ee9b4e1", label="Synchronous tight\ncoupling", tooltip="Synchronous training advances one shared model state through a barrier every step, so a persistent slowdown on one critical-path worker becomes a step penalty for all, and recovery must restore mutually consistent state across every participant rather than re-execute one task."];
"vol2.goal.fbdb2b82b010d740" [id="concept-vol2.goal.fbdb2b82b010d740", label="Scaling laws as the\ndemand curve", tooltip="Loss falls as a power law toward an irreducible floor, so each equal quality gain multiplies the resource by a fixed factor, a predictable but sublinear return that keeps organizations buying each further order of magnitude of fleet."];
"vol2.goal.ddf1e80098e63016" [id="concept-vol2.goal.ddf1e80098e63016", label="Infrastructure walls\ncascade", tooltip="Memory, communication, power, and reliability walls bind at successive physical scales (accelerator, node, rack, pod), each level's limit becomes the next level's input, and new technologies relocate a wall rather than remove it."];
"vol2.goal.989ed9c7e5080a72" [id="concept-vol2.goal.989ed9c7e5080a72", label="Capacity and bandwidth\nare separate tests", tooltip="Memory capacity decides whether model state fits and memory bandwidth decides how fast low-reuse phases run, so batch-1 decode is floored at weight bytes over HBM bandwidth and bandwidth per dollar becomes a procurement metric; the roofline and its ridge point (peak arithmetic over bandwidth) are the hardware screen that tells which ceiling a phase meets before any purchase."];
"vol2.goal.393c5e1657839837" [id="concept-vol2.goal.393c5e1657839837", label="Plan on sustained\nthroughput", tooltip="Peak TFLOP/s is a precision-specific ceiling that assumes every unit stays fed, so a run planned from peak needs 1/eta times the GPU-hours at measured utilization eta, compared only under matched FLOP conventions, precision, and scale."];
"vol2.goal.3d1c31dbaccf1ae1" [id="concept-vol2.goal.3d1c31dbaccf1ae1", label="ML traffic inversion", tooltip="Synchronous training releases a few large, correlated flows whose completion gates a job-wide barrier, so a fabric is judged by collective completion time and its tail, static ECMP hashing makes persistent hot spots, and oversubscription becomes a workload decision. The chapter defines bulk synchronous parallel (BSP) execution, the barrier model that distributed training later trades against SSP and ASP, and tail latency (p99) at its first use, the completion-time measure later chapters reuse."];
"vol2.goal.5c1c53f249a8b483" [id="concept-vol2.goal.5c1c53f249a8b483", label="RDMA reliable-delivery\ncontract", tooltip="Kernel-bypass RDMA with GPUDirect cuts per-message startup to microseconds, and InfiniBand and RoCE differ in where they place losslessness, so the requirement is reliable completion with a bounded recovery tail, a deployment contract rather than a property of RDMA."];
"vol2.goal.0ab41d1c37fdcef0" [id="concept-vol2.goal.0ab41d1c37fdcef0", label="Alpha-beta model", tooltip="Point-to-point message time T(n) = alpha + n/beta splits at the crossover n* = alpha*beta, so small control and pipeline messages are startup-bound and barely gain from faster links while multi-MB gradient shards are bandwidth-bound."];
"vol2.goal.6ec9aec8d44f20a8" [id="concept-vol2.goal.6ec9aec8d44f20a8", label="I/O wall", tooltip="Full-corpus training inverts database assumptions (large sequential shard reads, working sets larger than any cache, synchronized burst writes), so storage is provisioned for streaming bandwidth and burst absorption, and faster compute against a fixed input path plateaus at the delivery rate."];
"vol2.goal.420b33ad4a107d28" [id="concept-vol2.goal.420b33ad4a107d28", label="Scoped storage\nhierarchy", tooltip="The six storage tiers trade bandwidth for capacity and cost but quote bandwidth at different scopes, so a tier ratio is not a feed requirement, and as a cache E[T] = h*T_hot + (1-h)*T_miss means a 95 percent hit rate with a 100x slower miss path delivers about one-sixth of the all-hot rate."];
"vol2.goal.11073f680b31f1e3" [id="concept-vol2.goal.11073f680b31f1e3", label="Input delivery budget", tooltip="Required input bandwidth is the number of distinct consumers times target compute fraction times batch bytes over compute time, every stage of the chain must sustain it because delivered rate is the minimum over stages, and prefetch absorbs variance but never a sustained deficit; a direct DMA path from storage into accelerator memory (GPUDirect Storage, for example) removes the host-copy stage only when that copy is the limiting stage."];
"vol2.goal.d7ff5aa2f1be7d77" [id="concept-vol2.goal.d7ff5aa2f1be7d77", label="Collective contracts", tooltip="A collective is a contract on what each rank holds afterward, not a schedule or a barrier: AllReduce = ReduceScatter + AllGather, AllToAll is a distributed transpose, and the right primitive is the narrowest one whose output the next computation consumes. Gradient synchronization, the AllReduce of the full gradient that every synchronous data-parallel step repeats, is defined here as the central case."];
"vol2.goal.a32e55386de43997" [id="concept-vol2.goal.a32e55386de43997", label="Collective cost by\nrounds and chunks", tooltip="A collective pays the point-to-point alpha + n/beta price once per schedule round on a chunk, so a multi-MB bucket split across a thousand ranks travels in latency-bound steps, and fusion amortizes startup while compression helps only above the crossover."];
"vol2.goal.58332711d6709f7c" [id="concept-vol2.goal.58332711d6709f7c", label="Ring AllReduce and the\nbandwidth bound", tooltip="Any point-to-point AllReduce must send at least 2(N-1)M/N bytes from some rank, and Ring AllReduce meets that bound with a ReduceScatter phase and an AllGather phase while paying a startup term that grows linearly with N."];
"vol2.goal.95cc3aac16f5667d" [id="concept-vol2.goal.95cc3aac16f5667d", label="Data-parallel update\nequivalence", tooltip="Replicated data parallelism reproduces the single-device global-batch update only when sampling, valid-item denominators, optimizer state, and update order match, and its price is one gradient AllReduce per step that throughput hides only while local compute covers it."];
"vol2.goal.bb70e497bef71c64" [id="concept-vol2.goal.bb70e497bef71c64", label="Synchronization models\nand stragglers", tooltip="Bulk-synchronous training gives single-device semantics but waits for the slowest required contribution every step, so at thousands of GPUs the tail worker sets step time, and SSP and ASP trade that waiting for staleness with a convergence cost."];
"vol2.goal.d41daac52c76751a" [id="concept-vol2.goal.d41daac52c76751a", label="Sharded data\nparallelism", tooltip="ZeRO and FSDP shard optimizer state, then gradients, then parameters, cutting per-device state from 16 bytes per parameter toward 16/N, while full parameter sharding raises traffic about 1.5x and puts parameter gathers on every layer's critical path."];
"vol2.goal.4be33bc83e766be3" [id="concept-vol2.goal.4be33bc83e766be3", label="Fleet failure rate", tooltip="Independent constant-rate failures compose in series, so system MTBF = MTTF/N turns a 50,000-hour GPU into an interruption every few hours on a 10,000-GPU cluster, and correlated hazards over shared power, switches, and cooling come on top."];
"vol2.goal.b60299bc5a4335d5" [id="concept-vol2.goal.b60299bc5a4335d5", label="Fault classification by\npersistence,\nmanifestation, and\nscope", tooltip="A fault is placed on three axes that each select part of the response: persistence decides retry, quarantine, or replace-and-restore, manifestation decides whether liveness checks can see it, and scope decides the blast radius."];
"vol2.goal.0b6434e748f1636f" [id="concept-vol2.goal.0b6434e748f1636f", label="Silent data corruption\nverification", tooltip="ECC and link CRCs protect stored and transmitted bits but never arithmetic, so a live worker can feed a wrong gradient into a correct AllReduce, and because full redundancy costs 100 to 200 percent of compute, fleets use selective check-and-verify."];
"vol2.goal.927d3db05d93b697" [id="concept-vol2.goal.927d3db05d93b697", label="Scheduler as allocation\ncontrol plane", tooltip="A cluster scheduler loses direct observation, atomic effect, and binary failure, so it separates admission, placement, and reconciliation, and reusing a suspect node's accelerators requires versioned allocations, leases, and fencing."];
"vol2.goal.2f32b6f5ded59c77" [id="concept-vol2.goal.2f32b6f5ded59c77", label="Gang scheduling", tooltip="A rigid synchronous job makes no progress below its minimum gang, so partial allocation can deadlock two jobs at full cost, and atomic all-or-nothing allocation removes hold-and-wait but needs reservation, safe backfill, and holistic preemption."];
"vol2.goal.cbc2711bc7bf92d7" [id="concept-vol2.goal.cbc2711bc7bf92d7", label="Feasibility before\nfairness", tooltip="A fair share of accelerators a job cannot run on delivers nothing, so the scheduler first filters feasible bundles (every resource dimension, gang atomicity, topology, memory) and only then applies dominant-resource fairness, while multi-dimensional packing strands capacity."];
"vol2.goal.989ebb30b0a9b7a3" [id="concept-vol2.goal.989ebb30b0a9b7a3", label="ML goodput", tooltip="Useful fleet output is capacity times scheduling, runtime, and program goodput, each counted on one accounting boundary so every lost hour is charged to exactly one factor."];
"vol2.goal.8f9362df8e147e71" [id="concept-vol2.goal.8f9362df8e147e71", label="Reproducible\nmeasurement contract", tooltip="A goodput or optimization claim is valid only against a fixed contract that names the factor and window measured along with the workload and quality gate, system state, timing boundary, load-generation mode, and repeated trials with tails, so cold-start and warmed trials are reported apart."];
"vol2.goal.fe3140f3e57cf2ad" [id="concept-vol2.goal.fe3140f3e57cf2ad", label="Fleet profiling by\nhierarchy and sampling", tooltip="Trace volume grows with device count, so a fleet localizes the lost factor from the cheapest records first (scheduler records, then job timelines, then step traces) and captures short targeted traces or statistical samples only where the suspected factor lives."];
"vol2.goal.eb80ca6398332174" [id="concept-vol2.goal.eb80ca6398332174", label="Serving cost dominance", tooltip="Lifetime cost is training once plus cost per query times traffic times deployment time, so at high volume serving overtakes training within days to weeks and the lever is cost per completed request at a fixed mix, quality, and SLO."];
"vol2.goal.e171eebe81274129" [id="concept-vol2.goal.e171eebe81274129", label="SLO goodput and the\nserving tax", tooltip="Serving capacity is the rate of completed requests that meet stated TTFT and per-token targets for a fixed mix, and end-to-end latency adds network, serialization, coordination, and queueing to model time, so a 70 ms model in a 100 ms budget leaves 30 ms for everything else."];
"vol2.goal.8f9c3fee512742c1" [id="concept-vol2.goal.8f9c3fee512742c1", label="Batch formation trades\nwaiting for reuse", tooltip="With batch service time t_0 + B t_req throughput saturates toward 1/t_req past a knee near t_0/t_req, and request latency is queueing plus formation plus execution, so a batching window caps formation but not queueing, while Little's law (in-flight work = arrival rate x mean latency) sizes the concurrency and replica count a target rate and latency imply."];
"vol2.goal.b2350ae86fbe3e11" [id="concept-vol2.goal.b2350ae86fbe3e11", label="Local training must\nearn its place", tooltip="Centralized, local-only, and federated learning differ in what crosses the device boundary, and local training is justified only when a measured adaptation gain beats feature-based personalization under privacy and resource constraints."];
"vol2.goal.d0f77e5097de244b" [id="concept-vol2.goal.d0f77e5097de244b", label="Update working set\nwithin the background\nallowance", tooltip="An on-device update must fit its peak training working set inside the allowance the OS grants a background task, a few hundred MB on a phone rather than its installed RAM, so a model whose weights fit easily can still fail to train."];
"vol2.goal.7406b5a98bcf5ea8" [id="concept-vol2.goal.7406b5a98bcf5ea8", label="Background adaptation\nadmission", tooltip="The runtime admits an adaptation window only if its energy, thermal, and foreground-latency tests all hold, charging relaxes only the energy test, and admission is revoked when the measured envelope changes."];
"vol2.goal.3abd5fc859d724bd" [id="concept-vol2.goal.3abd5fc859d724bd", label="Operational load\nfollows coupling", tooltip="Once models share features, embeddings, pipelines, alerts, and capacity, the operational object is the dependency graph, so pairwise conflicts grow toward N^2/2 and a new model's marginal cost depends on how it couples to the portfolio."];
"vol2.goal.8faab063bb750917" [id="concept-vol2.goal.8faab063bb750917", label="Dependency-aware\nregistry", tooltip="Per-model validation does not establish compatibility along a chain, so the registry records upstream and downstream edges whose traversal yields the impact set, and a release names a compatible version set whose rollback unit may span a pipeline."];
"vol2.goal.0fbbb4ff7b964ddf" [id="concept-vol2.goal.0fbbb4ff7b964ddf", label="Feature consistency\ncontract", tooltip="A feature store makes training-serving consistency a testable platform invariant only if freshness SLOs name their timestamp contract and point-in-time joins filter on availability time rather than event time."];
"vol2.goal.5df000014c37ce5a" [id="concept-vol2.goal.5df000014c37ce5a", label="ML threat model", tooltip="Attacks on a learned system arrive through interfaces the fleet exposes on purpose, so a threat model writes down asset, trust boundary, adversary capability and goal, and control, and keeps model visibility separate from write capability; the serving interface adds prompt injection, which crosses the boundary between instructions and data, and denial of wallet, which spends the cost budget while the endpoint stays available."];
"vol2.goal.c53826fc802fdd92" [id="concept-vol2.goal.c53826fc802fdd92", label="Extraction budgets", tooltip="Exact artifact theft and approximate behavioral theft need different controls, and because a daily rate limit slows collection without capping its lifetime total, query-based extraction is bounded by cumulative per-principal budgets and the output contract."];
"vol2.goal.97b1dea8c8803a4e" [id="concept-vol2.goal.97b1dea8c8803a4e", label="Poisoning as a bilevel\nattack", tooltip="A poisoner needs write access to something the model learns from and solves a bilevel problem over the defender's training, so targeted, backdoor, and subpopulation attacks can leave aggregate validation accuracy unchanged, and clean-label poisons that keep every label correct pass any label audit, as concept poisoning of a text-to-image model (Nightshade) shows at a dose of a few hundred images."];
"vol2.goal.7c45f97d55b609e1" [id="concept-vol2.goal.7c45f97d55b609e1", label="Robustness per failure\nclass", tooltip="Drift, adversarial inputs, poisoning, and silent faults can keep every service-health signal green while predictions become invalid, and replication does not remove a weakness every copy shares, so robustness is claimed only per stated failure class."];
"vol2.goal.0f2e2bd61efc218f" [id="concept-vol2.goal.0f2e2bd61efc218f", label="Shift taxonomy", tooltip="Covariate shift changes P(x), label shift changes P(y), and concept drift changes P(y|x), so input monitors can be silent under pure concept drift and the type of shift selects the remedy (reweighting, recalibration, or adaptation on fresh labels)."];
"vol2.goal.63e126f3d547b321" [id="concept-vol2.goal.63e126f3d547b321", label="Drift alert to model\nupdate", tooltip="A drift alert opens an investigation rather than a retrain: detection, correlation with outcome performance, and action are separate levels, and a model update needs labels that confirm the shift and a root cause the update addresses."];
"vol2.goal.e20cfecffc456354" [id="concept-vol2.goal.e20cfecffc456354", label="Power ceiling versus\nenergy account", tooltip="A facility cannot draw more than its grid feed and cooling capacity at any instant, while run energy integrates average power over time, so a short run can be infeasible at modest energy and a long run feasible at large energy."];
"vol2.goal.a5f6bf8cdb5326d3" [id="concept-vol2.goal.a5f6bf8cdb5326d3", label="Sustainability\nmeasurement contract", tooltip="An energy or carbon number supports a comparison only when it extends the reproducible measurement contract with five fields, the functional unit, system boundary, attribution rule, carbon signal, and time and location of operation."];
"vol2.goal.ffe4b617511d55c2" [id="concept-vol2.goal.ffe4b617511d55c2", label="Operational carbon\nchain", tooltip="Operational CO2 = IT energy x PUE x grid carbon intensity, three terms acting at separate tiers, and PUE measures only non-IT overhead, so a coal-fed site can beat a hydro-fed one on PUE."];
"vol2.goal.4a8c551de5def767" [id="concept-vol2.goal.4a8c551de5def767", label="Assurance case", tooltip="A registry proves which weights shipped, not that shipping was justified, so deployment is justified by a versioned assurance case (claim for a stated use, argument, evidence, assumptions, an owner who can block, an invalidation rule) that expires on material change and maps the applicable legal obligations onto the lifecycle."];
"vol2.goal.5671fc8cd623cd50" [id="concept-vol2.goal.5671fc8cd623cd50", label="Fairness criteria\nconflict", tooltip="Demographic parity, equalized odds, equality of opportunity, and calibration measure different conditional rates, one classifier can fail all of them at once, and they cannot all hold when base rates differ, so choosing one is a governance decision."];
"vol2.goal.11ffd55c72f34f0a" [id="concept-vol2.goal.11ffd55c72f34f0a", label="Disparity measurement\nuncertainty", tooltip="A subgroup gap is evidence only with denominators, confidence intervals, and coverage limits, single-axis audits hide intersectional failure, and a significant disparity says nothing about its cause."];
"vol2.goal.fbdb2b82b010d740" -> "vol2.goal.62df2da88d4f9b18" [id="relation-vol2.connection.8fa2abe33d3d3576", label="drives demand toward"];
