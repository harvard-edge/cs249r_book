digraph concepts {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.85", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#88949d", penwidth=1.15, fontname="Helvetica Neue", fontsize=16, margin="0.18,0.12"];
edge [fontname="Helvetica Neue", fontsize=12, color="#7a858e", fontcolor="#47535d", arrowsize=0.65];
"vol1.serving.concurrency" [id="concept-vol1.serving.concurrency", label="Resident conversations", tooltip="Memory remaining after model weights must hold the attention state of every resident conversation.", fillcolor="#fcebed", color="#a51c30", penwidth=1.8];
"vol1.serving.kv" [id="concept-vol1.serving.kv", label="KV cache per\nconversation", tooltip="Attention keys and values retained for one conversation grow with its token count and model geometry."];
"vol1.serving.context" [id="concept-vol1.serving.context", label="Context length", tooltip="Longer histories retain more token state. At fixed cache format and model geometry, the per-conversation KV footprint grows linearly."];
"vol1.serving.pool" [id="concept-vol1.serving.pool", label="Available KV memory", tooltip="The device memory left after weights and other resident state bounds the cache pool."];
"vol1.serving.weights" [id="concept-vol1.serving.weights", label="Model weight memory", tooltip="Resident weights compete with KV state for device memory. Reducing weight storage can free cache capacity, subject to runtime allocations."];
"vol1.serving.prefill" [id="concept-vol1.serving.prefill", label="Prefill", tooltip="Processing the prompt creates attention state before the first output token is generated."];
"vol1.serving.decode" [id="concept-vol1.serving.decode", label="Decode", tooltip="Each generation step reads retained attention state and appends state for a new token."];
"vol1.serving.ttft" [id="concept-vol1.serving.ttft", label="Time to first token", tooltip="The time before the first output token includes queueing and prompt processing, so it captures a different part of the interaction than output-token cadence."];
"vol1.serving.tpot" [id="concept-vol1.serving.tpot", label="Time per output token", tooltip="The average interval between a request’s output tokens measures generation cadence."];
"vol1.serving.paging" [id="concept-vol1.serving.paging", label="Paged KV allocation", tooltip="Mapping fixed-size physical blocks to logical sequences reduces the waste of contiguous maximum-length reservation."];
"vol1.serving.prefix" [id="concept-vol1.serving.prefix", label="Prefix caching", tooltip="Compatible identical prefixes can reuse previously computed KV entries and avoid repeating prompt work."];
"vol1.serving.continuous" [id="concept-vol1.serving.continuous", label="Continuous batching", tooltip="Admitting work at generation boundaries lets the engine reclaim slots as sequences finish."];
"vol1.compression.precision" [id="concept-vol1.compression.precision", label="Weight precision", tooltip="Lower precision reduces the bytes needed for weights. It improves runtime only when the execution regime and kernel support let those saved bytes matter."];
"vol1.serving.concurrency" -> "vol1.serving.kv" [id="relation-vol1.serving.llm-relation-0", label="is limited by"];
"vol1.serving.concurrency" -> "vol1.serving.pool" [id="relation-vol1.serving.llm-relation-1", label="is bounded by"];
"vol1.serving.kv" -> "vol1.serving.context" [id="relation-vol1.serving.llm-relation-2", label="grows with"];
"vol1.serving.weights" -> "vol1.serving.pool" [id="relation-vol1.serving.llm-relation-3", label="competes with"];
"vol1.compression.precision" -> "vol1.serving.weights" [id="relation-vol1.serving.llm-relation-4", label="sets byte width in"];
"vol1.serving.prefill" -> "vol1.serving.kv" [id="relation-vol1.serving.llm-relation-5", label="creates"];
"vol1.serving.decode" -> "vol1.serving.kv" [id="relation-vol1.serving.llm-relation-6", label="reads and extends"];
"vol1.serving.prefill" -> "vol1.serving.ttft" [id="relation-vol1.serving.llm-relation-7", label="contributes to"];
"vol1.serving.decode" -> "vol1.serving.tpot" [id="relation-vol1.serving.llm-relation-8", label="determines cadence of"];
"vol1.serving.paging" -> "vol1.serving.pool" [id="relation-vol1.serving.llm-relation-9", label="reduces waste in"];
"vol1.serving.prefix" -> "vol1.serving.prefill" [id="relation-vol1.serving.llm-relation-10", label="avoids repeated work in"];
"vol1.serving.continuous" -> "vol1.serving.concurrency" [id="relation-vol1.serving.llm-relation-11", label="reclaims finished slots\nin"];
}
