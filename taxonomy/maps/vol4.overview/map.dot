digraph concepts {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.85", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#88949d", penwidth=1.15, fontname="Helvetica Neue", fontsize=16, margin="0.18,0.12"];
edge [fontname="Helvetica Neue", fontsize=12, color="#7a858e", fontcolor="#47535d", arrowsize=0.65];
"vol4.goal.1bcf90f28b356596" [id="concept-vol4.goal.1bcf90f28b356596", label="Causal boundary", tooltip="The causal boundary is the interface where an admitted digital command begins to drive current, force, or flow in the plant; upstream a tensor is a proposal that can be discarded for free, and downstream changing the command costs physical work against inertia over finite time.", fillcolor="#fcebed", color="#a51c30", penwidth=1.8];
"vol4.goal.608c8c5937e9c897" [id="concept-vol4.goal.608c8c5937e9c897", label="Irreversibility and\nrecovery", tooltip="Work delivered across the causal boundary has no checkpoint to restore, so recovery is a new constrained motion limited by torque, friction, and drive limits, and the permission path must confirm that a feasible recovery still exists before it admits an action."];
"vol4.goal.efc2a6739413bc5f" [id="concept-vol4.goal.efc2a6739413bc5f", label="Elementary stopping\nbudget", tooltip="Stopping distance v*tau_delay + v^2/(2*a_brake) must fit the clear distance, where the delay sums observation age, the unexpired chunk lease, a permission tick, a bus cycle, and brake onset, so every millisecond of latency is travel (1.5 mm per ms at the running machine's 1.5 m/s)."];
"vol4.goal.4eb521bfd8ea1247" [id="concept-vol4.goal.4eb521bfd8ea1247", label="Five-budget admission", tooltip="Before torque reaches a winding the permission path must find non-negative margin in all five physical budgets at once (observation age, stopping distance, deliverable torque, winding temperature, supply), because one budget's slack never pays another's deficit."];
"vol4.goal.dc3ef28a72648325" [id="concept-vol4.goal.dc3ef28a72648325", label="Measurement freshness\ndeadline", tooltip="An observation's age runs from physical transduction to actuator torque onset and must stay under the freshness deadline E_max / v_max set by the target's speed and the spatial tolerance, with inference only one of many stages."];
"vol4.goal.fa577a7a0e80f556" [id="concept-vol4.goal.fa577a7a0e80f556", label="Velocity ceiling", tooltip="The defended stopping distance v*tau + v^2/(2a) + localization and margin allowances must fit the clear distance, solved on the permission path as a clearance-dependent speed ceiling whose credible deceleration is the minimum of independently owned ceilings."];
"vol4.goal.8944a7ef2bc612c0" [id="concept-vol4.goal.8944a7ef2bc612c0", label="Delivered torque\nceiling", tooltip="A torque command is a current that winding inductance and voltage headroom pace and the inverter current limit caps, and a drive can clamp current silently while acknowledging packets, so the safety path must read measured current."];
"vol4.goal.2a5aa58415cf0672" [id="concept-vol4.goal.2a5aa58415cf0672", label="Memory-wall renewal\nceiling", tooltip="At batch size 1 a proposer streams every weight once per fresh evaluation, so its renewal rate is bounded by sustained bandwidth over weight bytes (14 GB at 142.8 GB/s is 98 ms per sweep, about 10 Hz before vision or decoding)."];
"vol4.goal.90e55e43b5f7c998" [id="concept-vol4.goal.90e55e43b5f7c998", label="Prefill-decode split", tooltip="One evaluation's prefill reuses each fetched weight across every input token and binds on arithmetic, while each later decode token rereads all weights and binds on bandwidth, so the two halves answer to different hardware limits."];
"vol4.goal.be5aabb6f820ece4" [id="concept-vol4.goal.be5aabb6f820ece4", label="Quantized model is a\nnew model", tooltip="Weight-only quantization shortens the bandwidth-bound decode but not the compute-bound prefill, and a quantized checkpoint is a different model whose evaluation evidence must be renewed."];
"vol4.goal.a42e015e58d8a72b" [id="concept-vol4.goal.a42e015e58d8a72b", label="Chunking is a supply\nlever", tooltip="Predicting H setpoints per evaluation divides weight traffic per supplied setpoint by H, but it leaves reaction latency at one renewal period plus one inference, so chunking supplies setpoints without refreshing them."];
"vol4.goal.23a92fc488143e94" [id="concept-vol4.goal.23a92fc488143e94", label="Independence\nrequirement", tooltip="Under any workload the proposer can generate, the permission path must meet its response bound and keep its authority to refuse, and separate processors are one realization of that requirement, a hypothesis that loaded tests must still confirm."];
"vol4.goal.26eeecaaa25f5099" [id="concept-vol4.goal.26eeecaaa25f5099", label="Rate tiers from time\nconstants", tooltip="Each tier takes its rate from a different physical constant (winding L/R and the PWM carrier for the current loop, base travel per tick for the permission tick, weight-sweep cost for the chunk policy, prefill cost for the intent model), not from convenience."];
"vol4.goal.95f4267d14e4bc5e" [id="concept-vol4.goal.95f4267d14e4bc5e", label="Freshest-proposal\nmailbox", tooltip="Proposals cross rate boundaries as state messages, not events, so a single-slot seqlock or wait-free multi-slot mailbox gives the faster reader one bounded, nonblocking attempt per tick that returns a complete snapshot or keeps the previous one."];
"vol4.goal.204871609bacb281" [id="concept-vol4.goal.204871609bacb281", label="Endogenous covariate\nshift", tooltip="Because a physical machine's own executed actions choose its next states and observations, the learner visits a distribution its demonstrations never sampled, so more nominal demonstrations only densify the region the expert already covered."];
"vol4.goal.02d4b998a35ddd7e" [id="concept-vol4.goal.02d4b998a35ddd7e", label="Compounding error and\nrecoverability", tooltip="Behavioral cloning's worst-case excess cost grows as T^2*eps because training error is weighted by the expert's occupancy, and labeling learner-visited states makes it linear only while a recovering action still exists."];
"vol4.goal.e3d14b209a92c1c7" [id="concept-vol4.goal.e3d14b209a92c1c7", label="Action-label semantics", tooltip="One command exists as four signals (requested, mapped, enforced, measured) and every pair must be dated at the exposure midpoint, because the tap chosen and the pairing lag decide what behavior the label teaches."];
"vol4.goal.13b5519659e8fdeb" [id="concept-vol4.goal.13b5519659e8fdeb", label="Demonstration yield and\nwear", tooltip="Physical data is bought in cell time and component life, so less than a quarter of a scheduled hour survives as retained demonstration and failed attempts wear parts like successful ones."];
"vol4.goal.97c8707e672e95bf" [id="concept-vol4.goal.97c8707e672e95bf", label="Training-regime hidden\ndependency", tooltip="A policy's weights keep what its experience rewarded but not which experience it was, so each regime (demonstrations, logged rewards, simulation, trial on the machine, a pretrained base) leaves a characteristic dependency no training score shows."];
"vol4.goal.766a75cfa93a3c24" [id="concept-vol4.goal.766a75cfa93a3c24", label="Mode averaging", tooltip="The squared-error optimum of a point-regression policy is the conditional mean of the action, so two valid evasions average to an action no demonstrator chose, and more data or capacity cannot fix it."];
"vol4.goal.c12b995b1438c444" [id="concept-vol4.goal.c12b995b1438c444", label="Decoder renewal slack", tooltip="A decoder chosen for multimodality must fit the proposal deadline, since latency is encoding plus every dependent decoder evaluation, so the head and evaluation count that training picks decide schedulability."];
"vol4.goal.ee986f656cb7d252" [id="concept-vol4.goal.ee986f656cb7d252", label="Offline RL support\nlimit", tooltip="Fitting values over a fixed log and acting greedily inflates values at actions the log never executed, and conservative objectives reduce that error but cannot create support the log lacks."];
"vol4.goal.a591584b0aa194ec" [id="concept-vol4.goal.a591584b0aa194ec", label="Closed-loop estimand", tooltip="A physical success rate is the expectation of a frozen outcome predicate over a declared distribution of trial conditions (initial state, environment, unit, frozen policy and permission parameters), so it belongs to that population and to no other."];
"vol4.goal.d26ca5b63f7b4ab5" [id="concept-vol4.goal.d26ca5b63f7b4ab5", label="Outcome channels and\ncensored trials", tooltip="Task completion, proposer autonomy, and supervisory burden are separate channels, and an intervened run is an autonomy failure, never a success that was cut short (the censored trial fallacy)."];
"vol4.goal.da9f10ab59d8841a" [id="concept-vol4.goal.da9f10ab59d8841a", label="Offline evaluation\nillusion", tooltip="Replay resets the input to the recorded state each step, so a heading bias with a tiny angular MSE can spend a 15 cm aisle clearance in seconds once the loop closes."];
"vol4.goal.8b2bed9fe3f3b917" [id="concept-vol4.goal.8b2bed9fe3f3b917", label="Four evidence regimes", tooltip="Replay, closed-loop simulation, shadow operation, and constrained physical testing sit on two axes (causal feedback, physical realism) and each trades one distortion for another, so they are not a fidelity ladder."];
"vol4.goal.e26b58d7709d7338" [id="concept-vol4.goal.e26b58d7709d7338", label="Sensor chosen by\nphysical quantity", tooltip="Each modality measures one physical quantity (bearing and appearance, metric range, Doppler velocity, contrast change, contact deformation) with its own environmental failures, so sensing is chosen by the quantity the decision needs."];
"vol4.goal.21f6688ca41969bb" [id="concept-vol4.goal.21f6688ca41969bb", label="Capture epoch", tooltip="A measurement is dated at its exposure midpoint or per-point firing time, never at arrival, and rolling-shutter rows and LiDAR sweeps sample the scene at different instants that capture-time geometry must undo."];
"vol4.goal.cc5a5e1f13cbeb68" [id="concept-vol4.goal.cc5a5e1f13cbeb68", label="Calibration chain", tooltip="Every metric claim rests on intrinsics, extrinsics, and inter-sensor time offsets composed along a frame tree at the capture instant, and angular and timing errors scale with range and turn rate."];
"vol4.goal.5572f1eac364fff7" [id="concept-vol4.goal.5572f1eac364fff7", label="Observation age", tooltip="Observation age runs from the exposure midpoint to dispatch, accumulates stage by stage (exposure, readout, transport, DMA, ISP, backbone, dispatch), and is paid in blind travel that no later stage returns."];
"vol4.goal.3709695ee5a670af" [id="concept-vol4.goal.3709695ee5a670af", label="Recursive estimation on\ndated measurements", tooltip="A state estimator alternates a prediction that widens uncertainty with elapsed time and updates that narrow it below every input by inverse-variance fusion, applying each measurement at its capture epoch and replaying out-of-sequence ones."];
"vol4.goal.3ee3bde7a9afde8e" [id="concept-vol4.goal.3ee3bde7a9afde8e", label="Covariance is a claim", tooltip="A filter's reported covariance is a hypothesis tested offline by NEES against ground truth and online by NIS on innovations, and an above-band mean flags the safety-critical overconfident filter."];
"vol4.goal.fc601d937e40bad6" [id="concept-vol4.goal.fc601d937e40bad6", label="Occupancy before\nidentity", tooltip="Tracking adds identity and velocity for planners, but a tentative track's occupied region must reach clearance consumers before confirmation and stays occupied while it coasts."];
"vol4.goal.c2e7d16472304b87" [id="concept-vol4.goal.c2e7d16472304b87", label="Belief record", tooltip="Every spatial claim carries evidence, estimate, and publication epochs, and only a physical measurement advances the evidence epoch, so prediction and republishing must preserve it."];
"vol4.goal.861edf8bc1d18d42" [id="concept-vol4.goal.861edf8bc1d18d42", label="Grounded affordance", tooltip="A request names an outcome, not a motion, and a target becomes checkable only as a feature pose in the base frame with approach direction, jaw aperture, and contact-wrench ceiling, each tied to dated sensor evidence."];
"vol4.goal.b4cdd27f3cd7238a" [id="concept-vol4.goal.b4cdd27f3cd7238a", label="Goal set is a\nspecification", tooltip="The admissible goal set is fixed by the verified task profile from what the grasp can physically absorb, not estimated by the proposer, and the proposal's error envelope plus tracking reserve must fit inside it."];
"vol4.goal.d1a1184313b6fd5a" [id="concept-vol4.goal.d1a1184313b6fd5a", label="Operators discharged by\nmotion predicates", tooltip="A symbolic operator asserts preconditions and effects it cannot verify, so each fact must map to a measurable motion predicate before any step that depends on it is admitted."];
"vol4.goal.c301753a1d48da62" [id="concept-vol4.goal.c301753a1d48da62", label="Calibrated referent\nrefusal", tooltip="A detector score measures prompt match, not uniqueness, so the producer forms a conformal prediction set over referents and refuses with a typed reason unless exactly one candidate remains."];
"vol4.goal.003422c7f26d3bfa" [id="concept-vol4.goal.003422c7f26d3bfa", label="Trajectory record", tooltip="The planner hands over an immutable record naming frame, evidence epoch, seam state, parent intent-lease digest, and four MCU-clock deadlines in two tiers (high-rate chunk lease, hardware commitment cutoff) together with its latched stop."];
"vol4.goal.341cc636f11197dc" [id="concept-vol4.goal.341cc636f11197dc", label="Replacement latency and\nhandoff tail", tooltip="Replacement latency runs from capture to MCU admission (about 115 ms against a 50 ms renewal and a 60 ms lease), so renewal is sustainable only by overlapping requests and every record must carry its own handoff tail."];
"vol4.goal.386ab88bb6d01411" [id="concept-vol4.goal.386ab88bb6d01411", label="Manipulator Jacobian", tooltip="Clearance and tool limits live in tool space but drives enforce joint limits, so tool-space quantities pass through the configuration-dependent Jacobian, whose weak direction near a singularity demands unbounded joint rates unless damped least squares trades accuracy for bounded rates."];
"vol4.goal.1c2d0de5670dd6f6" [id="concept-vol4.goal.1c2d0de5670dd6f6", label="Kinodynamic feasibility", tooltip="A collision-free path is executable only if every joint's position, velocity, acceleration, jerk, torque, and current stay within limits along the continuous interpolant, its seams, and its stop, which time parameterization must check."];
"vol4.goal.1b8b4b851096c370" [id="concept-vol4.goal.1b8b4b851096c370", label="Stopping envelope", tooltip="The stopping envelope is the set of states from which the resident stop, after every worst-case delay, halts before the obstacle with localization, protective, and tracking margins intact, and its seven priced rows run as a per-tick speed governor."];
"vol4.goal.fdd71b080dcdc7f1" [id="concept-vol4.goal.fdd71b080dcdc7f1", label="Kinetic barrier", tooltip="A control barrier function makes its safe set forward invariant only if every admitted input keeps hdot >= -alpha(h), and a barrier on raw distance has relative degree two in torque, so the barrier must carry the cost to stop."];
"vol4.goal.2885addca367265b" [id="concept-vol4.goal.2885addca367265b", label="Minimal-intervention\nfilter", tooltip="A least-change projection passes a safe proposal untouched and projects a violating one onto the barrier boundary, keeping learned competence, while a structurally invalid proposal is vetoed rather than corrected."];
"vol4.goal.a8c9e19c093e7cdd" [id="concept-vol4.goal.a8c9e19c093e7cdd", label="Per-resource\nindependence inventory", tooltip="A separate core or chip is not independent by construction, because memory protection governs where a transaction may go, not when it is served, so independence is argued row by row over every shared resource, including supply, clock, and reset."];
"vol4.goal.5fe2834eae8e975f" [id="concept-vol4.goal.5fe2834eae8e975f", label="Memory contention and\nmiss handling", tooltip="Memory arbiters schedule bursts, not averages, so a safety read waits on the backlog ahead of it and the controller's policy, and shared-cache miss handling, not bandwidth, threatens the declared bound."];
"vol4.goal.4b0925c60b86ab8d" [id="concept-vol4.goal.4b0925c60b86ab8d", label="Thermal throttling\nhangover", tooltip="On a shared die sustained inference drives the junction past the trip point, the governor cuts the clock so every tick overruns its bound, and hysteresis holds the clock down for seconds after the burst ends."];
"vol4.goal.f3cf7c74855a5437" [id="concept-vol4.goal.f3cf7c74855a5437", label="Declared WCET as\nfalsification threshold", tooltip="Loaded execution is isolated execution plus shared-hardware interference, and the placement claims that interference is zero, so any loaded tick above the declared WCET refutes the placement's timing premise even when it still meets the deadline."];
"vol4.goal.b5b7d7ebb3c5022c" [id="concept-vol4.goal.b5b7d7ebb3c5022c", label="Intervention transfers\nthe right to propose", tooltip="Supervisory intervention transfers the right to propose on named actuator channels from the policy to an authenticated person, committed on a control tick and bounded by a lease, while every human command still passes the permission check."];
"vol4.goal.d3aeeeb7213d6ac7" [id="concept-vol4.goal.d3aeeeb7213d6ac7", label="Takeover delay in the\nstopping budget", tooltip="Takeover latency (sensory, cognitive, motor, console) is long-tailed and must be budgeted at a design percentile as a delay before braking, which sets the speed a supervised machine may run."];
"vol4.goal.7c124479d6fb2331" [id="concept-vol4.goal.7c124479d6fb2331", label="Clearance-derived\nfallback deadline", tooltip="Fixing the current speed and solving the stopping inequality for the wait gives the latest fallback deadline, so a handover timeout is a function of state, and any configured ceiling is clipped to it."];
"vol4.goal.95c29f8e258f71c2" [id="concept-vol4.goal.95c29f8e258f71c2", label="Authority leases and\nphysical presence", tooltip="Autonomous chunks and manual sessions hold separate leases on the safety MCU's clock, so a silent policy, a dropped link, or an incapacitated operator loses authority to a state-matched local fallback."];
"vol4.goal.3fe8e9ecc90a1f5c" [id="concept-vol4.goal.3fe8e9ecc90a1f5c", label="Operating envelope and\ncoupled corners", tooltip="A protective claim holds only over a declared operating envelope that couples the external ODD with internal execution state (load, bus voltage, saturation, temperature), and its danger lives at the coupled corners, not the nominal center."];
"vol4.goal.4f842ab0a38edb52" [id="concept-vol4.goal.4f842ab0a38edb52", label="Precommitted oracle", tooltip="A fault trial counts as evidence only against an oracle fixed before the run that returns signed margins, scored from the event the fault disrupts rather than from the start of the trial."];
"vol4.goal.46f85b403792d390" [id="concept-vol4.goal.46f85b403792d390", label="Fault-list derivation", tooltip="Faults come from inverting each recorded design guarantee at its handoff and from working forward from the physical machine, each built as a five-element chain from cause to violated claim."];
"vol4.goal.9a55f85bc69983c7" [id="concept-vol4.goal.9a55f85bc69983c7", label="Transduction and\nproposer attacks", tooltip="A transduction attack delivers a checksum-valid packet whose measurement is false, so packet integrity is never an oracle for perception, and a wrong action inside the envelope after prompt injection or a patch is a coverage deficit, never a pass."];
"vol4.goal.6d24dfe2b5f08290" [id="concept-vol4.goal.6d24dfe2b5f08290", label="Safety case", tooltip="Release adjudicates physical inequalities (stop inside the clear distance, contact force under the assessed limit, WCET inside its deadline) through a claim-argument-evidence case whose warrants say why each piece of evidence supports its claim."];
"vol4.goal.3f8cc68b686e07cf" [id="concept-vol4.goal.3f8cc68b686e07cf", label="Conjunctive premises\nand diverse legs", tooltip="When every child claim is required the case is conjunctive and its confidence falls below every premise, so an assessor looks for the least-supported premise, and only genuinely independent sufficient legs add confidence."];
"vol4.goal.3cd6819bb72d284d" [id="concept-vol4.goal.3cd6819bb72d284d", label="Three signed verdicts", tooltip="The argument resolves into a signed verdict loaded as the machine's operating permit (UNCOND for the assessed envelope, COND for a separately evidenced restricted limit set, REFUSE naming the next measurement)."];
"vol4.goal.4e582da66be3016f" [id="concept-vol4.goal.4e582da66be3016f", label="Standing conditions", tooltip="A verdict lives only while its premises hold, so each premise is bound to a detector or site procedure at a cadence set by its degradation mechanism, and an unknown premise refuses like a breach."];
"vol4.goal.95dd077e73443a7a" [id="concept-vol4.goal.95dd077e73443a7a", label="Approval record", tooltip="The approval record names, for each decision behind an admitted action, the person who approved it and answers for it, together with the human roles, permit stage, exposed groups, records about people, and shifted labor, and the release gate reads it as a standing condition so that a decision with no named owner refuses operation the way an unknown premise does."];
"vol4.goal.c62f1e328f784c21" [id="concept-vol4.goal.c62f1e328f784c21", label="Decisions behind an\nadmitted action", tooltip="One admitted command rests on decisions made earlier by different parties (policy, enforcer, authority state, envelope, crossing rule, staffing), so each party can point to another, most of those decisions never appear in a runtime log, and a chain of k separately kept links is complete only with the product of their probabilities, so the links must be recorded on purpose."];
"vol4.goal.14d0b5661c20207d" [id="concept-vol4.goal.14d0b5661c20207d", label="Oversight a person can\nperform", tooltip="A human role counts as a countermeasure only if its holder has the time, information, and authority to act within the time the hazard leaves, including the queue one person serves, and a role that fails any of the three moves blame onto that person without adding protection."];
"vol4.goal.b02b81f84a9b711d" [id="concept-vol4.goal.b02b81f84a9b711d", label="Staged permission", tooltip="Permission to operate is granted in stages (testing with a safety driver or spotter, driverless or unattended testing, open deployment), each for a named configuration, domain, evidence, and reporting duties, left on evidence gathered at that stage and withdrawn for a configuration change, an incident, or a withheld record."];
"vol4.goal.a78a186e07169904" [id="concept-vol4.goal.a78a186e07169904", label="Four-law audit of a new\nmachine", tooltip="The method transfers to an unfamiliar machine as four ordered questions (what the task cannot undo and which measured bound excludes it, whether closed-loop evidence covers the enforced envelope, which independent path admits each proposal, and what evidence bounds the authority granted), not as the warehouse machine's numbers."];
"vol4.goal.30d70e32efbaf383" [id="concept-vol4.goal.30d70e32efbaf383", label="Residual-claims\nregister", tooltip="A premise no onboard sensor reports is not the envelope's monitored unknown, so it is bound to a standing restriction, an accountable owner, and a predeclared closure test, chosen among responses (probe, restrict, add sensing, accept by judgment) by the claim each can support."];
"vol4.goal.6d20d49eebb92849" [id="concept-vol4.goal.6d20d49eebb92849", label="Next capability by\nmissing evidence", tooltip="Open register entries fall into classes by the evidence they lack (an unmeasured observable, an evaluation deficit, a theoretical deficit) or by a scope mismatch that no evidence inside the present architecture repairs, and the class, not the urgency, selects the next experiment, with each restriction priced against the campaign that would retire it."];
"vol4.goal.8ed112cc56686fdc" [id="concept-vol4.goal.8ed112cc56686fdc", label="Observational\nindistinguishability", tooltip="When two states that need different responses produce identical observations until the action deadline, no model on that channel can separate them, and the latest useful observation is set by braking distance over speed."];
"vol4.goal.1bcf90f28b356596" -> "vol4.goal.608c8c5937e9c897" [id="relation-vol4.connection.d44430e36a111e5c", label="makes recovery subject\nto"];
"vol4.goal.efc2a6739413bc5f" -> "vol4.goal.fa577a7a0e80f556" [id="relation-vol4.connection.ce86111b8b761230", label="sets the clearance-\ndependent"];
"vol4.goal.efc2a6739413bc5f" -> "vol4.goal.4eb521bfd8ea1247" [id="relation-vol4.connection.6820e75ac1b9a233", label="is one condition in"];
"vol4.goal.4eb521bfd8ea1247" -> "vol4.goal.1bcf90f28b356596" [id="relation-vol4.connection.141e54cdbec2a453", label="gates crossing of"];
"vol4.goal.dc3ef28a72648325" -> "vol4.goal.5572f1eac364fff7" [id="relation-vol4.connection.5ef0721b4ad3baa8", label="bounds allowable"];
"vol4.goal.8944a7ef2bc612c0" -> "vol4.goal.4eb521bfd8ea1247" [id="relation-vol4.connection.65848e1f06b78cad", label="provides the torque\nmargin tested by"];
"vol4.goal.dc3ef28a72648325" -> "vol4.goal.efc2a6739413bc5f" [id="relation-vol4.connection.0302c4773c3dd41b", label="bounds observation\ndelay included in"];
"vol4.goal.2a5aa58415cf0672" -> "vol4.goal.90e55e43b5f7c998" [id="relation-vol4.connection.433c9e32cad3eb7a", label="constrains the decode\nside of"];
"vol4.goal.be5aabb6f820ece4" -> "vol4.goal.2a5aa58415cf0672" [id="relation-vol4.connection.9fd860ec34eb8909", label="can raise the\nbandwidth-limited\nceiling in"];
"vol4.goal.a42e015e58d8a72b" -> "vol4.goal.341cc636f11197dc" [id="relation-vol4.connection.09a8577629584e4e", label="improves supply without\nremoving"];
"vol4.goal.90e55e43b5f7c998" -> "vol4.goal.341cc636f11197dc" [id="relation-vol4.connection.8085321792bd9f92", label="contributes inference\ntime to"];
"vol4.goal.23a92fc488143e94" -> "vol4.goal.4eb521bfd8ea1247" [id="relation-vol4.connection.448beeb54025982b", label="protects timely\nexecution of"];
"vol4.goal.26eeecaaa25f5099" -> "vol4.goal.2a5aa58415cf0672" [id="relation-vol4.connection.3095349d2dda8bd0", label="includes a policy tier\nlimited by"];
"vol4.goal.95f4267d14e4bc5e" -> "vol4.goal.003422c7f26d3bfa" [id="relation-vol4.connection.05fb4b904cdd740c", label="transfers coherent\nproposals carried by"];
"vol4.goal.204871609bacb281" -> "vol4.goal.02d4b998a35ddd7e" [id="relation-vol4.connection.2073db42417a045c", label="produces the\ncompounding error\ndescribed by"];
