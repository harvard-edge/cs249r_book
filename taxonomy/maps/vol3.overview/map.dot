digraph concepts {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.85", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#88949d", penwidth=1.15, fontname="Helvetica Neue", fontsize=16, margin="0.18,0.12"];
edge [fontname="Helvetica Neue", fontsize=12, color="#7a858e", fontcolor="#47535d", arrowsize=0.65];
"vol3.goal.20995572b6c34727" [id="concept-vol3.goal.20995572b6c34727", label="Agency is a property of\nthe closed loop", tooltip="A system is agentic when a runtime, not a human, closes the proposal-action-observation loop, so the model's output is a proposal with no standing authority and enforcement, isolation, persistence, and completion checks belong to the runtime.", fillcolor="#fcebed", color="#a51c30", penwidth=1.8];
"vol3.goal.88f981f1782134ab" [id="concept-vol3.goal.88f981f1782134ab", label="Trajectory as the unit\nof engineering", tooltip="The ordered record of states, proposals, runtime decisions, and observations from initial context to acceptance, termination, or escalation is the accounting boundary for cost, latency, state lifetime, quotas, and permissions, so resources are managed per task rather than per call."];
"vol3.goal.1086ffbeff9dbc80" [id="concept-vol3.goal.1086ffbeff9dbc80", label="H·S·A exposures", tooltip="A task's coordinate is its horizon H in turns, carried state S0 to S3, and authority A0 to A3, each level set by operational consequence rather than command syntax, and the coordinate names the exposure that closure must answer."];
"vol3.goal.01349b7f17e34a39" [id="concept-vol3.goal.01349b7f17e34a39", label="Proposal boundary", tooltip="Model output is a proposal with zero ambient authority: the runtime validates, authorizes, executes, and returns the observation, so a tool request is never an effect and a model claim is never an observation."];
"vol3.goal.7a5320ab5f8d6649" [id="concept-vol3.goal.7a5320ab5f8d6649", label="Token-measured\nadmission", tooltip="A request is admitted only if its fully serialized wire payload, counted with the target model's own tokenizer, satisfies S <= S_max - K_max, and hidden reasoning tokens debit the same output headroom."];
"vol3.goal.bf5fe091de6980df" [id="concept-vol3.goal.bf5fe091de6980df", label="Sampling shapes\ncandidates, not\ncorrectness", tooltip="Temperature, top-k, and top-p reshape which candidates appear but none makes a likely token a correct one, so sampling settings are chosen by measured task pass rates."];
"vol3.goal.cba86fab8b9a103d" [id="concept-vol3.goal.cba86fab8b9a103d", label="Allocation axes", tooltip="Depth, breadth, and feedback can spend the same output ceiling yet differ in critical path, retained KV state, and bill, and only feedback adds information the prompt and weights lack."];
"vol3.goal.465d84a59edf4403" [id="concept-vol3.goal.465d84a59edf4403", label="Budgeted deliberation", tooltip="Test-time compute is a per-decision allowance that sets the attempt cost in C_eff, so it pays only when it raises acceptance faster than cost, and difficulty should route the budget."];
"vol3.goal.e10545e9384ab83b" [id="concept-vol3.goal.e10545e9384ab83b", label="Coverage is not\nselection", tooltip="pass@k = 1-(1-p)^k caps any selector that returns an unchanged pool member, while realized accuracy is set by the selector, so coverage near 98 percent can coexist with a vote that plateaus near half."];
"vol3.goal.945f96872e82943e" [id="concept-vol3.goal.945f96872e82943e", label="Working-set partition", tooltip="Before each call the runtime selects a bounded working set and splits the input allowance S_max - K_max among instructions, tool declarations, task state, and observations, and appended observations are the term that grows and displaces task state."];
"vol3.goal.f3954c5e25f6473c" [id="concept-vol3.goal.f3954c5e25f6473c", label="Usable working context", tooltip="Usable context is an empirical property of a model, configuration, representation, and workload found by decision-level evaluation, because attention dilutes a target key as staged keys accumulate and position matters."];
"vol3.goal.0b8ba274ab57346a" [id="concept-vol3.goal.0b8ba274ab57346a", label="Change-rate ordering", tooltip="Staging the request as root, trunk, and leaf by change rate keeps the longest exact token prefix reusable, so volatile fields belong in the leaf, although correctness always overrides cache economics."];
"vol3.goal.1e83a32e5eb8c1f7" [id="concept-vol3.goal.1e83a32e5eb8c1f7", label="KV footprint and\nresident fit", tooltip="Retained attention state costs 2 x layers x KV heads x head dim x bytes per token, so resident fit in the KV pool falls as 1/S with context length, and the attention design fixed at pretraining sets the slope."];
"vol3.goal.dff110711d65381a" [id="concept-vol3.goal.dff110711d65381a", label="Paged KV allocation", tooltip="Fixed-size blocks mapped by a per-sequence block table remove the stranded memory of full-cap reservation and bound tail waste below one block."];
"vol3.goal.4258bd5aad9384cf" [id="concept-vol3.goal.4258bd5aad9384cf", label="Copy-on-write block\nsharing", tooltip="Forked candidates share prefix blocks by reference count, so a fork costs block-table entries rather than a payload copy and physical demand is the count of unique blocks."];
"vol3.goal.1f5c5c21ed9f1dfc" [id="concept-vol3.goal.1f5c5c21ed9f1dfc", label="Record roles", tooltip="Persistent records are roles in an evidence chain (source of record, observation log, agent-written memory, retrieval index), not storage tiers, and any claim is validated against its source of record."];
"vol3.goal.cd2de11510439076" [id="concept-vol3.goal.cd2de11510439076", label="Retrieval contract", tooltip="Every read is a bounded request answered by an envelope that reports scope, snapshot, completeness status, and per-item provenance, and an empty result proves nonexistence only for a complete search of the declared scope."];
"vol3.goal.6315dc325eeefee4" [id="concept-vol3.goal.6315dc325eeefee4", label="Query formulation\nchoice", tooltip="A named target gets a direct read, a predictable unnamed set gets pre-staged, and a chain where each item is found only from the last forces model-directed probing at one model round per dependent hop."];
"vol3.goal.6623f2dfcdc519df" [id="concept-vol3.goal.6623f2dfcdc519df", label="Complete mediation", tooltip="Every proposed call, reads included, passes a deterministic host reference monitor that validates, authorizes, dispatches with outcome tracking, and shapes the observation."];
"vol3.goal.8e1cedeb16ce2891" [id="concept-vol3.goal.8e1cedeb16ce2891", label="Action-time\npreconditions", tooltip="A schema settles only structure, so any precondition that depends on current state (an expected version, a canonical path) must be enforced atomically with the effect at the endpoint."];
"vol3.goal.eaff06773270c3bd" [id="concept-vol3.goal.eaff06773270c3bd", label="Discovery is not\nauthority", tooltip="A shared tool protocol cuts integration to N_host + N_tool adapters, but listed tools supply only interface syntax: descriptions are untrusted input and admitted schemas must be bound to the server instance."];
"vol3.goal.3dd751688eaba3a2" [id="concept-vol3.goal.3dd751688eaba3a2", label="Containment beneath the\nmodel", tooltip="Admitting a well-typed call does not bound what the code it starts can reach, so the limit must be enforced below the executing process by a mechanism the code cannot modify."];
"vol3.goal.8fa37544e46401e4" [id="concept-vol3.goal.8fa37544e46401e4", label="In-process restriction\nfails", tooltip="Pruning an interpreter's globals is an interface filter, not an execution boundary, because reachable object references, shared native libraries, and inherited authority leave the supervisor's full power within reach."];
"vol3.goal.dbae61519cbe4a63" [id="concept-vol3.goal.dbae61519cbe4a63", label="Capability grants", tooltip="A capability is an unforgeable reference that designates a resource and authorizes operations on it, and a grant admits an access only if the reference is authentic and the operation, object, condition, and expiry all match."];
"vol3.goal.72093fa4fc781310" [id="concept-vol3.goal.72093fa4fc781310", label="Structural prompt\ninjection", tooltip="Instructions, tool definitions, the request, and every observation are serialized into one token sequence in which no position carries enforced privilege, so injection is structural and exposure grows with every untrusted read."];
"vol3.goal.e26664308128fa36" [id="concept-vol3.goal.e26664308128fa36", label="Callable is not\npermitted", tooltip="Injection turns the runtime into a confused deputy with a legitimate identity, so authorization must judge this request within this task, not the function name, argument types, or endpoint allowlist."];
"vol3.goal.56dececde969944b" [id="concept-vol3.goal.56dececde969944b", label="Information-flow labels", tooltip="Confidentiality and integrity provenance vary independently, so the host attaches both to every record, propagates them by the lattice join, and checks release and evidence before dispatch."];
"vol3.goal.3d1818cd8e3886b6" [id="concept-vol3.goal.3d1818cd8e3886b6", label="Harness owns\ncontinuation", tooltip="A model that honors a pause or allowance with probability p per turn holds it over H turns only p^H of the time, so the decision to take another step belongs to a harness that treats every reply as an untrusted proposal."];
"vol3.goal.5b5e137eb4b09d46" [id="concept-vol3.goal.5b5e137eb4b09d46", label="Trajectory record", tooltip="Supervision needs one authoritative per-trajectory control record, written only by the harness, holding contract, lifecycle state, accounting, grants, current invocations, the operation table, and a live plan."];
"vol3.goal.dd2f67a33b51241c" [id="concept-vol3.goal.dd2f67a33b51241c", label="Guarded transitions", tooltip="The trajectory advances only along legal state-machine edges whose guards pass on a current record version, and admission commits atomically under the record lock before any request leaves the host (register before send)."];
"vol3.goal.8c7a65811671f04f" [id="concept-vol3.goal.8c7a65811671f04f", label="Failure-domain\ndurability", tooltip="An acknowledgment is durable only against the faults its storage tier survives, so each write's durability is declared against a failure domain rather than assumed."];
"vol3.goal.8435c68573994f47" [id="concept-vol3.goal.8435c68573994f47", label="Trajectory log", tooltip="Recovery state comes from an append-only, typed trajectory log, and the live trajectory record is a deterministic fold over that log."];
"vol3.goal.3e41f01d2f063b4b" [id="concept-vol3.goal.3e41f01d2f063b4b", label="Durable intent before\ndispatch", tooltip="An admitted operation's identity, arguments, grant reference, and reservation must be durable under the declared failure domain before the request leaves, so no effect can exist without its intent on record."];
"vol3.goal.14868004d8399c1f" [id="concept-vol3.goal.14868004d8399c1f", label="Compensation", tooltip="An external service and the runtime log share no atomic commit, so an established effect is remediated only by a separately committed forward operation that restores declared postconditions, not the past."];
"vol3.goal.8f9802aa01e899f3" [id="concept-vol3.goal.8f9802aa01e899f3", label="Trajectory saga", tooltip="A trajectory saga durably registers each effectful step's cleanup template before dispatch, not after the step returns, so a crash never leaves an effect without its compensator."];
"vol3.goal.d4c39dffabf7e477" [id="concept-vol3.goal.d4c39dffabf7e477", label="Cleanup graph", tooltip="Recovery order is a DAG of admitted cleanup operations rather than a reverse stack, and an unresolved node blocks only its transitive dependents."];
"vol3.goal.f7284440ef336c98" [id="concept-vol3.goal.f7284440ef336c98", label="Task acceptance\ncontract", tooltip="A trial is credited as an accepted task only when evidence on the exact candidate bytes satisfies its declared outcome, process, resource, and residual-duty criteria, and every verdict is pass, fail, pending, or unknown, with no default to pass."];
"vol3.goal.0981570d7629822e" [id="concept-vol3.goal.0981570d7629822e", label="Hermetic evaluation gym", tooltip="Comparable trials need a hermetic boundary that declares which dependencies are provisioned, simulated, or blocked, a versioned task fixture, and a reset that leaves no state for the next trial."];
"vol3.goal.ed39939cfb8d238f" [id="concept-vol3.goal.ed39939cfb8d238f", label="Grader isolation", tooltip="Sealed tests protect evidence only if a trusted controller outside both the live agent's reach and the submitted artifact's execution keeps the reference solutions, hidden tests, and score store and binds each verdict to the artifact hash."];
"vol3.goal.462232d663bc3a8f" [id="concept-vol3.goal.462232d663bc3a8f", label="Trajectory traces", tooltip="Spans bind every model call, mediated tool execution, and check to their trial and artifact, but a diagnostic trace may sample or drop and never replaces the durable recovery log or the verdict record."];
"vol3.goal.2f9b5e5ddab1db33" [id="concept-vol3.goal.2f9b5e5ddab1db33", label="Trace retention", tooltip="Sampling may thin diagnostic detail but never the accounting record of admitted trials, verdicts, spend, and drops, and retention is chosen per verdict under storage and privacy budgets."];
"vol3.goal.cedde3b9fceb334d" [id="concept-vol3.goal.cedde3b9fceb334d", label="Postmortem by\nintervention", tooltip="An agent incident is diagnosed by keeping findings separated by boundary and testing each with a controlled intervention on the recorded trajectory, not by naming one culprit."];
"vol3.goal.71a65072ede23a39" [id="concept-vol3.goal.71a65072ede23a39", label="Capability-gap triage", tooltip="A failure earns a weight update only if it persists with complete context, a well-formed interface, and a healthy runtime, so counterfactual probes run up the intervention ladder from context and schema to SFT and then RL."];
"vol3.goal.dd68c621a0ec0934" [id="concept-vol3.goal.dd68c621a0ec0934", label="Learning artifacts from\none record", tooltip="One recorded run can yield imitation material, a preference comparison, or a rollout fixture, and each use has its own admission conditions rather than inheriting the run's outcome."];
"vol3.goal.539f50c18f2e7c63" [id="concept-vol3.goal.539f50c18f2e7c63", label="Task-group splits", tooltip="With k attempts per task a random trace split puts most tasks on both sides, so partitions are assigned to task groups that hold every attempt, paraphrase, fork, and derived record."];
"vol3.goal.2482c95aa6e8c0e1" [id="concept-vol3.goal.2482c95aa6e8c0e1", label="Three homes for\nbehavior", tooltip="Fine-tuning changes only the proposal distribution, so stable procedure can move into weights, deployment-varying contracts stay in context, and enforcement stays in the runtime."];
"vol3.goal.1ddaedf4a35f7eec" [id="concept-vol3.goal.1ddaedf4a35f7eec", label="Delivered-prefix\nserialization", tooltip="A training example reconstructs each selected response's input exactly as the model received it, truncations and redactions included, under a recorded tokenizer and template configuration."];
"vol3.goal.d7de3001d21b10b0" [id="concept-vol3.goal.d7de3001d21b10b0", label="Loss masking", tooltip="Loss is placed only on selected policy-response positions while prompts, refused proposals, and observations stay as attended context with zero loss, because a trajectory has two authors and only one is trained."];
"vol3.goal.37b296222be9fdbf" [id="concept-vol3.goal.37b296222be9fdbf", label="Sampled reward contrast", tooltip="RLVR scores sampled rollouts with a programmatic check, so the update learns only what the sampler reaches and the reward distinguishes, and a task the policy never solves gives zero signal."];
"vol3.goal.1a4a93667ab5e412" [id="concept-vol3.goal.1a4a93667ab5e412", label="Reward hacking", tooltip="Once a check is the objective, any trajectory with proxy reward at least the intended solution's but lower true utility gains weight, and cheap exploits usually have high probability."];
"vol3.goal.13fba08fac11a282" [id="concept-vol3.goal.13fba08fac11a282", label="Reward as measurement", tooltip="The false-accept share of rewarded rollouts moves with the policy's current pass rate rather than being a fixed verifier property, so reward shaping must preserve the priority of correct outcomes."];
"vol3.goal.24e47f72d5f79db3" [id="concept-vol3.goal.24e47f72d5f79db3", label="Delegation adds\nboundaries", tooltip="A delegated worker owns a separate child trajectory, and a capable single controller already runs tools and candidates concurrently, so delegation buys only separation of context, authority, and lifecycle, at the price of new boundaries."];
"vol3.goal.1e9d7760586b826a" [id="concept-vol3.goal.1e9d7760586b826a", label="Coordination overhead", tooltip="Under Speedup(N) = 1/((1-p) + p/N + c(N)) any gain requires c(N) < p(1 - 1/N), the best count sits near sqrt(p/c) for linear overhead, and the serial fraction caps speedup at 1/(1-p)."];
"vol3.goal.b7005a1bdb9d57e6" [id="concept-vol3.goal.b7005a1bdb9d57e6", label="Three delegation\nstructures", tooltip="The dependency graph, the communication topology, and the supervision tree are separate structures, and conflating them hides quadratic communication cost and orphaned lifecycles."];
"vol3.goal.2acb8b2a30db6774" [id="concept-vol3.goal.2acb8b2a30db6774", label="Cohort cost per\naccepted task", tooltip="Measured cost per accepted task is the sum of every initiated task's account, each charge in exactly one category, divided by the distinct tasks accepted under one declared contract."];
"vol3.goal.1d1238278e37c026" [id="concept-vol3.goal.1d1238278e37c026", label="Prefix-cache pricing\nand compaction payback", tooltip="Ideal prefix reuse bills the quadratic re-send at the cached rate, which lowers its coefficient without removing it, so a compaction pays back only after enough turns to recover its rewrite and lost cache."];
"vol3.goal.1740f5cc0eb0fdc3" [id="concept-vol3.goal.1740f5cc0eb0fdc3", label="Critical-path\nacceleration ceiling", tooltip="A speedup g applied to a fraction f of the measured critical path gives T' = T[(1-f) + f/g] and a ceiling of 1/(1-f), which a baseline profile reveals before anything is bought."];
