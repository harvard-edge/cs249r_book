"vol3.goal.56dececde969944b" -> "vol3.goal.6623f2dfcdc519df" [id="relation-vol3.connection.db50b9176ef546ce", label="constrains observation\nrelease and dispatch\nthrough"];
"vol3.goal.3d1818cd8e3886b6" -> "vol3.goal.01349b7f17e34a39" [id="relation-vol3.connection.9a8ea5d8cf792704", label="enforces the runtime\nside of"];
"vol3.goal.dd2f67a33b51241c" -> "vol3.goal.5b5e137eb4b09d46" [id="relation-vol3.connection.6ef6b257d2d98f38", label="advances a versioned"];
