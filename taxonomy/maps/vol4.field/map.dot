digraph concepts {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.85", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#88949d", penwidth=1.15, fontname="Helvetica Neue", fontsize=16, margin="0.18,0.12"];
edge [fontname="Helvetica Neue", fontsize=12, color="#7a858e", fontcolor="#47535d", arrowsize=0.65];
"vol4.boundary.causal" [id="concept-vol4.boundary.causal", label="Causal boundary", tooltip="The point where an admitted command becomes physical work in the world.", fillcolor="#fcebed", color="#a51c30", penwidth=1.8];
"vol4.boundary.irreversibility" [id="concept-vol4.boundary.irreversibility", label="Irreversibility", tooltip="Delivered physical work cannot be recalled by restoring a software state; recovery must deal with its remaining consequences."];
"vol4.boundary.proposal" [id="concept-vol4.boundary.proposal", label="Proposal boundary", tooltip="The architectural separation between learned proposals and the path authorized to admit physical action."];
"vol4.stopping.distance" [id="concept-vol4.stopping.distance", label="Stopping distance", tooltip="Clearance consumed during pre-brake travel and subsequent braking under the stated motion and plant assumptions."];
"vol4.stopping.delay" [id="concept-vol4.stopping.delay", label="Pre-brake delay", tooltip="Elapsed time charged before credible braking begins, measured from the event specified by the stopping claim."];
"vol4.plant.braking" [id="concept-vol4.plant.braking", label="Braking authority", tooltip="The credible deceleration the loaded plant can deliver under declared traction, actuator, supply, and thermal conditions."];
"vol4.plant.thermal" [id="concept-vol4.plant.thermal", label="Thermal headroom", tooltip="Remaining temperature margin before an actuator or brake must reduce its qualified output or duty; the relevant heat path depends on the mechanism."];
"vol4.plant.supply" [id="concept-vol4.plant.supply", label="Supply integrity", tooltip="The ability of the electrical supply to maintain valid operating voltage during coupled load transients."];
"vol4.inference.bandwidth" [id="concept-vol4.inference.bandwidth", label="Weight bandwidth", tooltip="Memory-transfer capacity available for the model weights needed by a fresh policy evaluation."];
"vol4.proposal.chunk" [id="concept-vol4.proposal.chunk", label="Action chunk", tooltip="A sequence of future setpoints proposed together so one model evaluation supplies several control steps."];
"vol4.proposal.horizon" [id="concept-vol4.proposal.horizon", label="Evidence horizon", tooltip="The interval over which observations and assumptions still justify using a proposal; longer output does not extend it."];
"vol4.timing.feedback-delay" [id="concept-vol4.timing.feedback-delay", label="Feedback-loop delay", tooltip="Time between a physical measurement and the feedback correction it produces in the same control loop; this loop-specific delay consumes phase margin."];
"vol4.control.phase-margin" [id="concept-vol4.control.phase-margin", label="Phase margin", tooltip="A feedback-loop stability margin consumed by delay at the loop crossover frequency; it is distinct from a stopping-distance budget."];
"vol4.timing.response-bound" [id="concept-vol4.timing.response-bound", label="Response-time bound", tooltip="An upper bound on permitted execution, blocking, interference, and communication delay under declared assumptions."];
"vol4.authority.chunk-lease" [id="concept-vol4.authority.chunk-lease", label="Chunk lease", tooltip="The bounded interval for which the permission processor may continue executing an admitted action chunk without renewal."];
"vol4.authority.actuation" [id="concept-vol4.authority.actuation", label="Actuation authority", tooltip="Exclusive physical control over the paths that can energize actuators; fast proposal generation does not grant it."];
"vol4.learning.shift" [id="concept-vol4.learning.shift", label="Endogenous covariate\nshift", tooltip="The change in visited states and subsequent observations caused by the learned policy executing its own actions."];
"vol4.learning.compounding-error" [id="concept-vol4.learning.compounding-error", label="Compounding error", tooltip="Growth of closed-loop consequences as early policy errors change later states and expose further errors; recovery behavior can limit that growth."];
"vol4.learning.recovery" [id="concept-vol4.learning.recovery", label="Recovery demonstrations", tooltip="Examples of corrective actions from off-nominal states, rather than only successful progress along an expert path."];
"vol4.deployment.odd" [id="concept-vol4.deployment.odd", label="Operational design\ndomain", tooltip="Declared external conditions in which the policy is intended to operate and for which its data and evaluation need coverage."];
"vol4.learning.mode-averaging" [id="concept-vol4.learning.mode-averaging", label="Mode averaging", tooltip="A point predictor averages distinct valid action modes into a motion that may belong to none of them."];
"vol4.learning.reality-gap" [id="concept-vol4.learning.reality-gap", label="Reality gap", tooltip="Mismatch between training simulation and the physical plant, including contact, sensing, timing, and actuation."];
"vol4.learning.checkpoint" [id="concept-vol4.learning.checkpoint", label="Policy checkpoint", tooltip="A versioned learned policy whose training provenance, decoder, interface, and evidence must be bound before evaluation and release."];
"vol4.evaluation.trial" [id="concept-vol4.evaluation.trial", label="Closed-loop trial", tooltip="A trial of the complete controller and plant in which actions determine later observations and the declared outcome is scored."];
"vol4.evaluation.confidence" [id="concept-vol4.evaluation.confidence", label="Failure-rate bound", tooltip="A statistical limit supported by a finite campaign under its sampling and outcome assumptions; no observed failures is not proof of zero risk."];
"vol4.sensing.capture" [id="concept-vol4.sensing.capture", label="Capture epoch", tooltip="The physical acquisition time attached to an observation, with the relevant clock-conversion and exposure uncertainty."];
"vol4.sensing.age" [id="concept-vol4.sensing.age", label="Observation age", tooltip="Elapsed time from physical capture to the point of use; queueing and transport continue to age the evidence."];
"vol4.sensing.spatial-error" [id="concept-vol4.sensing.spatial-error", label="Spatial error bound", tooltip="A qualified bound on measurement and calibration error used to reduce the clearance credited to a motion."];
"vol4.estimation.belief" [id="concept-vol4.estimation.belief", label="Belief state", tooltip="A dated estimate of physical state formed from prior dynamics and measurements, rather than a replacement for current observation."];
"vol4.estimation.covariance" [id="concept-vol4.estimation.covariance", label="Estimator covariance", tooltip="The estimator's stated uncertainty under its model and noise assumptions; consistency must be tested against physical residuals."];
"vol4.estimation.expiry" [id="concept-vol4.estimation.expiry", label="Belief expiry", tooltip="The point when propagated uncertainty or elapsed time exhausts the margin permitting a cached belief to support action."];
"vol4.intent.affordance" [id="concept-vol4.intent.affordance", label="Grounded affordance", tooltip="An action possibility tied to a physical object, the machine's capabilities, and the conditions required to execute it."];
"vol4.intent.goal" [id="concept-vol4.intent.goal", label="Goal set", tooltip="A checkable set of acceptable physical outcomes and constraints that gives the planner a specification to satisfy."];
"vol4.intent.lease" [id="concept-vol4.intent.lease", label="Intent lease", tooltip="A goal proposal with an expiry and validity conditions that must still hold when motion is planned and admitted."];
"vol4.motion.trajectory" [id="concept-vol4.motion.trajectory", label="Trajectory", tooltip="A time-indexed motion proposal carrying the state, horizon, and conditions needed for execution checks."];
"vol4.motion.feasibility" [id="concept-vol4.motion.feasibility", label="Kinodynamic feasibility", tooltip="Compatibility of a proposed path and timing with the plant's velocity, acceleration, torque, and dynamic limits."];
"vol4.motion.stopping-continuation" [id="concept-vol4.motion.stopping-continuation", label="Stopping continuation", tooltip="A state-matched, smoothly joined braking continuation that remains available if proposal renewal fails."];
"vol4.enforcement.envelope" [id="concept-vol4.enforcement.envelope", label="Stopping envelope", tooltip="States and motions that retain sufficient qualified clearance and braking authority for the declared stopping response."];
"vol4.enforcement.filter" [id="concept-vol4.enforcement.filter", label="Runtime safety filter", tooltip="A mechanism that checks or modifies a proposed control against modeled admissibility constraints, conditional on its plant, sensing, and timing premises."];
"vol4.enforcement.contact" [id="concept-vol4.enforcement.contact", label="Contact margin", tooltip="Remaining allowance for contact force, energy, and response delay when the task intentionally touches the environment."];
"vol4.enforcement.certified-floor" [id="concept-vol4.enforcement.certified-floor", label="Certified safety\nfunction", tooltip="A separately qualified protective function with a stated integrity claim; an unrated numerical filter does not acquire that claim merely by running above it."];
"vol4.placement.isolation" [id="concept-vol4.placement.isolation", label="Resource isolation", tooltip="Separation or bounded sharing of memory, supply, clock, reset, and compute resources between proposal and permission paths."];
"vol4.placement.throttling" [id="concept-vol4.placement.throttling", label="Thermal throttling", tooltip="Clock or performance reduction induced by a shared thermal state, which can persist after the workload that caused it stops."];
"vol4.timing.wcet" [id="concept-vol4.timing.wcet", label="Worst-case execution\ntime", tooltip="A declared upper execution-time bound for a specified binary and platform; observed maxima can falsify it but do not establish it."];
"vol4.intervention.delay" [id="concept-vol4.intervention.delay", label="Takeover delay", tooltip="Time consumed while a person perceives, decides, and transfers an intervention into the machine's admitted control path."];
"vol4.intervention.handoff" [id="concept-vol4.intervention.handoff", label="Single-writer handoff", tooltip="An authority-transfer protocol that prevents concurrent writers and requires fresh admission before the new proposer controls motion."];
"vol4.verification.fault" [id="concept-vol4.verification.fault", label="Fault injection", tooltip="A deliberate disturbance at a specified interface used to challenge a declared protection claim."];
"vol4.verification.envelope" [id="concept-vol4.verification.envelope", label="Operating envelope", tooltip="The coupled external conditions and internal compute, power, thermal, and actuation states over which a claim is qualified."];
"vol4.verification.oracle" [id="concept-vol4.verification.oracle", label="Test oracle", tooltip="A criterion fixed before a trial that distinguishes a valid pass, failure, or invalid test against the stated claim."];
"vol4.assurance.case" [id="concept-vol4.assurance.case", label="Safety case", tooltip="An inspectable argument connecting physical safety claims to evidence, assumptions, warrants, and possible defeaters."];
"vol4.assurance.manifest" [id="concept-vol4.assurance.manifest", label="Release manifest", tooltip="A signed binding of the release verdict to configuration identities, limits, evidence records, and conditions enforced at startup and operation."];
"vol4.assurance.conditions" [id="concept-vol4.assurance.conditions", label="Standing conditions", tooltip="Ongoing physical and organizational premises whose lapse withdraws a release verdict even without a software change."];
"vol4.accountability.approval" [id="concept-vol4.accountability.approval", label="Approval record", tooltip="A record of who accepted operational and organizational decisions, their evidence, conditions, and revocation responsibilities."];
"vol4.accountability.oversight" [id="concept-vol4.accountability.oversight", label="Human oversight", tooltip="An assigned human role that has enough time, information, and effective authority to intervene as the claim requires."];
"vol4.accountability.detection-gap" [id="concept-vol4.accountability.detection-gap", label="Subgroup detection gap", tooltip="A difference in detection performance across exposed groups that can delay response and consume their stopping clearance unequally."];
"vol4.limits.indistinguishability" [id="concept-vol4.limits.indistinguishability", label="Observational\nindistinguishability", tooltip="Different physical states require different responses but produce identical available observations through the action deadline."];
"vol4.limits.assumption" [id="concept-vol4.limits.assumption", label="Residual assumption", tooltip="An unresolved premise that remains explicit, with its operating restriction, owner, and missing evidence; recording it does not measure it."];
"vol4.boundary.irreversibility" -> "vol4.boundary.causal" [id="relation-vol4.field.boundary-irreversibility--boundary-causal", label="precludes rollback\nbeyond"];
"vol4.stopping.delay" -> "vol4.stopping.distance" [id="relation-vol4.field.stopping-delay--stopping-distance", label="increases"];
"vol4.boundary.proposal" -> "vol4.authority.actuation" [id="relation-vol4.field.boundary-proposal--authority-actuation", label="separates learned\noutput from"];
"vol4.plant.braking" -> "vol4.stopping.distance" [id="relation-vol4.field.plant-braking--stopping-distance", label="limits achievable"];
"vol4.plant.thermal" -> "vol4.plant.braking" [id="relation-vol4.field.plant-thermal--plant-braking", label="constrains delivered"];
"vol4.plant.supply" -> "vol4.authority.actuation" [id="relation-vol4.field.plant-supply--authority-actuation", label="supports independent"];
"vol4.inference.bandwidth" -> "vol4.proposal.chunk" [id="relation-vol4.field.inference-bandwidth--proposal-chunk", label="limits renewal of"];
"vol4.proposal.chunk" -> "vol4.proposal.horizon" [id="relation-vol4.field.proposal-chunk--proposal-horizon", label="does not extend"];
"vol4.proposal.horizon" -> "vol4.authority.chunk-lease" [id="relation-vol4.field.proposal-horizon--authority-chunk-lease", label="limits useful duration\nof"];
"vol4.timing.feedback-delay" -> "vol4.control.phase-margin" [id="relation-vol4.field.timing-feedback-delay--control-phase-margin", label="consumes"];
"vol4.timing.response-bound" -> "vol4.authority.chunk-lease" [id="relation-vol4.field.timing-response-bound--authority-chunk-lease", label="bounds overhead around"];
"vol4.authority.chunk-lease" -> "vol4.proposal.chunk" [id="relation-vol4.field.authority-chunk-lease--proposal-chunk", label="bounds stale execution\nof"];
"vol4.authority.actuation" -> "vol4.intervention.handoff" [id="relation-vol4.field.authority-actuation--intervention-handoff", label="is exclusive across"];
"vol4.authority.actuation" -> "vol4.boundary.causal" [id="relation-vol4.field.authority-actuation--boundary-causal", label="controls commands\ncrossing the"];
"vol4.timing.response-bound" -> "vol4.timing.feedback-delay" [id="relation-vol4.field.timing-response-bound--timing-feedback-delay", label="limits worst-case"];
"vol4.learning.shift" -> "vol4.learning.recovery" [id="relation-vol4.field.learning-shift--learning-recovery", label="creates need for"];
"vol4.learning.recovery" -> "vol4.learning.compounding-error" [id="relation-vol4.field.learning-recovery--learning-compounding-error", label="can limit"];
"vol4.learning.shift" -> "vol4.learning.compounding-error" [id="relation-vol4.field.learning-shift--learning-compounding-error", label="drives"];
"vol4.deployment.odd" -> "vol4.learning.checkpoint" [id="relation-vol4.field.deployment-odd--learning-checkpoint", label="defines required\ncoverage for"];
"vol4.learning.mode-averaging" -> "vol4.motion.trajectory" [id="relation-vol4.field.learning-mode-averaging--motion-trajectory", label="can invalidate"];
"vol4.learning.reality-gap" -> "vol4.learning.checkpoint" [id="relation-vol4.field.learning-reality-gap--learning-checkpoint", label="limits transfer\nevidence for"];
"vol4.learning.checkpoint" -> "vol4.evaluation.trial" [id="relation-vol4.field.learning-checkpoint--evaluation-trial", label="requires renewed"];
"vol4.evaluation.trial" -> "vol4.learning.shift" [id="relation-vol4.field.evaluation-trial--learning-shift", label="tests effects of"];
"vol4.evaluation.trial" -> "vol4.evaluation.confidence" [id="relation-vol4.field.evaluation-trial--evaluation-confidence", label="supports a conditional"];
"vol4.sensing.capture" -> "vol4.sensing.age" [id="relation-vol4.field.sensing-capture--sensing-age", label="starts the clock for"];
"vol4.sensing.age" -> "vol4.stopping.distance" [id="relation-vol4.field.sensing-age--stopping-distance", label="adds travel to"];
"vol4.sensing.spatial-error" -> "vol4.enforcement.envelope" [id="relation-vol4.field.sensing-spatial-error--enforcement-envelope", label="reduces credited\nclearance in"];
"vol4.sensing.capture" -> "vol4.estimation.belief" [id="relation-vol4.field.sensing-capture--estimation-belief", label="dates updates to"];
"vol4.estimation.covariance" -> "vol4.estimation.belief" [id="relation-vol4.field.estimation-covariance--estimation-belief", label="qualifies uncertainty\nin"];
"vol4.estimation.expiry" -> "vol4.estimation.belief" [id="relation-vol4.field.estimation-expiry--estimation-belief", label="withdraws action\nsupport from"];
"vol4.estimation.covariance" -> "vol4.estimation.expiry" [id="relation-vol4.field.estimation-covariance--estimation-expiry", label="can advance"];
"vol4.intent.affordance" -> "vol4.intent.goal" [id="relation-vol4.field.intent-affordance--intent-goal", label="grounds"];
"vol4.intent.goal" -> "vol4.motion.trajectory" [id="relation-vol4.field.intent-goal--motion-trajectory", label="specifies outcomes for"];
"vol4.intent.lease" -> "vol4.intent.goal" [id="relation-vol4.field.intent-lease--intent-goal", label="expires the authority\nof"];
"vol4.motion.feasibility" -> "vol4.motion.trajectory" [id="relation-vol4.field.motion-feasibility--motion-trajectory", label="constrains"];
"vol4.motion.trajectory" -> "vol4.motion.stopping-continuation" [id="relation-vol4.field.motion-trajectory--motion-stopping-continuation", label="must retain a qualified"];
"vol4.motion.stopping-continuation" -> "vol4.enforcement.envelope" [id="relation-vol4.field.motion-stopping-continuation--enforcement-envelope", label="provides braking motion\nwithin"];
"vol4.proposal.chunk" -> "vol4.proposal.horizon" [id="relation-vol4.field.proposal-chunk--proposal-horizon-3", label="trades renewal slack\nagainst"];
"vol4.enforcement.filter" -> "vol4.motion.trajectory" [id="relation-vol4.field.enforcement-filter--motion-trajectory", label="restricts proposed"];
"vol4.enforcement.filter" -> "vol4.enforcement.envelope" [id="relation-vol4.field.enforcement-filter--enforcement-envelope", label="conditionally preserves"];
"vol4.enforcement.contact" -> "vol4.stopping.distance" [id="relation-vol4.field.enforcement-contact--stopping-distance", label="requires more than\nfree-space"];
"vol4.enforcement.certified-floor" -> "vol4.enforcement.filter" [id="relation-vol4.field.enforcement-certified-floor--enforcement-filter", label="does not certify the"];
"vol4.enforcement.envelope" -> "vol4.plant.braking" [id="relation-vol4.field.enforcement-envelope--plant-braking", label="depends on credible"];
"vol4.authority.chunk-lease" -> "vol4.enforcement.envelope" [id="relation-vol4.field.authority-chunk-lease--enforcement-envelope", label="spends clearance within"];
"vol4.placement.isolation" -> "vol4.timing.response-bound" [id="relation-vol4.field.placement-isolation--timing-response-bound", label="protects assumptions of"];
"vol4.placement.throttling" -> "vol4.timing.wcet" [id="relation-vol4.field.placement-throttling--timing-wcet", label="can increase"];
"vol4.timing.wcet" -> "vol4.timing.response-bound" [id="relation-vol4.field.timing-wcet--timing-response-bound", label="is one component of"];
"vol4.intervention.delay" -> "vol4.stopping.distance" [id="relation-vol4.field.intervention-delay--stopping-distance", label="adds pre-brake travel\nto"];
"vol4.intervention.handoff" -> "vol4.authority.actuation" [id="relation-vol4.field.intervention-handoff--authority-actuation", label="transfers proposer\naccess beneath"];
"vol4.intervention.handoff" -> "vol4.motion.feasibility" [id="relation-vol4.field.intervention-handoff--motion-feasibility", label="must respect"];
"vol4.verification.envelope" -> "vol4.deployment.odd" [id="relation-vol4.field.verification-envelope--deployment-odd", label="extends"];
"vol4.verification.fault" -> "vol4.enforcement.filter" [id="relation-vol4.field.verification-fault--enforcement-filter", label="challenges premises of"];
"vol4.verification.oracle" -> "vol4.verification.fault" [id="relation-vol4.field.verification-oracle--verification-fault", label="scores"];
"vol4.verification.envelope" -> "vol4.assurance.case" [id="relation-vol4.field.verification-envelope--assurance-case", label="bounds evidence\ncredited to"];
"vol4.assurance.case" -> "vol4.assurance.conditions" [id="relation-vol4.field.assurance-case--assurance-conditions", label="binds evidence to"];
"vol4.assurance.manifest" -> "vol4.assurance.case" [id="relation-vol4.field.assurance-manifest--assurance-case", label="enforces the\nconfiguration of"];
"vol4.assurance.conditions" -> "vol4.assurance.manifest" [id="relation-vol4.field.assurance-conditions--assurance-manifest", label="can withdraw"];
"vol4.learning.checkpoint" -> "vol4.assurance.case" [id="relation-vol4.field.learning-checkpoint--assurance-case", label="can reopen"];
"vol4.assurance.case" -> "vol4.plant.braking" [id="relation-vol4.field.assurance-case--plant-braking", label="requires evidence of"];
"vol4.accountability.approval" -> "vol4.assurance.manifest" [id="relation-vol4.field.accountability-approval--assurance-manifest", label="records decisions\nbeyond"];
"vol4.accountability.oversight" -> "vol4.intervention.delay" [id="relation-vol4.field.accountability-oversight--intervention-delay", label="requires budgeted"];
"vol4.accountability.detection-gap" -> "vol4.stopping.distance" [id="relation-vol4.field.accountability-detection-gap--stopping-distance", label="can increase"];
