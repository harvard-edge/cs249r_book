digraph concepts {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.85", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#88949d", penwidth=1.15, fontname="Helvetica Neue", fontsize=16, margin="0.18,0.12"];
edge [fontname="Helvetica Neue", fontsize=12, color="#7a858e", fontcolor="#47535d", arrowsize=0.65];
graph [pack=true, packmode="array_u3"];
"mlsys.requirements" [id="concept-mlsys.requirements", label="System requirements", tooltip="Measurable desired behavior and constraints for a specified workload."];
"mlsys.data-quality" [id="concept-mlsys.data-quality", label="Data quality", tooltip="Fitness of recorded examples for the intended task, including validity, coverage, and error."];
"mlsys.data-selection" [id="concept-mlsys.data-selection", label="Data selection", tooltip="Allocating learning effort to examples according to value, coverage, and acquisition cost."];
"mlsys.generalization" [id="concept-mlsys.generalization", label="Generalization", tooltip="Performance on relevant examples or conditions beyond those used to fit the system."];
"mlsys.neural-network" [id="concept-mlsys.neural-network", label="Neural networks", tooltip="Parameterized compositions of differentiable operations used to learn representations and predictions."];
"mlsys.autodiff" [id="concept-mlsys.autodiff", label="Automatic\ndifferentiation", tooltip="Computing derivatives by composing local derivative rules through an execution graph."];
"mlsys.optimizer" [id="concept-mlsys.optimizer", label="Optimization algorithm", tooltip="A rule that uses training information to update model parameters and optimizer state."];
"mlsys.training-state" [id="concept-mlsys.training-state", label="Training state", tooltip="The parameters, gradients, optimizer variables, and other state needed to continue training."];
"mlsys.memory-capacity" [id="concept-mlsys.memory-capacity", label="Memory capacity", tooltip="Available storage for concurrently resident state and intermediates."];
"mlsys.quantization" [id="concept-mlsys.quantization", label="Quantization", tooltip="Representing values using a reduced discrete set with a specified encoding and approximation rule."];
"mlsys.precision" [id="concept-mlsys.precision", label="Numerical precision", tooltip="The representable values and arithmetic behavior of a numerical format."];
"mlsys.memory-bandwidth" [id="concept-mlsys.memory-bandwidth", label="Memory bandwidth", tooltip="The sustainable rate at which bytes move across a specified memory interface."];
"mlsys.roofline" [id="concept-mlsys.roofline", label="Roofline bound", tooltip="A performance bound combining a compute ceiling with an intensity-dependent bandwidth ceiling."];
"mlsys.arithmetic-intensity" [id="concept-mlsys.arithmetic-intensity", label="Arithmetic intensity", tooltip="Arithmetic work per byte transferred at a specified memory boundary."];
"mlsys.batching" [id="concept-mlsys.batching", label="Request batching", tooltip="Executing requests together to share work or improve resource use."];
"mlsys.service-capacity" [id="concept-mlsys.service-capacity", label="Service capacity", tooltip="The completion rate supported by a service under a stated workload and operating point."];
"mlsys.queueing" [id="concept-mlsys.queueing", label="Queueing delay", tooltip="Time a request waits for a resource before receiving service."];
"mlsys.tail-latency" [id="concept-mlsys.tail-latency", label="Tail latency", tooltip="A high quantile of a defined request-latency distribution."];
"mlsys.slo" [id="concept-mlsys.slo", label="Service-level objective", tooltip="A target for a defined service measure over a specified population and window."];
"mlsys.slo-goodput" [id="concept-mlsys.slo-goodput", label="SLO goodput", tooltip="The rate of useful completed work that satisfies the specified quality and service criteria."];
"mlsys.metrics" [id="concept-mlsys.metrics", label="Evaluation metrics", tooltip="Specified measurements of predictive or task behavior, with explicit populations and aggregation."];
"mlsys.monitoring" [id="concept-mlsys.monitoring", label="Production monitoring", tooltip="Collecting and interpreting signals about deployed system behavior and health."];
"mlsys.distribution-shift" [id="concept-mlsys.distribution-shift", label="Distribution shift", tooltip="A difference between development and deployment data-generating distributions."];
"mlsys.retraining" [id="concept-mlsys.retraining", label="Retraining", tooltip="Training a replacement version of a deployed model on updated or revised data, with timing and data chosen to balance staleness against training and validation cost."];
"mlsys.artifact-version" [id="concept-mlsys.artifact-version", label="Artifact versioning", tooltip="Identifying the exact model, code, data, configuration, and dependencies in an execution or release."];
"mlsys.rollout" [id="concept-mlsys.rollout", label="Staged rollout", tooltip="Increasing exposure to a candidate system through bounded release stages."];
"mlsys.rollback" [id="concept-mlsys.rollback", label="Rollback", tooltip="Returning to a previously accepted deployment configuration with compatible state."];
"mlsys.execution-time" [id="concept-mlsys.execution-time", label="Execution time", tooltip="Elapsed time for a specified execution boundary, workload, and operating condition."];
"mlsys.model-artifact" [id="concept-mlsys.model-artifact", label="Model artifact", tooltip="The learned parameters, structures, example stores, and metadata required to execute a model."];
"mlsys.linear-model" [id="concept-mlsys.linear-model", label="Linear models", tooltip="Models whose score is linear in their supplied features, with a possible output link function."];
"mlsys.tree-ensemble" [id="concept-mlsys.tree-ensemble", label="Tree ensembles", tooltip="Collections of decision trees whose branch traversal and aggregation determine predictions."];
"mlsys.kernel-method" [id="concept-mlsys.kernel-method", label="Kernel methods", tooltip="Models that score an input by a kernel similarity to retained training examples or to an explicit feature approximation, so storage and evaluation cost grow with the number of retained examples unless the kernel is approximated."];
"mlsys.nearest-neighbor" [id="concept-mlsys.nearest-neighbor", label="Nearest-neighbor models", tooltip="Predictions or retrieval based on similarity to stored examples or vectors."];
