digraph concepts {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.85", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#88949d", penwidth=1.15, fontname="Helvetica Neue", fontsize=16, margin="0.18,0.12"];
edge [fontname="Helvetica Neue", fontsize=12, color="#7a858e", fontcolor="#47535d", arrowsize=0.65];
"vol3.trajectory" [id="concept-vol3.trajectory", label="Trajectory", tooltip="The governed sequence of model proposals, mediated actions, observations, and completion evidence for one task.", fillcolor="#fcebed", color="#a51c30", penwidth=1.8];
"vol3.contract" [id="concept-vol3.contract", label="Task contract", tooltip="A task specification binds the goal, environment, permitted actions, available observations, and completion criteria before execution."];
"vol3.horizon" [id="concept-vol3.horizon", label="Execution horizon", tooltip="The number of decision turns over which errors, costs, and recovery obligations can accumulate."];
"vol3.state" [id="concept-vol3.state", label="Carried state", tooltip="Files, records, or execution state persist between invocations and can be corrupted or become stale."];
"vol3.authority" [id="concept-vol3.authority", label="Effect authority", tooltip="The permitted reach of tool actions exposes resources to effects, including disclosure through read access."];
"vol3.closure" [id="concept-vol3.closure", label="Invariant closure", tooltip="Runtime-enforced bounds and property-specific evidence constrain proposals; a plausible model response does not establish correctness."];
"vol3.proposal" [id="concept-vol3.proposal", label="Model proposal", tooltip="A generated response or tool request is a candidate whose structure, permission, and state preconditions require external checks."];
"vol3.observation" [id="concept-vol3.observation", label="Tool observation", tooltip="A recorded tool result reports an actual execution outcome, including errors and truncation, and becomes input to a later model call."];
"vol3.grammar" [id="concept-vol3.grammar", label="Grammar constraint", tooltip="Token-level constraints restrict legal output structures; they do not certify task semantics, permission, or external state."];
"vol3.search" [id="concept-vol3.search", label="Test-time search", tooltip="A bounded deliberation policy allocates generation across depth, breadth, and feedback before choosing a candidate."];
"vol3.selection" [id="concept-vol3.selection", label="Candidate selection", tooltip="A selection procedure chooses among generated candidates; candidate availability alone does not guarantee that the chosen result is valid."];
"vol3.precision" [id="concept-vol3.precision", label="Verifier precision", tooltip="The fraction of passing candidates that meet the stated validity specification depends on candidate base rates and verifier error rates."];
"vol3.working-context" [id="concept-vol3.working-context", label="Working context", tooltip="The selected task-relevant token sequence supplied to the next invocation is distinct from the full trajectory history."];
"vol3.compaction" [id="concept-vol3.compaction", label="Context compaction", tooltip="A policy replaces or removes active history to fit a working budget while preserving protected task facts and pending obligations."];
"vol3.invalidation" [id="concept-vol3.invalidation", label="Evidence invalidation", tooltip="A changed source or refuted assumption can invalidate dependent claims; a recent token position does not make evidence current."];
"vol3.kv" [id="concept-vol3.kv", label="Retained KV state", tooltip="Cached attention keys and values are derived execution state for a particular model and token prefix, occupying physical serving memory."];
"vol3.prefix-reuse" [id="concept-vol3.prefix-reuse", label="Prefix reuse", tooltip="Compatible exact token prefixes can reuse attention computation; source authorization and current applicability remain separate checks."];
"vol3.residency" [id="concept-vol3.residency", label="Paused-state residency", tooltip="Retaining, moving, or dropping cached attention state during a tool wait trades memory residence against transfer or recomputation cost."];
"vol3.memory" [id="concept-vol3.memory", label="Persistent memory\nrecord", tooltip="A stored cross-session record has an explicit role and provenance; retrieval does not turn stored text into an authoritative instruction."];
"vol3.retrieval" [id="concept-vol3.retrieval", label="Retrieval contract", tooltip="A bounded retrieval request specifies scope and a result envelope retains source identity, versions, and access conditions."];
"vol3.provenance" [id="concept-vol3.provenance", label="Source provenance", tooltip="A record carries the source and generation needed to determine whether retrieved evidence remains valid and permitted."];
"vol3.mediation" [id="concept-vol3.mediation", label="Complete mediation", tooltip="Every actual tool dispatch passes independent structure, authority, live-state, and budget checks at the execution boundary."];
"vol3.operation" [id="concept-vol3.operation", label="Operation identity", tooltip="A stable logical-operation identifier correlates attempts and outcomes only under an endpoint contract that defines its repeat behavior."];
"vol3.settlement" [id="concept-vol3.settlement", label="Effect settlement", tooltip="Correlated endpoint evidence establishes an effect or its absence; a timeout or missing reply leaves the outcome unknown."];
"vol3.capability" [id="concept-vol3.capability", label="Capability grant", tooltip="A runtime-issued grant bounds the concrete resources and operations an execution may access, with expiry and revocation rules."];
"vol3.isolation" [id="concept-vol3.isolation", label="Isolation envelope", tooltip="A process, container, restricted runtime, or virtual machine places an enforcement boundary below untrusted generated code."];
"vol3.egress" [id="concept-vol3.egress", label="Egress control", tooltip="An external enforcement point restricts destinations, operations, and data leaving the execution environment."];
"vol3.injection" [id="concept-vol3.injection", label="Prompt injection", tooltip="Untrusted task material attempts to redirect a model-controlled workflow across an instruction or authority boundary."];
"vol3.flow" [id="concept-vol3.flow", label="Information-flow policy", tooltip="Integrity and confidentiality labels constrain how source content may influence operations and reach recipients."];
"vol3.approval" [id="concept-vol3.approval", label="Action-bound approval", tooltip="A human or policy approval binds a specific operation, parameters, state, and expiry rather than conferring general tool authority."];
"vol3.guard" [id="concept-vol3.guard", label="Transition guard", tooltip="Runtime-owned predicates determine whether a trajectory may advance, wait, dispatch work, or finalize under current conditions."];
"vol3.budget" [id="concept-vol3.budget", label="Trajectory budget", tooltip="A runtime account bounds turns, tokens, time, and monetary liability, including work already reserved or outstanding."];
"vol3.waiting" [id="concept-vol3.waiting", label="Supervised waiting", tooltip="The harness suspends model continuation while named external work remains supervised, retaining ownership and wakeup conditions."];
"vol3.log" [id="concept-vol3.log", label="Trajectory log", tooltip="An append-only recovery record retains operation identities, admissions, observed results, and obligations across the declared failure domain."];
"vol3.intent" [id="concept-vol3.intent", label="Durable intent", tooltip="A durable pre-dispatch record preserves admitted operation identity and outstanding liability; it does not prove a remote effect happened."];
"vol3.checkpoint" [id="concept-vol3.checkpoint", label="Recovery checkpoint", tooltip="A consistent local state snapshot is bound to a log position and compatible environment; external effects still require reconciliation."];
"vol3.compensation" [id="concept-vol3.compensation", label="Semantic compensation", tooltip="A new forward action establishes declared fallback postconditions after a committed effect without erasing history or charges."];
"vol3.saga" [id="concept-vol3.saga", label="Trajectory saga", tooltip="A recovery coordinator registers obligations before effects and orders compensations by dependencies and settlement evidence."];
"vol3.watchdog" [id="concept-vol3.watchdog", label="Semantic watchdog", tooltip="An external supervisor compares progress evidence and consumed allowance to detect unproductive trajectories and trigger bounded responses."];
"vol3.acceptance" [id="concept-vol3.acceptance", label="Task acceptance", tooltip="A verdict checks the artifact, process, authority, and evidence against a declared task contract; it is distinct from full semantic correctness."];
"vol3.grader" [id="concept-vol3.grader", label="Grader isolation", tooltip="The authoritative test definitions and verdict channel remain outside the reach of the candidate code being assessed."];
"vol3.repeatability" [id="concept-vol3.repeatability", label="Repeated-run\nconsistency", tooltip="Reliability across repeated executions of the same task differs from the chance of finding at least one passing candidate in a pool."];
"vol3.coverage" [id="concept-vol3.coverage", label="Evidence coverage", tooltip="Each test or evaluation instrument supports named properties under stated conditions; passing finite tests does not establish a universal proof."];
"vol3.trace" [id="concept-vol3.trace", label="Trajectory trace", tooltip="Correlated model, tool, state, authority, timing, and cost records support diagnosis of an end-to-end trajectory."];
"vol3.diagnosis" [id="concept-vol3.diagnosis", label="Causal diagnosis", tooltip="A controlled intervention tests a suspected failure cause while holding relevant conditions fixed; a chronological replay alone does not establish causality."];
"vol3.release" [id="concept-vol3.release", label="Staged release", tooltip="Offline, shadow, and canary evidence constrain deployment exposure through explicit stopping and release gates."];
"vol3.artifact" [id="concept-vol3.artifact", label="Training artifact", tooltip="One trajectory can produce distinct imitation segments, preference comparisons, or task environments, each with its own admission criteria."];
"vol3.split" [id="concept-vol3.split", label="Task-group split", tooltip="Related tasks and all their derived records share a partition; held-out evidence stays isolated from upstream collection and selection."];
"vol3.intervention" [id="concept-vol3.intervention", label="Intervention ladder", tooltip="Remedies are ordered by engineering cost and reversibility; evidence of a residual capability gap justifies moving to weight updates."];
"vol3.mask" [id="concept-vol3.mask", label="Loss mask", tooltip="A supervised objective selects demonstrated policy outputs as targets while keeping observations and unselected actions as conditioning context."];
"vol3.exposure-bias" [id="concept-vol3.exposure-bias", label="Exposure bias", tooltip="A policy trained on recorded reference prefixes encounters a different state distribution when its own actions determine future inputs."];
"vol3.closed-loop" [id="concept-vol3.closed-loop", label="Closed-loop evaluation", tooltip="A policy is assessed on the task outcomes produced by its own actions under a fixed contract and budget, independently of teacher-forced loss."];
"vol3.reward" [id="concept-vol3.reward", label="Verifiable reward", tooltip="A measured rollout score supplies an optimization signal under a specified evaluator; it may incompletely represent the intended task."];
"vol3.credit" [id="concept-vol3.credit", label="Credit assignment", tooltip="The learning objective attributes trajectory outcomes to sampled policy actions; prompts and tool feedback condition actions without becoming sampled actions."];
"vol3.reward-hacking" [id="concept-vol3.reward-hacking", label="Reward hacking", tooltip="A policy increases measured reward through gaps in the task proxy or by manipulating its measurement mechanism."];
"vol3.delegation" [id="concept-vol3.delegation", label="Task delegation", tooltip="A parent assigns bounded work through a typed task envelope and receives a receipt while retaining integration and authority obligations."];
"vol3.coordination" [id="concept-vol3.coordination", label="Coordination tax", tooltip="Handoffs add context delivery, scheduling, joining, and integration work whose cost can exceed the useful concurrency gained."];
"vol3.integration" [id="concept-vol3.integration", label="Integration validation", tooltip="Returned work must be checked against its dependencies and the current integration state; a clean merge does not certify a valid result."];
"vol3.cost" [id="concept-vol3.cost", label="Cost per accepted task", tooltip="Total cohort spending includes failed attempts and retries and is divided by distinct accepted tasks under the declared contract."];
"vol3.goodput" [id="concept-vol3.goodput", label="Trajectory goodput", tooltip="The delivered rate counts accepted tasks rather than tokens or attempts, subject to time, resident-state, service, and quota constraints."];
"vol3.conservation" [id="concept-vol3.conservation", label="Budget conservation", tooltip="A parent and descendants conserve allocations across settled charges, reservations, and free balances; delegation cannot duplicate spending authority."];
"vol3.trajectory" -> "vol3.contract" [id="relation-vol3.field.trajectory.contract", label="is governed by"];
"vol3.trajectory" -> "vol3.horizon" [id="relation-vol3.field.trajectory.horizon", label="extends across"];
"vol3.trajectory" -> "vol3.state" [id="relation-vol3.field.trajectory.state", label="carries"];
"vol3.trajectory" -> "vol3.authority" [id="relation-vol3.field.trajectory.authority", label="exercises"];
"vol3.closure" -> "vol3.proposal" [id="relation-vol3.field.closure.proposal", label="constrains"];
"vol3.contract" -> "vol3.acceptance" [id="relation-vol3.field.contract.acceptance", label="defines criteria for"];
"vol3.trajectory" -> "vol3.observation" [id="relation-vol3.field.trajectory.observation", label="records"];
"vol3.proposal" -> "vol3.mediation" [id="relation-vol3.field.proposal.mediation", label="requires checks through"];
"vol3.observation" -> "vol3.working-context" [id="relation-vol3.field.observation.working-context", label="feeds"];
"vol3.grammar" -> "vol3.proposal" [id="relation-vol3.field.grammar.proposal", label="restricts the structure\nof"];
"vol3.grammar" -> "vol3.mediation" [id="relation-vol3.field.grammar.mediation", label="does not replace"];
"vol3.search" -> "vol3.selection" [id="relation-vol3.field.search.selection", label="produces candidates for"];
"vol3.selection" -> "vol3.precision" [id="relation-vol3.field.selection.precision", label="depends on"];
"vol3.search" -> "vol3.coverage" [id="relation-vol3.field.search.coverage", label="can expose gaps in"];
"vol3.compaction" -> "vol3.prefix-reuse" [id="relation-vol3.field.compaction.prefix-reuse", label="can invalidate"];
"vol3.compaction" -> "vol3.working-context" [id="relation-vol3.field.compaction.working-context", label="replaces parts of"];
"vol3.invalidation" -> "vol3.working-context" [id="relation-vol3.field.invalidation.working-context", label="withdraws stale support\nin"];
"vol3.kv" -> "vol3.working-context" [id="relation-vol3.field.kv.working-context", label="is derived from"];
"vol3.prefix-reuse" -> "vol3.kv" [id="relation-vol3.field.prefix-reuse.kv", label="reuses compatible"];
"vol3.residency" -> "vol3.kv" [id="relation-vol3.field.residency.kv", label="governs retention of"];
"vol3.waiting" -> "vol3.residency" [id="relation-vol3.field.waiting.residency", label="can extend"];
"vol3.retrieval" -> "vol3.working-context" [id="relation-vol3.field.retrieval.working-context", label="supplies evidence for"];
"vol3.retrieval" -> "vol3.memory" [id="relation-vol3.field.retrieval.memory", label="governs reads of"];
"vol3.memory" -> "vol3.provenance" [id="relation-vol3.field.memory.provenance", label="retains"];
"vol3.provenance" -> "vol3.invalidation" [id="relation-vol3.field.provenance.invalidation", label="supports"];
"vol3.mediation" -> "vol3.capability" [id="relation-vol3.field.mediation.capability", label="checks"];
"vol3.settlement" -> "vol3.observation" [id="relation-vol3.field.settlement.observation", label="requires correlated"];
"vol3.capability" -> "vol3.authority" [id="relation-vol3.field.capability.authority", label="bounds"];
"vol3.isolation" -> "vol3.capability" [id="relation-vol3.field.isolation.capability", label="enforces the boundary\nof"];
"vol3.egress" -> "vol3.isolation" [id="relation-vol3.field.egress.isolation", label="restricts channels\nacross"];
"vol3.injection" -> "vol3.observation" [id="relation-vol3.field.injection.observation", label="arrives through"];
"vol3.flow" -> "vol3.working-context" [id="relation-vol3.field.flow.working-context", label="tracks origins through"];
"vol3.approval" -> "vol3.proposal" [id="relation-vol3.field.approval.proposal", label="narrows authority for"];
"vol3.flow" -> "vol3.egress" [id="relation-vol3.field.flow.egress", label="constrains permitted"];
"vol3.guard" -> "vol3.trajectory" [id="relation-vol3.field.guard.trajectory", label="controls continuation\nof"];
"vol3.guard" -> "vol3.budget" [id="relation-vol3.field.guard.budget", label="checks available"];
"vol3.waiting" -> "vol3.trajectory" [id="relation-vol3.field.waiting.trajectory", label="suspends continuation\nof"];
"vol3.waiting" -> "vol3.settlement" [id="relation-vol3.field.waiting.settlement", label="retains obligations for"];
"vol3.operation" -> "vol3.settlement" [id="relation-vol3.field.operation.settlement", label="correlates evidence for"];
"vol3.log" -> "vol3.intent" [id="relation-vol3.field.log.intent", label="persists"];
"vol3.intent" -> "vol3.settlement" [id="relation-vol3.field.intent.settlement", label="does not establish"];
"vol3.checkpoint" -> "vol3.log" [id="relation-vol3.field.checkpoint.log", label="binds restored state to"];
"vol3.checkpoint" -> "vol3.settlement" [id="relation-vol3.field.checkpoint.settlement", label="does not replace"];
"vol3.saga" -> "vol3.compensation" [id="relation-vol3.field.saga.compensation", label="registers obligations\nfor"];
"vol3.compensation" -> "vol3.settlement" [id="relation-vol3.field.compensation.settlement", label="requires evidence of"];
"vol3.checkpoint" -> "vol3.compensation" [id="relation-vol3.field.checkpoint.compensation", label="restores local state\nseparately from"];
"vol3.watchdog" -> "vol3.trajectory" [id="relation-vol3.field.watchdog.trajectory", label="uses evidence to bound"];
"vol3.grader" -> "vol3.acceptance" [id="relation-vol3.field.grader.acceptance", label="protects measurement\nfor"];
"vol3.coverage" -> "vol3.acceptance" [id="relation-vol3.field.coverage.acceptance", label="limits claims from"];
"vol3.repeatability" -> "vol3.search" [id="relation-vol3.field.repeatability.search", label="differs from coverage\nunder"];
"vol3.trace" -> "vol3.diagnosis" [id="relation-vol3.field.trace.diagnosis", label="provides observations\nfor"];
"vol3.release" -> "vol3.acceptance" [id="relation-vol3.field.release.acceptance", label="requires evidence about"];
"vol3.trace" -> "vol3.trajectory" [id="relation-vol3.field.trace.trajectory", label="records the course of"];
"vol3.artifact" -> "vol3.trajectory" [id="relation-vol3.field.artifact.trajectory", label="is derived from"];
"vol3.split" -> "vol3.coverage" [id="relation-vol3.field.split.coverage", label="protects held-out"];
"vol3.intervention" -> "vol3.diagnosis" [id="relation-vol3.field.intervention.diagnosis", label="uses evidence from"];
"vol3.mask" -> "vol3.artifact" [id="relation-vol3.field.mask.artifact", label="selects targets within"];
"vol3.exposure-bias" -> "vol3.closed-loop" [id="relation-vol3.field.exposure-bias.closed-loop", label="motivates"];
"vol3.closed-loop" -> "vol3.acceptance" [id="relation-vol3.field.closed-loop.acceptance", label="measures deployed"];
"vol3.reward" -> "vol3.reward-hacking" [id="relation-vol3.field.reward.reward-hacking", label="can incentivize"];
"vol3.reward" -> "vol3.credit" [id="relation-vol3.field.reward.credit", label="supplies outcome\ninformation for"];
"vol3.reward-hacking" -> "vol3.grader" [id="relation-vol3.field.reward-hacking.grader", label="motivates protection by"];
"vol3.delegation" -> "vol3.coordination" [id="relation-vol3.field.delegation.coordination", label="incurs"];
"vol3.delegation" -> "vol3.integration" [id="relation-vol3.field.delegation.integration", label="requires"];
"vol3.delegation" -> "vol3.capability" [id="relation-vol3.field.delegation.capability", label="requires attenuation of"];
"vol3.acceptance" -> "vol3.cost" [id="relation-vol3.field.acceptance.cost", label="defines the denominator\nof"];
"vol3.conservation" -> "vol3.budget" [id="relation-vol3.field.conservation.budget", label="accounts for delegated"];
"vol3.goodput" -> "vol3.acceptance" [id="relation-vol3.field.goodput.acceptance", label="counts completed tasks\nsatisfying"];
}
