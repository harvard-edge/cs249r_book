  "checks": [
    {
      "concept": "vol1.serving.context",
      "question": "The model weights fit on the accelerator. What else determines how many conversations can remain resident?",
      "choices": [
        "The KV footprint of each conversation and the memory left for caches.",
        "Only the number of model weights.",
        "Only the peak arithmetic rate."
      ],
      "answer": 0,
      "explanation": "Weights fitting establishes model residency. Context-dependent KV state must also fit for every resident conversation."
    }
  ],
