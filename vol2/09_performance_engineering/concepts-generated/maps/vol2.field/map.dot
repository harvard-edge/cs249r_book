digraph concepts {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.85", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#88949d", penwidth=1.15, fontname="Helvetica Neue", fontsize=16, margin="0.18,0.12"];
edge [fontname="Helvetica Neue", fontsize=12, color="#7a858e", fontcolor="#47535d", arrowsize=0.65];
"vol2.fleet.step-time" [id="concept-vol2.fleet.step-time", label="Distributed step time", tooltip="The critical-path time to advance one distributed training step, including compute, exposed communication, and coordination.", fillcolor="#fcebed", color="#a51c30", penwidth=1.8];
"vol2.fleet.communication-intensity" [id="concept-vol2.fleet.communication-intensity", label="Communication intensity", tooltip="Network bytes transferred per unit of local computation for a specified distributed workload."];
"vol2.fleet.scaling-laws" [id="concept-vol2.fleet.scaling-laws", label="Empirical scaling laws", tooltip="Empirical relationships between model loss and training resources within a fitted regime."];
"vol2.hardware.memory-capacity" [id="concept-vol2.hardware.memory-capacity", label="Memory capacity", tooltip="The amount of state that can reside in a memory domain at once."];
"vol2.hardware.bandwidth-hierarchy" [id="concept-vol2.hardware.bandwidth-hierarchy", label="Bandwidth hierarchy", tooltip="The unequal data-transfer rates within an accelerator, within a node, and between nodes."];
"vol2.hardware.power-envelope" [id="concept-vol2.hardware.power-envelope", label="Rack power envelope", tooltip="The electrical and thermal limits on the equipment that a rack can operate concurrently."];
"vol2.network.startup-latency" [id="concept-vol2.network.startup-latency", label="Message startup latency", tooltip="The fixed startup component of a transfer that matters most for small messages."];
"vol2.network.bisection-bandwidth" [id="concept-vol2.network.bisection-bandwidth", label="Bisection bandwidth", tooltip="The minimum aggregate link capacity across any cut that divides the cluster into two equal groups."];
"vol2.network.congestion" [id="concept-vol2.network.congestion", label="Network congestion", tooltip="Queueing and contention caused when offered traffic exceeds the service capacity of shared network paths."];
"vol2.storage.input-pipeline" [id="concept-vol2.storage.input-pipeline", label="Input pipeline", tooltip="The staged path that reads, transforms, and delivers batches to accelerators."];
"vol2.storage.prefetch" [id="concept-vol2.storage.prefetch", label="Prefetching", tooltip="Preparing future input batches while the current batch computes, subject to buffer and service-rate limits."];
"vol2.storage.durable-checkpoint" [id="concept-vol2.storage.durable-checkpoint", label="Durable checkpoint", tooltip="A completed recoverable state version persisted beyond the failure domain it is meant to survive."];
"vol2.storage.versioned-artifact" [id="concept-vol2.storage.versioned-artifact", label="Versioned artifact", tooltip="An identifiable data or model version with a defined publication boundary and provenance."];
"vol2.collective.allreduce" [id="concept-vol2.collective.allreduce", label="AllReduce", tooltip="A collective that reduces contributions from every participant and returns the result to every participant."];
"vol2.collective.overlap" [id="concept-vol2.collective.overlap", label="Communication overlap", tooltip="Executing eligible communication concurrently with independent compute to hide part of its elapsed cost."];
"vol2.collective.gradient-compression" [id="concept-vol2.collective.gradient-compression", label="Gradient compression", tooltip="Encoding gradient updates with fewer transmitted bits, with convergence and encoding costs to evaluate."];
"vol2.collective.allgather" [id="concept-vol2.collective.allgather", label="AllGather", tooltip="A collective that assembles the contributions of all ranks into a complete tensor at every rank."];
"vol2.collective.reduce-scatter" [id="concept-vol2.collective.reduce-scatter", label="ReduceScatter", tooltip="A collective that reduces corresponding input contributions and distributes different reduced shards among ranks."];
"vol2.training.data-parallelism" [id="concept-vol2.training.data-parallelism", label="Data parallelism", tooltip="Replicating a model across workers that process distinct portions of a batch and combine their updates."];
"vol2.training.tensor-parallelism" [id="concept-vol2.training.tensor-parallelism", label="Tensor parallelism", tooltip="Partitioning an individual layer's tensor computation across cooperating accelerators."];
"vol2.training.pipeline-parallelism" [id="concept-vol2.training.pipeline-parallelism", label="Pipeline parallelism", tooltip="Partitioning model stages across devices and scheduling microbatches through those stages."];
"vol2.training.state-sharding" [id="concept-vol2.training.state-sharding", label="Training-state sharding", tooltip="Partitioning optimizer state, gradients, or parameters among data-parallel workers instead of keeping every state replicated."];
"vol2.training.critical-batch" [id="concept-vol2.training.critical-batch", label="Critical batch size", tooltip="A workload-dependent scale beyond which larger batches yield diminishing optimization progress per additional sample."];
"vol2.reliability.failure-rate" [id="concept-vol2.reliability.failure-rate", label="Job failure rate", tooltip="The rate at which failures interrupt a specified distributed job under stated component and correlation assumptions."];
"vol2.reliability.consistent-cut" [id="concept-vol2.reliability.consistent-cut", label="Consistent checkpoint\ncut", tooltip="A set of saved worker states that represents one mutually compatible point in distributed execution."];
"vol2.reliability.recovery" [id="concept-vol2.reliability.recovery", label="Recovery", tooltip="Detecting and isolating failure, restoring valid state, and returning the distributed job to useful execution."];
"vol2.scheduling.gang" [id="concept-vol2.scheduling.gang", label="Gang scheduling", tooltip="Allocating a tightly coupled job's required workers together so that partial allocation does not strand capacity."];
"vol2.scheduling.placement" [id="concept-vol2.scheduling.placement", label="Topology-aware\nplacement", tooltip="Assigning a job's workers to physical resources according to its traffic pattern and available link hierarchy."];
"vol2.scheduling.fairness" [id="concept-vol2.scheduling.fairness", label="Resource fairness", tooltip="A selected rule for sharing feasible fleet capacity among competing users or jobs."];
"vol2.goodput.ml" [id="concept-vol2.goodput.ml", label="ML goodput", tooltip="The fraction of fleet capacity-time that becomes useful work at the hardware ideal rate, decomposed into scheduling, runtime, and program factors."];
"vol2.goodput.scheduling" [id="concept-vol2.goodput.scheduling", label="Scheduling goodput", tooltip="The fraction of in-service fleet capacity-time held by complete allocations over a fixed calendar window; it does not measure work inside an allocation."];
"vol2.goodput.runtime" [id="concept-vol2.goodput.runtime", label="Runtime goodput", tooltip="The fraction of allocated opportunity retained after execution interruptions and runtime overhead under the stated measurement contract."];
"vol2.goodput.program" [id="concept-vol2.goodput.program", label="Program goodput", tooltip="The fraction of the hardware ideal rate realized by useful program operations during retained execution; distinct from progress per training example."];
"vol2.goodput.statistical" [id="concept-vol2.goodput.statistical", label="Statistical goodput", tooltip="Progress toward a specified learning target per processed training example, distinct from useful operations per second."];
"vol2.serving.slo-goodput" [id="concept-vol2.serving.slo-goodput", label="SLO goodput", tooltip="The rate of completed requests that meet the stated time-to-first-token (TTFT) and time-per-output-token (TPOT) targets for a fixed request mix."];
"vol2.serving.batching" [id="concept-vol2.serving.batching", label="Request batching", tooltip="Grouping requests for shared accelerator execution to trade weight reuse against waiting time and resource demand."];
"vol2.serving.kv-cache" [id="concept-vol2.serving.kv-cache", label="KV cache", tooltip="Stored attention keys and values whose per-sequence growth constrains concurrent autoregressive requests."];
"vol2.serving.concurrency" [id="concept-vol2.serving.concurrency", label="Resident sequence count", tooltip="The number of active sequences whose attention state resides in a serving replica; feasible count depends on their total cached tokens and available memory."];
"vol2.federated.fedavg" [id="concept-vol2.federated.fedavg", label="Federated averaging", tooltip="Combining client-trained model updates into a shared model using an explicitly defined weighting rule."];
"vol2.federated.participation" [id="concept-vol2.federated.participation", label="Client participation", tooltip="The selected set and sampling process of devices that contribute to a federated round."];
"vol2.federated.secure-aggregation" [id="concept-vol2.federated.secure-aggregation", label="Secure aggregation", tooltip="A protocol that reveals an aggregate update while hiding individual contributions within its stated threat model."];
"vol2.operations.evaluation-contract" [id="concept-vol2.operations.evaluation-contract", label="Evaluation contract", tooltip="The versioned definition of a deployment's task, evidence, acceptance tests, and operating limits."];
"vol2.operations.rollout" [id="concept-vol2.operations.rollout", label="Staged rollout", tooltip="Incrementally exposing live traffic to a candidate release while measuring acceptance and preserving rollback capability."];
"vol2.operations.registry" [id="concept-vol2.operations.registry", label="Dependency registry", tooltip="A versioned record of model artifacts, provenance, evaluations, and dependencies used for impact analysis and release control."];
"vol2.security.poisoning" [id="concept-vol2.security.poisoning", label="Data poisoning", tooltip="Adversarial manipulation of training data or updates to alter learned behavior."];
"vol2.privacy.dp" [id="concept-vol2.privacy.dp", label="Differential privacy", tooltip="A mechanism-level bound on how much a released-result distribution changes when a specified protected contribution changes."];
"vol2.privacy.budget" [id="concept-vol2.privacy.budget", label="Privacy budget", tooltip="The accumulated privacy-loss guarantee for a declared neighboring relation, sampling process, and composition rule."];
"vol2.robustness.shift" [id="concept-vol2.robustness.shift", label="Distribution shift", tooltip="A change between training or reference data and the operational data-generating distribution."];
"vol2.robustness.selective-prediction" [id="concept-vol2.robustness.selective-prediction", label="Selective prediction", tooltip="A decision rule that answers selected requests and abstains or routes the remainder under a measured risk-coverage contract."];
"vol2.robustness.poisoning-defense" [id="concept-vol2.robustness.poisoning-defense", label="Poisoning defenses", tooltip="Layered controls on source provenance, incoming data, training, and post-training behavior that reduce specified poisoning risks."];
"vol2.robustness.fallback-capacity" [id="concept-vol2.robustness.fallback-capacity", label="Fallback capacity", tooltip="The service or human-review capacity needed to handle the rate and work of requests deferred by the primary predictor within their response deadlines."];
"vol2.sustainability.operational-carbon" [id="concept-vol2.sustainability.operational-carbon", label="Operational carbon", tooltip="Emissions attributed to operating energy under a stated facility boundary and grid-carbon signal."];
"vol2.sustainability.embodied-carbon" [id="concept-vol2.sustainability.embodied-carbon", label="Embodied carbon", tooltip="Emissions from manufacturing and other non-operating lifecycle processes allocated to the measured system or workload."];
"vol2.sustainability.carbon-scheduling" [id="concept-vol2.sustainability.carbon-scheduling", label="Carbon-aware scheduling", tooltip="Choosing workload time or location using a declared carbon signal while respecting deadlines, capacity, and movement costs."];
"vol2.sustainability.energy" [id="concept-vol2.sustainability.energy", label="Operating energy", tooltip="The time integral of operating power across a declared set of devices and facility consumers."];
"vol2.governance.assurance" [id="concept-vol2.governance.assurance", label="Assurance case", tooltip="A bounded deployment claim supported by evidence, controls, accountable ownership, and rules for material change."];
"vol2.governance.fairness" [id="concept-vol2.governance.fairness", label="Fairness criterion", tooltip="A selected formal or normative requirement about how model outcomes or errors are distributed across affected groups."];
"vol2.governance.contestability" [id="concept-vol2.governance.contestability", label="Contestability", tooltip="The ability of affected people to challenge a decision and obtain investigation and an actionable remedy."];
"vol2.fleet.scaling-laws" -> "vol2.hardware.memory-capacity" [id="relation-vol2.field.01", label="drive demand for"];
"vol2.fleet.communication-intensity" -> "vol2.fleet.step-time" [id="relation-vol2.field.02", label="increases exposed cost\nin"];
"vol2.hardware.memory-capacity" -> "vol2.training.state-sharding" [id="relation-vol2.field.03", label="motivates"];
"vol2.hardware.bandwidth-hierarchy" -> "vol2.training.tensor-parallelism" [id="relation-vol2.field.04", label="constrains"];
"vol2.hardware.power-envelope" -> "vol2.scheduling.placement" [id="relation-vol2.field.05", label="bounds feasible"];
"vol2.network.startup-latency" -> "vol2.collective.allreduce" [id="relation-vol2.field.06", label="adds per-round cost to"];
"vol2.network.bisection-bandwidth" -> "vol2.collective.allreduce" [id="relation-vol2.field.07", label="bounds cross-cut\ntraffic for"];
"vol2.network.congestion" -> "vol2.fleet.step-time" [id="relation-vol2.field.08", label="can lengthen"];
"vol2.storage.prefetch" -> "vol2.storage.input-pipeline" [id="relation-vol2.field.09", label="hides latency in"];
"vol2.storage.input-pipeline" -> "vol2.fleet.step-time" [id="relation-vol2.field.10", label="can lengthen"];
"vol2.storage.durable-checkpoint" -> "vol2.reliability.recovery" [id="relation-vol2.field.11", label="provides restore state\nfor"];
"vol2.storage.versioned-artifact" -> "vol2.operations.registry" [id="relation-vol2.field.12", label="preserves provenance\nfor"];
"vol2.collective.allreduce" -> "vol2.training.data-parallelism" [id="relation-vol2.field.13", label="combines gradients in"];
"vol2.collective.overlap" -> "vol2.fleet.step-time" [id="relation-vol2.field.14", label="reduces exposed time in"];
"vol2.collective.gradient-compression" -> "vol2.fleet.communication-intensity" [id="relation-vol2.field.15", label="reduces"];
"vol2.training.pipeline-parallelism" -> "vol2.fleet.step-time" [id="relation-vol2.field.18", label="adds bubbles to"];
"vol2.training.state-sharding" -> "vol2.hardware.memory-capacity" [id="relation-vol2.field.19", label="reduces per-worker\ndemand on"];
"vol2.reliability.failure-rate" -> "vol2.storage.durable-checkpoint" [id="relation-vol2.field.20", label="raises demand for"];
"vol2.reliability.consistent-cut" -> "vol2.reliability.recovery" [id="relation-vol2.field.21", label="is required for correct"];
"vol2.reliability.recovery" -> "vol2.goodput.runtime" [id="relation-vol2.field.22", label="reduces"];
"vol2.scheduling.gang" -> "vol2.training.data-parallelism" [id="relation-vol2.field.23", label="admits workers together\nfor"];
"vol2.scheduling.placement" -> "vol2.hardware.bandwidth-hierarchy" [id="relation-vol2.field.24", label="matches traffic to"];
"vol2.scheduling.fairness" -> "vol2.scheduling.placement" [id="relation-vol2.field.25", label="is applied after\nfeasible"];
"vol2.scheduling.gang" -> "vol2.goodput.scheduling" [id="relation-vol2.field.26", label="affects"];
"vol2.goodput.scheduling" -> "vol2.goodput.ml" [id="relation-vol2.field.27", label="is a factor in"];
"vol2.goodput.runtime" -> "vol2.goodput.ml" [id="relation-vol2.field.28", label="is a factor in"];
"vol2.goodput.program" -> "vol2.goodput.ml" [id="relation-vol2.field.29", label="is a factor in"];
"vol2.serving.batching" -> "vol2.serving.slo-goodput" [id="relation-vol2.field.30", label="trades waiting against"];
"vol2.serving.kv-cache" -> "vol2.serving.concurrency" [id="relation-vol2.field.31", label="bounds"];
"vol2.serving.slo-goodput" -> "vol2.goodput.ml" [id="relation-vol2.field.32", label="uses a different\ncontract from"];
