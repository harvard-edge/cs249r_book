"vol2.federated.secure-aggregation" -> "vol2.federated.fedavg" [id="relation-vol2.field.34", label="hides individual inputs\nto"];
"vol2.federated.secure-aggregation" -> "vol2.privacy.dp" [id="relation-vol2.field.35", label="does not substitute for"];
